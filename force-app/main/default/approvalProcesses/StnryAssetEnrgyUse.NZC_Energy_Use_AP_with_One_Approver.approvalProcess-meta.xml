<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Data_Processor_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StnryAssetEnvrSrc</field>
        <field>OccupiedFloorArea</field>
        <field>OccupiedFloorAreaUnit</field>
        <field>TotalFloorArea</field>
        <field>TotalFloorAreaUnit</field>
        <field>StartDate</field>
        <field>EndDate</field>
        <field>FuelConsumption</field>
        <field>FuelConsumptionUnit</field>
        <field>FuelType</field>
        <field>Scope1EmissionsInTco2e</field>
        <field>Scope2LocBasedEmssnInTco2e</field>
        <field>Scope2MktBasedEmssnInTco2e</field>
        <field>Scope3UpstrmEmissionsInTco2e</field>
        <field>Scope3DnstrmEmissionsInTco2e</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Data_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Data approver needs to approve the record.</description>
        <label>Data Approver Approval</label>
        <name>Data_Approver_Approval</name>
    </approvalStep>
    <description>Approval process is designed to validate stationary asset energy use records created by data processor and validated by data approver.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.Data_Validator__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.Data_Approver__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.IsSystemGeneratedRecord</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_to_pending_approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Energy Use AP with One Approver</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
