<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>ESG_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>CrbnCrMethodology</field>
        <field>Country</field>
        <field>Description</field>
        <field>FundedBy</field>
        <field>MitigationType</field>
        <field>ProjRegistryIdentifier</field>
        <field>ProjectType</field>
        <field>ProjectUrl</field>
        <field>Region</field>
        <field>StandardsAgencyName</field>
        <field>TotalCrbnCrAllocInTco2e</field>
        <field>TotalCrbnCrAvlInTco2e</field>
        <field>TotalCrbnCrPurchInTco2e</field>
        <field>TotalSpend</field>
        <field>VerifiedBy</field>
        <field>VoluntaryRegistryName</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>stuart.poore@cognizant.com.nzc</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval by ESG Team Member(Stuart)</label>
        <name>Approval_by_ESG_Team_Member_Stuart</name>
    </approvalStep>
    <description>Venkat: Created as part of NZC Phase 2 Implementation for the user story &quot;PhII_UC012_US02&quot;.
Purpose: to send the carbon credit project records for the approval of ESG Team member(Stuart)</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>CrbnCreditProject.Status__c</field>
            <operation>equals</operation>
            <value>Created,Rejected,Revised</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NZC_Email_Alert_to_Carbon_Credit_Project_Owner_Upon_Approval</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>NZC_Email_Alert_to_Carbon_Credit_Project_Owner_Upon_Rejection</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Carbon Credit Project Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
