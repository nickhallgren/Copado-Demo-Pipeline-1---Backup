<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Data_Processor_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StnryAssetEnvrSrc</field>
        <field>OccupiedFloorArea</field>
        <field>OccupiedFloorAreaUnit</field>
        <field>TotalFloorArea</field>
        <field>TotalFloorAreaUnit</field>
        <field>StartDate</field>
        <field>EndDate</field>
        <field>FuelConsumption</field>
        <field>FuelConsumptionUnit</field>
        <field>FuelType</field>
        <field>Scope1EmissionsInTco2e</field>
        <field>Scope2LocBasedEmssnInTco2e</field>
        <field>Scope2MktBasedEmssnInTco2e</field>
        <field>Scope3UpstrmEmissionsInTco2e</field>
        <field>Scope3DnstrmEmissionsInTco2e</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>APAC_Phillipines_Data_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Data approver needs to approve the record.</description>
        <entryCriteria>
            <booleanFilter>1 AND 2</booleanFilter>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>APAC</value>
            </criteriaItems>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Country__c</field>
                <operation>equals</operation>
                <value>PH</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>APAC Philippines Data Approver Approval</label>
        <name>APAC_Philippines_Data_Approver_Approval</name>
        <rejectionActions>
            <action>
                <name>Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>INDIA_APAC_EMEA_Data_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(1 OR 2) OR (3 AND 4)</booleanFilter>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>INDIA</value>
            </criteriaItems>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>EMEA</value>
            </criteriaItems>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>APAC</value>
            </criteriaItems>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Country__c</field>
                <operation>notEqual</operation>
                <value>PH</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>INDIA, APAC, EMEA Data Approver Approval</label>
        <name>INDIA_APAC_EMEA_Data_Approver_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>LATAM_Data_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>LATAM</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>LATAM Data Approver Approval</label>
        <name>LATAM_Data_Approver_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>AMER_Data_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>StnryAssetEnrgyUse.Business_Region__c</field>
                <operation>equals</operation>
                <value>AMER</value>
            </criteriaItems>
        </entryCriteria>
        <label>AMER Data Approver Approval</label>
        <name>AMER_Data_Approver_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>HA: Created as part of NZC phase 3 hypercare implementation.
Purpose: Approval process is designed to validate stationary asset water activity records created by data processor and validated by data approver group.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.Data_Validator__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.Data_Approver__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>StnryAssetEnrgyUse.IsSystemGeneratedRecord</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>EmailAlert_Notifying_the_DataValidator_Processor_that_the_Approved_Energy_use_Re</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_to_pending_approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Stnry Asset Enr with One Approver</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
