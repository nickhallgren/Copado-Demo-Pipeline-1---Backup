<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Data_Processor_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>ActivityType</field>
        <field>ActivitySourceType</field>
        <field>CostCenter</field>
        <field>CostPerUnit</field>
        <field>StartDate</field>
        <field>EndDate</field>
        <field>Quantity</field>
        <field>QuantityUnit</field>
        <field>QuantityInM3</field>
        <field>StnryAssetEnvrSrc</field>
        <field>TotalCost</field>
        <field>TreatmentType</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Data_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Pending Data Approver Approval</label>
        <name>Pending_Data_Approver_Approval</name>
    </approvalStep>
    <description>Venkat: Created as part of NZC phase 2 implementation.
Purpose:Approval process is designed to validate stationary asset water activity records created by data processor and validated by data approver.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>StnryAssetWaterActvty.Data_Validator__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>StnryAssetWaterActvty.Data_Approver__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejection</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_to_Pending_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Water Activity AP with One Approver</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
