<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Data_Modeller</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>UK_Airport__c</field>
        <field>Owner</field>
        <field>Air_Travel_Emissions_Factor__c</field>
        <field>Class_of_Service__c</field>
        <field>DEFRA_Class__c</field>
        <field>Haul_Length__c</field>
        <field>International__c</field>
        <field>Light_Rail_and_Tram__c</field>
        <field>National_Rail__c</field>
        <field>Emission_Factor_Value_in_KM__c</field>
        <field>Emission_Factor_Value_in_Miles__c</field>
        <field>Fuel_Type_Name__c</field>
        <field>Hybrid__c</field>
        <field>RecordType</field>
        <field>Status__c</field>
        <field>WTT_Procurement_Emission_Factor_Set_Year__c</field>
        <field>Procurement_Emissions_Factor_Set_WTT__c</field>
        <field>Procurement_Emissions_Factor_Set__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>praveenkumar.patchigolla@cognizant.com.nzc</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval</label>
        <name>Approval</name>
    </approvalStep>
    <description>Venkat: Created as part of NZC Phase 2 implementation.
Purpose: To send the Scope 3 Emission Factor Records for the approval.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Scope_3_Emission_Factor__c.Status__c</field>
            <operation>notEqual</operation>
            <value>Pending For Approval,Approved</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Scope 3 Emission Factor Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
