<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>ESG_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>AccountName</field>
        <field>Year</field>
        <field>FinalScope1EmssnInTco2e</field>
        <field>TotScope2LocBasedEmssn</field>
        <field>TotScope2MarketBsdEmssn</field>
        <field>Scp3EmssnPurchGoodsAndServices</field>
        <field>Scope3EmissionsCapitalGoods</field>
        <field>Scp3EmssnFuelEnergyActivity</field>
        <field>Scope3EmissionsBusinessTravel</field>
        <field>Scope3EmssnEmployeeCommuting</field>
        <field>Scp3EmssnUpstreamLeasedAssets</field>
        <field>Scp3EmssnUpstreamTrnspDstr</field>
        <field>Scope3EmissionsWasteGenInOper</field>
        <field>Scope3EmissionsInvestments</field>
        <field>TotalEmissions</field>
        <field>RenewableEnergyUsagePctCmclBld</field>
        <field>RenewableEnergyUsagePctDataCtr</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>AEI_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Record Approval</label>
        <name>Record_Approval</name>
    </approvalStep>
    <description>Venkat: Created this Approval Process as part of NZC Phase 3 Implementation
Purpose: To send the Annual Emission Inventory Records for Approval.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>AnnualEmssnInventory.Status__c</field>
            <operation>equals</operation>
            <value>Created,Rejected,Revised</value>
        </criteriaItems>
        <criteriaItems>
            <field>AnnualEmssnInventory.AEI_Approver__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_For_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Annual Emissions Inventory Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
