<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Real_Estate_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StationaryAssetType</field>
        <field>OtherStnryAstType__c</field>
        <field>AccountName</field>
        <field>BusinessRegion</field>
        <field>ParentEnvironmentalSource</field>
        <field>StationaryAssetIdentifier</field>
        <field>IsCompanyOwnedAsset</field>
        <field>OccupiedFloorArea</field>
        <field>OccupiedFloorAreaUnit</field>
        <field>TotalFloorArea</field>
        <field>TotalFloorAreaUnit</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>john.dinapoli@cognizant.com.nzc</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Data Approver Approval</label>
        <name>Data_Approver_Approval</name>
    </approvalStep>
    <description>Approval Process is created to send the Approval to Data Approver</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>StnryAssetEnvrSrc.Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>NZC Stnry Asset AP with One Approver</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
