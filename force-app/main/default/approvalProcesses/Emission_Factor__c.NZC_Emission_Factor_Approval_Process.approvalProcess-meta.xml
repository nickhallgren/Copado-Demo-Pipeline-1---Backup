<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Data_Modeller</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Country__c</field>
        <field>State__c</field>
        <field>Electricity_Emissions_Factor_Set__c</field>
        <field>Other_Emissions_Factor_Set__c</field>
        <field>CFC_R22_Refrigerant_Emissions_Factor__c</field>
        <field>HFC_125_Refrigerant_Emissions_Factor__c</field>
        <field>HFC_134a_Refrigerant_Emissions_Factor__c</field>
        <field>HFC_R32_Refrigerant_Emissions_Factor__c</field>
        <field>HFC_R407c_Refrigerant_Emissions_Factor__c</field>
        <field>HFC_R410a_Refrigerant_Emissions_Factor__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>praveenkumar.patchigolla@cognizant.com.nzc</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval</label>
        <name>Approval</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Emission_Factor__c.Status__c</field>
            <operation>equals</operation>
            <value>Created,Rejected,Revised</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NZC Emission Factor Approval Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
