<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_modified_values</name>
        <label>Assign modified values</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.DisposedWasteQuantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ConvertedM3toKG</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.DisposedWasteQuantityUnit</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>KG</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>SB: Created this flow to convert the Disposed Waste Quantity entered in m3 to Kg</description>
    <environments>Default</environments>
    <formulas>
        <name>ConvertedM3toKG</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Disposed_Waste_Quantity_for_Meter_Cube__c})*1000</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>NZC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NZC Convert M3 to Kg for Generated Waste</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_modified_values</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Disposed_Waste_Quantity_for_Meter_Cube__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Disposed_Waste_Quantity_Unit_Meter_Cube__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>GeneratedWaste</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
