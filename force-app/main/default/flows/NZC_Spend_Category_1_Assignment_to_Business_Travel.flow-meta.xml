<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_of_GHG_tagged_to_the_record</name>
        <label>Assignment of GHG tagged to the record</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Scope3GhgCategory</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Scope3GhgCategory</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>GHG_Category_Assignment_to_Business_Travel</name>
        <label>GHG Category Assign to Business Travel</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Scope3GhgCategory</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Business Travel</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Spend_Category_1_Check</name>
        <label>Spend Category 1 Check</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Travel_Global_Mobility</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SpendingCategory1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.NZC_Spend_Category_1</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GHG_Category_Assignment_to_Business_Travel</targetReference>
            </connector>
            <label>Travel &amp; Global Mobility</label>
        </rules>
        <rules>
            <name>Not_Travel_and_Global_Mobility</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SpendingCategory1</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Label.NZC_Spend_Category_1</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_of_GHG_tagged_to_the_record</targetReference>
            </connector>
            <label>Not Travel and Global Mobility</label>
        </rules>
    </decisions>
    <description>HA: Created for NZC Implementation. This flow will assign the Scope 3 GHG Category as Business Travel when the Spend Category 1 value is Travel &amp; Global Mobility</description>
    <environments>Default</environments>
    <interviewLabel>NZC Spend Category 1 Assignment to Business Travel {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NZC Spend Category 1 Assignment to Business Travel</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Spend_Category_1_Check</targetReference>
        </connector>
        <object>Scope3PcmtItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
