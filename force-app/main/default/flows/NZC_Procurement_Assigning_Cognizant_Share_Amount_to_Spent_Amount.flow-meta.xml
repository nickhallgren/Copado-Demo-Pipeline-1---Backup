<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assigning_Cognizant_Share_Amount_to_Spent_Amount</name>
        <label>Assigning Cognizant Share Amount to Spent Amount</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.SpentAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CognizantShare</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Scope3GhgCategory</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Investments</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>SB: Created for NZC Implementation. This flow is created to populate the Cognizant Share Amount into Spent Amount field and populate Scope 3 GHG Category as Investments.</description>
    <environments>Default</environments>
    <formulas>
        <name>CognizantShare</name>
        <dataType>Number</dataType>
        <expression>({!$Record.CTS_s_Last_Known_Interest_Percentage__c}*{!$Record.Revenue__c}*{!$Record.year__c})/10000</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>NZC Assigning Cognizant Share Amount to Spent Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NZC Procurement Assigning Cognizant Share Amount to Spent Amount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assigning_Cognizant_Share_Amount_to_Spent_Amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Investment_Record__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Scope3PcmtItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
