    <description>HA: Created for NZC implementation. This flow will assign the Procurement EF set item to Procurement Item record.
Added: New Decision added to check weather EF Should be tagged, if not then the reason to be displayed.
Added: New condition to check Investment Record equals False.</description>
    <environments>Default</environments>
    <formulas>
        <description>HA: Created for NZC Implementation. This formula will concat the Category 0, Category 1, Category 2 and Category 3</description>
        <name>ConcatCategories</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.Spending_Category_0__c}, &quot; &quot;, &quot;&quot;) &amp; SUBSTITUTE({!$Record.SpendingCategory1} , &quot; &quot;, &quot;&quot;) &amp; SUBSTITUTE({!$Record.SpendingCategory2} , &quot; &quot;, &quot;&quot;) &amp; SUBSTITUTE({!$Record.SpendingCategory3} , &quot; &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>ConvertSpendToMillions</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SpentAmount} *1000</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>IsRecordNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
