<![CDATA[<p style="background-color: rgb(255, 255, 255);"><font face="arial">Hi {!User.FirstName},</font></p><p style="background-color: rgb(255, 255, 255);"><font face="arial"><br></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="arial"><span style="font-size: 12pt;">Please be informed that the Sustainability Scorecard record&nbsp;</span><b>{!SustainabilityScorecard.Name}</b><span style="font-size: 12pt;">&nbsp;has been updated. Please review the record and take the necessary actions.</span></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><br></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);">Thanks,</p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="arial">Net Zero Team</font></p>]]></td>
