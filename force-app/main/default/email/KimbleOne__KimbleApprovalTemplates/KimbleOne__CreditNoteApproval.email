<messaging:emailTemplate subject="Credit Note Approval - {!relatedTo.Invoice__r.Account__r.Name}" recipientType="User" relatedToType="KimbleOne__CreditNote__c">
<messaging:htmlEmailBody >

    <html>
        <body>

        <p>Please confirm that the following Credit Note is correct and is ready to be dispatched to the customer.</p>
        <p>By rejecting the Credit Note it will revert to a Draft state.</p>
        <p>Account: {!relatedTo.Invoice__r.Account__r.Name}</p>
        <p>Credit Note: {!relatedTo.KimbleOne__Reference__c}</p>
        <p>Credit Note Date: {!relatedTo.KimbleOne__CreditNoteDate__c}</p>
        <p>Related Invoice: {!relatedTo.Invoice__r.KimbleOne__Reference__c}</p>
        <p>
            <apex:outputText value="Net Amount: {0,number,#,###.00}"> 
                <apex:param value="{!ROUND(relatedTo.KimbleOne__NetAmount__c,2)}" /> 
            </apex:outputText>        
        </p> 
        <p>
            <apex:outputText value="Tax Amount: {0,number,#,###.00}"> 
                <apex:param value="{!ROUND(relatedTo.KimbleOne__TaxAmountSum__c,2)}" /> 
            </apex:outputText>        
        </p> 
        <p>
            <apex:outputText value="Total Amount ({!relatedTo.CurrencyIsoCode}): {0,number,#,###.00}"> 
                <apex:param value="{!ROUND(relatedTo.KimbleOne__GrossAmount__c,2)}" /> 
            </apex:outputText>        
        </p>        
        <br/>
        <p>You can approve or reject this Credit Note, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the Operations Department.</p>
        <br/>
        Regards
        <br/>
        {!$Organization.Name} Operations Department
        </body>
    </html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>