<messaging:emailTemplate subject="Travel Requisition {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__TravelRequisition__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">Your Travel Requisition {!relatedTo.Name} has been approved.</p>
           
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">
            If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com. 
           <br/>
            Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>

<messaging:plainTextEmailBody > 

    Your Travel Requisition {!relatedTo.Name} has been approved.
    
    Regards  {!$Organization.Name} 
    Operations Department
        
</messaging:plainTextEmailBody>

</messaging:emailTemplate>