<messaging:emailTemplate subject="Period Cost Approval" recipientType="User" relatedToType="KimbleOne__PeriodCost__c">
<messaging:htmlEmailBody >

    <html>
        <body>
        <h2>Product/Service Reference: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Name}</h2>
        
        <p>Please confirm that the following Period Cost is approved.</p>
        <p>Period: {!relatedTo.TimePeriod__r.Name}:</p>
        <p> 
             <apex:outputText value="{!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__BaselineCost__c.Label}"/>:&nbsp;<apex:outputField value="{!relatedTo.KimbleOne__BaselineCost__c}"/>         
        </p>
        <p> 
             <apex:outputText value="{!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__ForecastCost__c.Label}"/>:&nbsp;<apex:outputField value="{!relatedTo.KimbleOne__ForecastCost__c}"/>         
        </p>
        
        <br/>
        <p>You can approve or reject this Period Cost, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com.</p>
        <br/>
        Regards
        <br/>
        {!$Organization.Name} Operations Department
        </body>
    </html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>