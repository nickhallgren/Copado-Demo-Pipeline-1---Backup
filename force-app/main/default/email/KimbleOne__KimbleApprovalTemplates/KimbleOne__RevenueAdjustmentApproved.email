<messaging:emailTemplate subject="Your Revenue Adjustment has been approved" recipientType="User" relatedToType="KimbleOne__RevenueAdjustment__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
        <p style="padding: 10px 30px 10px 30px;margin: 10px;">
        <b>Hello {!relatedTo.Owner.Name},</b><br/><br/>
        Your Revenue Adjustment for <b>{!relatedTo.DeliveryElement__r.DeliveryGroup__r.Name}</b> with value
        <b>
            <apex:outputText value="{0, number, {!relatedTo.CurrencyISOCode} #,##0.00}">
                <apex:param value="{!relatedTo.KimbleOne__AdjustmentRevenue__c}"></apex:param>
            </apex:outputText>
        </b>  has been approved
        </p>
        
        <p style="padding: 10px 30px 10px 30px;margin: 10px;">
        <br/>
        Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>