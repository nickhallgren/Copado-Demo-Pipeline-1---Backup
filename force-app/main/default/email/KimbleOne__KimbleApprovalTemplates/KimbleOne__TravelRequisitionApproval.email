<messaging:emailTemplate subject="Travel Requisition - Approval Required" recipientType="User" relatedToType="KimbleOne__TravelRequisition__c">

<messaging:htmlEmailBody >

    <html>

        <body>
        <div id="content"
            style="border-width: 2px; border-style: solid; border-color: #810541; background-color: #F8F8F8; width: 600px; margin: 10px;font-family:Arial, Helvetica, sans-serif;">
        <h2
            style="padding: 30px 30px 30px 30px; border-bottom-style: solid; border-bottom-color: #810541; border-bottom-width: 1px; margin: 10px;">
        Travel Requisition for {!relatedTo.Resource__r.Name}
        </h2>
        <h3 style="padding: 10px 30px 10px 30px; margin: 10px;">
            Please confirm that the following Travel Requisition is approved:
        </h3>
        
        <table border="1" cellpadding="8" style="margin: 10px; border-width: 0px; border-spacing: 0px; border-style: solid; border-color: #810541; padding: 10px 30px 10px 30px;">

            <tr
                style="color: #FFFFFF; border-width: 1px; padding: 2px; border-style: solid; border-color: #810541; background-color: #B0B0B0;"
                border="0">
                <th>Travel Category</th>
                <th>Details</th>
                <th>Cost</th>
                <th>Supplier</th>
            </tr>
			
			<apex:variable value="{!1}" var="latestVersionNum"/>
						
			<apex:repeat var="version" value="{!relatedTo.TravelRequisitionVersions__r}">
				<apex:variable value="{!IF(version.KimbleOne__VersionNumber__c > latestVersionNum, version.KimbleOne__VersionNumber__c, latestVersionNum)}" var="latestVersionNum"/>
			</apex:repeat>
			
			
            <apex:repeat var="item" value="{!relatedTo.TravelRequisitionItems__r}">
                
                <apex:outputPanel layout="none" rendered="{!item.TravelRequisitionVersion__r.KimbleOne__VersionNumber__c = latestVersionNum}">
                <tr style="border-width: 1px;padding: 2px;border-style: solid;border-color: #810541;background-color: #FFFFF0;">
               
                    <td>{!item.TravelCategory__r.Name}</td>
                    <td><apex:outputField value="{!item.KimbleOne__Description__c}" /></td>
                    <td><apex:outputField value="{!item.KimbleOne__NetAmount__c}" /></td>
                    <td>{!item.SupplierAccount__r.Name}</td>
                </tr>
				</apex:outputPanel>
				
            </apex:repeat>
                       
        </table>

        <p style="padding: 10px 30px 10px 30px; margin: 10px;">
        You can approve or reject this Travel Requisition, by replying to this email and
        entering either <span style="color: #FF0000; font-weight: bold;">APPROVED</span>
        or <span style="color: #FF0000; font-weight: bold;">REJECTED</span> in
        the first line together with any comments in the second line. If you
        have any queries regarding this confirmation please contact Travel.
        <br />
        Regards 
        The Travel Department<br />
        </p>

        </div>
        </body>
        </html>

    </messaging:htmlEmailBody>

</messaging:emailTemplate>