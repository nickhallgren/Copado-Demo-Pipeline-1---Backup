<messaging:emailTemplate subject="Milestone Approval - {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Account__r.Name}" recipientType="User" relatedToType="KimbleOne__Milestone__c">
<messaging:htmlEmailBody >

    <html>
        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">        

            <h2 style="padding: 30px 30px 30px 30px;border-bottom-style:solid ;border-bottom-color: #810541;border-bottom-width: 1px;margin: 10px;">Product/Service Reference: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Name}</h2>

            <h3 style="padding: 10px 30px 10px 30px;margin: 10px;">Please confirm that the following Milestone has been completed.</h3> 
            <p style="padding: 10px 30px 10px 30px;margin: 10px;">Your approval will result in the item being passed to our Finance department for invoicing.</p> 
            
            <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Notes</b>: {!relatedTo.KimbleOne__Notes__c}</p>            
            <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Account</b>: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Account__r.Name}</p>
            <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Milestone</b>: {!relatedTo.Name}</p>
            <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Date Completed</b>: {!relatedTo.KimbleOne__MilestoneDate__c}</p>
            <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Value</b>: {!relatedTo.KimbleOne__InvoicingCurrencyIsoCode__c} {!relatedTo.KimbleOne__InvoicingCurrencyMilestoneValue__c} </p>
            <br/>
            <p style="padding: 10px 30px 10px 30px;margin: 10px;">You can approve or reject this Milestone, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com.</p>
            <br/>
            <p style="padding: 0px 0px 0px 30px;margin: 10px;">Regards</p>          
            <p style="padding: 0px 0px 0px 30px;margin: 10px;">{!$Organization.Name} Operations Department</p>

        </div>
        </body>
    </html>

</messaging:htmlEmailBody>
<messaging:plainTextEmailBody >

        Product/Service Reference: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Name}
 ---------------------------------------------------------------------------------------       
        Please confirm that the following Milestone has been completed. 
        Your approval will result in the item being passed to our Finance department for invoicing.

        Notes: {!relatedTo.KimbleOne__Notes__c}
        Account: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Account__r.Name}
        Milestone: {!relatedTo.Name}
        Date Completed: {!relatedTo.KimbleOne__MilestoneDate__c}
        Value: {!relatedTo.KimbleOne__InvoicingCurrencyIsoCode__c} {!relatedTo.KimbleOne__InvoicingCurrencyMilestoneValue__c}
        
        
        ---------------------------------------------------------------------------------------
        You can approve or reject this Milestone, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com.
        
        
        Regards
        
        
        {!$Organization.Name} Operations Department
        


</messaging:plainTextEmailBody>
</messaging:emailTemplate>