<messaging:emailTemplate subject="Your Invoice {!relatedTo.KimbleOne__Reference__c}  has been rejected" recipientType="User" relatedToType="KimbleOne__Invoice__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
       <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Hi {!relatedTo.Owner.Name},</b><br/><br/>
     Your Invoice <b>{!relatedTo.Reference__c}</b> for <b>{!relatedTo.Account__r.Name}</b> with value 
     <b>
		<apex:outputText value="{0, number, {!relatedTo.CurrencyISOCode} #,##0.00}">
			<apex:param value="{!relatedTo.KimbleOne__NetAmount__c}"></apex:param>
		</apex:outputText>
    </b>  has been rejected
       </p>
        <p style="padding: 10px 30px 10px 30px;margin: 10px;">
       <br/>
        Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>
 <messaging:plainTextEmailBody > 


Hi {!relatedTo.Owner.Name},
Your Invoice {!relatedTo.Reference__c} for {!relatedTo.Account__r.Name} with value <apex:outputText value="{0, number, {!relatedTo.CurrencyISOCode} #,##0.00}">
			<apex:param value="{!relatedTo.KimbleOne__NetAmount__c}"></apex:param>
		</apex:outputText>  has been rejected


Regards  {!$Organization.Name} 
Operations Department
        
 </messaging:plainTextEmailBody>
</messaging:emailTemplate>