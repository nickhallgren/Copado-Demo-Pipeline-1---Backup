<messaging:emailTemplate subject="Travel Itinerary for {!relatedTo.Name} Confirmed" recipientType="User" relatedToType="KimbleOne__TravelRequisition__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">The itinerary for Travel Requisition {!relatedTo.Name} has been confirmed.</p>
           
        <table border="1" cellpadding="8" style="margin: 10px; border-width: 0px; border-spacing: 0px; border-style: solid; border-color: #810541; padding: 10px 30px 10px 30px;">

            <tr
                style="color: #FFFFFF; border-width: 1px; padding: 2px; border-style: solid; border-color: #810541; background-color: #B0B0B0;"
                border="0">
                <th>Travel Category</th>
                <th>Itinerary Details</th>
                <th>Booking Reference</th>
                <th>Notes</th>
            </tr>
            
            <apex:variable value="{!1}" var="latestVersionNum"/>
                        
            <apex:repeat var="version" value="{!relatedTo.TravelRequisitionVersions__r}">
                <apex:variable value="{!IF(version.KimbleOne__VersionNumber__c > latestVersionNum, version.KimbleOne__VersionNumber__c, latestVersionNum)}" var="latestVersionNum"/>
            </apex:repeat>
            
            
            <apex:repeat var="item" value="{!relatedTo.TravelRequisitionItems__r}">
                
                <apex:outputPanel layout="none" rendered="{!item.TravelRequisitionVersion__r.KimbleOne__VersionNumber__c = latestVersionNum}">
                <tr style="border-width: 1px;padding: 2px;border-style: solid;border-color: #810541;background-color: #FFFFF0;">
                    <td>{!item.TravelCategory__r.Name}</td>
                    <td><apex:outputField value="{!item.SelectedTravelItineraryItem__r.KimbleOne__ItineraryNotes__c}" /></td>
                    <td><apex:outputField value="{!item.KimbleOne__BookingReference__c}" /></td>
                    <td><apex:outputField value="{!item.KimbleOne__BookingNotes__c}" /></td>
                </tr>
                </apex:outputPanel>
                
            </apex:repeat>
                       
        </table>

           
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">
            If you have any queries regarding this confirmation please contact the Travel Department on 0207-876 5432, or operations@kimbleapps.com. 
           <br/>
            Regards <br/>  {!$Organization.Name} Travel Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>

<messaging:plainTextEmailBody > 

    The itinerary for Travel Requisition {!relatedTo.Name} has been confirmed.
    
    Regards  {!$Organization.Name} 
    Travel Department
        
</messaging:plainTextEmailBody>

</messaging:emailTemplate>