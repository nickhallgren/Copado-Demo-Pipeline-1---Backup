<messaging:emailTemplate subject="Forecast Timesheet on activity {!relatedTo.ResourcedActivity__r.KimbleOne__FullName__c} Rejected" recipientType="User" relatedToType="KimbleOne__ForecastTimesheet__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
       <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Hi {!relatedTo.Resource__r.Name},</b><br/><br/>
      The forecast timesheet for {!relatedTo.ResourcedActivity__r.FullName__c} has been rejected for the following reason:<br/>{!relatedTo.ApprovalComments__c} </p>
        
         <table border="1" style="margin: 10px;border-width: 0px;border-spacing: 0px;border-style: solid;border-color: #810541;padding: 10px 30px 10px 30px;" >
            <tr style="color: #FFFFFF ;border-width: 1px ;padding: 2px ;border-style: solid;border-color: #810541;background-color: #B0B0B0 ;" border="0">
                    <th>{!$ObjectType.TimePeriod__c.Label} (days)</th>
                    <th>{!$ObjectType.ForecastTimeEntry__c.Fields.UtilisationPercentage__c.Label}(%)</th>
                    
                </tr>
              
                    <c:ApprovalEmailTemplateEntries ForecastTimesheetId="{!relatedTo.Id}" isPlainText="false"
                rowStyle="border-width: 1px; padding: 2px; border-style: solid; border-color: #810541; background-color: #FFFFF0;"/>   
        </table>
        
        
       
        <p style="padding: 10px 30px 10px 30px;margin: 10px;">
        If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com. 
       <br/>
        Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>
 <messaging:plainTextEmailBody > 


Hi {!relatedTo.Resource__r.Name},

The forecast timesheet for {!relatedTo.ResourcedActivity__r.KimbleOne__FullName__c} has been rejected for the following reason: {!relatedTo.KimbleOne__ApprovalComments__c}
        
        
 {!$ObjectType.KimbleOne__TimePeriod__c.Label}(days)  |   {!$ObjectType.KimbleOne__ForecastTimeEntry__c.Fields.KimbleOne__UtilisationPercentage__c.Label}(%)
----------------------------------------------------------------------------------------                
                <apex:repeat var="entry" value="{!relatedTo.ForecastTimeEntries__r}">
                    <apex:variable var="entryvalue" value="{!entry.KimbleOne__EntryUnits__c}"/>
                    
                    
  <c:ApprovalEmailTemplateEntries ForecastTimesheetId="{!relatedTo.Id}" isPlainText="true"/> 
                  
                  </apex:repeat> 
        
       
If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com. 

Regards  {!$Organization.Name} 
Operations Department
        
 </messaging:plainTextEmailBody>
</messaging:emailTemplate>