<messaging:emailTemplate subject="Supplier Requisition {!relatedTo.Name} Rejected" recipientType="User" relatedToType="KimbleOne__SupplierRequisition__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">Supplier Requisition has been rejected:</p>
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">Reference: {!relatedTo.Name}</p>
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">Supplier: {!relatedTo.SupplierAccount__r.Name}</p>
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">Description: {!relatedTo.KimbleOne__Description__c}</p>
       
           <p style="padding: 10px 30px 10px 30px;margin: 10px;">
            If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com. 
           <br/>
            Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>

<messaging:plainTextEmailBody > 

    Supplier Requisition {!relatedTo.Name} has been rejected.
    Supplier: {!relatedTo.SupplierAccount__r.Name}      
    
    
    Regards  {!$Organization.Name} 
    Operations Department
        
</messaging:plainTextEmailBody>

</messaging:emailTemplate>