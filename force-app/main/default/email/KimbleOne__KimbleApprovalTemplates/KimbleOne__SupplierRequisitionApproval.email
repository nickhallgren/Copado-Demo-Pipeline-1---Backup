<messaging:emailTemplate subject="Supplier Requisition Approval" recipientType="User" relatedToType="KimbleOne__SupplierRequisition__c">
<messaging:htmlEmailBody >

    <html>
        <body>
        <h2>Supplier Requisition Reference: {!relatedTo.Name}</h2>
        
        <p>Please confirm that the following Supplier Requisition is approved.</p>
        <br/>
        <p>Supplier: {!relatedTo.SupplierAccount__r.Name}</p>
        <br/>
        <p>Description: {!relatedTo.KimbleOne__Description__c}</p>
        <br/>
        <p>Net Amount: {!relatedTo.KimbleOne__NetAmount__c}</p>
        <br/>
        <p>{!relatedTo.KimbleOne__Notes__c}</p>
        <br/>
        <p>You can approve or reject this Supplier Requisition, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line.</p>
        <br/>
        Regards
        <br/>
        {!$Organization.Name} Operations Department
        </body>
    </html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>