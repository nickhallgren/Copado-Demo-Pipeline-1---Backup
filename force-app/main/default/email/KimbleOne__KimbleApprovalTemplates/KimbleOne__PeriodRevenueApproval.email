<messaging:emailTemplate subject="Period Revenue Approval" recipientType="User" relatedToType="KimbleOne__PeriodRevenue__c">
<messaging:htmlEmailBody >

    <html>
        <body>
        <h2>Product/Service Reference: {!relatedTo.DeliveryElement__r.DeliveryGroup__r.Name}</h2>
        
        <p>Please confirm that the following Period Revenue is approved. 
        Your approval will result in the item being passed to our Finance department for invoicing.</p>
        <p>Period: {!relatedTo.TimePeriod__r.Name}</p>
        <p> 
             <apex:outputText value="{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__BaselineRevenue__c.Label}"/>:&nbsp;<apex:outputField value="{!relatedTo.KimbleOne__BaselineRevenue__c}"/>
        </p>
        <p> 
             <apex:outputText value="{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__ForecastRevenue__c.Label}"/>:&nbsp;<apex:outputField value="{!relatedTo.KimbleOne__ForecastRevenue__c}"/>       
        </p>
        <br/>
        <p>You can approve or reject this Period Revenue, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact our Operations Department on 0207-876 5432, or operations@kimbleapps.com.</p>
        <br/>
        Regards
        <br/>
        {!$Organization.Name} Operations Department
        </body>
    </html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>