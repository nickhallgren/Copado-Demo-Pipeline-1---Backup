<messaging:emailTemplate subject="Your Expense Claim {!relatedTo.KimbleOne__Reference__c} has been approved" recipientType="User" relatedToType="KimbleOne__ExpenseClaim__c">
<messaging:htmlEmailBody >
    <html>

        <body>
        <div id="content" style="border-width:2px;border-style: solid;border-color:#810541;background-color: #F8F8F8 ;width:600px;margin: 10px;">
       
       <p style="padding: 10px 30px 10px 30px;margin: 10px;"><b>Hi {!relatedTo.Resource__r.Name},</b><br/><br/>
     Your Expense Claim <b>{!relatedTo.Reference__c}</b> has been approved</p>
       
        <p style="padding: 10px 30px 10px 30px;margin: 10px;">
     
       <br/>
        Regards <br/>  {!$Organization.Name} Operations Department<br/></p>
        
        </div>
        </body>
    </html>

</messaging:htmlEmailBody>
 <messaging:plainTextEmailBody > 


Hi {!relatedTo.Resource__r.Name},
Your Expense Claim {!relatedTo.KimbleOne__Reference__c} has been approved
       


Regards  {!$Organization.Name} 
Operations Department
        
 </messaging:plainTextEmailBody>
</messaging:emailTemplate>