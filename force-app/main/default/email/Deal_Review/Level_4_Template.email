<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><font color="#000066"><b>Hello,</b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><font color="#000099"><b><br></b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">{!Opportunity.OwnerFullName} is requesting Level 4 - Commercial Review for&nbsp;</font><span style="font-family: Arial, sans-serif;">{!Opportunity.Name}.</span></div><font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt; font-weight: bold;"><font face="Arial, sans-serif"><br></font></div><div style="font-size: 12pt; font-weight: bold;"><b><font color="#000066"><u>Opportunity Details:</u></font></b></div><font color="#000066"><font face="arial"><b>Opportunity Name:</b></font></font><font color="#000000" style="font-size: 12pt; font-weight: bold;">&nbsp;</font></font><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b><a href="{!Opportunity.Link}">{!Opportunity.Name}</a></b></font><div style=""><div style=""><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin-left: 1.25in; text-indent: -1.25in; vertical-align: middle;"><b style=""><font style="color: rgb(0, 0, 0); font-size: 12pt;"><font color="#000066">Opportunity Owner:</font>&nbsp;</font><font face="Arial, sans-serif" style="">{!Opportunity.OwnerFullName}</font></b></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin-left: 1.25in; text-indent: -1.25in; vertical-align: middle;"><span style="color: rgb(0, 0, 0); font-size: 12pt; text-indent: -1.25in;"><font face="Arial, sans-serif"><b><font color="#000066">Solution Engineer:</font>&nbsp;</b></font></span><font face="Arial, sans-serif" style=""><b style="">{!Opportunity.Solution_Engineer__