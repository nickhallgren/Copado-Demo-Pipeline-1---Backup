<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" style=""><font style="" color="#000066"><b style="">Hello,</b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><font color="#000099" style=""><b style=""><br></b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" style="">{!Opportunity.OwnerFullName} is requesting Level 1 - Deal Prioritization for&nbsp;</font><span style="font-family: Arial, sans-serif;">{!Opportunity.Name}.</span></div><font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; font-weight: bold;"><font face="Arial, sans-serif" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; font-weight: bold;"><b><font color="#000066"><u>Opportunity Details:</u></font></b></div><font color="#000066" style=""><font face="arial"><b>Opportunity Name</b></font><font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; font-weight: bold;">:</font></font><font color="#000000" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; font-weight: bold;">&nbsp;<a href="{!Opportunity.Link}">{!Opportunity.Name}</a></font></font><div style=""><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin-left: 1.25in; text-indent: -1.25in; vertical-align: middle;"><b style=""><font face="Arial, sans-serif" style="font-family: arial; font-size: 12pt;"><font color="#000066">Opportunity Owner:</font>&nbsp;</font><font face="Arial, sans-serif" style="">{!Opportunity.OwnerFullName}</font></b></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin-left: 1.25in; text-indent: -1.25in; vertical-align: middle;"><span style="font-family: arial; font-size: 12pt; text-ind