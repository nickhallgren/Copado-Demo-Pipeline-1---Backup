<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<b style="color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);"><font size="5"><span style="font-family: Arial, Helvetica, sans-serif;">*** NEW SYNERGY LEAD ASSIGNMENT NOTIFICATION ***</span></font></b><div style=""><b style="color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);"><font size="5"><br style="font-family: Arial, Helvetica, sans-serif;"></font></b><br style="font-family: Arial, Helvetica, sans-serif; font-size: 11.36px;"><font style="font-size: 12pt;" color="#330033"><b style=""><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">The following Synergy Lead has been created via our Form submission process:</span><br style="font-family: Arial, Helvetica, sans-serif;"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Cognizant Associate Name: {!</span><a href="https://lead.name/" target="_blank" style="font-family: Arial, Helvetica, sans-serif;">Lead.Name</a><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">}</span></b></font><div style="font-size: 12pt;"><b><font color="#330033"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Cognizant Associate Email: {!Lead.Email}</span></font></b></div><div style="font-size: 12pt;"><b><font color="#330033"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Who is the client?: {!Lead.Who_is_the_client__c}</span></font></b></div><div style="font-size: 12pt;"><b><font color="#330033"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Vertical Market: {!Lead.Vertical_Market__c}</span></font></b></div><div style="font-size: 12pt;"><b><font color="#330033"><br></font></b></div><div style="font-size: 12pt;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);"><b><font color="#330033">ATG Prioritized Revenue Stream: {!Lead.ATG_Prioritized_Revenue_Stream__c}</font></b></span></div><div style="font-size: 12pt;"><b><font color="#330033"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Is this an existing Cognizant Customer: {!Lead.Existing_Cognizant_Customer__c}</span></font></b></div><div style="font-size: 12pt;"><b><font color="#330033"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Is this tied to an RFP Response?: {!Lead.Tied_to_an_RFP_Response__c}</span></font></b></div><div style="font-size: 12pt;"><b><font color="#330033"><br></font></b></div><div style="font-size: 12pt;"><font style="" color="#330033"><b style=""><br style="font-family: Arial, Helvetica, sans-serif;"><br style="font-family: Arial, Helvetica, sans-serif;"><span style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);">Click on the link to access the lead and additional information captured from the form: {!Lead.Link}</span></b></font></div></div>]]></td>
</tr>
