<messaging:emailTemplate subject="{!$Organization.Name} Invoice Ref {!relatedTo.KimbleOne__Reference__c}" recipientType="Contact" relatedToType="KimbleOne__Invoice__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;font-family:Arial,Arial,sans-serif;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__Reference__c}</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;"> Dear {!Recipient.Name}<br/><br/> Invoice Reference {!relatedTo.KimbleOne__Reference__c} is now due for payment. Regards, </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html> </messaging:htmlEmailBody> <messaging:plainTextEmailBody >Dear {!Recipient.Name}Invoice Reference {!relatedTo.KimbleOne__Reference__c} is now due for payment.Regards,{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>