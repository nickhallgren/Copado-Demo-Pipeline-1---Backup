<messaging:emailTemplate subject="Travel Requisition - Approval Required" recipientType="User" relatedToType="KimbleOne__TravelRequisition__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">Please confirm that the following Travel Requisition by {!relatedTo.KimbleOne__Resource__r.Name} is correct and is ready to be dispatched.</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;font-weight:bold;padding-top:10px;padding-bottom:8px;font-size:.8em;">Your approval will result in the item being passed to our Finance department for despatch. By rejecting the Travel Requisition it will revert to a Draft state.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this requisition in Kimble.</td></tr> <tr> <td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;padding-top:10px;"> <table style="font-family:Arial,sans-serif;color:#0f0f0f;text-align:left;border-collapse:collapse;font-size:.7em;"> <tr> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__TravelCategory__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__Description__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__SupplierAccount__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__NetAmount__c.Label}</th> </tr> <apex:variable value="{!1}" var="latestVersionNum"/> <apex:repeat var="version" value="{!relatedTo.KimbleOne__TravelRequisitionVersions__r}"> <apex:variable value="{!IF(version.KimbleOne__VersionNumber__c > latestVersionNum, version.KimbleOne__VersionNumber__c, latestVersionNum)}" var="latestVersionNum"/> </apex:repeat> <apex:repeat var="line" value="{!relatedTo.KimbleOne__TravelRequisitionItems__r}"> <apex:outputPanel layout="none" rendered="{!line.KimbleOne__TravelRequisitionVersion__r.KimbleOne__VersionNumber__c = latestVersionNum}"> <tr> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!line.KimbleOne__TravelCategory__r.Name}</td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"><apex:outputText escape="false" value="{!line.KimbleOne__Description__c}" /></td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!line.KimbleOne__SupplierAccount__r.Name}</td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!line.KimbleOne__NetAmount__c}" /></apex:outputText></td> </tr> </apex:outputPanel> </apex:repeat> <tr> <td>&nbsp;</td> <td>&nbsp;</td> <td style="font-family:Arial,sans-serif;border-style:none;padding:4px;" align="right"><b>Net Total:</b></td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"><b> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__NetAmount__c}" /></apex:outputText></b></td> </tr> </table> </td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Travel Requisition, by replying to this email and entering either <span style="font-family:Arial,sans-serif;color:#1a8d4a;font-weight:bold;">APPROVED</span> or <span style="font-family:Arial,sans-serif;color:#dd1d2e;font-weight:bold;">REJECTED</span> in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the project owner.</td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td> </tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Please confirm that the following Travel Requisition is correct and is ready to be dispatched. Your approval will result in the item being passed to our Finance department for despatch. By rejecting the Travel Requisition it will revert to a Draft state. {!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__TravelCategory__c.Label} | {!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__Description__c.Label} | {!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__SupplierAccount__c.Label} | {!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__NetAmount__c.Label} <apex:repeat var="line" value="{!relatedTo.KimbleOne__TravelRequisitionItems__r}"> {!line.KimbleOne__TravelCategory__r.Name} | {!line.KimbleOne__Description__c} | {!line.KimbleOne__SupplierAccount__r.Name} | <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!line.KimbleOne__NetAmount__c}" /></apex:outputText> </apex:repeat> Net Total: <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__NetAmount__c}" /></apex:outputText> You can approve or reject this Travel Requisition, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the project owner. </messaging:plainTextEmailBody></messaging:emailTemplate>