<messaging:emailTemplate subject="Timesheet for {!relatedTo.KimbleOne__ResourcedActivity__r.Name} - {!relatedTo.KimbleOne__TimePeriod__r.Name} has been approved" recipientType="User" relatedToType="KimbleOne__Timesheet__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;font-family:Arial,Arial,sans-serif;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <apex:OutputPanel rendered="{!IF(relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__ResourcedActivityType__r.KimbleOne__Enum__c=='DeliveryElement','true','false')}"> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> </apex:OutputPanel> <apex:OutputPanel rendered="{!IF(relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__ResourcedActivityType__r.KimbleOne__Enum__c!='DeliveryElement','true','false')}"> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;color:#128752;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.Name}</td></tr> </apex:OutputPanel> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;"> Your&nbsp;<apex:outputlink value="{!URLFOR($Page.KimbleOne__Timesheet)+'?periodId='+relatedTo.KimbleOne__TimePeriod__r.Id}">Timesheet </apex:outputlink> for <b>{!relatedTo.KimbleOne__ResourcedActivity__r.Name}</b> covering the period <b> <apex:outputText value="{0,date, d MMM yyyy}"><apex:param value="{!relatedTo.KimbleOne__TimePeriod__r.KimbleOne__StartDate__c}" /></apex:outputText></b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">approved</span>. </td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Resource__c.label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__Resource__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Activity:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}</td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Comments: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr> </apex:OutputText> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html> </messaging:htmlEmailBody> <messaging:plainTextEmailBody >{!$ObjectType.KimbleOne__TimeEntry__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c} has been approved.--------------------------------------------------------------------------------------- {!$ObjectType.KimbleOne__Resource__c.label}: {!relatedTo.KimbleOne__Resource__r.Name}Activity: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}<apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c} </apex:OutputText>Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>