<messaging:emailTemplate subject="{!$ObjectType.KimbleOne__ExpenseItem__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent." recipientType="User" relatedToType="KimbleOne__ExpenseClaim__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;font-family:Arial,Arial,sans-serif;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">{!$ObjectType.KimbleOne__ExpenseItem__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent.</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:8px;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;font-weight:bold;padding-top:10px;padding-bottom:8px;font-size:.8em;">Please confirm that the following {!$ObjectType.KimbleOne__ExpenseClaim__c.Label} is approved:</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Expense Claim in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Resource__c.label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__Resource__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Activity:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Total Expense Cost:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">&nbsp;<apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__TotalExpenseCost__c}" /></apex:outputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Total Expense Revenue:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">&nbsp;<apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__TotalExpenseRevenue__c}" /></apex:outputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Total Reimbursement Amount:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">&nbsp;<apex:outputText value="{!relatedTo.KimbleOne__ReimbursementCurrencyIsoCode__c} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c}" /></apex:outputText></td></tr> </table> </td></tr> <tr> <td style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;background-color:#c9dae6;color:#0f0f0f;text-align:left;border-color:#464b50;border-style:solid;border-width:1px;border-collapse:collapse;font-size:.7em;"> <tr> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IncurredDate__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseCategory__c.Fields.Name.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExpenseGrossAmount__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__InvoicingCurrencyExpenseRevenue__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ReimbursementCurrencyReimbursementAmount__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">Units</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__Notes__c.Label}</th> </tr> <KimbleOne:ApprovalEmailTemplateEntries ExpenseClaimId="{!relatedTo.Id}" isPlainText="false" rowStyle="font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"/> </table> </td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Expense Claim in Kimble. If you have any queries regarding this confirmation please contact the project owner.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > {!$ObjectType.KimbleOne__ExpenseItem__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent. Please confirm that the following {!$ObjectType.KimbleOne__ExpenseClaim__c.Label} is approved. {!$ObjectType.KimbleOne__Resource__c.label}: {!relatedTo.KimbleOne__Resource__r.Name} Activity: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c} Total Expense Cost: <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__TotalExpenseCost__c}" /></apex:outputText> Total Revenue Cost: <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__TotalExpenseRevenue__c}" /></apex:outputText> Total Reimbursement Amount: <apex:outputText value="{!relatedTo.KimbleOne__ReimbursementCurrencyIsoCode__c} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c}" /></apex:outputText> {!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IncurredDate__c.Label} | {!$ObjectType.KimbleOne__ExpenseCategory__c.Fields.Name.Label} | {!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IncurredCurrencyGrossAmount__c.Label} | {!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__InvoicingCurrencyExpenseRevenue__c.Label} | {!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ReimbursementCurrencyReimbursementAmount__c.Label} | Units | {!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__Notes__c.Label} ------------------------------------------------------------------------------------------------------------------------------- <KimbleOne:ApprovalEmailTemplateEntries ExpenseClaimId="{!relatedTo.Id}" isPlainText="true"/> You can approve or reject this Expense Claim in Kimble. If you have any queries regarding this confirmation please contact the project owner Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>