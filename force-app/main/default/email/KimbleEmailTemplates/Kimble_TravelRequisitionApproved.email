<messaging:emailTemplate subject="Travel Requisition {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__TravelRequisition__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px; border-bottom-width:1px;border-left-style:none;border-bottom-style:solid; border-right-style:none;"> <apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;border-bottom-width:1px;border-bottom-style:solid;"> Hi {!relatedTo.KimbleOne__Resource__r.KimbleOne__FirstName__c},<br/> Your&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Travel Requisition</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">approved</span>.</td></tr> <tr> <td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;padding-top:10px;"> <table style="font-family:Arial,sans-serif;color:#0f0f0f;text-align:left;border-collapse:collapse;font-size:.7em;"> <tr> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__TravelCategory__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__Description__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__SupplierAccount__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__NetAmount__c.Label}</th> </tr> <apex:repeat var="line" value="{!relatedTo.KimbleOne__TravelRequisitionItems__r}"> <tr> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!line.KimbleOne__TravelCategory__r.Name}</td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!line.KimbleOne__Description__c}</td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!line.KimbleOne__SupplierAccount__r.Name}</td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!line.KimbleOne__NetAmount__c}" /></apex:outputText></td> </tr> </apex:repeat> <tr> <td>&nbsp;</td> <td>&nbsp;</td> <td style="font-family:Arial,sans-serif;border-style:none;padding:4px;" align="right"><b>Net Total:</b></td> <td style="font-family:Arial,sans-serif;background-color:#c9dae6;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"><b> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__NetAmount__c}" /></apex:outputText></b></td> </tr> </table> </td> </tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;border-bottom-width:1px;border-bottom-style:solid;"> If you have any queries regarding this confirmation please contact our {!$Label.kimbleone__emailtemplatesignature}.<br/><br/> Regards,<br/> {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Your Travel Requisition {!relatedTo.Name} has been approved. Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature} </messaging:plainTextEmailBody></messaging:emailTemplate>