<messaging:emailTemplate subject="You have Overdue Approval Requests" recipientType="Contact" relatedToType="KimbleOne__Resource__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;font-family:Arial,Arial,sans-serif;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;"> Dear {!Recipient.Name}<br/><br/> You have Overdue Approval Requests. Please login to Kimble and approve as soon as possible.<br/> </td></tr> <tr> <td style="font-family:Arial,sans-serif;padding-bottom:10px;"> <KimbleOne:ApprovalEmailTemplateEntries ApproverUserId="{!relatedTo.KimbleOne__User__c}" isPlainText="false" headStyle="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;font-size:.8em;" rowStyle="font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;font-size:.7em;"/> </td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html> </messaging:htmlEmailBody> <messaging:plainTextEmailBody >Dear {!Recipient.Name}You have Overdue Approval Requests. Please login to Kimble and approve as soon as possible.Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>