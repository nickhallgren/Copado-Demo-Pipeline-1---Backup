<messaging:emailTemplate subject="Delivery Element Stage Approval Required" recipientType="User" relatedToType="KimbleOne__DeliveryElementStage__c"><messaging:htmlEmailBody >  <html>    <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;">        <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;">            <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr>            <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">Engagement requires approval before progressing to the next Delivery Stage.</td></tr>            <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.Name}</td></tr>            <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Stage in Kimble.</td></tr>        <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;">          <table style="font-family:Arial,sans-serif;border-collapse:collapse;">                 <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryElementStage__c.Fields.Name.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__DeliveryStage__r.Name}</td></tr>            <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ForecastStatus__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ForecastStatus__r.Name}</td></tr>            <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ContractRevenue__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">            <apex:outputText value="{0, number, {!relatedTo.KimbleOne__DeliveryElement__r.CurrencyIsoCode} #,##0.00}">                <apex:param value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ContractRevenue__c}"></apex:param>            </apex:outputText></td></tr>          </table>        </td></tr>                                    <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Delivery Stage in Kimble. If you have any queries regarding this confirmation please contact the project owner.</td>                    </tr>            <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} Operations Department</td></tr>        </table>    </body>  </html></messaging:htmlEmailBody><messaging:plainTextEmailBody >{!$ObjectType.KimbleOne__DeliveryElement__c.Label} {!relatedTo.KimbleOne__DeliveryElement__r.Name} requires approval before progressing to the next Delivery Stage.{!$ObjectType.KimbleOne__DeliveryElementStage__c.Fields.Name.Label}: <apex:outputText value="{!relatedTo.KimbleOne__DeliveryStage__r.Name}" /> {!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ForecastStatus__c.Label}: <apex:outputText value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ForecastStatus__r.Name}"/>                          {!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ContractRevenue__c.Label}: <apex:outputText value="{0, number, {!relatedTo.KimbleOne__DeliveryElement__r.CurrencyIsoCode} #,##0.00}">                           <apex:param value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ContractRevenue__c}"></apex:param>                        </apex:outputText>You can approve or reject this Delivery Stage in Kimble. If you have any queries regarding this confirmation please contact the project owner.Regards {!$Organization.Name} Operations Department </messaging:plainTextEmailBody></messaging:emailTemplate>