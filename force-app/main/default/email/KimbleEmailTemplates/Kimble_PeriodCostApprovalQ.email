<messaging:emailTemplate subject="Period Cost Approval" recipientType="User" relatedToType="KimbleOne__PeriodCost__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">Please confirm that the following Period Cost is correct.</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;font-weight:bold;padding-top:10px;padding-bottom:8px;font-size:.8em;">Your approval will result in the item being passed to our Finance department.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Period Cost in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__TimePeriod__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> <apex:outputText value="{0,date, d MMM yyyy}"><apex:param value="{!relatedTo.KimbleOne__TimePeriod__r.KimbleOne__StartDate__c}" /></apex:outputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__ForecastCost__c.Label}: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;"><apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ForecastCost__c}" /></apex:outputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__ActualCost__c.Label}: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;"><apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ActualCost__c}" /></apex:outputText></td></tr> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Period Cost in Kimble. If you have any queries regarding this confirmation please contact the project owner.</td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td> </tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Please confirm that the following Period Cost is correct. Your approval will result in the item being passed to our Finance department. {!$ObjectType.KimbleOne__TimePeriod__c.Label}: <apex:outputText value="{0,date, d MMM yyyy}"><apex:param value="{!relatedTo.KimbleOne__TimePeriod__r.KimbleOne__StartDate__c}" /></apex:outputText> {!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__ForecastCost__c.Label}: <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ForecastCost__c}" /></apex:outputText> {!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__ActualCost__c.Label}: <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__ActualCost__c}" /></apex:outputText> You can approve or reject this Period Cost in Kimble. If you have any queries regarding this confirmation please contact the project owner. </messaging:plainTextEmailBody></messaging:emailTemplate>