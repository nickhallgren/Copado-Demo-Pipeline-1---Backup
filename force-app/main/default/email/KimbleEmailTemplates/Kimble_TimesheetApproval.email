<messaging:emailTemplate subject="{!$ObjectType.KimbleOne__TimeEntry__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent." recipientType="User" relatedToType="KimbleOne__Timesheet__c"> <messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;font-family:Arial,Arial,sans-serif;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">{!$ObjectType.KimbleOne__TimeEntry__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent.</td></tr> <apex:OutputPanel rendered="{!IF(relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__ResourcedActivityType__r.KimbleOne__Enum__c=='DeliveryElement','true','false')}"> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> </apex:OutputPanel> <apex:OutputPanel rendered="{!IF(relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__ResourcedActivityType__r.KimbleOne__Enum__c!='DeliveryElement','true','false')}"> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.Name}</td></tr> </apex:OutputPanel> <tr><td style="font-family:Arial,sans-serif;font-weight:bold;padding-top:10px;padding-bottom:8px;font-size:.8em;">Please confirm that the following {!$ObjectType.KimbleOne__Timesheet__c.Label} is approved:</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Timesheet in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Resource__c.label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__Resource__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Activity:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}</td></tr> </table> </td></tr> <tr> <td style="font-family:Arial,sans-serif;padding-bottom:10px;"> <KimbleOne:ApprovalEmailTemplateEntries TimesheetId="{!relatedTo.Id}" isPlainText="false" headStyle="font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;font-size:.8em;" rowStyle="font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;font-size:.7em;"/> </td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Timesheet, by replying to this email and entering either <span style="font-family:Arial,sans-serif;color:#1a8d4a;font-weight:bold;">APPROVED</span> or <span style="font-family:Arial,sans-serif;color:#dd1d2e;font-weight:bold;">REJECTED</span> in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the project owner.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html> </messaging:htmlEmailBody> <messaging:plainTextEmailBody >{!$ObjectType.KimbleOne__TimeEntry__c.LabelPlural} created for resource {!relatedTo.KimbleOne__Resource__r.Name} on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c}. Awaiting your consent.---------------------------------------------------------------------------------------Please confirm that the following {!$ObjectType.KimbleOne__Timesheet__c.Label} is approved: {!$ObjectType.KimbleOne__Resource__c.label}: {!relatedTo.KimbleOne__Resource__r.Name}Activity: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c} <KimbleOne:ApprovalEmailTemplateEntries TimesheetId="{!relatedTo.Id}" isPlainText="true"/> You can approve or reject this {!$ObjectType.KimbleOne__Timesheet__c.Label}, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact our {!$Label.kimbleone__emailtemplatesignature}. Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>