<messaging:emailTemplate subject="Revenue Recognition Milestone Rejected - {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.KimbleOne__Account__r.Name}" recipientType="User" relatedToType="KimbleOne__Milestone__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" alt="Company Logo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">MilestonRevenue Recognition Milestone <span style="font-family:Arial,sans-serif;color:#AF3135;font-weight:bold;">rejected</span>.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-top:10px;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Revenue Recognition Milestone in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneDate__c.Label}: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;"><apex:outputText value="{0, date, MMM-dd-yyyy}"> <apex:Param value="{!relatedTo.KimbleOne__MilestoneDate__c}" /> </apex:OutputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Value: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;"><apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"> <apex:param value="{!relatedTo.KimbleOne__InvoicingCurrencyMilestoneValue__c}" /> </apex:outputText></td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Reason: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr> </apex:OutputText> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">If you have any queries regarding this confirmation please contact the project owner.</td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td> </tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > The following Revenue Recognition Milestone has been REJECTED. --------------------------------------------------------------------------------------- Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name} Details <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}">Reason: {!relatedTo.KimbleOne__ApprovalComments__c}</apex:OutputText> Account: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.KimbleOne__Account__r.Name} Milestone: {!relatedTo.Name} Date Completed: {!relatedTo.KimbleOne__MilestoneDate__c} Value: {!relatedTo.KimbleOne__InvoicingCurrencyIsoCode__c} {!relatedTo.KimbleOne__InvoicingCurrencyMilestoneValue__c} --------------------------------------------------------------------------------------- If you have any queries regarding this confirmation please contact our {!$Label.kimbleone__emailtemplatesignature}. Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature} </messaging:plainTextEmailBody></messaging:emailTemplate>