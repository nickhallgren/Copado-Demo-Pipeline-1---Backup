<messaging:emailTemplate subject="Supplier Requisition {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__SupplierRequisition__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" alt="Company Logo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:15px;padding-bottom:12px;border-bottom-width:1px;border-bottom-style:solid;">Supplier Requisition has been <span style="font-family:Arial,sans-serif;color:#1a8d4a;font-weight:bold;">approved</span>.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-top:10px;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Supplier Requisition in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__SupplierRequisition__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__SupplierAccount__c.Label}: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__SupplierAccount__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__Description__c.Label}: </b></td> <td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__Description__c}</td></tr> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;"><apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c}<br/><br/> </apex:OutputText></td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">If you have any queries regarding this confirmation please contact the project owner, or [Primary Contact Name] on {!$Organization.Phone}, or [Contact Email]</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td> </tr> </table> </body> </html></messaging:htmlEmailBody> <messaging:plainTextEmailBody > Supplier Requisition {!relatedTo.Name} has been approved. {!$ObjectType.KimbleOne__SupplierRequisition__c.Label}: {!relatedTo.Name} {!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__SupplierAccount__c.Label}: {!relatedTo.KimbleOne__SupplierAccount__r.Name} {!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__Description__c.Label}: {!relatedTo.KimbleOne__Description__c} <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c} </apex:OutputText> Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature} </messaging:plainTextEmailBody></messaging:emailTemplate>