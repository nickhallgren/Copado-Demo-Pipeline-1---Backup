<messaging:emailTemplate subject="Delivery Element Stage {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__DeliveryElementStage__c"><messaging:htmlEmailBody >  <html>    <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;">        <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;">            <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr>            <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.Name}</td></tr>            <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;">                Your&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Delivery Stage</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">approved</span>.            </td></tr>        <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;">          <table style="font-family:Arial,sans-serif;border-collapse:collapse;">                 <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryStage__c.Fields.Name.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__DeliveryStage__r.Name}</td></tr>            <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ForecastStatus__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ForecastStatus__r.Name}</td></tr>            <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ContractRevenue__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">            <apex:outputText value="{0, number, {!relatedTo.KimbleOne__DeliveryElement__r.CurrencyIsoCode} #,##0.00}">                <apex:param value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ContractRevenue__c}"></apex:param>            </apex:outputText></td></tr>            <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}">                <tr><td align="right"  style="font-family:Arial,sans-serif;font-size:.8em;"><b>Comments: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr>            </apex:OutputText>          </table>        </td></tr>                                    <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} Operations Department</td></tr>        </table>    </body>  </html></messaging:htmlEmailBody><messaging:plainTextEmailBody >Delivery Stage {!relatedTo.KimbleOne__DeliveryElement__r.Name} has been approved.{!$ObjectType.KimbleOne__DeliveryStage__c.Fields.Name.Label}: <apex:outputText value="{!relatedTo.KimbleOne__DeliveryStage__r.Name}" /> {!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ForecastStatus__c.Label}: <apex:outputText value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ForecastStatus__r.Name}"/>                          {!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ContractRevenue__c.Label}: <apex:outputText value="{0, number, {!relatedTo.KimbleOne__DeliveryElement__r.CurrencyIsoCode} #,##0.00}">                           <apex:param value="{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__ContractRevenue__c}"></apex:param>                        </apex:outputText>    <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}">        Comments: {!relatedTo.KimbleOne__ApprovalComments__c}    </apex:OutputText>Regards {!$Organization.Name} Operations Department </messaging:plainTextEmailBody></messaging:emailTemplate>