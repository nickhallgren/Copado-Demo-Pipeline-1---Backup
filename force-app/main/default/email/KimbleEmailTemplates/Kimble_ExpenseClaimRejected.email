<messaging:emailTemplate subject="Your Expense Claim {!relatedTo.KimbleOne__Reference__c} has been rejected" recipientType="User" relatedToType="KimbleOne__ExpenseClaim__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px; border-bottom-width:1px;border-left-style:none;border-bottom-style:solid; border-right-style:none;"> <apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;border-bottom-width:1px;border-bottom-style:solid;"> Hi {!relatedTo.KimbleOne__Resource__r.KimbleOne__FirstName__c},<br/><br/> Your Expense Claim&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}"> {!relatedTo.KimbleOne__Reference__c}</apex:outputlink> has been <span style="font-family:Arial,sans-serif;color:#AF3135;font-weight:bold;">rejected</span>.<br/><br/> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c}<br/><br/> </apex:OutputText> Regards,<br/> {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody> <messaging:plainTextEmailBody > Hi {!relatedTo.KimbleOne__Resource__r.KimbleOne__FirstName__c},Your Expense Claim {!relatedTo.KimbleOne__Reference__c} has been rejected.<apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}">Comments: {!relatedTo.KimbleOne__ApprovalComments__c}</apex:OutputText> Regards, {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature} </messaging:plainTextEmailBody></messaging:emailTemplate>