<messaging:emailTemplate subject="Forecast Timesheet {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__ForecastTimesheet__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Your&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Forecast Timesheet</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">approved</span></td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Resource__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__Resource__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"><b>Activity:</b></td><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__ResourcedActivity__r.Name}</td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Comments: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr> </apex:OutputText> </table> </td></tr> <tr> <td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#c9dae6;color:#0f0f0f;text-align:left;border-color:#464b50;border-style:solid;border-width:1px;border-collapse:collapse;font-size:.7em;"> <tr> <th align="center" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__TimePeriod__c.Label}</th> <th align="center" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">Units ({!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__UsageUnitType__r.KimbleOne__Suffix__c})</th> <th align="center" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#8da8cd;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!$ObjectType.KimbleOne__ForecastTimeEntry__c.Fields.KimbleOne__Notes__c.Label}</th> </tr> <apex:repeat var="entry" value="{!relatedTo.KimbleOne__ForecastTimeEntries__r}"> <tr> <td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;"><apex:outputText value="{0,date, d MMM yyyy}"><apex:param value="{!entry.KimbleOne__TimePeriod__r.KimbleOne__StartDate__c}" /></apex:outputText></td> <td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!entry.KimbleOne__EntryUnits__c}</td> <td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;border-color:#464b50;border-style:solid;border-width:1px;padding:4px;">{!entry.KimbleOne__Notes__c}</td> </tr> </apex:repeat> </table> </td> </tr> <tr><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Your Forecast Timesheet has been approved. {!$ObjectType.KimbleOne__Resource__c.Label}: {!relatedTo.KimbleOne__Resource__r.Name} Activity: {!relatedTo.KimbleOne__ResourcedActivity__r.Name} <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c} </apex:OutputText> {!$ObjectType.KimbleOne__TimePeriod__c.Label}(days) | {!$ObjectType.KimbleOne__ForecastTimeEntry__c.Fields.KimbleOne__UtilisationPercentage__c.Label}(%) ---------------------------------------------------------------------------------------- <apex:repeat var="entry" value="{!relatedTo.KimbleOne__ForecastTimeEntries__r}"> <apex:outputText value="{0,date, d MMM yyyy}"><apex:param value="{!entry.KimbleOne__TimePeriod__r.KimbleOne__StartDate__c}" /></apex:outputText> | {!entry.KimbleOne__UtilisationPercentage__c} </apex:repeat> Regards {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature} </messaging:plainTextEmailBody></messaging:emailTemplate>