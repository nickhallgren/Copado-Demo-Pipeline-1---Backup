<messaging:emailTemplate subject="Forecast Timesheet on activity {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c} rejected" recipientType="User" relatedToType="KimbleOne__ForecastTimesheet__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Your&nbsp;<apex:outputlink value="{!SUBSTITUTE(LEFT($CurrentPage.URL,FIND('/',$CurrentPage.URL,9)),'://c.','://kimbleone.')+'apex/timesheet'}">Forecast Timesheet</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="color:#dd1d2e;">rejected</span></td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Resource__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__Resource__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"><b>Activity:</b></td><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__ResourcedActivity__r.Name}</td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Comments: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr> </apex:OutputText> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>Kimble Support</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Hi {!relatedTo.KimbleOne__Resource__r.Name}, The following forecast timesheet have been rejected. Activity: {!relatedTo.KimbleOne__ResourcedActivity__r.KimbleOne__FullName__c} If you have any queries regarding this confirmation please contact our {!$Label.kimbleone__emailtemplatesignature}. <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c} </apex:OutputText> Regards Kimble Support </messaging:plainTextEmailBody></messaging:emailTemplate>