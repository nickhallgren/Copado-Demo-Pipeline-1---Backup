<messaging:emailTemplate subject="You have been assigned the owner of a Delivery Engagement in Kimble" recipientType="User" relatedToType="KimbleOne__DeliveryGroup__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" alt="Company Logo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:15px;padding-bottom:12px;border-bottom-width:1px;border-bottom-style:solid;">You have been assigned as a Delivery Engagement owner in Kimble for the following engagement</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-top:10px;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Delivery Engagement in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Engagement: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ShortName__c} ({!relatedTo.KimbleOne__Reference__c})</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Account: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__Account__r.Name}</td></tr> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">If you have any queries regarding this confirmation please contact the project owner.</td> </tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td> </tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody >You have been assigned as a Delivery Engagement owner in Kimble for the following engagement:Engagement: {!relatedTo.KimbleOne__ShortName__c} ({!relatedTo.KimbleOne__Reference__c})Account: {!relatedTo.KimbleOne__Account__r.Name}Please log in to Kimble to view the engagement details.</messaging:plainTextEmailBody></messaging:emailTemplate>