<messaging:emailTemplate subject="Milestone Approval" recipientType="User" relatedToType="KimbleOne__Milestone__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;font-weight:bold;padding-top:10px;padding-bottom:8px;font-size:.8em;">Please confirm that the following Cost Milestone has been completed.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">Follow the&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Link</apex:outputlink> to view this Milestone in Kimble.</td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneDate__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> <apex:outputText value="{0, date, MMM-dd-yyyy}"> <apex:Param value="{!relatedTo.KimbleOne__MilestoneDate__c}" /> </apex:OutputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneValue__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"> <apex:param value="{!relatedTo.KimbleOne__MilestoneValue__c}" /> </apex:outputText></td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__Notes__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__Notes__c.label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__Notes__c}</td></tr> </apex:OutputText> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;">You can approve or reject this Milestone, by replying to this email and entering either <span style="font-family:Arial,sans-serif;color:#1a8d4a;font-weight:bold;">APPROVED</span> or <span style="font-family:Arial,sans-serif;color:#dd1d2e;font-weight:bold;">REJECTED</span> in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the project owner.</td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name} Please confirm that the following Cost Milestone has been completed. {!$ObjectType.KimbleOne__Milestone__c.Label}: {!relatedTo.Name} {!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneDate__c.Label}:<apex:outputText value="{0, date, MMM-dd-yyyy}"><apex:Param value="{!relatedTo.KimbleOne__MilestoneDate__c}" /></apex:OutputText> {!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneValue__c.Label}:<apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__MilestoneValue__c}" /></apex:outputText> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__Notes__c==null,'false','true')}">{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__Notes__c.label}: {!relatedTo.KimbleOne__Notes__c}</apex:OutputText> You can approve or reject this Milestone, by replying to this email and entering either APPROVED or REJECTED in the first line together with any comments in the second line. If you have any queries regarding this confirmation please contact the project owner.</messaging:plainTextEmailBody> </messaging:emailTemplate>