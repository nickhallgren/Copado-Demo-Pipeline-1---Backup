<messaging:emailTemplate subject="Revenue Revenue Recognition Milestone {!relatedTo.Name} Approved" recipientType="User" relatedToType="KimbleOne__Milestone__c"><messaging:htmlEmailBody > <html> <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;"> <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;"> <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr> <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;"> Your&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Revenue Milestone</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">approved</span>. </td></tr> <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;"> <table style="font-family:Arial,sans-serif;border-collapse:collapse;"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Account: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.KimbleOne__Account__r.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.Name}</td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneDate__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> <apex:outputText value="{0, date, MMM-dd-yyyy}"> <apex:Param value="{!relatedTo.KimbleOne__MilestoneDate__c}" /> </apex:OutputText></td></tr> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneValue__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"> <apex:param value="{!relatedTo.KimbleOne__MilestoneValue__c}" /> </apex:outputText></td></tr> <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>Comments: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__ApprovalComments__c}</td></tr> </apex:OutputText> <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__Notes__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.KimbleOne__Notes__c}</td></tr> </table> </td></tr> <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</td></tr> </table> </body> </html></messaging:htmlEmailBody><messaging:plainTextEmailBody > Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name} --------------------------------------------------------------------------------------- Your Revenue Recognition Milestone has been approved. Notes: {!relatedTo.KimbleOne__Notes__c} Account: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.KimbleOne__Account__r.Name} Milestone: {!relatedTo.Name} Date Completed: {!relatedTo.KimbleOne__MilestoneDate__c} Value: {!relatedTo.KimbleOne__InvoicingCurrencyIsoCode__c} {!relatedTo.KimbleOne__InvoicingCurrencyMilestoneValue__c} <apex:OutputText rendered="{!IF(relatedTo.KimbleOne__ApprovalComments__c==null,'false','true')}"> Comments: {!relatedTo.KimbleOne__ApprovalComments__c} </apex:OutputText> Regards, {!$Organization.Name} {!$Label.kimbleone__emailtemplatesignature}</messaging:plainTextEmailBody></messaging:emailTemplate>