<messaging:emailTemplate subject="Credit {!relatedTo.Name} Rejected" recipientType="User" relatedToType="KimbleOne__Credit__c">
    <messaging:htmlEmailBody >
        <html>
        <body style="font-family:Arial,sans-serif;background-color:#ffffff;color:#0f0f0f;text-align:left;">
        <table width="600px" align="left" style="font-family:Arial,sans-serif;margin-top:20px;">
            <tr><td style="font-family:Arial,sans-serif;padding-bottom:5px;padding-top:10px;padding-right:5px;border-bottom-width:1px;border-left-style:none;border-bottom-style:solid;border-right-style:none;"><apex:image id="KimbleLogo" value="{!$Setup.KimbleOne__KimbleOneConfigSetting__c.KimbleOne__EmailTemplateLogoURL__c}"/></td></tr>
            <tr><td style="font-family:Arial,sans-serif;line-height:1em;font-size:1em;font-weight:bold;padding-top:10px;padding-bottom:8px;border-bottom-width:1px;border-bottom-style:solid;">Reference: {!relatedTo.KimbleOne__DeliveryElement__r.KimbleOne__DeliveryGroup__r.Name}</td></tr>
            <tr><td style="font-family:Arial,sans-serif;line-height:1.3em;font-size:.9em;padding-top:15px;padding-bottom:12px;">
                    Your&nbsp;<apex:outputlink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+relatedTo.Id}">Credit</apex:outputlink> <b>{!relatedTo.Name}</b> has been <span style="font-family:Arial,sans-serif;color:#008752;font-weight:bold;">rejected</span>.
                </td></tr>
            <tr><td align="left" style="font-family:Arial,sans-serif;padding-bottom:10px;">
                    <table style="font-family:Arial,sans-serif;border-collapse:collapse;">
                        <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;"> {!relatedTo.Name}</td></tr>
                        <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditDate__c.Label}:</b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">
                                <apex:outputText value="{0, date, MMM-dd-yyyy}">
                                    <apex:Param value="{!relatedTo.KimbleOne__CreditDate__c}" />
                                </apex:OutputText></td></tr>
                        <tr><td align="right"  style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__Reference__c.label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">{!relatedTo.KimbleOne__Reference__c}</td></tr>
                        <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditValue__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">
                                <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.KimbleOne__CreditValue__c}" />
                                </apex:outputText></td></tr>
                        <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditUnits__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.KimbleOne__CreditUnits__c}" />
                                </apex:outputText></td></tr>
                        <tr><td align="right" style="font-family:Arial,sans-serif;font-size:.8em;"><b>{!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__UnitValue__c.Label}: </b></td><td style="font-family:Arial,sans-serif;font-size:.8em;">
                                <apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.KimbleOne__UnitValue__c}" />
                                </apex:outputText></td></tr>
                    </table>
                </td></tr>

            <tr><td style="font-family:Arial,sans-serif;font-size:.8em;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;">Regards<br/>{!$Organization.Name} {!$Label.EmailTemplateSignature}</td></tr>
        </table>
        </body>
        </html>
    </messaging:htmlEmailBody>
    <messaging:plainTextEmailBody >

        Your Credit has been rejected.

        {!$ObjectType.KimbleOne__Credit__c.Label}: {!relatedTo.Name}
        {!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditDate__c.Label}:<apex:outputText value="{0, date, MMM-dd-yyyy}"><apex:Param value="{!relatedTo.KimbleOne__CreditDate__c}" /></apex:OutputText>
        {!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__Reference__c.Label}:<apex:outputText value="{!relatedTo.KimbleOne__Reference__c}"></apex:OutputText>
        {!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditValue__c.Label}:<apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__CreditValue__c}" /></apex:outputText>
        {!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__CreditUnits__c.Label}:<apex:outputText value="{0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__CreditUnits__c}" /></apex:outputText>
        {!$ObjectType.KimbleOne__Credit__c.Fields.KimbleOne__UnitValue__c.Label}:<apex:outputText value="{!relatedTo.CurrencyIsoCode} {0,number,#,##0.00}"><apex:param value="{!relatedTo.KimbleOne__UnitValue__c}" /></apex:outputText>

        Regards,
        {!$Organization.Name} {!$Label.EmailTemplateSignature}

    </messaging:plainTextEmailBody>
</messaging:emailTemplate>