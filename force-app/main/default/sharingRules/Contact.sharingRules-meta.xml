<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>NZC_Sharing_with_ESG_Team_User</fullName>
        <accessLevel>Read</accessLevel>
        <label>NZC Sharing with ESG Team User</label>
        <sharedTo>
            <role>NZC</role>
        </sharedTo>
        <criteriaItems>
            <field>NZC__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Read_Edit_Contact_Records</fullName>
        <accessLevel>Edit</accessLevel>
        <description>8138:  Created to open back up access to Customer and Partner record types to trusted users.</description>
        <label>Read/Edit Contact Records</label>
        <sharedTo>
            <group>Trusted_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer,Partner</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Read_Only_Contacts</fullName>
        <accessLevel>Read</accessLevel>
        <description>Case 8138:  Created to open up access to contact records for Client Engagement Users and Service Cloud team members.</description>
        <label>Read Only Contacts</label>
        <sharedTo>
            <group>Client_Engagement_Team_Service_Cloud</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Customer,Partner</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Staff_Contact_Record_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Case 8138:  Created to restrict access to Contact records with the record type of &quot;Staff&quot; to certain individuals.</description>
        <label>Staff Contact Record Access - Edit</label>
        <sharedTo>
            <group>Staff_Contact_Record_Viewers</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Staff</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Staff_Contact_Record_Access_Read</fullName>
        <accessLevel>Read</accessLevel>
        <description>Case 8521:  Created to provide read only access for Staff Contact records.</description>
        <label>Staff Contact Record Access - Read</label>
        <sharedTo>
            <group>Staff_Contact_Record_Viewers_Read</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Staff</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
