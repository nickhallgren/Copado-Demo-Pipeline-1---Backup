<html> 
<head> 
<script src="/soap/ajax/19.0/connection.js" type="text/javascript"></script> 
<script src="/soap/ajax/19.0/apex.js" type="text/javascript"></script> 
<script type="text/javascript"> 

function setupPage() 
{ 

var BOX_DOMAIN = 'www.box.net';

// get page 
var current_url = parent.location.href; 
var current_id = current_url.substr(current_url.length -15); 
var record = sforce.apex.execute('box.Box_Salesforce_Web_Service', 'getRecord', {recordId: current_id}); 

// this sucks, but there is no way to get record type after being processed by apex.js 
var record_type = sforce.apex.execute('box.Box_Salesforce_Web_Service', 'getRecordType', {recordId: current_id}); 

if (record.length == 0) return; 
record = record[0]; 

// email_recipients 
email_recipients = ""; 
if (record.Email) 
{ 
var email_recipients = record.Email; 
} 

// api 
var src = 'https://' + BOX_DOMAIN + '/static/flash/box_explorer.swf'; 
var params = '&api_key=haxkxreiq4cm12iy8ulr5dd6028y2hlj' + '&module_url=https://www.box.net/static/flash/module_salesforce.swf'; 
var widget_api_urls = ''; 
if (BOX_DOMAIN != 'www.box.net') widget_api_urls = '&api_domain=' + BOX_DOMAIN; 

// flash 
var server_url = '{!API.Partner_Server_URL_120}'; 
var auth_token = '{"server_url":"' + server_url + '","session_id":"{!User.Session_ID}"}'; 
src = src + '?module_url=https%3A%2F%2F' + BOX_DOMAIN + '%2Fstatic%2Fflash%2Fmodule_salesforce.swf%3Fnew_version%3D1' + widget_api_urls + '&sri=1&partner_auth_token=' + escape(auth_token) + '&partner_object_type=' + escape(record_type) + '&partner_object_name=' + escape(record.Name) + '&partner_object_email=' + escape(email_recipients) + '&partner_object_id=' + escape(current_id) + '&salesforce_object_typed_id=' + escape(current_id) + '&open_new_window=1&partner_user_id={!URLENCODE($User.Id)}&partner_user_name={!URLENCODE($User.FirstName)}%20{!URLENCODE($User.LastName)}&partner_user_email={!URLENCODE($User.Email)}&email_recipients=' + escape(email_recipients); // + '&debug=1'; 

// write 
document.write('<embed pluginspage="http://www.macromedia.com/go/getflashplayer" src="' + src + '" width="100%" height="100%" name="box_net_widget" allowscriptaccess="always"></embed>'); 
document.close(); 
return false; 
} 

</script> 
</head> 
<body onload="setupPage()"> 
</body> 
</html>