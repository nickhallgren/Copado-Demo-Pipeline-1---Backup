					margin-right: 2px;
				}
				.delivery-group-print-icon {
					font-size: 18px;
					position: relative;
					left: -26px;
					top: -8px;
					color: #6F6F6F;
				}
				.delivery-program-indicator,
				.delivery-portfolio-indicator {
					margin-left: 10px;
					color: #428BCA;
					font-size: 16px;
				}
				.delivery-portfolio-indicator {
					cursor: pointer;
				}
				.dgde-tip-qtip {
					background-color: lemonchiffon;
					padding: 2px;
					font-size: 12px;
				}
				i.card-filter-icon {
				    display: none;
				}

				.loadingIndicator {
				   top:0;
				   right:0;
				   width:100%;
				   height:100%;
