	    function CreateNewInvoicingElementForAssignments(activityAssignmentIds, scopingElementId)
	    {
	    	var newDeliveryElementName = "";
	        activityAssignmentIds.forEach(function(assignmentToUpdateId) {
	        	// default the name of the new delivery element based on the first revenue item
			    var targetRow = jQuery("input[revenue-generation-item-id='" + assignmentToUpdateId + "']").parent().parent();

	        	if(newDeliveryElementName == "")
	        	{
	        		// based on the assignment type we'll take the values from the table
	        		newDeliveryElementName = targetRow.attr('revenue-generation-item-label');
	        	}
	        	
	        	jQuery(targetRow).find('input').parent().removeClass('Pending');
	        	jQuery(targetRow).find('input').parent().addClass('Loading');
			});
	        
			
	                
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupBudgetsController.CreateInvoicingContainerForAssignments}',
                activityAssignmentIds, scopingElementId, newDeliveryElementName, 
                    function(result, event){          
                        if (event.status) 
                        {
					        activityAssignmentIds.forEach(function(assignmentToUpdateId) {
							    var targetRow = jQuery("input[revenue-generation-item-id='" + assignmentToUpdateId + "']").parent().parent();
					        	jQuery(targetRow).find('input').parent().removeClass('Loading');
					        	jQuery(targetRow).find('input').parent().addClass('Completed');
							});
                        	
                        	// do a blanket refresh
                        	refreshAfterDragAndDrop();
                        } 
                        else if (event.type === 'exception') 
                        {
                            alert(event.message);
                        } 
                        else 
                        {
                            alert(event.message);
                        }
                }, 
                {escape: true, timeout: 60000}
            );
	    }

