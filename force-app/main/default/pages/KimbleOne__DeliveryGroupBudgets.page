		function selectRevenueGenerationItems(deliveryElementId)
		{
			// first get the value of the checked checkbox, then use this to check or uncheck the child checkboxes - ignore any disabled checkboxes
			jQuery("[delivery-element-id='" + deliveryElementId + "'][name='select-revenue-generation-item']").not(":disabled").prop('checked', jQuery("[delivery-element-id='" + deliveryElementId + "'][name='select-all-revenue-generation-items']").prop('checked'));
			
			var theParentElement = jQuery("[delivery-element-id='" + deliveryElementId + "'][name='select-revenue-generation-item']").closest('.element-with-detail-container');
			var theDropZone = jQuery(theParentElement).find('.dropzone-targets-container');
			
			if(jQuery(theParentElement).find("input:checkbox:checked").length == 0)
			{
				jQuery(theDropZone).hide('fade');
			}
			else
			{
				jQuery(theDropZone).show('fade');
			}		
		}

		function selectRevenueGenerationItem(itemId)
		{
			// first get the value of the checked checkbox then if checked reveal the dropzones on this element
			var theCheckbox = jQuery("[revenue-generation-item-id='" + itemId + "'][name='select-revenue-generation-item']");
			var checkstate = jQuery(theCheckbox).prop('checked');
			var theParentElement = jQuery(theCheckbox).closest('.element-with-detail-container');
			var theDropZone = jQuery(theParentElement).find('.dropzone-targets-container');
			
			if(checkstate == true)
			{
				jQuery(theDropZone).show('fade');
			}
			else
			{
				// if all checkboxes on this item are unchecked then hide the dropzone (ignore the select all checkbox)
				if(jQuery(theParentElement).find("input:checkbox:checked[revenue-generation-item-id]").length == 0)
				{
					jQuery(theDropZone).hide('fade');
				}
			}		
		}
		
		function unselectAllRevenueGenerationItems()
		{
			jQuery("[name='select-revenue-generation-item']").prop('checked', '');
			jQuery("[name='select-all-revenue-generation-items']").prop('checked', '');
		}
		
