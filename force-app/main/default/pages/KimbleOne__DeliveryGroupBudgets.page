	<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
	<div style="display:none;" kimble-tip="null"></div>

	<script>


	    function refreshDetailMode() {
	    	// this function allows us to reset the
	    	// detail view if the main elements panel has been rerendered
	    	if((typeof detailModeSetting == 'undefined') || detailModeSetting == true)
	    	{
	    		detailMode();
	    	}
	    	else
	    	{
	    		summaryMode();
	    	}
	    }

		function toggleDetailMode() {
			jQuery("#detailMode").toggleClass('fa-toggle-off');
			jQuery("#detailMode").toggleClass('fa-toggle-on');

			jQuery(".element-detail-item").toggleClass('po-hidden-item');

			detailModeSetting = jQuery("#detailMode").hasClass('fa-toggle-on');
		}

		function summaryMode() {
			jQuery("#detailMode").addClass('fa-toggle-off');
			jQuery("#detailMode").removeClass('fa-toggle-on');

			jQuery(".element-detail-item").addClass('po-hidden-item');

			// reset any override widths that were in place when in detail mode
			jQuery(".delivery-element-card").css({"width":""});

			detailModeSetting = false;
		}

		function detailMode() {
			jQuery("#detailMode").removeClass('fa-toggle-off');
			jQuery("#detailMode").addClass('fa-toggle-on');

			jQuery(".element-detail-item").removeClass('po-hidden-item');

			// adjust the element divs so that they are all the same width
			var maxDivWidth = Math.max.apply(Math, jQuery(".delivery-element-card").map(function(){ return jQuery(this).width(); }).get());

			jQuery(".delivery-element-card").width(maxDivWidth);

			detailModeSetting = true;
		}

		function splitDeliveryElementForPOAllocation(elementId)
		{
			jQuery(".po-item-checkbox.po-hidden-item[delivery-element-id='" + elementId + "']").removeClass("po-hidden-item");
		}

		function deleteThisInvoicingContainer(elementId)
		{
	        var del = false;

	        del = confirmDelete();

	        if (del)
	        {
				updatesPending = 1;
				jQuery("div[delivery-element-id='" + elementId + "']").find('.burger-menu').removeClass('fa fa-bars').addClass('Loading').css('width', 18).css('height', 18);
				DeleteInvoicingContainer(elementId);
			}
		}

		function initialiseDragAndDrops()
		{
			jQuery(".draggable-item").draggable({
				  revert: "invalid"
				  ,helper: function(){
				  	// the dragged item is actually always the individual item that was clicked
				  	// when dragging even if there is a collection, so get a handle on the item being dragged and then use this to derive the parent
				  	// then get all the items for that parent that have checked checkboxes
				  	var originalParentElementId = jQuery(this).closest(".element-with-detail-container").attr('delivery-element-id');
				    var originalParentElementRevGenType = jQuery(this).closest(".element-with-detail-container").attr('delivery-element-id');

				    var selectedItems = jQuery(".draggable-item input:checked[delivery-element-id='" + originalParentElementId + "']").parent().parent();

				    // surround the rows with a drag container, find the delivery element containing these rows and attribute the
				    // drag container with the id so that we can refuse drop on the same element
				    var container = jQuery("<div class='draggable-item dynamic-drag-container' revenue-generation-type='" + originalParentElementRevGenType + "' parent-delivery-element-id='" + originalParentElementId + "'/>").attr('id', 'draggingContainer');

				    container.append(selectedItems.clone());
				    // remove all the checkboxes from the draggable clone
				    container.find('input:checked').remove();

				    return container;
				  }
			});

			jQuery( ".revenue-generation-item-drop-target" ).droppable({
					accept: function(ev, ui) {

						var droppingOn = jQuery(this);
						var targetParentElementId = jQuery(droppingOn).closest(".element-with-detail-container").attr('delivery-element-id');
						var targetParentScopingElementId = jQuery(droppingOn).closest(".element-with-detail-container").attr('scoping-element-id');
						var targetParentElementRevGenType = jQuery(droppingOn).closest(".element-with-detail-container").attr('revenue-generation-type');

						var draggingParentElementId = jQuery(ev).find('input:checkbox').attr('delivery-element-id');
						var draggingParentScopingElementId = jQuery(ev).find('input:checkbox').attr('scoping-element-id');
						var draggingParentElementRevGenType = jQuery(ev).find('input:checkbox').attr('revenue-generation-type');
						// determine if this element supports the type of revenue item being dragged and confirm that it's not the original
						// also we must be within the scope of the same scoping container
						return (targetParentElementId != draggingParentElementId)
								&& (targetParentElementRevGenType == draggingParentElementRevGenType)
								&& (targetParentScopingElementId == draggingParentScopingElementId)
								&& (droppingOn.find('.revenue-generation-items-container tbody').length > 0);
					},
					//greedy: true,	// ensure the elements pick up the drop before the parent
					activeClass: "active-draggable-item",
				    hoverClass: "draggable-item-target-hover",
				    tolerance: "pointer",
				    drop: function(ev, ui) {
				        // dropped item is a cloned version of the original rows wrapped in a container
				        // get the delivery element Id from this clone then use it to look up which revenue elements in that container have their checkboxes checked
				        var droppedDeliveryElementId = jQuery(ui.helper).attr('parent-delivery-element-id');
				        var dropped = jQuery(".draggable-item input:checked[delivery-element-id='" + droppedDeliveryElementId + "']").parent().parent();
						// get a list of all the revenue items being moved
						var revenueGenerationItemsIds = jQuery(dropped).find('input').map(function(){return jQuery(this).attr('revenue-generation-item-id');}).get();
						// get the type of the item for switch later to call the right service
						var revenueGenerationType = jQuery(dropped).closest('.element-with-detail-container').attr('revenue-generation-type');

						updatesPending = 1;

				        var droppedOn = jQuery(this);
						var targetDeliveryElementId = droppedOn.closest('.element-with-detail-container').attr('delivery-element-id');

				        // find the revenue items table in this element
				        var revenueItemTableTarget = droppedOn.find('.revenue-generation-items-container tbody');

				        // ensure that the drop target is visible (it would be hidden if the table previously contained no items but supported items of this type)
				        jQuery(droppedOn).find('.revenue-generation-items-container').parent().removeClass('empty-table');

				        var existingCellWidth = jQuery(dropped).find('input[name="select-revenue-generation-item"]').parent().width();
				        jQuery(dropped).find('input[name="select-revenue-generation-item"]').parent().empty().attr('width', existingCellWidth).addClass('Loading');

				        jQuery(dropped).detach().appendTo(revenueItemTableTarget);

						// clean up any lingering dragging containers
						jQuery('.dynamic-drag-container').remove();

						// remove the dropzone targets
						jQuery('.dropzone-targets-container').hide('fade');

						if(revenueGenerationType == "assignment")
						{
							UpdateAssignmentInvoicingContainer(revenueGenerationItemsIds, targetDeliveryElementId);
						}
						else if(revenueGenerationType == "milestone")
						{
							UpdateMilestoneInvoicingContainer(revenueGenerationItemsIds, targetDeliveryElementId);
						}
						else if(revenueGenerationType == "period-revenue")
						{
							UpdateAnnuityInvoicingContainer(revenueGenerationItemsIds, targetDeliveryElementId);
						}
				    }
			});

			jQuery( ".create-new-element-drop-target" ).droppable({
					accept: ".draggable-item",
					activeClass: "active-draggable-item",
					greedy: true,
				    hoverClass: "draggable-item-create-new-element-target-hover",
				    tolerance: "pointer",
				    drop: function(ev, ui) {
				        // dropped item is a cloned version of the original rows wrapped in a container
				        // get the delivery element Id from this clone then use it to look up which revenue elements in that container have their checkboxes checked
				        var droppedDeliveryElementId = jQuery(ui.helper).attr('parent-delivery-element-id');
				        // get a handle on the row being dropped
				        var droppedRow = jQuery(".draggable-item input:checked[delivery-element-id='" + droppedDeliveryElementId + "']").parent().parent();
						// get a list of all the revenue items being moved
						var revenueGenerationItemsIds = jQuery(droppedRow).find('input').map(function(){return jQuery(this).attr('revenue-generation-item-id');}).get();
						// get the type of the item for switch later to call the right service
						var revenueGenerationType = jQuery(droppedRow).closest('.element-with-detail-container').attr('revenue-generation-type');

						updatesPending = 1;

						// remove the checkbox on the dropped row and replace with a loading indicator
						// also disable and uncheck the boxes to ensure they can't be used whilst the save is happening
						jQuery(droppedRow).find('input').parent().addClass('Pending');
						jQuery(droppedRow).find('input').hide();
						jQuery(droppedRow).find('input').attr('disabled', 'disabled');
						jQuery(droppedRow).find('input').attr('checked', false);

						// disable the menu on the element container and replace with a loading indicator
						var elementContainer = droppedRow.closest('.element-with-detail-container');
						jQuery(elementContainer).find('.burger-menu').removeClass('fa fa-bars').addClass('Loading').css('width', 18).css('height', 18);

						// clean up any lingering dragging containers
						jQuery('.dynamic-drag-container').remove();

						// remove the dropzone targets
						jQuery('.dropzone-targets-container').hide('fade');

						// UI prep complete, call the service to do the work
						if(revenueGenerationType == "assignment")
						{
							CreateNewInvoicingElementForAssignments(revenueGenerationItemsIds, droppedDeliveryElementId);
						}
						else if(revenueGenerationType == "milestone")
						{
							CreateNewInvoicingElementForMilestones(revenueGenerationItemsIds, droppedDeliveryElementId);
						}
						else if(revenueGenerationType == "period-revenue")
						{
							CreateNewInvoicingElementForAnnuities(revenueGenerationItemsIds, droppedDeliveryElementId);
						}
				    }
			});

			jQuery( ".create-new-element-for-each-drop-target" ).droppable({
					accept: ".draggable-item",
					activeClass: "active-draggable-item",
					greedy: true,
				    hoverClass: "draggable-item-create-new-element-target-hover",
				    tolerance: "pointer",
				    drop: function(ev, ui) {
				        // dropped item is a cloned version of the original rows wrapped in a container
				        // get the delivery element Id from this clone then use it to look up which revenue elements in that container have their checkboxes checked
				        var droppedDeliveryElementId = jQuery(ui.helper).attr('parent-delivery-element-id');
				        // get a handle on the row being dropped
				        var droppedRow = jQuery(".draggable-item input:checked[delivery-element-id='" + droppedDeliveryElementId + "']").parent().parent();
						// get a list of all the revenue items being moved
						var revenueGenerationItemsIds = jQuery(droppedRow).find('input').map(function(){return jQuery(this).attr('revenue-generation-item-id');}).get();
						// get the type of the item for switch later to call the right service
						var revenueGenerationType = jQuery(droppedRow).closest('.element-with-detail-container').attr('revenue-generation-type');

						updatesPending = revenueGenerationItemsIds.length;

						// disable the menu on the element container and replace with a loading indicator
						var elementContainer = droppedRow.closest('.element-with-detail-container');
						jQuery(elementContainer).find('.burger-menu').removeClass('fa fa-bars').addClass('Loading').css('width', 18).css('height', 18);

						// clean up any lingering dragging containers
						jQuery('.dynamic-drag-container').remove();

						// remove the dropzone targets
						jQuery('.dropzone-targets-container').hide('fade');

					    // for each assignment that requires update
					    revenueGenerationItemsIds.forEach(function(revenueItemToUpdateId) {
						    var targetRow = jQuery("input[revenue-generation-item-id='" + revenueItemToUpdateId + "']").parent().parent();
				        	jQuery(targetRow).find('input').parent().addClass('Pending');
							jQuery(targetRow).find('input').hide();
							jQuery(targetRow).find('input').attr('disabled', 'disabled');
							jQuery(targetRow).find('input').attr('checked', false);

							var revenueItemsToUpdate = [revenueItemToUpdateId];

							// UI prep complete, call the service to do the work
							if(revenueGenerationType == "assignment")
							{
								CreateNewInvoicingElementForAssignments(revenueItemsToUpdate, droppedDeliveryElementId);
							}
							else if(revenueGenerationType == "milestone")
							{
								CreateNewInvoicingElementForMilestones(revenueItemsToUpdate, droppedDeliveryElementId);
							}
							else if(revenueGenerationType == "period-revenue")
							{
								CreateNewInvoicingElementForAnnuities(revenueItemsToUpdate, droppedDeliveryElementId);
							}
						});
				    }
			});
		}

		// these calls are made here to ensure they fire everytime this form panel is re-rendered
		jQuery(document).ready(function()
		{
			refreshDetailMode();
			initialiseDragAndDrops();
			initialisePageTips();
		});
	</script>

    </apex:form>

