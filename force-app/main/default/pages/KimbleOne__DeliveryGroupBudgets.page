	    function deletePurchaseOrderAllocation(id, obj)
	    {
	        if (POdeleteRunning) return;
	        
	        POdeleteRunning = true;
	        
	        var del = false;
	    
	        del = confirmDelete();
	     
	        if (del)
	        {
				// replace the edit and trash icons with a loading indicator
				// get the width of the td to minimise the shudder effect when removing and replace the contents
				var existingCellWidth = jQuery('a[allocation-id="' + id + '"]').parent().width();       
	            jQuery('a[allocation-id="' + id + '"]').parent().empty().attr('width', existingCellWidth).addClass('Loading');
	        
	            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupBudgetsController.DeleteAllocation}',
	                id,
	                    function(result, event){          
	                        if (event.status) 
	                        {
	                        	// get a handle on the PO table before we start removing the rows
	                        	var POAllocationTable = jQuery('tr[allocation-id="' + id + '"]').parent().parent();
	                        	
	                            // remove the PO allocation rows relating to this Id
	                            jQuery('tr[allocation-id="' + id + '"]').remove();
	                            
	                            // if the PO allocation table is now empty, remove that too
	                            // (signified by there being only 1 TR representing the header line)
	                            if(POAllocationTable.find('tr').length == 1)
	                                 POAllocationTable.remove();                                        
	                        } 
	                        else if (event.type === 'exception') 
	                        {
	                            alert(event.message);
	                        } 
	                        else 
	                        {
	                            alert(event.message);
	                        }
	                        
	                        POdeleteRunning = false;
	                }, 
	                {escape: true, timeout: 60000}
	            );
	        
	        }
	    }	

