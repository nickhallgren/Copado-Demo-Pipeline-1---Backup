<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupBudgetsController,KimbleOne.TooltipsController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__DeliveryGroup__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
     <c:Menu MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}" DefaultHelpPage="BudgetsPOs.html"/>
    </apex:define>
    
   	<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
		
	<!-- Kimble Guidance -->
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
	<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/DeliveryGroupBudgetsNarratives/' + UserNarrativeLanguageCode + '.js')}" />

		<apex:outputPanel layout="none" rendered="{!DeliveryGroupBudgetsTipOverrideEnabled}">
			<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
		</apex:outputPanel>
	</apex:outputPanel>
    	
	<style>
	
		.Loading 
		{
			background-image: url('{!URLFOR($Resource.KimbleOne__JobImages, 'running16.gif')}') !important;
			background-repeat:no-repeat !important;
			background-position: 50%, 50%;
		}
		
		.Pending
		{
			background-image: url('{!URLFOR($Resource.KimbleOne__JobImages, 'pending16.gif')}') !important;
			background-repeat:no-repeat !important;
			background-position: 50%, 50%;
		}
		
		.Completed
		{
			background-image: url('{!URLFOR($Resource.KimbleOne__JobImages, 'completed16.gif')}') !important;;
			background-repeat:no-repeat !important;
			background-position: 50%, 50%;
		}

		.draggable-item {
			cursor: pointer;
		}
				
		.draggable-item-target-hover, .draggable-item-create-new-element-target-hover {
			background-color: #90EE90 !important;
			border: 1px dashed #808080;
		}
			
		.dynamic-drag-container {
			width: 350px;
			background-color: rgba(232, 232, 232, 0.5);
			z-index: 9999;
		}
		
		.dropzone-column {
			padding: 10px;
			margin: 1px 4px 1px 4px;
			background-color: #DDD;
			float: left;
			width: 337px;
			height: 28px;
			text-align: center;
			border: 1px dashed #808080;
		}
		
		.delivery-element-group
		{
			margin-right: 7px !important;
			background-color: #F5F5F5;
		}
			
		.delivery-element-group-title
		{
			display: inline-block;
			white-space: normal;
		}
		
		.delivery-element-name {
			width: 400px;
		}

		#delivery-element-groups-container {
	/* scroll across */
	/* 		overflow-x: hidden; */
	/* 		white-space: nowrap; */
	/* end scroll across */
	    	padding: 7px;
	    	border-radius: 4px;
			/* ensures that the burger menu will not be cropped */
	    	padding-bottom: 55px;
		}
		
		.delivery-elements-container {
			margin-left: 10px;
			margin-right: 10px;
			margin-bottom: 3px;
			margin-top: 10px;
		}
		.delivery-element-header
		{
	 		height: 18px;
	 	}
	 	
		.delivery-element-card {
			position: relative;
			margin-top: 3px;
			padding: 15px;
		    box-shadow: rgba(31, 31, 31, 0.16) 1px 2px 5px 1px;
		    background-color: #FFF;
			/* remove this to make the delivery element cards all the same width */
		    display: inline-block;
/* 		    TODO: need a better way of fixing this width */
		    min-width: 416px;
		    border-radius: 2px;
		}	
		
		.delivery-element-invoicing-container-title
		{
			display: inline-block;
			max-width: 320px;
			font-size: 12px;
			font-weight: bold;
			font-style: italic;
			white-space: normal;
		}
	
		.element-porule-label
		{
			vertical-align: top;
			display: inline-block;
		}
		
		.element-porule-value
		{
			max-width: 377px;
			vertical-align: top;
			display: inline-block;
			white-space: normal;
		}
		
		.element-credit-label {
    		vertical-align: top;
		    display: inline-block;
		    margin-top:16px;
		}
		
		.credit-allocation-table {
		    margin-top: 10px;
		    width: 100%;
		    border-top: 2px solid #EDEDED;
		    padding-top: 6px;
		}
				
		.delivery-element-group-details-footer
		{
			margin-left: 10px;
	    	margin-right: 10px;
	    	margin-bottom: 10px;
	    	margin-top: 10px;
	    	text-align: right;	
		}
		
		span.amountLabel {
		    font-weight: bold;
		    padding-right: 10px;
		}
	
		.element-po-details
		{
			margin-top: 12px;
		}
		
		.delivery-element-footer
		{
			display: inline-block;
		}

		.card {
			border: 1px solid rgba(0, 0, 0, 0);
			border-radius: 4px;
			-webkit-box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
			box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
			display: inline-block;
			border-color: #DDD;
			margin: 2px;
			vertical-align: top;
		}
	
		.disabled-link {
		    cursor: default !important;    
		    color: #ddd !important;
		}
		
		td.amount-Label {
		    font-weight: bold;
		    padding-right: 5px;
		    padding-left: 5px;
		    text-align: right;
		}

		td.amount-value {
		    min-width: 50px;
		}

		.element-budgets-table {
			border-bottom: 2px solid #EDEDED;
			padding-bottom: 6px;
			width: 100%;
		}
		
		.element-po-allocation-table {
			margin-top: 10px;
			width: 100%;
		}

		.deposit-allocation-table {
		    margin-top: 10px;
		    width: 100%;
		    border-top: 2px solid #EDEDED;
			padding-top: 6px;
		}
				
		.element-assignment-table, .element-period-revenue-table, .element-revenue-milestone-table {
		   width: 100%;		
		}
			
		.numeric-value {
			text-align: right;
		}
		
		.inline-value-table {
			display: block;
			padding-bottom: 3px;
		}
		
 		.inline-indicator {
			margin-right: 5px;
		}
		
		.revenue-generation-items-tile, .period-revenues-tile, .revenue-milestones-tile {
			width: 350px;
			margin-left: 10px;
			border-left: 2px solid #EDEDED;
			padding-left: 6px;
		}
		
		.element-with-detail-container {
			margin-bottom: 12px;
			margin-right: 10px;
			
			/* comment 2 display and float to make the elements flow down the left */ 
/* 			display: inline-block;  */
/* 			float: left;  */
		}
		
		.primary-element-container {
    		display: inline;
		}
		
		.delivery-element-body-column {
			float: left;
		}
		
		.delivery-element-body-column-right {
			float: right;
		}
		
		.detail-mode-toggle-container {
			float: right;
			vertical-align: middle;
			font-size: 13px;
			cursor: pointer;
			margin-bottom: 8px;
		}
		
		.dropzone-targets-container {
			padding-top: 10px;
		}
		
		.delivery-group-container {
			width: 100%
		}
		
		.delivery-group {
			width: 99%
		}
		
		.delivery-group-header {
			background-color: #F5F5F5;
			border-color: #DDD;
		}
		
		#detailMode {
			font-size: 20px;
			padding-left: 4px;
			padding-right: 4px;
		}
		
		.checkbox-col {
			width: 20px;
		}
		
		.empty-table {
			display: none;
		}
		
		.cap-error {
			color: #428BCA;
			font-size: 14px;
			margin-right: 7px;
		}
		.po-hidden-item {
			display: none;
		}
	</style>
	
	<apex:form id="TheForm">
		<apex:outputPanel id="PageErrors" layout="none">
			<apex:pageMessages escape="false" />
		</apex:outputPanel>

	<apex:outputPanel layout="block" id="ComponentContainer">

	<div id="delivery-element-groups-container">
			
		<div id="{!TheDeliveryGroupId}" class="delivery-group-container cardContainer">
			<div class="delivery-group card">
				<div id="deliveryGroupHeader" class="delivery-group-header cardHeading">
					<div class="delivery-element-group-title">
						<div class="card-heading-icon kimble-probability {!TheDeliveryGroupForecastStatusStyle} fa fa-square" title="{!TheDeliveryGroupForecastStatusName}"></div>
						<h3 class="cardTitle"><a class="undecorated-link" href="/{!TheDeliveryGroupId}"><apex:outputText value="{!TheDeliveryGroupShortName}"/></a></h3>
					</div>
					<div id="deliveryGroupBurgerMenu" data-floating-dropdown="#{!TheDeliveryGroupId}-menu-data" class="fa fa-bars delivery-group-po-menu burger-menu"></div>
					<div id="{!TheDeliveryGroupId}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
						<ul class="floating-dropdown-menu">
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__PurchaseOrderAllocation__c.createable && CanCreateNewPOAllocation == true}">
								<li id="allocatePurchaseOrderEngagement"><apex:commandLink action="{!NewPurchaseOrderAllocation}"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__allocatepurchaseorderbutton}</apex:commandLink></li>
							</apex:outputPanel>
						</ul>
					</div>
					<div id="summaryToggle" class="detail-mode-toggle-container">
						<span class="undecorated-link" onclick="summaryMode()">{!$Label.SummaryHeading}</span>
						<span id="detailMode" onclick="toggleDetailMode()" class="k-tgl fa fa-toggle-on"></span>
						<span class="undecorated-link" onclick="detailMode()">{!$Label.DetailsHeading}</span>
					</div>		
				</div>
			</div>
		</div>
		
		<apex:outputPanel id="scopingElementContainer">
		<apex:repeat value="{!scopingElements}" var="scopingElement">
			<apex:variable value="{!ScopingElementMap[scopingElement.Id]}" var="scopingElementElements"/>
			<div id="{!scopingElement.Id}" class="group-container cardContainer">
				<div id="deliveryElementGroupCard" class="delivery-element-group card">
					<div class="delivery-element-group-header cardHeading">
						<div class="card-heading-icon kimble-probability {!scopingElement.ForecastStatus__r.StyleClass__c} fa fa-square" title="{!scopingElement.ForecastStatus__r.Name}"></div>
						<div id="deliveryElementGroupCardTitle" class="delivery-element-group-title">
							<h3 class="cardTitle"><a class="undecorated-link" href="/{!scopingElement.Id}"><apex:outputText value="{!scopingElement.Name}"/></a></h3>
						</div>
					</div>
	
					<div class="primary-elements-container">						
							<div class="delivery-elements-container">
							<apex:repeat value="{!scopingElementElements}" var="element">
								<apex:variable value="{!isResourcedMap[element.Id]}" var="hasBudget"/>
								<apex:variable value="{!ActivityAssignmentMap[element.Id]}" var="elementAssignments"/>
								<apex:variable value="{!AnnuityMap[element.Id]}" var="elementAnnuities"/>
								<apex:variable value="{!RevenueMilestoneMap[element.Id]}" var="elementRevenueMilestones"/>
								<apex:variable value="{!PurchaseOrderAllocationMap[element.Id]}" var="POAllocations"/>
								<apex:variable value="{!DepositAllocationMap[element.Id]}" var="elementDeposits"/>
								<apex:variable value="{!CreditAllocationMap[element.Id]}" var="elementCredits"/>

								<apex:variable value="{!POAllocations.size > 0}" var="hasPOAllocations"/>
								<apex:variable value="{!element.Product__r.ProductDomain__r.IsResourced__c && element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsUsageGenerated__c && !element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsUsageNotional__c}" var="elementSupportsAssignments"/>
								<apex:variable value="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsMilestoneGenerated__c}" var="elementSupportsMilestones"/>
								<apex:variable value="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsPeriodGenerated__c}" var="elementSupportsAnnuities"/>
								
								<div class="element-with-detail-container" scoping-element-id="{!scopingElement.Id}" delivery-element-id="{!element.Id}" revenue-generation-type="{!IF(elementSupportsAssignments, 'assignment' ,'')}{!IF(elementSupportsMilestones, 'milestone' ,'')}{!IF(elementSupportsAnnuities, 'period-revenue' ,'')}">
									<div class="primary-element-container">
										<div class="delivery-element-card{!IF(elementSupportsAssignments || elementSupportsMilestones || elementSupportsAnnuities, ' revenue-generation-item-drop-target' ,'')}">
											<div class="delivery-element-header">
												<div class="delivery-element-invoicing-container-title"><apex:outputText value="{!element.Name}" rendered="{!scopingElementElements.size > 1}"/></div>
												<apex:outputPanel rendered="{!$ObjectType.KimbleOne__PurchaseOrderAllocation__c.createable || (HasAccountCredit && $ObjectType.KimbleOne__CreditAllocation__c.createable)}">
												<div data-floating-dropdown="#{!element.Id}-menu-data" class="fa fa-bars burger-menu"></div>
												
												<div id="{!element.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
										   			 <ul class="floating-dropdown-menu">
														<apex:outputPanel layout="none" rendered="{!scopingElementElements.size > 1 && $ObjectType.KimbleOne__DeliveryElement__c.fields.name.updateable}">
											        		<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="initialiseModalBoxy('#DeliveryElementNamePopup', '{!JSENCODE($Label.kimbleone__edit)} {!$Label.kimbleone__name}');loadDeliveryElement('{!JSENCODE(element.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__edit} {!$Label.Name}</apex:outputLink></li>
														</apex:outputPanel>
														
														<apex:outputPanel layout="none" rendered="{!hasBudget && $ObjectType.KimbleOne__DeliveryElement__c.updateable}">
											        		<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="initialiseModalBoxy('#DeliveryElementCapPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$Label.kimbleone__deliverygroupbudgetsheading}');loadDeliveryElement('{!JSENCODE(element.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__edit} {!$Label.DeliveryGroupBudgetsHeading}</apex:outputLink></li>
														</apex:outputPanel>
														<apex:outputPanel layout="none" rendered="{!!hasBudget || !$ObjectType.KimbleOne__DeliveryElement__c.updateable}">
											        		<li><apex:outputLink styleClass="actionLink disabled-link" title="{!$Label.kimbleone__noelementbudgetsmessage}" value="javascript:void(0)"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__edit} {!$Label.DeliveryGroupBudgetsHeading}</apex:outputLink></li>
														</apex:outputPanel>
		
														<apex:outputPanel layout="none" rendered="{!!hasPOAllocations && $ObjectType.KimbleOne__DeliveryElement__c.fields.KimbleOne__PurchaseOrderRule__c.updateable}">
															<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="initialiseModalBoxy('#PORulePopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__PurchaseOrderRule__c.label}');loadDeliveryElement('{!JSENCODE(element.Id)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__edit} {!$ObjectType.PurchaseOrderRule__c.label}</apex:outputLink></li>
														</apex:outputPanel>
														<apex:outputPanel layout="none" rendered="{!hasPOAllocations || !$ObjectType.KimbleOne__DeliveryElement__c.fields.KimbleOne__PurchaseOrderRule__c.updateable}">
															<li><apex:outputLink styleClass="actionLink disabled-link" title="{!$Label.kimbleone__poallocationsexistmessage}" value="javascript:void(0)"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.kimbleone__edit} {!$ObjectType.PurchaseOrderRule__c.label}</apex:outputLink></li>
														</apex:outputPanel>
														
														<apex:outputPanel layout="none" rendered="{!(element.PurchaseOrderRule__r.IsServicesPOCoverRequired__c || element.PurchaseOrderRule__r.IsExpensesPOCoverRequired__c) && $ObjectType.KimbleOne__PurchaseOrderAllocation__c.createable && CanCreateNewPOAllocation == true}">
															<li id="allocatePurchaseOrderElement"><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="newPurchaseOrderAllocationForElement('{!JSENCODE(element.Id)}')">{!$Label.kimbleone__allocatepurchaseorderbutton}</apex:outputLink></li>
														</apex:outputPanel>
														<apex:outputPanel layout="none" rendered="{!(element.PurchaseOrderRule__r.IsServicesPOCoverRequired__c == false && element.PurchaseOrderRule__r.IsExpensesPOCoverRequired__c == false) || $ObjectType.KimbleOne__PurchaseOrderAllocation__c.createable == false || CanCreateNewPOAllocation == false}">
															<li><apex:outputLink styleClass="actionLink disabled-link" title="{!$Label.kimbleone__ponotapplicablemessage}" value="javascript:void(0)"><i class="fa fa-list-ul dropdown-icon"></i>{!$Label.kimbleone__allocatepurchaseorderbutton}</apex:outputLink></li>
														</apex:outputPanel>
														
														<apex:outputPanel layout="none" rendered="{!HasAccountCredit && $ObjectType.KimbleOne__CreditAllocation__c.createable}">
															<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="newCreditAllocationForElement('{!JSENCODE(element.Id)}')"><i class="fa fa-list-ul dropdown-icon"></i>{!$Label.AllocateCredit}</apex:outputLink></li>
														</apex:outputPanel>
														
														<apex:outputPanel layout="none" rendered="{!(scopingElementElements.size == 1) && ((elementSupportsAssignments && (elementAssignments.size > 1)) || (elementSupportsMilestones && (elementRevenueMilestones.size > 1)) || (elementSupportsAnnuities && (elementAnnuities.size > 1)))}">
															<li id="splitElementForPO"><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="splitDeliveryElementForPOAllocation('{!JSENCODE(element.Id)}')"><i class="fa fa-scissors dropdown-icon"></i>{!$Label.SplitDeliveryElementForPOAllocationLabel}</apex:outputLink></li>
														</apex:outputPanel>
																												
														<apex:outputPanel layout="none" rendered="{!RenderDepositsPanel}">
															<apex:outputPanel layout="none" rendered="{!(element.PurchaseOrderRule__r.IsServicesPOCoverRequired__c || element.PurchaseOrderRule__r.IsExpensesPOCoverRequired__c) && $ObjectType.KimbleOne__Deposit__c.createable}">
																<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="initialiseModalBoxy('#DepositPopup', '{!JSENCODE($Label.kimbleone__new)} {!$ObjectType.KimbleOne__Deposit__c.label}');newDeposit('{!JSINHTMLENCODE(element.Id)}')"><i class="fa fa-plus-square dropdown-icon"></i>{!$Label.New} {!$ObjectType.Deposit__c.label}</apex:outputLink></li>
															</apex:outputPanel>
															<apex:outputPanel layout="none" rendered="{!(element.PurchaseOrderRule__r.IsServicesPOCoverRequired__c == false && element.PurchaseOrderRule__r.IsExpensesPOCoverRequired__c == false) || $ObjectType.KimbleOne__Deposit__c.createable == false}">
																<li><apex:outputLink styleClass="actionLink disabled-link" title="{!$Label.kimbleone__depositallocationnotapplicablemessage}" value="javascript:void(0)"><i class="fa fa-plus-square dropdown-icon"></i>{!$Label.New} {!$ObjectType.Deposit__c.label}</apex:outputLink></li>
															</apex:outputPanel>												
														</apex:outputPanel>
														
														<apex:outputPanel layout="none" rendered="{!((elementSupportsAssignments && (elementAssignments.size == 0)) || (elementSupportsMilestones && (elementRevenueMilestones.size == 0)) || (elementSupportsAnnuities && (elementAnnuities.size == 0))) && (scopingElement.Id != element.Id)}">
															<li><apex:outputLink styleClass="actionLink" value="javascript:void(0)" onclick="deleteThisInvoicingContainer('{!JSENCODE(element.Id)}')"><i class="fa fa-trash dropdown-icon"></i>{!$Label.DeleteInvoicingContainerLink}</apex:outputLink></li>
														</apex:outputPanel>
												    </ul>
												</div>
												</apex:outputPanel>
											</div>
											
											<div class="delivery-element-body">										
												<apex:variable value="{!!ISBLANK(element.InvoicingCurrencyRevenueCap__c)}" var="revenueCapDefined"/>
												<apex:variable value="{!!ISBLANK(element.ResourcedActivity__r.InvoicingCurrencyExpenseRevenueCap__c)}" var="expensesCapDefined"/>
												<apex:variable value="{!!ISBLANK(element.ResourcedActivity__r.InvoicingCurrencyUsageRevenueCap__c)}" var="usageCapDefined"/>
												<div class="delivery-element-body-column">
													<apex:outputPanel layout="block" styleclass="element-financials" rendered="{!hasBudget && (revenueCapDefined || expensesCapDefined || usageCapDefined)}">
														<table class="element-budgets-table">
															<tr>
																<td class="amount-Label">
																	<apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__RevenueCap__c.Label}"/>
																</td>
					
																<td class="amount-value">
																	<apex:outputPanel layout="none" rendered="{!!ISBLANK(element.RevenueCap__c) && element.Product__r.ProductDomain__r.RevenueGenerationModel__r.Enum__c = 'CappedBillableEffortExpended'}">
																		<apex:outputText value="{!element.InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
																		<apex:outputField value="{!element.InvoicingCurrencyRevenueCap__c}" />
																	</apex:outputPanel>
																	<apex:outputText value="{!$Label.kimbleone__none}" rendered="{!ISBLANK(element.RevenueCap__c) && element.Product__r.ProductDomain__r.RevenueGenerationModel__r.Enum__c = 'CappedBillableEffortExpended'}"/>
																	<apex:outputText value="{!$Label.kimbleone__notapplicableshort}" rendered="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.Enum__c != 'CappedBillableEffortExpended'}"/>
																</td>
																
																<td class="amount-Label">
																	<apex:outputText value="{!$ObjectType.KimbleOne__ResourcedActivity__c.Fields.KimbleOne__ExpenseRevenueCap__c.Label}"/>
																</td>
								
																<td class="amount-value">
																	<apex:outputPanel layout="none" rendered="{!!ISBLANK(element.ResourcedActivity__r.ExpenseRevenueCap__c) && element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsExpenseGenerated__c}">
																		<apex:outputText value="{!element.InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
																		<apex:outputField value="{!element.ResourcedActivity__r.InvoicingCurrencyExpenseRevenueCap__c}" />
																	</apex:outputPanel>
																	<apex:outputText value="{!$Label.kimbleone__none}" rendered="{!ISBLANK(element.ResourcedActivity__r.ExpenseRevenueCap__c) && element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsExpenseGenerated__c}"/>
																	<apex:outputText value="{!$Label.kimbleone__notapplicableshort}" rendered="{!!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsExpenseGenerated__c}"/>
																</td>
