		function refreshAfterDragAndDrop()
		{
			// track how many updates we have to perform before we actually do the refresh
			// this ensures that the scenario where multiple elements are being created completes
			// before the screen can refresh
			updatesPending-=1;
			
			if(updatesPending == 0)
			{
				rerenderTheForm();
			}
		}
		        		
		var POdeleteRunning = false;
		
