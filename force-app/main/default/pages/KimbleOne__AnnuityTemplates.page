<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.AnnuityTemplatesController" sidebar="false">

	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">

			<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>

		</apex:define>

		<apex:define name="Content">

			<apex:pageMessages escape="false"/>

			<apex:outputPanel id="AnnuityTemplatesMainPanel">

				<apex:form >
					<apex:pageBlock id="AnnuityTemplatesDetailPanel">

						<apex:pageBlockButtons >
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__AnnuityTemplate__c.createable}">
								<input class="btn" type="button"
										onclick="initialiseModalBoxy('#AnnuityTemplatesPopup', '{!JSENCODE($Label.New)} {!$ObjectType.AnnuityTemplate__c.label}');newAnnuityTemplate()"
										value="{!$Label.New} {!$ObjectType.AnnuityTemplate__c.label}" />
							</apex:outputPanel>
						</apex:pageBlockButtons>

						<apex:pageBlockTable value="{!AnnuityTemplatesForProduct}" var="aAnnuity">
							<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
								<apex:outputPanel rendered="{!$ObjectType.KimbleOne__AnnuityTemplate__c.updateable}">
									<apex:outputLink value="#" onclick="initialiseModalBoxy('#AnnuityTemplatesPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__AnnuityTemplate__c.label}');editAnnuityTemplate('{!JSINHTMLENCODE(aAnnuity.id)}')">{!$Label.kimbleone__edit}</apex:outputLink>
								</apex:outputPanel>
	           					&nbsp; | &nbsp;
								<apex:commandLink onclick="var d = confirmDelete();if(!d) return;"
									action="{!deleteAnnuityTemplate}" rendered="{!$ObjectType.KimbleOne__AnnuityTemplate__c.deletable}"
									reRender="AnnuityTemplatesMainPanel">{!$Label.kimbleone__delete}
									<apex:param name="atId" value="{!aAnnuity.Id}" />
								</apex:commandLink>
							</apex:column>

							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.Name.Label}"
								value="{!aAnnuity.Name}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__AnnuityBehaviourRule__c.Label}"
								value="{!aAnnuity.AnnuityBehaviourRule__r.Name}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__StartDateOffsetType__c.Label}"
								value="{!aAnnuity.StartDateOffsetType__r.Name}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__StartDateOffset__c.Label}"
								value="{!aAnnuity.KimbleOne__StartDateOffset__c}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__NumberOfPeriods__c.Label}"
								value="{!aAnnuity.KimbleOne__NumberOfPeriods__c}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__RevenueRate__c.Label}"
								value="{!aAnnuity.KimbleOne__RevenueRate__c}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__CostRate__c.Label}"
								value="{!aAnnuity.KimbleOne__CostRate__c}" />

						</apex:pageBlockTable>

					</apex:pageBlock>

					<apex:actionFunction action="{!newAnnuityTemplate}"
						name="newAnnuityTemplate"
						rerender="AnnuityTemplatesPopupPanel"
						oncomplete="showModalBoxy();" />

					<apex:actionFunction action="{!editAnnuityTemplate}"
						name="editAnnuityTemplate"
						rerender="AnnuityTemplatesPopupPanel"
						oncomplete="showModalBoxy();">
						<apex:param name="atId" value="" />
					</apex:actionFunction>

				</apex:form>
			</apex:outputPanel>



			<div id="AnnuityTemplatesPopup" style="display: none"><apex:outputPanel id="AnnuityTemplatesPopupPanel">
				<apex:form >
					<apex:pageBlock >

						<div id="AnnuityTemplatesPopupErrors"><apex:pageMessages escape="false"/>
						</div>
						<apex:pageBlockButtons location="bottom">
							<apex:commandButton action="{!upsertAnnuityTemplate}"
								value="{!$Label.kimbleone__save}"
								oncomplete="hideModalBoxyWithErrorCheck('#AnnuityTemplatesPopupErrors')"
								reRender="AnnuityTemplatesPopupPanel, AnnuityTemplatesMainPanel" />
							<input class="btn" type="button" onclick="hideModalBoxy();"
								value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>

						<apex:pageblockSection collapsible="false" showheader="false" columns="1">

							<apex:inputfield value="{!aAnnuityTemplateObject.Name}"
								required="true" />

							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.CurrencyIsoCode.Label}" />
								<apex:inputText value="{!aAnnuityTemplateObject.CurrencyIsoCode}" required="true"
									styleclass="kimblecustomlookup GetActiveCurrencyTypes null true false" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__StartDateOffsetType__c.Label}" />
								<apex:selectList value="{!aAnnuityTemplateObject.KimbleOne__StartDateOffsetType__c}" size="1">
										<apex:selectOptions value="{!TheOffsetTypes}" />
									</apex:selectList>
							</apex:pageBlockSectionItem> 
							
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__StartDateOffset__c.Label}" />
								<apex:inputText value="{!aAnnuityTemplateObject.KimbleOne__StartDateOffset__c}" />
							</apex:pageBlockSectionItem> 																	
									
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__AnnuityBehaviourRule__c.Label}" />
									<apex:selectList value="{!aAnnuityTemplateObject.KimbleOne__AnnuityBehaviourRule__c}" size="1">
										<apex:selectOptions value="{!TheAnnuityBehaviourRules}" />
									</apex:selectList>
							</apex:pageBlockSectionItem>
							
							</apex:pageblockSection>
 							<apex:outputPanel layout="none">
								<apex:pageblockSection collapsible="false" showheader="false" columns="1" >		
									<apex:inputfield value="{!aAnnuityTemplateObject.KimbleOne__NumberOfPeriods__c}" required="true"/>							
								</apex:pageBlockSection>
							</apex:outputPanel>
														
 							<apex:outputPanel layout="none" id="Revenue">
								<apex:pageblockSection collapsible="false" showheader="false" columns="1" >		
									<apex:inputfield value="{!aAnnuityTemplateObject.KimbleOne__RevenueRate__c}" rendered="{!aProductObject.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsPeriodGenerated__c}" required="true"/>							
								</apex:pageBlockSection>
							</apex:outputPanel>
 					
							
						<apex:pageblockSection collapsible="false" showheader="false" columns="1">
							<apex:pageBlockSectionItem rendered="{!aProductObject.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsPeriodGenerated__c}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__CostRateRule__c.Label}" />
								<apex:actionRegion >
									<apex:selectList value="{!aAnnuityTemplateObject.KimbleOne__CostRateRule__c}" size="1">
										<apex:selectOptions value="{!TheCostRateRules}" />
										<apex:actionSupport event="onchange" action="{!CostRateRule}" rerender="CostDefinitions"/>
									</apex:selectList>
								</apex:actionRegion>
							</apex:pageBlockSectionItem>					 
						</apex:pageblockSection>
											
							<apex:outputPanel layout="none" id="CostDefinitions">
								<apex:pageblockSection collapsible="false" showheader="false" columns="1" >							
									<apex:inputfield value="{!aAnnuityTemplateObject.KimbleOne__CostRate__c}" rendered="{!aProductObject.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsPeriodGenerated__c && isFixedCostRate}" required="true"/>
									<apex:inputfield value="{!aAnnuityTemplateObject.KimbleOne__CostRateFactor__c}" rendered="{!aProductObject.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsPeriodGenerated__c && !isFixedCostRate}" required="true"/>
								</apex:pageBlockSection>
							</apex:outputPanel>

						<apex:pageblockSection >
							<apex:pageBlockSectionItem rendered="{!aProductObject.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsUnitGenerated__c && aProductObject.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsPeriodGenerated__c}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__AnnuityTemplate__c.Fields.KimbleOne__UnitsUnitType__c.Label}" />
									<apex:selectList value="{!aAnnuityTemplateObject.KimbleOne__UnitsUnitType__c}" size="1">
										<apex:selectOptions value="{!TheUnitsUnitTypes}" />
									</apex:selectList>
							</apex:pageBlockSectionItem>
						</apex:pageblockSection>								
							
						<apex:pageblockSection collapsible="false" showheader="false" columns="1">
							<apex:inputfield value="{!aAnnuityTemplateObject.KimbleOne__InitialNumberOfUnits__c}" rendered="{!IsUnitGenerated}" required="{!IsUnitGenerated}"/>					 
						</apex:pageblockSection>					
											
					</apex:pageBlock>
				</apex:form>
			</apex:outputPanel></div>
		</apex:define>
	</apex:composition>
	<style>
		.detailList .labelCol {
		    width: 45% !important;
		}
		
	</style>
</apex:page>