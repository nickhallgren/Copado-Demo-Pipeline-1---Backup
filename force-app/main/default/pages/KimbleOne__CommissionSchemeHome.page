<apex:page standardcontroller="KimbleOne__CommissionScheme__c" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="SalesMarketing.html" MenuContextType="CommissionScheme" MenuContextId="{!KimbleOne__CommissionScheme__c.Id}" MenuContextName="{!KimbleOne__CommissionScheme__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
    
	<apex:pageMessages escape="false" />    	
	
	<apex:pageBlock >
	
		<apex:pageBlockSection collapsible="false" title="{!$ObjectType.KimbleOne__CommissionScheme__c.Label}">
    		
    		<apex:outputField value="{!KimbleOne__CommissionScheme__c.Name}"/>
    		&nbsp;
    		<apex:pageBlockSectionItem >
    			<apex:outputLabel value="{!$ObjectType.KimbleOne__CommissionScheme__c.Fields.KimbleOne__SchemeBasis__c.Label}" />
    			<apex:outputField value="{!KimbleOne__CommissionScheme__c.SchemeBasis__r.Name}"/>
    		</apex:pageBlockSectionItem>
    		<apex:outputField value="{!KimbleOne__CommissionScheme__c.CommissionSchemeMeasure__r.Name}"/>    	
    	
    	</apex:pageBlockSection>
    
    </apex:pageBlock>
    		
</apex:define>

</apex:composition>    		

</apex:page>