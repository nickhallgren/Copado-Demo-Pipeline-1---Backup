<apex:page standardController="KimbleOne__ExpenseClaim__c" extensions="KimbleOne.ExpenseClaimRedirectController" showHeader="false" sidebar="false">
    <script>
		safeRedirectToSForceURL('{!JSENCODE(RedirectToURL)}');

		function isSFClassic()
		{
			return ( (typeof sforce == 'undefined' || typeof sforce.one == 'undefined') );
		}

		function safeRedirectToSForceURL(theURL)
		{
			if(isSFClassic())
			{
				// SF Classic
				window.location = theURL;
			}
			else
			{
				// SF Lightning
				sforce.one.navigateToURL(theURL);
			}
		}
	</script>

</apex:page>