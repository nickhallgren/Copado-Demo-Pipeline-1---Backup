<script>
	var TPage = {
		enableSave : function() { 
			jQuery('.save-button').prop('disabled', '').addClass('btn').removeClass('btnDisabled'); 
		},
		disableSave : function() { 
			jQuery('.save-button').prop('disabled', 'disabled').addClass('btnDisabled').removeClass('btn'); 
		},
	};
	
	function initialiseActions()
	{
		jQuery(document).off('change', '.targetAmount').on('change', '.targetAmount', targetChanged);
		jQuery(document).off('change', '.stretchAmount').on('change', '.stretchAmount', targetChanged);
		jQuery(document).off('change', '.Currency').on('change', '.currencySelector', currencyChanged);
	}

	jQuery(document).ready(
		initialiseActions()
	);	
</script>

