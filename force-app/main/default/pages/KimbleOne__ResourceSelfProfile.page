			width: 75%;
		}
		.nothing-here {
			padding: 20px;
			font-size: 14px;
			border: 2px dashed #bbbbbb;
			margin: 11px 2px;
			background-color: lemonchiffon;
			text-align: center;
		}
		.convert-to-capability {
			font-size: 20px;
			cursor: pointer;
			position: absolute;
		    right: 22px;
		    top: 8px;
  		}
  		.learningmode-icon {
			background-color: #FF9800;
			color: white;
  		    margin-right:5px;
  		    padding: 4px;
  		    border-radius: 2px;
  		    font-size: 16px;
    	}
		.capmode-icon {
			background-color: #8bc34a;
			color: white;
  		    margin-right:5px;
  		    padding: 4px 6px 4px 6px;
  		    border-radius: 3px;
  		    font-size: 16px;
    	}
		/* Winter 18 Lightning Style Overrides - START */
		/* Only required to format the pageBlock which is required to maintain fonts and styling in Lightning */
		div[id$='sf-formatting-container'] .pbBody {
		    margin: 0px !important;
		    background-color: white;
		}
		div[id$='sf-formatting-container'].bPageBlock {
		    border: none !important;
			overflow-x: hidden;
		}
		/* Winter 18 Lightning Style Overrides - END */
	</style>
	
	<apex:pageBlock id="sf-formatting-container">
	<div class="page-container">
		<div class="search-container">
			<div class="search-container-header title-card" kimble-tip="SearchIcon" kimble-tip-help-link="ResourceProfilingLink" kimble-tip-extended-text="SearchIconExtendedText">
	  			<input id="capability-type-filter" placeholder="{!$Label.CapabilitySearchPlaceholder}"/>
				<i class="clear-capability-filter fa fa-times hidden-item"></i>
				<i class="searching-ind top-right-search-icon hidden-item fa fa-spin fa-circle-o-notch"></i>
				<i class="browse-btn action-btn top-right-search-icon fa fa-list-ul" title="{!$Label.Browse}"></i>
			</div>
			<div id="capability-search-results">
			</div>
		</div>

		<div class="resource-capabilities-container">
			<div id="capabilities-title">
				<div class="title-card-container">
				<div class="title-card">
					<div class="title-card-heading" >
						<div class="title-card-heading-text">
							<apex:outputPanel layout="none" rendered="{!learningMode}">
								<div>
									<span class=" learningmode-icon"><i class="fa fa-graduation-cap"></i></span>
									<span><apex:outputText title="{!$Label.kimbleone__mylearningobjectives}" value="{!$Label.kimbleone__mylearningobjectives}"/></span>
								</div>
							</apex:outputPanel>

							<apex:outputPanel layout="none" rendered="{!!learningMode}">
								<div>
									<span class="capmode-icon"><i class="fa fa-check-square"></i></span>
									<span><apex:outputText title="{!$Label.kimbleone__mycapabilitieslabel}" value="{!$Label.kimbleone__mycapabilitieslabel}"/></span>
								</div>
							</apex:outputPanel>

						</div>
					</div>
					
					<div class="title-card-body">
						<i class="save-btn action-btn fa fa-save" kimble-tip="SaveIcon" kimble-tip-help-link="ResourceProfilingLink" title="{!$Label.Save}"></i>
					</div>
