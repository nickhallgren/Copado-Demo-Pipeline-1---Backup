		.page-container {
			display: table;
			width: 100%
		}

		/* rating key */
  		i.rating-info {
			color: #428BCA;
			font-size: 16px;
			margin-left: 3px;
			cursor: pointer;
		}
		.rating-qtip {
			max-width: unset !important;
