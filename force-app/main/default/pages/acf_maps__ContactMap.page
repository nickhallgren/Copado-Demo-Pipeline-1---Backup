<apex:page controller="acf_maps.ContactMapController" title="Business Intensity Maps from ACF Solutions" sidebar="false">
<!-- Created by ACF Solutions - October 2013 2013 v1.45 -->
<!-- Intensity maps displaying counts of contacts and cases by US state -->
	<style>
	.header
	{
	font-size:130%;
	font-weight:bold;
	}
	.chartlabel
	{
	font-size:100%;
	font-weight:bold;
	}
	.chartsublabel
	{
	font-size:100%;
	font-style:italic;
	}
	.footerlabel
	{
	font-size:120%;
	font-weight:bold;
	font-style:italic;
	}
	</style>
	<apex:outputText styleclass="header" value="Where Does {!$Organization.Name} Do Business?"/>
   	<br/><br/>
 	<table>
		<tr>
			<td>
				<apex:outputText styleclass="chartlabel" value="{!ContactLabel}"/><br/>
				<apex:outputText styleclass="chartsublabel" value="For the 25,000 most recently created {!ContactLabel}"/>
				<c:GeoMap jsondata="{!GeoMapContactData}" currency="false" height="307" width="493" 
					colors="['#E3DEB8','#56458C']" reportId="00O80000003GRzn" drillfield="ADDRESS2_STATE"/>
				<br/>
			</td>
			<td>
				<apex:outputText styleclass="chartlabel" value="{!CaseLabel}"/><br/>
				<apex:outputText styleclass="chartsublabel" value="For the 25,000 most recently created {!CaseLabel}"/>
				<c:GeoMap jsondata="{!GeoMapCaseData}" currency="false" height="307" width="493" 
					colors="['#E3DEB8','#B7A752']" reportId="00O80000003GRzs" drillfield="CONTACT2.STATE"/>
				<br/>
			</td>
		</tr>
	</table>
	<apex:outputText styleclass="footerlabel" value="Business Intensity Maps is brought to you by "/>
	<apex:outputLink value="http://www.acfsolutions.com" target="_blank" styleclass="footerlabel">ACF Solutions</apex:outputLink>
</apex:page>