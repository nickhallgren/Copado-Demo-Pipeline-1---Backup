		function initialiseTaskWorkItemsDragAndDrop()
		{
			if(jQuery('.work-items').data('ui-sortable')) jQuery('.work-items').sortable('destroy');
			
			jQuery('.work-items').each(function(index) { 
				var scopingId = jQuery(this).attr('scoping-id');
				jQuery('.work-items[scoping-id="' + scopingId + '"]').sortable({
					connectWith: '.work-items[scoping-id="' + scopingId + '"]',
					cancel : '.wi-actions, .status-select, textarea, input',
					tolerance: "pointer",
					over: function(e, ui) {
						jQuery(ui.sender).data('ui-sortable').scrollParent = jQuery(e.target);
					},
					receive: function( e, ui ) {
						var originalParentId = ui.item.attr('parent-node-id');
						var originalParent = jQuery('div[node-id="' + originalParentId + '"]');

						ui.item.attr('parent-node-id', jQuery(e.target).closest('.work-items').attr('node-id'));
						workItemMap[ui.item.attr('node-id')].TaskId = jQuery(e.target).closest('.work-items').attr('node-id');

						var originalChildren = jQuery('li[parent-node-id="' + originalParentId + '"]');
						
						var newParent = jQuery('div[node-id="' + jQuery(e.target).closest('.work-items').attr('node-id') + '"]');
						var newChildren = jQuery('li[parent-node-id="' + ui.item.attr('parent-node-id') + '"]');

						calculateParentUnitsTotal(newParent, newChildren);
						calculateParentUnitsTotal(originalParent, originalChildren);
						
						listChanged();
					},
					stop: function( e, ui ) {
						jQuery('.feed-me').removeClass('feed-me');
						listChanged();
					},
					start: function (e, ui ) {
						clearTimer();
						jQuery('.work-items:empty').addClass('feed-me');
					}
				}).disableSelection();
			});
		}
		
		function getCurrentActivityAssignment() 
		{
			for(var i = 0; i < thisResourcesActivities.length; i++) {
				currentActivityAssIds.push({id: thisResourcesActivities[i], text: theResources.filter(function(x){return x.id == thisResourcesActivities[i].id}) });
			}
		}
		
		function workItemChange(e)
		{
			// enter to create a new work item
			if(jQuery(this).parent('.work-item').hasClass('new') && e.keyCode == 13)
			{
				e.preventDefault();
				e.stopPropagation();
				jQuery('.last-added').removeClass('last-added');
				
				addWorkItemClick(e, jQuery(this).closest('.work-item'));
			}
			
			if(!jQuery(this).parent('.work-item').hasClass('new') && e.keyCode == 13)
			{
				e.preventDefault();
				e.stopPropagation();
			}

			if(jQuery(this).hasClass('work-item-r-units') || jQuery(this).hasClass('work-item-a-units'))
			{
				// ideally we'd validate that this input is numeric however there are many issues doing this with multi-locale
				// input, particularly in some keyboard layouts where SHIFT+ is required to enter numerics
				// instead at this point we specifically prevent the - symbol
				// 189 = minus, 109 = numpad minus, 173 FireFox minus
				if(e.keyCode == 189 || e.keyCode == 109 || e.keyCode == 173)
				{			
					e.preventDefault();
					e.stopPropagation();
					return;
				}
			}			
		}

		function workItemNotesChange(e)
		{
			jQuery(this).height(1);
			var totalHeight = jQuery(this).prop('scrollHeight') - parseInt(jQuery(this).css('padding-top')) - parseInt(jQuery(this).css('padding-bottom'));
			jQuery(this).height(totalHeight);
		
			var theItem = jQuery(this).closest('.work-item');	
			var itemHasDetail = workItemHasDetail(theItem);
			theItem.find('.edit-work-item').toggleClass('fa-pencil-square', itemHasDetail);
			theItem.find('.edit-work-item').toggleClass('has-detail', itemHasDetail);
			theItem.find('.edit-work-item').toggleClass('fa-pencil-square-o', !itemHasDetail);

			workItemMap[theItem.attr('node-id')].Notes = jQuery(this).val();

			listChanged();
		}
		
		function workItemBlockedChange(e) 
		{
			var theSelect = jQuery(this);
			theSelect.closest('.list-item').attr('item-blocked', theSelect.is(":checked"));
			
			var theItem = theSelect.closest('.work-item');	
			workItemMap[theItem.attr('node-id')].IsBlocked = theSelect.is(":checked");

			listChanged();
		}
		
		function workItemUnitsChange(e)
		{
			var itemNodeId = jQuery(this).parent('.work-item').attr('node-id');

			var workItemParent = jQuery('div[node-id="' + jQuery(this).parent('.work-item').attr('parent-node-id') + '"]');
			var workItems = jQuery('li[parent-node-id="' + jQuery(this).parent('.work-item').attr('parent-node-id') + '"]');
			
			var itemHasActuals = (jQuery(this).parent('.work-item').find('.work-item-a-units').length > 0);
			
			if(jQuery(this).hasClass('work-item-a-units'))
			{
				workItemMap[itemNodeId].ActualUnits = getSafeInteger(parseNumber(jQuery(this).val()));
				
				// decrement the remaining
				// use the original remaining value and the difference between actual rather than current otherwise increases in actual are double counted
				var originalRemainingUnits = jQuery(this).parent('.work-item').find('.work-item-r-units').attr('orig-value');
				var originalActualUnits = jQuery(this).parent('.work-item').find('.work-item-a-units').attr('orig-value');
				
				var newRemainingUnits = (originalRemainingUnits != undefined ? originalRemainingUnits : 0);
				var actualUnitsDelta = getSafeInteger(parseNumber(jQuery(this).val())) - (originalActualUnits != undefined ? originalActualUnits : 0);
				
				workItemMap[itemNodeId].RemainingUnits = Math.max(0, newRemainingUnits - actualUnitsDelta);
				jQuery(this).parent('.work-item').find('.work-item-r-units').val(formatNumberNat2DP(workItemMap[itemNodeId].RemainingUnits));
				jQuery(this).parent('.work-item').find('.work-item-r-units').attr('orig-value', workItemMap[itemNodeId].RemainingUnits);
				
				// change the original value as we have now overriden the original actual
				jQuery(this).parent('.work-item').find('.work-item-a-units').attr('orig-value', getSafeInteger(parseNumber(jQuery(this).val())));
			}
			else if(jQuery(this).hasClass('work-item-r-units'))
			{
				workItemMap[itemNodeId].RemainingUnits = getSafeInteger(parseNumber(jQuery(this).val()));
				
				// change the original value as we have now overriden the original remaining
				jQuery(this).parent('.work-item').find('.work-item-r-units').attr('orig-value', workItemMap[itemNodeId].RemainingUnits);
			}
			
			if(itemHasActuals)
			{
				var newStatus = '';
				// if no actual then must be not started
				// if there are actual then the work item must be in progress
				// if nothing remaining then it must be complete
				if(workItemMap[itemNodeId].ActualUnits == 0 && workItemMap[itemNodeId].RemainingUnits > 0
					|| workItemMap[itemNodeId].ActualUnits == 0 && workItemMap[itemNodeId].RemainingUnits == 0)
				{
					newStatus = 'NotStarted';
				}
				else if(workItemMap[itemNodeId].ActualUnits > 0 && workItemMap[itemNodeId].RemainingUnits > 0)
				{
					newStatus = 'InProgress';
				}
				else if(workItemMap[itemNodeId].ActualUnits > 0 && workItemMap[itemNodeId].RemainingUnits == 0)
				{
					newStatus = 'Completed';
				}
				 
				if(newStatus != '')
				{
					jQuery(this).parent('.work-item').attr('item-status', newStatus);
					
					var theSelect = jQuery(this).parent('.work-item').find('.status-select');
					theSelect.val(newStatus);
					
					theSelect.toggleClass('NotStarted', (theSelect.val() == 'NotStarted'));
					theSelect.toggleClass('InProgress', (theSelect.val() == 'InProgress'));
					theSelect.toggleClass('Completed', (theSelect.val() == 'Completed'));
					
					workItemMap[itemNodeId].Status = theSelect.val();
				}
			}
			
			calculateParentUnitsTotal(workItemParent, workItems);
		
			listChanged();
		}
		
		function getSafeInteger(theItemVal)
		{
			return (theItemVal != undefined && theItemVal != '' ? theItemVal : 0);
		}		
		
		function calculateParentUnitsTotal(theParent, theChildren)
		{
			var theTotal = 0;
			jQuery.each(theChildren.find('.work-item-a-units'), function (i, item){
				theTotal += parseNumber(jQuery(item).val());
			});
			theParent.find('.task-a-units-total').text(formatNumberNat2DP(theTotal));

			theTotal = 0;
			jQuery.each(theChildren.find('.work-item-r-units'), function (i, item){
				theTotal += parseNumber(jQuery(item).val());
			});
			theParent.find('.task-r-units-total').text(formatNumberNat2DP(theTotal));
		}
		
		function editWorkItemClick(e)
		{
			var theItem = jQuery(this).closest('.work-item');

			if(enableOwners) {
				theItem.find('.ti-owner-details').hide();
				theItem.removeClass('owner-on');
			}
			
			 theItem.find('.edit-work-item').toggleClass('detail-edit-mode');
			
			if(!refreshingList) {
				if( theItem.find('.edit-work-item').hasClass('detail-edit-mode')) {expandedWorkItems.push(theItem.attr('node-id'));}
				else {expandedWorkItems.splice(expandedWorkItems.indexOf(theItem.attr('node-id')), 1);}
			}
			
			theItem.find('.wi-add-details').toggleClass('detail-edit-mode',  theItem.find('.edit-work-item').hasClass('detail-edit-mode'));
		
			jQuery.each(theItem.find('.wi-add-details textarea'), function (i, theTextArea)
			{
				jQuery(this).height(1);
				var totalHeight = jQuery(this).prop('scrollHeight') - parseInt(jQuery(this).css('padding-top')) - parseInt(jQuery(this).css('padding-bottom'));
				jQuery(this).height(totalHeight);
			});
		}		
		
		function deleteWorkItemClick(e)
		{
			var workItemParent = jQuery('div[node-id="' + jQuery(this).closest('.work-item').attr('parent-node-id') + '"]');

			if (!jQuery(this).closest('.work-item').hasClass('new'))
				theDeletedItems[jQuery(this).closest('.work-item').attr('node-id')] = jQuery(this).closest('.work-item').attr('node-id');
				
			jQuery(this).closest('.work-item').remove();
			
			delete workItemMap[jQuery(this).closest('.work-item').attr('node-id')];

			var workItems = jQuery('li[parent-node-id="' + jQuery(this).closest('.work-item').attr('parent-node-id') + '"]');

			calculateParentUnitsTotal(workItemParent, workItems);
			
			listChanged();
		}
		
		function getNewWorkItemObject(parentTaskId, resourcedActivityIdIn, trackingPlanIdIn)
		{
			var theWorkItem = {WorkItemId: getUniqueId(), IsNew: true, Status: newWorkItemStatus, TaskId: parentTaskId, ResourcedActivityId: resourcedActivityIdIn, TrackingPlanId: trackingPlanIdIn, ActivityAllowNewTasks: true};
			
			if(enableOwners && defaultOwnerToCurrentUser) {
				var activityAssignmentIds = theActivityAssResources[resourcedActivityIdIn];
				for(let i = 0; i < currentActivityAssIds.length; i++) {
					if(activityAssignmentIds.includes(currentActivityAssIds[i].id)) {
						theWorkItem.ActivityAssignmentId = currentActivityAssIds[i].id; 
						break;
					}
				}
			}
			
			workItemMap[theWorkItem.WorkItemId] = theWorkItem;
			
			return theWorkItem;
		}
		
		function showOwner()
		{
			var theNode = jQuery(this).closest('li[node-id]');
			if(!jQuery('.task-list-container').hasClass('drag-active') && !theNode.find('.wi-add-details').hasClass('detail-edit-mode'))
			{	
				theNode.addClass('owner-on');
				theNode.find('.ti-owner-details').slideDown();
			}
		}
		
		function hideOwner()
		{
			var theNode = jQuery(this).closest('li[node-id]');
			theNode.removeClass('owner-on');
			theNode.find('.ti-owner-details').slideUp();
		}
		
		
		function getUniqueId()
		{
			  // Math.random should be unique because of its seeding algorithm.
			  // Convert it to base 36 (numbers + letters), and grab the first 9 characters
			  // after the decimal.
			  return '__' + Math.random().toString(36).substr(2, 9);
		}
		
		function workItemNameChange(e)
		{	
			var itemId = jQuery(this).closest('.list-item').attr('node-id');
			
			workItemMap[itemId].Name = jQuery(this).val();
			
			listChanged(); 
		}
		
		function addWorkItemClick(e, triggerWorkItem)
		{
			var thisItem = (triggerWorkItem == undefined ? jQuery(this) : jQuery(triggerWorkItem));
			
			var isActivity = (triggerWorkItem == undefined ? thisItem.closest('.list-item').hasClass('activity-item') : thisItem.closest('.work-items').hasClass('activity-work-items'));
			
			// action is different depending on whether this is a Task/Iteration work item or an Activity Work Item
			var parentTaskId;
			var resourcedActivityId;
			var trackingPlanId;
			
			if(isActivity)
			{
				resourcedActivityId = (triggerWorkItem == undefined ? thisItem.closest('.list-item').attr('scoping-id') : thisItem.attr('parent-node-id'));
			}
			else
			{
				parentTaskId = (triggerWorkItem == undefined ? thisItem.closest('.list-item').attr('node-id') : thisItem.closest('.list-item').attr('parent-node-id'));
				resourcedActivityId = (triggerWorkItem == undefined ? thisItem.closest('.list-item').attr('scoping-id') : jQuery('.list-item[node-id="' + parentTaskId + '"]').attr('scoping-id'));
				trackingPlanId = (triggerWorkItem == undefined ? thisItem.closest('.list-item').attr('parent-node-id') : jQuery('.list-item[node-id="' + parentTaskId + '"]').attr('parent-node-id'));
			}
			
			var targetWorkItems = jQuery('.work-items[node-id="' + (parentTaskId != null ? parentTaskId : resourcedActivityId) + '"]');
			
			var newItemObject = getNewWorkItemObject(parentTaskId, resourcedActivityId, trackingPlanId);
			
			var theWorkItemUnitType = theResourcedActivityWorkItemUnitTypeMap[resourcedActivityId];
			
			if(triggerWorkItem != undefined)
			{
				jQuery(triggerWorkItem).after(getWorkItemHtml(newItemObject, theWorkItemUnitType));
			}
			else
			{
				targetWorkItems.append(getWorkItemHtml(newItemObject, theWorkItemUnitType));
			}
			
			var newItem = targetWorkItems.find('.work-item.last-added textarea');
			newItem.focus().select();
		}
		
		function editTaskItemEffortClick(e)
		{
			e.stopPropagation();
			var theMetrics =  jQuery(this).closest('.ti-metrics')
			theMetrics.find('.ass-remaining').hide();
			jQuery(this).css('visibility', 'hidden');
			var inputRemaining = '<input type=text class="ass-remaining-input" value="' + theMetrics.find('.ass-remaining').text() + '" style="width:40px;"></input>';
			jQuery(inputRemaining).insertAfter(theMetrics.find('.ass-expended'));
			jQuery('body').click(function() {
				var theInput = jQuery(this).find('.ass-remaining-input');
				var itemId = theInput.closest('.task-item').attr('node-id');
				if(theInput.val() != undefined) {
					var newRemainingEffort = parseNumber(theInput.val());
					taskMap[itemId].RemainingEffort = newRemainingEffort;	
					theInput.closest('.ti-metrics').find('.ass-remaining').show();
					theInput.closest('.ti-metrics').find('.ass-remaining').text(formatNumberNat2DP(newRemainingEffort));
					theInput.closest('.ti-metrics').find('.edit-task-item-effort').css('visibility', 'visible');
					theInput.remove();
					listChanged();
				}
				jQuery('body').unbind('click');
			});
			jQuery('.ass-remaining-input').click(function(e) { e.stopPropagation();});
			
		}		
		
		function statusChange()
		{
			var theSelect = jQuery(this);
	
			var itemId = theSelect.closest('.list-item').attr('node-id');
			
			theSelect.toggleClass('NotStarted', (theSelect.val() == 'NotStarted'));
			theSelect.toggleClass('InProgress', (theSelect.val() == 'InProgress'));
			theSelect.toggleClass('Completed', (theSelect.val() == 'Completed'));
			
			theSelect.closest('.list-item').attr('item-status', theSelect.val());
			
			if(theSelect.closest('.list-item').hasClass('task-item'))
			{
				var startDateUTC = kimble.parseDate(theSelect.closest('.list-item').find('.ti-start-date').text(), false);
				var endDateUTC = kimble.parseDate(theSelect.closest('.list-item').find('.ti-end-date').text(), false);
				
				var highlightClass = getHighlightClass(theSelect.val(), startDateUTC, endDateUTC);
				
				theSelect.closest('.list-item').find('.ti-start-date, .ti-end-date, .ti-status').toggleClass('red-highlight', highlightClass == ' red-highlight');
				theSelect.closest('.list-item').find('.ti-start-date, .ti-status').toggleClass('amber-highlight', highlightClass == ' amber-highlight');
				
				if(theSelect.val() == 'Completed' && theSelect.closest('.task-list-table').find('ul[node-id="'+itemId+'"]').has('li')) {
					theSelect.closest('.task-list-table').find('ul[node-id="'+itemId+'"]').find('li').each(function() {
						if(jQuery(this).attr('item-status') != 'Completed') {
							displayQtip(theSelect, itemId);	
							return false;
						}
					});
				}
				else {theSelect.closest('.ti-status').qtip('destroy', true);}
				
				taskMap[itemId].Status = theSelect.val();				
			}
			else
			{
				if(theSelect.val() == 'Completed') {
					theSelect.closest('.work-item').attr('item-blocked', false);
					theSelect.closest('.work-item').find('.work-item-isblocked-box').attr('checked', false);
					workItemMap[itemId].IsBlocked = false;
					theSelect.closest('.work-item').find('.work-item-isblocked-box').attr('disabled', true);
					
					var taskDiv = jQuery('div[node-id='+theSelect.closest('li').attr('parent-node-id')+']')
					if(taskDiv.attr('item-status') != 'Completed' && theSelect.closest('ul').hasClass('task-work-items')  && !taskDiv.hasClass('Iteration')) {
						var allcomplete = true;
						theSelect.closest('ul').find('li').each(function() {
							if(jQuery(this).attr('item-status') != 'Completed') {
								allcomplete = false;
							 	return false;
							 }
						});
						if(allcomplete) {wiDisplayQtip(theSelect, itemId);}
						else { theSelect.closest('.wi-status-details').qtip('destroy', true); }
					}
					else {theSelect.closest('.wi-status-details').qtip('destroy', true); }
				}
				else {
					theSelect.closest('.work-item').find('.work-item-isblocked-box').attr('disabled', false);
					theSelect.closest('.work-item').attr('item-blocked', theSelect.closest('.work-item').find('.work-item-isblocked-box').is(":checked"));
				}
				workItemMap[itemId].Status = theSelect.val();
			}
			
			listChanged();		
		}
		
		function changeStatusWorkItems(e) {
			jQuery('ul[node-id='+e.name+']').find('li').each(function() {
				if(jQuery(this).attr('item-status') != 'Completed') {
					var workItem = jQuery(this).find('.status-select');
					workItem.val('Completed');
					var workItemStatusChange = statusChange.bind(workItem);
					workItemStatusChange();
				}
			});
			jQuery('div[node-id='+e.name+']').find('.ti-status').qtip('destroy', true);
			if(e.getAttribute('autosave') == 'true') {autoSaveInd=true;}
			listChanged();
		}
		
		function cancelChangeStatusWorkItems(e)
		{
			jQuery('div[node-id='+e.name+']').find('.ti-status').qtip('destroy', true);
			if(e.getAttribute('autosave') == 'true') {
				autoSaveInd=true; 
				listChanged();
			}	
		}
		
		function displayQtip(theSelect, itemId) {
			var autoSaveOn = false;
			if(autoSaveInd == true) {
				autoSaveInd = false;
				autoSaveOn = true;
			}
			theSelect.closest('.ti-status').qtip({
				content:{
					text: function(event, api) {
						var html= '<p class="tool-tip-content">{!JSENCODE($Label.WICompleteQtipText)}</p>';
						html += '<div class="tool-tip-form-buttons">';
						html += '<input id="confirmChangeWI" class="btn" name="' + itemId + '" type="button" autosave= "'+ autoSaveOn +'" onclick="changeStatusWorkItems(this);" value="{!JSENCODE($Label.Yes)}"/>';
						html += '<input id="cancelChangeWI" class="btn" name="' + itemId + '" type="button" autosave= "'+ autoSaveOn +'" onclick="cancelChangeStatusWorkItems(this);" value="{!JSENCODE($Label.No)}"/>';
						html += '</div>';
						return html;
					},
					title:'{!JSENCODE($Label.WICompleteQtipTitle)}'
				},
				position: {
					adjust: {
						method: 'flip flip'
					},
					viewport: $(window)
				},
				show: {
 					event: 'click',
 					solo: true
 				},
 				hide: false,
				style: {classes: 'qtip-light qtip-shadow qtip-rounded'}
			});
			jQuery('.qtip').css('display', 'block');
		}
		
		function changeStatusTask(e) {
			var parentId = jQuery('li[node-id='+e.name+']').attr('parent-node-id');
			var taskSelect = jQuery('div[node-id='+parentId+']').find('.status-select');
			taskSelect.val('Completed');
			var changeStatusTask = statusChange.bind(taskSelect);
			changeStatusTask();
			jQuery('li[node-id='+e.name+']').find('.wi-status-details').qtip('destroy', true);
			if(e.getAttribute('autosave') == 'true') {autoSaveInd=true;}
			listChanged();
		}
		
		function cancelChangeStatusTask(e) {
			jQuery('li[node-id='+e.name+']').find('.wi-status-details').qtip('destroy', true);
			if(e.getAttribute('autosave') == 'true') {
				autoSaveInd=true; 
				listChanged();
			}		
		}
		
		function wiDisplayQtip(theSelect, itemId) {
			var autoSaveOn = false;
			if(autoSaveInd == true) {
				autoSaveInd = false;
				autoSaveOn = true;
			}
			theSelect.closest('.wi-status-details').qtip({
				content:{
					text: function(event, api) {
						var html= '<p class="tool-tip-content">{!JSENCODE($Label.TaskCompleteQtipText)}</p>';
						html += '<div class="tool-tip-form-buttons">';
						html += '<input id="confirmChangeWI" autosave= "'+ autoSaveOn +'" class="btn" name="' + itemId + '" type="button" onclick="changeStatusTask(this);" value="{!JSENCODE($Label.Yes)}"/>';
						html += '<input id="cancelChangeWI" autosave= "'+ autoSaveOn +'" class="btn" name="' + itemId + '" type="button" onclick="cancelChangeStatusTask(this);" value="{!JSENCODE($Label.No)}"/>';
						html += '</div>';
						return html;
					},
					title:'{!JSENCODE($Label.TaskCompleteQtipTitle)}'
				},
				position: {
					adjust: {
						method: 'flip flip'
					},
					viewport: $(window)
				},
				show: {
 					event: 'click',
 					solo: true
 				},
 				hide: false,
				style: {classes: 'qtip-light qtip-shadow qtip-rounded'}
			});
			jQuery('.qtip').css('display', 'block');
		}
		
		var myWorkItemsViewInd = false;
		
		function toggleWorkItemsView() {
			myWorkItemsViewInd = !myWorkItemsViewInd;
			jQuery('#workItemsViewMode').toggleClass('fa-toggle-off').toggleClass('fa-toggle-on');
			refreshList();
		}
		
		function myWorkItems(workItemsViewIndIn) {
			myWorkItemsViewInd = workItemsViewIndIn;
			jQuery("#workItemsViewMode").toggleClass('fa-toggle-off', myWorkItemsViewInd).toggleClass('fa-toggle-on', !myWorkItemsViewInd);						
			refreshList();
		}
		
		var autoSaveInd = true;
		
		function toggleAutoSave() {
			autoSaveInd = !autoSaveInd;
			jQuery("#autoSaveMode").toggleClass('fa-toggle-off').toggleClass('fa-toggle-on');
		}
		
		function autoSave(autoSaveIndIn) {
			autoSaveInd = autoSaveIndIn;
			jQuery("#autoSaveMode").toggleClass('fa-toggle-off', !autoSaveInd).toggleClass('fa-toggle-on', autoSaveIndIn);			
		}
		
		function hideWorking()
		{
			if(!disablePlan) jQuery('#toolbar-buttons>a').removeClass('disabled');
			jQuery('#loadingIndicatorOuterContainer').hide();
		}
		
		function showWorking()
		{
			jQuery('#toolbar-buttons>a').addClass('disabled');
			jQuery('#loadingIndicatorOuterContainer').show();
		}
		
		function hideSaving()
		{
			if(!disablePlan) jQuery('#toolbar-buttons>a, #toolbar-buttons>.auto-save-toggle-container>a').removeClass('disabled');
			jQuery('.list-input').prop('disabled', false).removeClass('working');
		}
		
		function showSaving()
		{
			jQuery('#toolbar-buttons>a, #toolbar-buttons>.auto-save-toggle-container>a').addClass('disabled');
			jQuery('.list-input').prop('disabled', 'disabled').addClass('working');
		}
		
		function initialiseFilter()
		{
			if(theResourcedActivities.length == 1) {
				jQuery('.filter-container').hide();
				return;
			}
			for(var i = 0; i < theResourcedActivities.length; i++) {
				theResourcedActivities[i].text = jQuery.parseHTML(theResourcedActivities[i].text)[0].textContent;
			}
						
			jQuery('#filter-input').select2({
				//minimumInputLength: 2,
				multiple: false,
				data: theResourcedActivities,
				initSelection : function (element, callback) {
					var data = {id: element.val(), text: element.attr('data-name')};
					callback(data);
				},
				 escapeMarkup: function(text) {return text;}
			});
			
			jQuery('#filter-input').on("select2-selecting", function(e) {
				theSelectedResourcedActivity = {id: e.object.id, name: e.object.text};
				if(jQuery.isEmptyObject(theSelectedResourcedActivity)) {$('#clear-button').css('visibility', 'hidden');	}
				else {$('#clear-button').css('visibility', 'visible');}
				refreshList();

			});
			
			jQuery('#clear-button').on('click', function() {
				$('#filter-input').val(null).trigger("change");
				theSelectedResourcedActivity = {};
				$('#clear-button').css('visibility', 'hidden');
				refreshList();	
			});			
		}
		
		function getTaskList()
		{
			jQuery.publish('kimble.task-list-working-start');
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ResourcePlanTasksController.GetTaskList}',
					currentResourceId,
						function(result, event){		  
							if (event.status) 
							{								
								theTasks = result.TheTaskItems;
								theActivities = result.TheActivityItems;
								theResourcedActivities = result.TheResourcedActivities;
								theResources = result.TheResources;
								theResourcedActivityWorkItemUnitTypeMap = result.ActivityWorkItemUnitTypeMap;
								theActivityAssResources = result.TheActivityAssignmentResources;
								thisResourcesActivities = result.ThisResourcesActivities;

								resetWorkingMaps();
								
								refreshList();
								
								initialiseFilter();
								jQuery.publish('kimble.task-list-working-end');				
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
					}, 
					{escape: true, timeout: 60000}
				);
		}
		
		var saveTimer;
		
		function listChanged()
		{
			jQuery(window).off('.has-changes').on('beforeunload.has-changes', function(){
				return kimble.labels['UnsavedChangesHeading'] + "\n\n" + kimble.labels['UnsavedChangesMessage']; 
			});

			// start a timer and then save on expiry - compensates for the user probably wanting to change the state of many items
			clearTimer();
			
			if(autoSaveInd)
			{
				saveTimer = setTimeout(saveTaskList, 4000);
			}
			
			jQuery('#saveButton').addClass('has-changes');
		}
		
		function clearTimer()
		{
			clearTimeout(saveTimer);
		}
		
		function resetListChanged()
		{
			jQuery(window).off('.has-changes');
			jQuery('#saveButton').removeClass('has-changes');
		}
		
		function processWorkItemSequenceChanges()
		{
			jQuery('.work-items').each(function(index) { 
				jQuery(this).find('li:not(.deleted)').each(function(wiIndex) {
					var itemId = jQuery(this).attr('node-id');
					workItemMap[itemId].Position = wiIndex + 1; 
				});
			});
		}
		
		function resetWorkingMaps()
		{
			taskMap = {};
			workItemMap = {};
			theDeletedItems = {};		
		}
		
		function saveTaskList()
		{
			clearTimer();
			
			jQuery.publish('kimble.task-list-save-start');
			
			// work items may have been moved around in their respective lists - iterate the controls and order them
			processWorkItemSequenceChanges();
			
			

			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ResourcePlanTasksController.SaveTaskList}',
					currentResourceId, taskMap, workItemMap, theDeletedItems, 
						function(result, event){		  
							if (event.status) 
							{
								theTasks = result.TheTaskItems;
								theActivities = result.TheActivityItems;
								theResourcedActivities = result.TheResourcedActivities;

								theResourcedActivityWorkItemUnitTypeMap = result.ActivityWorkItemUnitTypeMap;

								resetWorkingMaps();
								
								refreshList();
								
								resetListChanged();
								
								jQuery.publish('kimble.task-list-save-end');				
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
					}, 
					{escape: true, timeout: 60000}
				);
		}		
	</script>
	
