			html += '</div>';
			
			return html;
		}
		
		function formatPct(theVal)
		{
			var formattedVal = 0;
			if(theVal != undefined && theVal != '') formattedVal = theVal;
			formattedVal = jQuery.formatNumber(formattedVal, {format: "0.##", locale:kimble.locale, isFullLocale:false}) + '%';
			
			return formattedVal;
		}

		function formatNumberNat2DP(theVal)
		{
			var formattedVal = '0';
			if(theVal != undefined && theVal != '') formattedVal = theVal;
			formattedVal = kimble.formatNumber(formattedVal, "#.##");
			
			return (formattedVal != undefined && formattedVal != '' ? formattedVal : '0'); 
		}
		
		function parseNumber(theVal)
		{
			var formattedVal = '0';
			
			if(theVal != undefined && theVal != '') formattedVal = theVal;
			formattedVal = kimble.parseNumber(formattedVal);

			return (formattedVal != undefined && formattedVal != '' ? formattedVal : 0); 
		}		
		
		function getHighlightClass(status, startDate, endDate)
		{
			var highlightClass = '';
			
			if(status == 'NotStarted' && startDate != undefined && endDate != undefined)
			{
				if(startDate.toDate() < new Date() && endDate.toDate() < new Date())
				{
					highlightClass = ' red-highlight';
				}
				else if(startDate.toDate() < new Date() && endDate.toDate() > new Date())
				{
					highlightClass = ' amber-highlight';
				}
			}
			return highlightClass;
		}

		function getWorkItemHtml(theWorkItem, workItemUnitType)
		{
			var html = '';

			var itemIsDeleted = (theWorkItem.WorkItemId in theDeletedItems); 
	
			if(enableOwners && myWorkItemsViewInd && theWorkItem.ActivityAssignmentId != null && !thisResourcesActivities.filter(function(x) {return x == theWorkItem.ActivityAssignmentId})[0]) return html;
			var workItemNameHtml = '<textarea maxlength="80" class="work-item-name" placeholder="' + l['NewItem'] + '">' + (theWorkItem.Name != undefined && theWorkItem.Name != '' ? theWorkItem.Name : '') + '</textarea>';
			
			var additionalDetailsHtml = '';
			additionalDetailsHtml += '<div class="wi-add-details">';
			additionalDetailsHtml += '<textarea maxlength="2000" class="work-item-notes" placeholder="' + l['Notes'] + '">' + (theWorkItem.Notes != undefined && theWorkItem.Notes != '' ? theWorkItem.Notes : '') + '</textarea>';
			additionalDetailsHtml += '<maxlength="2000" class="work-item-owner" style="visibility:' + (enableOwners ? 'visible' : 'hidden') + ';">' + l['Owner'] + ': ' + (theWorkItem.ActivityAssignmentId != undefined && theWorkItem.ActivityAssignmentId != '' ? (theResources.filter(function(x) {return x.id == theWorkItem.ActivityAssignmentId})[0] != undefined ? theResources.filter(function(x) {return x.id == theWorkItem.ActivityAssignmentId})[0].text : '{!$Label.None}') : '{!$Label.None}' ) + '</maxlength="2000">';
			
			additionalDetailsHtml += '<div class="work-item-isblocked">';
			if(theWorkItem.Status == 'Completed') {additionalDetailsHtml += '<input type="checkbox" class="work-item-isblocked-box" disabled="true"/>' + l['IsBlocked'];}
			else {additionalDetailsHtml += '<input type="checkbox" class="work-item-isblocked-box" ' + (theWorkItem.IsBlocked ? ' checked="checked"' : '') + '"/>' + l['IsBlocked'];}
			additionalDetailsHtml += '</div></div>';
						
			var actionsHtml = '<div class="wi-actions">';
			if (theWorkItem.ActivityAllowNewTasks)
			{
				var editActionClass = (workItemObjectHasDetail(theWorkItem) ? 'fa-pencil-square has-detail' : 'fa-pencil-square-o');
				actionsHtml += '<i class="fa ' + editActionClass + ' edit-work-item" title="' + l['ShowDetails'] + '"></i>';
				actionsHtml += '<i class="fa fa-trash del-work-item" title="' + l['Delete'] + '"></i>';
			}
			actionsHtml += '</div>';
			
			var workItemClass = 'work-item list-item selectable';
			
			html += '<li node-id="' + theWorkItem.WorkItemId + '" parent-node-id="' + (theWorkItem.TaskId != null ? theWorkItem.TaskId : theWorkItem.ResourcedActivityId) + '" item-status="' + theWorkItem.Status + '" item-blocked="' + (theWorkItem.IsBlocked != null && theWorkItem.Status != 'Completed' ? theWorkItem.IsBlocked : false) + '" class="' + workItemClass + (theWorkItem.IsNew ? ' new last-added' : '') + '">' + workItemNameHtml + additionalDetailsHtml + actionsHtml;

			var workItemUnitsHtml = '';
			
			if(enableOwners && theWorkItem.ActivityAssignmentId != null) workItemUnitsHtml += '<i class="fa fa-user owner-ind" owner-detail="on"></i>';
			
			if(workItemUnitType == 'Point' || workItemUnitType == 'Item')
			{
				if(workItemUnitType == 'Item')
				{
					workItemUnitsHtml += '<input class="work-item-a-units" title="' + l['ActualUnits'] + '" value="' + (theWorkItem.ActualUnits == undefined ? 0 : formatNumberNat2DP(theWorkItem.ActualUnits)) + '" orig-value="' + (theWorkItem.ActualUnits == undefined ? 0 : theWorkItem.ActualUnits) + '"/>';
					workItemUnitsHtml += '<div class="work-item-a-unit-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
				}
				
				workItemUnitsHtml += '<input class="work-item-r-units" title="' + l['RemainingUnits'] + '" value="' + (theWorkItem.RemainingUnits == undefined ? 0 : formatNumberNat2DP(theWorkItem.RemainingUnits)) + '" orig-value="' + (theWorkItem.RemainingUnits == undefined ? 0 : theWorkItem.RemainingUnits) + '"/>';
				workItemUnitsHtml += '<div class="work-item-r-unit-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
			}
			html += workItemUnitsHtml;
			
			html += '<div class="wi-status-details">' + getStatusSelectHtml(theWorkItem) + '</div>';
			
			if(enableOwners && theWorkItem.ActivityAssignmentId != null) html += '<div class="ti-owner-details"><div class="task-owner-name">' + l['Owner'] + ': ' + (theResources.filter(function(x) {return x.id == theWorkItem.ActivityAssignmentId})[0] != undefined ? theResources.filter(function(x) {return x.id == theWorkItem.ActivityAssignmentId})[0].text : '') + '</div></div>';
			
			html += '</li>';			
			
			return html;
		}

		function workItemObjectHasDetail(theWorkItem)
		{
			return (theWorkItem.Notes != undefined && theWorkItem.Notes != '');
		}
		
		function workItemHasDetail(theWorkItem)
		{
			return (theWorkItem.find('.work-item-notes').val().length > 0);
		}			
		
		function getStatusSelectHtml(theTaskItem)
		{
			var html = '';
			
			html += '<select class="status-select ' + (theTaskItem.IsIteration ? '' : 'list-input ') + theTaskItem.Status + '"' + (theTaskItem.IsIteration ? ' disabled="disabled"' : '') + '>';
			html += '<option value="NotStarted"' + (theTaskItem.Status == 'NotStarted' ? 'selected="selected"' : '') + '>' + l['NotStarted'] + '</option>';
			html += '<option value="InProgress"' + (theTaskItem.Status == 'InProgress' ? 'selected="selected"' : '') + '>' + l['InProgress'] + '</option>';
			html += '<option value="Completed"' + (theTaskItem.Status == 'Completed' ? 'selected="selected"' : '') + '>' + l['Completed'] + '</option>';
			html += '</select>';
			
			return html;
		}
		
