	<script>
		var l = {};
		l['move-dependent-tasks-warning'] = '<apex:outputText value="{!$Label.kimbleone__movedependenttaskswarning}"/>';
		l['balance-label'] = '<apex:outputText value="{!$Label.kimbleone__balancelabel}"/>';
		l['Backlog'] = '<apex:outputText value="{!$Label.kimbleone__unassignedworkitems}"/>';
		l['AddWorkItem'] = '<apex:outputText value="{!$Label.kimbleone__addworkitem}"/>';
		l['WorkItem'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.Label}"/>';
		l['WorkItems'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.LabelPlural}"/>';
		l['NewItem'] = '<apex:outputText value="{!$Label.kimbleone__newplanitem}"/>';
		l['AddIterations'] = '<apex:outputText value="{!$Label.kimbleone__additerations}"/>';

		l['NotStarted'] = '<apex:outputText value="{!$Label.kimbleone__notstartedlabel}"/>';
		l['InProgress'] = '<apex:outputText value="{!$Label.kimbleone__inprogresslabel}"/>';
		l['Completed'] = '<apex:outputText value="{!$Label.kimbleone__complete}"/>';

		l['Baseline'] = '<apex:outputText value="{!$Label.kimbleone__baselinelabel}"/>';
		l['Expended'] = '<apex:outputText value="{!$Label.kimbleone__expendedeffort}"/>';
		l['Remaining'] = '<apex:outputText value="{!$Label.kimbleone__remainingeffort}"/>';
		l['PercentComplete'] = '<apex:outputText value="{!$Label.kimbleone__planpercentcomplete}"/>';

		l['ActualUnits'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.Fields.KimbleOne__ActualUnits__c.Label}"/>';
		l['RemainingUnits'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.Fields.KimbleOne__RemainingUnits__c.Label}"/>';
		l['Notes'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.Fields.KimbleOne__Notes__c.Label}"/>';
		l['IsBlocked'] = '<apex:outputText value="{!$ObjectType.KimbleOne__WorkItem__c.Fields.KimbleOne__IsBlocked__c.Label}"/>';
		l['ShowDetails'] = '<apex:outputText value="{!$Label.kimbleone__clicktoshowhideapprovaldetails}"/>';
		l['Delete'] = '<apex:outputText value="{!$Label.kimbleone__deletebutton}"/>';
		l['Owner'] = '<apex:outputText value="{!$Label.kimbleone__ownerlabel}"/>';
		l['EditRemainingEffort'] = '<apex:outputText value="{!$Label.kimbleone__editremainingeffortlabel}"/>';
		
		var newWorkItemStatus = '<apex:outputText value="{!NotStartedStatus}"/>';
		var inProgressWorkItemStatus = '<apex:outputText value="{!InProgressStatus}"/>';
		var completedWorkItemStatus = '<apex:outputText value="{!CompletedStatus}"/>';
		
		var currentResourceId = '<apex:outputText value="{!TheResource.Id}"/>';
		var currentActivityAssIds = [];
		var thisResourcesActivities = [];
		
		var unitTypeEnumToSuffixMap = {};
		<apex:outputText value="unitTypeEnumToSuffixMap={!UnitTypeEnumToSuffixJson};" rendered="{!!ISBLANK(UnitTypeEnumToSuffixJson)}"/>
		
		var enableOwners = <apex:outputText value="{!EnableOwnersWorkItems}"/>;
		var defaultOwnerToCurrentUser = <apex:outputText value="{!DefaultOwnerToCurrentUser}"/>;
		var enableSettingRemainingEffort = <apex:outputText value="{!EnableSettingPlanTaskRemainingEffort}"/>;
		
		var disablePlan = false;
		
		var theTasks = [];
		var theActivities = [];
		var theResourcedActivities = [];
		var theResources = [];
		var theActivityAssResources = [];
		
		var theSelectedResourcedActivity = {};

		var theResourcedActivityWorkItemUnitTypeMap = '';
		
		var theDeletedItems = {};
		
		var expandedWorkItems = [];
		var refreshingList = false;
		
		var taskMap = {};
		var workItemMap = {};
		
		jQuery(window).load(function()
		{
			if(!enableOwners) $('.filter-own-work-items').remove();
			initialiseActions();
			
			getTaskList();
			
		});
		
		function refreshList()
		{
			
			jQuery('.task-list-container').html(getTaskListHtml());
			
			initialiseTaskWorkItemsDragAndDrop();
			
			reOpenDetails();
		}
		
		function reOpenDetails() {
			refreshingList = true;	
				
			for(var i = 0; i < expandedWorkItems.length; i++) {
				var openDetails = editWorkItemClick.bind(jQuery('.work-item[node-id=' + expandedWorkItems[i] + ']').find('.edit-work-item'));
				openDetails();
			}
			
			refreshingList = false;
		}
		
		function getTaskListHtml()
		{
			var html = '';
			
			html += '<div class="task-list-table">';
			var theActivitiesLength = theActivities.length;
			
			getCurrentActivityAssignment();
			
			for(var i = 0; i < theActivitiesLength; i++)
			{
				var theActivityItem = theActivities[i];
				
				if(jQuery.isEmptyObject(theSelectedResourcedActivity) || theActivityItem.ResourcedActivityId == theSelectedResourcedActivity.id) {
	
					var actualUnits = 0;
					var forecastUnits = 0;
					var remainingUnits = 0;
					
					var workItemUnitType = theActivityItem.WorkItemUnitType;
					
					var activityHtml = '';
					activityHtml += '<div node-id="' + theActivityItem.ResourcedActivityId + '" scoping-id="' + theActivityItem.ResourcedActivityId + '" class="activity-item list-item">';
	
					activityHtml += '<div class="ai-actions">';
					if (theActivityItem.ActivityAllowNewTasks) activityHtml += '<div class="add-work-item"><i class="fa fa-plus-square activity-action-ind" title="' + l['AddWorkItem'] + '"></i></div>';
					activityHtml += '</div>';
					
					activityHtml += '<div class="ai-name-details">';
					activityHtml += '<div class="ai-act-name">' + theActivityItem.ActivityName + '</div>';
					activityHtml += '</div>';
	
					activityHtml += '<div class="ai-metrics">';
					activityHtml += '</div>';
					
					activityHtml += '<div class="ai-status-details">';
					activityHtml += '<div class="ai-start-date">' + kimble.formatDate(theActivityItem.StartDateUTC) + '</div>';
					activityHtml += '<div class="ai-end-date">' + kimble.formatDate(theActivityItem.EndDateUTC) + '</div>';
					activityHtml += '</div>';
					
					var workItemHtml = '';
					
					var theWorkItemLength = theActivityItem.WorkItems.length;
					workItemHtml += '<ul class="work-items activity-work-items" node-id="' + theActivityItem.ResourcedActivityId + '" scoping-id="' + theActivityItem.ResourcedActivityId + '">';
					for(var j = 0; j < theWorkItemLength; j++)
					{
						var theWorkItem = theActivityItem.WorkItems[j];
						workItemMap[theWorkItem.WorkItemId] = theWorkItem;
						
						workItemHtml += getWorkItemHtml(theWorkItem, workItemUnitType);
	
						if(workItemUnitType == 'Point' || workItemUnitType == 'Item')
						{
							remainingUnits += (theWorkItem.RemainingUnits == undefined ? 0 : theWorkItem.RemainingUnits);
							
							if(workItemUnitType == 'Item')
							{
								actualUnits += (theWorkItem.ActualUnits == undefined ? 0 : theWorkItem.ActualUnits);
								forecastUnits += (theWorkItem.ForecastUnits == undefined ? 0 : theWorkItem.ForecastUnits);
							}
						}					
					}
					workItemHtml += '</ul>';
	
					var workItemUnitsHtml = '';
					if(workItemUnitType == 'Point' || workItemUnitType == 'Item')
					{
						if(workItemUnitType == 'Item')
						{
							workItemUnitsHtml += '<div class="task-a-units-total" title="' + l['ActualUnits'] + '">' + formatNumberNat2DP(actualUnits) + '</div>';
							workItemUnitsHtml += '<div class="task-a-units-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
						}
					
						workItemUnitsHtml += '<div class="task-r-units-total">' + formatNumberNat2DP(remainingUnits) + '</div>';
						workItemUnitsHtml += '<div class="task-r-units-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
