					taskHtml += '<div class="ti-act-name">' + theTaskItem.ActivityName + '</div>';
					taskHtml += '</div>';
	
					taskHtml += '<div class="ti-metrics">';
	                taskHtml += '<div class="ass-baseline" title="' + l['Baseline'] + '">' + formatNumberNat2DP(theTaskItem.BaselineEffort) + '</div>';
	                taskHtml += '<div class="ass-expended' + startDateClass + '" title="' + l['Expended'] + '">' + formatNumberNat2DP(theTaskItem.ExpendedEffort) + '</div>';
	               	taskHtml += '<div class="ass-remaining' + endDateClass + '" title="' + l['Remaining'] + '">' + formatNumberNat2DP(theTaskItem.RemainingEffort) + '</div>';
	               	if(enableSettingRemainingEffort) taskHtml += '<i class="fa fa-pencil edit-task-item-effort" title="' + l['EditRemainingEffort'] + '" style="cursor: pointer;"></i>';
	               	taskHtml += '<div class="ass-pct-complete" title="' + l['PercentComplete'] + '">' + formatPct(theTaskItem.PercentageComplete) + '</div>';
					taskHtml += '</div>';
					
					taskHtml += '<div class="ti-status-details">';
					taskHtml += '<div class="ti-start-date' + startDateClass + '">' + kimble.formatDate(theTaskItem.StartDateUTC) + '</div>';
					taskHtml += '<div class="ti-end-date' + endDateClass + '">' + kimble.formatDate(theTaskItem.EndDateUTC) + '</div>';
					taskHtml += '<div class="ti-status' + highlightClass + '">' + getStatusSelectHtml(theTaskItem) + '</div>';
					taskHtml += '</div>';
					
					if(theTaskItem.AcceptWorkItems)
					{
						var workItemHtml = '';
						
						var actualUnits = 0;
						var forecastUnits = 0;
						var remainingUnits = 0;
					
						var workItemUnitType = theTaskItem.WorkItemUnitType;
					
						var theWorkItemLength = theTaskItem.WorkItems.length;
						workItemHtml += '<ul class="work-items task-work-items" node-id="' + theTaskItem.TaskId + '" scoping-id="' + theTaskItem.ResourcedActivityId + '">';				
						for(var j = 0; j < theWorkItemLength; j++)
						{
							var theWorkItem = theTaskItem.WorkItems[j];
							workItemMap[theWorkItem.WorkItemId] = theWorkItem;
							
							workItemHtml += getWorkItemHtml(theWorkItem, workItemUnitType);
	
							if(workItemUnitType == 'Point' || workItemUnitType == 'Item')
							{
								remainingUnits += (theWorkItem.RemainingUnits == undefined ? 0 : theWorkItem.RemainingUnits);
								
								if(workItemUnitType == 'Item')
								{
									actualUnits += (theWorkItem.ActualUnits == undefined ? 0 : theWorkItem.ActualUnits);
									forecastUnits += (theWorkItem.ForecastUnits == undefined ? 0 : theWorkItem.ForecastUnits);
								}							
							}						
						}
						workItemHtml += '</ul>';
	
						var workItemUnitsHtml = '';
						if(workItemUnitType == 'Point' || workItemUnitType == 'Item')
						{
							if(workItemUnitType == 'Item')
							{
								workItemUnitsHtml += '<div class="task-a-units-total" title="' + l['ActualUnits'] + '">' + formatNumberNat2DP(actualUnits) + '</div>';
								workItemUnitsHtml += '<div class="task-a-units-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
							}
												
							workItemUnitsHtml += '<div class="task-r-units-total" title="' + l['RemainingUnits'] + '">' + formatNumberNat2DP(remainingUnits) + '</div>';
							workItemUnitsHtml += '<div class="task-r-units-type">' + unitTypeEnumToSuffixMap[workItemUnitType] + '</div>';
