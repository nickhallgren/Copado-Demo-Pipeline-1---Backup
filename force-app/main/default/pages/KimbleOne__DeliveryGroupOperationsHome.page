	<script>
		
		var queuedUsage = new Array();
		
		function deleteAllAssignmentUsage()
		{
			startWorking();
			
			queuedUsage = jQuery('.removeForecast');
			
			if (queuedUsage.length == 0) return;
			
			queuedUsage.splice(0,1)[0].click();			
		}
		
		function removeForecastUsage(assignmentId, obj)
		{
   			var assignmentRowObj = jQuery('tr[assignmentid="' + assignmentId + '"]');
   			assignmentRowObj.find('td.actions-cell').addClass('Processing');
   			assignmentRowObj.find('a.removeForecast').hide();
   			
   			var assignmentExpectedObj = assignmentRowObj.find('[id$="expectedUsage"]');
   			var assignmentRemainingObj = assignmentRowObj.find('[id$="remainingUsage"]');
   			
   			var resourcedActivityId = assignmentRowObj.attr('resourcedactivityid')
   			
   			var activityExpectedObj = jQuery('tr[resourcedactivityid="' + resourcedActivityId + '"]').find('[id$="activityExpectedUsage"]');
   			var activityRemainingObj = jQuery('tr[resourcedactivityid="' + resourcedActivityId + '"]').find('[id$="activityRemainingUsage"]');
   			
   			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupOperationsHomeController.RemoveForecastUsage}',
	       		assignmentId, businessUnitGroupId, periodStartDateUTC, periodEndDateUTC, removeUsageStartDateUTC, removeUsageEndDateUTC, resourcedActivityId,
	      			function(result, event){          
	             		if (event.status) 
			            {			            	
			            	assignmentExpectedObj.text(jQuery.formatNumber(result.Expected, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
			            	assignmentExpectedObj.effect('highlight',2000);
			            	
			            	assignmentRemainingObj.text(jQuery.formatNumber(result.Remaining, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
			            	assignmentRemainingObj.effect('highlight',2000);
			            	
			            	activityExpectedObj.text(jQuery.formatNumber(result.TotalExpected, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
			            	activityExpectedObj.effect('highlight',2000);
			            	
			            	activityRemainingObj.text(jQuery.formatNumber(result.TotalRemaining, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
			            	activityRemainingObj.effect('highlight',2000);
			            	
				   			assignmentRowObj.find('td.actions-cell').removeClass('Processing');
				   			assignmentRowObj.find('a.removeForecast').show();
			            	
			            	if (queuedUsage.length == 0)
			            	{
			            		refreshGraphView();
			            		stopWorking();
			            		return;
			            	}
			            			
							queuedUsage.splice(0,1)[0].click();
							
			         	} 
			         	else 
			         	{
			             	alert(event.message);
				   			assignmentRowObj.find('td.actions-cell').removeClass('Processing');
				   			assignmentRowObj.find('a.removeForecast').show();
			         	}		         	
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
		}
		
		function startWorking()
		{
			jQuery('#deleteAllUsageButton').hide();
			jQuery('#deleteAllUsageWorking').show();
		}		

		function stopWorking()
		{
			jQuery('#deleteAllUsageButton').show();
			jQuery('#deleteAllUsageWorking').hide();
		}		
		
		jQuery(window).load(function() {
			initialiseScreen();
		});
				
		function initialiseScreen() {
			setupDatePicker();
			setupGridBehaviours();
			setupSummaryCharts();
			
			jQuery('#deleteAllUsageButton').show();
			jQuery('.fa-info-circle').qtip();
		}
						
		function setupTimeSummaryCharts() {
			// time entry summary		 	
		 	var timeEntryGraphData = new Array(
		   		 [timeEntrySummaryData.formattedForecastP3Usage.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'{!JSENCODE($Label.ExpectedHoursGraphHeading)}','#BBB'],
		   		 [timeEntrySummaryData.formattedRemainingP3Usage.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'{!JSENCODE($Label.DeliveryGroupHomeRemaining)}','#F0BB75'],
		   		 [timeEntrySummaryData.formattedDraftTime.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowTimeDetails)}\', \'{!JSENCODE(ApprovalStatusDraft)}\')">{!$Label.DraftHoursGraphHeading}</a>','#729BC7'],
		   		 [timeEntrySummaryData.formattedRejectedTime.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowTimeDetails)}\', \'{!JSENCODE(ApprovalStatusRejected)}\')">{!$Label.Rejected}</a>','#B42D34'],
		   		 [timeEntrySummaryData.formattedReadyForApprovalTime.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowTimeDetails)}\', \'{!JSENCODE(ApprovalStatusReadyForApproval)}\')">{!$Label.PendingApprovalWithLineBreakHeading}</a>','#E58E1A'],
		   		 [timeEntrySummaryData.formattedActualUsage.{!JSENCODE(NamespacePrefix)}InputDecimal__c, '<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowTimeDetails)}\', \'{!JSENCODE(ApprovalStatusApproved)}\')">{!$Label.ApprovedHoursGraphHeading}</a>','#008752']);
		   		 
		 	$('#divForTimeEntrySummaryGraph').jqBarGraph({ data: timeEntryGraphData,title: '<div class="graphTitle">{!$Label.TotalTimeEntryHeading} ({!JSENCODE(DisplayUnitType.Suffix__c)})</div>', height:150, width:495, animate: false, barSpace: 6}); 
		 	
		 	jQuery.each($('div.graphValuedivForTimeEntrySummaryGraph'),function(i,obj){
		 		$(obj).text($.formatNumber($(obj).text(), {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
		 	});
		 	
		 	// time invoicing summary
		 	var timeInvoicingGraphData = new Array(
		   		 [timeInvoicingSummaryData.formattedInvoiceableTime.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'Invoiceable','#729BC7'],
		   		 [timeInvoicingSummaryData.formattedInvoicedTime.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'Invoiced','#008752']);
		   		 
		 	$('#divForTimeInvoicingSummaryGraph').jqBarGraph({ data: timeInvoicingGraphData,title: '<div class="graphTitle">{!$Label.TotalTimeInvoicingHeading} ({!JSENCODE(DisplayUnitType.Suffix__c)})</div>', height:150, width:158, animate: false, barSpace: 6}); 
		 	
		 	jQuery.each($('div.graphValuedivForTimeInvoicingSummaryGraph'),function(i,obj){
		 		$(obj).text($.formatNumber($(obj).text(), {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
		 	});		
		}
		
		function setupExpenseSummaryCharts() {
			// expense entry summary		 	
		 	var expenseEntryGraphData = new Array(
		   		 [expenseEntrySummaryData.formattedDraftExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowExpenseDetails)}\', \'{!JSENCODE(ApprovalStatusDraft)}\')">{!$Label.DraftHoursGraphHeading}</a>','#729BC7'],
		   		 [expenseEntrySummaryData.formattedRejectedExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowExpenseDetails)}\', \'{!JSENCODE(ApprovalStatusRejected)}\')">{!$Label.Rejected}</a>','#B42D34'],
		   		 [expenseEntrySummaryData.formattedReadyForApprovalExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowExpenseDetails)}\', \'{!JSENCODE(ApprovalStatusReadyForApproval)}\')">{!$Label.PendingApprovalWithLineBreakHeading}</a>','#E58E1A'],
		   		 [expenseEntrySummaryData.formattedActualExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'<a href="javascript:void(0)" onclick="changeView(\'{!JSENCODE(ShowExpenseDetails)}\', \'{!JSENCODE(ApprovalStatusApproved)}\')">{!$Label.ApprovedHoursGraphHeading}</a>','#008752']);
		   		 
		 	$('#divForExpenseEntrySummaryGraph').jqBarGraph({ data: expenseEntryGraphData,title: '<div class="graphTitle">{!$Label.TotalExpenseEntryHeading} ({!DeliveryGroupCurrencyIsoCode})</div>', height:150, width:386, animate: false, barSpace: 7}); 
		 	
		 	jQuery.each($('div.graphValuedivForExpenseEntrySummaryGraph'),function(i,obj){
		 		$(obj).text($.formatNumber($(obj).text(), {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
		 	});
		 	
		 	// expense invoicing summary
		 	var expenseInvoicingGraphData = new Array(
		   		 [expenseInvoicingSummaryData.formattedInvoiceableExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'Invoiceable','#729BC7'],
		   		 [expenseInvoicingSummaryData.formattedInvoicedExpense.{!JSENCODE(NamespacePrefix)}InputDecimal__c,'Invoiced','#008752']);
		   		 
		 	$('#divForExpenseInvoicingSummaryGraph').jqBarGraph({ data: expenseInvoicingGraphData,title: '<div class="graphTitle">{!$Label.TotalExpenseInvoicingHeading} ({!JSENCODE(DeliveryGroupInvoicingCurrencyIsoCode)})</div>', height:150, width:186, animate: false, barSpace: 6}); 
		 	
		 	jQuery.each($('div.graphValuedivForExpenseInvoicingSummaryGraph'),function(i,obj){
		 		$(obj).text($.formatNumber($(obj).text(), {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));
		 	});		
		}
		
		function setupGridBehaviours() {
	        jQuery(".groupDataRowHideCell").click(function() {
	        	var theResourcedActivityId = $(this).parent().attr('resourcedActivityId');
	        	var groupRowIsDisplayed = $(this).parent().find('img').hasClass("groupDataRowExpanded");
	        	
	        	// can't just use toggle as that would mean that child assignments that were hidden
	        	// would appear when hiding the group, instead hide those that are visible if visible
	        	// or show those that are hidden if not childassignmentrows
	        	if(groupRowIsDisplayed) {
	            	jQuery(".dataRow[resourcedActivityId='" + theResourcedActivityId + "']:visible").hide();
	            }
	            else {
	            	jQuery(".dataRow[resourcedActivityId='" + theResourcedActivityId + "']").show();
					jQuery(".parentAssignmentDataRow[resourcedActivityId='" + theResourcedActivityId + "']").find('img').removeClass('parentAssignmentDataRowTwisterCollapsed').addClass('parentAssignmentDataRowTwisterExpanded');	            	
	            }
	            	
	            jQuery(this).parent().find('img').toggleClass('groupDataRowTwisterExpanded');
	            jQuery(this).parent().find('img').toggleClass('groupDataRowTwisterCollapsed');            
            
	            $(this).parent().find('img').toggleClass('groupDataRowExpanded');
	            $(this).parent().find('img').toggleClass('groupDataRowCollapsed');
	        });
        			        
	        jQuery(".parentAssignmentDataRow").click(function() {
	        	var assignmentId = $(this).closest('tr').attr('assignmentId');
	            jQuery(".dataRow[parentAssignmentId='" + assignmentId + "']").toggle();
	            jQuery(this).find('img').toggleClass('parentAssignmentDataRowTwisterExpanded');
	            jQuery(this).find('img').toggleClass('parentAssignmentDataRowTwisterCollapsed');
	        });
	    }
	    
	    function setupDatePicker() { 			
			$('.datepicker').datepicker({ 
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true, 
					selectOtherMonths: true, 
					buttonText: '{!JSENCODE($Label.OpenTimePeriodDropdownToolTip)}', 
					buttonImageOnly: true, 
					buttonImage: '{!URLFOR($Resource.AssignmentImages, 'CalendarButtonSquare.png')}', 
					showOn: "button",
					changeMonth: true,
      				changeYear: true
			}); 
		}
	        
	</script>		
