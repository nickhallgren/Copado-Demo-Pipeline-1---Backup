<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupOperationsHomeController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="OperationsDashboard.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}" />

</apex:define>
     
<apex:define name="Content">
	
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__jQueryBarGraph, 'jqBarGraph.1.1.min.js')}"/>   
	
	<apex:pageBlock title="{!$Label.kimbleone__deliveryengagementoperationsheading}">
		
	<apex:form >
		
	<apex:outputPanel id="resourcedActivitySummaryData">
	
	<apex:pageMessages escape="false"/>
	
	<br/>
	<apex:actionStatus id="ResourcedActivityListLoadingStatus">
		<apex:facet name="start">
			<div id="loadingIndicatorOuterContainer" class="loadingIndicator">
				<div id="loadingIndicatorInnerContainer">
					<img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
				</div>
			</div>
		</apex:facet>
	</apex:actionStatus>
	<apex:outputPanel id="ResourcedActivityTimeHeaderPanel">
	<table cellpadding="0" cellspacing="0" border="0">
		<tr height="173px" >
			<td class="centerAlignDataCell" width="340px" style="background-color:#FFF">

 				<apex:selectRadio id="rdoPeriodMode" styleClass="centerAlignTable" onclick="togglePeriodMode()" value="{!PeriodMode}">
            		<apex:selectOptions value="{!PeriodModes}"/>
            	</apex:selectRadio>

				<span>			
					<apex:outputLink value="#" onclick="goPreviousPeriod()" title="{!$Label.kimbleone__previousperiod}">
						<apex:image url="{!URLFOR($Resource.KimbleOne__AssignmentImages, 'PreviousButtonSquare.png')}" alt="{!$Label.kimbleone__previousperiod}" />
					</apex:outputLink>
					<span class="periodLabel">&nbsp;<span class="periodLabelHeading">&nbsp;&nbsp;{!$ObjectType.TimePeriod__c.Label}:&nbsp;</span>{!JSENCODE(PeriodName)}&nbsp;&nbsp;&nbsp;</span>
					<span class="selectable"><apex:inputText styleClass="datepicker" style="width:0px;border:0px; margin:0px; padding:0px;" value="{!GoDate.KimbleOne__InputDate__c}" onchange="moveToDate()" /></span>
					
					<apex:outputLink value="#" onclick="goNextPeriod()" title="{!$Label.kimbleone__nextperiod}">
						<apex:image url="{!URLFOR($Resource.KimbleOne__AssignmentImages, 'NextButtonSquare.png')}" alt="{!$Label.kimbleone__nextperiod}" />
					</apex:outputLink>
				</span>
				<p/>
				<span class="periodLabel">{<apex:outputField value="{!PeriodStartDate.KimbleOne__InputDate__c}"/>&nbsp;-&nbsp;<apex:outputField value="{!PeriodEndDate.KimbleOne__InputDate__c}"/>}</span>

 				<apex:selectRadio id="rdoViewMode" styleClass="centerAlignTable" onclick="toggleTimeExpense()" value="{!DisplayMode}">
            		<apex:selectOptions value="{!DisplayModes}"/>
            	</apex:selectRadio>
            
			</td>
			<td width="6px"></td>
			
			<apex:outputpanel layout="none" rendered="{!DisplayMode = DisplayModeTime}">
				<td id="" width="504px" valign="top" class="graphText" style="background-color:#FFF">				
					<div id="divForTimeEntrySummaryGraph" class="graphText"></div>
				</td>
			</apex:outputpanel>
			<apex:outputpanel layout="none" rendered="{!DisplayMode = DisplayModeExpense}">
				<td width="395px" valign="top" class="graphText" style="background-color:#FFF">
					<div id="divForExpenseEntrySummaryGraph" class="graphText"></div>
				</td>
			</apex:outputpanel>
			
			<td width="6px"></td>
			
			<apex:outputpanel layout="none" rendered="{!DisplayMode = DisplayModeTime}">
				<td width="167px" valign="top" class="graphText" style="background-color:#FFF">	
					<div id="divForTimeInvoicingSummaryGraph" class="graphText"></div>				
				</td>
			</apex:outputpanel>
			<apex:outputpanel layout="none" rendered="{!DisplayMode = DisplayModeExpense}">
				<td width="195px" valign="top" class="graphText" style="background-color:#FFF">	
					<div id="divForExpenseInvoicingSummaryGraph" class="graphText"></div>
				</td>
			</apex:outputpanel>
		</tr>
	</table>
	
	<script>
		var timeEntrySummaryData = jQuery.parseJSON('<apex:outputText value="{!JSENCODE(TheTimeEntrySummaryJson)}"/>');
		var timeInvoicingSummaryData = jQuery.parseJSON('<apex:outputText value="{!JSENCODE(TheTimeInvoicingSummaryJson)}"/>');
		
		var businessUnitGroupId = '<apex:outputText value="{!BusinessUnitGroupId}"/>';
		var periodStartDateUTC = '<apex:outputText value="{!PeriodStartDateUTC}"/>';
		var removeUsageStartDateUTC = '<apex:outputText value="{!RemoveUsagePeriodStartDateUTC}"/>';
		var periodEndDateUTC = '<apex:outputText value="{!PeriodEndDateUTC}"/>';
		var removeUsageEndDateUTC = '<apex:outputText value="{!RemoveUsagePeriodEndDateUTC}"/>';
	</script>
	
	</apex:outputPanel>
	<br/>
	
	<apex:outputpanel rendered="{!DisplayMode = DisplayModeTime}">
	<apex:outputpanel layout="none" rendered="{!ShowRemoveUsage}">
		<div id="deleteAllUsageWorking" class="Processing"></div>
		<input id="deleteAllUsageButton" type="button" value="{!$Label.RemoveAllUsageButton}" onclick="deleteAllAssignmentUsage();"/>
		<apex:outputpanel layout="none" rendered="{!!ISBLANK(RemoveUsageMessage)}">
			<i class="fa fa-info-circle" title="{!JSENCODE(RemoveUsageMessage)}"></i>
		</apex:outputpanel>
	</apex:outputpanel>
															
	<table id="timeSummaryTable" class="list" border="0" cellpadding="0" cellspacing="0">
		<colgroup>
			<col style="width: 27px;"/> 
			<col style="width: 170px;"/>
			<col style="width: 76px;"/>
			<col style="width: 70px;"/>

			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
			<col style="width: 85px;"/>
		</colgroup>
		<thead>
			<tr class="headerRow">
				<th colspan="2" class="headerRow"></th>
				<th colspan="2" class="headerRow"></th>
					
				<th colspan="6" class="headerRow" style="text-align: center;"><h2>{!$Label.TimeEntryHeading} ({!JSENCODE(DisplayUnitType.Suffix__c)})</h2></th>
				<th colspan="2" class="headerRow" style="text-align: center;"><h2>{!$Label.TimeInvoicingHeading} ({!JSENCODE(DisplayUnitType.Suffix__c)})</h2></th>
			</tr>

			<tr class="headerRow">
				<th class="headerRow">
					<span class="columnLabel"></span>
				</th>
	                											
				<th class="headerRow ui-resizable sortable">
	            	<span class="columnLabel"><h2>{!$ObjectType.KimbleOne__Resource__c.Fields.Name.Label} &amp; {!$ObjectType.ActivityAssignment__c.Fields.ActivityRole__c.Label}</h2></span>
	            </th>
	             
	            <th class="headerRow ui-resizable">{!$ObjectType.ActivityAssignment__c.Fields.StartDate__c.Label}</th>
				<th class="headerRow ui-resizable">{!$Label.EndDateLabel}</th>
					
				<th class="headerRow ui-resizable">{!$Label.ExpectedHoursGraphHeading}</th>
				<th class="headerRow ui-resizable">{!$Label.DeliveryGroupHomeRemaining}</th>
				<th class="headerRow ui-resizable">{!$Label.ApprovalStatusDraftLabel}</th>
				<th class="headerRow ui-resizable">{!$Label.Rejected}</th>
				<th class="headerRow ui-resizable">{!$Label.PendingApprovalHoursGraphHeading}</th>	
				<th class="headerRow ui-resizable">{!$Label.Approved}</th>	
				<th class="headerRow ui-resizable">{!$Label.InvoiceableHeading}</th>	
				<th class="headerRow ui-resizable">{!$Label.InvoicedLabel}</th>
			</tr>
		</thead>
		<tbody>		
			<apex:repeat value="{!ResourcedActivities}" var="theResourcedActivity">		
				<apex:variable value="{!ResourcedActivityTimeEntryStatisticsMap[theResourcedActivity.Id]}" var="theResourcedActivityTimeEntryStatistics"/>
				<apex:variable value="{!ResourcedActivityTimeInvoicingStatisticsMap[theResourcedActivity.Id]}" var="theResourcedActivityTimeInvoicingStatistics"/>											
				<tr id="resourceActivityHeader" class="groupDataRow" title="{!$Label.ClickToHideAssignmentsMessage}" resourcedActivityId="{!JSENCODE(theResourcedActivity.Id)}">
					<td colspan="4" class="groupDataRowHideCell"><img class="groupDataRowCollapsed" src="/s.gif"/>{!$Label.Activity}:&nbsp;{!JSENCODE(theResourcedActivity.Name)}</td>
						
					<td class="dataCell rightAlignDataCell"><apex:outputField id="activityExpectedUsage" value="{!theResourcedActivityTimeEntryStatistics.formattedForecastP3Usage.InputDecimal__c}" /></td>
					<td class="dataCell rightAlignDataCell"><apex:outputField id="activityRemainingUsage" value="{!theResourcedActivityTimeEntryStatistics.formattedRemainingP3Usage.InputDecimal__c}" /></td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowTimeDetails}', '{!ApprovalStatusDraft}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityTimeEntryStatistics.formattedDraftTime.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowTimeDetails}', '{!ApprovalStatusRejected}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityTimeEntryStatistics.formattedRejectedTime.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowTimeDetails}', '{!ApprovalStatusReadyForApproval}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityTimeEntryStatistics.formattedReadyForApprovalTime.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowTimeDetails}', '{!ApprovalStatusApproved}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityTimeEntryStatistics.formattedActualUsage.InputDecimal__c}"/>
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourcedActivityTimeInvoicingStatistics.formattedInvoiceableTime.InputDecimal__c}"/></td>
					<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourcedActivityTimeInvoicingStatistics.formattedInvoicedTime.InputDecimal__c}"/></td>							
				</tr>
		
				<apex:repeat value="{!SortedAssignmentsMap[theResourcedActivity.Id]}" var="theActivityAssignment">
					<apex:variable value="{!ResourcedActivityDetailsMap[theResourcedActivity.Id][theActivityAssignment.Id]}" var="theAssignmentOperationalView"/>				
					<apex:variable value="{!theAssignmentOperationalView.TheActivityAssignment}" var="theAssignment"/>
					<apex:variable value="{!theActivityAssignment.StartDate__c <= PeriodEndDate.KimbleOne__InputDate__c && theActivityAssignment.ForecastP3EndDate__c >= PeriodStartDate.KimbleOne__InputDate__c}" var="thisPeriod"/>
					<apex:outputPanel layout="none" rendered="{!thisPeriod && (theAssignmentOperationalView.TheTimeEntryStatistics.hasValues || theAssignmentOperationalView.TheTimeInvoicingStatistics.hasValues)}">
					<tr class="dataRow" 
									resourcedActivityId="{!JSENCODE(theAssignment.ResourcedActivityOperatedWith__r.Id)}"
									assignmentId="{!JSENCODE(theAssignment.Id)}"
									parentAssignmentId="{!IF(theAssignment.ActivityAssignment__c != null, JSENCODE(theAssignment.ActivityAssignment__c), '')}">
																					
						<td style="padding-left: 0px; padding-right: 0px;" class="actions-cell">
							<apex:outputLink value="#" styleclass="removeForecast" onclick="removeForecastUsage('{!JSENCODE(theAssignment.Id)}',this);" title="{!$Label.kimbleone__removeforecastusagelabel}" rendered="{!ShowRemoveUsage && theAssignment.ActivityAssignmentType__r.Enum__c != 'AppliedModel'}">
									<i class="fa fa-times"></i>
							</apex:outputLink>
						</td>
						<td class="dataCell {!IF(theAssignment.ActivityAssignment__c != null, 'childAssignmentIndentedCell', '')}" >
							<apex:outputpanel rendered="{!OR(theAssignment.ActivityAssignmentType__r.Enum__c = 'ResourcedParent', theAssignment.ActivityAssignmentType__r.Enum__c = 'AppliedModel')}" styleclass="{!IF(OR(theAssignment.ActivityAssignmentType__r.Enum__c = 'ResourcedParent', theAssignment.ActivityAssignmentType__r.Enum__c = 'AppliedModel'), 'parentAssignmentDataRow', '')} {!IF(theAssignment.ActivityAssignment__c != null, 'childAssignmentDataRow', '')}">
								<img class="parentAssignmentDataRowTwisterExpanded" src="/s.gif"/>
							</apex:outputpanel>
							
							<apex:outputField value="{!theAssignment.Resource__c}"/>
							<p/><apex:outputText value="{!theAssignment.ActivityRole__r.Name}"/>
						</td>
						
						<td class="dataCell rightAlignDataCell">
							<apex:outputField value="{!theAssignment.StartDate__c}"/>
						</td>
						<td class="dataCell rightAlignDataCell">
							<apex:outputField value="{!theAssignment.ForecastP3EndDate__c}"/>
						</td>
						
						<td class="dataCell rightAlignDataCell">
							<!-- There is no forecast at this level if this is a child assignment -->
							<apex:outputField id="expectedUsage" value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedForecastP3Usage.InputDecimal__c}" />
							
						</td>
						<td class="dataCell rightAlignDataCell">
							<apex:outputField id="remainingUsage" styleclass="{!IF(ISBLANK(theAssignment.ActivityAssignment__c),'includeInRollup','')}" value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedRemainingP3Usage.InputDecimal__c}"/>
						</td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedDraftTime.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedRejectedTime.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedReadyForApprovalTime.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeEntryStatistics.formattedActualUsage.InputDecimal__c}"/></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeInvoicingStatistics.formattedInvoiceableTime.InputDecimal__c}"/></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theAssignmentOperationalView.TheTimeInvoicingStatistics.formattedInvoicedTime.InputDecimal__c}"/></td>							
					</tr>
					</apex:outputPanel>
				</apex:repeat>
			</apex:repeat>
		</tbody>
	</table>

	<script>
		function setupSummaryCharts() {
			setupTimeSummaryCharts();
		}
		
	</script>
	</apex:outputpanel>

	<apex:outputpanel rendered="{!DisplayMode = DisplayModeExpense}">																
	<table id="expenseSummaryTable" class="list" border="0" cellpadding="0" cellspacing="0">
		<colgroup>
			<col style="width: 27px;"/>
			<col style="width: 317px;"/>

			<col style="width: 100px;"/>
			<col style="width: 100px;"/>
			<col style="width: 100px;"/>
			<col style="width: 100px;"/>
			<col style="width: 100px;"/>
			<col style="width: 100px;"/>
		</colgroup>
		<thead>
			<tr class="headerRow">
				<th colspan="2" class="headerRow"></th>
				
				<th colspan="4" class="headerRow" style="text-align: center;"><h2>{!$Label.ExpenseEntryHeading} ({!DeliveryGroupCurrencyIsoCode})</h2></th>
				<th colspan="2" class="headerRow" style="text-align: center;"><h2>{!$Label.ExpenseInvoicingHeading} ({!DeliveryGroupInvoicingCurrencyIsoCode})</h2></th>
			</tr>

			<tr class="headerRow">
				<th class="headerRow">
					<span class="columnLabel"></span>
				</th>
	                											
				<th class="headerRow ui-resizable sortable">
	            	<span class="columnLabel"><h2>{!$ObjectType.KimbleOne__Resource__c.Fields.Name.Label}</h2></span>
	            </th>
	             						
				<th class="headerRow ui-resizable">{!$Label.ApprovalStatusDraftLabel}</th>
				<th class="headerRow ui-resizable">{!$Label.Rejected}</th>
				<th class="headerRow ui-resizable">{!$Label.PendingApprovalHoursGraphHeading}</th>	
				<th class="headerRow ui-resizable">{!$Label.Approved}</th>	
				<th class="headerRow ui-resizable">{!$Label.InvoiceableHeading}</th>	
				<th class="headerRow ui-resizable">{!$Label.InvoicedLabel}</th>
			</tr>
		</thead>
		<tbody>		
			<apex:repeat value="{!ResourcedActivities}" var="theResourcedActivity">		
				<apex:variable value="{!ResourcedActivityExpenseEntryStatisticsMap[theResourcedActivity.Id]}" var="theResourcedActivityExpenseEntryStatistics"/>
				<apex:variable value="{!ResourcedActivityExpenseInvoicingStatisticsMap[theResourcedActivity.Id]}" var="theResourcedActivityExpenseInvoicingStatistics"/>
				<apex:outputPanel layout="none" rendered="{!theResourcedActivityExpenseEntryStatistics.hasValues}">
				<tr id="resourceActivityHeader" class="groupDataRow" title="{!$Label.ClickToHideResourcesMessage}" resourcedActivityId="{!JSENCODE(theResourcedActivity.Id)}">
					<td colspan="2" class="groupDataRowHideCell"><img class="groupDataRowCollapsed" src="/s.gif"/>{!$ObjectType.ResourcedActivity__c.Label}: {!JSENCODE(theResourcedActivity.Name)}</td>
						
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowExpenseDetails}', '{!JSENCODE(ApprovalStatusDraft)}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityExpenseEntryStatistics.formattedDraftExpense.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowExpenseDetails}', '{!JSENCODE(ApprovalStatusRejected)}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityExpenseEntryStatistics.formattedRejectedExpense.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowExpenseDetails}', '{!ApprovalStatusReadyForApproval}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityExpenseEntryStatistics.formattedReadyForApprovalExpense.InputDecimal__c}" />
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell">
						<apex:outputLink value="#" onclick="changeView('{!ShowExpenseDetails}', '{!ApprovalStatusApproved}', 'true', '{!JSENCODE(theResourcedActivity.Id)}')" title="{!$Label.kimbleone__viewlistlabel}">
							<apex:outputField value="{!theResourcedActivityExpenseEntryStatistics.formattedActualExpense.InputDecimal__c}"/>
						</apex:outputLink>
					</td>
					<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourcedActivityExpenseInvoicingStatistics.formattedInvoiceableExpense.InputDecimal__c}"/></td>
					<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourcedActivityExpenseInvoicingStatistics.formattedInvoicedExpense.InputDecimal__c}"/></td>							
				</tr>
				</apex:outputPanel>
				<apex:repeat value="{!ResourcesMap[theResourcedActivity.Id]}" var="theResource">
					<apex:variable value="{!ResourcedActivityDetailsMap[theResourcedActivity.Id][theResource.Id]}" var="theResourceOperationalView"/>				
					
					<apex:outputPanel layout="none" rendered="{!theResourceOperationalView.TheExpenseEntryStatistics.hasValues || theResourceOperationalView.TheExpenseInvoicingStatistics.hasValues}">				
					<tr class="dataRow hiddenDataRow" resourcedActivityId="{!JSENCODE(theResourcedActivity.Id)}">												
						<td style="padding-left: 0px; padding-right: 0px;"></td>
						<td class="dataCell"><apex:outputField value="{!theResource.Name}"/></td>
						
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseEntryStatistics.formattedDraftExpense.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseEntryStatistics.formattedRejectedExpense.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseEntryStatistics.formattedReadyForApprovalExpense.InputDecimal__c}" /></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseEntryStatistics.formattedActualExpense.InputDecimal__c}"/></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseInvoicingStatistics.formattedInvoiceableExpense.InputDecimal__c}"/></td>
						<td class="dataCell rightAlignDataCell"><apex:outputField value="{!theResourceOperationalView.TheExpenseInvoicingStatistics.formattedInvoicedExpense.InputDecimal__c}"/></td>							
					</tr>
					</apex:outputPanel>
				</apex:repeat>
			</apex:repeat>
		</tbody>
	</table>

	<script>
		var expenseEntrySummaryData = jQuery.parseJSON('<apex:outputText value="{!JSENCODE(TheExpenseEntrySummaryJson)}"/>');
		var expenseInvoicingSummaryData = jQuery.parseJSON('<apex:outputText value="{!JSENCODE(TheExpenseInvoicingSummaryJson)}"/>');
		
		function setupSummaryCharts() {
			setupExpenseSummaryCharts();
		}
	</script>
	</apex:outputpanel>

	<apex:actionFunction action="{!TrackingPeriodChange}" name="moveToDate" rerender="resourcedActivitySummaryData, ViewLoadingStatus" status="ResourcedActivityListLoadingStatus" oncomplete="initialiseScreen();"/>
	<apex:actionFunction action="{!GoPreviousPeriod}" name="goPreviousPeriod" rerender="resourcedActivitySummaryData, ViewLoadingStatus" status="ResourcedActivityListLoadingStatus" oncomplete="initialiseScreen();"/>
	<apex:actionFunction action="{!GoNextPeriod}" name="goNextPeriod" rerender="resourcedActivitySummaryData, ViewLoadingStatus" status="ResourcedActivityListLoadingStatus" oncomplete="initialiseScreen();"/>

	<apex:actionFunction action="{!ChangeView}" name="changeView" rerender="ViewLoadingStatus" status="ResourcedActivityListLoadingStatus">
		<apex:param name="viewName" value="" />
		<apex:param name="selectedApprovalStatus" value=""/>
		<apex:param name="restrictViewScope" value="" />
		<apex:param name="resourcedActivityId" value="" />
	</apex:actionFunction>

	<apex:actionFunction action="{!ChangeDisplayMode}" name="toggleTimeExpense" rerender="resourcedActivitySummaryData, ViewLoadingStatus" status="ResourcedActivityListLoadingStatus" oncomplete="initialiseScreen();"></apex:actionFunction>
	<apex:actionFunction action="{!ChangePeriodMode}" name="togglePeriodMode" rerender="resourcedActivitySummaryData, ViewLoadingStatus" status="ResourcedActivityListLoadingStatus" oncomplete="initialiseScreen();"></apex:actionFunction>
	
	<apex:actionFunction action="{!RefreshGraphView}" name="refreshGraphView" rerender="ResourcedActivityTimeHeaderPanel" oncomplete="initialiseScreen();"></apex:actionFunction>

	</apex:outputPanel>

	<br/>
	
	<apex:actionStatus id="ViewLoadingStatus">
		<apex:facet name="stop">
		
		<apex:outputPanel id="TheViews" rendered="{!TheSelectedView != ''}">

			<!-- Time Detail Panels (different panel for draft versus other status values since we have to show different details) -->
			<apex:outputPanel layout="none" rendered="{!TheSelectedView = ShowTimeDetails && TheTargetApprovalStatus == ApprovalStatusDraft}">
							
				<apex:pageBlockSection collapsible="false" columns="1" title="{!$Label.kimbleone__drafttimesheetsheading}" />
				<apex:pageBlockTable value="{!ThePagedDraftTimesheets.TheRecords}" var="entry">
   					<apex:column headerValue="{!$ObjectType.KimbleOne__Resource__c.Fields.Name.Label}">
           				<apex:outputLink value="/{!entry.ResourceId}"><apex:outputText value="{!entry.ResourceName}"/></apex:outputLink>
           			</apex:column> 
           			<apex:column value="{!entry.ResourcedActivityName}" headerValue="{!$ObjectType.KimbleOne__ResourcedActivity__c.Fields.Name.Label}"/> 
           			<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EntryUnits__c.Label}">
