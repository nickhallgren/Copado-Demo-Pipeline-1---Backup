<apex:page controller="KimbleOne.ScheduledJobsController" sidebar="false">

	<apex:pageMessages escape="false"/>

    <apex:form >
		 	<apex:pageBlock id="ScheduledJobs" title="Scheduled Jobs">  
		    		<apex:pageBlockButtons location="top">						
						<apex:commandButton action="{!CreateDefaultJobs}" value="Create Jobs" reRender="ScheduledJobs"/>
						<apex:commandButton action="{!AbortAllJobs}" value="Abort Jobs (DEV ORGS ONLY)" reRender="ScheduledJobs"/>						
					</apex:pageBlockButtons>
		    	
					<apex:pageBlockTable value="{!Jobs}" var="job">
		       			<apex:column value="{!job.id}"/>
						<apex:column value="{!job.CronExpression}"/>
						<apex:column value="{!job.State}"/>
						<apex:column value="{!job.NextFireTime}"/>
					</apex:pageBlockTable>

		    	</apex:pageBlock>
    
    </apex:form>

</apex:page>