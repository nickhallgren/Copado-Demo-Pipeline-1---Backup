<apex:page standardcontroller="KimbleOne__DeliveryPortfolio__c" extensions="KimbleOne.DeliveryPortfolioEditController" sidebar="false" >
 
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="DeliveryPortfolios.html" MenuContextType="DeliveryPortfolio" MenuContextId="{!KimbleOne__DeliveryPortfolio__c.Id}" MenuContextName="{!KimbleOne__DeliveryPortfolio__c.Name}" rendered="{!!ISBLANK(KimbleOne__DeliveryPortfolio__c.Id)}"/>

</apex:define>
    
<apex:define name="Content">
    
	<apex:outputPanel layout="none" rendered="{!KimbleOne__DeliveryPortfolio__c.Id == null}">
		<apex:sectionHeader title="" subtitle="{!$Label.kimbleone__new} {!$ObjectType.KimbleOne__DeliveryPortfolio__c.label}"/>
	</apex:outputPanel>
    
	<apex:pageMessages escape="false"/>
 
	<apex:form >  

		<apex:pageBlock mode="edit">

			<apex:pageBlockButtons location="top" >
			
				<apex:commandButton id="save" action="{!saveAndNoRedirect}" value="{!$Label.kimbleone__save}"/>
				<apex:commandButton id="saveAndClose" action="{!saveAndRedirect}" value="{!$Label.kimbleone__saveandclose}"/>
				<apex:commandButton id="refreshPortfolioEngagements" action="{!reEvaulateAllPortfolioCriteria}" value="{!$Label.kimbleone__reevaulateallportfoliocriteria}" rendered="{!!ISBLANK(KimbleOne__DeliveryPortfolio__c.Id) && KimbleOne__DeliveryPortfolio__c.KimbleOne__InclusionMode__c != ManualId}"/>
				
			</apex:pageBlockButtons>
		
			<apex:pageBlockSection columns="2">

				<apex:inputField id="name" value="{!KimbleOne__DeliveryPortfolio__c.Name}" required="true"/>
				<apex:inputField id="CurrencyIsoCode" value="{!KimbleOne__DeliveryPortfolio__c.CurrencyIsoCode}" required="true"/>
				<apex:inputField id="InclusionMode" value="{!KimbleOne__DeliveryPortfolio__c.KimbleOne__InclusionMode__c}" required="false"/>
			
			</apex:pageBlockSection>	 
			
		</apex:pageBlock>

  	</apex:form>

	<div id="FilterCriteriaPopup" style="display:none;">
		<apex:include pageName="{!$Page.FilterCriteria}"/>
	</div>
  	
	<apex:outputPanel id="DeliveryPortfolioDeliveryGroups" layout="block" rendered="{!!ISBLANK(KimbleOne__DeliveryPortfolio__c.Id)}">

		<apex:form >
			
			<div id="deliveryPortfolioDeliveryGroupErrors">
				<apex:pageMessages escape="false"/>
			</div>
			
			<apex:pageBlock >

				<div class="toolbar" style="height:35px">
					<div id="filter-buttons" class="control-cell no-text-select">
						<apex:outputPanel layout="none" rendered="{!KimbleOne__DeliveryPortfolio__c.KimbleOne__InclusionMode__c != ManualId}">
							<a value="javascript:void(0);" class="toolbar-button-single" title="{!JSENCODE($Label.Filter)}"><div id="filter-button" class="toolbar-button toggle-btn filter-btn bigger-btn" onclick="showFilterCriteria();"><i class="fa fa-filter"></i></div></a>
						</apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!KimbleOne__DeliveryPortfolio__c.KimbleOne__InclusionMode__c != AutomatcallyAddAndRemoveId}">
							<apex:outputPanel rendered="{!DeliveryPortfolioDeliveryGroups.size < PortfolioDeliveryGroupLimit}" layout="none">
								<a class="toolbar-button-single" title="{!$Label.New} {!$ObjectType.DeliveryPortfolioDeliveryGroup__c.Label}"><div class="toolbar-button toggle-btn new-group-btn bigger-btn" onclick="initialiseModalBoxy('#DeliveryPortfolioDeliveryGroupPopup', '{!JSENCODE($Label.New)} {!$ObjectType.DeliveryPortfolioDeliveryGroup__c.Label}'); newDeliveryPortfolioDeliveryGroup();"><i class="fa fa-plus-square"></i></div></a>
							</apex:outputPanel>
							<!-- todo: add a label for text here -->
							<apex:outputPanel rendered="{!DeliveryPortfolioDeliveryGroups.size >= PortfolioDeliveryGroupLimit}" layout="none">
								<a class="toolbar-button-single" title="Add disabled, maximum number of {!$ObjectType.DeliveryPortfolioDeliveryGroup__c.Label} reached."><div class="disabled  toolbar-button toggle-btn new-group-btn bigger-btn"><i class="fa fa-plus-square"></i></div></a>
							</apex:outputPanel>
						</apex:outputPanel>
                    </div>
				</div>
				
				<apex:pageBlockTable value="{!DeliveryPortfolioDeliveryGroups}" var="dpdg">

					<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}" >

	       	   			<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DeliveryPortfolioDeliveryGroup__c.deletable && KimbleOne__DeliveryPortfolio__c.KimbleOne__InclusionMode__c != AutomatcallyAddAndRemoveId}">
           					<apex:commandLink onclick="var d = confirmDelete();if(!d) return;" action="{!deleteDeliveryPortfolioDeliveryGroup}" reRender="DeliveryPortfolioDeliveryGroups">{!$Label.kimbleone__delete}
								<apex:param name="dpdgId" value="{!dpdg.Id}" />
							</apex:commandLink>
           				</apex:outputPanel>
						
					</apex:column>

					<apex:column value="{!dpdg.KimbleOne__DeliveryGroup__c}" />

					<apex:column value="{!dpdg.DeliveryGroup__r.Account__r.Name}" />
					
				</apex:pageBlockTable>

			</apex:pageBlock>

			<apex:actionFunction action="{!newDeliveryPortfolioDeliveryGroup}" 
				name="newDeliveryPortfolioDeliveryGroup"
				rerender="DeliveryPortfolioDeliveryGroup"
				oncomplete="showModalBoxy();">
			</apex:actionFunction>

			<apex:actionFunction action="{!SaveAndReEvaulateAllPortfolioCriteria}" name="saveAndReEvaulateAllPortfolioCriteria"	rerender="loading-status-panel,DeliveryPortfolioDeliveryGroups" status="PortfolioLoadingStatus" oncomplete="initialise();">
				<apex:param name="porfolioCriteria" value="" />
			</apex:actionFunction>

			<apex:outputPanel id="loading-status-panel">
				<apex:actionStatus id="PortfolioLoadingStatus">
					<apex:facet name="start">
						<div id="loadingIndicatorOuterContainer" class="loadingIndicator">
							<div id="loadingIndicatorInnerContainer">
								<img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
							</div>
						</div>
					</apex:facet>
				</apex:actionStatus>
			</apex:outputPanel>

		</apex:form>
		
	</apex:outputPanel>

	<div id="DeliveryPortfolioDeliveryGroupPopup" style="display: none">
	
		<apex:outputPanel id="DeliveryPortfolioDeliveryGroup">

		<apex:form id="TheForm">
			
			<apex:outputPanel style="width:500px;" layout="block">
			
				<apex:outputPanel id="Errorpanel">
					<div id="deliveryPortfoliodDeliveryGroupErrors">
						<apex:pageMessages escape="false"/>
					</div>
				</apex:outputPanel>

				<apex:pageBlock >
			
					<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!SaveDeliveryPortfolioDeliveryGroup}"
							value="{!$Label.kimbleone__save}"
							oncomplete="hideModalBoxyWithErrorCheck('#deliveryPortfolioDeliveryGroupErrors');"
							reRender="Errorpanel, DeliveryPortfolioDeliveryGroups" styleclass="SaveButton"/>
						<input class="btn" type="button" onclick="hideModalBoxy();"
							value="{!$Label.Cancel}" />
					</apex:pageBlockButtons>

					<apex:pageblockSection collapsible="false" showheader="false" columns="1">
						
    		  			<apex:pageBlockSectionItem datastyle="white-space: nowrap;">
				           	<apex:outputLabel value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Label}"/>
				           	<apex:outputPanel layout="none">
				           		<apex:outputPanel styleClass="requiredInput" layout="block">
					           		<apex:outputPanel styleClass="requiredBlock" layout="block"/>				           		
					           		<apex:inputText id="DeliveryEngagement" value="{!DeliveryEngagementName}" required="true" styleclass="readonly"/>
					           		<apex:inputHidden id="DeliveryEngagement_lkid" value="{!DeliveryPortfolioDeliveryGroup.KimbleOne__DeliveryGroup__c}"/>
					           		<a href="javascript:openLookup(KimbleLookupPage + '?lkfm=' + jQuery('[id$=\'TheForm\']').attr('id') + '&lknm=' + jQuery('[id$=\'DeliveryEngagement\']').attr('id') + '&lktp={!$ObjectType.DeliveryGroup__c.KeyPrefix}&DeliveryPortfolioId={!KimbleOne__DeliveryPortfolio__c.Id}&typename=LookupObjectDeliveryGroup',670,'1','&lksrch='+jQuery('[id$=\'DeliveryEngagement\']').val())" class="kimbleSearch " onclick="setLastMousePosition(event)" ><img src="/s.gif" class="lookupIcon" onblur="this.className = 'lookupIcon';" onfocus="this.className = 'lookupIconOn';" onmouseout="this.className = 'lookupIcon';this.className = 'lookupIcon';" onmouseover="this.className = 'lookupIconOn';this.className = 'lookupIconOn';" /></a>
				           		</apex:outputPanel>
							</apex:outputPanel>			     
						</apex:pageBlockSectionItem>
					</apex:pageblockSection>						

				</apex:pageBlock>

			</apex:outputPanel>

		</apex:form>

		</apex:outputPanel>
		
	</div>
	
	<script>
	
		var portfolioCriteria = '{!JSENCODE(TheDeliveryPortfolio.Criteria__c)}';

		jQuery(window).load(function() {
        	initialiseFilterCriteriaConfig('{!JSENCODE(FilterContextId)}');

			initialise();

		});

		function initialise() {
		    if (portfolioCriteria != '')
        	{
        		var c = JSON.parse(portfolioCriteria);
        		if (c.Criteria.length > 0) jQuery('#filter-button').addClass('active-toolbar-button');
         	}
  		}

		function showFilterCriteria()
		{
           loadFilterCriteria(portfolioCriteria,
           			function(){
           			    jQuery("#FilterCriteriaPopup").show();
           			}
				   ,function(newFilter){
					   jQuery("#FilterCriteriaPopup").hide();

					   portfolioCriteria = JSON.stringify(newFilter);
					   jQuery('#filter-button').removeClass('active-toolbar-button');

					   if (newFilter.Criteria.length > 0) jQuery('#filter-button').addClass('active-toolbar-button');

            		   saveAndReEvaulateAllPortfolioCriteria(portfolioCriteria);
				   },
				   function(){
				       jQuery("#FilterCriteriaPopup").hide();
       				});
		}
		
	</script>
	<style>
		div#FilterCriteriaPopup {
			position: absolute;
			top: 203px;
			padding: 5px;
			min-width:295px;
			height: auto;
			z-index: 999;
			border-color: #ddd;
			border-style: solid;
			border-width: 0px 1px 1px 1px;
			background-color: #fff;
			box-shadow: rgba(31, 31, 31, 0.16) 4px 3px 8px;
			left: 225px;
		}
		.toolbar {
			display: table-row;
			width: 100%;
		}
		a.toolbar-button-single {
			padding-right: 3px;
		}
		a.toolbar-button-double > div {
			border-right-style: hidden;
		}
		div.toolbar-button {
			display: inline-block;
			padding: 6px 8px;
			background-color: white;
			border: 1px solid #ccc;
			border-radius: 2px;
			cursor: pointer;
		}
		div.toolbar-button.active-toolbar-button {
			color: white;
			background-color: #888;
		}		
		div.toolbar-button:hover {
			text-decoration: none;
			color: white;
			background-color: #1A9EFF;
		}
		div.toolbar-button .fa {font-size: 14px;}
		div.toolbar-button.disabled {background-color: #ccc;color: darkgray;}
		div.toolbar-button.disabled:hover {background-color: #ccc;color: darkgray;}
		div#filter-buttons {display: inline;}
		
		.loadingIndicator {
		   top:0;
		   right:0;
		   width:100%;
		   height:100%;
		   font-weight: bold;
		   position:absolute;
		   text-align:center;
		   /* IE filter */
		   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
		   -moz-opacity:0.7;    /* Mozilla extension */
		   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
		   opacity:0.7; /* CSS3 */
		   z-index:1000;
		   background-color:white;
		}
		
		.loadingIndicator img {
		    margin-right:9px;
		}
		
		#loadingIndicatorInnerContainer { 
		    position:absolute; 
		    top:50%;
		    height:10em; 
		    margin-top:-2em;
		    width:100%;
		}
	</style>
</apex:define>

</apex:composition>

</apex:page>