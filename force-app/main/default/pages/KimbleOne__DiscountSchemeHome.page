<apex:page standardController="KimbleOne__DiscountScheme__c" extensions="KimbleOne.DiscountSchemeHomeController"  sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
    	<c:Menu DefaultHelpPage="Finance.html" MenuContextType="{!MenuContextType}" MenuContextId="{!MenuContextId}" MenuContextName="{!MenuContextName}" />
    </apex:define>	
    <apex:define name="Content">
    	
    	<apex:form id="DiscountSchemeForm">
    		<apex:pageMessages escape="false"/>
			
			<apex:pageBlock title="{!$ObjectType.KimbleOne__DiscountScheme__c.Label}">
				
				<apex:pageBlockButtons location="top">
					<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DiscountScheme__c.updateable}">
						<apex:commandButton id="editButton" action="{!Edit}" value="{!$Label.kimbleone__edit}" />
					</apex:outputPanel>
				</apex:pageBlockButtons>
				
             	<apex:pageblockSection collapsible="false" showheader="false" columns="2">
					
					<apex:outputField value="{!KimbleOne__DiscountScheme__c.Name}" />
					<apex:pageBlockSectionItem >
						<apex:outputLabel value="{!$ObjectType.KimbleOne__DiscountScheme__c.Fields.KimbleOne__SchemeModel__c.Label}"/>
						<apex:outputField value="{!KimbleOne__DiscountScheme__c.KimbleOne__SchemeModel__c}"/>
					</apex:pageBlockSectionItem>
					
					<apex:outputField value="{!KimbleOne__DiscountScheme__c.KimbleOne__StartDate__c}" rendered="{!KimbleOne__DiscountScheme__c.SchemeModel__r.CalculationTerm__r.KimbleOne__Enum__c = 'Periodic'}"/>
					<apex:outputField value="{!KimbleOne__DiscountScheme__c.KimbleOne__EndDate__c}" rendered="{!KimbleOne__DiscountScheme__c.SchemeModel__r.CalculationTerm__r.KimbleOne__Enum__c = 'Periodic'}"/>

					<apex:outputField value="{!KimbleOne__DiscountScheme__c.KimbleOne__DiscountPercentage__c}" rendered="{!KimbleOne__DiscountScheme__c.SchemeModel__r.SchemeRateType__r.KimbleOne__Enum__c = 'Flat'}"/>
											
				</apex:pageBlockSection>
									
			</apex:pageBlock>

			<apex:pageBlock id="DiscountRatesList" title="{!$ObjectType.KimbleOne__DiscountRate__c.LabelPlural}">
           	
    			<apex:pageBlockTable value="{!DiscountRates}" var="discRate" >
          		
          			<apex:column value="{!discRate.KimbleOne__MeasureLower__c}" headerValue="{!$ObjectType.KimbleOne__DiscountRate__c.Fields.KimbleOne__MeasureLower__c.Label}" />
					<apex:column value="{!discRate.KimbleOne__MeasureUpper__c}" headerValue="{!$ObjectType.KimbleOne__DiscountRate__c.Fields.KimbleOne__MeasureUpper__c.Label}" />
					<apex:column value="{!discRate.KimbleOne__DiscountPercentage__c}"  headerValue="{!$ObjectType.KimbleOne__DiscountRate__c.Fields.KimbleOne__DiscountPercentage__c.Label}" />

				</apex:pageBlockTable>
		
			</apex:pageBlock>
		
		</apex:form>
				
    </apex:define>
    
</apex:composition>

</apex:page>