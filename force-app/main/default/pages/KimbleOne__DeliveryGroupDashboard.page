				// add tip attributes to elements
				function ApplyTipAttributes()
				{
					if(enableTips)
					{
					    // Revenue Summary Card
						jQuery('[id$="revenueSummaryCard"]').parent().parent().attr('kimble-tip','RevenueSummaryRSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery(".graphLabeldivForRevenueSummaryGraph:contains('{!JSENCODE($Label.ProjectedLabel)}')").parent().attr('kimble-tip','ProjectedRSC').attr('kimble-tip-extended-text','ProjectedRSCExtendedText').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery(".graphLabeldivForRevenueSummaryGraph:contains('{!JSENCODE($Label.ActualLabel)}')").parent().attr('kimble-tip','ActualRSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery(".graphLabeldivForRevenueSummaryGraph:contains('{!JSENCODE($Label.BaselineLabel)}')").parent().attr('kimble-tip','BaselineRSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery(".graphLabeldivForRevenueSummaryGraph:contains('{!JSENCODE($Label.POCoverLabel)}')").parent().attr('kimble-tip','POCoverRSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery(".graphLabeldivForRevenueSummaryGraph:contains('{!JSENCODE($Label.InvoicedLabel)}')").parent().attr('kimble-tip','InvoicedRSC').attr('kimble-tip-extended-text','InvoicedRSCExtendedText').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						// Margin Summary Card
						jQuery('[id$="marginSummaryCardHeading"]').attr('kimble-tip','MarginSummary').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="divForBaselineMargin"]').attr('kimble-tip','BaselineMSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="divForProjectedMargin"]').attr('kimble-tip','ProjectedMSC').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						// Financials table
						jQuery('[id$="financialSummaryCardHeading"]').parent().attr('kimble-tip','Financials').attr('kimble-tip-extended-text','FinancialsExtendedText').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="finacialsBaselineColumn"]').attr('kimble-tip','BaselineFT').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="finacialsProjectedColumn"]').attr('kimble-tip','ProjectedFT').attr('kimble-tip-extended-text','ProjectedFTExtendedText').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="finacialsActualColumn"]').attr('kimble-tip','ActualFT').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('.currency-mode-toggle-container').attr('kimble-tip','FinancialCurrencyToggle').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						// Cost Summary Card
						jQuery('[id$="costSummaryCardHeading"]').parent().attr('kimble-tip','CostSummary');
						jQuery(".graphLabeldivForCostSummaryGraph:contains('{!JSENCODE($Label.BaselineLabel)}')").parent().attr('kimble-tip','BaselineCSC');
						jQuery(".graphLabeldivForCostSummaryGraph:contains('{!JSENCODE($Label.ActualLabel)}')").parent().attr('kimble-tip','ActualCSC');
						jQuery(".graphLabeldivForCostSummaryGraph:contains('{!JSENCODE($Label.ProjectedLabel)}')").parent().attr('kimble-tip','ProjectedCSC');
						jQuery(".graphLabeldivForCostSummaryGraph:contains('{!JSENCODE($Label.InvoicedLabel)}')").parent().attr('kimble-tip','InvoicedCSC');
						// Risk Summary Card
						jQuery('[id$="risksTopCardHeading"]').parent().parent().attr('kimble-tip','RiskAssessment').attr('kimble-tip-help-link','RisksHelpLink');
						jQuery('[id$="topRisksTable"]').attr('kimble-tip','TopRisks').attr('kimble-tip-help-link','RisksHelpLink');
						jQuery('[id$="riskSummaryRiskLevel"]').parent().attr('kimble-tip','RiskLevel').attr('kimble-tip-help-link','RisksHelpLink');
						// RAG Summary Card and Stage Summary Card
						jQuery('[id$="usagePercentCompleteOutput"]').parent().attr('kimble-tip','PercentComplete');
						jQuery('[id$="divGroupStatusCard"]').attr('kimble-tip','Summary').attr('kimble-tip-extended-text','SummaryExtendedText').attr('kimble-tip-help-link','DeliveryEngagementHelpLink');
						jQuery('[id$="divStageSummaryCard"]').attr('kimble-tip','StageSummary');
						// Intercompany Summary Card
						jQuery('[id$="intercompanySummaryCardHeading"]').parent().attr('kimble-tip','IntercompanySummary');
						jQuery(".graphLabeldivForMarginSummaryGraph").parent().attr('kimble-tip','MarginICSC');
						jQuery('[id$="intercompanySummaryCardHeading"]').parent().attr('kimble-tip','SummaryCardIC').attr('kimble-tip-extended-text','SummaryICExtendedText').attr('kimble-tip-help-link','SummaryICHelpLink');
						
						// Other
						jQuery('[id$="editDeliveryGroupDashboardLayoutBtn"]').attr('kimble-tip','EditLayoutbutton').attr('kimble-tip-extended-text','EditLayoutbuttonExtendedText');
					}
				}
				
				
				function updateTipsConfigSetting(newTipSetting)
				{
					Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
						newTipSetting,
							function(result, event){
								if (event.status)
								{
									var data = {};
									data.results = result;
									loadGuidance();
								}
								else
								{
									alert(event.message);
								}
						},
						{escape: false, timeout: 60000}
					);
				}
