<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupDashboardController,KimbleOne.TooltipsController" sidebar="false" >

	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="DeliveryEngagements.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}" />
		</apex:define>

		<apex:define name="Content">
			<!-- Ajax loaded pages don't load external resources so they have to be loaded in the parent page -->
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__jQueryBarGraph, 'jqBarGraph.1.1.min.js')}"/>

			<apex:outputPanel rendered="{!ICSEnabled}">
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__ChartJs)}"/>
			</apex:outputPanel>

			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'RiskStyle.css')}"/>
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>

			<!-- Kimble Guidance -->
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
			<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
				<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/DeliveryGroupDashboardNarratives/' + UserNarrativeLanguageCode + '.js')}" />

				<apex:outputPanel layout="none" rendered="{!DeliveryGroupDashboardTipOverrideEnabled}">
					<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
				</apex:outputPanel>
			</apex:outputPanel>

			<chatter:feedWithFollowers entityId="{!KimbleOne__DeliveryGroup__c.Id}"/>

			<div id="dashboard-layout" class="dashboardLayout">
				<div id="dashboardContainer" class="dashboardContainer">
					<div id="delivery-group-title">
						<apex:outputPanel id="DeliveryGroupCard" layout="none">
							<div class="title-card-container">
								<div class="title-card">
									<div class="title-card-heading" >
										<div class="title-card-heading-icon">
											<apex:variable value="{!KimbleOne__DeliveryGroup__c.ForecastStatus__r.KimbleOne__StyleClass__c}" var="StyleClassValue"/>
											<apex:variable value="{!KimbleOne__DeliveryGroup__c.ForecastStatus__r.Name}" var="GroupForecastStatus"/>
											<div class="fa fa-square kimble-probability {!JSENCODE(StyleClassValue)}" title="{!JSENCODE(GroupForecastStatus)}"></div>
										</div>
										<div class="title-card-heading-text">
											<apex:outputText title="{!KimbleOne__DeliveryGroup__c.Name}" value="{!KimbleOne__DeliveryGroup__c.Name}"/>
											<apex:outputPanel layout="none" rendered="{!!ISBLANK(KimbleOne__DeliveryGroup__c.KimbleOne__DeliveryProgram__c)}">
												<apex:outputLink styleClass="undecorated-link delivery-program-indicator fa fa-link" value="/{!KimbleOne__DeliveryGroup__c.KimbleOne__DeliveryProgram__c}" title="{!$ObjectType.KimbleOne__DeliveryProgram__c.Fields.Name.Label}: {!JSENCODE(KimbleOne__DeliveryGroup__c.DeliveryProgram__r.Name)}"/>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!deliveryPortfolios.size == 1}">
												<apex:repeat value="{!deliveryPortfolios}" var="deliveryPortfolio">
													<apex:outputLink styleClass="undecorated-link delivery-portfolio-indicator fa fa-list" value="/{!deliveryPortfolio.Id}" title="{!$ObjectType.KimbleOne__DeliveryPortfolio__c.Label}: {!JSENCODE(deliveryPortfolio.Name)}"/>
												</apex:repeat>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!deliveryPortfolios.size > 1}">
												<div data-floating-dropdown="#delivery-portfolios-menu-data" class="delivery-portfolio-indicator fa fa-list burger-menu" title="{!$ObjectType.DeliveryPortfolio__c.LabelPlural}"></div>
												<div id="delivery-portfolios-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
													<ul class="floating-dropdown-menu">
														<apex:repeat value="{!deliveryPortfolios}" var="deliveryPortfolio">
															<li><apex:outputLink styleClass="actionLink" value="/{!deliveryPortfolio.Id}"><apex:outputText value="{!deliveryPortfolio.Name}"/></apex:outputLink></li>
														</apex:repeat>
													</ul>
												</div>
											</apex:outputPanel>
										</div>
									</div>

									<div class="title-card-body">
										<div id="embeddedCharmsContainer" context-id="{!KimbleOne__DeliveryGroup__c.Id}" pageSource="DeliveryGroupCharmsCard"><i class="charm-loading fa fa-circle-o-notch fa-spin fa-3x fa-fw"/></div>
									</div>
								</div>
							</div>
						</apex:outputPanel>
					</div>
					<apex:pageMessages escape="false"/>

					<apex:repeat value="{!DashboardLayout.Rows}" var="dashboardRow">
						<div class="cardRowContainer">
							<apex:repeat value="{!dashboardRow.Itms}" var="dashboardItem">
								<div context-id="{!ContextId}" pageSource="{!dashboardItem.Src}" class="cardContainer"></div>
							</apex:repeat>
						</div>
					</apex:repeat>
					<apex:repeat value="{!DashboardLayout.Itms}" var="dashboardItem">
						<div context-id="{!ContextId}" pageSource="{!dashboardItem.Src}" class="cardContainer"></div>
					</apex:repeat>
				</div>

				<div class="dashboard-footer">
					<apex:outputLink style="text-decoration: none;" styleClass="edit-layout-btn" value="{!$Page.KimbleOne__DeliveryGroupDashboardEdit}?id={!KimbleOne__DeliveryGroup__c.Id}" title="{!$Label.kimbleone__editlayout}" rendered="{!ShowDashboardEdit}">
						<div id="editDeliveryGroupDashboardLayoutBtn" class="footer-button {!IF(CustomDashboardLayout, 'highlight', '')}">
							<i class="fa fa-th delivery-group-layout-edit-icon"></i>
						</div>
					</apex:outputLink>
					<apex:outputLink style="text-decoration: none;" styleClass="print-btn" value="{!$Page.KimbleOne__DeliveryGroupHomePrint}?id={!KimbleOne__DeliveryGroup__c.Id}" title="{!$Label.kimbleone__print}" rendered="{!ShowEngagementPrint}">
						<div class="footer-button">
							<i class="fa fa-print delivery-group-print-icon"></i>
						</div>
					</apex:outputLink>
				</div>
			</div>
			<div id="DeliveryElementPopup" style="display: none">
				<apex:outputPanel id="DeliveryElementPopupPanel">
					<apex:form >
						<apex:inputText styleClass="DefaultCurrencyForDeliveryElementUpdate" style="display:none" value="{!FinancialCardCurrency}"/>
						<apex:pageBlock >
							<div id="DeliveryElementPopupErrors">
								<apex:pageMessages escape="false"/>
							</div>
							<apex:pageBlockButtons location="bottom">
								<apex:commandButton action="{!updateDeliveryElement}"
													value="{!$Label.kimbleone__save}"
													oncomplete="if(hideModalBoxyWithErrorCheck('#DeliveryElementPopupErrors'))window.location = window.location;"
													styleclass="DisableButtonWhileBusy"
													reRender="DeliveryElementPopupPanel"
													rendered="{!OR(OR(theDeliveryElementObject.Product__r.ProductDomain__r.RevenueGenerationModel__r.IsUsageGenerated__c, theDeliveryElementObject.Product__r.ProductDomain__r.CostGenerationModel__r.IsUsageGenerated__c),
                                                    theDeliveryElementObject.Product__r.ProductDomain__r.CostGenerationModel__c != null,
                                                    theDeliveryElementObject.Product__r.ProductDomain__r.RevenueGenerationModel__c != null)}"/>
								<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}" />
							</apex:pageBlockButtons>
							<apex:pageblockSection collapsible="false" showheader="false" columns="2">
								<apex:pageBlockSectionItem rendered="{!theDeliveryElementObject.KimbleOne__ResourcedActivity__c != null}">
									<apex:outputLabel >{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BaselineUsage__c.Label} <span>({!IF(theDeliveryElementObject.KimbleOne__DeliveryElementOperatedWith__c != null,theDeliveryElementObject.DeliveryElementOperatedWith__r.ResourcedActivity__r.ForecastUnitType__r.KimbleOne__Suffix__c, theDeliveryElementObject.ResourcedActivity__r.ForecastUnitType__r.KimbleOne__Suffix__c)})</span></apex:outputLabel>
									<apex:outputPanel >
										<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineUsage__c}" rendered="{!theDeliveryElementObject.KimbleOne__ResourcedActivity__c != null}"/>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem rendered="{!theDeliveryElementObject.KimbleOne__ResourcedActivity__c != null}" />

								<apex:pageBlockSectionItem rendered="{!showExpenses}">
									<apex:outputLabel >{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BaselineExpensesContractRevenue__c.Label} <span>({!FinancialCardCurrency})</span></apex:outputLabel>
									<apex:outputPanel >
										<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineExpensesContractRevenue__c}" required="true"  rendered="{!!IsInvoicingCurrencyUsedInFinancial}"/>
										<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineInvCcyExpensesContractRevenue__c}" required="true"  rendered="{!IsInvoicingCurrencyUsedInFinancial}"/>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem rendered="{!AND(showExpenses, ShowBaselineExpenseCost)}">
									<apex:outputLabel >{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BaselineExpensesContractCost__c.Label} <span>({!FinancialCardCurrency})</span></apex:outputLabel>
									<apex:outputPanel >
										<apex:outputPanel rendered="{!CanEditBaselineExpenseCost}">
											<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineExpensesContractCost__c}" required="true" rendered="{!!IsInvoicingCurrencyUsedInFinancial}" />
											<apex:inputField value="{!BaselineInvExpensesContractCost.KimbleOne__InputDecimal__c}" required="true" rendered="{!IsInvoicingCurrencyUsedInFinancial}" />
										</apex:outputPanel>
										<apex:outputText value="{!theDeliveryElementObject.KimbleOne__BaselineExpensesContractCost__c}" rendered="{!!CanEditBaselineExpenseCost}" />
									</apex:outputPanel>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem >
									<apex:outputLabel >{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BaselineServicesContractRevenue__c.Label} <span>({!FinancialCardCurrency})</span></apex:outputLabel>
									<apex:outputPanel >
										<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineServicesContractRevenue__c}" required="true" rendered="{!!IsInvoicingCurrencyUsedInFinancial}"/>
										<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineInvCcyServicesContractRevenue__c}" required="true" rendered="{!IsInvoicingCurrencyUsedInFinancial}"/>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem rendered="{!ShowBaselineCost}">
									<apex:outputLabel >{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BaselineServicesContractCost__c.Label} <span>({!FinancialCardCurrency})</span></apex:outputLabel>
									<apex:outputPanel >
										<apex:outputPanel rendered="{!theDeliveryElementObject.Product__r.ProductDomain__r.KimbleOne__CostGenerationModel__c != null && CanEditBaselineCost}" >
											<apex:inputField value="{!theDeliveryElementObject.KimbleOne__BaselineServicesContractCost__c}" required="true" rendered="{!!IsInvoicingCurrencyUsedInFinancial}" />
											<apex:inputField value="{!BaselineInvServicesContractCost.KimbleOne__InputDecimal__c}" required="true" rendered="{!IsInvoicingCurrencyUsedInFinancial}" />
										</apex:outputPanel>
										<apex:outputText value="{!theDeliveryElementObject.KimbleOne__BaselineServicesContractCost__c}" rendered="{!NOT(theDeliveryElementObject.Product__r.ProductDomain__r.KimbleOne__CostGenerationModel__c != null) || !CanEditBaselineCost}" />
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
							</apex:pageblockSection>
						</apex:pageBlock>
					</apex:form>
				</apex:outputPanel>
			</div>
			<apex:form >
				<apex:actionFunction action="{!overrideBaselineElement}"
									 name="overrideBaselineElement"
									 rerender="DeliveryElementPopupPanel"
									 oncomplete="showModalBoxy();">
					<apex:param assignTo="{!elementId}" name="elementId" value="{!elementId}"/>
					<apex:param assignTo="{!FinancialCardCurrency}" name="FinancialCardCurrency" value="{!FinancialCardCurrency}"/>
				</apex:actionFunction>

				<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
				<div style="display:none;" kimble-tip="null"></div>
				
			</apex:form>
			<script>
				var filterLabels = {};
				filterLabels['services'] = '{!JSENCODE($Label.ServicesLabel)}';
				filterLabels['expenses'] = '{!JSENCODE($Label.ExpensesLabel)}';
				filterLabels['all'] = '{!JSENCODE($Label.All)}';
				filterLabels['revsummary'] = '{!JSENCODE($Label.RevenueSummaryLabel)}';
				filterLabels['marsummary'] = '{!JSENCODE($Label.MarginSummaryLabel)}';
				filterLabels['cstsummary'] = '{!JSENCODE($Label.CostSummaryLabel)}';
				filterLabels['icsummary'] = '{!JSENCODE($Label.IntercompanyMarginSummary)}';
				filterLabels['apply'] = '{!JSENCODE($Label.ApplyFilter)}';

				var showFilter = <apex:outputText value="{!ShowFilter}"/>;
				var showRevFilter = <apex:outputText value="{!ShowRevFilter}"/>;
				var showCstFilter = <apex:outputText value="{!ShowCstFilter}"/>;
				var showMarFilter = <apex:outputText value="{!ShowMarFilter}"/>;
				var showIcFilter = <apex:outputText value="{!ShowIcFilter}"/>;

				var componentsToLoad = 0;

                jQuery(document).ready(function()
                {
					componentsToLoad = jQuery('.dashboardContainer div[pageSource]').length;

                    jQuery.each( jQuery('.dashboardContainer'), function(i, dashboardContainer) {
                            jQuery('div[pageSource]', dashboardContainer).each(function() {
                               loadDashboardComponent(jQuery( this ));
                       });
                    })
                });

				function SetStatusSummaryCardHeight()
				{
					var variableHeightEnabled = '<apex:outputText value="{!StatusCardVariableHeight}"/>';

					if(variableHeightEnabled == 'true')
					{
						if($('#summaryCardBody').is(':visible'))
						{
							$('#summaryCardBody').css('height', 'auto');
						}
						else
						{
	    					setTimeout(function(){ $('#summaryCardBody').css('height', 'auto'); }, 500);
	  					}
	  				}
				}

                function loadDashboardComponent(dashboardComponent)
                {
                    var pageSourceName = dashboardComponent.attr('pageSource');

                       // kick off the population of the page with an ajax call - always provide ID, only provide currency if on the source element
                       var displayCurrencyParam = '';

                       if(dashboardComponent.attr('display-currency') != null)
                       {
                           displayCurrencyParam = '&currencyISOCode=' + dashboardComponent.attr('display-currency');
                       }

			   		var domainParam = '';

			   		if(dashboardComponent.attr('domain') != null)
			   		{
			   			domainParam = '&domain=' + dashboardComponent.attr('domain');
			   		}

			   		jQuery.ajax({ url: kimble.pages[pageSourceName] + dashboardComponent.attr('context-id') + displayCurrencyParam + domainParam})
                        .done(function(html) {
                            dashboardComponent.empty();

                            if(html != null && html != '')
                            {
                                jQuery(html).appendTo(dashboardComponent);
                            }
                            else
                            {
                                // nothing to render in the component
                                // remove the container for this component to allow the page to re-flow
                                dashboardComponent.remove();
                            }

							componentLoadComplete();
                        })
                        .fail(function(xhr, status, error) {
                            if(error !=null && error !="") {
                                console.log('ajax component load error: ' + error);
                                // hide the container for this component
                                dashboardComponent.hide();
                            }
							componentLoadComplete();
                        })
                }

				function componentLoadComplete()
				{
					componentsToLoad -= 1;
					if(componentsToLoad <= 0) jQuery.publish('kimble.dashboard-load-complete');
				}

                function baselineElement(elementId)
                {
                    if (confirm('{!$Label.AreYouSure}'))
                    {
                        jQuery('#' + elementId + ' .burger-menu').hide();
                        jQuery('#' + elementId + ' .Loading').show();

                        Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupDashboardController.BaselineDeliveryElement}',
                               elementId,
                                  function(result, event){
                                     if (event.status)
                                    {
                                         //reload screen
                                         window.location = window.location;
                                     }
                                     else if (event.type === 'exception')
                                     {
                                         alert(event.message);
                                         jQuery('#' + elementId + ' .burger-menu').show();
                                        jQuery('#' + elementId + ' .Loading').hide();
                                     }
                                     else
                                     {
                                         alert(event.message);
                                         jQuery('#' + elementId + ' .burger-menu').show();
                                        jQuery('#' + elementId + ' .Loading').hide();
                                     }
                         },
                         {escape: true, timeout: 60000});
                     }
				}

				jQuery.subscribe('kimble.dashboard-load-complete', function(event, data)
				{
					if(showFilter)
					{
					    initialiseFilters();
						setFilterTooltips();
					}

					SetStatusSummaryCardHeight();
                    
                    initialisePageTips();
				});

				function initialiseFilters()
				{
					jQuery('.card-filter-icon').qtip('destroy', true);

	                jQuery('.card-filter-icon').qtip({
						content: {
							text: function(event, api) {
								return generateCardFilterHtml();
							},
							button: 'Cancel'
						},
						position: {
						   	my: 'center right',
							at: 'center left'
						},
						show: {
		 					event: 'click',
		 					solo: true
	  					},
	  					hide: false,
						style: {classes: 'qtip-light qtip-shadow qtip-rounded card-filter-qtip'}
				    });
				}

				function generateCardFilterHtml()
				{
					var html = '';

					html += '<div class="group-card-filters">';

					if (typeof revenueDomainFilter !== 'undefined' && showRevFilter)
					{
						html += '<div class="card inverted min-horizontal-padding revenue-summary-filters">';

						html += '<div class="cardHeading inverted">';
						html += '<h3 class="cardTitle">' + filterLabels['revsummary'] + '</h3>';
						html += '</div>';

						html += '<div class="cardBody">';
						html += '<label><input type="radio"' + (revenueDomainFilter == 'All' ? ' checked="checked"' : '') + ' name="rev-sum-filter" value="All">' + filterLabels['all'] + '</input></label>';
						html += '<label><input type="radio"' + (revenueDomainFilter == 'Services' ? ' checked="checked"' : '') + ' name="rev-sum-filter" value="Services">' + filterLabels['services'] + '</input></label>';
						html += '<label><input type="radio"' + (revenueDomainFilter == 'Expenses' ? ' checked="checked"' : '') + ' name="rev-sum-filter" value="Expenses">' + filterLabels['expenses'] + '</input></label>';
						html += '</div>';

						html += '</div>';
					}

					if (typeof costDomainFilter !== 'undefined' && showCstFilter)
					{
						html += '<div class="card inverted min-horizontal-padding cost-summary-filters">';

						html += '<div class="cardHeading inverted">';
						html += '<h3 class="cardTitle">' + filterLabels['cstsummary'] + '</h3>';
						html += '</div>';

						html += '<div class="cardBody">';
						html += '<label><input type="radio"' + (costDomainFilter == 'All' ? ' checked="checked"' : '') + ' name="cst-sum-filter" value="All">' + filterLabels['all'] + '</input></label>';
						html += '<label><input type="radio"' + (costDomainFilter == 'Services' ? ' checked="checked"' : '') + ' name="cst-sum-filter" value="Services">' + filterLabels['services'] + '</input></label>';
						html += '<label><input type="radio"' + (costDomainFilter == 'Expenses' ? ' checked="checked"' : '') + ' name="cst-sum-filter" value="Expenses">' + filterLabels['expenses'] + '</input></label>';
						html += '</div>';

						html += '</div>';
					}

					if (typeof marginDomainFilter !== 'undefined' && showMarFilter)
					{
						html += '<div class="card inverted min-horizontal-padding margin-summary-filters">';

						html += '<div class="cardHeading inverted">';
						html += '<h3 class="cardTitle">' + filterLabels['marsummary'] + '</h3>';
						html += '</div>';

						html += '<div class="cardBody">';
						html += '<label><input type="radio"' + (marginDomainFilter == 'All' ? ' checked="checked"' : '') + ' name="mar-sum-filter" value="All">' + filterLabels['all'] + '</input></label>';
						html += '<label><input type="radio"' + (marginDomainFilter == 'Services' ? ' checked="checked"' : '') + ' name="mar-sum-filter" value="Services">' + filterLabels['services'] + '</input></label>';
						html += '<label><input type="radio"' + (marginDomainFilter == 'Expenses' ? ' checked="checked"' : '') + ' name="mar-sum-filter" value="Expenses">' + filterLabels['expenses'] + '</input></label>';
						html += '</div>';

						html += '</div>';
					}

					if (typeof intercompanySummaryDomainFilter !== 'undefined' && showIcFilter)
					{
						html += '<div class="card inverted min-horizontal-padding ic-margin-summary-filters">';

						html += '<div class="cardHeading inverted">';
						html += '<h3 class="cardTitle">' + filterLabels['icsummary'] + '</h3>';
						html += '</div>';

						html += '<div class="cardBody">';
						html += '<label><input type="radio"' + (intercompanySummaryDomainFilter == 'All' ? ' checked="checked"' : '') + ' name="ic-mar-sum-filter" value="All">' + filterLabels['all'] + '</input></label>';
						html += '<label><input type="radio"' + (intercompanySummaryDomainFilter == 'Services' ? ' checked="checked"' : '') + ' name="ic-mar-sum-filter" value="Services">' + filterLabels['services'] + '</input></label>';
						html += '<label><input type="radio"' + (intercompanySummaryDomainFilter == 'Expenses' ? ' checked="checked"' : '') + ' name="ic-mar-sum-filter" value="Expenses">' + filterLabels['expenses'] + '</input></label>';
						html += '</div>';

						html += '</div>';
					}

					html += '<input class="btn" type="Button" onclick="applyDomainFilter();" name="apply-filter" value="' + filterLabels['apply'] + '"/>';

					html += '</div>';
					html += '</div>';

					return html;
				}

				function applyDomainFilter()
				{
					if (typeof revenueDomainFilter !== 'undefined' && showRevFilter)
					{
						var newRevenueDomainFilter = jQuery('.group-card-filters:visible .revenue-summary-filters input[name="rev-sum-filter"]:checked').val();
						if(revenueDomainFilter != newRevenueDomainFilter) revenueSummaryDomainFilterChange(newRevenueDomainFilter);

				    	var filterTooltip = filterLabels['all'];
				    	if(revenueDomainFilter == 'Services') filterTooltip = filterLabels['services'];
				    	else if(revenueDomainFilter == 'Expenses') filterTooltip = filterLabels['expenses'];

				    	jQuery('.filter-rev-sum-icon').prop('title', filterTooltip);
					}

					if (typeof marginDomainFilter !== 'undefined' && showMarFilter)
					{
						var newMarginDomainFilter = jQuery('.group-card-filters:visible .margin-summary-filters input[name="mar-sum-filter"]:checked').val();
						if(marginDomainFilter != newMarginDomainFilter) marginSummaryDomainFilterChange(newMarginDomainFilter);
					}

					if (typeof costDomainFilter !== 'undefined' && showCstFilter)
					{
						var newCostDomainFilter = jQuery('.group-card-filters:visible .cost-summary-filters input[name="cst-sum-filter"]:checked').val();
						if(costDomainFilter != newCostDomainFilter) costSummaryDomainFilterChange(newCostDomainFilter);
					}

					if (typeof intercompanySummaryDomainFilter !== 'undefined' && showIcFilter)
					{
						var newIntercompanySummaryDomainFilter = jQuery('.group-card-filters:visible .ic-margin-summary-filters input[name="ic-mar-sum-filter"]:checked').val();
						if(intercompanySummaryDomainFilter != newIntercompanySummaryDomainFilter) intercompanyMarginSummaryDomainFilterChange(newIntercompanySummaryDomainFilter);
					}

					setFilterTooltips();
					jQuery('.card-filter-icon').qtip("hide");
				}

				function setFilterTooltips()
				{
					if (typeof revenueDomainFilter !== 'undefined' && showRevFilter)
					{
				    	var filterTooltip = filterLabels['all'];
				    	if(revenueDomainFilter == 'Services') filterTooltip = filterLabels['services'];
				    	else if(revenueDomainFilter == 'Expenses') filterTooltip = filterLabels['expenses'];

				    	jQuery('.filter-rev-sum-icon').prop('title', filterTooltip);
					}

					if (typeof marginDomainFilter !== 'undefined' && showMarFilter)
					{
				    	var filterTooltip = filterLabels['all'];
				    	if(marginDomainFilter == 'Services') filterTooltip = filterLabels['services'];
				    	else if(marginDomainFilter == 'Expenses') filterTooltip = filterLabels['expenses'];

				    	jQuery('.filter-mar-sum-icon').prop('title', filterTooltip);
					}

					if (typeof costDomainFilter !== 'undefined' && showCstFilter)
					{
				    	var filterTooltip = filterLabels['all'];
				    	if(costDomainFilter == 'Services') filterTooltip = filterLabels['services'];
				    	else if(costDomainFilter == 'Expenses') filterTooltip = filterLabels['expenses'];

				    	jQuery('.filter-cst-sum-icon').prop('title', filterTooltip);
					}

					if (typeof intercompanySummaryDomainFilter !== 'undefined' && showIcFilter)
					{
				    	var filterTooltip = filterLabels['all'];
				    	if(intercompanySummaryDomainFilter == 'Services') filterTooltip = filterLabels['services'];
				    	else if(intercompanySummaryDomainFilter == 'Expenses') filterTooltip = filterLabels['expenses'];

				    	jQuery('.filter-ic-mar-sum-icon').prop('title', filterTooltip);
					}
