<apex:page standardcontroller="KimbleOne__ResourcedActivity__c" extensions="KimbleOne.ActivityAssignmentsBulkTransferCntrllr" tabStyle="KimbleOne__ReferenceData__c"  sidebar="false">
	<apex:composition template="KimbleOne__SiteMaster">
	
		<apex:define name="Menu">
		    	 <c:Menu DefaultHelpPage="BulkVacationTransfer.html" MenuContextType="ResourcedActivity" MenuContextId="{!KimbleOne__ResourcedActivity__c.Id}" MenuContextName="{!KimbleOne__ResourcedActivity__c.Name}" /> 
		</apex:define>
		  
		<apex:define name="Content">
		
	<apex:form >
	
	         <apex:pageMessages escape="False" /> 
	
	        <div id="Jobs"></div>
	
			<apex:outputPanel layout="none" rendered="{!JobsRunning}">
			<script>
				jQuery(function ()
				{
					intialise();
				});
		
				function intialise()
				{
					loadJobsInline(jQuery('#Jobs'), '{!JSINHTMLENCODE(JobContextId)}','{!JSENCODE($Label.TransferringUsage)}', refreshPage);
				}
		
				function refreshPage()
				{
					window.location = window.location;
				}
		
			</script>
			</apex:outputPanel>
			
			<style>
				.transfer-narrative {
				    padding: 10px 0px 10px 0px;
				    display: block;
			        line-height: 26px;
				}
				.transfer-narrative select, .transfer-narrative .narrative-value {
				    margin: 0px 4px 0px 4px;
				}
			</style>
        
			<apex:pageBlock title="{!$Label.kimbleone__bulkusagetransfer}" rendered="{!!JobsRunning}">
				<apex:outputPanel styleClass="transfer-narrative">
					<apex:outputText value="{!$Label.kimbleone__transferusage} {!$Label.kimbleone__from}"/>
					<apex:outputText value="{!KimbleOne__ResourcedActivity__c.Name}" styleClass="narrative-value"/>
					<apex:outputText value="{!$Label.kimbleone__usinglabel}"/>
					<apex:selectlist value="{!TransferFromAdjustmentReason}" size="1">
						<apex:selectoptions value="{!TransferFromReasons}"></apex:selectoptions>
					</apex:selectlist>
					<apex:outputText value="{!$Label.kimbleone__to}" styleClass="narrative-splitter"/>
					<apex:selectlist value="{!TransferToId}" size="1">
						<apex:selectoptions value="{!TheResourcedActivities}"></apex:selectoptions>
					</apex:selectlist>
					<apex:outputText value="{!$Label.kimbleone__usinglabel}"/>
					<apex:selectlist value="{!TransferToAdjustmentReason}" size="1">
						<apex:selectoptions value="{!TransferToReasons}"></apex:selectoptions>
					</apex:selectlist>
				</apex:outputPanel>
			</apex:pageBlock>

			<apex:pageBlock title="{!$Label.kimbleone__selectassignmentstotransferusagefrom}" rendered="{!!JobsRunning}">
				<apex:pageBlockbuttons location="bottom">
					<apex:commandButton action="{!TransferUsage}" value="{!$Label.kimbleone__transferusage}"/>
					</apex:pageBlockbuttons> 
				    <apex:inputHidden value="{!TheCurrentPageNumber}"/>
				
  					<apex:pageBlockTable value="{!ThePagedMatchingLines}" var="assignment">
	 					<apex:column headervalue="{!$ObjectType.KimbleOne__Resource__c.Label}">
	 					<apex:outputLink value="{!$Page.KimbleOne__ResourceUsageAdjustments}?id={!assignment.KimbleOne__Resource__c}"><apex:outputText value="{!assignment.Resource__r.Name}"/></apex:outputLink>
	 					</apex:column>
						<apex:column value="{!assignment.KimbleOne__BaselineUsage__c}"/>
						<apex:column value="{!assignment.KimbleOne__TotalActualUsage__c}"/>
						<apex:column value="{!assignment.KimbleOne__UnforecastUsage__c}"/>
						<apex:column headervalue="{!$Label.kimbleone__remainingusageheading}" value="{!UsageAdjustmentMap[assignment.id].remainingusageformatted}"/> 
						<apex:column headervalue="{!$Label.kimbleone__scheduledusageheading}" value="{!UsageAdjustmentMap[assignment.id].scheduledusageformatted}"/>
						<apex:column ><apex:inputfield value="{!UsageAdjustmentMap[assignment.id].checkboxvalue.inputcheckbox__c}"/></apex:column>	
						<apex:column headervalue="{!$Label.kimbleone__adjustmentamount}"><apex:inputfield value="{!UsageAdjustmentMap[assignment.id].adjustmentamount.inputdecimal__c}" /></apex:column>											
					</apex:pageBlockTable>

		            <div style="float:left; margin-top:15px;">
						<apex:outputText value="{!CurrentPageDescription}"/>
					</div>
                    <div style="float: right; margin-right: 15px; margin-top:15px;">
                        <apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoPrevious}" rendered="{!CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
                        <apex:outputText styleclass="greyedLink" rendered="{!!CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
                        &nbsp;|&nbsp;
                        <apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoNext}" rendered="{!CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
                        <apex:outputText styleclass="greyedLink" rendered="{!!CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>     
                    </div>
                    <div style="clear:both;"></div>			
			</apex:pageBlock>
	</apex:form>										
		
		</apex:define>
	</apex:composition>
</apex:page>