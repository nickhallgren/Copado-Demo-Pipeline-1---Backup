<apex:page controller="OrgChartPlus.SM_Config" standardStylesheets="false" applyBodyTag="false" sidebar="false" showHeader="false">
    <apex:includeLightning />
    
    <style type="text/css">
        html, body, #OuterContainer, #LightningContainer { height:100%; width:100%; margin:0px; padding:0px; overflow:hidden; }
        #OuterContainer { background-color: rgb(176, 196, 223); }
        #LoadingMessage {
            position: absolute;
            top: 40%;
            left: 0;
            right: 0;
            text-align: center;
        }

        #SetupBrand {
            display: flex;
            flex-direction: column;
            position: relative;
            height: 100%;
            width: 100%;
            padding: 0.75rem;
        }

        #SetupBrand:before {
            content: '';
            display: block;
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            height: 12.5rem;
            z-Index: 0;
            background: url(/_slds/images/themes/oneSalesforce/banner-brand-default.png?cache=be3300a3),linear-gradient(to top, rgba(25, 85, 148, 0) 0, rgb(25, 85, 148));
        }
    </style>

    <div id="OuterContainer" class="slds-scope">
        <div id="SetupBrand">
            <div id="LoadingMessage">
                Loading OrgChartPlus Configuration. Please wait.
            </div>
        
            <div id="LightningContainer">
            </div>
        </div>
    </div>

    <script>
    $Lightning.use("{!lwcNamespace}:orgChartPlusApp2", function() {
        $Lightning.createComponent("{!lwcNamespace}:ocpConfig", {}, "LightningContainer", function(components, status, errorMessage) {
            var msg = document.getElementById('LoadingMessage');
            msg.innerHTML = '';

            if (status !== "SUCCESS") {
                var content = document.createTextNode(errorMessage);
                msg.appendChild(content);
            }
        });
    });
    </script>    
</apex:page>