<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.ProductAlternativesController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">
  
<apex:define name="Menu">
	
		<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
	<style>
		.action-icon {
		    cursor: pointer;
		}
	</style>

	<apex:form >
<!-- Additional fields -->
	<apex:outputField value="{!KimbleOne__Product__c.KimbleOne__ProductDomain__c}" rendered="false" />
	<apex:outputField value="{!KimbleOne__Product__c.KimbleOne__IsAbstract__c}" rendered="false" />
	<apex:outputField value="{!KimbleOne__Product__c.KimbleOne__AbstractionType__c}" rendered="false" />
		
		<apex:outputPanel id="ProductEditMainPanel">
			
			<apex:pageMessages escape="false" id="messagesMain"/>
			
			<apex:pageBlock id="ProductEditMainPanelNoMessage">		
				<apex:pageBlockButtons location="bottom">
					<apex:commandButton action="{!save}" value="{!$Label.kimbleone__save}"/>						
				</apex:pageBlockButtons>

				<apex:pageBlockSection collapsible="false" title="{!$Label.kimbleone__alternativesgroup}" rendered="{!KimbleOne__Product__c.KimbleOne__IsAbstract__c}" columns="1" id="alternatives">
					<apex:outputPanel rendered="{!hasAddableAlternatives}"><span class="fa fa-plus-square action-icon" onClick="initialiseModalBoxy('#addAlternativePopup', '{!JSENCODE($Label.kimbleone__addalternativemember)}', '#popups');showModalBoxy()"/></apex:outputPanel>
					<apex:actionRegion >
					<apex:pageBlockTable value="{!alternativeMembers}" var="member">
						<apex:column ><span class='fa fa-trash-o action-icon' onClick="deleteAlternative('{!member.ChildProduct__r.id}');"/></apex:column>
						<apex:column value="{!member.KimbleOne__ChildProduct__c}"/>
						<apex:column value="{!member.ChildProduct__r.KimbleOne__DefaultDescription__c}"/>
						<apex:column value="{!member.ChildProduct__r.KimbleOne__ProductDomain__c}"/>
					</apex:pageBlockTable>
		
					<apex:actionFunction name="deleteAlternative" action="{!deleteAlternative}" rerender="alternatives,addAlternativePopup,messagesMain">
						<apex:param name="productId" value="" />
					</apex:actionFunction>
					</apex:actionRegion>
				</apex:pageBlockSection>
				
			</apex:pageBlock>
			
		</apex:outputPanel>
		
		<div id="popups">
		<div id='addAlternativePopup' style='{!htmlencode(HiddenElementStyle)}'>
		<apex:outputPanel id="addAlternativePopup">
			<apex:pageMessages escape="false"/>
			
			<apex:pageBlock >
				<apex:pageBlockButtons location="bottom">
					<input type='button' class='btn DisableButtonWhileBusy' value='{!JSENCODE($Label.Ok)}' onClick='addAlternative()' />
					<input type='button' class='btn' value='{!JSENCODE($Label.Cancel)}' onClick='hideModalBoxy()' />
				</apex:pageBlockButtons>
				
				<apex:actionRegion >
				<apex:pageBlockSection collapsible="false" columns="1">
					<apex:selectList value="{!addableAlternative}" size="1" id="addableAlternative">
						<apex:selectOptions value="{!addableAlternativeOptions}" />
					</apex:selectList>
				</apex:pageBlockSection>		
				<apex:actionFunction name="addAlternative" action="{!addAlternative}" rerender="alternatives,addAlternativePopup,messagesMain" onComplete="hideModalBoxy();"/>
				</apex:actionRegion>
		
			</apex:pageBlock>
		</apex:outputPanel>
		</div>
		</div>
		
	</apex:form>
</apex:define>
</apex:composition>

</apex:page>