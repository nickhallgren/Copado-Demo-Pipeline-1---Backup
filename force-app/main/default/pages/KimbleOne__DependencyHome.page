<apex:page standardController="KimbleOne__Dependency__c" extensions="KimbleOne.DependencyEditController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Issues.html" MenuContextType="{!IF(ISBLANK(KimbleOne__Dependency__c.KimbleOne__Proposal__c), 'DeliveryGroup','Proposal')}" MenuContextId="{!IF(ISBLANK(KimbleOne__Dependency__c.KimbleOne__Proposal__c), KimbleOne__Dependency__c.KimbleOne__DeliveryGroup__c,KimbleOne__Dependency__c.KimbleOne__Proposal__c)}" MenuContextName="{!IF(ISBLANK(KimbleOne__Dependency__c.KimbleOne__Proposal__c), KimbleOne__Dependency__c.DeliveryGroup__r.Name ,KimbleOne__Dependency__c.Proposal__r.Name)}"/>

</apex:define>  
   
<apex:define name="Content">

	   
	<apex:pagemessages escape="false"/>

	<chatter:feedWithFollowers entityId="{!KimbleOne__Dependency__c.Id}" rendered="{!ShowChatter}"/>

    <apex:form >
		<apex:outputPanel id="DependencyDetailsPanel" >
		    	<apex:pageBlock id="DependencyDetailsBlock" title="{!$ObjectType.KimbleOne__Dependency__c.Label}">
		    	
		    	    <apex:pageBlockButtons location="top">
    				<apex:commandButton rendered="{!KimbleOne__Dependency__c.DeliveryGroup__r.DeliveryStage__r.KimbleOne__AllowNewDependencies__c}" action="{!Edit}" value="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__Dependency__c.label}"/>
    				</apex:pageBlockButtons> 
		    	  
		    		<div id="DependencyDetailsErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
		    	   
					<apex:pageBlockButtons location="bottom"> 
						<apex:commandButton action="{!goToDependencyManager}" value="{!$Label.kimbleone__back}" oncomplete="" reRender=""/>						
					</apex:pageBlockButtons>
					
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
             		 
               			<apex:outputfield value="{!KimbleOne__Dependency__c.Name}" />
               			<apex:outputfield value="{!KimbleOne__Dependency__c.KimbleOne__Status__c}" />
              			<apex:outputfield value="{!KimbleOne__Dependency__c.KimbleOne__DueDate__c}" />
              			<apex:outputfield value="{!KimbleOne__Dependency__c.KimbleOne__Summary__c}" />
              			<apex:outputfield value="{!KimbleOne__Dependency__c.KimbleOne__Description__c}" />
               			
					</apex:pageBlockSection>					

					<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
						<apex:repeat value="{!$ObjectType.KimbleOne__Dependency__c.FieldSets.KimbleOne__DependencyDetails}" var="f">
		     				<apex:outputfield value="{!KimbleOne__Dependency__c[f]}" />
   						</apex:repeat>
		            </apex:pageBlockSection>						

		    	</apex:pageBlock>
		</apex:outputPanel>
		    
    </apex:form>
     </apex:define>
</apex:composition> 
</apex:page>