    var datePrimer = function(d){if (d==null) return null; return d.toDate()};
	var stringPrimer = function(s){return s};
	
	var sortFields = {StartDate:{name:'StartDate', primer:datePrimer}, EndDate:{name:'EndDate', primer:datePrimer}, Name:{name:'Name', primer:stringPrimer}};
	
	
	//DEFAULT SORT FROM CONFIG THEN COOKIE
	var sortCookie = readCookie('kimble.sortmilestonetableby');
	var sortDirection = '{!DefaultDirection}';
	var sortBy1 = sortFields['{!DefaultSortByField1}'];
	var sortBy2 = sortFields['{!DefaultSortByField2}'];
		
	if (sortCookie == '{!ConfigSettingNameASC}') 
	{
		sortBy1 = sortFields['Name'];
		sortBy2 = sortFields['StartDate'];
		sortDirection = 'ASC';
	}
	else if (sortCookie == '{!ConfigSettingNameDESC}') 
	{
		sortBy1 = sortFields['Name'];
		sortBy2 = sortFields['StartDate'];
		sortDirection = 'DESC';
	}
	else if (sortCookie == '{!ConfigSettingDateASC}') 
	{
		sortBy1 = sortFields['StartDate'];
		sortBy2 = sortFields['Name'];
		sortDirection = 'ASC';
	}
	else if (sortCookie == '{!ConfigSettingDateDESC}') 
	{
		sortBy1 = sortFields['StartDate'];
		sortBy2 = sortFields['Name'];
		sortDirection = 'DESC';
	}
	
	function sortList(a, b)
	{
		var x = sortBy1.primer(a[sortBy1.name]);
		var y = sortBy1.primer(b[sortBy1.name]);
		console.log(x + ' :: ' + y);
		
		console.log(x > y);
		
		if (sortDirection == 'ASC')
		{
			if (x == y) return sortBy2.primer(a[sortBy2.name]) > sortBy2.primer(b[sortBy2.name]);
			return x > y ? 1 : -1;
		}
		else
		{
			if (x == y) return sortBy2.primer(b[sortBy2.name]) > sortBy2.primer(a[sortBy2.name]);
			return y > x ? 1 : -1;
		}
	}
	
	function sortMap(source)
	{
		return function(a, b) {
			var x = sortBy1.primer(source[a][sortBy1.name]);
			var y = sortBy1.primer(source[b][sortBy1.name]);
				
			if (sortDirection == 'ASC')
			{
				if (x == y) return sortBy2.primer(source[a][sortBy2.name]) > sortBy2.primer(source[b][sortBy2.name]);
				return x > y ? 1 : -1;
			}
			else
			{
				if (x == y) return sortBy2.primer(source[b][sortBy2.name]) > sortBy2.primer(source[a][sortBy2.name]);
				return y > x ? 1 : -1;
			}
		}
	}
	
	function toggleTreeNode(e)
	{
		var row = jQuery(this).closest('tr');
		
		if (!row.hasClass('branch')) return;
		
		if (row.hasClass('expanded'))
		{
			//remove class expanded and hide all my children and grandchildren
			row.removeClass('expanded');
			hideNode(row);
			treeState[row.attr('node-id')] = {};
		}
		else
		{
			row.addClass('expanded');
			showNode(row);
			delete treeState[row.attr('node-id')];
		}
		
		jQuery(window).resize();
	}
	
	function showNode(node)
	{
		jQuery.each(jQuery('[parent-node-id="' + node.attr('node-id') + '"]'), function (i, child) {
			var childNode = jQuery(child);
			childNode.show();
			if (childNode.hasClass('expanded'))
				showNode(childNode);
		});
	}
	
	function hideNode(node)
	{
		jQuery.each(jQuery('[parent-node-id="' + node.attr('node-id') + '"]'), function (i, child) {
			var childNode = jQuery(child);
			childNode.hide();
			if (childNode.attr('node-id') != null)
				hideNode(childNode);
		});
	}
	
