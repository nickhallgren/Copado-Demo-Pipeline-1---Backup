    function getMilestoneGridHtml(element, milestone, gridOptions)
    {
    	var milestoneRow = '<tr class="dataRow tree-node " parent-node-id="' + element.Id + '" node-id="' + milestone.Id + '" level="1">';
								
		if (milestone.CanEdit)
		{
			milestoneRow += '<td class="action-col">';
			milestoneRow += '<a href="javascript:editMilestone(\'' + element.Id + '\', \'' + milestone.Id + '\')" title="Edit Milestone"><i class="fa fa-pencil-square-o"></i></a>';
			
			if ({!HasPermission['TransferDeliveryElementItems']} && milestone.CanMoveToOperatingActivity)
			{
				milestoneRow += '&nbsp;&nbsp;<a  id="' + milestone.Id + '" title="{!$Label.MovetoOperatingElement}" class="move-milestone" href="javascript:moveMilestone(\'' + milestone.Id + '\')"><i style="font-size: 16px;margin-top:8px;" class="fa fa-level-up"></i></a>';
			}
			
			if(milestone.CanClone)
			{
			    milestoneRow += ' <a href="javascript:cloneMilestone(\'' + element.Id + '\', \'' + milestone.Id + '\')" title="Clone Milestone"><i class="fa fa-clone"/></a>';
   			}
			
			milestoneRow += '</td>';
		}
		else
		{
			milestoneRow += '<td class="action-col"></td>';
		}
		
		milestoneRow += ('<td><span class="indent"/><a class="open-milestone-link" href="/' + milestone.Id + '" title="' + milestone.Name +'">' + milestone.Name + '</a></td>');
		
		if (gridOptions.showScopingElement)
			milestoneRow += ('<td><span title="' + element.Name + '">' + element.Name + '</span></td>');
		
		milestoneRow += '<td class="centerAlignDataCell complete-cell" style="font-size: 16px;">';
		
		var completeWarningHtml = '';
		if (milestone.CanComplete && element.AllowNewRevenueCostItems)
		{
			milestoneRow += '<a id="' + milestone.Id + '" href="javascript:completeMilestone(\'' + milestone.Id + '\')" style="text-decoration: none;" class="complete-milestone fa can-complete ';
			if(milestone.AutoComplete) completeWarningHtml += '<i class="fa fa-warning auto-complete-inline-warning" title="' + '{!JSENCODE($Label.MilestoneAutoCompletionWarning)}' +'"></i>';
		}
		else
		{
			milestoneRow += '<span class="fa cannot-complete ';
		}
		
		if (milestone.Status == 'Open')
			milestoneRow += 'fa-square-o open';
		
		if (milestone.Status == 'CompletedUnapproved')
			milestoneRow += 'fa-check-square completed-unapproved';
		
		if (milestone.Status == 'Completed') 
		 	milestoneRow += 'fa-check-square-o completed';	
		
		if (milestone.Status == 'Obsolete') 
			milestoneRow += 'fa-minus-circle obsolete';
			
		if (milestone.EventId != null && milestone.Status == 'Open')
		{
			milestoneRow += '" title="{!$Label.MilestoneLinkedToEventMessage}">';
		}
		else
		{
			milestoneRow += '">';
		}
		
		if (milestone.CanComplete)
		{
			milestoneRow += '</a>' + completeWarningHtml;
		}
		else
		{
			milestoneRow += '</span>';
		}
		
		if(milestone.ApprovalComments != undefined && milestone.ApprovalComments != '' && milestone.Status == 'Open')
		{
		    milestoneRow += '<span class="fa fa-info-circle info-indicator approval-info-icon">';
			milestoneRow += '<div style="display:none;" class="tool-tip-content">{!$Label.RejectionCommentsHeading}' + ': ' + milestone.ApprovalComments + '</div>';
			milestoneRow += '</span>';
		}		
		
		milestoneRow += '</td>';
		
		milestoneRow += ('<td class="centerAlignDataCell">' + kimble.formatDate(milestone.StartDate) + '</td>');
		
		if (gridOptions.showUnits) 
		{
			if ((milestone.MilestoneType == 'Cost' && element.HasCostUnits) || (milestone.MilestoneType == 'Revenue' && element.HasRevenueUnits))
			{
				milestoneRow += '<td class="rightAlignDataCell">' + milestone.Units + '</td>';
				milestoneRow += '<td class="rightAlignDataCell">' + element.CurrencyISOCode + ' ' + kimble.formatNumber(milestone.UnitValue, '#,##0.##') + '</td>';
			}
			else
			{
				milestoneRow += '<td class="rightAlignDataCell"></td>';
				milestoneRow += '<td class="rightAlignDataCell"></td>';
			}
		}
		
		if (gridOptions.showRevenue)
		{
			milestoneRow += '<td class="rightAlignDataCell">';
			
			if (milestone.MilestoneType == 'Revenue') 
			{
				milestoneRow += element.InvoicingCurrencyISOCode + ' ' + kimble.formatNumber(milestone.InvoicingCurrencyRevenue, '#,##0.##');
						
				if (element.RevenueForecastMode == 'DeliveryElement') milestoneRow += ' (' + milestone.Percentage + '%)';
			}
			else
				milestoneRow += '-';
						
			milestoneRow += '</td>';
					
			milestoneRow += '<td class="rightAlignDataCell">';	
			
			if (milestone.MilestoneType == 'Revenue') 
			{
				milestoneRow += element.CurrencyISOCode + ' ' + kimble.formatNumber(milestone.Revenue, '#,##0.##');
				
				if (element.RevenueForecastMode == 'DeliveryElement') milestoneRow += ' (' + milestone.Percentage + '%)';
			}
			else
				milestoneRow += '-';
				
			milestoneRow += '</td>';
		}
		
		if (gridOptions.showCost)
		{
			milestoneRow += '<td class="rightAlignDataCell">';
		
			if (milestone.MilestoneType == 'Cost') 
			{
				milestoneRow += element.CurrencyISOCode + ' ' + kimble.formatNumber(milestone.Cost, '#,##0.##');
				
				if (element.CostForecastMode == 'DeliveryElement') milestoneRow += ' (' + milestone.Percentage + '%)';
			}
			else
				milestoneRow += '-';
				
			milestoneRow += '</td>';
		}
		
		if (milestone.EventId != null)
		{
			milestoneRow += ('<td><a href="{!$Page.DeliveryGroupTimeline}?id={!KimbleOne__DeliveryGroup__c.Id}&eventId=' + milestone.EventId + '">' + milestone.EventName + '</a></td>');
		}
		else
		{
			milestoneRow += '<td></td>';
		}
		
		milestoneRow += ('<td>' + (milestone.Notes == null ? '' : milestone.Notes) + '</td>');
		
		milestoneRow += '</tr>';
		
		return milestoneRow;
    	
    }
    
