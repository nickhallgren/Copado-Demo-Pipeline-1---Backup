<apex:page standardController="KimbleOne__ResourcedActivity__c" extensions="KimbleOne.BidTeamActivityController,KimbleOne.TooltipsController"  showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__ReferenceData__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
     	
     	<c:Menu DefaultHelpPage="ViewAssignments.html" MenuContextType="Proposal" MenuContextId="{!KimbleOne__ResourcedActivity__c.KimbleOne__Proposal__c}" MenuContextName="{!KimbleOne__ResourcedActivity__c.Proposal__r.Name}" />
     	 
    </apex:define>
    
    <apex:define name="Content">

        <!-- Kimble Guidance -->
        <apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
        <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
        <apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
            <apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/BidTeamActivityNarratives/' + UserNarrativeLanguageCode + '.js')}" />

            <apex:outputPanel layout="none" rendered="{!BidTeamActivityTipOverrideEnabled}">
                <apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
            </apex:outputPanel>
        </apex:outputPanel>

        <div style="display:none;" kimble-tip="null"></div>
    	<c:ResourcedActivityCards ComponentContext="{!TheContext}"/>

        <apex:form >
            <apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
        </apex:form>
        
        <script>
        
	 	$(document).ready(function(){
            initialisePageTips();
        });
        
		/* Tooltips */
		var enableTips = <apex:outputText value="{!TooltipsEnabled}"/>;
		var BaseHelpURL = '<apex:outputText value="{!URLFOR($Resource.KimbleOne__KimbleHelp, '')}"/>';
		var DetailedHelpLabel = '<apex:outputText value="{!$Label.kimbleone__detailedhelp}"/>';
		var MoreLabel = '<apex:outputText value="{!$Label.kimbleone__more}"/>';
		var TipsEnabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsenabled}"/>';
		var TipsDisabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsdisabled}"/>';
		
		// add tip attributes to elements in components
        function initialisePageTips()
        {
            ApplyTipAttributes();
            initialiseTips();
        }
        
        // add tip attributes to elements
        function ApplyTipAttributes()
        {
            if(enableTips)
            {
                // base page tips
                jQuery('[id$="actualUsageEntryFormatLabel"]').parent().attr('kimble-tip','A_ActualUsageEntryFormat').attr('kimble-tip-extended-text','A_ActualUsageEntryFormatExtendedText').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="forecastTimeEntryIcon"]').attr('kimble-tip','A_ActivityIcons').attr('kimble-tip-extended-text','A_ActivityIconsExtendedText').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="costHeader"]').attr('kimble-tip','A_Cost').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="forecastUsageEntryFormatLabel"]').parent().attr('kimble-tip','A_ForecastUsageEntryFormat').attr('kimble-tip-extended-text','A_ForecastUsageEntryFormatExtendedText').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="maxUsageHeader"]').attr('kimble-tip','A_MaxUsage').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="editRateBandPencil"]').attr('kimble-tip','A_PencilIcon').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="revenueHeader"]').attr('kimble-tip','A_Revenue').attr('kimble-tip-help-link','EditActivityDetailsLink');
                jQuery('[id$="toilHeader"]').attr('kimble-tip','A_TOIL').attr('kimble-tip-extended-text','A_TOILExtendedText').attr('kimble-tip-help-link','TimeOffinLieuTOILLink');
                jQuery('[id$="usageUnitsOutput"]').attr('kimble-tip','A_UsageUnits');
                jQuery('[id$="utilisationHeader"]').attr('kimble-tip','A_Utilisation').attr('kimble-tip-help-link','EditActivityDetailsLink');
                
                var prbTips = '[id$="ActivityRateBandEditPopup"]:visible';
                if(jQuery(prbTips).length)
                {	
                    jQuery(prbTips).find('[id$="costRateFactorInput"]').attr('kimble-tip','PRB_CostRateFactor').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="costRateFactorOutput"]').attr('kimble-tip','PRB_CostRateFactor').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="maxUsageInput"]').attr('kimble-tip','PRB_MaximumUsage').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="rateBandNameInput"]').attr('kimble-tip','PRB_Name').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="periodRateBandSelect"]').attr('kimble-tip','PRB_RateBand').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="revenueUnitsCalcSelect"]').attr('kimble-tip','PRB_RevenueUnitsCalcMethod').attr('kimble-tip-extended-text','PRB_RevenueUnitsCalcMethodExtendedText').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="notesMandatoryCheckbox"]').attr('kimble-tip','PRB_TimeEntryNotesMandatory').addClass('tip-right').attr('kimble-tip-help-link','PRB_NotesMandatoryLink');
                    jQuery(prbTips).find('[id$="toilFactorInput"]').attr('kimble-tip','PRB_TOILFactor').attr('kimble-tip-extended-text','PRB_TOILFactorExtendedText').addClass('tip-right').attr('kimble-tip-help-link','TimeOffinLieuTOILLink');
                    jQuery(prbTips).find('[id$="usageAllocationTypeSelect"]').attr('kimble-tip','PRB_UsageAllocationType').attr('kimble-tip-extended-text','PRB_UsageAllocationTypeExtendedText').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                    jQuery(prbTips).find('[id$="utilisationFactorInput"]').attr('kimble-tip','PRB_UtilisationFactor').addClass('tip-right').attr('kimble-tip-help-link','MaintainRateBandsLink');
                }
                
                var eraTips = '[id$="ResourcedActivityEditPopup"]:visible';
                if(jQuery(eraTips).length)
                {		
                    jQuery(eraTips).find('[id$="activityStatusField"]').attr('kimble-tip','RA_ActivityStatus').attr('kimble-tip-extended-text','RA_ActivityStatusExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditActivityDetailsLink');
                    jQuery(eraTips).find('[id$="actualiseForecastOnlyInput"]').attr('kimble-tip','RA_ActualiseForecastOnly').addClass('tip-right');
                    jQuery(eraTips).find('input[id$="location-lookup-enhanced"]').attr('kimble-tip','RA_Location').attr('kimble-tip-extended-text','RA_LocationExtendedText');
                    jQuery(eraTips).find('[id$="location-lookup"]').attr('kimble-tip','RA_Location').attr('kimble-tip-extended-text','RA_LocationExtendedText');
                    jQuery(eraTips).find('[id$="allowFrameworkAssignmentInput"]').attr('kimble-tip','RA_AllowFrameworkAssignment').attr('kimble-tip-extended-text','RA_AllowFrameworkAssignmentExtendedText').addClass('tip-right').attr('kimble-tip-help-link','FrameworkAssignmentsLink');
                    jQuery(eraTips).find('[id$="calendarIsPrivateInput"]').attr('kimble-tip','RA_CalendarPrivate').addClass('tip-right').addClass('tip-right').attr('kimble-tip-help-link','EditResourcedActivityLink');
                    jQuery(eraTips).find('[id$="calendarShowAsInput"]').next().attr('kimble-tip','RA_CalendarShowAs').attr('kimble-tip-extended-text','RA_CalendarShowAsExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditResourcedActivityLink');
                    jQuery(eraTips).find('[id$="canSelfForecastField"]').attr('kimble-tip','RA_CanSelfAssign').addClass('tip-right').attr('kimble-tip-help-link','EditResourcedActivityLink');
                    jQuery(eraTips).find('[id$="hideForecastInput"]').attr('kimble-tip','RA_HideForecast').attr('kimble-tip-extended-text','RA_HideForecastExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditActivityDetailsLink');
                    jQuery(eraTips).find('[id$="scheduledTimeRuleInput"]').attr('kimble-tip','RA_ScheduledTimeRule').attr('kimble-tip-extended-text','RA_ScheduledTimeRuleExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditResourcedActivityLink');
                    jQuery(eraTips).find('[id$="timeEntryRuleInput"]').attr('kimble-tip','RA_TimeEntryRule').addClass('tip-right');
                    jQuery(eraTips).find('[id$="usageAllocationTypeField"]').attr('kimble-tip','RA_UsageAllocationType').attr('kimble-tip-extended-text','RA_UsageAllocationTypeExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditResourcedActivityLink');
                    jQuery(eraTips).find('[id$="usageTrackingModelInput"]').attr('kimble-tip','RA_UsageTrackingModel').addClass('tip-right').attr('kimble-tip-help-link','UsageTrackingModelsLink');
                    jQuery(eraTips).find('[id$="usageUnitsSelect"]').attr('kimble-tip','RA_UsageUnits').attr('kimble-tip-extended-text','RA_UsageUnitsExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditActivityDetailsLink');
                    jQuery(eraTips).find('[id$="usageUnitsOutput"]').attr('kimble-tip','RA_UsageUnits').attr('kimble-tip-extended-text','RA_UsageUnitsExtendedText').addClass('tip-right').attr('kimble-tip-help-link','EditActivityDetailsLink');
                    jQuery(eraTips).find('[id$="utilisationRuleSelect"]').attr('kimble-tip','RA_UtilisationRule').attr('kimble-tip-extended-text','RA_UtilisationRuleExtendedText').addClass('tip-right');
                    jQuery(eraTips).find('[id$="workItemLevelSelect"]').attr('kimble-tip','RA_WorkItemLevel').addClass('tip-right').attr('kimble-tip-help-link','WorkItemsLink');
                    jQuery(eraTips).find('[id$="workItemUnitsSelect"]').attr('kimble-tip','RA_WorkItemUnits').attr('kimble-tip-extended-text','RA_WorkItemUnitsExtendedText').addClass('tip-right').attr('kimble-tip-help-link','WorkItemsLink');
                }
            }
        }

		function updateTipsConfigSetting(newTipSetting)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
				newTipSetting,
					function(result, event){
						if (event.status)
						{
							var data = {};
							data.results = result;
							loadGuidance();
						}
						else
						{
							alert(event.message);
						}
				},
				{escape: false, timeout: 60000}
			);
		}
    </script>

    </apex:define>

</apex:composition>

</apex:page>