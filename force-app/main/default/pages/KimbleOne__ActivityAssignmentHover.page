<apex:page standardController="KimbleOne__ActivityAssignment__c" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__ReferenceData__c">
		<apex:outputPanel layout="none" rendered="{!(!ISBLANK(KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__EndDate__c) && KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__EndDate__c < KimbleOne__ActivityAssignment__c.KimbleOne__ForecastP3EndDate__c) || (!ISBLANK(KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__StartDate__c) && KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__StartDate__c > KimbleOne__ActivityAssignment__c.KimbleOne__StartDate__c )}">
		<div id="warningMessage">
 	 		<div class="message warningM3">
		        <table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;text-align:left;">
		            <tbody>
		            	<tr valign="top">
		                	<td>
		                    	<img alt="{!$Label.kimbleone__warningcapsheading}" class="msgIcon" src="/s.gif" title="{!$Label.kimbleone__warningcapsheading}"/>
		                	</td>
		                	<td class="messageCell">
		                		<div class="messageText">
		                			<apex:outputPanel layout="none" rendered="{!!ISBLANK(KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__EndDate__c) && KimbleOne__ActivityAssignment__c.Resource__r.KimbleOne__EndDate__c < KimbleOne__ActivityAssignment__c.KimbleOne__ForecastP3EndDate__c}">
		                				{!$Label.kimbleone__resoureendbeforeactivityassignmentend}
		                				<br/>
		                			</apex:outputPanel>
		                			<apex:outputPanel layout="none" rendered="{!!ISBLANK(ActivityAssignment__c.Resource__r.StartDate__c) && ActivityAssignment__c.Resource__r.StartDate__c > ActivityAssignment__c.StartDate__c }">
		                				{!$Label.kimbleone__resourestartafteractivityassignmentstart}
		                				<br/>
		                			</apex:outputPanel>
		                		</div>
		                	</td>
		            	</tr>
		            	<tr>
		                	<td></td>
		                	<td></td>
		            	</tr>
		        	</tbody>
		        </table>
    		</div>
 	 	</div>
 	 	</apex:outputPanel>
 	 	<apex:pageBlock title="{!$ObjectType.KimbleOne__ActivityAssignment__c.Label}">
	 		
	 		<apex:pageblockSection columns="1" >
	 		
	 		<apex:outputField value="{!KimbleOne__ActivityAssignment__c.KimbleOne__Resource__c}"/>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Label}</apex:outputLabel>
				<apex:outputPanel layout="none">
					<apex:outputLink value="{!$Page.KimbleOne__ActivityAssignmentsDelivery}?id={!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.DeliveryElement__r.KimbleOne__DeliveryGroup__c}" rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'DeliveryElement'}"><apex:outputText value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.KimbleOne__FullName__c}"/></apex:outputLink>
					<apex:outputLink value="{!$Page.KimbleOne__BidTeamAssignments}?id={!KimbleOne__ActivityAssignment__c.KimbleOne__ResourcedActivity__c}" rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'SalesOpportunity'}"><apex:outputText value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.KimbleOne__FullName__c}"/></apex:outputLink>
					<apex:outputLink value="{!$Page.KimbleOne__OtherResourcedActivityDetails}?id={!KimbleOne__ActivityAssignment__c.KimbleOne__ResourcedActivity__c}" rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'Other'}"><apex:outputText value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.KimbleOne__FullName__c}"/></apex:outputLink>
				</apex:outputPanel>	
			</apex:pageBlockSectionItem>
			
			<apex:outputField rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'DeliveryElement'}" value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.KimbleOne__DeliveryGroup__c}"/>
			
			<apex:outputField rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'DeliveryElement'}" value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.DeliveryGroup__r.KimbleOne__Account__c}"/>
			
			<apex:outputField rendered="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'SalesOpportunity'}" value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.KimbleOne__Proposal__c}"/>

			<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__ActivityAssignment__c.KimbleOne__Location__c) && (KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'DeliveryElement' || KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'SalesOpportunity')}">
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Location__c.Label}</apex:outputLabel>
				<apex:outputField value="{!KimbleOne__ActivityAssignment__c.Location__r.Name}"/>
			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__ActivityAssignment__c.KimbleOne__ActivityRole__c) && (KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'DeliveryElement' || KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ResourcedActivityType__r.KimbleOne__Enum__c == 'SalesOpportunity')}">
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ActivityRole__c.Label}</apex:outputLabel>
				<apex:outputField value="{!KimbleOne__ActivityAssignment__c.ActivityRole__r.Name}"/>
			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}</apex:outputLabel>
				<apex:outputField value="{!KimbleOne__ActivityAssignment__c.KimbleOne__StartDate__c}"/>
			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel >{!$Label.kimbleone__enddatelabel}</apex:outputLabel>
				<apex:outputField value="{!KimbleOne__ActivityAssignment__c.KimbleOne__ForecastP3EndDate__c}"/>
			</apex:pageBlockSectionItem>	
			
			<apex:outputField value="{!KimbleOne__ActivityAssignment__c.KimbleOne__UsageBehaviourRule__c}"/>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UtilisationPercentage__c.Label}</apex:outputLabel>
					<apex:outputLabel >
						 <apex:outputText rendered="{!KimbleOne__ActivityAssignment__c.UsageBehaviourRule__r.EntrySpecification__r.KimbleOne__Enum__c == 'DerivedUtilisation'}" value="{!$Label.kimbleone__derivedutilisationlabel}" >
						 	<apex:param value="{!ROUND(KimbleOne__ActivityAssignment__c.KimbleOne__ForecastRemainingUsage__c,2)}" />
						 	<apex:param value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ForecastUnitType__r.KimbleOne__Suffix__c}" />
						 </apex:outputText>
						 <apex:outputText rendered="{!KimbleOne__ActivityAssignment__c.UsageBehaviourRule__r.EntrySpecification__r.KimbleOne__Enum__c == 'DerivedUsage'}" value="{!$Label.kimbleone__derivedusagelabel}">
							<apex:param value="{!ROUND(KimbleOne__ActivityAssignment__c.KimbleOne__UtilisationPercentage__c,0)}" />
						 </apex:outputText>	
						  <apex:outputText rendered="{!KimbleOne__ActivityAssignment__c.UsageBehaviourRule__r.EntrySpecification__r.KimbleOne__Enum__c == 'DerivedEndDate'}" value="{!$Label.kimbleone__derivedenddatelabel}" >
						 	<apex:param value="{!ROUND(KimbleOne__ActivityAssignment__c.KimbleOne__ForecastRemainingUsage__c,2)}" />
						 	<apex:param value="{!KimbleOne__ActivityAssignment__c.ResourcedActivity__r.ForecastUnitType__r.KimbleOne__Suffix__c}" />
						 	<apex:param value="{!ROUND(KimbleOne__ActivityAssignment__c.KimbleOne__UtilisationPercentage__c,0)}" />
						 </apex:outputText>	
				</apex:outputLabel>
			</apex:pageBlockSectionItem>
				
			</apex:pageblockSection>
	
	 	</apex:pageBlock>

<style>
.lookupHoverDetail{z-index:7000;}
.labelCol{white-space:nowrap;}
.mainTitle{white-space:nowrap;}
</style>

</apex:page>