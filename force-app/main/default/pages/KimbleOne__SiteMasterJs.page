	function initFunctions(){	
		
		if (typeof DatePicker != 'undefined')
		{
		DatePicker.prototype.position = function () {
		    if ($(this.myElement).hasClass('kimbleDatePicker'))
		    {
		    	this.shim.setStyle('display','none');
		    }
		    else
		    {
			    var matched = false;
			    for (var a = 0, b = 0, c = this.myElement; c != null &amp;&amp; c != this.calendarDiv.offsetParent;) {
			        a += c.offsetLeft;
			        b += c.offsetTop;
			        c = c.offsetParent;
			        if (c == this.calendarDiv.offsetParent)
			        	matched = true;
			    }
			    if (getObjY(this.myElement) + this.calendarDiv.offsetHeight > getScrollY() + getWindowHeight()) b -= this.calendarDiv.offsetHeight;
			    else b += this.myElement.offsetHeight;
			    c = "left";
			    if (LC.isRtlPage()) {
			        c = "right";
			        a = this.calendarDiv.offsetParent.offsetWidth - a - this.myElement.offsetWidth
			    }
			    if (!matched)
			    	b = b - (isSFClassic() ? $('.bodyDiv') : $('#content-pane').closest('body').parent()).offset().top;
			    	
			    this.shim.setStyle(c, a + "px");
			    this.shim.setStyle("top", b + "px");
			    $(this.calendarDiv).css('z-index', '2000');
			 }
		};
		}
		
		//Extend sforce xml object to read property with namespace
		sforce.Xml.prototype.value = getWithNamespace;
		sforce.Xml.prototype.dateValue = getDateWithNamespace;
		
		String.prototype.replaceAt=function(index, char) {
      		return this.substr(0, index) + char + this.substr(index+char.length);
   		}
   		
   		if (typeof String.prototype.endsWith !== 'function') {
    		String.prototype.endsWith = function(suffix) {
        		return this.indexOf(suffix, this.length - suffix.length) !== -1;
			};
		}
   		
		ReferenceDataCache=new Array();
		getReferenceData();
		reregisterButtonsToDisable();
		
		defaultCursorPosition();
		
		String.prototype.format = function() {
    		var s = this,
        	i = arguments.length;

    		while (i--) {
        		s = s.replace(new RegExp('\\{' + i + '\\}', 'gm'), arguments[i]);
    		}
    		return s;
		};
		
		String.prototype.toDate = function () {
			
			var parts = this.split('-');
			if (parts.length != 3) return null;
			
			return new Date(parts[0], parts[1] - 1, parts[2]);
			
		};

		String.prototype.toDateDiscardTime = function () {
			
			var datetimeparts = this.split('T');
			var dateparts = datetimeparts[0].split('-');

			if (dateparts.length != 3) return null;
			
			return new Date(dateparts[0], dateparts[1] - 1, dateparts[2]);
		};
				
		String.prototype.getTimeFromDateTime = function (includeSeconds) {
			
			var datetimeparts = this.split('T');
			var dateparts = datetimeparts[0].split('-');
			var timeparts = datetimeparts[1].split(':');

			if (dateparts.length != 3) return null;
			
			// time portion will depend on whether the time has been recorded with seconds
			var theTimeString = '';
			for(var counter = 0; counter &lt; timeparts.length; counter++)
			{
				if(counter==0) theTimeString = timeparts[counter].padToTwoDigits();
				else if(counter==1) theTimeString += ':' + timeparts[counter].padToTwoDigits();
				else if(counter==2 &amp;&amp; includeSeconds) theTimeString += ':' + timeparts[counter].replace('Z', '').padToTwoDigits();
			}
			
			return theTimeString;
			
		};
		
		String.prototype.padToTwoDigits = function () {
		    return this > 9 ? "" + this: "0" + this;
		}
				
		Date.prototype.toKimbleUTC = function () {
			
			return this.getFullYear() + '-' + (this.getMonth() + 1) + '-' + this.getDate();
			
		};

		Date.prototype.toKimbleUTCWithPadding = function () {

			return this.getFullYear() + '-' + (this.getMonth() + 1).padToTwoDigits() + '-' + this.getDate().padToTwoDigits();

		};

		Number.prototype.padToTwoDigits = function() {
			return this > 9 ? "" + this: "0" + this;
		}

		Date.prototype.kimbleAddDays = function(days){
			return new Date(this.getFullYear(), this.getMonth(), this.getDate() + days, 0, 0, 0, 0);
    	}

		String.prototype.kimbleUTCAddDays = function(days){
			return this.toDate().kimbleAddDays(Math.ceil(days)).toKimbleUTC();
    	}
		///
	}
	
