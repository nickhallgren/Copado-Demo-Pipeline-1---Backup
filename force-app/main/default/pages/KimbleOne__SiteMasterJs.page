function sizeModalBoxyToFitHeight()
{
	if(jQuery('.boxy-wrapper:visible').height() > window.innerHeight)
	{
		var maxHeight = window.innerHeight - jQuery('.boxy-wrapper:visible .title-bar').height() - 25;
		jQuery('.boxy-wrapper:visible .boxy-content').addClass('boxy-scroll').height(maxHeight);
	}
	else
	{
		jQuery('.boxy-wrapper:visible .boxy-content').removeClass('boxy-scroll');
		jQuery('.boxy-wrapper:visible .boxy-content').css('height', 'initial');
	}
}

function isSFClassic()
{
	return ( (typeof sforce == 'undefined' || typeof sforce.one == 'undefined') );
}

function isSFLightning()
{
	return ( !isSFClassic() );
}

// window.location can't be used in lightning 
// so instead we use the lightning js navigation routines
// we can only use these if in lightning as otherwise they will be undefined
function safeNavigateToSForceURL(theURL)
{
	if(isSFClassic())
	{
		// SF Classic
		window.location = theURL;
	}
	else
	{
		// SF Lightning
		sforce.one.navigateToURL(theURL, false);
	}
}

function safeNavigateToSForceURLNewTab(theURL)
{
	if(isSFClassic())
	{
		window.open(theURL);
	}
	else
	{
		safeNavigateToSForceURL(theURL);
	}
}

function safeNavigateToSForceURLForReport(theURL)
{
	var launchAsNewTab = '{!LaunchReportsMenuInNewTab}';
	
	if(launchAsNewTab == 'true')
	{
		window.open(theURL);
	}
	else
	{ 
		safeNavigateToSForceURL(theURL);
	}
}

function safeRedirectToSForceURL(theURL)
{
	if(isSFClassic())
	{
		// SF Classic
		window.location = theURL;
	}
	else
	{
		// SF Lightning
		sforce.one.navigateToURL(theURL, true);
	}
}

function safeRedirectParentToSForceURL(theURL)
{
	if(isSFClassic())
	{
		// SF Classic
		window.top.location = theURL;
	}
	else
	{
		// SF Lightning
		sforce.one.navigateToURL(theURL, true);
	}
}

function safeNavigateToSObject(theObjectId)
{
	if(isSFClassic())
	{
		// SF Classic
		window.location = '/' + theObjectId;
	}
	else
	{
		// SF Lightning
		sforce.one.navigateToSObject(theObjectId);
	}
}

function safeShowSFInlineHover(lookupId, theObjectId)
{
	var lightningURLParam = (isSFClassic() ? '' : '&amp;isdtp=p1'); 
	LookupHoverDetail.getHover(lookupId, '/' + theObjectId + '/m?retURL=%2F' + theObjectId + '&amp;isAjaxRequest=1' + lightningURLParam).show();
}

function safeHideSFInlineHover(lookupId)
{
	LookupHoverDetail.getHover(lookupId).hide();
}

function referenceDataCallbackSuccess(itemsJson)
{
    referenceDataCallbackSuccessReal(itemsJson,this.target);
}
function referenceDataCallbackSuccessReal(itemsJson,kimbletextbox)
{
  	try
  	{
  	referenceDataItemCount--;
	ReferenceDataCache[kimbletextbox.data('Identifier')]=itemsJson;
			
	if(kimbletextbox.next().is('select'))
    {
    	//ignore created already by removing former
    	
    	kimbletextbox.next().remove();
    }
   
		//create select input fill with options from above
		var select=$("<select></select>");
		
		// give the select an ID based on the source textbox
		if(kimbletextbox.attr('id') != undefined)
		{
			select.attr('id',kimbletextbox.attr('id') + '_SELECT');
		}
	    	
	    select.change(function(){
	    	$(this).prev().val(this.options[this.selectedIndex].value);
	    	$(this).prev().change();
	    	});
	    	
	     
    	if(kimbletextbox.is('.HideControl'))
    	{
    		select.attr('class','HideControl');
    	}	
	    kimbletextbox.hide();
	    var curVal=kimbletextbox.val();
			    
			
 			//alert('IncludeDefaultValue? '+ kimbletextbox.attr('class').split(/\s+/)[4]);
			//IncludeDefaultValue
			if (kimbletextbox.attr('class').split(/\s+/)[4]=='true')
			//if(!(kimbletextbox.is('.NotIncludeDefaultValue')))
			{
				select.append($("<option></option>").attr("value","").text("--None--"));   
	    	}
	    	var selectedval='';
	    	$.each(itemsJson, function(key, value)
			{   
				if(curVal==value.Id)
			    {
			    	 select.
			          append($("<option></option>").
			          attr("value",value.Id).attr("selected","selected").text(value.Name)); 
					selectedval=value.Id;
			    }
			    else
			    {
			   		select.
			          append($("<option></option>").
			          attr("value",value.Id).text(value.Name)); 
					/**if (kimbletextbox.attr('class').split(/\s+/)[5] == 'true')
					if(key==0)
					{
						selectedval=value.Id;
						
					}**/
			    }
			});
			
			if (itemsJson.length > 0 &amp;&amp; kimbletextbox.attr('class').split(/\s+/)[4]=='false')
			{
				if(selectedval=='')
				kimbletextbox.val(itemsJson[0].Id);
				else
				kimbletextbox.val(selectedval);
			}
			
			//alert('IsMandatory? '+ kimbletextbox.attr('class').split(/\s+/)[3]);			
			//IsMandatory?
			if (kimbletextbox.attr('class').split(/\s+/)[3]=='true'){ 
			//if((kimbletextbox.is('.IsMandatory'))) {

				var parent = kimbletextbox.parent();
				var kimbletextboxcopy = kimbletextbox.clone(); //clean copy
				
				//we are going to remove all the children. Before we will save kimbletextbox to write it again (between other html elements with more things)			
				//delete all children!
				parent.children().each(function(){
					$(this).remove();
				});

				var firstchild = $("<div></div>").attr("class","requiredInput");
				firstchild.append ( $("<div></div>").attr("class","requiredBlock") );
				//kimbletextboxcopy.after(select);
				firstchild.append (  kimbletextboxcopy );
				
				parent.append(firstchild);
				
				kimbletextboxcopy.after(select);
			} else {
				kimbletextbox.after(select);
			}
			
			
			<!-- if (kimbletextbox.attr('class').split(/\s+/)[5] == 'true')//run onclick events
				if(selectedval!='')
					{
				
						select.change();
						//$('#'+selectname).change();
						//document.getElementById(kimbletextbox.attr('name')+'_SELECT').onchange();
						ToggleAControlsClass('.PeriodRateBandList','false',5);
						kimbletextbox.attr('value',selectedval);// doesn't work explicitly doing this for now
					}
			 -->
			//kimbletextbox.data('root',select);
			
	    	//onselectedchange event set value of input
	    	
	    	
	 }
	 catch(err)
	 {
	 	var vDebug = ""; 
	    for (var prop in err) 
	    {  
	       vDebug += "property: "+ prop+ " value: ["+ err[prop]+ "]\n"; 
	    } 
	    vDebug += "toString(): " + " value: [" + err.toString() + "]"; 
	    alert(vDebug); 
	 }   	
    
}

var referenceDataItemCount=0;

function getReferenceData()
{
	
      if (referenceDataItemCount > 0)
      {
      	//alert('a='+referenceDataItemCount ); 
        return;
      }    
      var kimbledropdowns = $('.kimbledropdown, .kimblecustomlookup,.kimblecustomlookup2');
      
      referenceDataItemCount = kimbledropdowns.length;
		//alert('n'+referenceDataItemCount ); 
        
	
    kimbledropdowns.each(function(){
    	//load ref data items based on this.class
    	var itemsJson;
    	//var aClass = $(this).attr('class').split(' ')[0];
    	//if (aClass == 'kimbledropdown')
    	if ($(this).is('.kimbledropdown'))
    	
    	{
    	
    		GetReferenceDataItems($(this).attr('class').split(/\s+/)[1],$(this));
    	}
    	else if($(this).is('.kimblecustomlookup'))
    	{
    		GetReferenceDataItemsByNameAndFilter($(this).attr('class').split(/\s+/)[1],$(this).attr('class').split(/\s+/)[2],$(this));
    	}
    	else
    	{
    		GetReferenceDataItemsByNameAndTwoFilters($(this).attr('class').split(/\s+/)[1],$(this).attr('class').split(/\s+/)[2],$(this).attr('class').split(/\s+/)[6],$(this));
    	}
    	
    });
}



function ToggleAControlsClass(controlidcls,newvalue,index)
{

	var newclasses='';
	var arr=  $(controlidcls).attr('class').split(/\s+/);
	for(key in arr )
	{
		value=arr[key];
		if(key==index)
			newclasses=newclasses+newvalue+' ';
			else
			newclasses=newclasses+value+' ';
		}
		$(controlidcls).attr('class',newclasses);
}

