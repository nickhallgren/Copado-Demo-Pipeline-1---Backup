kimble.parseJSON = function(j)
{
	try
	{
		return JSON.parse(j.replace(/\\"/g, '"'));
	}
	catch(e)
	{
		return JSON.parse(j);
	}
}

kimble.addDays = function(dte, days) {
	return new Date(dte.getFullYear(), dte.getMonth(), dte.getDate() + days, 0, 0, 0, 0);
	}

kimble.UTCStringFromMilliseconds = function(seconds) {
	var s = new Date(seconds).toISOString();

	return s.substr(s, s.indexOf('T'));
	}


$(window).load(function(){
    
    jQuery.datepicker.setDefaults($.datepicker.regional['']);
	
	// Luxembourgish date locale override
	jQuery.datepicker.regional.lb.dateFormat = "mm/dd/yy";
	// Polish date locale override
	jQuery.datepicker.regional['pl-PL'] = jQuery.extend({}, jQuery.datepicker.regional.pl);
	jQuery.datepicker.regional.pl.dateFormat = "yy-mm-dd";
	// English Hong Kong date locale override
	jQuery.datepicker.regional['en-HK'] = jQuery.extend({}, jQuery.datepicker.regional['']);
	jQuery.datepicker.regional['en-HK'].dateFormat = "dd/mm/yy";
	// Hebrew date locale override
	jQuery.datepicker.regional['iw'] = jQuery.extend({}, jQuery.datepicker.regional['']);
	jQuery.datepicker.regional['iw'].dateFormat = 'dd/mm/yy';
	
	var mappedLocale = kimble.localeMapping[kimble.dateLocale.toLowerCase()];
	
	if (mappedLocale != undefined)
		kimble.dateLocale = mappedLocale;

	if (jQuery.datepicker.regional[kimble.dateLocale] == null)
		kimble.dateLocale = kimble.locale.split('-')[0];
		
	if (jQuery.datepicker.regional[kimble.dateLocale] == null)
		kimble.dateLocale = '';
	
	if (kimble.numberLocaleMapping[kimble.locale.toLowerCase()] != undefined)
	{
		kimble.locale = kimble.numberLocaleMapping[kimble.dateLocale.toLowerCase()];
	}
	
	kimble.regional = jQuery.datepicker.regional[kimble.dateLocale];
	
	kimble.parseId = function (val)
	{
		if (val === null || val === '' || val == undefined) return null;
		
		return val;
	}
	
	kimble.parseNumber = function (val, format)
	{
		if (val === null || val === '' || val == undefined) return null;
		
		return jQuery.parseNumber(val,{format:format, locale:kimble.locale, isFullLocale:false}).valueOf(); 
	}
	
	kimble.formatNumber = function (val, format)
	{
		if (val === null || val === '' || val == undefined) return null;
		
		return jQuery.formatNumber(val, {format: format, locale:kimble.locale, isFullLocale:false});
	}
	
	kimble.parseDate = function (val, asDate)
	{
		if (val == null || val == '') return null;
		
		var dte = jQuery.datepicker.parseDate(kimble.regional.dateFormat, val);
		
		if (asDate) return dte;
		
		return dte.toKimbleUTC();
	}
	
	kimble.formatDate = function (val)
	{	
		if (val == '' || val == null) return '';
		
		return jQuery.datepicker.formatDate(kimble.regional.dateFormat, val.toDate())
	}
	
	kimble.formatDateTime = function (val)
	{	
		if (val == '' || val == null) return '';
		
		// the JqueryUI datepicker only supports date so here we use it to format
		// the date and then append the time to the end (as that has no regional format)
		return jQuery.datepicker.formatDate(kimble.regional.dateFormat, val.toDateDiscardTime()) + ' ' + val.getTimeFromDateTime()
	}		

	kimble.formatDateWithFormat = function (val, format)
	{	
		if (val == '' || val == null) return '';
		
		return jQuery.datepicker.formatDate(format, val.toDate())
	}	

	kimble.formatDates = function (selector)
	{
		var sel = (selector != undefined ? selector : '.kimble-format-date');

		jQuery.each(jQuery(sel), function (i, obj) {
			var $o = jQuery(obj);
			$o.text(kimble.formatDate($o.text())).removeClass(sel.replace(/\./g, ""));
		});
	}
	
	kimble.formatDateTimes = function ()
	{
		jQuery.each(jQuery('.kimble-format-date-time'), function (i, obj) {
			var $o = jQuery(obj);
			$o.text(kimble.formatDateTime($o.text())).removeClass('kimble-format-date-time');
		});
	}
	
	kimble.formatCurrencies = function (selector)
	{
		var sel = (selector != undefined ? selector : '.kimble-format-currency');

		jQuery.each(jQuery(sel), function (i, obj) {
			var $o = jQuery(obj);
			var currencyCode = '';
			
			if ($o.attr("data-currency") != null) currencyCode = $o.attr("data-currency") + ' ';
			
			if ($o.is('input'))
			{
				if ($o.val() != '') $o.val(kimble.formatNumber($o.val(), '#,##0.00'));				
			}
			else
			{
				if ($o.text() != '') $o.text(currencyCode + kimble.formatNumber($o.text(), '#,##0.00'));
			}
			
			$o.removeClass(sel.replace(/\./g, ""));
		});
	}
	
	kimble.replaceNull = function (val, def)
	{
		return (val == null?def:val);
	}
	
	kimble.replaceValue = function (val, nullVal)
	{
		return (val == nullVal || val == null ? null : val);
	}

	kimble.escapeHTML = function (str) {
		var p = document.createElement('p');
		p.appendChild(document.createTextNode(str));
		return p.innerHTML;
	}

	kimble.encodeHTML = function(str) {
		var buf = [];

		for (var i=str.length-1;i>=0;i--) {
		buf.unshift(['&amp;#', str[i].charCodeAt(), ';'].join(''));
		}

		return buf.join('');
	}

	kimble.firstDayIndex = <apex:outputText value="{!FirstDayIndex}"/>;

	jQuery('.format-as-currency-value').each(function(i, obj)
	{
		obj.val(kimble.formatNumber(obj.val(), '#,##0.##'));
	});
	
	//lightning overrides
	if(isSFLightning())
	{
		// ensure same body padding as classic for full width pages
		jQuery('html body').css('padding','10px');
		
		// add missing 'Custom299Tab' class to body to restore VF formatting (SF case 14902423)
		//jQuery('html body').addClass('Custom299Tab');
		
		// prevent menu floating out of shallow pages
		jQuery('#side-bar-container').css('min-height','95vh');
	}

	kimble.initialiseDatePickers = function()
	{
		jQuery('.kimbleDatePicker').datepicker({
			dateFormat: kimble.regional.dateFormat,
			firstDay: kimble.firstDayIndex,
			showOtherMonths: true,
			selectOtherMonths: true,
			changeMonth: true,
			changeYear: true
		});
	}
});								

var currentBoxy = null;
var currentBoxyDropdownsCount=0;
var ReferenceDataCache=new Array();//Cache for reference data already loaded on page

function initialiseModalBoxy(contentSelector, windowTitle, appendToElement)
{
	if (appendToElement != null)
		currentBoxy = new Boxy($(contentSelector),{draggable:true, title:windowTitle, modal: true, closeable: false, appendToElement: appendToElement});
	else
		currentBoxy = new Boxy($(contentSelector),{draggable:true, title:windowTitle, modal: true, closeable: false});

	currentBoxy.getContent().css('visibility','hidden');
}

function initialiseNonModalBoxy(contentSelector, windowTitle, appendToElement)
{
	currentBoxy = new Boxy($(contentSelector),{draggable:true, title:windowTitle, modal: false, closeable: false, appendToElement: appendToElement}); 
	currentBoxy.getContent().css('visibility','hidden');
}

/* STACKED BOXY IMPLEMENTATION - MAYBE THIS SHOULD BE MERGED INTO STANDARD BOXY IMPLEMENTATION*/
var stackedBoxy = [];
function initialiseStackedModalBoxy(contentSelector, windowTitle, appendToElement)
{
	stackedBoxy.push(new Boxy($(contentSelector),{draggable:true, title:windowTitle, modal: true, closeable: false, appendToElement: appendToElement}));

	stackedBoxy[stackedBoxy.length - 1].getContent().css('visibility','hidden');
}

function showStackedModalBoxy()
{
	var topBoxy = stackedBoxy[stackedBoxy.length - 1];
	if (topBoxy != null)
	{
		getReferenceData();
		topBoxy.getContent().css('visibility','visible').hide().fadeIn('6000');
		topBoxy.getContent().find("input:text:visible:first").each(function(){
		try{
		$(this).focus();
		}
		catch(e)
		{
		//error
		}
		});//focus on first visible input box
		topBoxy.center();
	}
}

function hideStackedModalBoxy()
{
	if(stackedBoxy.length > 0)
	{
		var topBoxy = stackedBoxy[stackedBoxy.length - 1];
		topBoxy.hide();
		stackedBoxy.pop();
	}
}


function hideStackedModalBoxyWithErrorCheck(errorSelector)
{
	if($(errorSelector + ' &gt; span')[0].children.length == 0) {
	    hideStackedModalBoxy();
		return true;
	}
	else
	{
	 getReferenceData();
	 return false;
	}
}

