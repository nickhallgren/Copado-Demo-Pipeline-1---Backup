	var silentJobsToRun;
	var silentThreads = 2;

	function loadAndRunSilentJobs(contextId)
	{
		//Enable Silent Jobs setting
		if (contextId == null || contextId == '' || <apex:outputText value="{!!SilentJobsModeEnabled}"/>) return;

		jQuery.ajax({type: "GET",
			url: '{!$Page.JobsPendingInline}?id=' + contextId + '&amp;silent=true',
			async: true,
			dataType: "json",
			success: function (data) {
				silentJobsToRun = data;

				for (var i=0;i&lt;silentThreads;i++){
					if(silentJobsToRun.length != 0){
						setTimeout(function(){ RunAllSilentJobs(); }, (i+1) * 1000);
					}
				}
			}
		});
	}

	function RunAllSilentJobs()
	{
		if (silentJobsToRun.length == 0) return;

		var jobId = silentJobsToRun.shift();

		RunSilentJob(jobId, function(){RunAllSilentJobs()});
	}

	function RunSilentJob(jobId, onSuccessCallback)
	{
		var callback = {onSuccess : onSuccessCallback, target:null, onFailure : function(e){console.log(e);}};
		sforce.apex.execute(KimbleNamespaceWithPeriod + 'JobWebService','RunJob',{jobId:jobId}, callback);
	}

