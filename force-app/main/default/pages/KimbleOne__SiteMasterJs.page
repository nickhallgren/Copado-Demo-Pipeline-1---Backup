	function GetReferenceDataItems(domain,obj)
	{
		if(ReferenceDataCache[domain]!=null)
		{
			referenceDataCallbackSuccessReal(ReferenceDataCache[domain],obj);
			return;
		}
		obj.data('Identifier',domain);
		var callback = {onSuccess : referenceDataCallbackSuccess,target:obj, onFailure : function(e){onError(e)}};
		sforce.apex.execute(KimbleNamespaceWithPeriod + 'ReferenceDataWebService','GetItems',{domain:domain},callback);
	}
	
	function GetReferenceDataItemsByNameAndFilter(name, filter,obj)
	{
		if(ReferenceDataCache[name+':'+filter]!=null)
		{
			referenceDataCallbackSuccessReal(ReferenceDataCache[name+':'+filter],obj);
			return;
		}
		obj.data('Identifier',name+':'+filter);
		var callback = {onSuccess : referenceDataCallbackSuccess,target:obj, onFailure : onError};
		sforce.apex.execute(KimbleNamespaceWithPeriod + 'ReferenceDataWebService',name,{filter:filter},callback);
	}
	function GetReferenceDataItemsByNameAndTwoFilters(name, filter1,filter2,obj)
	{
		if(ReferenceDataCache[name+':'+filter1+'-'+filter2]!=null)
