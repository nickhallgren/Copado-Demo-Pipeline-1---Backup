		var callback = {onSuccess : referenceDataCallbackSuccess,target:obj, onFailure : onError};
		sforce.apex.execute(KimbleNamespaceWithPeriod + 'ReferenceDataWebService',name,{filter1:filter1,filter2:filter2},callback);
