<apex:page standardController="KimbleOne__ProductDomain__c" sidebar="false" extensions="KimbleOne.ProductDomainEditController" >
<!-- ProductDomainEditController  is extended here only to show warnings-->
<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu"> 
            <c:Menu HelpSource="CfgGuide" DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextType="ProductDomain" MenuContextId="{!KimbleOne__ProductDomain__c.Id}" MenuContextName="{!KimbleOne__ProductDomain__c.Name}" /> 
    </apex:define>
    <apex:define name="Content">
    <apex:pageMessages />
        <apex:pageblock title="">
            <apex:pageBlockSection columns="2">
                <apex:outputField value="{!KimbleOne__ProductDomain__c.Name}"/>
                <apex:outputField value="{!KimbleOne__ProductDomain__c.KimbleOne__IsResourced__c}"/>
                <apex:outputField value="{!KimbleOne__ProductDomain__c.KimbleOne__RevenueGenerationModel__c}"/>
                <apex:outputField value="{!KimbleOne__ProductDomain__c.KimbleOne__CostGenerationModel__c}"/>  
                <apex:outputField value="{!KimbleOne__ProductDomain__c.KimbleOne__RevenueRecognitionModel__c}"/>
                <apex:outputField value="{!KimbleOne__ProductDomain__c.KimbleOne__CostRecognitionModel__c}"/>
                <apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__PeriodReceivable__c.LabelPlural}" />
                	<apex:outputText value="{!InvoiceScheduleNarrative}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__PeriodPayable__c.LabelPlural}" />
                	<apex:outputText value="{!SupplierInvoiceScheduleNarrative}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageblock>           
    </apex:define>
</apex:composition>
</apex:page>