<apex:page controller="KimbleOne.Portal_ResourceUploadAttachController">
	<apex:composition template="KimbleOne__Portal_SiteMaster">
		<apex:define name="Content">
			<apex:form enctype="multipart/form-data">
			    <apex:pageMessages escape="false"/>
			    <apex:pageBlock title="{!$Label.kimbleone__portalresourceuploadattachment}">
			 
			      <apex:pageBlockButtons location="bottom">
			        <apex:commandButton action="{!upload}" value="{!$Label.kimbleone__upload}"/>
			      </apex:pageBlockButtons>
			 
			      <apex:pageBlockSection showHeader="false" columns="1" id="block1">
			 		
			 		
			        <apex:pageBlockSectionItem >
			          <apex:outputLabel value="{!$Label.kimbleone__file}" for="file"/>
			          <apex:inputFile value="{!attachment.body}" filename="{!attachment.name}" id="file"/>
			        </apex:pageBlockSectionItem>
			 
			        <apex:pageBlockSectionItem >
			          <apex:outputLabel value="{!$Label.kimbleone__description}" for="description"/>
			          <apex:inputTextarea value="{!attachment.description}" id="description"/>
			        </apex:pageBlockSectionItem>
			 
			      </apex:pageBlockSection>
			 
			    </apex:pageBlock>
  			</apex:form>
		</apex:define>
	</apex:composition>
</apex:page>