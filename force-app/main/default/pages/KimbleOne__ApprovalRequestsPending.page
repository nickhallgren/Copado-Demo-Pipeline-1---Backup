<apex:page controller="KimbleOne.ApprovalRequestsPendingController" extensions="KimbleOne.SecurityController" showHeader="true" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">

	<apex:composition template="KimbleOne__SiteMaster">
	
		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="PendingApprovals.html" MenuContextName="{!$Label.kimbleone__approvalrequestspendingheading}" />
		</apex:define>

		<apex:define name="Content">
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
		
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
		
		<style>
			.charms-card-body {
			    padding-left: 0px !important;
			    padding-top: 20px;
			}
			.cardTileTitle {
			    margin-top: 7px;
			}
			.cardTile {
		        width: 97px;
    			height: 87px;
			}
			.cardTileIcon {
			    font-size: 30px !important;
			    margin-bottom: 4px;
			}
			.cardTileStat {
			    font-size: 20px;
			}
			.cardTileLink {
				display: inline-block;
				cursor: pointer;
			}
			div#approving-user-container {
				position: absolute;
			    right: 10px;
			    top: 39px;
			}
			.approval-mode-toggle-container {
			    font-size: 13px;
			    padding-top: 8px;
			}
			.approval-mode-toggle-container span {
			    cursor: pointer;
			}
			span.approvals-tgl-label {
				max-width: 250px;
				display: inline-block;
				text-overflow: ellipsis;
				white-space: nowrap;
				overflow: hidden;
			}
			span#approvalMode {
			    font-size: 14px;
			    padding-left: 4px;
			    padding-right: 4px;
			}
			.filter-button {
			   	position: absolute;
			    top: 29px;
			    right: 292px;
				font-size: 18px;
				width: 20px;
				text-align: center;
				padding: 6px 10px 6px 10px;
				background-color: white;
				border: 1px solid #ccc;
				border-radius: 2px;
				cursor: pointer;
				margin: 10px 10px 10px 10px;
   			}
			div#FilterPopup {
				position: absolute;
				top: 71px;
			    right: 302px;
				padding: 5px;
				width: 318px;
				height: 163px;
				z-index: 999;
				border-color: #ddd;
				border-style: solid;
				border-width: 0px 1px 1px 1px;
				background-color: #fff;
				box-shadow: rgba(31, 31, 31, 0.16) 4px 3px 8px;
				overflow-y: auto;
			}
			.filter-header {
				font-weight: bold;
				font-size: 14px;
				padding: 10px;
				background-color: #F5F5F5;
				border: 1px solid #DDD;
				border-radius: 4px;
				margin-left: 2px;
				margin-right: 2px;
			}

			i.filter-collapse-btn.fa.fa-angle-double-up {
				color: #BBB;
				cursor: pointer;
				padding-right: 6px;
				position: absolute;
				right: 13px;
				top: 13px;
				font-size: 26px;
			}
   			.filter-button.active {
				text-decoration: none;
				color: white;
				background-color: #1A9EFF;
			}
			.filter-button:not(.active):hover {
				background-color: #f4f6f9;
			}
			input#applyFilterButton {
				margin-top: 10px;
			}
			.cardTileLink.active .cardTile.cardTileInfo {
				background-color: #428bca;
			}
			.cardTileLink.active span.cardTileStat,
			.cardTileLink.active span.cardTileTitle,
			.cardTileLink.active .cardTileIcon.cardIconInfo {
				color: #ecf3f9;
			}
		</style>

        <apex:actionStatus id="ApprovalItemLoadingStatus">
            <apex:facet name="start">
                <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
                    <div id="loadingIndicatorInnerContainer">
                        <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
                    </div>
                </div>
            </apex:facet>
        </apex:actionStatus>
        	
		<apex:outputPanel id="approvalsSummary">

			<apex:outputPanel rendered="{!HasPermission['ManageAllPendingApprovals']}">
			<div id="approving-user-container" >
				<div class="approval-mode-toggle-container" style="">
					<span class="undecorated-link approvals-tgl-label" onclick="unloadBoxy();switchToMyApprovalsOnly();" title="{!JSENCODE($Label.ApprovalRequestActorLabel)}"><apex:outputText value="{!$Label.kimbleone__approvalrequestactorlabel}"/></span>
					<span id="approvalMode" onclick="unloadBoxy();toggleApprovalMode();" class="k-tgl fa"></span>
					<span class="undecorated-link approvals-tgl-label" onclick="unloadBoxy();switchToAllApprovals();" title="{!JSENCODE($Label.All)} {!JSENCODE($Label.ApprovalRequestsPendingHeading)}"><apex:outputText value="{!$Label.kimbleone__all} {!$Label.kimbleone__approvalrequestspendingheading}"/></span>
				</div>
			</div>
			</apex:outputPanel>

			<apex:form id="TheForm">

			<div id="filterContainer">

				<div class= "filter-button" title="{!$Label.Filter}" onclick="jQuery('#FilterPopup').show();"><i class="fa fa-filter"></i></div>

				<div id="FilterPopup" style="display:none;">
					<div class="filter-header">{!$Label.Filter}<i onclick="jQuery('#FilterPopup').hide();" class="filter-collapse-btn fa fa-angle-double-up" title="{!$Label.Close}"></i></div>
					<apex:outputPanel id="FilterPopupPanel">
					<table border="0" cellpadding="0" cellspacing="0" style="font-size: 11px;color: #4a4a56;">

					<apex:outputPanel layout="none" rendered="{!BUGOptions.size > 2}">
						<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!$ObjectType.KimbleOne__BusinessUnitGroup__c.Label}</div>
						<apex:selectList styleClass="filterSelect filterBUG" value="{!filterBUG}" size="1" style="width:80%; margin-left:8px;">
							<apex:actionSupport event="onchange" action="{!getBusinessUnitOptions}" reRender="FilterPopupPanel"/>
							<apex:selectOptions value="{!BUGOptions}"/>
						</apex:selectList>
					</apex:outputPanel>

					<apex:outputPanel layout="none">
						<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!$ObjectType.KimbleOne__BusinessUnit__c.Label}</div>
						<apex:selectList styleClass="filterSelect filterBU" value="{!filterBU}" size="1" style="width:80%; margin-left:8px;">
							<apex:selectOptions value="{!BUOptions}"/>
						</apex:selectList>
					</apex:outputPanel>

					</table>
					</apex:outputPanel>

					<div id="filterInputs" style="padding-left:8px">
						<input class="btn" id="applyFilterButton" onclick="setFilter();" type="Button" value="{!$Label.GoButton}"/>
						<input class="btn" id="clearButtonFilter" onclick="clearFilter();" type="Button" value="{!$Label.ClearAllLabel}"/>
						<label>{!$Label.DefaultViewLabel}</label>
						<input type="checkbox" id="saveAsDefault"/>
					</div>

				</div>
			</div>

			<apex:actionFunction action="{!SelectContextType}" name="changeApprovalContext" rerender="thePendingApprovalsForContext" status="ApprovalItemLoadingStatus">
				<apex:param name="contextType" value="" assignTo="{!SelectedContextType}"/>
			</apex:actionFunction>

			<apex:actionFunction name="switchToMyApprovalsOnly" action="{!ShowOnlyMyApprovals}" rerender="approvalsSummary" status="ApprovalItemLoadingStatus"/>
			<apex:actionFunction name="switchToAllApprovals" action="{!ShowForAllApprovers}" rerender="approvalsSummary" status="ApprovalItemLoadingStatus"/>
			<apex:actionFunction name="reRenderAll" rerender="approvalsSummary"/>

			<apex:actionFunction name="applyFilter" action="{!applyFilters}"/>

			</apex:form>

			<div class="charms-card-body">
				<apex:repeat value="{!TheItemTypes}" var="objectAPIName">
					<apex:outputPanel layout="none" rendered="{!TheApprovalItemsCountMap[objectAPIName] > 0}">
					<div object-api-name="{!JSENCODE(objectAPIName)}" class="cardTileStatLink cardTileLink {!IF(SelectedContextType = objectAPIName, 'active', '')}">
						<div class="cardTile cardTileInfo">
							<span class="cardTileIcon cardIconInfo fa {!JSENCODE(TheApprovalObjectTypeIconMap[objectAPIName])}"></span>
							<span class="cardTileStat"><apex:outputText value="{!TheApprovalItemsCountMap[objectAPIName]}"/></span>
							<span class="cardTileTitle"><apex:outputText value="{!TheApprovalObjectTypeNameMap[objectAPIName]}"/></span>
						</div>
					</div>
					</apex:outputPanel>
				</apex:repeat>
			</div>

   		<script>
   			var allApprovalsMode = {!IF(showAllApprovals,'true','false')};

			jQuery(document).ready(function()
			{
				initialiseApprovalMode();
				initialiseFilter();
			});
			
			function initialiseApprovalMode()
			{
				jQuery('.cardTileLink[object-api-name]').click( function() {changeApprovalContext(jQuery(this).attr('object-api-name'));highlightActive(jQuery(this).attr('object-api-name'))} );
				
				refreshApprovalMode();
			}

			function initialiseFilter()
			{
				if(filterIsActive())
				{
				    jQuery('.filter-button').addClass('active');
				}

				jQuery('.filter-button').css('right', jQuery('#approving-user-container').width() + 5);
   			}

   			function setFilter()
   			{
   			    var isDefault = jQuery('[id$="saveAsDefault"]').prop('checked');

   			    if(isDefault)
   			    {
   			    	var selectedBUG = jQuery('.filterBUG').val();
   			    	var selectedBU = jQuery('.filterBU').val();

					{
					    var theDefault = {BUG: selectedBUG, BU: selectedBU};
					    createCookie('apex__kimble.pendingappsfilterdef',JSON.stringify(theDefault));
     				}
   			    }

   			    applyFilter();
      		}

      		function highlightActive(objectName)
      		{
      		    jQuery('.cardTileLink[object-api-name]').removeClass('active');
      		    jQuery('.cardTileLink[object-api-name="' + objectName + '"]').addClass('active');
        	}

        	function unloadBoxy()
        	{
        	    if(currentBoxy != null)
        	    {
        	        currentBoxy.unload();
             	}
         	}
		
	 		function toggleApprovalMode()
	 		{
				if(allApprovalsMode)
				{
					switchToMyApprovalsOnly();
				}
				else
				{
					switchToAllApprovals();
				}	
			}

			function refreshApprovalMode()
			{
				if(allApprovalsMode)
				{
					jQuery("#approvalMode").removeClass('fa-toggle-off');
					jQuery("#approvalMode").addClass('fa-toggle-on');
				}
				else
				{
					jQuery("#approvalMode").addClass('fa-toggle-off');
					jQuery("#approvalMode").removeClass('fa-toggle-on');
				}
			}

			function clearFilter()
			{
				jQuery('.filterSelect').each(function(ind,item)
				{
				    var defaultValue = jQuery(this).children()[0].value;
				    jQuery(this).val(defaultValue);
    			});
   			}

   			function filterIsActive()
   			{
   			    var filterApplied = false;

   			    jQuery('.filterSelect').each(function(){
					if(this.value != 'All'){filterApplied = true; return false;}
          		});

          		return filterApplied;
      		}
		</script>

			<c:PendingApprovalsForContext id="thePendingApprovalsForContext" ComponentContext="{!SelectedContextType}" ShowAllApprovalsMode="{!ShowAllApprovals}"/>
		
		</apex:outputPanel>
   		
		</apex:define>
	
	</apex:composition>

</apex:page>