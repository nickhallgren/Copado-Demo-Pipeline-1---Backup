<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.WorkItemTemplatesController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>

</apex:define>
	
<apex:define name="Content">
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>

	<style>
		/* loading panel */
		.loadingIndicator {
		   top:0;
		   right:0;
		   width:100%;
		   height:100%;
		   font-weight: bold;
		   position:absolute;
		   text-align:center;
		   /* IE filter */
		   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
		   -moz-opacity:0.7;	/* Mozilla extension */
		   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
		   opacity:0.7; /* CSS3 */
		   z-index:1000;
		   background-color:white;
		   display:none; 
		}
		.loadingIndicator img {
			margin-right:9px;
		}
		#loadingIndicatorInnerContainer { 
			position:absolute; 
			top:50%;
			height:10em; 
			margin-top:-2em;
			width:100%;
		}
		.working {
			cursor: wait !important;
		}
		.auto-save-toggle-container span {
			cursor: pointer;
		}
		.auto-save-toggle-container {
			position: absolute;
			right: 5px;
			top: 0px;
		}		
		/* toolbar styling */
		.toolbar-container {
			position: relative;
			background-color: #f8f8f8;
			padding: 6px;
			margin-bottom: 5px;
			height: 26px;
		}
		.toolbar {
			display: table;
			width: 100%;
		}
		div#toolbar-buttons {
			display: table-cell;
			position: relative;
		}
		a.toolbar-button {
			display: inline-block;
			padding: 6px 10px 6px 10px;
			background-color: white;
			margin-right: 4px;
			border: 1px solid #ccc;
			border-radius: 2px;
		}
		a.toolbar-button.active-toolbar-button {
			color: white;
			background-color: #888;
		}		
		a.toolbar-button:hover {
			text-decoration: none;
			color: white;
			background-color: #1A9EFF;
		}
		a.toolbar-button.button-left {
			border-top-right-radius: 0px;
			border-bottom-right-radius: 0px;
