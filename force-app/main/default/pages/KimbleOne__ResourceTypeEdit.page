								        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ResourceType__c.updateable}">
								        	<li><a href="javascript:editResourceTypeClick();"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__ResourceType__c.Label}</a></li>
