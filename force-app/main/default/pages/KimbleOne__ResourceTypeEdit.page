			<script>
				
				jQuery(window).load(function(){
					
					<apex:outputPanel layout="none" rendered="{!ISBLANK(KimbleOne__ResourceType__c.Id)}">
						editResourceTypeClick();
					</apex:outputPanel>					
					
				});
			
				function editResourceTypeClick()
				{
					initialiseModalBoxy('#ResourceTypePopup', '{!$ObjectType.ResourceType__c.label}', jQuery('form[id$=\'ResourceTypeForm\']'));
					showModalBoxy();

					jQuery.each(jQuery('.temporal-tracker'), function(i, obj) {
						var $o = jQuery(obj);
						$o.parent().children().last().after(jQuery('<span class="fa fa-calendar effective-date"><input type="text" style="width:10px;visibility:hidden"/></span>'));
     				});

					jQuery(document).off('click', '.effective-date');
					jQuery(document).on('click', '.effective-date', function (event) {
						var inp = jQuery(this).find('input');
						//TODO: min date should be earliest open reporting period
						inp.datepicker({dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
																defaultDate: jQuery('[id$="effectiveDate"]').val(),
																//maxDate:0,
																//minDate:jQuery('[id$="startDate"]').val(),
																altField: '[id$="effectiveDate"]',
																showOtherMonths: true,
																selectOtherMonths: true,
																onSelect: function(dateText, inst) {jQuery(this).attr('title', dateText); inp.datepicker('destroy');}
																});

						inp.datepicker('show');
					});

					jQuery(document).off('change', '.temporal-tracker');
					jQuery(document).on('change', '.temporal-tracker', function (event) {

						var spn = jQuery(this).parent().find('.effective-date');

						spn.show();

						spn.click();

					});
						}
				
				</script>
			
