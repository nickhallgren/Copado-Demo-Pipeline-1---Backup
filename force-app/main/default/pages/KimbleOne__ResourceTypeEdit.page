			  							<div class="tool-tip-content">
											<apex:outputText value="{!$ObjectType.KimbleOne__ResourceType__c.Fields.KimbleOne__IsDemand__c.Label}" />														
										</div>
										
			  						</apex:outputPanel>
			  					</apex:outputPanel>
								
								<apex:outputPanel styleclass="title-card-body-field" rendered="{!KimbleOne__ResourceType__c.KimbleOne__IsSupplier__c}">
