			           		<apex:pageMessages escape="false"/>
			           	</div>
           				<apex:pageBlock title="{!$ObjectType.KimbleOne__ResourceType__c.Label}">           				
          					<apex:pageBlockButtons location="bottom">
								<apex:commandButton id="saveResourceTypeBtn" styleClass="DisableButtonWhileBusy" action="{!SaveResourceType}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#ResourceTypeEditErrors');initialiseTooltips();" reRender="ResourceTypeEdit, ResourceTypeContainer"/>
								<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
								
							</apex:pageBlockButtons>
							
							<apex:pageBlockSection title="{!$Label.kimbleone__information}" columns="2" collapsible="false">

								<!-- Resource Type Name -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.Name}" required="true" />
								
								<apex:pageBlockSectionItem >
								<!-- No Suffix -->
								</apex:pageBlockSectionItem>
		
								<!-- Description -->
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__ResourceType__c.Fields.KimbleOne__Description__c.Label}" />
									<apex:outputPanel layout="none">
										<div class="requiredInput">
											<div class="requiredBlock"></div>
											<apex:inputTextarea value="{!KimbleOne__ResourceType__c.KimbleOne__Description__c}" style="width:258px; height:63px" />
										</div>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
								<apex:pageBlockSectionItem >
									<!-- No suffix -->
								</apex:pageBlockSectionItem>
		
								<!-- Resource Class -->
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__ResourceType__c.Fields.KimbleOne__ResourceClass__c.Label}" />
									<apex:outputPanel layout="none">
										<div class="requiredInput">
											<div class="requiredBlock"></div>
											<apex:selectList value="{!KimbleOne__ResourceType__c.KimbleOne__ResourceClass__c}" size="1" style="width:140px">
												<apex:selectOptions value="{!TheResourceClasses}" />
											</apex:selectList>
										</div>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<!-- No suffix -->
								</apex:pageBlockSectionItem>
		
								<!-- Is Assignable -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__IsAssignable__c}" />

								<!-- Is Generic -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__IsGeneric__c}" onchange="RTEPage.isGenericChanged();" styleClass="isGenericField"/>

								<!-- Is Demand -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__IsDemand__c}" onchange="RTEPage.isDemandChanged();"  styleClass="isDemandField"/>

								<!-- Can be used as the basis of a Model Assignment-->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__IsModellable__c}" styleClass="isDemandField"/>

								<!-- Calculate Aggregate Usage -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__CalculateAggregateUsage__c}" styleClass="calcAggregateUsageField"/>
								
								<!-- Has Members -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__HasMembers__c}" onchange="RTEPage.hasMembersChanged();" styleClass="hasMembersField"/>
											
								<!-- Is Supplier -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__IsSupplier__c}" />
											
								<!-- Portal Enabled -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__PortalEnabled__c}" />
								
								<!-- Currency -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.CurrencyIsoCode}" required="true" />
								
								<apex:pageBlockSectionItem >
								<!-- No suffix -->
								</apex:pageBlockSectionItem>
		
								<!-- Maximum Utilisation -->
								<apex:inputField value="{!KimbleOne__ResourceType__c.KimbleOne__MaximumUtilisationPercentage__c}" />
								
								<apex:pageBlockSectionItem >	
								<!-- No suffix -->
								</apex:pageBlockSectionItem>
								
								<!-- ResourceStandardCostCalcMethod -->
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__ResourceType__c.Fields.KimbleOne__ResourceStandardCostCalcMethod__c.Label}" />
									<apex:selectList value="{!KimbleOne__ResourceType__c.KimbleOne__ResourceStandardCostCalcMethod__c}" size="1" style="width:140px" styleClass="{!IF(ISBLANK(KimbleOne__ResourceType__c.Id),'','temporal-tracker')}">
										<apex:selectOptions value="{!TheCostTypes}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>
								
								<!-- ResourceStandardRevenueCalcMethod -->
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__ResourceType__c.Fields.KimbleOne__ResourceStandardRevenueCalcMethod__c.Label}" />
									<apex:selectList value="{!KimbleOne__ResourceType__c.KimbleOne__ResourceStandardRevenueCalcMethod__c}" size="1" style="width:140px"  styleClass="{!IF(ISBLANK(KimbleOne__ResourceType__c.Id),'','temporal-tracker')}">
										<apex:selectOptions value="{!TheRevenueTypes}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>

							</apex:pageBlockSection>
					</apex:pageBlock>
						<div style="display:none"><apex:inputfield id="effectiveDate" value="{!KimbleOne__ResourceType__c.KimbleOne__EarliestCalculationEffectiveDate__c}"/></div>
					</apex:outputPanel>
				</div>
				</apex:actionRegion>
				
				<apex:actionFunction action="{!RecalculateRevenueAndCosts}" name="recalculateRevenueAndCosts">
					
				</apex:actionFunction>
				
			</apex:form>
			
