<apex:page standardController="KimbleOne__ResourceType__c" extensions="KimbleOne.ResourceTypeEditController,KimbleOne.SecurityController" showHeader="true" sidebar="false">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<apex:stylesheet value="{!URLFOR($Page.KimbleOne__GanttViewCss)}"/>
	<apex:composition template="KimbleOne__SiteMaster">
		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="MaintainResource.html" MenuContextId="{!KimbleOne__ResourceType__c.Id}" MenuContextName="{!KimbleOne__ResourceType__c.Name}" BreadCrumbLink="/{!$ObjectType.KimbleOne__ResourceType__c.KeyPrefix}" BreadCrumbName="{!$ObjectType.KimbleOne__ResourceType__c.LabelPlural}"/> 
  
		</apex:define>
		<apex:define name="Content">
			<apex:outputPanel id="ResourceTypeContainer" styleclass="resource-type-container cardContainer" rendered="{!!ISBLANK(KimbleOne__ResourceType__c.Id)}" style="margin-bottom: 150px;">
				<div class="resource-type card">
					<div class="cardHeadingContainer">
						<div style="display:table-row">
							<div class="cardHeadingCell">
								<div class="card-heading-icon fa fa-user" ></div>
								<div class="card-title-container">
									<h3 class="cardTitle"><apex:outputText value="{!KimbleOne__ResourceType__c.Name}"/></h3>
								</div>
							</div>
							<div class="cardProperties cardHeadingCell cardHeadingCellFixed">
								
								<div class="title-card-body-field" style="position:relative;color: #729BC7;">
									
									<apex:outputPanel styleclass="resource-count fa-resource-type-has-members" rendered="{!KimbleOne__ResourceType__c.KimbleOne__HasMembers__c}">
										<apex:outputText value="{!ResourceCount}"/>	
									</apex:outputPanel>
									
									<apex:outputPanel styleclass="resource-count fa-resource-type-specific {!SUBSTITUTE(KimbleOne__ResourceType__c.Name,' ','-')}" rendered="{!!KimbleOne__ResourceType__c.KimbleOne__HasMembers__c}">
										<apex:outputText value="{!ResourceCount}"/>	
									</apex:outputPanel>
									
									<apex:outputPanel styleclass="title-card-body-charm fa fa-group fa-resource-type-has-members" title="{!$ObjectType.KimbleOne__Resource__c.LabelPlural}" rendered="{!KimbleOne__ResourceType__c.KimbleOne__HasMembers__c}"></apex:outputPanel>
									
									<apex:outputPanel styleclass="title-card-body-charm fa fa-user fa-resource-type-specific {!SUBSTITUTE(KimbleOne__ResourceType__c.Name,' ','-')}" title="{!$ObjectType.KimbleOne__Resource__c.LabelPlural}" rendered="{!!KimbleOne__ResourceType__c.KimbleOne__HasMembers__c}"></apex:outputPanel>
																		
								</div>
								
								<apex:outputPanel styleclass="title-card-body-field" rendered="{!KimbleOne__ResourceType__c.KimbleOne__IsDemand__c}">
