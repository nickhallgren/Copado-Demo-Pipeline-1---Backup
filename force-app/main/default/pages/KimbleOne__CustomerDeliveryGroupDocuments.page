<apex:page standardcontroller="KimbleOne__CustomerDeliveryGroup__c" sidebar="false" extensions="KimbleOne.FilesAndAttachmentsController">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="DeliveryEngagements.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__CustomerDeliveryGroup__c.KimbleOne__DeliveryGroup__c}" MenuContextName="{!KimbleOne__CustomerDeliveryGroup__c.DeliveryGroup__r.Name}"/>

</apex:define>
    
<apex:define name="Content">
 	  
	<apex:pageMessages escape="False" />
 
      
	<apex:pageBlock title="{!$Label.kimbleone__deliverygroupreviewdocumentsheader}">

		<apex:pageBlockSection collapsible="false">
  
	   	  	<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
			<apex:relatedList subject="{!KimbleOne__CustomerDeliveryGroup__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>

		</apex:pageBlockSection> 
		<script>
			jQuery(document).ready(function() {
				if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
			});
		</script>
	</apex:pageBlock>
  
</apex:define>

</apex:composition>

</apex:page>