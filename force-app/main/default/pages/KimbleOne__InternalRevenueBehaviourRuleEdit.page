            <script>
                    jQuery(window).load(function()
                    {

                        <apex:outputPanel layout="none" rendered="{!ISBLANK(KimbleOne__InternalRevenueBehaviourRule__c.Id)}">
                            editBehaviourRuleClick('new');
                            defaultDisplaySequence();
                        </apex:outputPanel>

                    });

                    function editBehaviourRuleClick(mode)
                    {
                        if(mode == 'edit')
                        {
                            initialiseModalBoxy('#BehaviourRulePopup', '{!$ObjectType.InternalRevenueBehaviourRule__c.label}', jQuery('form[id$=\'BehaviourRuleForm\']'));
                        }
                        else
                        {
                            initialiseModalBoxy('#BehaviourRulePopupNew', '{!$ObjectType.InternalRevenueBehaviourRule__c.label}', jQuery('form[id$=\'BehaviourRuleFormNew\']'));
                        }
                        showModalBoxy();
                    }

                    function openNext()
                    {
                        if(hideModalBoxyWithErrorCheck('#BehaviourRuleNewErrors') == true)
                        {
                            hideModalBoxyWithErrorCheck('#BehaviourRuleNewErrors');
                            editBehaviourRuleClick('edit');
                            preSetRevenueOptions();
                        }
                    }

                    function defaultDisplaySequence()
                    {
                        var defaultDisplaySequence;
                        //default display sequence based on selected product domain
                        var selectedDomain = jQuery("select[id$='domainSelector']").val();

                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.InternalRevenueBehaviourRuleEditCntrllr.getDefaultSequence}',
                            selectedDomain,
                            function(result,event)
                            {
                                if(event.status)
                                {
                                    defaultDisplaySequence = result;
                                    jQuery("[id$='displaySequence']").val(defaultDisplaySequence);
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                            }
                        );
                    }
                </script>

