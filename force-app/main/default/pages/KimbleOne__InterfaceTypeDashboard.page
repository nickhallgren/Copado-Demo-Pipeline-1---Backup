            function updateInterfaceTypeRow(interfaceTypeId, interfaceStatus) {
                var tr = jQuery('#interface-type-list tr[context-id="' + interfaceTypeId + '"]');

                tr.find('.last-run-date').text(interfaceStatus.LastRunDateTime == null ? '-' : kimble.formatDateTime(interfaceStatus.LastRunDateTime));

                if (interfaceStatus.ImportingPendingCount != null){
                    tr.find('.queued-pending').text(kimble.formatNumber(interfaceStatus.ImportingPendingCount, '#,##0')).toggleClass('highlight', interfaceStatus.ImportingPendingCount > 0).addClass('with-val');
                    tr.find('.preparing-failed').text(kimble.formatNumber(interfaceStatus.ImportingFailedCount, '#,##0')).toggleClass('highlight', interfaceStatus.ImportingFailedCount > 0).addClass('with-val');
                    if (interfaceStatus.ImportingFailedCount > 0) tr.find('.completing-failed').parent().attr('search-term', '{!$Label.Failed}');
                } else {
                    tr.find('.queued-pending').addClass('detail-link').text(kimble.formatNumber(interfaceStatus.PendingCount, '#,##0')).toggleClass('highlight', interfaceStatus.PendingCount > 0).addClass('with-val');
                    tr.find('.preparing-failed').text(kimble.formatNumber(interfaceStatus.FailedGenerationCount, '#,##0')).toggleClass('highlight', interfaceStatus.FailedGenerationCount > 0).addClass('with-val');
                }
                
                if (interfaceStatus.FailedCount > 0) {
                    tr.find('.completing-failed').text(kimble.formatNumber(interfaceStatus.FailedCount, '#,##0')).toggleClass('highlight', interfaceStatus.FailedCount > 0).addClass('with-val');
                    tr.find('.completing-failed').parent().attr('search-term', '{!$Label.Failed}');
                }

                tr.toggleClass('refreshing');
            }

