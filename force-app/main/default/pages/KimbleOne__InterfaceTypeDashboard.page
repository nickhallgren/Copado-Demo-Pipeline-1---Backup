                   }

                   html += '</td>';
                   html += '<td><div class="long-text">' + getFieldValue(r, exportSourceField) + '</div></td>';
                   html += '<td><div class="long-text">' + getFieldValue(r, exportContextIdField) + '</div></td>';
                   html += '<td><div class="long-text"><a href="/' + getFieldValue(r, exportContextIdField) + '">' + result.ObjectNamesMap[getFieldValue(r, exportContextIdField)] + '</a></div></td>';
                   html += '<td><div class="long-text">' + kimble.formatDate(kimble.UTCStringFromMilliseconds(getFieldValue(r, exportCreatedDateField))) + '</div></td>';
                   html += '<td><div class="long-text log-text">' + getFieldValue(r, exportLogField) + '</div></td>';

