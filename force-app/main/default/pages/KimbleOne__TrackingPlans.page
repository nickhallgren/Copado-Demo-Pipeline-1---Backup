		function initialiseHandlebars()
		{
            //register templates
            jQuery.each(jQuery('script[type="text/x-handlebars-template"]:not([partial]'), function (i, s) {
                handlebarsTemplates[s.id] = Handlebars.compile(s.innerHTML);
            });

            //register partials
            jQuery.each(jQuery('script[type="text/x-handlebars-template"][partial="true"]'), function (i, s) {
                Handlebars.registerPartial(s.id, s.innerHTML);
            });

            Handlebars.registerHelper('formatNum', function(numVal){
              return kimble.formatNumber(numVal, "#.##");
            });

            Handlebars.registerHelper('formatUTCDate', function(UTCDate){
              return kimble.formatDate(UTCDate);
            });

            Handlebars.registerHelper('planItemIds', function(planItem){
              return '';
            });

            Handlebars.registerHelper('cTypeHtml', function(dte, ctype, ignoreNBD){
              return getConstraintHtml(dte, ctype, ignoreNBD);
            });

			Handlebars.registerHelper('eq', function(lvalue, rvalue) {
                return lvalue==rvalue;
            });
		}

		function getConstraintHtml(constraintDate, constraintType, ignoreNBD)
		{
			var formattedConstraintDate = (constraintDate != null ? jQuery.datepicker.formatDate(kimble.regional.dateFormat, constraintDate.toDate()) : '');

			var constraintHtml = '';
			var titleText = planItemConstraintIdToNameMap[constraintType];
			var constraintIndClass = 'constraint-ind';

			var calendarIcon = (ignoreNBD ? 'fa-calendar-o' : 'fa-calendar');

			if(planItemConstraintIdToEnumMap[constraintType] == 'AsSoonAsPossible'
				|| planItemConstraintIdToEnumMap[constraintType] == 'AsLateAsPossible')
			{
				constraintIndClass += ' ' + calendarIcon;
			}
			else if(planItemConstraintIdToEnumMap[constraintType] == 'ManuallyScheduled')
			{
				constraintIndClass += ' fa-thumb-tack fixed-constraint';
			}
			else if(planItemConstraintIdToEnumMap[constraintType] == 'MustStartOn'
				|| planItemConstraintIdToEnumMap[constraintType] == 'StartNoEarlierThan'
				|| planItemConstraintIdToEnumMap[constraintType] == 'StartNoLaterThan'
				|| planItemConstraintIdToEnumMap[constraintType] == 'MustFinishOn'
				|| planItemConstraintIdToEnumMap[constraintType] == 'FinishNoEarlierThan'
				|| planItemConstraintIdToEnumMap[constraintType] == 'FinishNoLaterThan')
			{
				titleText += ': ' + formattedConstraintDate;
				constraintIndClass += ' ' + calendarIcon + ' fixed-constraint';
			}

			if(ignoreNBD) titleText += ' (' + kimble.labels['ignore-nbd'] + ')';

			constraintHtml += '<i class="fa ' + constraintIndClass + '" title="' + titleText + ' "></i>';

			return constraintHtml;
		}

		function buildExternalDependencyQtipHtml(theIndicator)
		{
			var html = '<div class="external-dep-details-container">';

			html += '<table class="list external-dep-list">';
			html += '<thead>';

			html += '<th>' + l['DeliveryElement'] + '</th>';
			html += '<th>' + l['ItemName'] + '</th>';
			html += '<th>' + l['PlanItemType'] + '</th>';
			html += '<th>' + l['StartDate'] + '</th>';
			html += '<th>' + l['EndDate'] + '</th>';

			html += '</thead>';
			html += '<tbody>';

			var depKey = theIndicator.attr('ind-pos');

			var thisItemDeps = thePlans.ExternalPlanItemDs[depKey];

			if(thisItemDeps != null)
			{
				for(var j = 0; j < thisItemDeps.length; j++)
				{
					var externalPlanItem = thisItemDeps[j];

					html += '<tr>';

					html += '<td>' + externalPlanItem.ExtElementName + '</td>';
					var jumpToPlanLink = "javascript:jumpToPlan('" + externalPlanItem.ExtTpId + "');";
					html += '<td><a class="jump-to-plan undecorated-link" href="' + jumpToPlanLink + '">' + externalPlanItem.ExtItmName + '</a></td>';
					html += '<td>' + externalPlanItem.ExtItmType + '</td>';
					html += '<td>' + kimble.formatDate(externalPlanItem.ExtSDUTC) + '</td>';
					html += '<td>' + kimble.formatDate(externalPlanItem.ExtEDUTC) + '</td>';

					html += '</tr>';
				}
			}

			html += '</tbody>';
			html += '</table>';
			html += '</div>';

			return html;
		}

