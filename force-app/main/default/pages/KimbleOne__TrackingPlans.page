        function setCookie()
        {
            // cookie: IsCollapsed; Plan Summaries filter; Summary Tasks filter; Tasks filter; Milestones filter; External Dependencies filter
            
            var planSumFltr = jQuery('#show-smry-bar').prop('checked');
            var sumTasksFltr = jQuery('#show-smry').prop('checked');
            var tasksFltr = jQuery('#show-tasks').prop('checked');
            var msFltr = jQuery('#show-ms').prop('checked');
            var extDependenciesFltr = jQuery('#show-ext').prop('checked');
            
            var cookie = isCollapsed + ';' + planSumFltr + ';'  + sumTasksFltr + ';'  + tasksFltr + ';'  + msFltr + ';'  + extDependenciesFltr;
   		    createCookie('kimble.trackingplanfilterpreferences', cookie);
        }
        
        function applyCookie()
        {
            // cookie: IsCollapsed; Plan Summaries filter; Summary Tasks filter; Tasks filter; Milestones filter; External Dependencies filter
            var theCookie = readCookie('kimble.trackingplanfilterpreferences');
            
            if(theCookie != null)
            {
				theCookie = theCookie.split(';');
				
				// IsCollapsed
				if(theCookie[0] == "true") collapseAll();
				
				// Plan Summaries filter
				if(theCookie[1] == "false") jQuery('#show-smry-bar').prop('checked', false);
				
				// Summary Tasks filter
				if(theCookie[2] == "false") jQuery('#show-smry').prop('checked', false);
				
				// Tasks filter
				if(theCookie[3] == "false") jQuery('#show-tasks').prop('checked', false);
				
				// Milestones filter
				if(theCookie[4] == "false") jQuery('#show-ms').prop('checked', false);
				
				// External Dependencies filter
				if(theCookie[5] == "false") jQuery('#show-ext').prop('checked', false);
				
				applyPlansFilter();
            }
        }
        
        function zoomIn()
        {
            var val = jQuery( "#zoom-slider" ).slider('value');
            if(val < 28)
            {
				val = Math.min(val + 2, 28);
				jQuery( "#zoom-slider" ).slider('value', val);
				zoomTo(val);
            }
        }
        
        function zoomOut()
        {
            var val = jQuery( "#zoom-slider" ).slider('value');
            if(val > 1)
            {
				val = Math.max(val - 2, 1);
				jQuery( "#zoom-slider" ).slider('value', val);
				zoomTo(val);
            }
        }
        
        function selectAllCheckboxes()
        {
            var allSelected = true;
            jQuery.each(jQuery('.filter-row input[type="checkbox"]'), function (i, s) {
                if(!jQuery(this).prop('checked'))
                {
    	    		jQuery('.filter-row input[type="checkbox"]').prop('checked', true);
    	    		allSelected = false;
                    return false;
                }
            });
            
			if(allSelected) jQuery('.filter-row input[type="checkbox"]').prop('checked', false);
        }
        
	</script>

