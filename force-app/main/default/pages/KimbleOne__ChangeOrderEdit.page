<apex:page standardController="KimbleOne__ChangeOrder__c" extensions="KimbleOne.ChangeOrderEditController" showHeader="true" sidebar="false">
<apex:composition template="KimbleOne__SiteMaster">

	<apex:define name="Menu">
		<c:Menu DefaultHelpPage="ChangeManagement.html" MenuContextType="{!IF(KimbleOne__ChangeOrder__c.ChangeOrderBehaviourRule__r.KimbleOne__ProposalAcceptanceType__c = 'OpportunityClose', 'Proposal', 'ChangeOrder')}"  MenuContextId="{!IF(KimbleOne__ChangeOrder__c.ChangeOrderBehaviourRule__r.KimbleOne__ProposalAcceptanceType__c = 'OpportunityClose', KimbleOne__ChangeOrder__c.KimbleOne__Proposal__c, KimbleOne__ChangeOrder__c.Id)}" MenuContextName="{!IF(KimbleOne__ChangeOrder__c.ChangeOrderBehaviourRule__r.KimbleOne__ProposalAcceptanceType__c = 'OpportunityClose', KimbleOne__ChangeOrder__c.Name, KimbleOne__ChangeOrder__c.Name)}"/>
	</apex:define>
	
	<apex:define name="Content">
		<apex:form id="ChangeOrderForm">
			<apex:pageMessages escape="false"/>
			
			<apex:pageBlock title="{!$ObjectType.KimbleOne__ChangeOrder__c.Label}">
				<apex:pageblockSection collapsible="false" showheader="false" columns="2">
				
					<apex:inputField value="{!KimbleOne__ChangeOrder__c.Name}" rendered="{!CanEdit}"/>
					<apex:outputField value="{!KimbleOne__ChangeOrder__c.Name}" rendered="{!!CanEdit}"/>
					
					<apex:outputField value="{!KimbleOne__ChangeOrder__c.KimbleOne__Status__c}"/>
					
					<apex:inputField value="{!Proposal.KimbleOne__AcceptanceDate__c}" styleClass="kimbleDatePicker" rendered="{!CanEditAcceptanceDate}"/>
					<apex:pageBlockSectionItem rendered="{!CanEditAcceptanceDate}"/>
					
					<apex:repeat value="{!$ObjectType.KimbleOne__ChangeOrder__c.FieldSets.KimbleOne__ChangeOrderDetails}" var="field">
						<apex:inputField value="{!KimbleOne__ChangeOrder__c[field]}" rendered="{!CanEdit && !CONTAINS(field.FieldPath,'.')}" styleClass="{!IF(AND($ObjectType.KimbleOne__ChangeOrder__c.Fields[field].type == 'date',$ObjectType.KimbleOne__ChangeOrder__c.Fields[field].updateable),'kimbleDatePicker','')}"/>
						<apex:outputField value="{!KimbleOne__ChangeOrder__c[field]}" rendered="{!!CanEdit || CONTAINS(field.FieldPath,'.')}"/>
					</apex:repeat>
					
				</apex:pageblockSection>
				
				<apex:pageBlockButtons location="bottom">
	           		<apex:commandButton action="{!SaveAndRedirect}" value="{!$Label.kimbleone__save}"/>
	           		<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}"/>
	            </apex:pageBlockButtons>

			</apex:pageBlock>
			
		</apex:form>
		<script>

		jQuery(window).load(function()
		{
			initialiseItems();
		});
		function initialiseItems()
		{
		    SetupDatePicker();
  		}
		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}
		</script>
	</apex:define>

</apex:composition>
</apex:page>