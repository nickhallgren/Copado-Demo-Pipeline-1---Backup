<apex:page standardController="KimbleOne__InterfaceType__c" extensions="KimbleOne.OutboundInterfaceTypeEditController" showHeader="true" sidebar="false" standardStylesheets="true">
	<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
        <c:Menu id="menuPageTitle" MenuContextName="{!pageTitle}"/>
    </apex:define>
        <apex:define name="Content">
        <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>   		
    	<apex:form id="InterfaceTypeForm">
		<div id="NewInterfaceTypeErrors">
           	<apex:pageMessages />
       	</div>
       	<apex:outputPanel id="newInterfaceTypePanel" layout="none">
   		<apex:pageBlock rendered="{!ISBLANK(TheDbInterfaceType.Name)}"> 		
    		<apex:pageBlockButtons location="bottom" style="align:left">
	            <apex:commandButton id="saveInterfaceTypeBtn"                    	 
	            	action="{!SaveInterfaceType}" 
	            	value="{!$Label.kimbleone__next}" 
	            	disabled="{!($ObjectType.KimbleOne__InterfaceType__c.updateable && $ObjectType.KimbleOne__InterfaceType__c.createable) = false}"/>               
	            <apex:commandButton id="cancelInterfaceTypeBtn"                    	 
	            	action="{!Cancel}" 
	            	value="{!$Label.kimbleone__cancel}"/>
		    </apex:pageBlockButtons> 
    		<apex:pageBlockSection columns="1" collapsible="false">
    			<apex:pageBlockSectionItem >
		    		<!-- new interface type panel starts here -->
			    	<apex:outputText value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.Name.Label}" />
			    	<apex:inputText id="inputInterfaceTypeName" value="{!TheDbInterfaceType.Name}" required="true" />
                 </apex:pageBlockSectionItem>
                 <apex:pageBlockSectionItem >
                 	<apex:outputText value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__BatchSize__c.Label}" />
                 	<apex:inputText id="inputInterfaceTypeRecordBatch" value="{!TheDbInterfaceType.KimbleOne__BatchSize__c}"/>
                 </apex:pageBlockSectionItem>
                 <apex:pageBlockSectionItem >
                 	<apex:outputText value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__AllowUserGeneratedOutput__c.Label}" />
                 	<apex:inputCheckbox id="inputInterfaceTypeRecordAllowUserGeneratedOutput" value="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}">
						<apex:actionSupport event="onclick" rerender="newInterfaceTypePanel"/>
                 	</apex:inputCheckbox>
                 </apex:pageBlockSectionItem>
                 <!-- only required if AllowUserGeneratedOutput is true --> 
                 <apex:pageBlockSectionItem rendered="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}">
                 	<apex:outputText value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__ObjectType__c.Label}" />
                 	<apex:inputText id="inputInterfaceTypeObjectType" value="{!TheDbInterfaceType.KimbleOne__ObjectType__c}"/>
                 </apex:pageBlockSectionItem>
                 <!-- new interface type panel ends here -->
		    </apex:pageBlockSection>
		</apex:pageBlock>
		</apex:outputPanel>
    	
    	<!-- <apex:outputPanel id="InterfaceTypeContainer" styleClass="card variable-width min-horizontal-padding" layout="block">-->
    	<apex:outputPanel rendered="{!!ISBLANK(TheDbInterfaceType.Id)}">
    		<!-- edit interface type panel starts here -->
    		
    		<div class="card variable-width min-horizontal-padding">
    			<div class="cardHeading">
 					<h3 class="cardTitle"><span>Outbound </span><apex:outputText value="{!$Label.kimbleone__typelabel} : {!TheDbInterfaceType.Name}"/></h3>
 					<div data-floating-dropdown="#{!TheDbInterfaceType.Id}-menu1-data" class="fa fa-bars burger-menu"></div>
	                <div class="deleting Loading" style="display:none"></div>
	                <div id="{!TheDbInterfaceType.Id}-menu1-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
	                    <ul class="floating-dropdown-menu">
	                    	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.updateable}">
			                	<li><a href="{!$Page.InterfaceMapHome}?InterfaceTypeid={!JSINHTMLENCODE(TheDbInterfaceType.Id)}"><i class="fa fa-plus-square dropdown-icon"></i>{!$Label.New} {!$ObjectType.InterfaceMap__c.Label}</a></li>
			                </apex:outputPanel>
	                    	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.updateable}">
	                    		<li><a href="javascript:newInterfaceSourceClick('{!JSENCODE(TheDbInterfaceType.Id)}');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.InterfaceSource__c.Label}</a></li>
	                        </apex:outputPanel>
	                        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.updateable}">
	                            <li><a href="javascript:editInterfaceTypeClick('{!JSINHTMLENCODE(TheDbInterfaceType.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__InterfaceType__c.Label}</a></li>
	                        </apex:outputPanel>
	                        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.deletable}">   
	                            <li><a href="javascript:deleteInterfaceTypeClick('{!JSINHTMLENCODE(TheDbInterfaceType.Id)}');"><i class="fa fa-trash dropdown-icon"></i>{!$Label.DeleteButton} {!$ObjectType.KimbleOne__InterfaceType__c.Label}</a></li>
	                        </apex:outputPanel>
	                        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.createable}">  
	                            <li><a href="{!$Page.InterfaceMapEdit}?id={!JSINHTMLENCODE(TheDbInterfaceType.Id)}"><i class="fa fa-download dropdown-icon"></i>{!$Label.ExportLabel} {!$ObjectType.KimbleOne__InterfaceType__c.Label}</a></li>
							</apex:outputPanel>
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceType__c.createable}">  
	                            <li><a href="{!$Page.InterfaceTypeEdit}?Id={!JSINHTMLENCODE(TheDbInterfaceType.Id)}"><i class="fa fa-check dropdown-icon"></i><span>{!$Label.Validate}</span> {!$ObjectType.KimbleOne__InterfaceType__c.Label}</a></li>
							</apex:outputPanel>
	                     </ul>
	                </div>
	            </div>
	            <div class="cardBody">
					<apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__BatchSize__c.Label}" rendered="{!!ISBLANK(TheDbInterfaceType.KimbleOne__BatchSize__c)}" />
                   	<span class="card-field-value"><apex:outputText value="{!TheDbInterfaceType.KimbleOne__BatchSize__c}" rendered="{!!ISBLANK(TheDbInterfaceType.KimbleOne__BatchSize__c)}"/></span>
                   	<span>&nbsp;</span>                   	
					<apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__AllowUserGeneratedOutput__c.Label}" rendered="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}" />
                   	<span class="card-field-value"><apex:outputField value="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}" label="" rendered="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}"/></span>
                   	<span>&nbsp;</span>                   	
                    <!-- only required if the AllowUserGeneratedOutput is true--> 
                    <apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.KimbleOne__ObjectType__c.Label}" rendered="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}"/>
                    <span class="card-field-value"><apex:outputText value="{!TheDbInterfaceType.KimbleOne__ObjectType__c}" rendered="{!TheDbInterfaceType.KimbleOne__AllowUserGeneratedOutput__c}"/></span>
                    <span>&nbsp;</span>
                    <apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields.LastModifiedDate.Label}" />
                    <span class="card-field-value">
                    	<apex:outputText value=" {0,date,EEE MMM d, yyyy}">
    						<apex:param value="{!KimbleOne__InterfaceType__c.LastModifiedDate}"/>
						</apex:outputText>
					</span>
					<span>&nbsp;</span>
					<apex:repeat value="{!$ObjectType.KimbleOne__InterfaceType__c.FieldSets.KimbleOne__InterfaceTypeCustomFields}" var="f" >
						<apex:outputPanel layout="none" rendered="{!KimbleOne__InterfaceType__c[f] != null}">
							<apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceType__c.Fields[f].Label}" />
		     				<apex:outputText value="{!KimbleOne__InterfaceType__c[f]}"/>
		     			</apex:outputPanel>
	   				</apex:repeat>
		 		</div>
		 		<div class="cardBody">
	    			<apex:outputPanel id="MapsContainer" layout="block">
	    				<div class="inner-card">		
		    				<div class="cardHeading">
    							<h4 class="cardTitle"><apex:outputText value="{!$ObjectType.KimbleOne__InterfaceMap__c.labelPlural}"/></h4>							
                            </div>
                            <div class="inner-card-body">                          						
				        		<table class="inner-card">
				        			<tr>
					        			<th></th>
					        			<th><span class="card-field-label">{!$ObjectType.InterfaceMap__c.Fields.Name.Label}</span></th>
					        			<th><span class="card-field-label">{!$ObjectType.InterfaceMap__c.Fields.FieldDelimiter__c.Label}</span></th>
					        			<th><span class="card-field-label">{!$ObjectType.InterfaceMap__c.Fields.GroupByFields__c.Label}</span></th>
					        			<th><span class="card-field-label">{!$ObjectType.InterfaceMap__c.Fields.MapFormat__c.Label}</span></th>
					        			<th><span class="card-field-label">{!$ObjectType.InterfaceMap__c.Fields.RecordBatchSize__c.Label}</span></th>
					        		</tr>
		    						<apex:repeat value="{!maps}" var="map">
				        				<tr>
					        				<apex:outputPanel rendered="{!$ObjectType.KimbleOne__InterfaceMap__c.updateable}" StyleClass="card-table-row1">
					                        	<td class="inner-card-table"><a class="fa fa-pencil-square-o" style="padding-right: 4px;padding-left: 12px; cursor:pointer; text-decoration-line:none;" href="{!$Page.InterfaceMapHome}?Id={!JSINHTMLENCODE(map.Id)}"></a></td>
					                       	</apex:outputPanel>
					        				<td class="inner-card-table"><apex:outputField value="{!map.Name}"/></td>
											<td class="inner-card-table"><apex:outputField value="{!map.KimbleOne__FieldDelimiter__c}"/></td>
											<td class="inner-card-table"><apex:outputField value="{!map.KimbleOne__GroupByFields__c}"/></td>
					        				<td class="inner-card-table"><apex:outputField value="{!map.KimbleOne__MapFormat__c}"/></td>
					        				<td class="inner-card-table"><apex:outputField value="{!map.KimbleOne__RecordBatchSize__c}"/></td>
					        			</tr>
				        			</apex:repeat>
				        		</table>
				        	</div>
				        </div>		
			    	</apex:outputPanel>
			    </div>
	            <div class="cardBody">
	    			<apex:outputPanel id="SourcesContainer" layout="block">
	    				<!-- loop thru each Interface Type Source and create a card -->
	    				<apex:repeat value="{!Sources}" var="src">    				
	    					<div class="inner-card">    					
	    						<div class="cardHeading">
	    							<h4 class="cardTitle"><apex:outputText value="{!$Label.kimbleone__source} : {!src.Name}"/></h4>							
	                                <div data-floating-dropdown="#{!src.Id}-menu2-data" class="fa fa-bars burger-menu"></div>
	                                <div class="deleting Loading" style="display:none"></div>
	                                <div id="{!src.Id}-menu2-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
	                                    <ul class="floating-dropdown-menu">
                                            <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InterfaceSource__c.createable}">
					                    		<li><a href="javascript:newInterfaceScopeClick('{!JSINHTMLENCODE(src.Id)}');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__InterfaceScope__c.Label}</a></li>
					                    	</apex:outputPanel>
					                    	<apex:outputPanel rendered="{!$ObjectType.KimbleOne__ResultField__c.createable}">
				                            	<li><a href="javascript:newResultFieldClick('{!JSINHTMLENCODE(src.Id)}');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.ResultField__c.Label}</a></li>
				                            </apex:outputPanel>
				                            <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__SearchCriterion__c.createable}">
			                                	<li><a href="javascript:newSearchCriteriaClick('{!JSINHTMLENCODE(src.Id)}');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.SearchCriterion__c.Label}</a></li>
			                                </apex:outputPanel>
			                                <apex:outputPanel rendered="{!$ObjectType.KimbleOne__InterfaceSource__c.createable}">
                                            	<li><a href="javascript:editInterfaceSourceClick('{!JSINHTMLENCODE(src.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.InterfaceSource__c.Label}</a></li>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!$ObjectType.KimbleOne__InterfaceSource__c.deletable}">
                                            	<li><a href="javascript:deleteInterfaceSourceClick('{!JSINHTMLENCODE(src.Id)}');"><i class="fa fa-trash dropdown-icon"></i>{!$Label.DeleteButton} {!$ObjectType.InterfaceSource__c.Label}</a></li>
                                            </apex:outputPanel>
	                                     </ul>
	                                </div>
	                            </div>
	                            <div class="inner-card-body">
	                            	<div>&nbsp;</div>
	                            	<!-- is this nessesary -->
	                            	<apex:outputPanel styleClass="card-detail" rendered="{!!ISBLANK(src.ObjectType)}" style="margin:20px;">
										<apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__ExportObject__c.Label}" />
	                                	<span class="card-field-value" id="srcExportObject"><apex:outputText value="{!src.ObjectType}"/></span>
									</apex:outputPanel>
									<apex:outputPanel styleClass="card-detail" rendered="{!!ISBLANK(src.ObjectType)}" style="margin:20px;">
										<apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__IsSingleOIR__c.Label}" />
	                                	<span class="card-field-value" id="srcIsSingleOIR"><apex:outputText value="{!src.IsSingleOIR}"/></span>
									</apex:outputPanel>									
					        		<table class="inner-card">
					        			<tr>
					        				<td colspan="5"><apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__InterfaceScope__c.Label}" /></td>
					        			</tr>
					        			<tr>
						        			<th></th>
						        			<th></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__ExportObject__c.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__InterfaceSource__c.Fields.KimbleOne__InterfaceScope__c.Label} <span>Path</span></span></th>
						        			<th><span class="card-field-label">Criteria</span></th>
						        			<!-- var required due to scope not being an object -->
						        		</tr>
					        			<apex:variable value="{!0}" var="scopeItemCounter"/>
					        			<apex:repeat value="{!src.ScopeLst}" var="interfaceScope">
					        				<tr>
						        				<apex:outputPanel rendered="{!$ObjectType.KimbleOne__InterfaceSource__c.updateable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-pencil-square-o" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:editInterfaceScopeClick('{!scopeItemCounter}','{!JSENCODE(src.Id)}')"></span></td>
						                       	</apex:outputPanel>
						                       	<apex:outputPanel rendered="{!$ObjectType.KimbleOne__InterfaceSource__c.deletable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-trash" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:deleteInterfaceScopeClick('{!scopeItemCounter}','{!JSENCODE(src.Id)}')"></span></td>
						                        </apex:outputPanel>
						        				<td class="inner-card-table"><apex:outputText value="{!interfaceScope.ExportObject}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!interfaceScope.ScopePath}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!interfaceScope.Criteria}" styleClass="ellipsis"/></td>						        				
						        				<apex:variable value="{!scopeItemCounter+1}" var="scopeItemCounter"/>
						        			</tr>
					        			</apex:repeat>
					        		</table>
					        		<table class="inner-card">
					        			<tr>
					        				<td colspan="5"><apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__ResultField__c.labelPlural}" /></td>
					        			</tr>
					        			<tr>
						        			<th></th>
						        			<th></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__ResultField__c.Fields.Name.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__ResultField__c.Fields.KimbleOne__FieldName__c.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__ResultField__c.Fields.KimbleOne__DisplaySequence__c.Label}</span></th>
						        			<!-- var required due to scope not being an object -->
						        		</tr>
					        			<apex:repeat value="{!src.ResultFields}" var="resultField">
					        				<tr>
						        				<apex:outputPanel rendered="{!$ObjectType.KimbleOne__ResultField__c.updateable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-pencil-square-o" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:editResultFieldClick('{!JSENCODE(resultField.Id)}')"></span></td>
						                       	</apex:outputPanel>
						                       	<apex:outputPanel rendered="{!$ObjectType.KimbleOne__ResultField__c.deletable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-trash" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:deleteResultFieldClick('{!JSENCODE(resultField.Id)}')"></span></td>
						                        </apex:outputPanel>
						        				<td class="inner-card-table"><apex:outputText value="{!resultField.Name}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!resultField.FieldName}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!resultField.Sequence}"/></td>
						        			</tr>
					        			</apex:repeat>
					        		</table>
					        		<apex:outputPanel id="srchCritPanel">
					        		<table class="inner-card">
					        			<tr>
					        				<td colspan="5"><apex:outputLabel styleClass="card-field-label" value="{!$ObjectType.KimbleOne__SearchCriterion__c.labelPlural}" /></td>
					        			</tr>
					        			<tr>
						        			<th></th>
						        			<th></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__SearchCriterion__c.Fields.Name.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__SearchCriterion__c.Fields.KimbleOne__DataSource__c.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__SearchCriterion__c.Fields.KimbleOne__DisplaySequence__c.Label}</span></th>
						        			<th><span class="card-field-label">{!$ObjectType.KimbleOne__SearchCriterion__c.Fields.KimbleOne__FieldName__c.Label}</span></th>						        			
						        			<!-- var required due to scope not being an object -->
						        		</tr>
					        			<apex:repeat value="{!src.SearchCriteriaLst}" var="searchCriteria">
					        				<tr>
						        				<apex:outputPanel id="srchCritEditPanel" rendered="{!$ObjectType.KimbleOne__SearchCriterion__c.updateable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-pencil-square-o" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:editSearchCriteriaClick('{!JSENCODE(searchCriteria.Id)}')"></span></td>
						                       	</apex:outputPanel>
						                       	<apex:outputPanel id="srchCritDeletePanel" rendered="{!$ObjectType.KimbleOne__SearchCriterion__c.deletable}" StyleClass="card-table-row1">
						                        	<td class="inner-card-table"><span class="fa fa-trash" style="padding-right: 4px;padding-left: 12px; cursor:pointer;" onclick="javascript:deleteSearchCriteriaClick('{!JSENCODE(searchCriteria.Id)}')"></span></td>
						                        </apex:outputPanel>
						        				<td class="inner-card-table"><apex:outputText value="{!searchCriteria.Name}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!searchCriteria.DataSource}" styleClass="ellipsis"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!searchCriteria.Sequence}"/></td>
						        				<td class="inner-card-table"><apex:outputText value="{!searchCriteria.FieldName}"/></td>						        				
						        			</tr>
					        			</apex:repeat>
					        		</table>
					        		</apex:outputPanel>					        						
	    						</div>    					
	    					</div>    				
	    				</apex:repeat>
	    			</apex:outputPanel>
    			</div>
    		</div>    			    		
    	</apex:outputPanel>
    	<!-- </apex:outputPanel>-->
    </apex:form>
     
    <!-- FIELD SELECTOR COMPONENT, to build field selector drop down in Modal pop-ups -->
    <c:JQueryFieldSelectorAddIn />
    
    <style>

	.ellipsis {
	        display: inline-block;
	        white-space: nowrap;
	        overflow: hidden;
	        text-overflow: ellipsis;
	        -o-text-overflow: ellipsis;
	        width: 370px;
	    }
	    
	 .ellipsis:hover {
		    text-overflow: clip;
		    white-space: normal;
		    word-break: break-all;
	    }
    
    </style>
    <script>
       
        jQuery(window).load(function()
        {
            //covert breadcrumb into link back to type list page.
            jQuery('.breadcrumb-item-link').wrap('<a href="/' + getQueryVariable('id').slice(0,3)+'" />');
            
            initialiseTooltips();            
        });

        function initialiseTooltips() 
        {
            jQuery('.title-card-body-charm').each(function() {
                jQuery(this).qtip({
                    content:{
                        text:jQuery(this).children('.tool-tip-content'),
                        title:jQuery(this).attr('title'),
                        button: 'Close'
                    },
                    position: {
                        adjust: {
                            method: 'flip flip'
                        },
                        viewport: $(window)
                    },
                    show: {
                        event: 'click',
                        solo: true
                    },
                    hide: {event: 'unfocus'},
                    style: {classes: 'qtip-light qtip-shadow qtip-rounded'}})
            });     
        }   
        
        function enableFieldSelector(fld,obj)
        {
        	var parent = obj;
        		
        	var ctrl = jQuery('[id$='+fld+']');
        	ctrl.fieldSelector({ rootObject : parent}); 
        }
        
         
        <!-- Type CRUD JS funtions -->
        
        function editInterfaceTypeClick(typeId)
        {
            initialiseModalBoxy('#InterfaceTypeEditPopup', '{!JSENCODE($Label.Edit)}  {!$ObjectType.InterfaceType__c.label}', jQuery('form[id$=\'InterfaceTypeEditForm\']'));
            editInterfaceType();
        }
        
        function deleteInterfaceTypeClick(typeId)
        {
            var answer = confirm("Delete Record?")
            if (answer){
               deleteInterfaceType(typeId);
            }
            else{
               return false;
            }
            
        }
        
        //Source CRUD JS funtions
                
        function newInterfaceSourceClick(interfaceTypeId)
        {
            initialiseModalBoxy('#InterfaceSourceEditPopup', '{!JSENCODE($Label.New)}  {!$ObjectType.InterfaceSource__c.label}', jQuery('form[id$=\'InterfaceSourceEditForm\']'));
            newInterfaceSource(interfaceTypeId);
        }
        
        function editInterfaceSourceClick(srcId)
        {
            initialiseModalBoxy('#InterfaceSourceEditPopup', '{!JSENCODE($Label.Edit)}  {!$ObjectType.InterfaceSource__c.label}', jQuery('form[id$=\'InterfaceSourceEditForm\']'));
            editInterfaceSource(srcId);
        }
        
         function deleteInterfaceSourceClick(interfaceScopeId, srcId)
        {
            var answer = confirm("Delete Record?")
            if (answer){
               deleteInterfaceSource(interfaceScopeId, srcId);
            }
            else{
