	<apex:variable value="{!KimbleOne__Resource__c.ResourceType__r.KimbleOne__ResourceClass__c}" var="resourceClass"/>
	
	<apex:form >
		<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialiseTips();"/>
	</apex:form>
	
	<script>
		var defaultNumericRating = <apex:outputText value="{!DefaultNumericRating}"/>;
		var numericRatingOptions;

		var capabilityExpiryWarningMonths = <apex:outputText value="{!CapabilityExpiryWarningMonths}"/>;
		
		var expiringCapabilityLabel = '<apex:outputText value="{!$Label.kimbleone__expiringcapabilitylabel}"/>';
		var expiredCapabilityLabel = '<apex:outputText value="{!$Label.kimbleone__expiredcapabilitylabel}"/>';
		
		var capabilityHierarchyDelimiter = '<apex:outputText value="{!JSENCODE(CapabilityHierarchyDelimiter)}"/>';
		var noneLabel = '<apex:outputText value="{!$Label.kimbleone__none}"/>';
		var reviewOptions;
		
		var resourceActivityRoles = [];
		var activityRoleChanges = false;
		
		var resourceCapabilityMap = {};
		var resourceCapabilityIdsMap = {};
		
		var canEditPrimaryRole = <apex:outputText value="{!CanEditPrimaryRole}"/>;
		var canEditCapability = <apex:outputText value="{!CanEditCapability}"/>;
		
		jQuery(window).load(function()
		{
			initialise();
			getResourceProfile();
		});	
		
		function initialise()
		{
			jQuery(document).off('click', '.expand-btn').on('click', '.expand-btn', toggleSearch);
			jQuery(document).off('click', '.collapse-btn').on('click', '.collapse-btn', toggleSearch);
			jQuery(document).off('click', '.browse-btn').on('click', '.browse-btn', fetchAllCapabilities);
			jQuery(document).off('click', '.clear-capability-filter').on('click', '.clear-capability-filter', fetchAllCapabilities);
			jQuery(document).off('click', '.expand-and-browse-btn').on('click', '.expand-and-browse-btn', toggleSearchAndfetchAllCapabilities);

			jQuery(document).off('click', '.save-btn.fa-save').on('click', '.save-btn.fa-save', saveAll);

			jQuery(document).off('click', '.remove-cap.action-btn').on('click', '.remove-cap.action-btn', toggleRemoveCapRow);
			jQuery(document).off('click', '.remove-role.action-btn').on('click', '.remove-role.action-btn', removeActivityRole);
			
			jQuery(document).off('click', 'input[name="primary-roles"]').on('click', 'input[name="primary-roles"]', setPrimaryRole);

			jQuery(document).off('keyup', '#capability-type-filter').on('keyup', '#capability-type-filter', lookupCapabilities);
			jQuery(document).off('click', '#capability-search-results .cap-row').on('click', '#capability-search-results .cap-row', toggleSelect);
			jQuery(document).off('click', '#capability-search-results .breadcrumb-header').on('click', '#capability-search-results .breadcrumb-header', toggleCapabilityHeader);

			jQuery(document).off('change', '.expiry-date').on('change', '.expiry-date', expiryDateChange);
			jQuery(document).off('change', '.rating-cell.BooleanRating input').on('change', '.rating-cell.BooleanRating input', booleanRatingChange);
			jQuery(document).off('change', '.rating-cell.NumericRating select').on('change', '.rating-cell.NumericRating select', numericRatingChange);
			jQuery(document).off('change', '.status-cell select').on('change', '.status-cell select', statusChange);
		}
		
		function initialiseRoleFind()
		{
			jQuery('.find-role').select2({
				//minimumInputLength: 2,
				multiple: false,
				query: function (params) {
					var find = function() {findActivityRoles(params);};        		
					find();
				},
				initSelection : function (element, callback) {
				var data = {id: element.val(), text: element.attr('data-name')};
				callback(data);
				}
			});
			
			jQuery('.find-role').on("select2-selecting", function(e) {
				var asPrimary = jQuery(e.target).closest('.role-row').find('.primary-cell input').prop('checked');
				var newRole = {ActivityRoleId: e.object.id, ActivityRoleName: e.object.text, IsPrimary: asPrimary, state: 'new'};
				resourceActivityRoles.push(newRole);
				resourceActivityRoles.sort(sortByActivityRoleName);
				setHasChanges();
				activityRoleChanges = true;
				drawResourceActivityRoles();
			});
			
			initialiseTips();
		}
		
	   	function sortByActivityRoleName(a,b)
	   	{
	   		return (a.ActivityRoleName < b.ActivityRoleName) ? -1 : (a.ActivityRoleName > b.ActivityRoleName) ? 1 : 0; 
	   	}
		
		function findActivityRoles(params)
		{
			var existingRoleIds = [];
			jQuery('.role-row:not(.deleted)').each(function() {existingRoleIds.push(jQuery(this).attr('actroleid'));});
		
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ResourceProfileController.AllActivityRoles}',
		      		existingRoleIds,
		     			function(result, event){          
		            		if (event.status) 
			            {
			             	var data = {};
			             	data.results = result;
			             	params.callback(data);
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
		        	}, 
		        	{escape: false, timeout: 60000}
		    	);
		}
		
		var capabilityLookupTimeout;

		function toggleRemoveCapRow()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			resourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;
			jQuery(this).closest('div.cap-row').addClass('has-changes');

			// remove
			if(jQuery(this).closest('div.cap-row').find('i.fa-trash').length)
			{
				resourceCapabilityIdsMap[capabilityTypeId].IsDeleted = true;
				jQuery(this).closest('div.cap-row').addClass('is-deleted');
				jQuery(this).closest('div.cap-row').find('.fa-trash').removeClass('fa-trash').addClass('fa-undo');
			}
			else
			{
				// undo
				resourceCapabilityIdsMap[capabilityTypeId].IsDeleted = false;
				jQuery(this).closest('div.cap-row').removeClass('is-deleted');					
				jQuery(this).closest('div.cap-row').find('.fa-undo').removeClass('fa-undo').addClass('fa-trash');
			}

			setHasChanges();
		}
		
		function setPrimaryRole()
		{
			setHasChanges();
			activityRoleChanges = true;
			
			var actroleid = jQuery(this).closest('.role-row').attr('actroleid');
			var resactroleid = jQuery(this).closest('.role-row').attr('resActRoleId');
			
			for(var roleCounter = 0; roleCounter < resourceActivityRoles.length; roleCounter++)
			{
				var resourceActivityRole = resourceActivityRoles[roleCounter];
				resourceActivityRole.IsPrimary = (resourceActivityRole.ActivityRoleId == actroleid);
			}
		}
		
		function removeActivityRole()
		{
			var actroleid = jQuery(this).closest('.role-row').attr('actroleid');
			var resactroleid = jQuery(this).closest('.role-row').attr('resActRoleId');
			
			if(resactroleid != undefined && resactroleid != '')
			{
				jQuery(this).closest('.role-row').addClass('deleted');
			}
			else
			{
				jQuery(this).closest('.role-row').remove();
			}
			
			for(var roleCounter = 0; roleCounter < resourceActivityRoles.length; roleCounter++)
			{
				var resourceActivityRole = resourceActivityRoles[roleCounter];
				
				if(resourceActivityRole.ActivityRoleId == actroleid && (resourceActivityRole.Id == undefined || resourceActivityRole.Id == ''))
				{
					resourceActivityRoles.splice(roleCounter, 1);
					break;
				}
				else if(resourceActivityRole.ActivityRoleId == actroleid && resourceActivityRole.Id != undefined && resourceActivityRole.Id != '')
				{
					resourceActivityRole.state = 'deleted';
					break;
				}
			}
			
			setHasChanges();
			
			activityRoleChanges = true;
			
			drawResourceActivityRoles();
		}
						
		function expiryDateChange()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			resourceCapabilityIdsMap[capabilityTypeId].ExpiryDate = kimble.parseDate(jQuery(this).val());
			resourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;

			jQuery(this).closest('div.cap-row').addClass('has-changes');
			setHasChanges();
		}
		
		function booleanRatingChange()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			resourceCapabilityIdsMap[capabilityTypeId].BooleanRating = jQuery(this).val();
			resourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;

			jQuery(this).closest('div.cap-row').addClass('has-changes');
			setHasChanges();
		}
		
		function numericRatingChange()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			resourceCapabilityIdsMap[capabilityTypeId].NumericRating = jQuery(this).val();
			resourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;

