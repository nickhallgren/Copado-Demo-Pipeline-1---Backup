	  			<input id="capability-type-filter" placeholder="{!$Label.CapabilitySearchPlaceholder}"/>
				<i class="clear-capability-filter fa fa-times hidden-item"></i>
				<i class="searching-ind top-right-search-icon hidden-item fa fa-spin fa-circle-o-notch"></i>
				<i class="collapse-btn action-btn top-right-search-icon fa fa-angle-double-up" title="{!$Label.Close}" kimble-tip="CloseIcon" kimble-tip-help-link="ResourceProfilingLink"></i>
				<i class="browse-btn action-btn top-right-search-icon fa fa-list-ul" title="{!$Label.Browse}" kimble-tip="BrowseIcon2" kimble-tip-help-link="ResourceProfilingLink"></i>
