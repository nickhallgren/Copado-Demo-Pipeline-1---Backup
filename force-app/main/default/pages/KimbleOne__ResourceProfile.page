		<div id="activity-roles-title" kimble-tip="Role" kimble-tip-extended-text="RoleExtendedText" kimble-tip-help-link="ResourceProfilingLink">
			<div class="title-card-container">
			<div class="title-card">
				<div class="title-card-heading" >
					<div class="title-card-heading-text">
