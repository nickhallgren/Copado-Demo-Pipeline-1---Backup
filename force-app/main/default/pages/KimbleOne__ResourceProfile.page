					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!CanAssignCapability}">
					<i class="expand-and-browse-btn action-btn fa fa-list-ul" kimble-tip="BrowseIcon" kimble-tip-help-link="ResourceProfilingLink" kimble-tip-extended-text="BrowseIconExtendedText" title="{!$Label.Browse}"></i>
					<i class="expand-btn action-btn fa fa-search-plus" kimble-tip="SearchIcon" kimble-tip-help-link="ResourceProfilingLink" kimble-tip-extended-text="SearchIconExtendedText"></i>
