        function loadCriteriaConfig(id, additionalCriteria)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FilterCriteriaController.GetObjectCriteria}',
	       		id,
	      			function(result, event){
	             		 if (event.status)
			             {
			             	theCriteriaConfig = result;

			             	if (additionalCriteria != null) {
			             	    Object.assign(theCriteriaConfig.CriteriaMap, additionalCriteria);
                            }

                            console.log('config loaded');
                            console.log(theCriteriaConfig);

                            if (onCriteriaConfigLoaded != null) onCriteriaConfigLoaded();

			         	}
			         	else if (event.type === 'exception')
			         	{
			             	alert(event.message);
			         	}
			         	else
			         	{
			             	alert(event.message);
			         	}
	         	},
	         	{escape: false, timeout: 60000}
	     	);
		}

        function validateCriteriaRemoteAction(j, oncomplete)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FilterCriteriaController.ValidateCriteria}',
	       		j,
	      			function(result, event){
	             		 jQuery('.update-filter-button input').prop('disabled', false);

	             		 if (event.status)
			             {
			                oncomplete();
			         	 }
			         	 else if (event.type === 'exception')
			         	 {
			             	alert(event.message);
			         	 }
			         	 else
			         	 {
			             	 alert(event.message);
			         	 }

	         	},
	         	{escape: false, timeout: 60000}
	     	);
		}

        function loadAllObjectNames() {
            jQuery.each(jQuery('.dynamic-lookup'), function(i, obj) {
                var $o = jQuery(obj);
                var ids =  JSON.parse($o.attr('data-ids'));
                getObjectNames(ids, function(){
                    var t = '';

                    ids.forEach(function(id) {
                           t += objectNamesMap[id] + ', ';
                     });

                     t = t.substring(0, t.length-2);

                     $o.text(t);
                });
            });
        }

        function loadAllDynamicLabels() {
            jQuery.each(jQuery('.dynamic-label'), function(i, obj) {
                var $o = jQuery(obj);
                getFieldLabel($o, theFilterCriteria.ArgumentObjectType, $o.attr('data-fld'));
            });
        }

        var objectNamesMap = {};

        function getObjectNames(ids, oncomplete) {

            var idsToFind = [];

            ids.forEach(function(id){
                if (objectNamesMap[id] == null) {
                    idsToFind.push(id);
                }
            });

            if (idsToFind.length > 0) {

                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FilterCriteriaController.GetObjectNames}',
                    ids,
                        function(result, event){
                             if (event.status)
                             {
                                //do the stuff with result;
                                Object.assign(objectNamesMap, result);
                                oncomplete();
                            }
                            else if (event.type === 'exception')
                            {
                                alert(event.message);
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {escape: false, timeout: 60000}
                );
            } else {
                oncomplete();
            }
        }

        function sortOptions(a, b)
        {
            return a.text > b.text ? 1 : -1;
        }

        function getFieldLabel(node, typ, fld) {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FilterCriteriaController.GetFieldLabel}',
	       		typ, fld,
	      			function(result, event){
	             		 if (event.status)
			             {
