			         	}
			         	else if (event.type === 'exception')
			         	{
			             	alert(event.message);
			         	}
			         	else
			         	{
			             	alert(event.message);
			         	}
	         	},
	         	{escape: false, timeout: 60000}
	     	);
        }

        function searchLookupValues(id, term, oncomplete) {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FilterCriteriaController.SearchLookupValues}',
	       		id, term,
	      			function(result, event){
	             		 if (event.status)
			             {
			             	oncomplete(result);
			         	}
			         	else if (event.type === 'exception')
			         	{
			             	alert(event.message);
			         	}
			         	else
			         	{
			             	alert(event.message);
			         	}
	         	},
	         	{escape: false, timeout: 60000}
	     	);
        }

        function switchDateRange()
        {
            if (jQuery('#date-fixed').prop('checked'))
            {
                jQuery('#fixed-dates').show();
                jQuery('#rolling-dates').hide();
            }
            else if (jQuery('#date-rolling').prop('checked'))
            {
                jQuery('#fixed-dates').hide();
                jQuery('#rolling-dates').show();
            }
            else
            {
                jQuery('#fixed-dates').hide();
                jQuery('#rolling-dates').hide();
            }
        }

