<apex:page standardcontroller="KimbleOne__DeliveryGroup__c" sidebar="false" extensions="KimbleOne.FilesAndAttachmentsController">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="DeliveryEngagements.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}"/>

</apex:define>
    
<apex:define name="Content">

	<apex:pageMessages escape="False" />
 
	<apex:pageBlock title="{!$Label.kimbleone__deliverygroupreviewactionsheader}">

		<apex:pageBlockSection title="{!$Label.kimbleone__deliverygroupconfirmtasksheader}" collapsible="false">
      
			<apex:relatedList list="ActivityHistories" />

			<apex:relatedList list="OpenActivities" />
    
		</apex:pageBlockSection>

	</apex:pageBlock>
      
	<apex:pageBlock title="{!$Label.kimbleone__deliverygroupreviewdocumentsheader}" rendered="{!ReviewSupportingDocsEnabled}">

		<apex:pageBlockSection collapsible="false">
  
   	  		<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
			<apex:relatedList subject="{!KimbleOne__DeliveryGroup__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
			
		</apex:pageBlockSection> 

	</apex:pageBlock>
	<script>
		jQuery(document).ready(function() {
			if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
		});
	</script>
</apex:define>

</apex:composition>

</apex:page>