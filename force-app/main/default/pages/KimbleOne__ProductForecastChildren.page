<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.ProductForecastChildrenController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">
  
<apex:define name="Menu">
		<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>
</apex:define>
    
<apex:define name="Content">
	<style>
		.action-icon {
			cursor: pointer;
		}
	</style>

	<apex:form >
<!-- Additional fields -->
	<apex:outputField value="{!KimbleOne__Product__c.KimbleOne__ProductDomain__c}" rendered="false" />
	<apex:outputField value="{!KimbleOne__Product__c.KimbleOne__IsAbstract__c}" rendered="false" />
		
		<apex:outputPanel id="ProductEditMainPanel">
			
			<apex:pageMessages escape="false" id="messagesMain"/>
			
			<apex:pageBlock id="ProductEditMainPanelNoMessage">		
				<apex:pageBlockButtons location="bottom">
					<apex:commandButton action="{!save}" value="{!$Label.kimbleone__save}"/>						
				</apex:pageBlockButtons>
	
				<apex:pageBlockSection collapsible="false" columns="1" id="forecastChildren">
					<apex:outputPanel rendered="{!hasAddableForecastChildren}"><span type="button" class="fa fa-plus-square action-icon" onClick="initialiseModalBoxy('#addForecastChildPopup', '{!JSENCODE($Label.AddForecastChildMember)}', '#popups');showModalBoxy()"/></apex:outputPanel>
					<apex:actionRegion >
					<apex:pageBlockTable value="{!forecastChildMembers}" var="member">
						<apex:column ><span onClick="deleteForecastChild('{!member.ChildProduct__r.id}');" class='fa fa-trash-o action-icon'/></apex:column>
						<apex:column value="{!member.KimbleOne__ChildProduct__c}"/>
						<apex:column headerValue="{!$ObjectType.KimbleOne__ProductDomain__c.Fields.KimbleOne__CostForecastMode__c.label}" value="{!member.ChildProduct__r.ProductDomain__r.CostForecastMode__r.Name}"/>
						<apex:column headerValue="{!$ObjectType.KimbleOne__ProductDomain__c.Fields.KimbleOne__RevenueForecastMode__c.label}" value="{!member.ChildProduct__r.ProductDomain__r.RevenueForecastMode__r.Name}"/>
						<apex:column headerValue="{!$ObjectType.KimbleOne__ProductMember__c.fields.KimbleOne__IsMandatory__c.label}"><apex:inputField value="{!member.KimbleOne__IsMandatory__c}"/></apex:column>
					</apex:pageBlockTable>
		
					<apex:actionFunction name="deleteForecastChild" action="{!deleteForecastChild}" rerender="forecastChildren,addForecastChildPopup,messagesMain">
						<apex:param name="productId" value="" />
					</apex:actionFunction>
					</apex:actionRegion>
				</apex:pageBlockSection>
				
			</apex:pageBlock>
			
		</apex:outputPanel>
		
		<div id="popups">
		<div id='addForecastChildPopup' style='{!htmlencode(HiddenElementStyle)}'>
		<apex:outputPanel id="addForecastChildPopup">
			<apex:pageMessages escape="false"/>
			
			<apex:pageBlock >
				<apex:pageBlockButtons location="bottom">
					<input type='button' class='btn DisableButtonWhileBusy' value='{!JSENCODE($Label.Ok)}' onClick='addForecastChild()' />
					<input type='button' class='btn' value='{!JSENCODE($Label.Cancel)}' onClick='hideModalBoxy()' />
				</apex:pageBlockButtons>
	
				<apex:actionRegion >
				<apex:pageBlockSection collapsible="false" columns="1">
					<apex:selectList value="{!addableForecastChild}" size="1" id="addableForecastChild">
						<apex:selectOptions value="{!addableForecastChildOptions}" />
					</apex:selectList>
				</apex:pageBlockSection>		
				<apex:actionFunction name="addForecastChild" action="{!addForecastChild}" rerender="forecastChildren,addForecastChildPopup,messagesMain" onComplete="hideModalBoxy();"/>
				</apex:actionRegion>

			</apex:pageBlock>
		</apex:outputPanel>
		</div>
		</div>
		
	</apex:form>
</apex:define>
</apex:composition>

</apex:page>