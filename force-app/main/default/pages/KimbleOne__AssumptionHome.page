<apex:page standardController="KimbleOne__Assumption__c" extensions="KimbleOne.AssumptionEditController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Issues.html" MenuContextType="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), 'DeliveryGroup','Proposal')}" MenuContextId="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), KimbleOne__Assumption__c.KimbleOne__DeliveryGroup__c,KimbleOne__Assumption__c.KimbleOne__Proposal__c)}" MenuContextName="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), KimbleOne__Assumption__c.DeliveryGroup__r.Name ,KimbleOne__Assumption__c.Proposal__r.Name)}"/>

</apex:define>  
   
<apex:define name="Content">

	   
	<apex:pagemessages escape="false"/>

	<chatter:feedWithFollowers entityId="{!KimbleOne__Assumption__c.Id}" rendered="{!ShowChatter}"/>

    <apex:form >
		<apex:outputPanel id="AssumptionDetailsPanel" >
		    	<apex:pageBlock id="AssumptionDetailsBlock" title="{!$ObjectType.KimbleOne__Assumption__c.Label}">
		    	
		    	    <apex:pageBlockButtons location="top">
    				<apex:commandButton action="{!Edit}" value="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__Assumption__c.label}" rendered="{!KimbleOne__Assumption__c.KimbleOne__Proposal__c != null || (KimbleOne__Assumption__c.DeliveryGroup__r.DeliveryStage__r.KimbleOne__AllowNewAssumptions__c = true && KimbleOne__Assumption__c.KimbleOne__DeliveryGroup__c != null)}"/>
    				</apex:pageBlockButtons> 
		    	  
		    		<div id="AssumptionDetailsErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
		    	   
					<apex:pageBlockButtons location="bottom"> 
						<apex:commandButton action="{!goToAssumptionManager}" value="{!$Label.kimbleone__back}" oncomplete="" reRender=""/>						
					</apex:pageBlockButtons>
					
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
             		 
               			<apex:outputfield value="{!KimbleOne__Assumption__c.Name}" />  
               			<apex:outputfield value="{!KimbleOne__Assumption__c.KimbleOne__IsValid__c}" />
               			
               			<apex:outputfield value="{!KimbleOne__Assumption__c.KimbleOne__ImpactDescription__c}" />               			               			
               			<apex:outputfield value="{!KimbleOne__Assumption__c.KimbleOne__Impact__c}" />
               			
               			<apex:outputfield value="{!KimbleOne__Assumption__c.KimbleOne__Summary__c}" />
               			<apex:outputfield value="{!KimbleOne__Assumption__c.KimbleOne__Description__c}" />
               			
					</apex:pageBlockSection>					

					<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
						<apex:repeat value="{!$ObjectType.KimbleOne__Assumption__c.FieldSets.KimbleOne__AssumptionDetails}" var="f">
		     				<apex:outputfield value="{!KimbleOne__Assumption__c[f]}" />
   						</apex:repeat>
		            </apex:pageBlockSection>						

		    	</apex:pageBlock>
		</apex:outputPanel>
		    
    </apex:form>
     </apex:define>
</apex:composition> 
</apex:page>