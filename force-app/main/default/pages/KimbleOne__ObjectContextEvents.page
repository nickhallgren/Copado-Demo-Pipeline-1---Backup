<apex:page controller="KimbleOne.ObjectContextEventsController" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">

    <apex:composition template="KimbleOne__SiteMaster">

        <apex:define name="Menu">

            <c:Menu MenuContextType="{!menuType}" MenuContextId="{!menuId}" MenuContextName="{!objectName}"/>

        </apex:define>

        <apex:define name="Content">
            <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
                <div id="loadingIndicatorInnerContainer">
                    <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
                </div>
            </div>

           <apex:pageBlock id="TheEvents" title="{!$ObjectType.KimbleOne__Event__c.LabelPlural}">

                    <apex:pageBlockTable value="{!TheEvents}" var="event" styleClass="kimble-enhanced-table">
                        <apex:column headerValue="{!$Label.kimbleone__actionlinksheader}" headerClass="sortable">
                            <apex:outputPanel layout="none" rendered="{!event.KimbleOne__IsComplete__c}"><a href="javascript:void(0);" onclick="reCompleteEventClick('{!JSENCODE(event.Id)}');">{!$Label.kimbleone__recomplete}</a></apex:outputPanel>
                        </apex:column>

                        <apex:column headerValue="{!$ObjectType.KimbleOne__Event__c.Fields.Name.Label}" headerClass="sortable">
                            <apex:outputField value="{!event.Name}" />
                        </apex:column>

                        <apex:column headerValue="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__EventClass__c.Label}" headerClass="sortable">
                            <apex:outputField value="{!event.KimbleOne__EventClass__c}" />
                        </apex:column>

                        <apex:column headerValue="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__EventDate__c.Label}" headerClass="sortable">
                            <apex:outputField value="{!event.KimbleOne__EventDate__c}" />
                        </apex:column>

                        <apex:column headerValue="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__EventNarrative__c.Label}" headerClass="sortable">
                            <apex:outputField value="{!event.KimbleOne__EventNarrative__c}" />
                        </apex:column>

                        <apex:column headerValue="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__IsComplete__c.Label}" headerClass="sortable">
                            <apex:outputField value="{!event.KimbleOne__IsComplete__c}" />
                        </apex:column>

                    </apex:pageBlockTable>

                </apex:pageBlock>

            <script>

          jQuery(window).load(function(){

          	initialise();

          });

          function initialise()
          {
          	jQuery('.kimble-enhanced-table').enhancedTable();
          }

          function reCompleteEventClick(eventId)
          {
                jQuery('#loadingIndicatorOuterContainer').show();

                reCompleteEvent(eventId);
          }

          function reCompleteEvent(eventId)
          {
                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ObjectContextEventsController.ReCompleteEvent}',
                    eventId,
                    function(result, event){
                            if (event.status)
                            {

                            }
                            else if (event.type === 'exception')
                            {
                                alert(event.message);
                            }
                            else
                            {
                                alert(event.message);
                            }

                            jQuery('#loadingIndicatorOuterContainer').hide();
                    },
                    {buffer: false, escape: true, timeout: 60000}
                );
        }

   </script>

            <style>
            /*
    loading panel
*/

.loadingIndicator {
   top:0;
   right:0;
   width:100%;
   height:100%;
   font-weight: bold;
   position:absolute;
   text-align:center;
   /* IE filter */
   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
   -moz-opacity:0.7;    /* Mozilla extension */
   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
   opacity:0.7; /* CSS3 */
   z-index:1000;
   background-color:white;
   display:none;
}

.loadingIndicator img {
    margin-right:9px;
}

#loadingIndicatorInnerContainer {
    position:absolute;
    top:50%;
    height:10em;
    margin-top:-2em;
    width:100%;
}
</style>

        </apex:define>

    </apex:composition>

</apex:page>