												<apex:outputField value="{!TheRequisitionItemsMap[itm.Id].BookingReference__c}" rendered="{!TheRequisitionItemsMap[itm.Id].Status__c = BookedId}"/>

											</apex:column>
											<apex:column headervalue="{!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__SupplierPurchaseOrder__c.Label}" styleclass="{!IF(itm.IsCancelled__c, 'lineCancelled','')}">
												<apex:outputLink value="/{!itm.SupplierRequisition__c}"><apex:outputText value="{!itm.SupplierRequisition__r.SupplierPurchaseOrder__r.Name}"/></apex:outputLink>
											</apex:column>
											<apex:column headervalue="{!$Label.kimbleone__travelrequisitionothers}" rendered="{!$ObjectType.KimbleOne__TravelRequisitionItem__c.FieldSets.KimbleOne__TravelRequisitionItemCarHire.size > 0}">
