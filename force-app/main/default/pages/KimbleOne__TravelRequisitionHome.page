										<apex:outputLabel value="{!$ObjectType.KimbleOne__TravelRequisition__c.Fields.KimbleOne__Reference__c.Label}"/>
										<apex:outputPanel layout="none">
											<apex:outputText value="{!KimbleOne__TravelRequisition__c.KimbleOne__Reference__c}"/>/<apex:outputText value="{!TheRequisitionItemToUpdate.KimbleOne__Reference__c}"/>
										</apex:outputPanel>
									</apex:pageBlockSectionItem>
									<apex:outputField value="{!TheRequisitionItemToUpdate.SelectedTravelItineraryItem__r.KimbleOne__ItineraryNotes__c}"/>
									<apex:outputField value="{!TheRequisitionItemToUpdate.KimbleOne__BookingReference__c}" />

