													<apex:selectOptions value="{!theTravelCategorySuppliers[cat]}" />
												</apex:selectList>
											</div>
										</apex:outputPanel>
									</apex:pageBlockSectionItem>

									<apex:outputField value="{!TheRequisitionItemToBook.SelectedTravelItineraryItem__r.KimbleOne__ItineraryNotes__c}"/>
