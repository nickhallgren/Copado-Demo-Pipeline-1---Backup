											<apex:column headervalue="{!$ObjectType.KimbleOne__Traveller__c.Fields.KimbleOne__Contact__c.Label}" width="400px">
												<apex:outputField value="{!traveller.KimbleOne__Contact__c}"/>
											</apex:column>

											<apex:repeat var="f" value="{!$ObjectType.Contact.FieldSets.KimbleOne__TravellerDetails}">
												<apex:column headerValue="{!f.label}">
													<apex:outputField value="{!TheContactTravellerDetails[traveller.KimbleOne__Contact__c][f]}" />
												</apex:column>
											</apex:repeat>
										</apex:pageBlockTable>
