									<apex:inputField value="{!TheRequisitionItemToBook.KimbleOne__NetAmount__c}"/>
									<apex:inputField value="{!TheRequisitionItemToBook.KimbleOne__BookingReference__c}" required="true"/>
									<apex:inputField value="{!TheRequisitionItemToBook.KimbleOne__BookingNotes__c}"/>

									<apex:repeat value="{!$ObjectType.KimbleOne__TravelRequisitionItem__c.FieldSets.KimbleOne__TravelRequisitionItemDetails}" var="f" rendered="{!ISBLANK(TheRequisitionVersion)}">
										<apex:inputField value="{!TheRequisitionItemToBook[f]}" required="{!f.Required}" />
									</apex:repeat>

								</apex:pageblockSection>
							</apex:pageBlock>
						</apex:form>

