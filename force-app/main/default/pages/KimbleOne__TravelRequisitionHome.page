										</apex:outputPanel>
									</apex:pageBlockSectionItem>
									<apex:pageBlockSectionItem >
										<apex:outputLabel value="{!$Label.kimbleone__cancelbookinglabel}"/>
										<apex:outputPanel layout="none">
											<apex:inputField value="{!BookingUpdate.KimbleOne__InputCheckbox__c}"/>
										</apex:outputPanel>
									</apex:pageBlockSectionItem>
