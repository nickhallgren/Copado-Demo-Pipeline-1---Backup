													<b><apex:outputLabel value="{!f.Label}"></apex:outputLabel> : </b><apex:outputField value="{!itm[f]}"  /> <br/>
												</apex:repeat>
											</apex:column>
										</apex:pageBlockTable>
									</div>
								</apex:outputPanel>

								<apex:outputPanel layout="none" rendered="{!TheTravellers.Size != 0}">
