																	</apex:outputPanel>
																	<apex:outputPanel layout="none" rendered="{!!(itm.SelectedTravelItineraryItem__c == itinerary.Id)}">
																		<input type="radio" name="selectCarHireItineraryItem{!itm.Id}" onclick="selectTravelItinerary('{!JSINHTMLENCODE(itm.Id)}','{!JSINHTMLENCODE(itinerary.Id)}')"/>
																	</apex:outputPanel>
																</apex:outputPanel>
															</td>
															<td class="{!IF(!ISBLANK(itm.SelectedTravelItineraryItem__c) && itm.SelectedTravelItineraryItem__c == itinerary.Id,'selectedOption','unselectedOption')}">
																&nbsp;
															</td>
															<td style="background:transparent;">
																<apex:inputTextArea value="{!itinerary.ItineraryNotes__c}" cols="48" rows="6" readonly="true"/>
															</td>
															<td style="background:transparent;">
																<apex:outputField value="{!itinerary.NetAmount__c}"/>
															</td>
														</tr>
													</apex:repeat>
												</table>
