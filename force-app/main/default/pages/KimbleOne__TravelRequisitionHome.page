							<apex:pageBlock rendered="{!!ISBLANK(TheRequisitionItemToUpdate)}">
								<apex:pageBlockButtons location="bottom">
									<apex:commandButton action="{!UpdateBooking}"  styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__updatebookinglabel}" reRender="TheForm, UpdateRequisitionItem" oncomplete="hideModalBoxyWithErrorCheck('UpdateBookingPopupErrors');"/>
									<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.kimbleone__cancel}"/>
								</apex:pageBlockButtons>
								<apex:variable var="cat" value="{!TheRequisitionItemToUpdate.TravelCategory__r.KimbleOne__Enum__c}"/>
