<apex:page extensions="KimbleOne.TimeCategoryTemplatesController" standardController="KimbleOne__ResourcedActivityTemplate__c" sidebar="false">
 
<apex:composition template="KimbleOne__SiteMaster">
	<apex:define name="Menu"> 
		<c:Menu HelpSource="CfgGuide" DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextType="{!IF(ISBLANK(KimbleOne__ResourcedActivityTemplate__c.KimbleOne__Product__c),IF(ISBLANK(KimbleOne__ResourcedActivityTemplate__c.KimbleOne__ProductDomain__c), 'ResourcedActivityType', 'ProductDomain'),'ProductDefinition')}" MenuContextId="{!IF(ISBLANK(KimbleOne__ResourcedActivityTemplate__c.KimbleOne__Product__c),IF(ISBLANK(KimbleOne__ResourcedActivityTemplate__c.KimbleOne__ProductDomain__c), KimbleOne__ResourcedActivityTemplate__c.KimbleOne__ResourcedActivityType__c, KimbleOne__ResourcedActivityTemplate__c.KimbleOne__ProductDomain__c),KimbleOne__ResourcedActivityTemplate__c.KimbleOne__Product__c)}" MenuContextName="{!KimbleOne__ResourcedActivityTemplate__c.Name}" /> 
	</apex:define>
	<apex:define name="Content">
	
	   <apex:outputPanel id="TimeCategoryTemplates" layout="block">
			<apex:form >
				
				<div id="timeCategoryTemplatesErrors">
					<apex:pageMessages escape="false"/>
				</div>
				
				<apex:pageBlock >
	
					<apex:pageBlockButtons location="top">
	
						<!-- Add Category at any point, up to maximum of 5 -->
						<apex:outputPanel layout="none" rendered="{!(TimeCategoryTemplates.size<maxCategoriesAllowed)}">
							<input type="button" class="btn"
								value="{!$Label.New} {!$ObjectType.TimeCategoryTemplate__c.Label}"
								onclick="initialiseModalBoxy('#TimeCategoryTemplatePopup', '{!JSENCODE($Label.New)} {!$ObjectType.TimeCategoryTemplate__c.Label}');newTimeCategoryTemplate();"></input>
						</apex:outputPanel>
	
					</apex:pageBlockButtons>
					
					<apex:variable var="counter" value="{!1}"/>
					
					<apex:pageBlockTable value="{!TimeCategoryTemplates}" var="a">
	
						<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}" >
	
							<!-- Edit -->
							<apex:outputLink value="#" onclick="initialiseModalBoxy('#TimeCategoryTemplatePopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Label}');editTimeCategoryTemplate('{!JSINHTMLENCODE(a.Id)}')">{!$Label.kimbleone__edit}</apex:outputLink>
							&nbsp;|&nbsp;
		     				<apex:commandLink onclick="var d = confirmDelete();if(!d) return;" action="{!deleteTimeCategoryTemplate}" reRender="TimeCategoryTemplates">{!$Label.kimbleone__delete}
								<apex:param name="ActivityTimeCatId" value="{!a.Id}" />
							</apex:commandLink>
	           				&nbsp;|&nbsp;
							<apex:commandLink action="{!moveUpTimeCategoryTemplate}" reRender="TimeCategoryTemplates">{!$Label.kimbleone__uplabel}
								<apex:param name="ActivityTimeCatId" value="{!a.Id}" />
							</apex:commandLink>
							
	     					&nbsp;|&nbsp;
							<apex:commandLink action="{!moveDownTimeCategoryTemplate}" reRender="TimeCategoryTemplates">{!$Label.kimbleone__downlabel}
								<apex:param name="ActivityTimeCatId" value="{!a.Id}" />
							</apex:commandLink>
							
							<apex:variable var="counter" value="{!counter+1}"/>
	
						</apex:column>
	
						<apex:column value="{!a.Name}"
							headerValue="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.Name.Label}" />
						<apex:column value="{!a.KimbleOne__DisplaySequence__c}" 
							headerValue="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__DisplaySequence__c.Label}" />
						<apex:column value="{!a.DisplayType__r.KimbleOne__Enum__c}"
							headerValue="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__DisplayType__c.Label}" />
						<apex:column value="{!a.KimbleOne__IsMandatory__c}"
							headerValue="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__IsMandatory__c.Label}" />
						<apex:column value="{!a.KimbleOne__TimeCategoryValues__c}"
							headerValue="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__TimeCategoryValues__c.Label}" />
						
					</apex:pageBlockTable>
	
				</apex:pageBlock>
	
				<apex:actionFunction action="{!newTimeCategoryTemplate}"
					name="newTimeCategoryTemplate"
					rerender="TimeCategoryTemplate"
					oncomplete="showModalBoxy(); decideDisableSaveButton()">
				</apex:actionFunction>
	
				<apex:actionFunction action="{!EditTimeCategoryTemplate}"
					name="editTimeCategoryTemplate" rerender="TimeCategoryTemplate"
					oncomplete="showModalBoxy();decideHide()">
					<apex:param name="ActivityTimeCatId" value="" />
				</apex:actionFunction>
	
			</apex:form>
		</apex:outputPanel>
	
	
		<div id="TimeCategoryTemplatePopup" style="display: none"><apex:outputPanel id="TimeCategoryTemplate">
	
			<apex:form >
				<apex:outputPanel style="width:500px;" layout="block">
				
					<apex:outputPanel id="Errorpanel">
						<div id="activityTimeCatErrors">
							<apex:pageMessages escape="false"/>
						</div>
					</apex:outputPanel>
	
					<apex:pageBlock >
				
						<apex:pageBlockButtons location="bottom">
							<apex:commandButton action="{!SaveTimeCategoryTemplate}"
								value="{!$Label.kimbleone__save}"
								oncomplete="hideModalBoxyWithErrorCheck('#activityTimeCatErrors');"
								reRender="Errorpanel, TimeCategoryTemplates" onclick="beforeSave()" styleclass="SaveButton"/>
							<input class="btn" type="button" onclick="hideModalBoxy();"
								value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
	
						<apex:pageblockSection collapsible="false" showheader="false"
							columns="1">
							<apex:inputHidden value="{!TimeCategoryTemplate.KimbleOne__DisplaySequence__c}"/>
							<apex:pageblockSectionItem labelStyle="width:40%">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.Name.Label}"/>
								<apex:inputField value="{!TimeCategoryTemplate.Name}" required="true"/>
							</apex:pageblockSectionItem>
							
							<apex:pageblockSectionItem labelStyle="width:40%">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__DisplayType__c.Label}"/>
								<apex:inputText value="{!TimeCategoryTemplate.KimbleOne__DisplayType__c}"
										styleclass="kimbledropdown DisplayType NoFilter true true" required="true" onchange=" decideHide()" />
							</apex:pageblockSectionItem>
							
							<apex:inputField value="{!TimeCategoryTemplate.KimbleOne__IsMandatory__c}"/>
							<apex:inputtext value="{!TimeCategoryTemplate.KimbleOne__TimeCategoryValues__c}" styleclass="TimeCategoryValues HideControl"/>
							<apex:pageblockSectionItem >
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeCategoryTemplate__c.Fields.KimbleOne__TimeCategoryValues__c.Label}" styleclass="SelectedValuePanel" style="display:none"/>
									<apex:panelGrid columns="2"  styleclass="SelectedValuePanel" style="display:none;vertical-align:top">
										<apex:outputPanel >
											<input type="text" id="PreSelectedValues" size="8" style="width:200px" />
										</apex:outputPanel>
										<apex:outputPanel >
											<input id="addButton" type="button" value="{!$Label.AddButton}" onclick="if($('#PreSelectedValues').val()=='')return false;$('#SelectedValues').append($('<option></option>').attr('value',jQuery.trim($('#PreSelectedValues').val())).text(jQuery.trim($('#PreSelectedValues').val()))); $('#PreSelectedValues').val('');decideDisableSaveButton()"/>
										</apex:outputPanel>
										<apex:outputPanel >
											<select Id="SelectedValues"  multiple="multiple" size="5" style="width:200px" 
												onclick="if(	$('#SelectedValues option:selected').length>0) $('#removeButton').removeAttr('disabled'); else $('#removeButton').attr('disabled','disabled');">
											</select>
										</apex:outputPanel>
										<apex:outputPanel >
											<input id="removeButton" type="button" value="{!$Label.RemoveButton}" onclick="$('#SelectedValues option:selected').remove();$('#removeButton').attr('disabled','disabled'); decideDisableSaveButton()" disabled="disabled"/>
										</apex:outputPanel>
									</apex:panelGrid>
							</apex:pageblockSectionItem>
						</apex:pageblockSection>						
					</apex:pageBlock>
				</apex:outputPanel>
			</apex:form>
	
	
		</apex:outputPanel></div>
			<script>
				function decideHide()
				{
					if($('.DisplayType').val()!='{!JSINHTMLENCODE(DisplayTypeDropDownEnum)}')
					{
						$('.SelectedValuePanel').css('display','none');
					}
					else
					{
						$('.SelectedValuePanel').css('display','block');
						
						var selectedvalues=$('.TimeCategoryValues').val().split(',');
						$('#SelectedValues').html('');
						for(i in selectedvalues)
						{
						if(selectedvalues[i]!='')
							$('#SelectedValues').append($('<option></option>').attr('value',selectedvalues[i]).text(selectedvalues[i])); 
						}
					
					}
					decideDisableSaveButton();
				}
				function beforeSave()
				{
					if($('.DisplayType').val()!='{!JSINHTMLENCODE(DisplayTypeDropDownEnum)}')
					{
						$('.TimeCategoryValues').val('');
					}
					else
					{
						var selectedvalues='';
						$("#SelectedValues option").each(function(key,value)
						{
							selectedvalues+=$(this).val();
							if($("#SelectedValues option").length!=(key+1))
							selectedvalues+=',';
							
						});
						$('.TimeCategoryValues').val(selectedvalues);
					}
				}
				function decideDisableSaveButton()
				{
					if($('.DisplayType').val()=='{!JSINHTMLENCODE(DisplayTypeDropDownEnum)}' && $("#SelectedValues option").length==0)
						DisableButton('SaveButton');
					else
						EnableButton('SaveButton');
				}
			</script>
	</apex:define>

</apex:composition>
 
</apex:page>