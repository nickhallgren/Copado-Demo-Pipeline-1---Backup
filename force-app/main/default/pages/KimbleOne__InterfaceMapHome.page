	{
		return addTransformationTypeValueWithAddBtnFields(isAtBottom,sourceId,withTransVal,transValLabel,addButton,[],removeButton,itemLabel)
	}
	//setup with add button that generate muiltiple values
	var sourceTypeCount = 0;
	function addTransformationTypeValueWithAddBtnFields(isAtBottom,sourceId,withTransVal,transValLabel,addButton,fieldsToAddArrLabel,removeButton,itemLabel)
	{
		transCount++;
		sourceTypeCount++;
		var tr=jQuery('<tr>');
 		tr.attr('item',transCount);
 		tr.attr('sourceitem',sourceTypeCount);
 		if(isAtBottom)
 			tr.addClass('AtBottom');
 		tr.append(jQuery('<td>').text(itemLabel));
 		tr.append(jQuery('<td>').html(jQuery('.TransformationPanel').html()));
 		tr.find('.SourceTypeItem').next().attr('sourceitem',sourceTypeCount);
 		tr.find('.SourceTypeItem').next().find('option[value="{!GetTransformationInterfaceFieldMapSourceTypeId}"]').remove();
 		tr.find('.SourceTypeItem').next().change(function(){decideHideSourceTypeOutItem(jQuery(this).attr('sourceitem'))});
 		tr.find('.AddTransformationValueButton').css('display',addButton?'':'none').attr('label',transValLabel).attr('sourceId',sourceId)
 				.attr('fieldlabels',fieldsToAddArrLabel.toString());
 		tr.find('.RemoveTransformationValueButton').css('display',removeButton?'':'none');
 		
 		if(withTransVal)
 		{
 			tr.find('.TransformationValue').show();
 			tr.find('.TransformationValue').attr('label',transValLabel);
 		}
 		else
 			tr.find('.TransformationValue').hide();
 		
 		if(isAtBottom)
 		{ 
 			if(jQuery('.TransformationTypeTable.'+sourceId+'>tbody>tr.AtBottom').length==0)
 				jQuery('.TransformationTypeTable.'+sourceId).append(tr);
 			else
 				tr.insertAfter(jQuery(jQuery('.TransformationTypeTable.'+sourceId+'>tbody>tr.AtBottom')[0]));	
		}
		else
		{
			if(jQuery('.TransformationTypeTable.'+sourceId+'>tbody>tr.AtBottom').length==0)
 				jQuery('.TransformationTypeTable.'+sourceId).append(tr);
 			else
 				tr.insertBefore(jQuery(jQuery('.TransformationTypeTable.'+sourceId+'>tbody>tr.AtBottom')[0]));	
		}
 		if(removeButton)
 		{
 			showLabel(jQuery('.SourceValueOutItem'));
			showLabel(jQuery('.SourceFieldOutItem'));
			showLabel(jQuery('.TransformationValue'));
 		}
 		
 		
		var sourceType = jQuery('#InterfaceSource').find('option[value="'+sourceId+'"]').attr('object');
		tr.find('.SourceFieldOutItem').fieldSelector({rootObject:sourceType});
		
 		decideHideSourceTypeOutItem(tr.attr('sourceitem'));
 		return tr;
	}
