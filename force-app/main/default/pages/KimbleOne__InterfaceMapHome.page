		function setAvaPositions()
		{
			var calcCurrentlySelectedKey=currentlySelectedKey; 
			if(currentlySelectedKey!=undefined && entryType == 'VIS')
		 	{
		 		if(!containsVIS() || currentlySelectedKey<0 )
		 			calcCurrentlySelectedKey = 1;
		 		else if(currentlySelectedKey>0)
		 			calcCurrentlySelectedKey=parseInt(currentlySelectedKey)+1;
		 					
		 	}
		 	else if(currentlySelectedKey!=undefined && entryType == 'VAR')
		 	{
		 		if(!containsVAR() || currentlySelectedKey>0)
	 				calcCurrentlySelectedKey = 0;
	 		}
		
			jQuery.each(jQuery('.InterfaceFieldMapsList>option'),function(key,obj){
		 		if(parseInt(jQuery(obj).val())>=parseInt(calcCurrentlySelectedKey))
		 			jQuery(obj).attr('disabled','disabled');
		 		else
		 			jQuery(obj).removeAttr('disabled');
		 		
		 	});
		
			jQuery.each(jQuery('.InterfaceFieldMapsListItem>option'),function(key,obj){
		 		if(parseInt(jQuery(obj).val())>=parseInt(calcCurrentlySelectedKey))
		 			jQuery(obj).attr('disabled','disabled');
		 		else
		 			jQuery(obj).removeAttr('disabled');
		 		
		 	});
		 	
		 	
		}
		var transCount=0;
	function addTransformationTypeValueWithValueMuiliple(isAtBottom,sourceId,withTransVal,transValLabel,addButton,removeButton,values)
	{
		transCount++;
		if(values.length >0)
		{
			var labelsList = [];
			jQuery.each(values,function(key,value){
				labelsList.push(value.Label);
			});
			jQuery.each(values,function(key,value){
				if(key==0)
				{
					var tr = addTransformationTypeValueWithValue(isAtBottom,sourceId,withTransVal,transValLabel,addButton,false,value.Label,value);
					tr.find('.AddTransformationValueButton').attr('fieldlabels',labelsList.toString());
				}
				else
					addTransformationTypeValueWithValue(isAtBottom,sourceId,withTransVal,transValLabel,false,removeButton,value.Label,value);
				
				transCount--;
			});
		}
		
	}	
	function addTransformationTypeValueWithValue(isAtBottom,sourceId,withTransVal,transValLabel,addButton,removeButton,itemLabel,value)
	{
		var tr = addTransformationTypeValue(isAtBottom,sourceId,withTransVal,transValLabel,addButton,removeButton,itemLabel);
		if(value.Type == 'Literal')
	 	{
	 		tr.find('.SourceValueOutItem').val(value.Value);
	 		tr.find('.SourceValueOutItem').show();
	 		tr.find('.InterfaceFieldMapsListItem').hide();
	 		tr.find('.SourceFieldOutItem').hide();
	 		tr.find('.SourceTypeItem').val('{!JSINHTMLENCODE(GetLiteralInterfaceFieldMapSourceTypeId)}');
	 		tr.find('.SourceTypeItem').next().val('{!JSINHTMLENCODE(GetLiteralInterfaceFieldMapSourceTypeId)}');
		}
		else if(value.Type == 'Numeric')
	 	{
	 		tr.find('.SourceValueOutItem').val(value.Value);
	 		tr.find('.SourceValueOutItem').show();
	 		tr.find('.InterfaceFieldMapsListItem').hide();
	 		tr.find('.SourceFieldOutItem').hide();
	 		tr.find('.SourceTypeItem').val('{!JSINHTMLENCODE(GetNumericInterfaceFieldMapSourceTypeId)}');
	 		tr.find('.SourceTypeItem').next().val('{!JSINHTMLENCODE(GetNumericInterfaceFieldMapSourceTypeId)}');
		}
	 	else if(value.Type == 'Position')
	 	{
	 		tr.find('.InterfaceFieldMapsListItem').val(value.Value);
	 		tr.find('.InterfaceFieldMapsListItem').show();
	 		tr.find('.SourceFieldOutItem').hide();
	 		tr.find('.SourceTypeItem').val('{!JSINHTMLENCODE(GetPositionInterfaceFieldMapSourceTypeId)}');
			tr.find('.SourceTypeItem').next().val('{!JSINHTMLENCODE(GetPositionInterfaceFieldMapSourceTypeId)}');
		}
		else if(value.Type == 'Field')
	 	{
	 		tr.find('.SourceFieldOutItem').val(value.Value);
	 		tr.find('.SourceFieldOutItem').show();
	 		tr.find('.SourceTypeItem').val('{!JSINHTMLENCODE(GetFieldInterfaceFieldMapSourceTypeId)}');
			tr.find('.SourceTypeItem').next().val('{!JSINHTMLENCODE(GetFieldInterfaceFieldMapSourceTypeId)}');
			tr.find('.SourceValueOutItem').hide();
			tr.find('.InterfaceFieldMapsListItem').hide();
		}
	 	if(value.TransformationValue!=undefined)
	 	{
	 		tr.find('.TransformationValue').val(value.TransformationValue);
	 		tr.find('.TransformationValue').show();
	 	
	 	}
	 	return tr;
	}
	//called from add button, for muiltiples values
	function addTransformationTypeValueMuiltiple(isAtBottom,sourceId,withTransVal,transValLabel,addButton,fieldsToAddArrLabel,removeButton,itemLabel)
	{
		transCount++;
		if(fieldsToAddArrLabel.length >0)
		{
			jQuery.each(fieldsToAddArrLabel,function(key,value){
				if(key == 0)
					addTransformationTypeValueWithAddBtnFields(isAtBottom,sourceId,withTransVal,transValLabel,addButton,fieldsToAddArrLabel,false,value);
				else
					addTransformationTypeValueWithAddBtnFields(isAtBottom,sourceId,withTransVal,transValLabel,addButton,fieldsToAddArrLabel,removeButton,value);
				transCount --;
			});
		}
		else
		{
			addTransformationTypeValue(isAtBottom,sourceId,withTransVal,transValLabel,addButton,removeButton,itemLabel)
		}
		
	}
