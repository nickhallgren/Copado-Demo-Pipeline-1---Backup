	var linesWithFieldsErrors = {};
	function validateQuery(fieldWithLines)
	{

		if(fieldWithLines.length >0)
		{
			var aField = fieldWithLines.shift();
			
			var sourceObject = $('#InterfaceSource>option[value='+aField.SourceId+']').attr('object');
			//var interfaceTypeEnum = sforce.connection.query("SELECT Enum__c FROM InterfaceType__c WHERE Id = "+theMap.InterfaceTypeId;
			if (sourceObject != undefined){
			 	var result = sforce.connection.query("SELECT "+aField.Value+" FROM "+sourceObject+" LIMIT 1" , {
		      		onSuccess : function(result) {
		      			if(result.done != "true")
		      				linesWithFieldsErrors[aField.Id]=aField.Id;
		      			validateQuery(fieldWithLines);	
		            },
		      		onFailure : function(error) {
		      		 linesWithFieldsErrors[aField.Id]=aField.Id;
		       		 console.log("error has occurred " + error);
		       		 validateQuery(fieldWithLines);
		     	 	}
		  		});
	  		}else{

	  			var relatedObjectCol = {
	  				"ExpenseItemImport" : {value: 0, name:"ExpenseItemImport", impObj: KimbleNamespaceWithUnderscores + "ExpenseItemImportLine__c"},
	  				"TimeEntryImport" : {value: 1, name:"TimeEntryImport", impObj: KimbleNamespaceWithUnderscores + "TimeEntryImportLine__c"},
	  				"AnalysisItemImport" : {value: 2, name:"AnalysisItemImport", impObj: KimbleNamespaceWithUnderscores + "AnalysisItemImportLine__c"},
	  				"PlainObjectImport" : {value: 3, name:"PlainObjectImport", impObj: theTypeObjectType},
	  				"UpdateResourceCalendar" : {value: 4, name:"UpdateResourceCalendar", impObj: KimbleNamespaceWithUnderscores + "AssignmentScheduleImportLine__c"},
	  				"SupplierInvoiceStatement" : {value: 5, name:"SupplierInvoiceStatement", impObj: KimbleNamespaceWithUnderscores + "SupplierInvoiceStatementLine__c"},
	  				"ActivityAssignmentImport" : {value: 6, name:"ActivityAssignmentImport", impObj: KimbleNamespaceWithUnderscores + "ActivityAssignmentImportLine__c"},
	  				"InterfaceRunLineObject" : {value: 7, name:"InterfaceRunLine__c", impObj: KimbleNamespaceWithUnderscores + "InterfaceRunLine__c"}
	  			};

  				var relatedObj = relatedObjectCol[theTypeEnum].impObj;
  				if(aField.Enum == 'InterfaceRunLineObject')
  					relatedObj = relatedObjectCol['InterfaceRunLineObject'].impObj;
	  			
	  			var result = sforce.connection.query("SELECT "+aField.Value+" FROM "+relatedObj+" LIMIT 1" , {
		      		onSuccess : function(result) {
		      			if(result.done != "true")
		      				linesWithFieldsErrors[aField.Id]=aField.Id;
		      			validateQuery(fieldWithLines);	
		            },
		      		onFailure : function(error) {
		      		 if(aField.Enum != 'InterfaceRunLineObject'){
		      		     aField.Enum = 'InterfaceRunLineObject';
		      		     fieldWithLines.push(aField);
		      		 }
           			 else{
		      		 	linesWithFieldsErrors[aField.Id]=aField.Id;
		       		 	console.log("error has occurred " + error);
		       		 }
		       		 validateQuery(fieldWithLines);
		       		}
		  		});		  		
	  		}
		}
		else
		{
	 		var linesWithFieldsErrorsArr = Object.keys(linesWithFieldsErrors);
		 	if(linesWithFieldsErrorsArr.length > 0)
		 	{
		 		jQuery('#InterfaceMapErrorsMsg').html("Field Validations Failed! Errors on lines:" +linesWithFieldsErrorsArr.toString());
		 		jQuery('#InterfaceMapErrors').show();
		 	}
		 	else
		 		alert("Field Validations Passed!");
		 	       				 
        	EnableButton('SaveButton');
        	EnableButton('ValidateButton');
			jQuery('.ButtonLoading').hide();
		 	
	 	}				
	}
	
	function validateInterfaceMapForFieldErrors()
	{
		jQuery('#InterfaceMapErrors').hide();
       	DisableButton('SaveButton');
       	DisableButton('ValidateButton');
		jQuery('.ButtonLoading').show();	
		
		linesWithFieldsErrors = {};
		var fieldWithLines = [];
		jQuery.each(getSortInterfaceFieldMapsHash(true),function(key,fieldMap){
				if(fieldMap.SourceFieldMapValues != undefined && theInterfaceTypeId=='OutboundInterfaceRun')
				{
					jQuery.each(fieldMap.SourceFieldMapValues,function(k,fieldMapItem){
	 					if(fieldMapItem.SourceTypeId == '{!JSINHTMLENCODE(GetFieldInterfaceFieldMapSourceTypeId)}')
	 					{
	 						var lineObj= {};
	 						lineObj.SourceId = fieldMapItem.InterfaceSourceId;
	 						lineObj.Value = fieldMapItem.SourceValue;
	 						lineObj.Id = fieldMap.DestinationFieldPosition;
	 						fieldWithLines.push(lineObj);
	 					}
	 					else if(fieldMapItem.SourceTypeId == '{!JSINHTMLENCODE(GetTransformationInterfaceFieldMapSourceTypeId)}')
	 					{
	 						var transformationJsonObject =  jQuery.parseJSON(jQuery('<span>').text(fieldMapItem.SourceValue).text());
			 				jQuery.each(transformationJsonObject,function(k,obj){
			 					
			 					if(obj==null || typeof obj == 'number' || typeof obj == 'string')
			 						return;
			 					
			 					if(obj.InputTypeEnum!=undefined && obj.InputTypeEnum == 'Field')
			 					{
			 						var lineObj= {};
	 								lineObj.SourceId = fieldMapItem.InterfaceSourceId;
	 								lineObj.Value = obj.Value;
	 								lineObj.Id = fieldMap.DestinationFieldPosition;
	 								fieldWithLines.push(lineObj);
	 							}
			 					
			 					jQuery.each(obj,function(k,obj1){
					 					if(obj1==null || typeof obj1 == 'number' || typeof obj1 == 'string')
					 						return;
					 					if(obj1.InputTypeEnum!=undefined && obj1.InputTypeEnum == 'Field')
					 					{
					 						var lineObj= {};
	 										lineObj.SourceId = fieldMapItem.InterfaceSourceId;
	 										lineObj.Value = obj1.Value;
	 										lineObj.Id = fieldMap.DestinationFieldPosition;
	 										fieldWithLines.push(lineObj);
		 								}
					 					
					 					jQuery.each(obj1,function(k,obj2){
					 					if(obj2==null || typeof obj2 == 'number' || typeof obj2 == 'string')
					 						return;
					 					if(obj2.InputTypeEnum!=undefined && obj2.InputTypeEnum == 'Field')
					 					{
					 						var lineObj= {};
	 										lineObj.SourceId = fieldMapItem.InterfaceSourceId;
	 										lineObj.Value = obj2.Value;
	 										lineObj.Id = fieldMap.DestinationFieldPosition;
	 										fieldWithLines.push(lineObj);
		 								}	
			 						});	
				 						
			 					});	 
	 											
	 						});
	 						
	
	 					}
		 			});
		 		}else{
		 		
		 			var lineObj= {};
					lineObj.Value = fieldMap.DestinationFieldName;
					lineObj.Id = fieldMap.OriginalKey;
					lineObj.Enum = theTypeEnum;
					fieldWithLines.push(lineObj);
		 		
		 		}
		 		
		 	});	
		 	
		 	
		 	
		 	validateQuery(fieldWithLines);
		 	
		 	
		 	
		 	
       				 	
	}	
		</script>
