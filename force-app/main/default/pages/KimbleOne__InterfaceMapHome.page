	var aggCount=0;
	function addAggregateWithValue(addButton,removeButton,value)
	{
		var tr = addAggregate(addButton,removeButton);
		tr.find('.AggPosition').val(value.WhenPosition);
		tr.find('.AggEquals').val(value.Equals);
		tr.find('.AggFunction').val(value.FunctionEnum);
	}
	function addAggregate(addButton,removeButton)
	{
		aggCount++;
		var tr=jQuery('<tr>');
 		tr.attr('item',aggCount);
 		tr.append(jQuery('<td>').html(jQuery('.AggregatePanel').html()));
 		tr.find('.AddAggregateButton').css('display',addButton?'':'none');
 		tr.find('.RemoveAggregateButton').css('display',removeButton?'':'none');
 		
 		jQuery('.AggregateTable').append(tr);
 		return tr;
	}
	function decideGroupingType(obj)
	{
		jQuery('.AggregateTable>tbody>tr').remove();
		if(obj.val() == 'Aggregate')
		{
			 addAggregate(WITH_ADDBTN,WITHOUT_REMBTN)
		}
	}
	function showLabel(objs)
	{
		jQuery.each(objs,function(key,obj){
			if(jQuery(obj).val()=='' || jQuery(obj).val()==jQuery(obj).attr('label'))
			{
				jQuery(obj).val(jQuery(obj).attr('label'));
				jQuery(obj).css('color','#666666');
			}
			else 
			{
				jQuery(obj).css('color','#000000');
			}
		});
	}
	function removeLabel(objs)
	{
		jQuery.each(objs,function(key,obj){
			if(jQuery(obj).val()==jQuery(obj).attr('label'))
			{	
				jQuery(obj).val('');
				jQuery(obj).css('color','#000000');
			}
		});
	}	
	function sortInterfaceFieldMapsHash() 
	{
		var theInterfaceFieldMapsHashNew = {};
		var mapPositionToSet = {};
		var pos = [];
    	jQuery.each(theInterfaceFieldMapsHash,function(key,fieldMap){
    		 pos.push(theInterfaceFieldMapsHash[key].DestinationFieldPosition);
        	 mapPositionToSet[theInterfaceFieldMapsHash[key].DestinationFieldPosition] = key;
    	});
    	
    	var possort = pos.sort(function(a, b){return a-b});
    	jQuery.each(possort,function(i,po){
    		var key = mapPositionToSet[po];
      		var value = theInterfaceFieldMapsHash[key];
      		theInterfaceFieldMapsHashNew[po] = value;
    	});
    	
    	theInterfaceFieldMapsHash = {};
		
    	jQuery.each(theInterfaceFieldMapsHashNew,function(key,fieldMap){
    		  theInterfaceFieldMapsHash[key] = fieldMap;
    	});
	}
	
	//override to force array to be retruned when validating inbound maps
	function getSortInterfaceFieldMapsHash() 
	{
		return getSortInterfaceFieldMapsHash(false);
	}
	
	function getSortInterfaceFieldMapsHash(returnArray) 
	{
		var theInterfaceFieldMapsHashNew = [];
		jQuery.each(theInterfaceFieldMapsHash,function(key,fieldMap){
    		fieldMap.OriginalKey = key;
    		theInterfaceFieldMapsHashNew.push(fieldMap);
     	});
		
		if(theInterfaceTypeId=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}' || returnArray)
    		return theInterfaceFieldMapsHashNew.sort(function(a, b){return a.DestinationFieldPosition-b.DestinationFieldPosition});
    	else
    		return theInterfaceFieldMapsHashNew;
	}
	
		
