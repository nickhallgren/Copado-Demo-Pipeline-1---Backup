		}
		function getReferencedPositions()
		{
			referencedPositions = {};
			jQuery.each(getSortInterfaceFieldMapsHash(),function(key,fieldMap){
				if(fieldMap.SourceFieldMapValues != undefined)
				{
					jQuery.each(fieldMap.SourceFieldMapValues,function(k,fieldMapItem){
	 					if(fieldMapItem.SourceTypeId == '{!JSINHTMLENCODE(GetPositionInterfaceFieldMapSourceTypeId)}')
	 					{
	 						var po = parseInt(fieldMapItem.SourceValue);
	 						referencedPositions[po] = po;
	 					}
	 					else if(fieldMapItem.SourceTypeId == '{!JSINHTMLENCODE(GetTransformationInterfaceFieldMapSourceTypeId)}')
	 					{
	 						var transformationJsonObject =  jQuery.parseJSON(jQuery('<span>').text(fieldMapItem.SourceValue).text());
			 				jQuery.each(transformationJsonObject,function(k,obj){
			 					
			 					if(obj==null || typeof obj == 'number' || typeof obj == 'string')
			 						return;
			 					
			 					if(obj.InputTypeEnum!=undefined && obj.InputTypeEnum == 'Position')
			 					{
			 						var po = parseInt(obj.Value);
	 								referencedPositions[po] = po;
			 					}
			 					
			 					jQuery.each(obj,function(k,obj1){
				 					if(obj1==null || typeof obj1 == 'number' || typeof obj1 == 'string')
				 						return;
				 					if(obj1.InputTypeEnum!=undefined && obj1.InputTypeEnum == 'Position')
				 					{
				 						var po = parseInt(obj1.Value);
	 									referencedPositions[po] = po;
				 					}
				 					
				 					jQuery.each(obj1,function(k,obj2){
				 					if(obj2==null || typeof obj2 == 'number' || typeof obj2 == 'string')
				 						return;
				 					if(obj2.InputTypeEnum!=undefined && obj2.InputTypeEnum == 'Position')
				 					{
				 						var po = parseInt(obj2.Value);
	 									referencedPositions[po] = po;
				 					}	
			 					});	
				 						
			 					});	 
	 											
	 						});
	 						
	
	 					}
		 			});
		 		}
		 		if(fieldMap.Aggregate != undefined)
		 		{
		 			jQuery.each(fieldMap.Aggregate.Conditions,function(k,cond){
		 				referencedPositions[parseInt(cond.WhenPosition)] = parseInt(cond.WhenPosition);
		 			});
		 		}
		 	});	
		 	return referencedPositions;
		}
		//onload Call GetInterfaceMap to get InterfaceMap
		function getInterfaceMap(id)
		{
			DisableButton('SaveButton');
			jQuery('.ButtonLoading').show();
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InterfaceMapHomeController.GetInterfaceMap}',id,
        		function(result, event){
 			
 				theMap = result;
 				decideHide('{!JSINHTMLENCODE(aInterfaceType.Enum__c)}');
 				jQuery('#Name').val(theMap.Name);
 				
 				
 				jQuery('#ShowHeader').prop('checked', theMap.ShowHeader);
 				jQuery('[id$="MapFormat"]').val(theMap.MapFormat);
 				jQuery('#FieldDelimiter').val(theMap.FieldDelimiter);
 				
 				jQuery('#GroupByFields').val(theMap.GroupByFields);
 				var groupBy = {};
 				if(theMap.GroupByFields!=undefined && theMap.GroupByFields!=null && theMap.GroupByFields!='')
 				{
 					jQuery.each(theMap.GroupByFields.split(','),function(key,value){
 						groupBy[value] = parseInt(value);
 					});
 				}
 				jQuery('#GroupDelimiter').val(theMap.GroupDelimiter);

 				if(theMap.MapContext != undefined)
 					theMap.MapContext = jQuery('<span>'+theMap.MapContext+'</span>').text();
 				jQuery('#MapContext').val(theMap.MapContext);

 				if(theMap.AggregateFields!=undefined)
 					theMap.AggregateFields = jQuery('<span>'+theMap.AggregateFields+'</span>').text();
 				jQuery('#AggregateFields').val(theMap.AggregateFields);

 				aggregates = {};
 				if(theMap.AggregateFields!=undefined && theMap.AggregateFields!=null && theMap.AggregateFields!='')
 				{
	 				var aggregatesList = jQuery.parseJSON(theMap.AggregateFields);
	 				jQuery.each(aggregatesList,function(key,value){
	 					aggregates[value.FieldPosition] = value;
	 				});
 				}
 				jQuery('#RecordStartLine').val(theMap.RecordStartLine);
 				jQuery('#RecordBatchSize').val(theMap.RecordBatchSize);
 				jQuery('[id$="CurrencyISOCode"]').val(theMap.CurrencyISOCode);
 				theInterfaceFieldMapsHash={};
 				var maxKey=0;
 				fieldMapCount = 1;
 				jQuery.each(theMap.FieldMaps,function(key,fieldMap){
 					var id = '{!JSINHTMLENCODE(aInterfaceType.Enum__c)}'=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}'?fieldMap.DestinationFieldPosition:fieldMapCount;
 					theInterfaceFieldMapsHash[id]=fieldMap;
 					if(groupBy[id] != undefined )
 						theInterfaceFieldMapsHash[id].Grouping = 'GroupBy';
 					if(aggregates[id] != undefined )
 					{
 						theInterfaceFieldMapsHash[id].Grouping = 'Aggregate';
 						theInterfaceFieldMapsHash[id].Aggregate = aggregates[id];
 					}	
 					fieldMapCount++;
 					if(id>maxKey)
 						maxKey=id;
 				});
 				if(currentlySelectedKey==undefined)
 					currentlySelectedKey = maxKey;
 				
 				updateTableView();
 				
 				
 				if(result==null && event.type=='exception')
       			{
       				jQuery('#InterfaceMapErrors').show();
       				jQuery('#InterfaceMapErrorsMsg').html(event.message);
       			}
       			else
       			{
       				jQuery('#InterfaceMapErrors').hide();
       			}		
        		EnableButton('SaveButton');
				jQuery('.ButtonLoading').hide();
 				
 				//populateMapFields
 				
 				//create fields list
 				});
		}
		
		function saveInterfaceMap()
		{
			jQuery('#InterfaceMapErrors').hide();
			if(!validateMap(jQuery('#Name')))
				return;
				
			if('{!JSINHTMLENCODE(aInterfaceType.Enum__c)}'=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
			{		
				if(!validateMap(jQuery('#FieldDelimiter')))
					return;
			}	
			
			DisableButton('SaveButton');
       		DisableButton('ValidateButton');
       		jQuery('.ButtonLoading').show();
			theMap.Name=jQuery('#Name').val();
			theMap.InterfaceTypeId='{!JSINHTMLENCODE(aInterfaceType.Id)}';
			theMap.MapFormat = jQuery('[id$="MapFormat"]').val();
			
			if('{!JSINHTMLENCODE(aInterfaceType.Enum__c)}'=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
			{
				theMap.ShowHeader=jQuery('#ShowHeader').prop('checked');
				theMap.FieldDelimiter=jQuery('#FieldDelimiter').val();
				theMap.GroupByFields=jQuery('#GroupByFields').val();
	 			theMap.GroupDelimiter=jQuery('#GroupDelimiter').val();
	 			theMap.MapContext=jQuery('#MapContext').val();
	 			theMap.AggregateFields=jQuery('#AggregateFields').val();
	 		}
			else
			{
				theMap.RecordStartLine=parseInt(jQuery('#RecordStartLine').val());
	 			theMap.RecordBatchSize=parseInt(jQuery('#RecordBatchSize').val());
	 			theMap.CurrencyISOCode=jQuery('[id$="CurrencyISOCode"]').val();
	 			theMap.ShowHeader = false;
	 		}
		
			theMap.FieldMaps = new Array();
			var counterField=0;
			jQuery.each(theInterfaceFieldMapsHash,function(key,fieldMap){
				fieldMap.OriginalKey = undefined;
				fieldMap.Grouping = undefined;
				fieldMap.Aggregate = undefined;
				theMap.FieldMaps[counterField] = fieldMap;
				counterField++;
			});
		
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InterfaceMapHomeController.SaveInterfaceMap}',theMap,
        		function(result, event){
       				 if(result==null && event.type=='exception')
       				 {
       				 	jQuery('#InterfaceMapErrors').show();
       				 	jQuery('#InterfaceMapErrorsMsg').html(event.message);
       				 }
       				 else
       				 {
       				 	jQuery('#InterfaceMapErrors').hide();
       				 	theMapId = result;
       				 	getInterfaceMap(theMapId);
       				 }		
        			EnableButton('SaveButton');
        			EnableButton('ValidateButton');
			
					jQuery('.ButtonLoading').hide();
		
        		});
 		}
 		var interfaceMapFieldCurrentPos;
 		function editInterfaceMapField(id)
 		{
 			jQuery('#InterfaceFieldMapId').val(id);
 			selectCurrentKey(id);
 			var interfaceFieldMap=theInterfaceFieldMapsHash[id];
 			jQuery('#DestinationFieldName').val(interfaceFieldMap.DestinationFieldName);
 			jQuery('#IsMandatory').prop('checked',interfaceFieldMap.IsMandatory);
 			
 			if(theInterfaceTypeId!='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
 			{
 				jQuery('#SourceFieldName').val(interfaceFieldMap.SourceFieldName);
 				jQuery('#DestinationFieldLookupKeyFieldName').val(interfaceFieldMap.DestinationFieldLookupKeyFieldName);
 				jQuery('#SourceType').val(interfaceFieldMap.SourceTypeId);
 				jQuery('#SourceType').next().val(interfaceFieldMap.SourceTypeId);
 				jQuery('#SourceValue').val(interfaceFieldMap.SourceValue);
 				jQuery('#SourceFieldPositions').val(interfaceFieldMap.SourceFieldPositions);
 				
 			}
 			else
 			{
				jQuery('.TransformationTypeTable>tbody>tr').remove();
				jQuery('.AggregateTable>tbody>tr').remove();
				interfaceMapFieldCurrentPos = interfaceFieldMap.DestinationFieldPosition;

				if (interfaceFieldMap.SourceFieldMapValues['{!$ObjectType.OutboundInterfaceRequest__c.Name}'] != null) {
					jQuery.ionTabs.setTab('Tabs_Group_name', '{!$ObjectType.OutboundInterfaceRequest__c.Name}');
				}

				jQuery.each(jQuery('.InterfaceSource'),function(key,fieldItem){
				 	
				 	var fieldItemObj = interfaceFieldMap.SourceFieldMapValues[jQuery(fieldItem).attr('sourceid')];
				 	if (fieldItemObj == undefined) fieldItemObj = {};
				 		
					jQuery(fieldItem).find('.InterfaceFieldMapsList').val('');
		 			jQuery(fieldItem).find('.SourceValueOut').val('');
		 			jQuery(fieldItem).find('.SourceFieldOut').val('');
					jQuery(fieldItem).find('.InterfaceFieldMapsList').hide();
		 			jQuery(fieldItem).find('.SourceValueOut').hide();
		 			jQuery(fieldItem).find('.SourceFieldOut').hide();
					
					var sourceId = jQuery(fieldItem).attr('sourceId');
					jQuery(fieldItem).find('.SourceTypeOut').val(fieldItemObj.SourceTypeId);
					jQuery(fieldItem).find('.SourceTypeOut').next().val(fieldItemObj.SourceTypeId);
					if(fieldItemObj.SourceTypeId=='{!JSINHTMLENCODE(GetLiteralInterfaceFieldMapSourceTypeId)}')
		 			{
		 				jQuery(fieldItem).find('.SourceValueOut').val(fieldItemObj.SourceValue);
		 				jQuery(fieldItem).find('.SourceValueOut').show();
		 			}
					else if(fieldItemObj.SourceTypeId=='{!JSINHTMLENCODE(GetNumericInterfaceFieldMapSourceTypeId)}')
		 			{
		 				jQuery(fieldItem).find('.SourceValueOut').val(fieldItemObj.SourceValue);
		 				jQuery(fieldItem).find('.SourceValueOut').show();
		 			}
		 			else if(fieldItemObj.SourceTypeId=='{!JSINHTMLENCODE(GetPositionInterfaceFieldMapSourceTypeId)}')
		 			{
		 				jQuery(fieldItem).find('.InterfaceFieldMapsList').val(fieldItemObj.SourceValue);
		 				jQuery(fieldItem).find('.InterfaceFieldMapsList').show();
		 			}
			 		else if(fieldItemObj.SourceTypeId=='{!JSINHTMLENCODE(GetFieldInterfaceFieldMapSourceTypeId)}')
		 			{
		 				jQuery(fieldItem).find('.SourceFieldOut').val(fieldItemObj.SourceValue);
		 				jQuery(fieldItem).find('.SourceFieldOut').show();
		 			}
			 		else if(fieldItemObj.SourceTypeId=='{!JSINHTMLENCODE(GetTransformationInterfaceFieldMapSourceTypeId)}')
		 			{
		 				jQuery(fieldItem).find('.TransfornationTypeOut').show();
		 				jQuery(fieldItem).find('.TransfornationTypeOut').val(fieldItemObj.TransformationTypeId);
		 				var transformationJsonObject =  jQuery.parseJSON(jQuery('<span>').text(fieldItemObj.SourceValue).text());
		 				
		 				
		 				if(fieldItemObj.TransformationTypeId == '{!JSINHTMLENCODE(FormatTransformationType)}') // has one value
						{
							var value = {};
							value.Value= transformationJsonObject.Value.Value;
							value.Type= transformationJsonObject.Value.InputTypeEnum;
							value.TransformationValue= transformationJsonObject.DateFormat;
							
							addTransformationTypeValueWithValue(AT_TOP,sourceId,WITH_TRANSVAL,'-DateFormat-',WITHOUT_ADDBTN,WITHOUT_REMBTN,NO_LBL,value);
	 					}
	 					else if(fieldItemObj.TransformationTypeId == '{!JSINHTMLENCODE(SetScaleTransformationType)}' )
	 					{
	 						var value = {};
							value.Value= transformationJsonObject.Value.Value;
