 		function moveUp(id)
 		{
 			var currentKey = id;
 			var currentInterfaceField = jQuery.extend(true,{},theInterfaceFieldMapsHash[id]);
 			var previousKey = getPreviousKey(id);
 			if(previousKey == undefined)
 				return;
 			var previousInterfaceField = jQuery.extend(true,{},theInterfaceFieldMapsHash[previousKey]);	
 			
 			
 			if(theInterfaceTypeId=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
	 		{
	 			currentInterfaceField.DestinationFieldPosition = previousKey;
 				previousInterfaceField.DestinationFieldPosition = id;
 			}
 			
 			if(!updateMove(currentKey,previousKey,currentInterfaceField))
 				return;
 			
 		
 			
 			currentlySelectedKey = previousKey;
 			theInterfaceFieldMapsHash[previousKey] =  currentInterfaceField;
 			theInterfaceFieldMapsHash[id] =  previousInterfaceField;
 			
 			updateTableView();
 		}
 		function moveDown(id)
 		{
 			var currentInterfaceField = jQuery.extend(true,{},theInterfaceFieldMapsHash[id]);
 			var nextKey = getNextKey(id);
 			if(nextKey == undefined)
 				return;
 			
 			var nextInterfaceField = jQuery.extend(true,{},theInterfaceFieldMapsHash[nextKey]);	
 			
 			if(theInterfaceTypeId=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
	 		{
	 			currentInterfaceField.DestinationFieldPosition = nextKey;
 				nextInterfaceField.DestinationFieldPosition = id;
 			}
 			
 			if(!updateMove(id,nextKey,currentInterfaceField))
 				return;
 				
 			currentlySelectedKey = nextKey;
 			theInterfaceFieldMapsHash[nextKey] =  currentInterfaceField;
 			theInterfaceFieldMapsHash[id] =  nextInterfaceField;
 			
 			updateTableView();
 		}
 		
