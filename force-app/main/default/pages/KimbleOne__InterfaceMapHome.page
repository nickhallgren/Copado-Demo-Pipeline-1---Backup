 		function getPreviousKey(curkey)
 		{
 			var previousKey;
 			jQuery.each(getSortInterfaceFieldMapsHash(),function(key,fieldMap){
	 			var shouldFinish = false;
	 			if(curkey == parseInt(fieldMap.OriginalKey))
	 				shouldFinish = true;
	 			if(!shouldFinish)
	 				previousKey = parseInt(fieldMap.OriginalKey);
	 			return (!shouldFinish);
	 		});
	 		return previousKey;
 		
 		}
 		
 		function getNextKey(curkey)
 		{
 			var readyForNext = false;
 			var nextKey;
 			jQuery.each(getSortInterfaceFieldMapsHash(),function(key,fieldMap){
	 			var isFinished=false;
	 			if(readyForNext)
	 			{
	 				nextKey = parseInt(fieldMap.OriginalKey);
	 				isFinished = true;
	 			}
	 			if(curkey == fieldMap.OriginalKey)
	 				readyForNext = true;
	 			return (!isFinished);
	 		});
	 		
	 		return nextKey;
 		}
