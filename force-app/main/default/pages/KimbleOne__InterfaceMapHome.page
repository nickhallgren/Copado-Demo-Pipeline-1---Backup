 		function decideHideSourceFieldPositionsCol()
 		{
 			if(jQuery('#RecordStartLine').val() == '')
 			{
 				jQuery('.SourceFieldPositionsCol').hide();
 				jQuery('.SourceFieldNameCol').show();
 			}
 			else
 			{
 				jQuery('.SourceFieldPositionsCol').show();
 				jQuery('.SourceFieldNameCol').hide();
 			}
 					
 			if(theInterfaceTypeId=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
			{
				jQuery('.OutPanelCol').show();
				jQuery('.InPanelCol').hide();
			}
			else
			{
				jQuery('.OutPanelCol').hide();
				jQuery('.InPanelCol').show();
			}	
 		}	
 		function decideHideSourceType()
 		{
 			if(theInterfaceTypeId=='{!JSINHTMLENCODE(OutboundInterfaceTypeEnum)}')
			{
				jQuery('.InPanel').parent().hide();
				jQuery('.OutPanel').parent().show();
				selectInterfaceSource();
			}
			else
			{
				jQuery('.OutPanel').parent().hide();
				jQuery('.InPanel').parent().show();
				jQuery('#SourceType').next().find('option[value="{!GetPositionInterfaceFieldMapSourceTypeId}"]').attr('disabled','disabled');
				jQuery('#SourceType').next().find('option[value="{!GetTransformationInterfaceFieldMapSourceTypeId}"]').attr('disabled','disabled');
				
				
	 			
	 			
	 			if(jQuery('#SourceType').next().val()=='{!JSINHTMLENCODE(GetLiteralInterfaceFieldMapSourceTypeId)}')
	 			{
	 				jQuery('#SourceValue').parent().parent().parent().show();
	 				jQuery('#SourceFieldPositions').parent().parent().parent().hide();
		 			jQuery('#SourceFieldName').parent().parent().parent().hide();
		 			
	 			}
	 			else if(jQuery('#SourceType').next().val()=='{!JSINHTMLENCODE(GetNumericInterfaceFieldMapSourceTypeId)}')
	 			{
	 				jQuery('#SourceValue').parent().parent().parent().show();
	 				jQuery('#SourceFieldPositions').parent().parent().parent().hide();
		 			jQuery('#SourceFieldName').parent().parent().parent().hide();
		 			
	 			}
	 			else
	 			{
		 			if(jQuery('#RecordStartLine').val()!='')
		 			{
		 				jQuery('#SourceValue').parent().parent().parent().hide();
	 					jQuery('#SourceFieldPositions').parent().parent().parent().show()
		 				jQuery('#SourceFieldName').parent().parent().parent().hide()
		 			}
		 			else
		 			{
		 				jQuery('#SourceValue').parent().parent().parent().hide();
	 					jQuery('#SourceFieldPositions').parent().parent().parent().hide()
