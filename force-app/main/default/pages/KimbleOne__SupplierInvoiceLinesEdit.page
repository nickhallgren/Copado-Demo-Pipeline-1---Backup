<apex:page standardController="KimbleOne__SupplierInvoice__c" extensions="KimbleOne.SupplierInvoiceLinesEditController" showHeader="true" sidebar="false" tabStyle="KimbleOne__SupplierInvoice__c">
<apex:composition template="KimbleOne__SiteMaster">

    <apex:define name="Menu">
        <c:Menu DefaultHelpPage="" MenuContextType="SupplierInvoice" MenuContextId="{!KimbleOne__SupplierInvoice__c.Id}" MenuContextName="{!KimbleOne__SupplierInvoice__c.Name}"/>
    </apex:define> 
         
    <apex:define name="Content">
        
        <apex:form id="TheForm">
        
        <apex:pageMessages escape="false"/>
        
        <apex:pageBlock title="{!$ObjectType.KimbleOne__SupplierInvoiceLine__c.LabelPlural}">
            <apex:pageBlockTable value="{!TheSupplierInvoiceLines}" var="suppInvLine">
                <apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
                    <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__SupplierInvoiceLine__c.updateable}">
                        <apex:outputLink styleClass="actionLink" value="#" onclick="initialiseModalBoxy('#SupplierInvoiceLinePopup', '{!JSENCODE($Label.kimbleone__edit)}');editSupplierInvoiceLine('{!JSENCODE(suppInvLine.Id)}')">{!$Label.kimbleone__edit}</apex:outputLink>
                    </apex:outputPanel>
                </apex:column>
                <apex:column value="{!suppInvLine.KimbleOne__LineNumber__c}"/>
                <apex:column value="{!suppInvLine.KimbleOne__Narrative__c}"/>
                <apex:column value="{!suppInvLine.KimbleOne__NetAmount__c}"/>
                <apex:column value="{!suppInvLine.KimbleOne__TaxAmount__c}"/>
                                
            </apex:pageBlockTable>
            
        </apex:pageBlock>

        <apex:actionFunction action="{!EditSupplierInvoiceLine}" name="editSupplierInvoiceLine" reRender="SupplierInvoiceLinePopupPanel" oncomplete="showModalBoxy()">
            <apex:param name="suppInvLineId" value=""/>
        </apex:actionFunction>
        
        </apex:form>
        
        <div id="SupplierInvoiceLinePopup" style="display:none">
            <apex:outputPanel id="SupplierInvoiceLinePopupPanel">
                <apex:form id="SupplierInvoiceLineForm">
                
                    <div id="SupplierInvoiceLineErrors">
                        <apex:pageMessages id="SupplierInvoiceLineMessages" escape="false"/>
                    </div>
                    
                    <apex:pageBlock >
                    
                    <apex:pageBlockButtons location="bottom">
                        <apex:commandButton id="saveSupplierInvoiceLine" styleclass="DisableButtonWhileBusy" action="{!SaveSupplierInvoiceLine}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxy();" reRender="TheForm, SupplierInvoiceLinePopupPanel"/>
                        <input id="cancelSupplierInvoiceLine" class="btn DisableButtonWhileBusy" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
                    </apex:pageBlockButtons>
                    
                    <apex:pageblockSection collapsible="false" showheader="false" columns="1">
                       
                        <apex:outputfield value="{!TheSupplierInvoiceLine.KimbleOne__LineNumber__c}"/> 
                        
                        <apex:inputField style="width: 500px;" value="{!TheSupplierInvoiceLine.KimbleOne__Narrative__c}" />
                        
                    </apex:pageBlockSection>
                    
                    </apex:pageBlock>
                </apex:form>
                        
            </apex:outputPanel>
        </div>

    </apex:define>
</apex:composition>
</apex:page>