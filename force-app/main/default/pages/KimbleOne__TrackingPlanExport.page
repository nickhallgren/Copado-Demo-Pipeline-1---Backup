<apex:page standardController="KimbleOne__TrackingPlan__c"  extensions="KimbleOne.TrackingPlanExportController" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="TaskManagement.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__TrackingPlan__c.ResourcedActivity__r.KimbleOne__DeliveryGroup__c}" MenuContextName="{!KimbleOne__TrackingPlan__c.ResourcedActivity__r.DeliveryGroup__r.Name}" />
</apex:define>
   
<apex:define name="Content">
	
	<apex:form id="theForm">
        <apex:outputPanel id="TheAttachmentsPanel">
        	<div id="ErrorMessages">
				<apex:pageMessages escape="false"/>
			</div>
        	 <apex:pageBlock title="{!$Label.kimbleone__planheading} {!$Label.kimbleone__exportlabel}">
			 	<apex:pageBlockButtons location="bottom"> 
					<apex:commandButton action="{!goToTrackingPlanGantt}" value="{!$Label.kimbleone__back}" oncomplete="" reRender=""/>						
					<apex:commandButton action="{!exportAndSave}" value="{!$Label.kimbleone__exportlabel}"/>
				</apex:pageBlockButtons>
					
				<apex:pageBlockSection title="{!$Label.kimbleone__msprojectexportlabel}">
	 
					<apex:pageBlockTable value="{!TheAttachments}" var="att" >
						<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
							<apex:outputlink value="/servlet/servlet.FileDownload?file={!att.id}" target="_blank">{!$Label.kimbleone__view}</apex:outputlink>
							&nbsp;|&nbsp;
							<apex:outputlink value="#" onclick="var d = confirmDelete();if(!d) return; deleteAttachmentNow('{!JSINHTMLENCODE(att.id)}')">{!$Label.kimbleone__delete}</apex:outputlink>
						</apex:column>
		   				<apex:column value="{!att.Name}"/>
		   				<apex:column value="{!att.CreatedDate}"/>
					</apex:pageBlockTable>
		
				</apex:pageBlockSection> 
	
			 </apex:pageBlock>
		</apex:outputPanel>
		
		<apex:actionFunction action="{!deleteAttachment}" name="deleteAttachmentNow" reRender="TheAttachmentsPanel">
         	<apex:param name="attId" value="" />
      	</apex:actionFunction>
   </apex:form>
</apex:define>
</apex:composition>
</apex:page>