<apex:page standardController="KimbleOne__Vacancy__c" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="Vacancy" MenuContextId="{!KimbleOne__Vacancy__c.Id}" MenuContextName="{!KimbleOne__Vacancy__c.Name}"/>

</apex:define>  
   
<apex:define name="Content">
	   
	<apex:pagemessages escape="false"/>

    <apex:form >
		
		<apex:outputPanel id="VacancyDetailsPanel" >
		    
		    <apex:pageBlock id="VacancyDetailsBlock" title="{!$ObjectType.KimbleOne__Vacancy__c.Label}">
		    	
		    	<div id="VacancyDetailsErrors">
           			<apex:pageMessages escape="false"/>
           		</div>
		    	   
				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
             		 
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.Name}" />  
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__VacancyType__c}" />  
               		
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__HireDate__c}" />
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Status__c}" />

				</apex:pageblockSection>
				
				<apex:pageblockSection collapsible="false" showheader="false"  columns="1">

               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Summary__c}" />  
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Description__c}" />  
             	               			
				</apex:pageblockSection>
				
				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">

               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__BusinessUnit__c}" />               			               			
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__BusinessUnitSecondary__c}" />

               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Grade__c}" />               			               			
               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__ActivityRole__c}" />

               		<apex:outputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Location__c}" />
               			
				</apex:pageBlockSection>					

				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">

					<apex:repeat value="{!$ObjectType.KimbleOne__Vacancy__c.FieldSets.KimbleOne__VacancyDetails}" var="f">
	     				<apex:outputfield value="{!KimbleOne__Vacancy__c[f]}" />
					</apex:repeat>

	            </apex:pageBlockSection>						

	    	</apex:pageBlock>
		</apex:outputPanel>
		    
    </apex:form>
    
</apex:define>

</apex:composition> 

</apex:page>