	<script>
	
		var viewerOffsetMinutes = <apex:outputText value="{!viewerOffsetMinutes}"/>;

		jQuery(window).load(function()
		{
			initialiseDynamicElements();
		});
		
		function initialiseDynamicElements()
		{
			jQuery('.find-journey-leg-location').select2();
			
			jQuery('.kimbleDatePicker').datepicker({
		   		dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true
			});
			
			jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i' });
			
			
			if(jQuery('.activity-option').length > 0)
			{
				jQuery('.find-activity').select2();
			}
			else
			{
				jQuery('.find-activity').select2({
	            		minimumInputLength: 2,
	            		multiple: false,
	            		query: function (params) {
	            			var find = function() {findMatchingActivities(params);};        		
	        				find();
	            		},
	            		initSelection : function (element, callback) {
					        var data = {id: element.val(), text: element.attr('data-name')};
					        callback(data);
					    }
			    });
		    }
		    
		    jQuery('.find-activity').on("change", function(e) { 
			   getValidDatesForActivity(this);
			});
		    
		    jQuery('.fa-sticky-note-o').qtip();
		    
		    if(jQuery('input.allocation-amount').length == 0)
		    {
		    	jQuery('#submit-allowance-allocations').hide();
		    }
		    else
		    {
		    	jQuery('#submit-allowance-allocations').show();
		    }
		    
		    // if any amounts are allocated then check whether there are remaining
		    // amounts to allocate (only do this once allocations start so that
		    // we don't show needless warnings before the user has even started allocating amounts
		    if(jQuery('.allocation-amount').length > 0)
		    {
			    jQuery('span[data-remaining-numeric-amt]').each(function() {
					var remainingAllowanceAmount = jQuery(this).attr('data-remaining-numeric-amt');
					var remainingAllowanceAmountRounded = Number(remainingAllowanceAmount).toFixed(2);
	
					var totalAllowanceAmount = jQuery(this).attr('data-numeric-amt');
					var totalAllowanceAmountRounded = Number(totalAllowanceAmount).toFixed(2);
					
					if(remainingAllowanceAmountRounded == totalAllowanceAmountRounded && remainingAllowanceAmountRounded > 0)
					{
						var warningTitle = '{!JSENCODE($Label.AllowanceAmountNotAllocatedMessage)}'; 
						warningTitle = warningTitle.format(remainingAllowanceAmountRounded);
						jQuery(this).parent().prepend('<i class="fa fa-info-circle allocation-msg allocation-info" title="' + warningTitle + '"/>');
					}
					else if(remainingAllowanceAmountRounded > 0 && remainingAllowanceAmountRounded != totalAllowanceAmountRounded)
					{
						var warningTitle = '{!JSENCODE($Label.AllowanceAmountPartiallyAllocatedMessage)}'; 
						warningTitle = warningTitle.format(remainingAllowanceAmountRounded);
						jQuery(this).parent().prepend('<i class="fa fa-warning allocation-msg allocation-warning" title="' + warningTitle + '"/>');
					}
					else
					{
						jQuery(this).parent().remove('.allocation-msg');
					}
				});
			}
			
			jQuery(document).off('click', '.printJourneyLegsButton').on('click', '.printJourneyLegsButton', printJourneyLegs);
