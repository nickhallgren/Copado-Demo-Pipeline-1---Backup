		function saveJourneyLeg(journeyLegRow)
		{
			var theRow = jQuery(journeyLegRow).closest('tr');
			jQuery(theRow).find('.fa').addClass('hidden-item');
			jQuery(theRow).find('.action-cell').addClass('Loading');

			jQuery(".journey-leg-error-row").remove();
			
			var theJourneyLeg = {};
			
			theJourneyLeg.JourneyId = '{!JSENCODE(TheJourney.Id)}';
			theJourneyLeg.DepartingFromId = getFieldValue(theRow, 'select.departing-from');
			
			if(jQuery(theRow).attr('journey-leg-id') != "")
			{
				theJourneyLeg.JourneyLegId = jQuery(theRow).attr('journey-leg-id');
			}
			
			if(jQuery(theRow).closest('.journey-section-container').attr('journey-section-id') != "" && jQuery(theRow).closest('.journey-section-container').attr('journey-section-id') != "null")
			{
				theJourneyLeg.JourneySectionId = jQuery(theRow).closest('.journey-section-container').attr('journey-section-id');
			}

			var fromDate = kimble.parseDate(getFieldValue(theRow, '.departing-from-date'));
			if(getFieldValue(theRow, '.departing-from-time') != null)
			{
				fromDate += 'T' + getFieldValue(theRow, '.departing-from-time');
			}			
			theJourneyLeg.DepartureTime = fromDate;
						
			theJourneyLeg.ArrivingAtId = getFieldValue(theRow, 'select.arriving-at');

			var toDate = kimble.parseDate(getFieldValue(theRow, '.arriving-at-date'));
			if(getFieldValue(theRow, '.arriving-at-time') != null)
			{
				toDate += 'T' + getFieldValue(theRow, '.arriving-at-time');
			}			
			theJourneyLeg.ArrivalTime = toDate;
			theJourneyLeg.ResourceId = '{!JSENCODE(TheResource.Id)}'; 
			
			theJourneyLeg.Notes = getFieldValue(theRow, '.leg-note');
			if(theJourneyLeg.Notes == null) theJourneyLeg.Notes = '';
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.SaveJourneyLeg}', 
				theJourneyLeg, viewerOffsetMinutes, 
