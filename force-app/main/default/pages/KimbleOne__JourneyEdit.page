		{
			var allowancePeriodRow = jQuery(copyAllocationBtn).closest('tr');
			var remainingAllowanceAmount = jQuery(allowancePeriodRow).find('span.remaining-amt[data-numeric-amt]').attr('data-numeric-amt');
			jQuery(copyAllocationBtn).prev('input.allocation-amount').val(Number(remainingAllowanceAmount).toFixed(2)).change();
		}
		
		function clearAllocation(clearAllocationBtn)
		{
			jQuery(clearAllocationBtn).prev().prev('input.allocation-amount').val('').change();
		}

		function newAllowanceAllocationAllocateAll(newAllocationBtn)
		{			
			// get the activity currently selected
			var activityId = jQuery(newAllocationBtn).closest('table').find('.find-activity').val();

			if(activityId == null || activityId == '')
			{
				alert('{!JSENCODE($Label.ActivityRequiredMessage)}');
			}
			else
			{
				var allowancePeriodId = jQuery(newAllocationBtn).closest('tr').attr('allowance-period-id');
				
				jQuery(newAllocationBtn).parent().addClass('Loading');
				jQuery(newAllocationBtn).parent().find('.find-activity').hide();
				jQuery(newAllocationBtn).hide();
	
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.AllowanceAllocationAllocateAll}', 
					'{!JSENCODE(TheJourney.Id)}', '{!JSENCODE(TheResource.Id)}', activityId, viewerOffsetMinutes, 
		     			function(result, event){          
		            		if (event.status) 
			            {
			             	rerenderTheForm();
			         	} 
			         	else 
			         	{
			             	alert(event.message);
							jQuery(newAllocationBtn).parent().removeClass('Loading');
							jQuery(newAllocationBtn).parent().find('.find-activity').show();
							jQuery(newAllocationBtn).show();
			         	} 
		        	}, 
		        	{escape: false, timeout: 60000}
		    	);
	    	}
		}
				
		function newAllowanceAllocation(newAllocationBtn)
		{			
			// get the activity currently selected
			var activityId = jQuery(newAllocationBtn).closest('table').find('.find-activity').val();
			
			if(activityId == null || activityId == '')
			{
				alert('{!JSENCODE($Label.ActivityRequiredMessage)}');
			}
			else
			{
				var allowancePeriodId = jQuery(newAllocationBtn).closest('tr').attr('allowance-period-id');
				var allowancePeriodRow = jQuery(newAllocationBtn).closest('tr');
				var allowanceAmount = jQuery(allowancePeriodRow).find('span.remaining-amt[data-numeric-amt]').attr('data-numeric-amt');
				var allowanceCurrency = jQuery(allowancePeriodRow).find('span[data-currency]').attr('data-currency');

				jQuery(newAllocationBtn).parent().addClass('Loading');
				jQuery(newAllocationBtn).hide();

				if(allowanceAmount > 0)
				{
					saveNewAllowanceAllocation(allowancePeriodId, '{!JSENCODE(TheResource.Id)}', activityId, allowanceAmount, allowanceCurrency);
		    	}
		    	else
		    	{
		    		alert('{!JSENCODE($Label.NothingToAllocateMessage)}');
					jQuery(newAllocationBtn).parent().removeClass('Loading');
	    		}
	    	}
		}
		
		function setAllowanceAllocationNotes(allocationId, notes)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.UpdateAllowanceAllocationNotes}', 
				allocationId, notes,
	     			function(result, event){          
	            		if (!event.status) 
			            {
			             	alert(event.message);
			             	rerenderTheForm();
			         	} 
	        	}, 
	        	{escape: false, timeout: 60000}
	    	);
		}
				
		function setAllowanceAllocation(allocationField)
		{			
			// this is either an update to an existing allocation or a new allocation
			// check the attributes on the field
			var allowancePeriodRow = jQuery(allocationField).closest('tr');
						
			var allocationId = jQuery(allocationField).attr('allocation-id');
			var activityId = jQuery(allocationField).attr('activity-id');
			var allowancePeriodId = jQuery(allocationField).attr('allowance-period-id');
			
			jQuery(allocationField).parent().parent().addClass('Loading');
			jQuery(allocationField).parent().hide();
			
			if(allocationId != null && allocationId !='')
			{
				// this is an update to an existing allocation
				
				// a null value means we should delete, otherwise update
				if(jQuery(allocationField).val() == null || jQuery(allocationField).val() == '')
				{
					deleteAllowanceAllocation(allocationId);
				}
				else
				{
					var allowanceAmount = jQuery(allowancePeriodRow).find('span.total-amt[data-numeric-amt]').attr('data-numeric-amt');
					
					var newValue = (Number(jQuery(allocationField).val()) < Number(allowanceAmount)) ? jQuery(allocationField).val() : allowanceAmount;
					updateAllowanceAllocation(allocationId, newValue);
				}
			}
			else
			{
				if(jQuery(allocationField).val() != null && jQuery(allocationField).val() != '')
				{
					var allowanceCurrency = jQuery(allowancePeriodRow).find('span[data-currency]').attr('data-currency');
					var allowanceAmount = jQuery(allowancePeriodRow).find('span.total-amt[data-numeric-amt]').attr('data-numeric-amt');
					var newValue = (Number(jQuery(allocationField).val()) < Number(allowanceAmount)) ? jQuery(allocationField).val() : allowanceAmount;
					saveNewAllowanceAllocation(allowancePeriodId, '{!JSENCODE(TheResource.Id)}', activityId, newValue, allowanceCurrency);
				}
			}
		}

		function deleteAllowanceAllocation(allowancePeriodAllocationId)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.DeleteAllowanceAllocation}', 
				allowancePeriodAllocationId, 
	     			function(result, event){          
	            		if (event.status) 
		            {
		             	rerenderTheForm();
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		             	rerenderTheForm();
		         	} 
	        	}, 
	        	{escape: false, timeout: 60000}
	    	);
		}
				
		function updateAllowanceAllocation(allowancePeriodAllocationId, allowanceAmount)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.UpdateAllowanceAllocation}', 
				allowancePeriodAllocationId, allowanceAmount,
	     			function(result, event){          
	            		if (event.status) 
		            {
		             	rerenderTheForm();
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		             	rerenderTheForm();
		         	} 
	        	}, 
	        	{escape: false, timeout: 60000}
	    	);
		}	
		
		function saveNewAllowanceAllocation(allowancePeriodId, resourceId, activityId, allowanceAmount, allowanceCurrency)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.JourneyEditController.NewAllowanceAllocation}', 
				allowancePeriodId, resourceId, activityId, allowanceAmount, allowanceCurrency,
	     			function(result, event){          
	            		if (event.status) 
		            {
		             	rerenderTheForm();
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		             	rerenderTheForm();
		         	} 
	        	}, 
	        	{escape: false, timeout: 60000}
	    	);
		}

		function jDecode(str) {
		    return jQuery("<div/>").html(str).text();
		}
				
	</script>
</apex:define>

</apex:composition>

