<apex:page standardcontroller="KimbleOne__Journey__c" extensions="KimbleOne.JourneyEditController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextType="Journey" MenuContextId="{!TheJourney.Id}" MenuContextName="{!TheJourney.Resource__r.Name} - {!TheJourney.Name}" rendered="{!!ISBLANK(TheJourney.Id)}"/>

</apex:define>
    
<apex:define name="Content">

	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>

	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.min.js')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.css')}"/>

	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<style>
		#journey-layout {
		    min-height: 360px;
		}
		.cardContainer {
			display: block;
		}
		.card.allowance-periods {
		    display: block;
		}
		.title-card {
			display: table;
		    width: 100%;
		    height: 33px;
    		margin-bottom: 6px;		    
		}
		.kimble-format-currency {
			display: none;
		}
		.title-card-body {
			min-width: 250px;
		    vertical-align: middle;
		}
		.title-card-body-field {
			width: 100px;
		}
		.journey-card  {
			/*min-width: 50%;
			width: auto;*/
	    	width: 98%;
		}
		.card.min-horizontal-padding {
		  	margin-bottom: 10px;
		}
		.right-align-cell {
			text-align: right;
		}
		.journey-header-title {
		}
		.journey-name {
	    	width: 340px;
		}
		.inner-card {
			margin: 10px;
		}
		.padding-cell i {
			font-size: 18px;
		}
		.action-cell i.fa {
		    margin-left: 5px;
		    cursor: pointer;
		    font-size: 16px;
		}		
		.action-cell i.fa-plus-square {
		    font-size: 20px;
		}
		i.fa-plus-square-o {
		    font-size: 20px;
		    cursor: pointer;
		}
		.new-journey-leg {
			display: none;
		}
		.rolling-period {
			display: block;
			white-space: nowrap;
    		margin-bottom: 2px;
		}
		.kimbleDatePicker, .kimbleTimePicker {
		    width: 80px;
		    margin-right: 5px;
	        text-align: center;
		}
		.allowance-period-time {
			display: block;
		}
		tr[allowance-period-id] {
		    height: 40px;
		}
		.journey-legs.card, .allowance-periods.card {
		    min-width: 740px;
		    margin-bottom: 8px;
		}
		table.list.journey-leg-table {
		    width: 100%;
		}
		table.list.allowance-period-table {
		    width: 100%;
		}
		th.action-cell {
		    width: 65px;
		}
		td.action-cell {
		    min-width: 19px;
		}
		.calculate-btn {
		    position: absolute;
		    right: 10px;
		    bottom: 3px;
		}
		td.allowance-adjustment-cell {
		    text-align: center;
	        width: 50px;
		}
		tr[journey-leg-id]:hover, tr[allowance-period-id]:hover {
		    background-color: #e3f3ff;
		}
		.allowance-periods-title {
			display: inline;
		}
		.footer-action-btn-container {
			display: inline;
		    min-width: 18px;
		    min-height: 18px;
		}
		.find-journey-leg-location {
		    width: 130px;
		}
		.journey-legs-heading, .allowance-period-heading {
			position: relative;
		}
		.leg-date {
			min-width: 115px;
		}
		.allowance-date {
			width: 65px;
		}
		.add-allocation-cell, .add-allocation-header {
		    width: 169px;
		}
		.add-allocation-header {
			text-align: center;
		}
		.location-name, .location-region {
			width: 120px;
		}
		.footer-action-btn-container .fa {
			cursor: pointer;
		    padding: 4px;
		}
		span.add-non-forecast-activity-button {
		    cursor: pointer;
		    font-size: 18px;
		}
		.add-allocation-cell {
		    text-align: center;
    		font-size: 16px;
		}
		.add-allocation-header {
			padding-right: 16px !important;
		}
		span.allocation-all-btn.fa.fa-plus-square {
		    font-size: 20px;
		    position: absolute;
		    margin-left: 5px;
		    cursor: pointer;
		}
		.add-allocation-btn {
			cursor: pointer;
		    font-size: 20px;
		}
		.allocation-wrapper {
			position: relative;
	    	display: inline;
		}
		.allocation-amount {
			width: 80px;
		    text-align: right;
		}
		.allocation-column {
	    	width: 100px;
    	    white-space: normal;
		}
	    i.allocate-allowance-btn.fa.fa-angle-double-right, i.clear-allowance-allocation-btn.fa.fa-times-circle {
		    font-size: 18px;
		    cursor: pointer;
		    position: absolute;
		    right: 64px;
		    bottom: -2px;
   		}
	    i.allocate-allowance-btn.fa.fa-angle-double-right {
		    margin-right: 5px;
		}
	    i.clear-allowance-allocation-btn.fa.fa-times-circle {
	        margin-right: 2px;
            color: #808080;
		}
		.expense-claim-submit-icon {
			cursor: pointer;
		}
		i.allocated-allowance-btn.fa.fa-info-circle {
		    font-size: 16px;
		    margin-right: 5px;
		}
		i.allocated-allowance-btn.Draft {
			color: #949599;
		}
		i.allocated-allowance-btn.Approved {
			color: #008852;
		}
		i.allocated-allowance-btn.Rejected {
			color:#B42D34;
		}
		i.allocated-allowance-btn.ReadyForApproval {
			color: #0F0F0F;
		}
		td.allocation-cell.Approved {
			background-color: #DFEEE6;
		}
		td.allocation-cell.Rejected {
			background-color: #F6E4DE;
		}
		td.allocation-cell.ReadyForApproval {
			background-color: #E7E7E8;
		}
		th.adjustment-header, th.adjustments-header, th.allocations-header {
		    text-align: center;
		}
		th.adjustment-header {
		    font-style: italic;
	        white-space: normal;
		}
		td.allocation-cell {
		    text-align: right;
		    min-width: 105px;
		}
		
		th.allocation-column {
		    text-align: center;
		}
		.allowance-amount-header-cell {
			white-space: normal;
			width: 110px;
		}
		.journey-leg-error-ind {
			color: red !important;
			font-size: 18px;
		    text-align: center;
		}
		.journey-leg-error-message {
			color: red !important;
			font-weight: bold;
		}
		.Loading {
			background-image: url('{!URLFOR($Resource.JobImages, 'running16.gif')}') !important;
			background-repeat:no-repeat !important;
			background-position: 50%, 50%;
		}
		/* Make select2 dropdowns look like conventional dropdowns */
		a.select2-choice {
		    height: 18px !important;
		    line-height: 18px !important;
		    background-image: none !important;
		    border-radius: 0px !important;
		    color: black !important;
		    padding-left: 4px !important;
		}
		.select2-choice div {
		    border-left: none !important;
		}
		
		/* SF Pageblock overrides */
		.pbBody, .bPageBlock {
		    border: none !important;
		    background-color: initial !important;
		    margin: 0px !important;
		    padding: 0px !important;
		}
		.action-footer {
			text-align: right;
		    margin-top: 10px;
		    margin-bottom: 4px;
		}
		.footer-btn-ind {
	        font-size: 18px;
		    position: absolute;
		    right: 1px;
		    top: 0px;
		}
		.footer-action-btn-container {
		    margin-top: 5px;
		}
		.action-footer-btn {
		    display: inline;
		    cursor: pointer;
		    padding: 6px 30px 8px 9px !important;
		    position: relative;
		}
		div#add-section {
			position: absolute;
			left: 0px;
			top: 4px;
		}
		.cardFooter.journey-legs-footer {
			background-color: #FFF;
			border-color: #DDD;
			padding: 10px 15px;
			border-top: 1px solid #DDD;
			border-bottom-right-radius: 3px;
			border-bottom-left-radius: 3px;
			position: relative;
		}
		td.leg-notes {
		    text-align: center;
		}
		td.leg-notes.for-print {
		    text-align: left !important;
		}
		.allocation-note-ind {
			margin-right: 5px;
		}
		textarea.note
		{
			font-family: 'Arial','Helvetica',sans-serif;
  			font-size: 100%;
  			color: #666;
		}
		.hidden-item {
			display: none !important;
		}
		.fieldset-display-value, .fieldset-heading {
		    text-overflow: ellipsis;
		    white-space: nowrap;
		    overflow: hidden;
		    width: 125px !important;
		    display: block;
		}
		.journey-fieldset-edit .journey-fieldset-label {
		    font-weight: bold;
		    font-size: 12px;
		    margin-right: 10px;
		    vertical-align: top;
		    width: 160px;
		    display: inline-block;
		    text-align: right;
	        padding-top: 2px;
		}
		.journey-fieldset-edit-field {
		    margin-top: 10px;
		    margin-bottom: 5px;
		}
		.text-area-field[rows] {
		    font-size: 12px;
		    width: 260px;
		    height: 50px;
		}
		.requiredInput .requiredBlock {
			background-color: #c00;
			position: absolute;
			left: -4px;
			width: 3px;
			top: 1px;
			bottom: 1px;
		}
		.requiredInput {
		    display: inline-block;
		    position: relative;
		}
		.journey-fieldset-edit-field .dateInput {
		    font-size: 12px;
		}
		.allocation-msg {
			font-size: 16px;
		    margin-right: 5px;
		}
		.allocation-warning {
			color: #E58E1A;
		}
		.allocation-info {
			color: #428BCA;
		}
		
		/* Toolbar */
		a.toolbar-button {
			display: inline-block;
			padding: 6px 10px 6px 10px;
			background-color: white;
			margin-right: 4px;
			border: 1px solid #ccc;
			border-radius: 2px;
		}
		a.toolbar-button.active-toolbar-button {
			color: white;
			background-color: #888;
		}
		.toolbar-container {
			position: relative;
		    display: table-cell;
		    min-width: 70px;
		    padding: 6px;
		    margin-bottom: 5px;
		}
		.toolbar {
			display: table;
			width: 100%;
		}
		div#toolbar-buttons {
			display: table-cell;
			position: relative;
		}
		span.gantt-display-mode {
		    position: absolute;
		    right: 10px;
		}
		a.toolbar-button:hover {
			text-decoration: none;
			color: white;
			background-color: #1A9EFF;
		}
		a.toolbar-button.button-left {
			border-top-right-radius: 0px;
			border-bottom-right-radius: 0px;
			margin-right: 0px;
		}
		a.toolbar-button.button-middle {
			border-radius: 0px;
			border-left: 0;
			margin-right: 0px;
		}
		a.toolbar-button.button-right {
			border-top-left-radius: 0px;
			border-left: 0;
			border-bottom-left-radius: 0px;
		}
		a.toolbar-button .fa {
			font-size: 14px;
		}
		a.toolbar-button.disabled {
			background-color: #ccc;
			color: darkgray;
		}
		a.toolbar-button.disabled:hover {
			background-color: #ccc;
			color: darkgray;
		}		
 	</style>

	<!-- Print Styling -->
	<style media="print">
		/* salesforce elements */
		div#AppBodyHeader,
		div#side-bar-container,
		div.bPageFooter.noTableFooter,
		div.links,
		div#footer {
			display: none;
		}
		body {
			background: 0 !important;
		}
		table#bodyTable {
			border: 0 !important;
		}
		div.bodyDiv.brdPalette.brandPrimaryBrd {
			border: 0 !important;
			box-shadow: none;
		}
		.bPageBlock {
			background: 0 !important;
			border: 0 !important;
		}
		div.pbBody {
			margin: 0 !important;
		}
		/* kimble specific */
		#kimble-page-header-container {
			display: none;
		}
		/* page specific */
		.fa,
		.action-cell,
		.action-footer {
			display: none;
		}
		#print-button-floating-dropdown,
		.toolbar-container{
			display:none !important;
		}
		.card {
			width: 100%;
		}
	</style>

	<apex:pageMessages id="page-messages" escape="false"/>

 	<apex:form id="TheForm">

	<div id="journey-layout" class="journey-layout">
		<div class="journey-card title-card-container">
			<apex:outputPanel id="journey-edit" layout="none">
			<div class="title-card">
				<div class="title-card-heading" >
					<div class="title-card-heading-text">
						<apex:inputField id="name" html-placeholder="{!$Label.kimbleone__journeynameplaceholder}" styleClass="journey-name" value="{!TheJourney.Name}" required="true" rendered="{!(EditMode || ISBLANK(TheJourney.Id)) && ($ObjectType.KimbleOne__Journey__c.Updateable || $ObjectType.KimbleOne__Journey__c.Createable)}"/>
						<apex:outputText value="{!TheJourney.Name}" rendered="{!!EditMode && !ISBLANK(TheJourney.Id) && ($ObjectType.KimbleOne__Journey__c.Updateable || $ObjectType.KimbleOne__Journey__c.Createable)}"/>
					</div>
					
					<apex:outputPanel layout="block" styleClass="journey-fieldset-edit" rendered="{!$ObjectType.KimbleOne__Journey__c.FieldSets.KimbleOne__JourneyDetails.size > 0 && (EditMode || ISBLANK(TheJourney.Id)) && ($ObjectType.KimbleOne__Journey__c.Updateable || $ObjectType.KimbleOne__Journey__c.Createable)}">
						<apex:repeat value="{!$ObjectType.KimbleOne__Journey__c.FieldSets.KimbleOne__JourneyDetails}" var="r">
							<div class="journey-fieldset-edit-field">
								<apex:outputLabel styleClass="journey-fieldset-label" value="{!r.Label}" />
			   					<apex:inputField styleClass="{!CASE(r.Type, 'textarea', 'text-area-field', 'string', 'text-area-field','date',IF($ObjectType.KimbleOne__Journey__c.Fields[r].updateable,'kimbleDatePicker',''),'')}" required="{!r.Required}" value="{!TheJourney[r]}" rendered="{!!CONTAINS(r.FieldPath,'.')}"/>
								<apex:outputField value="{!TheJourney[r]}" rendered="{!CONTAINS(r.FieldPath,'.')}"/>
		   					</div>
		 				</apex:repeat>
	 				</apex:outputPanel>
				</div>

				<apex:outputPanel layout="none" rendered="{!!EditMode && !ISBLANK(TheJourney.Id)}">
				<div class="toolbar-container">
					<div class="toolbar">
						<div id="toolbar-buttons">
							<a class="toolbar-button button-left printJourneyLegsButton" title="{!$Label.Print} {!$ObjectType.KimbleOne__JourneyLeg__c.LabelPlural}" href="#"><i class="fa fa-print"></i></a><a data-floating-dropdown="#print-button-floating-dropdown" class="toolbar-button button-right addButton" title="{!$Label.Print}" href="#"><i class="fa fa-caret-down"></i></a>
						</div>
					</div>
					
					<div id="print-button-floating-dropdown" class="floating-dropdown floating-dropdown-relative" style="margin-top:1px">
						<ul class="floating-dropdown-menu">
							<li><a href="#" class="printJourneyLegsButton">{!$ObjectType.KimbleOne__JourneyLeg__c.LabelPlural}</a></li>
							<li><a href="#" id="printJourneyButton">{!$Label.All}</a></li>
						</ul>
					</div>
				</div>
				</apex:outputPanel>

				<div class="title-card-body">
					<apex:outputPanel layout="none" rendered="{!$ObjectType.Journey__c.FieldSets.JourneyDetails.size > 0 && !EditMode && !ISBLANK(TheJourney.Id) }">
						<apex:repeat value="{!$ObjectType.KimbleOne__Journey__c.FieldSets.KimbleOne__JourneyDetails}" var="r">
							<div class="title-card-body-field">
								<apex:outputLabel styleClass="center-aligned-block label-heading fieldset-heading" value="{!r.Label}" title="{!JSENCODE(r.Label)}"/>
			   					<span class="fieldset-display-value" title="{!r.Type}"><apex:outputField styleClass="center-aligned-block" value="{!TheJourney[r]}"/></span>
							</div>
		 				</apex:repeat>
	 				</apex:outputPanel>

		  			<apex:outputPanel layout="none" rendered="{!!ISBLANK(TheJourney.Id)}">
 					<div class="title-card-body-field">
 						<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Journey__c.Fields.KimbleOne__EarliestLegDepartureTime__c.Label}" />
 						<span ><apex:outputText styleClass="center-aligned-block kimble-format-date-time" value="{!TheEarliestDate}"/></span>
 					</div>
					<div class="title-card-body-field">
						<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Journey__c.Fields.KimbleOne__LatestLegArrivalTime__c.Label}" />
						<span ><apex:outputText styleClass="center-aligned-block kimble-format-date-time" value="{!TheLatestDate}"/></span>
					</div>
					</apex:outputPanel>
				</div>
	
				<div class="title-card-menu">
					<apex:commandLink id="edit-journey" action="{!EditJourney}" title="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__Journey__c.Label}" rendered="{!!EditMode && !ISBLANK(TheJourney.Id) && $ObjectType.KimbleOne__Journey__c.Updateable}">
						<div class="title-card-menu fa fa-pencil burger-menu"></div>
					</apex:commandLink>
					<apex:commandLink id="save-journey" action="{!SaveJourney}" title="{!$Label.kimbleone__save}" rendered="{!(EditMode || ISBLANK(TheJourney.Id)) && ($ObjectType.KimbleOne__Journey__c.Updateable || $ObjectType.KimbleOne__Journey__c.Createable)}">
						<div class="title-card-menu fa fa-save burger-menu"></div>
					</apex:commandLink>
				</div>	
			</div>
			</apex:outputPanel>

			<apex:outputPanel layout="none" rendered="{!!ISBLANK(TheJourney.Id) && !EditMode}">

			<div class="card journey-legs">
				<div class="cardHeading journey-legs-heading">
					<div class="journey-legs-title">
						<h3 class="cardTitle"><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.LabelPlural}"/></h3>
					</div>
				</div>
				<apex:repeat value="{!TheOrderedJourneySectionKeys}" var="sectionKey">
				<div class="inner-card journey-section-container" section-key="{!sectionKey}" journey-section-id="{!TheSectionKeyToIdMap[sectionKey]}">
					<apex:outputPanel layout="block" styleClass="inner-card-body journey-legs">
						<table class="list journey-leg-table">
			    			<thead>
			    				<apex:outputPanel layout="none" rendered="{!!HasExpenseItems}">
			    				<th class="action-cell">
                                    <apex:variable value="{!TheJourneySectionLegs[sectionKey]}" var="legs"/>
				    				<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__JourneyLeg__c.createable}">
			    						<i class="fa fa-plus-square add-new-journey-leg journey-btn" onclick="addNewJourneyLeg('{!sectionKey}');" title="{!$Label.kimbleone__add} {!$ObjectType.KimbleOne__JourneyLeg__c.Label}"/>
									</apex:outputPanel>
                                    <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__JourneyLeg__c.createable && $ObjectType.KimbleOne__JourneySection__c.createable && AllowSections && TheSectionKeyToIdMap[sectionKey] != 'null' && legs.size = 0}">
                                        <i class="fa fa-trash delete-journey-section journey-btn" onclick="deleteJourneySection('{!sectionKey}');" title="{!$Label.kimbleone__deletebutton} {!$ObjectType.KimbleOne__JourneySection__c.Label}"/>
                                    </apex:outputPanel>
			    				</th>
			    				</apex:outputPanel>
			    				<th><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.Fields.KimbleOne__JourneyLocationDeparture__c.Label}"/></th>
			    				<th><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.Fields.KimbleOne__DepartureTime__c.Label}"/></th>
			    				<th></th>
			    				<th><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.Fields.KimbleOne__JourneyLocationArrival__c.Label}"/></th>
			    				<th><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.Fields.KimbleOne__ArrivalTime__c.Label}"/></th>
			    				<th><apex:outputText value="{!$ObjectType.KimbleOne__JourneyLeg__c.Fields.KimbleOne__Notes__c.Label}"/></th>
			    				<th></th>
			    			</thead>
			    			<tbody>
								<apex:repeat value="{!TheJourneySectionLegs[sectionKey]}" var="journeyLeg" >
	    							<tr journey-leg-id="{!journeyLeg.JourneyLegId}">
					    				<apex:outputPanel layout="none" rendered="{!!HasExpenseItems}">
	    								<td class="action-cell">
						    				<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__JourneyLeg__c.updateable}">
		    									<i class="fa fa-pencil" onclick="editJourneyLeg(this);" title="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__JourneyLeg__c.Label}"/>
		    								</apex:outputPanel>
						    				<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__JourneyLeg__c.deletable}">
		    									<i class="fa fa-trash" onclick="deleteJourneyLeg(this);" title="{!$Label.kimbleone__deletebutton} {!$ObjectType.KimbleOne__JourneyLeg__c.Label}"/>
