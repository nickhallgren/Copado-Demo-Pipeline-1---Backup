		.ui-layout-center,.ui-layout-east {
			padding: 0;
		}
		
		.ui-layout-content {
			padding: 0px;
		}
		
		/*
			resizable columns
		*/
		
		.results-grid-table {
			width: auto;
			table-layout: fixed;
		    border-collapse: collapse;
		    width: 0; /* otherwise Chrome will not increase table size */
		}
		
		.results-grid-table th, .results-grid-table td { 
		     overflow: hidden;
		     white-space: nowrap;
		} 
		
		.columnLabel {
		    display: inline-block;
		    width: 100%;
		}
		
		.resizeHelper,.ui-resizable-e {
		    cursor: e-resize;
		    width: 10px;
		    height: 100%;
		    top: 0;
		    right: -8px;
		    position: absolute;
		    z-index: 100;
		    font-size: 100%;
		}
		
		/* handle for FF */
		@-moz-document url-prefix() {
		    .resizeHelper,.ui-resizable-e {
		        position: relative;
		        float: right;
		    }
		}
		
		/* PAGE OVERRIDDES */
		.gantt-container
		{
			padding-bottom: 1px;
			border-bottom: 1px solid #eee;
			width:100%
		}
		.ui-state-active
		{
			border:0px;
		}
	</style>

