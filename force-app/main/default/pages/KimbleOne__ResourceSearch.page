			<script>
    var enableDragDrop = {!$ObjectType.KimbleOne__ActivityAssignment__c.updateable};

    var availabilityScoringEnabled = <apex:outputText value="{!EnableAvailabilityScoring}"/>;
    var availabilityScoringActive = <apex:outputText value="{!AvailabilityScoringActive}"/>;
    var savedIncludedClassifications = '<apex:outputText value="{!IncludedClassifications}"/>';
    
	var candidateResourcesDisplayed = <apex:outputText value="{!IntegratedCandidateResourcesActive}"/>;
	var excludedResources = {};

	jQuery('#layout-container').layout({maskIframesOnResize: true, west__size: (availabilityScoringEnabled ? 276 : 266)});
    
    jQuery(window).load(function(){
    	
    	jQuery('#layout-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
	   	jQuery('#layout-container').layout({west__size: 266});
    	
    	jQuery('#period-header-container').paintPeriodsHeader(ganttViewStartDate.toDate(), ganttViewEndDate.toDate(), showNonBusDays);
      	   	
      	maxGanttSectionHeight = jQuery('#layout-container').height() - jQuery('#period-header-container').height() - scrollbarWidth;
    	jQuery('#matching-gantt-container, #gantt-vertical-scroll-container, #matching-resources-container, #cap-score-resource-rows-container').css('max-height', maxGanttSectionHeight);
    	
    	jQuery(window).resize(function() {
    		jQuery('#layout-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
    		maxGanttSectionHeight = jQuery('#layout-container').height() - jQuery('#period-header-container').height() - scrollbarWidth;
    		jQuery('#matching-gantt-container, #gantt-vertical-scroll-container, #matching-resources-container, #cap-score-resource-rows-container').css('max-height', maxGanttSectionHeight);
    	
			jQuery('#matching-gantt-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#matching-resources-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#cap-score-resource-rows-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
    		
    		refreshViewport(true);    	
    	});
    	
    	jQuery(window).resize();
    	
    	jQuery('#gantt-vertical-scroll-container').scroll(function() {
  			
  			jQuery('#matching-gantt-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			
  			jQuery('#matching-resources-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			
  			jQuery('#cap-score-resource-rows-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());

  				clearTimeout(jQuery.data(this, "scrollTimer"));

  				jQuery.data(this, "scrollTimer", setTimeout(function() {
        			refreshViewport();
    			}, 250));
  		});
  		
  		jQuery('.dragging-scroll').hide();
  		
  		jQuery('.dragging-scroll').hover(
		    function(){
		        
		        if (jQuery('.ui-draggable-dragging').length == 0) return;
	    
		        var scroller;
		        
		        if ($(this).hasClass('scroll-bottom'))
		        	scroller = setInterval( scrollDown, 30 );
		        if ($(this).hasClass('scroll-top'))
		        	scroller = setInterval( scrollUp, 30 );
		        if ($(this).hasClass('scroll-left'))
		        	scroller = setInterval( scrollLeft, 30 );
		        if ($(this).hasClass('scroll-right'))
		        	scroller = setInterval( scrollRight, 30 );
		        	
		        $(this).data('scroller', scroller);
		    },
		    function(){
		        var scroller = $(this).data('scroller');
		        clearInterval( scroller );
		    }
		);
  		
  		jQuery.subscribe('kimble.activityassignmentcalendarchange', function(e, data) {
			refreshResource(data.resourceId);
		});
		
		jQuery.subscribe('kimble.assignmentChanged', function(e, data) {
			refreshResource(data.resourceId);
		});
  		
  		jQuery.subscribe('kimble.assignmentReassigned', function(e, theResource){
			redrawResource(theResource.ResourceGantt);
		});
		
		jQuery.subscribe('kimble.assignmentEndDated', function(e, d){
			redrawResource(d.TheResource);
			jQuery('[parent-resource-id="' + d.TheResource.Id + '"]').remove();
		});
		
		
  		jQuery.subscribe('kimble.ganttViewUpdated', function(e){
			
			setScrollHeight();
			
			if (jQuery('.ui-draggable-dragging').length == 0)
			{
				jQuery(".ui-draggable").draggable("destroy");
				
				jQuery('.assignment-draggable').draggable({
							start: function( event, ui ) {
								//show dragging-scroll
								jQuery(this).css('visibility', 'hidden');
								jQuery('.dragging-scroll').show();
							}, 
							stop: function( event, ui ) {
								//hide dragging-scroll
								jQuery('.dragging-scroll').hide();
								jQuery(this).css('visibility', 'visible');
								jQuery('.drag-active-day').removeClass('drag-active-day');
							}, 
							drag: function (event, ui) {
								jQuery('.drag-active-day').removeClass('drag-active-day');
								var d = jQuery(document.elementFromPoint(Math.ceil(ui.helper.offset().left), Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));
								if (d.hasClass('day-head'))
									d.toggleClass('drag-active-day');								
							},
							revert:"invalid", 
							helper:'clone', 
							scroll:false, 
							appendTo: '#gantt-view'});
			}
				
			jQuery(".ui-droppable").droppable("destroy");
				
			jQuery(".can-assign" ).droppable({
				      hoverClass: "drag-active-resource",
				      accept: function(draggable) {
				      	if (draggable.closest('.resource-gantt-row').length == 0) return false;
				      	
				      	return draggable.closest('.resource-gantt-row').prop('id') != jQuery(this).prop('id');
				      }, 
				      drop: function(event, ui ) {
				         var dayCell = jQuery('.day-head.drag-active-day');
			        
			        	if (dayCell.length == 0) return false;
			        
			        	var starting = new Date(new Number(dayCell.parent().prop('id').substring(3)));
			       
				        initialiseModalBoxy('#assignment-assign', '{!JSENCODE($Label.Assign)}');
				        
				        var obj = ui.draggable.clone();
				        
				        obj.show().css('position','absolute').css('visibility','').css('left', ui.helper.position().left).css('top', ui.helper.position().top).appendTo(ui.helper.parent());
				        
				        assign(assignmentMap[ui.draggable.attr('assignment-id')], jQuery(this).prop('id'), starting, obj, false, false, []);
				        
						showModalBoxy();
				      },
				      over: function(event, ui) {
			      		jQuery('#' + this.id + '.resource-grid-row').addClass('drag-active-resource');
			      	  },
			      	  out: function(event, ui) {
			      		var gridRow = jQuery('#' + this.id + '.resource-grid-row').removeClass('drag-active-resource');
			      	 }
			});	
			
			applyIndicatorTitles();
		});
  		
  		if(availabilityScoringEnabled) initialiseAvailabilityScoring();
    }); 
   	
   	function getFilterCriteria()
   	{
   		var criteria = new Array();
   		
   		<apex:repeat value="{!criteria}" var="criterion">
   			// {!JSENCODE(criterion.DisplayType)}
   			// {!JSENCODE(criterion.FieldName)}
   			// {!JSENCODE(criterion.Id)}
   			<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'date'}">
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['LessThan'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').datepicker("getDate").toKimbleUTC()}]};
   				
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').val() != '')
