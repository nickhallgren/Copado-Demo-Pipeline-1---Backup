   	function getCapabilityCriteriaWithRatings()
   	{
   		var caps = new Array();
   		jQuery.each(jQuery('.required-capability-rows div[cap-type-id]'), function (i, obj){
   			caps[caps.length] = {CapTypeId: jQuery(obj).attr('cap-type-id'), Rating: (jQuery(obj).attr('cap-rating') != null && jQuery(obj).attr('cap-rating') != undefined && jQuery(obj).attr('cap-rating') != '' && jQuery(obj).attr('cap-rating') != 'null' && jQuery(obj).attr('cap-rating') != 'undefined' ? jQuery(obj).attr('cap-rating') : null)};
   		});
   		return caps;
   	}

   	var availabilityScoringClassMap = {};
   	function initialiseAvailabilityScoring()
   	{
   		var json = new Array();
		<apex:outputText value="json={!GanttViewProperties.TheActivityAssignmentClassesJson};" rendered="{!!ISBLANK(GanttViewProperties.TheActivityAssignmentClassesJson)}"/>
		availabilityScoringClassMap = {};

		for(var i = 0; i < json.length; i++) {
			availabilityScoringClassMap[json[i][priorityName]] = json[i][includeAvailabilityScoreName];
		}
   	}
   	   	
   	function includeClassInAvailabilityScore(priority)
   	{
   		return ((priority in availabilityScoringClassMap) && availabilityScoringClassMap[priority]);
   	}
   	
   	var requiredScheduledDays = {};
   	   	
   	function getRequiredUsageDetails()
   	{   	
   		var requiredUsageDetails = {};
   		requiredUsageDetails.UnitType = 'Pct';

   		var usageMap = {};
   		
   		// for each day between the entered start date and end date manufacture a usage day
   		// note we use 0 for each non-business day in the global non-business days collection
   		// default to the earliest and latest dates and 100% util if null
   		var theStartDateUTC = (jQuery('#avail-start-date').val() != undefined && jQuery('#avail-start-date').val() != '' ? kimble.parseDate(jQuery('#avail-start-date').val()) : ganttViewStartDate);
   		var theEndDateUTC = (jQuery('#avail-end-date').val() != undefined && jQuery('#avail-end-date').val() != '' ? kimble.parseDate(jQuery('#avail-end-date').val()) : ganttViewEndDate);
   		var pctRequired = (jQuery('#avail-utilisation').val() != undefined && jQuery('#avail-utilisation').val() != '' ? jQuery('#avail-utilisation').val() : 100);
   		
		for (var i=0;i<=days_between(theStartDateUTC.toDate(), theEndDateUTC.toDate());i++)
		{
			var contextDate = new Date(theStartDateUTC.toDate().getFullYear(), theStartDateUTC.toDate().getMonth(), theStartDateUTC.toDate().getDate() + i, 0, 0, 0, 0);
			
			var dte = contextDate.toKimbleUTC();
			
			if(dte in theGlobalNonBusinessDays)
			{
				usageMap[dte] = 0;
			}
			else
			{
				usageMap[dte] = pctRequired;
			}
		}	
   		
		requiredUsageDetails.UsageMap = usageMap;
		
		return requiredUsageDetails;
   	}
   	
   	function scrollScoredAreaIntoView()
	{
		var scrollOffset = 200;
		var left = jQuery('td[dte].av-dte:first').position().left;
		var currentScrollLeft = jQuery('#gantt-view').scrollLeft();
		if(left != undefined && left != null && left-scrollOffset != 0)
		{
			if(jQuery('#gantt-view').length > 0) jQuery('#gantt-view').scrollLeft(left+currentScrollLeft-scrollOffset);
			else jQuery('#gantt-container').scrollLeft(left+currentScrollLeft-scrollOffset);
		}
	}
	
   	function findResources()
   	{
   		jQuery('#loadingIndicatorOuterContainer').show();
   		
   		jQuery('#goBtn').addClass('search-working');
   		jQuery('.go-spinner').removeClass('search-working');
   		
   		jQuery('#matching-gantt-lines').empty();
   		excludedResources = {};
   		
   		jQuery('#matching-resources-table-body>tbody').empty();
   		
   		var caps = getCapabilityCriteria();
   		
   		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ResourceSearchController.FindResources}',
	       		getCapabilityCriteria(), getFilterCriteria(), candidateResourcesDisplayed,
	      			function(result, event){          
	             		
	             		jQuery('#loadingIndicatorOuterContainer').hide();
				   		jQuery('#goBtn').removeClass('search-working');
				   		jQuery('.go-spinner').addClass('search-working');
	             		
	             		if (event.status) 
			            {
			             	if (result.TotalRecords == 0) 
			             	{
			             		alert(kimble.labels['NoResourcesFound']);
			             		return;
			             	}
			             	
     						if (result.TheResources.length < result.TotalRecords)
			             	{
			             		if(caps.length > 0)
			             		{
			             			alert(kimble.labels['TooManyResourcesFoundForCapabilitySearch'].format(result.TheResources.length, result.TotalRecords));
		             			}
		             			else
		             			{
		             				alert(kimble.labels['TooManyResourcesFound'].format(result.TheResources.length, result.TotalRecords));
		             			}
			             	}
			             	resourceScoringMap = {};
			             	
			             	var scoring = (caps.length > 0 || availabilityScoringActive);

		             		if(scoring)
		             		{
		             			initialiseScoringColumn();
	             			}
	             			else
	             			{
	             				jQuery('.scoring-column').remove();
	             				if(jQuery('#scoring-view:visible').length > 0) showGanttView();
	             			}
			             	
			             	if(caps.length > 0)
			             	{
			             		calculateCapabilityScores(result.TheResources);
			             		jQuery('.hide-until-caps').removeClass('hide-until-caps');
		             		}
		             		else
		             		{
		             			jQuery('.scoring-btn').addClass('hide-until-caps');
		             			jQuery('.min-rating-col').addClass('hide-until-caps');
		             			
		             			if(jQuery('#scoring-view:visible').length > 0) showGanttView();
		             		}
		             		
		             		if(availabilityScoringActive)
		             		{
		             			var minAvailScore = (jQuery('#min-avail-score').val() != undefined && jQuery('#min-avail-score').val() != '' ? jQuery('#min-avail-score').val() : 0);
		             			calculateAvailabilityScores(result.TheResources, minAvailScore);
	             			}					
							
							jQuery('#gantt-vertical-scroll-container').scrollTo(0);
							
		             		if(scoring) result.TheResources.sort(sortByScore);
							
			             	repaintResources(result.TheResources);
			             	
							jQuery('td[dte].av-dte').removeClass('av-dte');
			             	if(availabilityScoringActive)
			             	{								
								for(key in requiredUsageDetails.UsageMap)
								{
									jQuery('td[dte="' + key + '"]').addClass('av-dte');
								}
								
								scrollScoredAreaIntoView();								
							}
			             	
							// if the capability scoring page is open, repaint it
			             	if(jQuery('#scoring-view:visible').length > 0) showCapabilityScoringView();
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         	}, 
	         	{escape: false, timeout: 60000}
	     	);
   	}	

   	function applyIndicatorTitles()
   	{
		jQuery('.capability-score-ind.meets-or-exceeds-summary-ind').prop('title', kimble.labels['CapMeetsOrExceedsRequirement']);
		jQuery('.capability-score-ind.falls-short-summary-ind').prop('title', kimble.labels['CapFallsShortOfRequirement']);
		jQuery('.capability-score-ind.missing-mandatory-summary-ind').prop('title', kimble.labels['CapMissingMandatoryRequirement']);
		jQuery('.capability-score-ind.missing-some-summary-ind').prop('title', kimble.labels['CapMissingRequirement']);
	
		jQuery('.capability-score-ind.fa-circle-o').prop('title', function() {return jQuery(this).prop('title') + ' (' + kimble.labels['CapExpiring'] + ')';});
	
		if(availabilityScoringEnabled)
		{
			jQuery('.availability-score-ind.has-sched-days-ind').prop('title', kimble.labels['ResourceHasScheduledDays']);
			jQuery('.availability-score-ind.resource-overlap-ind').prop('title', kimble.labels['ResourceHasOverlappingAssignments']);
		}
   	}
