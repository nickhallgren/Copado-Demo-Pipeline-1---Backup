<apex:page id="ResourceSupplierInvoices" controller="KimbleOne.ResourceSupplierInvoicesController" sidebar="false">
	<apex:composition template="KimbleOne__SiteMaster">
		<apex:define name="Content">
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>

			<apex:pageBlock title="{!TheTabLabel}">
				<apex:pageMessages />
				<apex:pageBlockTable value="{!TheSupplierInvoices}" var="supplierInvoice" rendered="{!TheSupplierInvoices.size > 0 && CanShowSelfBillInvoices}">
					<apex:column value="{!supplierInvoice.TheSupplierInvoice.KimbleOne__InvoiceDate__c}"/>
					<apex:column headerValue="{!$ObjectType.KimbleOne__SupplierInvoice__c.Fields.Name.Label}">
						<apex:outputlink value="/servlet/servlet.FileDownload?file={!supplierInvoice.TheAttachmentId}" target="_blank" rendered="{!!ISBLANK(supplierInvoice.TheAttachmentId)}">{!supplierInvoice.TheSupplierInvoice.Name}</apex:outputlink>
						<apex:outputText value="{!supplierInvoice.TheSupplierInvoice.Name}" rendered="{!ISBLANK(supplierInvoice.TheAttachmentId)}"/>
					</apex:column>
					<apex:column value="{!supplierInvoice.TheSupplierInvoice.SupplierAccount__r.Name}"/>
					<apex:column headerValue="{!$ObjectType.KimbleOne__SupplierInvoice__c.Fields.KimbleOne__Status__c.Label}" value="{!supplierInvoice.TheSupplierInvoice.Status__r.KimbleOne__Enum__c}"/>
					<apex:column value="{!supplierInvoice.TheSupplierInvoice.KimbleOne__NetAmount__c}"/>
					<apex:column value="{!supplierInvoice.TheSupplierInvoice.KimbleOne__TaxAmount__c}"/>
				</apex:pageBlockTable>

<!-- TODO:JMB implement preview in page
Commented out for the time being, user has access to click on link above and view the attachment, and subsequently download it.

				<apex:repeat value="{!TheSupplierInvoices}" var="supplierInvoice">
					<iframe src="data:{!supplierInvoice.TheAttachmentContentType};base64,{!supplierInvoice.TheAttachmentBody}" ></iframe>
				</apex:repeat>
-->
			</apex:pageBlock>
		</apex:define>
	</apex:composition>
</apex:page>