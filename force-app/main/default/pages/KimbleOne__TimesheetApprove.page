								<apex:outputPanel layout="none">
									<apex:inputTextarea rows="4" cols="45" value="{!TimeEntry.KimbleOne__Notes__c}" styleclass="NoteText" rendered="{!canEdit}"/>
									<apex:outputField value="{!TimeEntry.KimbleOne__Notes__c}" rendered="{!!canEdit}"/>
