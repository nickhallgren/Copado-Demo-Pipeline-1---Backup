							<apex:pageBlockSectionItem labelStyle="width:30%" rendered="{!!ISBLANK(TimeEntry.Timesheet__r.KimbleOne__ApprovalComments__c)}">
								<apex:outputText value="{!$ObjectType.KimbleOne__Timesheet__c.Fields.KimbleOne__ApprovalComments__c.Label}"  />
								<apex:outputText value="{!TimeEntry.Timesheet__r.KimbleOne__ApprovalComments__c}" />
							</apex:pageBlockSectionItem>

			       		</apex:pageblockSection>

