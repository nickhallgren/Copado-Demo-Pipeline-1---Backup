									<apex:outputPanel layout="block" styleClass="requiredInput" rendered="{!canEdit && TheActivityTimeCategories[num].TheCategory.DisplayType__r.Enum__c = 'Dropdown' && TheActivityTimeCategories[num].TheCategory.IsMandatory__c}">
											<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
											<apex:selectList value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" multiselect="false" size="1" required="true">
												<apex:selectOptions value="{!TheActivityTimeCategories[num].TheOptions}" />
											</apex:selectList>
									</apex:outputPanel>
									<apex:selectList value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" multiselect="false" size="1" rendered="{!canEdit && TheActivityTimeCategories[num].TheCategory.DisplayType__r.Enum__c = 'Dropdown' && !TheActivityTimeCategories[num].TheCategory.IsMandatory__c}">
										<apex:selectOptions value="{!TheActivityTimeCategories[num].TheOptions}" />
									</apex:selectList>
									<apex:outputField value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" rendered="{!!canEdit}"/>
