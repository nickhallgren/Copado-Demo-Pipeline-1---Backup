<apex:page standardcontroller="KimbleOne__Timesheet__c" extensions="KimbleOne.TimesheetApproveController,KimbleOne.SecurityController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu MenuContextName="{!TheTimesheet.Name}" />
</apex:define>
    
<apex:define name="Content">

	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.min.js')}"/>
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__HoursAndMinsHelper)}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.css')}"/>


	<style>
		.kimbleTimePicker {
		    width: 75px;
		}
		.pre-app-validation-messages {
		    width: 500px;
		}
		i.inline-validation {
		    font-size: 18px;
		    margin-right: 5px;
		}
		i.inline-validation.ok {
		    color: #2ba60d;
		}
		i.inline-validation.alert {
		    color: #8f0000;
		}
		tr.has-errors {
		    background-color: #F6E4DE;
		}
		input.entry-units, input.hours-and-mins {
    		width: 80px;
		}
	</style>

    <!-- Hidden fields for use in controller -->
    <apex:outputField value="{!KimbleOne__Timesheet__c.KimbleOne__TimePeriod__c}" rendered="False"/>
    <apex:outputField value="{!TheTimesheet.TimePeriod__r.KimbleOne__StartDate__c}" rendered="False"/>
	<apex:variable value="{!IF(ISBLANK(TheTimesheet.ResourcedActivity__r.DeliveryElement__r.KimbleOne__DeliveryElementOperatedWith__c), TheTimesheet.ResourcedActivity__r.UsageUnitType__r.KimbleOne__Suffix__c, TheTimesheet.ResourcedActivity__r.DeliveryElement__r.DeliveryElementOperatedWith__r.ResourcedActivity__r.UsageUnitType__r.KimbleOne__Suffix__c)}" var="usageUnits"/>
     
	<apex:pagemessages escape="false"/>

	<apex:form id="TimeForm">  
    
      <apex:actionFunction action="{!GetTimeEntry}" name="editTimeEntry" rerender="TimeEntryDetails" oncomplete="initialiseDynamicElements();showModalBoxyWithFocus($('.EntryUnitsText'));">
			<apex:param name="entryId" value="" />
	  </apex:actionFunction>
   
   	  <apex:outputpanel id="Timesheet">	 
       <apex:pageBlock title="" mode="edit" >

       <apex:pageBlockButtons >
		
         <apex:commandButton id="RevertToDraft"  action="{!RevertToDraft}" value="{!$Label.kimbleone__reverttodraft}" rendered="{!AllowRevert && HasPermission['RevertApprovedTimesheet']}" />
         
       </apex:pageBlockButtons>

         <apex:pageBlockSection title="{!$ObjectType.KimbleOne__Timesheet__c.Label}" columns="2" >
           <apex:outputField id="timesheetName" value="{!TheTimesheet.Name}" />
           <apex:pageBlockSectionItem >
				<apex:outputLabel value="{!$ObjectType.KimbleOne__Timesheet__c.Fields.KimbleOne__Status__c.Label}" />
				<apex:outputField id="timesheetStatus" value="{!TheTimesheet.Status__r.Name}" />
		   </apex:pageBlockSectionItem>
		   
		   <apex:outputField value="{!TheTimesheet.KimbleOne__TimeAdjustment__c}" rendered="{!!ISBLANK(TheTimesheet.KimbleOne__TimeAdjustment__c)}"/>
		   
		   <apex:outputText value="" rendered="{!!ISBLANK(TheTimesheet.KimbleOne__TimeAdjustment__c)}"/>
		   
           <apex:outputField id="resource" value="{!TheTimesheet.KimbleOne__Resource__c}" />
           <apex:outputField id="deliveryGroup" value="{!TheTimesheet.ResourcedActivity__r.KimbleOne__DeliveryGroup__c}" />
           <apex:outputField id="activity" value="{!TheTimesheet.ResourcedActivity__r.Name}" />
           <apex:outputText id="emptyCell" value="" />
           <apex:outputField id="trackingPeriod" value="{!TheTimesheet.TimePeriod__r.Name}" />
           <apex:pageBlockSectionItem >
				<apex:outputLabel value="{!$Label.kimbleone__timeperiodstatus}" />
				<apex:outputField id="trackingPeriodStatus" value="{!TheTimesheet.TimePeriod__r.Status__r.KimbleOne__Enum__c}" />
		   </apex:pageBlockSectionItem>
           <apex:pageBlockSectionItem >
				<apex:outputLabel value="{!$ObjectType.KimbleOne__Timesheet__c.Fields.KimbleOne__TotalEntryUnits__c.Label}" />
				<apex:outputText id="totalEntryUnits" value="{!TheTimesheet.KimbleOne__TotalEntryUnits__c} {!usageUnits}" />
		   </apex:pageBlockSectionItem>
           <apex:pageBlockSectionItem >
				<apex:outputLabel value="{!$ObjectType.KimbleOne__Timesheet__c.Fields.KimbleOne__TotalEntryRevenue__c.Label}" />
				<apex:outputPanel layout="none">
					<apex:outputText value="{!TheTimesheet.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
					<apex:outputField value="{!TheTimesheet.KimbleOne__InvoicingCurrencyTotalEntryRevenue__c}" />
				</apex:outputPanel>
			</apex:pageBlockSectionItem>
           <apex:pageBlockSectionItem rendered="{!PreValidateTimesheet && TheAssignments.size == 1}">
				<apex:outputLabel value="{!$Label.kimbleone__currentremainingusageheading}" />
				<apex:outputText value="{!TheAssignments[0].PreApprovalRemainingUsage.InputDecimal__c} {!usageUnits}" />
		   </apex:pageBlockSectionItem>
           <apex:pageBlockSectionItem rendered="{!PreValidateTimesheet && TheAssignments.size == 1}">
				<apex:outputLabel value="{!$Label.kimbleone__preapprovalvalidationheading}" />
				<apex:outputPanel styleClass="pre-app-validation-messages">
					<apex:outputPanel layout="none" rendered="{!!TheAssignments[0].HasErrors}">
						<i class="fa fa-check-circle inline-validation ok"></i>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!TheAssignments[0].HasErrors}">
						<i class="fa fa-exclamation-circle inline-validation alert"></i>
					</apex:outputPanel>
					<apex:outputText value="{!TheAssignments[0].ApprovalValidation}" />
				</apex:outputPanel>
		   </apex:pageBlockSectionItem>
	    	<apex:pageBlockSectionItem rendered="{!PreValidateTimesheet && TheAssignments.size > 1}">
	    	<apex:pageBlockTable var="assignment" value="{!TheAssignments}" styleClass="multi-assignment-validation-table" >
	    		<apex:column value="{!assignment.Name}" headerValue="{!$Label.kimbleone__preapprovalvalidationheading}"/>
	    		<apex:column value="{!assignment.PreApprovalRemainingUsage.KimbleOne__InputDecimal__c} {!usageUnits}" headerValue="{!$Label.kimbleone__currentremainingusageheading}"/>
				<apex:column headerValue="{!$Label.kimbleone__validationmessagesheading}" styleClass="pre-app-validation-messages">
					<apex:outputPanel layout="none" rendered="{!!assignment.HasErrors}">
						<i class="fa fa-check-circle inline-validation ok"></i>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!assignment.HasErrors}">
						<i class="fa fa-exclamation-circle inline-validation alert"></i>
					</apex:outputPanel>
					<apex:outputText value="{!assignment.ApprovalValidation}" />
				</apex:column>    		
	    	</apex:pageBlockTable>
	    	</apex:pageBlockSectionItem>
	    	<apex:pageBlockSectionItem rendered="{!PreValidateTimesheet && TheAssignments.size > 1}"/>
			<apex:pageBlockSectionItem >
				<apex:outputLabel value="{!$Label.kimbleone__timesheetentryview}" />
					<apex:outputLink styleClass="k-link" value="{!$Page.KimbleOne__Timesheet}?id={!TheTimesheet.KimbleOne__Resource__c}&periodId={!TheTimesheet.KimbleOne__TimePeriod__c}">
		      	   			{!TheTimesheet.Resource__r.Name} - {!TheTimesheet.TimePeriod__r.Name} {
		      	   			<apex:outputField value="{!TheTimesheet.TimePeriod__r.KimbleOne__StartDate__c}"/>&nbsp;-&nbsp;<apex:outputField value="{!TheTimesheet.TimePeriod__r.KimbleOne__EndDate__c}"/>}
		      			</apex:outputLink>
			</apex:pageBlockSectionItem>
         </apex:pageBlockSection>
    
	<apex:pageBlockSection title="{!$Label.kimbleone__timesheetapproval}" columns="2" >
           <apex:outputField id="approvalStatus" value="{!TheTimesheet.KimbleOne__ApprovalStatus__c}" />
           <apex:outputField id="approver1" value="{!TheTimesheet.KimbleOne__Approver1User__c}" />
           <apex:outputField id="approvalComments" value="{!TheTimesheet.KimbleOne__ApprovalComments__c}" />
           <apex:outputField id="approver2" value="{!TheTimesheet.KimbleOne__Approver2User__c}" />
           <apex:pageBlockSectionItem rendered="{!TheTimesheet.CreatedById != TheTimesheet.OwnerId}" />
           <apex:outputField id="createdBy" rendered="{!TheTimesheet.CreatedById != TheTimesheet.OwnerId}" value="{!TheTimesheet.CreatedById}" />
	</apex:pageBlockSection>
 		
	<apex:PageBlockSection Title="{!$ObjectType.KimbleOne__TimeEntry__c.Labelplural}" columns="1" >
	   <apex:outputpanel id="TimeEntriesPane">
	  <apex:variable var="isDisplayingRevenueUnits" value="false"/>
	  <apex:variable var="isTaskBased" value="false"/>
	  <apex:repeat var="entry" value="{!TimeEntries}" >
	  	<apex:outputpanel layout="none" rendered="{!entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.RevenueUnitsCalculationMethod__r.KimbleOne__Enum__c == 'Manual'}">
	  		<apex:variable var="isDisplayingRevenueUnits" value="true"/>
	  	</apex:outputpanel>
	  	<apex:outputpanel layout="none" rendered="{!entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'Task' || entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'CategoryAndTask'}">
	  		<apex:variable var="isTaskBased" value="true"/>
	  	</apex:outputpanel>
	  </apex:repeat>
      <apex:pageBlockTable var="entry" value="{!TimeEntries}" >
      <apex:column headerValue="{!$Label.kimbleone__actionlinksheader}" rendered="{!TheTimesheet.KimbleOne__ApprovalStatus__c=='ReadyForApproval'}">
      	<a href="#" onclick="initialiseModalBoxy('#EditTimeEntryPopup', '{!$ObjectType.KimbleOne__TimeEntry__c.label}');editTimeEntry('{!JSENCODE(entry.Id)}')">{!$Label.kimbleone__edit}</a>
      </apex:column>
      	<apex:column value="{!entry.TimePeriod__r.KimbleOne__StartDate__c}" headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
		<apex:column value="{!entry.ActivityAssignment__r.ResourcedActivity__r.Name}" rendered="{!ShowResourcedActivityColumn}"/>
		<apex:column value="{!entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.Name} " headerValue="{!$Label.kimbleone__periodratebandalternatenamelabel}"/>
		<apex:column value="{!entry.ActivityAssignmentRate__r.ActivityAssignment__r.ActivityRole__r.Name}" headerValue="{!$ObjectType.KimbleOne__Resource__c.Label} {!$Label.kimbleone__role}"/>
		<apex:column value="{!entry.KimbleOne__StartTime__c}" rendered="{!StartEndTimeRequired}"/>
		<apex:column value="{!entry.KimbleOne__EndTime__c}" rendered="{!StartEndTimeRequired}"/>
		<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EntryUnits__c.Label}" >
			<apex:outputText rendered="{!ISBLANK(entry.KimbleOne__FormattedEntryUnits__c)}" value="{!entry.KimbleOne__EntryUnits__c} {!LOWER(If(entry.KimbleOne__EntryUnits__c>1,entry.ActivityAssignmentRate__r.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageUnitType__r.KimbleOne__Suffix__c, entry.ActivityAssignmentRate__r.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageUnitType__r.Name))}" />
			<apex:outputText rendered="{!!ISBLANK(entry.KimbleOne__FormattedEntryUnits__c)}" value="{!entry.KimbleOne__FormattedEntryUnits__c}"/>
		</apex:column>
		<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__RevenueUnits__c.Label}" rendered="{!isDisplayingRevenueUnits}">
			<apex:outputText value="{!entry.KimbleOne__RevenueUnits__c} {!LOWER(If(entry.KimbleOne__RevenueUnits__c>1,entry.ActivityAssignmentRate__r.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageUnitType__r.KimbleOne__Suffix__c, entry.ActivityAssignmentRate__r.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageUnitType__r.Name))}" 
					rendered="{!entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.RevenueUnitsCalculationMethod__r.KimbleOne__Enum__c == 'Manual'}">
		</apex:outputText>		
		</apex:column>
		<apex:column value="{!entry.KimbleOne__EntryRevenue__c}" headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EntryRevenue__c.Label}"/>
				
		<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__InvoicingCurrencyEntryRevenue__c.Label}" rendered="{!!ISBLANK(TheTimesheet.KimbleOne__InvoicingCurrencyTotalEntryRevenue__c)}">
			<apex:outputText value="{!entry.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
			<apex:outputField value="{!entry.KimbleOne__InvoicingCurrencyEntryRevenue__c}" />
		</apex:column>
		<apex:column headerValue="{!$ObjectType.KimbleOne__Task__c.Fields.Name.Label}" rendered="{!isTaskBased}">
			<apex:outputText rendered="{!'Task' == entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c || 'CategoryAndTask' == entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c || (entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c==null && entry.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageAllocationType__r.Enum__c = 'Task') }" value="{!entry.PlanTaskAssignment__r.PlanTask__r.Task__r.Name}" />
		</apex:column>
		<apex:column headerValue="{!$ObjectType.KimbleOne__PlanTaskAssignment__c.Fields.KimbleOne__DraftRemainingEffort__c.Label}" rendered="{!isTaskBased}">
			<apex:outputText styleClass="HoursAndMinsOutput" rendered="{!'Task' == entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c || 'CategoryAndTask' == entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c || (entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c==null && entry.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageAllocationType__r.Enum__c = 'Task') }" value="{!entry.PlanTaskAssignment__r.KimbleOne__DraftRemainingEffort__c}" />
		</apex:column>

		<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Reference__c.Label}">
			<apex:outputText rendered="{!'Reference' == entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c || (entry.ActivityAssignmentRate__r.ActivityPeriodRateBand__r.UsageAllocationType__r.Enum__c==null && entry.ActivityAssignment__r.ResourcedActivityOperatedWith__r.UsageAllocationType__r.Enum__c = 'Reference') }" value="{!entry.KimbleOne__Reference__c}" />
		</apex:column>

	  	<apex:column headerValue="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Case__c.Label}" rendered="{!TheTimesheet.ResourcedActivity__r.KimbleOne__HasCases__c}">
		  	<apex:outputField value="{!entry.KimbleOne__Case__c}" />
	  	</apex:column>

		<apex:column value="{!entry.KimbleOne__Category1__c}" rendered="{!TheActivityTimeCategories[1].show}" headerValue="{!TheActivityTimeCategories[1].TheCategory.Name}"/>
		<apex:column value="{!entry.KimbleOne__Category2__c}" rendered="{!TheActivityTimeCategories[2].show}" headerValue="{!TheActivityTimeCategories[2].TheCategory.Name}"/>
		<apex:column value="{!entry.KimbleOne__Category3__c}" rendered="{!TheActivityTimeCategories[3].show}" headerValue="{!TheActivityTimeCategories[3].TheCategory.Name}"/>
		<apex:column value="{!entry.KimbleOne__Category4__c}" rendered="{!TheActivityTimeCategories[4].show}" headerValue="{!TheActivityTimeCategories[4].TheCategory.Name}"/>
		<apex:column value="{!entry.KimbleOne__Category5__c}" rendered="{!TheActivityTimeCategories[5].show}" headerValue="{!TheActivityTimeCategories[5].TheCategory.Name}"/>

		<apex:column >
			<apex:outputText rendered="{!entry.KimbleOne__Notes__c!=null && entry.KimbleOne__Notes__c!=''}">
				<apex:image url="{!URLFOR($Resource.KimbleOne__DocIcon)}" alt="{!$Label.kimbleone__notes}"  title="{!entry.KimbleOne__Notes__c}" width="20" height="20" />
			</apex:outputText>
		</apex:column>
	  </apex:pageBlockTable>
   	</apex:outputpanel>

    </apex:PageBlockSection>

  </apex:pageBlock>
	</apex:outputpanel>
      </apex:form>
		<apex:include pageName="{!$Page.ApproveRejectItem}" rendered="{!InPageApproveRejectEnabled}"/>
		<apex:relatedList list="ProcessSteps"></apex:relatedList>

		<div id="EditTimeEntryPopup" style="display: none">

			<apex:outputPanel id="TimeEntryDetails">
				<apex:outputPanel id="EditTimeEntryDetails" style="min-width:550px;min-height:300px;display:block">
					<apex:form >

					<apex:outputPanel id="TimeMessagePanel">
						<div id="editErrors"><apex:pageMessages escape="false" id="errormessages" /></div>
					</apex:outputPanel>

					<apex:variable value="{!TimeEntry.Timesheet__r.KimbleOne__ApprovalStatus__c = 'ReadyForApproval'}" var="canEdit"/>

					<apex:pageBlock mode="edit" rendered="{!!ISBLANK(TimeEntry)}">
							<apex:pageBlockButtons location="bottom">
								<apex:commandButton value="{!$Label.kimbleone__save}" action="{!SaveTimeEntry}" oncomplete="if(!hideModalBoxyWithErrorCheck('#editErrors')) initialiseDynamicElements();applyHoursAndMinutesOutputs();" rerender="TimeEntryDetails, Timesheet" styleclass="DisableButtonWhileBusy" />
								<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}" />
							</apex:pageBlockButtons>
							<apex:pageblockSection collapsible="false" showheader="false" columns="1">

							<apex:pageBlockSectionItem labelStyle="width:30%">
								<apex:outputText value="{!$Label.kimbleone__resourceactivityalternativelabel}" />
								<apex:outputPanel layout="none">
								<apex:outputPanel rendered="{!TheActivityAssignmentOptions.size != 1}">
									<apex:selectList id="SelectedAssignment" value="{!TimeEntry.KimbleOne__ActivityAssignment__c}" multiselect="false" size="1" required="true">
										<apex:selectOptions value="{!TheActivityAssignmentOptions}" />
										<apex:actionSupport event="onchange" action="{!ActivityAssignmentChange}" rerender="TimeEntryDetails" onsubmit="DisableParentsChildren($('.DisableButtonWhileBusy'),'Reloading...');"/>
									</apex:selectList>
								</apex:outputPanel>

								<apex:outputPanel rendered="{!TheActivityAssignmentOptions.size = 1}">
									<apex:outputText value="{!TheActivityAssignmentOptions[0].Label}"/>
								</apex:outputPanel>

								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem >
								<apex:outputText value="{!$Label.kimbleone__periodratebandalternatenamelabel}" />

								<apex:selectList id="SelectedRateBand" value="{!TimeEntry.KimbleOne__ActivityAssignmentRate__c}" multiselect="false" size="1" required="true" onchange="updateRevenue()">
									<apex:selectOptions value="{!TheRateBands}" />
								</apex:selectList>

							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem >
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__TimePeriod__c.Label}" />
								<apex:outputField value="{!TimeEntry.TimePeriod__r.KimbleOne__StartDate__c}" />
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'Task'}">
									<apex:outputText value="{!$ObjectType.KimbleOne__Task__c.Fields.Name.Label}" />
									<apex:outputPanel layout="none">
										<apex:outputPanel layout="block" styleClass="requiredInput" rendered="{!canEdit}">
											<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
												<apex:actionRegion >
													<apex:selectList value="{!TimeEntry.KimbleOne__PlanTaskAssignment__c}" multiselect="false" size="1" required="true" >
														<apex:selectOptions value="{!ThePlanTaskOptions}" />
														<apex:actionSupport event="onchange" action="{!PlanTaskAssignmentChange}" rerender="TimeEntryDetails" onsubmit="DisableParentsChildren($('.DisableButtonWhileBusy'),'Reloading...');"/>
													</apex:selectList>
												</apex:actionRegion>
											</apex:outputPanel>
										<apex:outputField value="{!TimeEntry.KimbleOne__PlanTaskAssignment__c}" rendered="{!!canEdit}"/>
									</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:variable var="Suffix" value="{!TheSelectedAssignment.ResourcedActivityOperatedWith__r.UsageUnitType__r.KimbleOne__Suffix__c}" />

							<apex:pageBlockSectionItem rendered="{!TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'Task' || TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'CategoryAndTask'}">
									<apex:outputText value="{!$ObjectType.KimbleOne__PlanTaskAssignment__c.Fields.KimbleOne__DraftRemainingEffort__c.Label}" />
									<apex:outputPanel layout="none">
										<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
										<apex:inputField required="true" value="{!ThePlanTaskAssignment.KimbleOne__DraftRemainingEffort__c}" styleclass="AllTimeFields " rendered="{!canEdit}" html-display-hours-mins="{!canEdit && KimbleOne__Timesheet__c.ResourcedActivity__r.KimbleOne__ShowUsageAsHoursAndMins__c}"/>
									</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!StartEndTimeRequired && !ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__StartTime__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:inputField id="entryStartTime" styleclass="AllTimeFields kimbleTimePicker StartTimeText" value="{!TimeEntry.KimbleOne__StartTime__c}" required="true" rendered="{!canEdit}"/>
									<apex:outputField styleclass="AllTimeFields" value="{!TimeEntry.KimbleOne__StartTime__c}" rendered="{!!canEdit}"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!StartEndTimeRequired && !ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EndTime__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:inputField id="entryEndTime" styleclass="AllTimeFields kimbleTimePicker EndTimeText" value="{!TimeEntry.KimbleOne__EndTime__c}" required="true" rendered="{!canEdit}"/>
									<apex:outputField styleclass="AllTimeFields" value="{!TimeEntry.KimbleOne__EndTime__c}" rendered="{!!canEdit}"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText >
									<div><apex:outputText value="{!$Label.kimbleone__entrylabel} {!Suffix}"/></div>
								</apex:outputText>
								<apex:outputPanel layout="none">
									<apex:inputField id="EntryUnits" required="true" styleclass="EntryUnitsText" html-display-hours-mins="{!!ISBLANK(TheSelectedAssignmentRate) && canEdit && !ISBLANK(TimeEntry.KimbleOne__FormattedEntryUnits__c)}" value="{!TimeEntry.KimbleOne__EntryUnits__c}" rendered="{!canEdit}" onchange="updateRevenue()"/>
									<apex:outputField value="{!TimeEntry.KimbleOne__EntryUnits__c}" rendered="{!!canEdit}"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && TheSelectedAssignmentRate.ActivityPeriodRateBand__r.RevenueUnitsCalculationMethod__r.KimbleOne__Enum__c = 'Manual'}">
								<apex:outputText >
									<div><apex:outputText value="{!$Label.kimbleone__revenuelabel} {!Suffix}"/></div>
								</apex:outputText>
								<apex:outputPanel layout="none">
									<apex:inputField id="RevenueUnits" required="true" value="{!TimeEntry.KimbleOne__RevenueUnits__c}" rendered="{!canEdit}" onchange="updateRevenue()"/>
									<apex:outputField value="{!TimeEntry.KimbleOne__RevenueUnits__c}" rendered="{!!canEdit}"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem >
