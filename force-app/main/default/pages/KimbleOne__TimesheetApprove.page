								<apex:outputPanel layout="none">
									<apex:inputText value="{!TimeEntry.KimbleOne__Reference__c}"  rendered="{!canEdit}"/>
									<apex:outputField value="{!TimeEntry.KimbleOne__Reference__c}" rendered="{!!canEdit}"/>
