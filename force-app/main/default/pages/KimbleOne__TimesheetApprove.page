						<apex:outputPanel layout="none" rendered="{!InPageApproveRejectEnabled}">
						<script>
							jQuery(window).load(function()
							{
								var approvalItemId = '<apex:outputText value="{!KimbleOne__Timesheet__c.Id}"/>';

								overrideSFApproveRejectLink(approvalItemId);
							});

							function reLoadItemId()
							{
								var itemId =  '<apex:outputText value="{!KimbleOne__Timesheet__c.Id}"/>';
								return itemId;
							}
						</script>
						</apex:outputPanel>

						<script>
							var theRates = {};
							<apex:outputPanel layout="none" rendered="{!!ISBLANK(RatesJson)}">
								theRates = kimble.parseJSON("{!JSENCODE(RatesJson)}");
							</apex:outputPanel>

							var hoursAndMinsHelper;

							function initialiseDynamicElements()
			        		{
			        			jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i', 'show2400': 'true' });

			        			if(jQuery('.kimbleTimePicker').length > 0)
			        			{
				        			jQuery(document).on('change', '.kimbleTimePicker, .EntryUnitsText', function ()
									{
										timeChange(this);
									});
								}

								jQuery('.hours-and-mins').remove();

								jQuery(document).off('change','[display-hours-mins=true]').on('change', '[display-hours-mins=true]', function(e) {
										if (jQuery(this).next().hasClass('hours-and-mins'))
											jQuery(this).next().val(hoursAndMinsHelper.formatHours(kimble.parseNumber(jQuery(this).val())));
									});

									jQuery(document).off('blur','.hours-and-mins').on('blur', '.hours-and-mins', function(e) {
										var hrs = hoursAndMinsHelper.parseHours(this.value);
										jQuery(this).qtip('destroy', true);

										if (hrs == null) {
											var h = jQuery('<div style="white-space: pre-wrap;">' + hoursAndMinsHelper.helpMessage + '</div>');
											jQuery('.hours-and-mins').qtip({
																		content: h,
																		position: {my: 'bottom center', at: 'top center',viewport: $(window)},
																		style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
																		show: {ready:true, solo: true }
																		});
										} else {
											jQuery(this).prev().val(hrs).change();
										}
									})

								jQuery('[display-hours-mins=true]').each(function(i, obj){
									let $o = jQuery(obj);

									if ($o.is('input')) {
										$o.hide().after('<input type="text" class="hours-and-mins"/>');
										$o.change();
									}
									else {
										$o.text(hoursAndMinsHelper.formatHours(kimble.parseNumber($o.text())));
									}
								});
			        		}

			        		function timeChange(theField)
							{
								var currentStartTime = jQuery('.kimbleTimePicker.StartTimeText:visible').val();
								var currentEndTime = jQuery('.kimbleTimePicker.EndTimeText:visible').val();
								var currentEntryUnits = jQuery('.EntryUnitsText:visible').val();

								// given a end time and a start time work out the usage
								if (jQuery(theField).hasClass('StartTimeText') && currentEndTime != '') {
									jQuery('.EntryUnitsText:visible').val(timeDiff(currentStartTime, currentEndTime));
								} else if (jQuery(theField).hasClass('EndTimeText') && currentStartTime != '') {
									jQuery('.EntryUnitsText:visible').val(timeDiff(currentStartTime, currentEndTime).toFixed(3));
								} else if (jQuery(theField).hasClass('EntryUnitsText') && currentStartTime != '') {
									// we only update the end time if the value is blank or the calculated value is greater
									// meaning that you can update the usage to less than the difference
									var newEndTime = timeAddHours(currentStartTime, currentEntryUnits);
									if(currentEndTime == '' || currentEndTime < newEndTime)
									{
										jQuery('.kimbleTimePicker.EndTimeText:visible').val(newEndTime);
									}
								}
							}

							function timeDiff(startTime, endTime)
							{
								// date is unimportant, using Date construct to do time maths
								return (new Date(2000, 0, 1, parseTime(endTime).hh, parseTime(endTime).mm) - new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm)) / 1000 / 60 / 60;
							}

							function timeAddHours(startTime, hours)
							{
								var newDateTime = addHours(new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm), hours);

								var min = newDateTime.getMinutes();
								if (min < 10) {
									min = "0" + min;
								}

								var hour = newDateTime.getHours();
								if (hour < 10) {
									hour = "0" + hour;
								}

								var newTime = hour + ':' + min;

								// special case - if the result is 00:00 and we are adding >0 hours then this must be 24:00
								newTime = (newTime == "00:00" && hours > 0 ? "24:00" : newTime);

								return newTime;
							}

							function addHours(theDate, hours)
							{
								theDate.setTime(theDate.getTime() + (hours * 60 * 60 * 1000));
								return theDate;
							}

							function parseTime(s)
							{
								var part = s.match(/(\d+):(\d+)(?: )?(am|pm)?/i);
								var hh = parseInt(part[1], 10);
								var mm = parseInt(part[2], 10);
								var ap = part[3] ? part[3].toUpperCase() : null;
								if (ap === "AM") {
									if (hh == 12) {
										hh = 0;
									}
								}
								if (ap === "PM") {
									if (hh != 12) {
										hh += 12;
									}
								}
								return {
									hh : hh,
									mm : mm
								};
							}

						</script>

					</apex:form>
				</apex:outputPanel>


			</apex:outputPanel></div>

				<script>
						$(document).ready(function(){
    						$(function() {
    							$('input[name="piSubmit"]').remove();
    							$('input[name="piRemove"]').remove();
    						})

    						jQuery('i.inline-validation.alert').closest('tr').addClass('has-errors');
    						jQuery('.multi-assignment-validation-table').parent('td').prop('colspan', 4);

							hoursAndMinsHelper = initialiseHoursAndMinsHelper('{!JSENCODE($Label.HoursPart)}','{!JSENCODE($Label.MinutesPart)}', '{!JSENCODE($Label.HoursAndMinsEntryHelp)}');

							applyHoursAndMinutesOutputs();
    					});

    					function updateRevenue()
						{
							var rate = theRates[jQuery('[id$="SelectedRateBand"]').val()];

							var entryUnits = jQuery('input[id$="EntryUnits"]').val();

							if (jQuery('input[id$="RevenueUnits"]').length != 0)
								entryUnits = jQuery('input[id$="RevenueUnits"]').val();

							jQuery('[id$="EntryRevenue"]').text(jQuery.formatNumber(rate * entryUnits,{format:'#,##0.00', locale:kimble.locale, isFullLocale:false}));

						}

						function applyHoursAndMinutesOutputs()
						{
						    if({!Timesheet__c.ResourcedActivity__r.ShowUsageAsHoursAndMins__c})
						    {
								jQuery('.HoursAndMinsOutput').each(function()
								{
									var formattedValue = hoursAndMinsHelper.formatHours(jQuery(this).text());
									jQuery(this).text(formattedValue);
								});
							}
						}
				</script>	


</apex:define>

</apex:composition>

