<apex:page standardController="KimbleOne__CandidateResource__c" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

	<apex:define name="Menu">
	
		<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="CandidateResource" MenuContextId="{!KimbleOne__CandidateResource__c.Id}" MenuContextName="{!KimbleOne__CandidateResource__c.Name}"/>
		
	</apex:define>
     
	<apex:define name="Content">
	
		<chatter:feedWithFollowers entityId="{!KimbleOne__CandidateResource__c.Id}"/>
	
		<apex:pageBlock >
			<apex:pageBlockSection collapsible="false" columns="2" title="{!KimbleOne__CandidateResource__c.Name}">
				<apex:outputField value="{!KimbleOne__CandidateResource__c.Name}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__CandidateStatus__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__ResourceType__c}" />
				<apex:outputText value="" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__FirstName__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__LastName__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__BusinessUnit__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__BusinessUnitSecondary__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__Resource__c}" />
				<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__CandidateStage__c}" />
				<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__CandidateResource__c.KimbleOne__Vacancy__c)}">
					<apex:outputLabel >{!$ObjectType.KimbleOne__CandidateResource__c.Fields.KimbleOne__Vacancy__c.Label}</apex:outputLabel>
					<apex:outputField value="{!KimbleOne__CandidateResource__c.KimbleOne__Vacancy__c}"  />
				</apex:pageBlockSectionItem>			
				<apex:repeat value="{!$ObjectType.KimbleOne__CandidateResource__c.FieldSets.KimbleOne__CandidateResourceDetails}" var="f" >
	     			<apex:outputField value="{!KimbleOne__CandidateResource__c[f]}" />
	   			</apex:repeat>
							
			</apex:pageBlockSection>
		</apex:pageBlock>
	
	</apex:define>

</apex:composition>
</apex:page>