<apex:page controller="KimbleOne.DeliveryGroupStatusCardController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__ReferenceData__c">    
	<apex:outputPanel layout="none" rendered="true">
		<div id="divGroupStatusCard" class="card inverted variable-width min-horizontal-padding">
		
			<apex:outputPanel layout="none" rendered="{!(TheGroupStatuses.size > 0)}">
				<apex:variable value="{!TheGroupStatuses[0]}" var="TheFirstStatus"/>
				<div class="cardHeading inverted" title="{!$Label.kimbleone__statuslabel}: {!JSENCODE(TheFirstStatus.Status)}">
					<h3 class="cardTitle"><a class="undecorated-link" href="{!$Page.KimbleOne__DeliveryGroupStatusEdit}?id={!TheFirstStatus.StatusId}&deliveryGroupId={!TheDeliveryGroups[0]}&redirect=dashboard"><apex:outputText value="{!$Label.kimbleone__deliverygroupstatussummarystatus} - {!TheFirstStatus.TimePeriodDisplay}"/></a></h3>
					<div class="DeliveryStatus {!JSENCODE(TheFirstStatus.Style)} fa fa-circle"></div>
					<apex:outputPanel rendered="{!ShowUsagePercent}" styleClass="usage-percent-complete">
						<span id="usagePercentCompleteOutput" class="cardFooterLabel"><apex:outputText value="{!$Label.kimbleone__deliverygroupusagepercentcomplete}" /></span>
					 	<span class="cardFooterValue"><apex:outputField value="{!UsagePercentComplete.KimbleOne__InputInteger__c}" />%</span>
					</apex:outputPanel>
				</div>
			</apex:outputPanel>  

			<apex:outputPanel layout="none" rendered="{!(TheGroupStatuses.size == 0)}">
				<div class="cardHeading inverted">
					<h3 class="cardTitle"><a class="undecorated-link" href="{!$Page.KimbleOne__DeliveryGroupStatusEdit}?deliveryGroupId={!TheDeliveryGroups[0]}&redirect=dashboard"><apex:outputText value="{!$Label.kimbleone__deliverygroupstatussummarystatus}"/></a></h3>
					<div class="DeliveryStatus"></div>
					<apex:outputPanel rendered="{!ShowUsagePercent}" styleClass="usage-percent-complete">
						<span id="usagePercentCompleteOutput" class="cardFooterLabel"><apex:outputText value="{!$Label.kimbleone__deliverygroupusagepercentcomplete}" /></span>
					 	<span><apex:outputField value="{!UsagePercentComplete.KimbleOne__InputInteger__c}" />%</span>
					</apex:outputPanel>
				</div>
			</apex:outputPanel>  
				
			<div id="summaryCardBody" class="cardBody">
				<apex:repeat value="{!TheGroupStatuses}" var="theGroupStatus">			    	
			    	<table class="perspectivesRow">
			    		<tr>
				    		<apex:repeat value="{!theGroupStatus.StatusDetails}" var="statusDetail">
					    		<td>
					    			<span title="{!JSENCODE(statusDetail.Status)}">
					    				<div class="PerspectiveStatus {!JSENCODE(statusDetail.Style)} fa fa-circle"></div>&nbsp;<apex:outputText value="{!statusDetail.Name}" />&nbsp;
					    			</span>
					    		</td>
							</apex:repeat>
				    	</tr>
			    	</table>
			    	<apex:outputPanel layout="none" rendered="{!!ISBLANK(theGroupStatus.Narrative)}">
				    	<div class="deliveryGroupNarrativeContainer">					
							<apex:outputText value="{!theGroupStatus.Narrative}"></apex:outputText>
						</div>
					</apex:outputPanel>			    						
				</apex:repeat>
				<apex:outputPanel layout="none" rendered="{!TheGroupStatuses.size == 0}">
					<apex:outputLabel value="{!$Label.kimbleone__deliverygrouphomeemptynarrative}" />
				</apex:outputPanel>
 			</div>
 			 
		</div>
	</apex:outputPanel>
    
    <style>
				
		#summaryCardBody
		{
		  	height: 150px;
  			overflow-y: auto;
		}
		
		.usage-percent-complete {
			float: right;
			font-size: 12px;
			padding-top: 3px;
		}
		
		.perspectivesRow {
			width: 100%;
		}
		
	    .perspectiveItem
	    {
	    	display:inline-block;
	    	vertical-align: top;
	    }
	    
	    .DeliveryStatus
	    {
			font-size: 18px;
			float: right;
	    }
	    
	    .PerspectiveStatus
	    {
			font-size: 13px;
	    }
	    
		.DeliveryStatusRed {color: #E50000}
		.DeliveryStatusAmber {color: #FFB732}
		.DeliveryStatusGreen {color: #32b42a}
		
		.deliveryGroupNarrativeContainer
		{
			padding-bottom: 15px;
			padding-top: 3px;
		}
		
		.deliveryGroupNarrativeSeparator
		{
		    border-bottom: 1px solid #ddd;
			width: 100%;
			padding-bottom: 5px;
			margin-bottom: 3px;
		}
    </style>
    
    <script>
 
     </script>
</apex:page>