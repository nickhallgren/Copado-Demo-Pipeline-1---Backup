<apex:page standardController="KimbleOne__InvoiceFormat__c" sidebar="false" showHeader="true" tabStyle="KimbleOne__InvoiceFormat__c">


<apex:composition template="KimbleOne__SiteMaster">
	<apex:define name="Menu">
		<c:Menu id="menuPageTitle" DefaultHelpPage="CustomizingInvoiceFormats.html" MenuContextName="{!$ObjectType.KimbleOne__InvoiceFormat__c.Label}"/>
 	</apex:define>

	<apex:define name="Content">	
		<apex:form >
		 	<apex:pageBlock Id="InvoiceFormat">
		 		<apex:pageBlockButtons location="top">
					<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InvoiceFormat__c.updateable}">
						<input class="btn invformat-edit-btn" type="button" onclick="safeNavigateToSForceURL('{!$Page.InvoiceFormatEdit}?id={!InvoiceFormat__c.Id}');" value="{!$Label.Edit}" />
						<input class="btn" type="button" onclick="safeNavigateToSForceURL('{!$Page.InvoiceFormatEdit}?cloneId={!InvoiceFormat__c.Id}');" value="{!$Label.CloneLabel}"/>
					</apex:outputPanel>
					<input class="btn" type="button" onclick="safeNavigateToSForceURL('{!$Page.InvoiceFormatTranslationRedirect}');" value="{!$Label.ManageTranslationsLabel}"/>
					<input class="btn" type="button" onclick="safeNavigateToSForceURL('/{!$ObjectType.InvoiceFormat__c.keyPrefix}');" value="{!$Label.Cancel}"/>
		 		</apex:pageBlockButtons>
		 		
				<apex:pageblockSection collapsible="false" showHeader="false" columns="2">	
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.Name}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__InvoiceMode__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__ShowContext__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsInternal__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField label="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RoundingRule__c.Label}" value="{!KimbleOne__InvoiceFormat__c.RoundingRule__r.KimbleOne__Description__c}"/>
 				</apex:pageblockSection>

				<apex:pageblockSection collapsible="false" title="Fixed Narrative Settings" columns="2">	
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__SingleDateNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__DateRangeNarrative__c}"/>
					<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitNarrative__c.inlineHelpText}" >
						<apex:outputPanel >
							<apex:outputLabel value="{!$Label.kimbleone__costlabel} {!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitNarrative__c.Label}" rendered="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
							<apex:outputLabel value="{!$Label.kimbleone__revenuelabel} {!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitNarrative__c.Label}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
						</apex:outputPanel>
						<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__RatePerUnitNarrative__c}" />
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitPerPeriodNarrative__c.inlineHelpText}" >
						<apex:outputPanel >
							<apex:outputLabel value="{!$Label.kimbleone__costlabel} {!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitPerPeriodNarrative__c.Label}" rendered="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
							<apex:outputLabel value="{!$Label.kimbleone__revenuelabel} {!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitPerPeriodNarrative__c.Label}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
						</apex:outputPanel>
						<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__RatePerUnitNarrative__c}" />
					</apex:pageBlockSectionItem>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__RatePerUnitNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__RatePerUnitPerPeriodNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__NumberOfUnitsNarrative__c}"/>
 				</apex:pageblockSection>

				<apex:pageblockSection collapsible="false" title="Invoice Line Narrative Settings" columns="2">	
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__TimeEntryNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__MilestoneNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__ExpenseItemNarrative__c}"/>
					<apex:outputText value=""/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__PeriodRevenueNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__PeriodCostNarrative__c}" rendered="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__InvoiceAdjustmentNarrative__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__RevenueAdjustmentNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__DepositAdjustmentNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__DepositNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__CreditNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__CreditAdjustmentNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__DiscountItemNarrative__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__InternalRevenueShareNarrative__c}" rendered="{!!InvoiceFormat__c.IsSupplier__c && InvoiceFormat__c.IsInternal__c }"/>
 				</apex:pageblockSection>

				<apex:pageblockSection collapsible="false" title="Time Format Settings" columns="2">	
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__ShowTimeInTabularFormat__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__ShowResourceRateInColumn__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__ShowResourceNumberOfUnitsInColumn__c}"/>
 				</apex:pageblockSection>

				<apex:pageblockSection collapsible="false" title="Auto Invoice Settings" columns="2">	
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeExpenseItem__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeTimeEntry__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeMilestone__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludePeriodRevenue__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeDeposit__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludePeriodCost__c}" rendered="{!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeDepositAdjustment__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeCredit__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeCreditAdjustment__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeDiscountItem__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeInternalRevenueShare__c}" rendered="{!!InvoiceFormat__c.IsSupplier__c && InvoiceFormat__c.IsInternal__c }"/>
					<apex:outputField value="{!KimbleOne__InvoiceFormat__c.KimbleOne__IncludeRevenueAdjustment__c}" rendered="{!!KimbleOne__InvoiceFormat__c.KimbleOne__IsSupplier__c}"/>
 				</apex:pageblockSection>

			</apex:pageBlock>
		</apex:form>
	</apex:define>
	
</apex:composition>	
	
			
</apex:page>