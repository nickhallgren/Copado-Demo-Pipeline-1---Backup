<apex:page standardcontroller="KimbleOne__CandidateResource__c" extensions="KimbleOne.CandidateResourceCloseStageController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="CandidateResource" MenuContextId="{!KimbleOne__CandidateResource__c.Id}" MenuContextName="{!KimbleOne__CandidateResource__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
        
	<apex:form >   
      
		<apex:pageMessages escape="false"/>
 
		<apex:pageBlock title="{!$Label.kimbleone__candidateresourcestagedetailsheader}" >

			<apex:pageBlockSection title="{!$Label.kimbleone__candidateresourcestagenarrative}" collapsible="false">

				<apex:outputField id="opportunityStage" value="{!KimbleOne__CandidateResource__c.KimbleOne__CandidateStage__c}" />
				<apex:outputField id="opportunityStatus" value="{!KimbleOne__CandidateResource__c.KimbleOne__CandidateStatus__c}" />
         
			</apex:pageBlockSection>

		</apex:pageBlock>

		<apex:pageBlock >

			<apex:commandButton action="{!closeStage}" value="{!$Label.kimbleone__close}"/>
		
		</apex:pageBlock>

	</apex:form>
  
</apex:define>

</apex:composition>

</apex:page>