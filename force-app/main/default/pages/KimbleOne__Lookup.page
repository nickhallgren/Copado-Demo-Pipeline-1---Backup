<apex:page controller="KimbleOne.LookupController" showHeader="false" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuery, 'jquery-1.6.min.js')}"/>
	<body class="lookupTab" style="margin-left: 4px;margin-right: 4px;">
	<apex:form id="TheForm">
	
	<style>
		.limit-message
		{
			padding: 7px;
		    display: block;
		    background-color: #ffc;
		}
	</style>
		
	<div class="lookup">
		<div class="bPageTitle">
			<div class="ptBody secondaryPalette">
				<div class="content">
					<img src="/s.gif" alt="" class=" PageTitleIcon" title=""/>
					<h1>{!$Label.LookupHeading}</h1>
				</div>
			</div>
		</div>
	
		<div class="pBody">
			<label>{!$Label.SearchByNameLabel}</label>
			<apex:inputText value="{!NameFilter}"/>
			<apex:commandButton action="{!Go}" value="{!$Label.kimbleone__salesforcestylegobutton}" title="{!$Label.kimbleone__salesforcestylegobutton}"/>
		</div>
		<div class="pBody">
			<label for="lksrch"></label> 
			<apex:repeat var="f" value="{!TheSearchContext.SearchFields}">
				<div style="float:left;height: 26px;">
				<label><apex:outputText value="{!f.Label}"/>&nbsp;
				
				<apex:selectList value="{!f.BindValue}" size="1" rendered="{!f.TheOptions.size != 0}">
					<apex:selectOptions value="{!f.TheOptions}" />
				</apex:selectList>
        		
        		<apex:inputText value="{!f.BindValue}" rendered="{!!f.IsBindObject && f.TheOptions.size = 0}"/>
				
				<apex:inputField value="{!TheSearchContext.BindObject[f.Name]}" rendered="{!f.IsBindObject}"/>
				</label>
				</div>
			</apex:repeat>
			<div style="clear:both"></div>
		</div>
	</div>
	
	<div class="lookup">
		<div class="clearResults">&lt;
			<apex:outputLink value="javascript:void(0)" onclick="clearResults()">{!$Label.kimbleone__clearsearchresultslink}</apex:outputLink>
			<apex:actionFunction action="{!ClearResults}" name="clearResults" rerender="TheForm"></apex:actionFunction>
		</div>
	</div>
	
	<br/>	
	
	<apex:pageBlock title="{!TheSearchContext.ObjectLabelPlural}" mode="edit" >
		<apex:outputText styleClass="limit-message" value="{!TheSearchContext.LimitMessage}" rendered="{!!ISBLANK(TheSearchContext.LimitMessage) && TheSearchContext.LimitMessage != ''}"/>
		<div id="wrapper" style="overflow-y:scroll;overflow-x:auto;">
		<apex:pageBlockTable value="{!TheSearchContext.TheResults}" var="result" rendered="{!TheSearchContext.TheResults.size != 0}">
      				   					
			<apex:column headervalue="{!$Label.kimbleone__name}">
				<apex:outputLink rendered="{!!ISBLANK(FormTag)}" value="javascript:try{top.window.opener.lookupPick2('{!FormTag}','{!TextBox}_lkid','{!TextBox}','{!result.Id}','{!JSENCODE(result[TheSearchContext.NameField])}', false);}finally{top.window.opener.closePopup();}">{!result[TheSearchContext.NameField]}</apex:outputLink>
				<apex:outputLink rendered="{!ISBLANK(FormTag)}" value="javascript:try{top.window.opener.kimblePickValue('{!TextBox}','{!result.Id}','{!JSENCODE(result[TheSearchContext.NameField])}');}finally{top.window.opener.closePopup();}">{!result[TheSearchContext.NameField]}</apex:outputLink>
			</apex:column>
  				
			<apex:repeat var="f" value="{!TheSearchContext.TheResultFields}">
				  <apex:column headerValue="{!f.label}">
				  		<span class="removeLink">
             				<apex:outputField value="{!result[f.Name]}"/>
             			</span>
        	 	</apex:column>
     		</apex:repeat> 
     		
  		</apex:pageBlockTable>
  		</div>
  		<script>
				 $(document).ready(function(){
				 	jQuery.each($('.removeLink:has(a)'), function(i, o){
				 		var obj = $(o);
				 		var t = obj.text();
				 		obj.empty().text(t);
				 	});
				 	
				 });
				 
				 $(function(){
    				$('#wrapper').css({'height':($(window).height() - $('#wrapper').offset().top -11) +'px'});
    				$(window).resize(function(){
        				$('#wrapper').css({'height':($(window).height() - $('#wrapper').offset().top -11)+'px'});
    				});
				});
				

			</script>
  		
	</apex:pageBlock>
	
	</apex:form>
	</body>
</apex:page>