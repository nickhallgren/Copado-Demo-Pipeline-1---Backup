<apex:page standardcontroller="KimbleOne__ResourcedActivity__c" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">

	<apex:composition template="KimbleOne__SiteMaster">
	 
		<apex:define name="Menu">
			<c:Menu MenuContextName="{!$ObjectType.KimbleOne__ResourcedActivity__c.Label}" />
		</apex:define>
		
		<apex:define name="Content">
			<apex:outputText value="{!$Label.kimbleone__resourcedactivitypreventnewmessage}" rendered="{!ISBLANK(KimbleOne__ResourcedActivity__c.Id)}"/>
			
			<apex:outputPanel layout="none" rendered="{!!ISBLANK(KimbleOne__ResourcedActivity__c.Id)}">
				Resourced Activities cannot be opened from here. You will be redirected in 5 seconds, alternatively click this link to continue:
				
				<apex:outputLink styleclass="redirect-to" value="{!$Page.KimbleOne__ActivityAssignmentsDelivery}?filterid={!KimbleOne__ResourcedActivity__c.Id}&id={!KimbleOne__ResourcedActivity__c.KimbleOne__DeliveryGroup__c}" rendered="{!!ISBLANK(KimbleOne__ResourcedActivity__c.KimbleOne__DeliveryGroup__c)}"><apex:outputText value="{!KimbleOne__ResourcedActivity__c.Name}"/></apex:outputLink>
				
				<apex:outputLink styleclass="redirect-to" value="{!$Page.KimbleOne__BidTeamAssignments}?id={!KimbleOne__ResourcedActivity__c.Id}" rendered="{!!ISBLANK(KimbleOne__ResourcedActivity__c.KimbleOne__Proposal__c)}"><apex:outputText value="{!KimbleOne__ResourcedActivity__c.Name}"/></apex:outputLink>
				
				<apex:outputLink styleclass="redirect-to" value="{!$Page.KimbleOne__OtherResourcedActivityDetails}?id={!KimbleOne__ResourcedActivity__c.Id}" rendered="{!KimbleOne__ResourcedActivity__c.ResourcedActivityType__r.KimbleOne__Enum__c = 'Other'}"><apex:outputText value="{!KimbleOne__ResourcedActivity__c.Name}"/></apex:outputLink>
				
			</apex:outputPanel>
			
			<script>
				var delay = 5000;
				setTimeout(function(){jQuery('.redirect-to')[0].click();}, delay);
			</script>
		</apex:define>
	
	</apex:composition>	

</apex:page>