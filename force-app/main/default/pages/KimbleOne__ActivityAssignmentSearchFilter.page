<apex:page id="ActivityAssignmentSearchFilter" showHeader="false">
    <div id="AssignmentFilterPopup" style="display:none;">

        <div id="AssignmentFilters">
            <div id="AssignmentFilterCriteria">
                <div class="filter-header"><span id="assignment-search-name"></span><i onclick="jQuery('#AssignmentFilterPopup').hide();" class="filter-collapse-btn fa fa-angle-double-up" title="{!$Label.Close}"></i></div>

                <div class="ionTabs" id="filter-tabs" data-name="filter-tabs-group" >
                    <ul class="ionTabs__head">
                        <li class="ionTabs__tab" data-target="filtering">{!$Label.Filters}<div class="clear-filter-btn " title="{!JSENCODE($Label.ClearAllLabel)}"><i class="fa fa-times-circle" onclick="clearAssignmentFilter()"></i></div></li>
                        <li class="ionTabs__tab" data-target="sorting">{!$Label.Sorting}</li>
                        <li class="ionTabs__tab" data-target="dates">{!$Label.Dates}</li>
                    </ul>
                    <div class="ionTabs__body" >
                        <div class="ionTabs__item" data-name="filtering">

                            <div class="ParentQueryConfig">
                                <div class="parent-filter-header"><span></span></div>
                                <div class="Filters"></div>
                            </div>
                            
                            <div class="ChildQueryConfig">
                                <div class="child-filter-header"></div>
                                <div class="Filters"></div>
                            </div>
                        </div>
                        <div class="ionTabs__item" data-name="sorting">
                            <div class="ParentQueryConfig">

                                <div class="OrderBy">
                                    <div class="filter-heading">{!$Label.SortOrder}</div>
                                    <ul class="sort-items"></ul>
                                </div>
                            </div>

                            <div class="ChildQueryConfig">
                                <div class="child-filter-header"></div>
                                <div class="OrderBy">
                                    <div class="filter-heading">{!$Label.SortOrder}</div>
                                    <ul class="sort-items"></ul>
                                </div>
                            </div>
                        </div>
                        <div class="ionTabs__item" data-name="dates">
                            <div id="date-range">
                                <div class="filter-heading">Date Range</div>
                                <label class="radio-inline">
                                    <input id="date-fixed" type="radio" name="date-range">Fixed</input>
                                </label>
                                <label class="radio-inline">
                                    <input id="date-rolling" type="radio" name="date-range">Rolling</input>
                                </label>
                                <label class="radio-inline">
                                    <input id="date-none" type="radio" name="date-range">None</input>
                                </label>
                               <div id="fixed-dates">
                                    <div class="filter-heading">From</div>
                                    <input id="date-from" class="filter-date" type="text"/>

                                    <div class="filter-heading">To</div>
                                   <input id="date-to" class="filter-date" type="text"/>
                                </div>
                                <div id="rolling-dates">
                                    <div class="filter-heading">Number Of Days Before Today</div>
                                    <input id="rolling-days-before" type="text"/>

                                    <div class="filter-heading">Number Of Days After Today</div>
                                    <input id="rolling-days-after" type="text"/>
                                </div>
                            </div>
                        </div>
                        <div class="ionTabs__preloader"></div>
                    </div>
                </div>
                
            </div>



            <div id="save-buttons" style="margin-top: 8px;margin-left: 6px;">
                <input class="btn" id="saveButton" onclick="applyAssignmentFilter(function(){saveConfiguration()});" type="Button" value="{!$Label.Save}" style="display:none;"/>

                <input class="btn" id="saveAsButton" onclick="saveConfigAs()" type="Button" value="{!$Label.SaveAs}"/>

                <input class="btn" style="position: absolute;right: 15px;" id="applyFilterButton" onclick="applyAssignmentFilter(function(){newSearch()});" type="Button" value="{!$Label.ApplyFilter}"/>
            </div>


            <div id="config-name-edit" style="display:none">
                <apex:pageBlock title="{!$ObjectType.KimbleOne__ActivityAssignmentSearch__c.Label}" mode="edit">
                    <apex:pageBlockButtons location="bottom">
                        <input class="btn" onclick="configName = jQuery('#config-name').val(); jQuery('#assignment-search-name').text(configName); configId = null; hideModalBoxy(); applyAssignmentFilter(function(){saveConfiguration()});" type="button" value="{!$Label.Save}" style="width:60px;"/>
                        <input class="btn" onclick="hideModalBoxy()" type="button" value="{!$Label.Cancel}" style="width:60px;"/>
                    </apex:pageBlockButtons>

                    <apex:pageblockSection collapsible="false" showheader="false" columns="2" >

                        <apex:pageBlockSectionItem >
                            <apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignmentSearch__c.Fields.Name.Label}" />
                            <input type="text" id="config-name" />
                        </apex:pageBlockSectionItem>

                    </apex:pageblockSection>
                </apex:pageBlock>
            </div>

        </div>
        <script>

        var filtersInitialised = false;

        function initialiseAssignmentFilters(config, context)
        {
            var theFilter =  jQuery('#AssignmentFilterPopup');

            if (context.closest('#fixed-header').length == 1)
                theFilter.css('top', 36);
            else
                theFilter.css('top', 54 + jQuery('#AppBodyHeader').height() + (jQuery('#AppBodyHeader').height() > 0 ? 5 : 0));

            theFilter.show();

            if (!filtersInitialised)
            {
                initialiseFilters(config);
            }

        }

        function changeSort(obj)
        {
           jQuery(obj).toggleClass('fa-sort-alpha-asc').toggleClass('fa-sort-alpha-desc');
        }

        function buildOrderBy($container, OrderBy, fixedOrderBy)
        {
            if (fixedOrderBy)
            {
                $container.append('<li class="not-sortable group-by-order"><div class="order-by-item" data-field-name="' + fixedOrderBy.FieldName + '"><span>' + fixedOrderBy.DisplayName + '</span><i onclick="changeSort(this);" class="change-sort fa ' + (fixedOrderBy.Order == 'ASC'?'fa-sort-alpha-asc':'fa-sort-alpha-desc') + '"/></div></li>');
            }

            jQuery.each(OrderBy, function(i, orderBy){
               $container.append('<li><div class="sortable order-by-item" data-field-name="' + orderBy.FieldName + '"><span class="re-order-item fa fa-th-large" style="display:' + (OrderBy.length > 1?'':'none') + '"></span><span>' + orderBy.DisplayName + '</span><i onclick="changeSort(this);" class="change-sort fa ' + (orderBy.Order == 'ASC'?'fa-sort-alpha-asc':'fa-sort-alpha-desc') + '"/></div></li>');
            });
        }

        function buildCriteria(container, config)
        {
            jQuery.each(jQuery(Object.keys(config.Filters)), function(i, key){

                var filter = config.Filters[key];

                if (filter.Editable)
                {
                    if (filter.DisplayType == 'REFERENCE')
                    {
                        container.append('<div class="filter-heading">' + filter.DisplayName + '</div>');
                        var $filter = jQuery('<input type="hidden" style="width:100%"/>');
                        $filter.prop('id', key);

                        container.append($filter);

                        $filter.select2({
                            placeholder: filter.DisplayName,
                            minimumInputLength: 2,
                            multiple: true,
                            query: function (query) {

                                var find = function() {findLookupValues(filter.LookupObjectType, null, '', query, filter.RelatedObjectCriteria);};
                                find();
                            }
                        }).on("change", function (e) {console.log('filter-changed')});

                        if (filter.DefaultValue != null)
                        {
                            sforce.connection.query("SELECT Id, Name FROM " + filter.LookupObjectType + " WHERE Id IN (" + filter.DefaultValue + ")", {
                                onSuccess:function(result){
                                    var records = [];

                                    if (!jQuery.isArray(result.records))
                                        records.push(result.records);
                                    else
                                        records = result.records;

                                    var data = [];

                                    for (var i=0;i<records.length;i++)
                                    {
                                        data.push({id:records[i].Id, text:records[i].Name});
                                    }

                                    $filter.select2('data',  data);
                                },
                                onFailure:function(error){console.log(error);}
                            });

                        }
                    }
                    else if (filter.DisplayType == 'BOOLEAN')
                    {

                        var $filter = jQuery('<div class="filter-heading">' + filter.DisplayName + '<input id="' + key + '" type="checkbox" /></div>');
                        container.append($filter);

                        if (filter.DefaultValue == 'true')
                        {
                            jQuery('#' + key).prop('checked', true);
                        }
                    }
                    else if (filter.DisplayType == 'DATE')
                    {
                        container.append('<div class="filter-heading">' + filter.DisplayName + '</div>');
                        var html = '<table border="0" cellpadding="0" cellspacing="0" style="font-size: 11px;color: #4a4a56;"><tr><td><span style="margin-left: 4px;">{!$Label.LessThanLabel}</span></td><td><span style="margin-left: 4px;">{!$Label.EqualToLabel}</span></td><td><span style="margin-left: 4px;">{!$Label.GreaterThanLabel}</span></td></tr>';
                        html += '<tr><td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="date-filter" id="' + key + '-lt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '<td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="date-filter" id="' + key + '-eq-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '<td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="date-filter" id="' + key + '-gt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '</tr></table>';

                        container.append(jQuery(html));

                        if (filter.DefaultValue != null && filter.DefaultValue != '')
                        {
                            if (filter.Operator == '<')
                                jQuery('#' + key + '-lt-filter').val(kimble.formatDate(filter.DefaultValue));
                            else if (filter.Operator == '=')
                                jQuery('#' + key + '-eq-filter').val(kimble.formatDate(filter.DefaultValue));
                            else if (filter.Operator == '>')
                                jQuery('#' + key + '-gt-filter').val(kimble.formatDate(filter.DefaultValue));

                        }
                    }
                    else if (filter.DisplayType == 'NUMERIC')
                    {
                        container.append('<div class="filter-heading">' + filter.DisplayName + '</div>');
                        var html = '<table border="0" cellpadding="0" cellspacing="0" style="font-size: 11px;color: #4a4a56;"><tr><td><span style="margin-left: 4px;">{!$Label.LessThanLabel}</span></td><td><span style="margin-left: 4px;">{!$Label.EqualToLabel}</span></td><td><span style="margin-left: 4px;">{!$Label.GreaterThanLabel}</span></td></tr>';
                        html += '<tr><td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="numeric-filter" id="' + key + '-lt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '<td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="numeric-filter" id="' + key + '-eq-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '<td style="padding-right: 2px;"><div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;"><input class="numeric-filter" id="' + key + '-gt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;"/></div></td>';
						html += '</tr></table>';

                        container.append(jQuery(html));

                        if (filter.DefaultValue != null && filter.DefaultValue != '')
                        {
                            if (filter.Operator == '<')
                                jQuery('#' + key + '-lt-filter').val(kimble.formatNumber(filter.DefaultValue, '#,##0.##'));
                            else if (filter.Operator == '=')
                                jQuery('#' + key + '-eq-filter').val(kimble.formatNumber(filter.DefaultValue, '#,##0.##'));
                            else if (filter.Operator == '>')
                                jQuery('#' + key + '-gt-filter').val(kimble.formatNumber(filter.DefaultValue, '#,##0.##'));

                        }

                    }
                }
            });
        }

        function initialiseFilters(config)
        {
            if (canSave) jQuery('#saveButton').show();

            jQuery('#assignment-search-name').text(configName);

            jQuery.ionTabs("#filter-tabs", {type: "none"});

            jQuery('#AssignmentFilters .filter-date').datepicker({
                dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
				showOtherMonths: true,
				selectOtherMonths: true
            });

            //dates
            if (config.DateRange == null) config.DateRange = 'None';

            if (config.DateRange == 'Fixed') jQuery('#date-fixed').prop('checked', true);
            if (config.DateRange == 'Rolling') jQuery('#date-rolling').prop('checked', true);
            if (config.DateRange == 'None') jQuery('#date-none').prop('checked', true);

            if (config.ViewPortStartDate != null) jQuery('#date-from').val(kimble.formatDate(config.ViewPortStartDate));
            if (config.ViewPortEndDate != null) jQuery('#date-to').val(kimble.formatDate(config.ViewPortEndDate));
            if (config.DaysBefore != null) jQuery('#rolling-days-before').val(kimble.formatNumber(config.DaysBefore,'#'));
            if (config.DaysAfter != null) jQuery('#rolling-days-after').val(kimble.formatNumber(config.DaysAfter,'#'));

            jQuery('input[type=radio][name=date-range]').change(function() {
                switchDateRange();
            });

            switchDateRange();

            sforce.connection.describeSObject(config.ParentConfig.ObjectType, {onSuccess : function(result){jQuery('.ParentQueryConfig').find('.parent-filter-header span').text(result.labelPlural);}, onFailure: function(error){console.log(error);}});
            sforce.connection.describeSObject(config.ChildConfig.ObjectType, {onSuccess:function(result){jQuery('.ChildQueryConfig').find('.child-filter-header').text(result.labelPlural);}, onFailure: function(error){console.log(error);}});

            buildOrderBy(jQuery('.ParentQueryConfig .sort-items'), config.ParentConfig.QueryConfig.OrderBy, config.ParentConfig.GroupBy != null ? config.ParentConfig.GroupBy.OrderBy : null);
            buildCriteria(jQuery('.ParentQueryConfig .Filters'), config.ParentConfig.QueryConfig);

            buildOrderBy(jQuery('.ChildQueryConfig .sort-items'), config.ChildConfig.QueryConfig.OrderBy);
            buildCriteria(jQuery('.ChildQueryConfig .Filters'), config.ChildConfig.QueryConfig);

            jQuery('.sort-items').sortable({
              items: 'li:not(.not-sortable)',
              placeholder: 'sort-placeholder'
            });

            jQuery('.date-filter').datepicker({
					   	dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true
					}).change(function(e){
					    //clear others
					    jQuery(this).closest('tr').find('input:not(#' + jQuery(this).prop('id') + ')').val('');
                    });

            jQuery('.numeric-filter').change(function(e){
					    //clear others
					    jQuery(this).closest('tr').find('input:not(#' + jQuery(this).prop('id') + ')').val('');
                    });

            filtersInitialised = true;
        }

        function switchDateRange()
        {
            if (jQuery('#date-fixed').prop('checked'))
            {
                jQuery('#fixed-dates').show();
                jQuery('#rolling-dates').hide();
            }
            else if (jQuery('#date-rolling').prop('checked'))
            {
                jQuery('#fixed-dates').hide();
                jQuery('#rolling-dates').show();
            }
            else
            {
                jQuery('#fixed-dates').hide();
                jQuery('#rolling-dates').hide();
            }
        }

        function setConfigCriteria(container, config)
        {
            jQuery.each(jQuery(Object.keys(config.Filters)), function(i, key){

                var filter = config.Filters[key];

                if (filter.Editable)
                {
                    filter.DefaultValue = null;

                    if (filter.DisplayType == 'REFERENCE')
                    {
                        var d = jQuery('#' + key).select2('data');

                        if (d.length > 0)
                        {

                            var v = '';

                            for (var i=0;i<d.length;i++)
                            {
                                v += '\'' + d[i].id + '\',';
                            }

                            filter.DefaultValue = v.slice(0, -1);
                        }
                    }
                    else if(filter.DisplayType == 'BOOLEAN')
                    {
                        filter.DefaultValue = jQuery('#' + key).prop('checked');
                    }
                    else if(filter.DisplayType == 'DATE')
                    {
                        //get the three values
                        var lt = jQuery('#' + key + '-lt-filter').val();
                        var eq = jQuery('#' + key + '-eq-filter').val();
                        var gt = jQuery('#' + key + '-gt-filter').val();

                        if (lt != null && lt != '')
                        {
                            filter.Operator = '<';
                            filter.DefaultValue = kimble.parseDate(lt, true).toKimbleUTCWithPadding();
                        }
                        else if (eq != null && eq != '')
                        {
                            filter.Operator = '=';
                            filter.DefaultValue = kimble.parseDate(eq, true).toKimbleUTCWithPadding();
                        }
                        else if (gt != null && gt != '')
                        {
                            filter.Operator = '>';
                            filter.DefaultValue = kimble.parseDate(gt, true).toKimbleUTCWithPadding();
                        }
                    }

                    else if(filter.DisplayType == 'NUMERIC')
                    {
                        //get the three values
                        var lt = jQuery('#' + key + '-lt-filter').val();
                        var eq = jQuery('#' + key + '-eq-filter').val();
                        var gt = jQuery('#' + key + '-gt-filter').val();

                        if (lt != null && lt != '')
                        {
                            filter.Operator = '<';
                            filter.DefaultValue = kimble.parseNumber(lt, '#,##0.##');
                        }
                        else if (eq != null && eq != '')
                        {
                            filter.Operator = '=';
                            filter.DefaultValue = kimble.parseNumber(eq, '#,##0.##');
                        }
                        else if (gt != null && gt != '')
                        {
                            filter.Operator = '>';
                            filter.DefaultValue = kimble.parseNumber(gt, '#,##0.##');
                        }
                    }
                }
            });
        }

        function clearFilter(container, config)
        {
             //set order by config

             jQuery.each(jQuery(Object.keys(config.Filters)), function(i, key){

                var filter = config.Filters[key];

                if (filter.Editable)
                {
                    if (filter.DisplayType == 'REFERENCE')
                    {
                        jQuery('#' + key).select2('data', []);
                    }
                    else if (filter.DisplayType == 'BOOLEAN')
                    {
                        jQuery('#' + key).prop('checked', false);
                    }
                    else if (filter.DisplayType == 'DATE' || filter.DisplayType == 'NUMERIC')
                    {
                        var lt = jQuery('#' + key + '-lt-filter').val('');
                        var eq = jQuery('#' + key + '-eq-filter').val('');
                        var gt = jQuery('#' + key + '-gt-filter').val('');
                    }
                }
            });
        }

    	function clearAssignmentFilter()
    	{
    	    //clear and apply filter
            clearFilter(jQuery('.ParentQueryConfig .Filters'), config.ParentConfig.QueryConfig);

            clearFilter(jQuery('.ChildQueryConfig .Filters'), config.ChildConfig.QueryConfig);

    	    //applyAssignmentFilter(function(){newSearch()});
    	}

        function applySortOrder($items, config)
        {
            config.OrderBy = [];

            jQuery.each($items, function (i, obj) {

                 var $o = jQuery(obj);
                 config.OrderBy.push({FieldName:$o.attr('data-field-name'), Order:($o.find('.fa-sort-alpha-asc').length == 1?'ASC':'DESC'), DisplayName:$o.text()});
            });
        }

    	function applyAssignmentFilter(oncomplete)
    	{
    		jQuery('#AssignmentFilterPopup').hide();

            config.ViewPortStartDate = null;
            config.ViewPortEndDate = null;
            config.DaysBefore = null;
            config.DaysAfter = null;

            if (jQuery('#date-fixed').prop('checked'))
            {
                config.DateRange = 'Fixed';
                config.ViewPortStartDate = kimble.parseDate(jQuery('#date-from').val());
                config.ViewPortEndDate = kimble.parseDate(jQuery('#date-to').val());
            }

            if (jQuery('#date-rolling').prop('checked'))
            {
                config.DateRange = 'Rolling';
                config.DaysBefore = kimble.parseNumber(jQuery('#rolling-days-before').val());
                config.DaysAfter = kimble.parseNumber(jQuery('#rolling-days-after').val());
            }

            if (jQuery('#date-none').prop('checked'))
            {
               config.DateRange = 'None';
            }

            if (config.ParentConfig.GroupBy != null) config.ParentConfig.GroupBy.OrderBy.Order = (jQuery('.group-by-order').find('.fa-sort-alpha-asc').length == 1?'ASC':'DESC');

            applySortOrder(jQuery('.ParentQueryConfig .sortable'), config.ParentConfig.QueryConfig);
            applySortOrder(jQuery('.ChildQueryConfig .sortable'), config.ChildConfig.QueryConfig);

            setConfigCriteria(jQuery('.ParentQueryConfig .Filters'), config.ParentConfig.QueryConfig);

            setConfigCriteria(jQuery('.ChildQueryConfig .Filters'), config.ChildConfig.QueryConfig);

            if (oncomplete != null) oncomplete();
    	}

        function saveConfigAs()
		{
			initialiseModalBoxy('#config-name-edit', '{!$ObjectType.KimbleOne__ActivityAssignmentSearch__c.Label}');

			jQuery('#config-name').val(configName);

			showModalBoxy();
		}

    	</script>

        <style>
