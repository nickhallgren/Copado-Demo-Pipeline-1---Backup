<apex:page standardcontroller="KimbleOne__SalesOpportunityReferral__c" extensions="KimbleOne.SalesOppReferralController" sidebar="true" >
 
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	

</apex:define>
    
<apex:define name="Content">
    
	<apex:pageMessages escape="false"/>
 
	<apex:form >  
      
		<apex:pageBlock title="{!$Label.kimbleone__referraldetailsheader}" mode="edit" >
			<apex:pageBlockSection columns="1" >
			
			<apex:inputField id="referralName" value="{!KimbleOne__SalesOpportunityReferral__c.Name}" required="true"/>
			<apex:inputField id="referralAccountName" value="{!KimbleOne__SalesOpportunityReferral__c.KimbleOne__Account__c}"/>			
			
			
            <apex:pageBlockSectionItem >
            <apex:outputLabel value="{!$ObjectType.KimbleOne__Proposition__c.Fields.Name.Label}" />            
	           <apex:inputText value="{!KimbleOne__SalesOpportunityReferral__c.KimbleOne__Proposition__c}" 
	           styleclass="kimblecustomlookup GetPropositions null true true" required="true"/>
   	        </apex:pageBlockSectionItem>  	        
			
								
			<apex:inputField id="referralNotes" value="{!KimbleOne__SalesOpportunityReferral__c.KimbleOne__Notes__c}" required="true"/>
            
			</apex:pageBlockSection>
            
		</apex:pageBlock>
		
		<apex:pageBlock >
			<apex:commandButton id="save" action="{!saveAndRedirect}" value="{!$Label.kimbleone__save}"/>
		</apex:pageBlock>

	</apex:form>
  
</apex:define>

</apex:composition>

</apex:page>