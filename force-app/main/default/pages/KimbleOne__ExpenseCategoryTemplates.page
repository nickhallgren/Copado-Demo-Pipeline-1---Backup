<apex:page standardController="KimbleOne__ResourcedActivityType__c" sidebar="false" extensions="KimbleOne.ExpenseCategoryTemplatesController" >
<!-- ProductDomainEditController  is extended here only to show warnings-->
<apex:composition template="KimbleOne__SiteMaster">

    <apex:define name="Menu"> 
            <c:Menu HelpSource="CfgGuide" DefaultHelpPage="ExpenseCategories.html" MenuContextType="{!IF(ISBLANK(TheResourcedActivityTemplate),'ResourcedActivityType','ProductDefinition')}" MenuContextId="{!IF(ISBLANK(TheResourcedActivityTemplate),KimbleOne__ResourcedActivityType__c.Id,TheResourcedActivityTemplate.KimbleOne__Product__c)}" MenuContextName="{!IF(ISBLANK(TheResourcedActivityTemplate),KimbleOne__ResourcedActivityType__c.Name,TheResourcedActivityTemplate.Name)}" /> 
    </apex:define>
    
    <apex:define name="Content">
    
    	<apex:form id="TheForm">
    		<apex:pageMessages escape="false"/>
			<apex:pageBlock title="{!$ObjectType.KimbleOne__ExpenseCategoryTemplate__c.LabelPlural}">
			
			<apex:pageblockbuttons location="top">
				<apex:commandButton id="saveButton" action="{!newTemplateRedirect}" value="{!$Label.kimbleone__new}" />
			</apex:pageblockbuttons>
			
			<apex:pageBlockTable value="{!expenseCategoryTemplates}" var="expenseCategoryTemplate">
				<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
					<apex:outputLink styleClass="actionLink" value="{!$Page.KimbleOne__ExpenseCategoryTemplateEdit}?id={!expenseCategoryTemplate.Id}{!IF(ISBLANK(TheResourcedActivityTemplate),'','&filterid=' + TheResourcedActivityTemplate.Id)}">{!$Label.kimbleone__edit}</apex:outputLink>
					&nbsp; | &nbsp;
					<apex:outputLink styleClass="actionLink" value="{!$Page.KimbleOne__ExpenseCategoryTemplateDelete}?id={!expenseCategoryTemplate.Id}{!IF(ISBLANK(TheResourcedActivityTemplate),'','&filterid=' + TheResourcedActivityTemplate.Id)}">{!$Label.kimbleone__delete}</apex:outputLink>
				</apex:column>
				<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseCategoryTemplate__c.Fields.Name.Label}">
					<apex:outputlink value="/{!expenseCategoryTemplate.Id}"><apex:outputText value="{!expenseCategoryTemplate.Name}" /></apex:outputlink>
				</apex:column>
				<!-- <apex:column value="{!expenseCategoryTemplate.Name}"/> -->
				<apex:column value="{!expenseCategoryTemplate.KimbleOne__ProductDomain__c}"/>
				<apex:column value="{!expenseCategoryTemplate.KimbleOne__ResourceType__c}"/>
				<apex:column value="{!expenseCategoryTemplate.KimbleOne__Location__c}"/>
				<apex:column value="{!expenseCategoryTemplate.KimbleOne__RebillingRule__c}"/>
				<apex:column value="{!expenseCategoryTemplate.KimbleOne__ReimbursementRule__c}"/>
			</apex:pageBlockTable>
			
			</apex:pageBlock>
    	</apex:form>
    
    </apex:define>
</apex:composition>
</apex:page>