<apex:page standardController="KimbleOne__Invoice__c" extensions="KimbleOne.InvoiceNewController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__Invoice__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
      
    </apex:define>
    
    <apex:define name="Content">
    	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__InvoiceManagement)}" />
    	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
    	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
    	
    	<apex:form id="TheForm">
    	<div id="pageErrors">
    		<apex:pageMessages escape="False" />
		</div>
		
		<apex:pageBlock title="{!IF (IsNegativeInvoiceMode, $Label.kimbleone__createnewcreditnoteheading, $Label.kimbleone__createnewinvoiceheading)}">
           	<apex:pageBlockButtons location="bottom">
           		<apex:commandButton action="{!Cancel}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__cancel}" rerender="TheForm" rendered="{!TheInvoiceCreationWizard.CanCancel}"/>
           		<apex:commandButton id="goPreviousBtn" action="{!TheInvoiceCreationWizard.GoPrevious}" styleclass="DisableButtonWhileBusy" onclick="processInvoiceContacts();" value="{!$Label.kimbleone__previous}" reRender="TheForm" rendered="{!TheInvoiceCreationWizard.CanGoPrevious && TheInvoiceCreationWizard.CurrentStep.StepName != 'SelectDeliveryElements'}" oncomplete="rerenderWizardPageComplete()"/>
            	<apex:commandButton id="goNextBtn" action="{!TheInvoiceCreationWizard.GoNext}" styleclass="DisableButtonWhileBusy theNextButton" onclick="processInvoiceContacts();" value="{!TheInvoiceCreationWizard.NextLabel}" reRender="TheForm" rendered="{!TheInvoiceCreationWizard.CanGoNext}" oncomplete="rerenderWizardPageComplete()" disabled="{!TheInvoiceCreationWizard.IsFinishDisabled}"/>
            </apex:pageBlockButtons>

            <script>
            jQuery(window).load(function(){
                rerenderWizardPageComplete();
            });

            function rerenderWizardPageComplete() {
                kimble.formatCurrencies();
               	SetupDatePicker();
            }

            function SetupDatePicker()
            {
				jQuery('.kimbleDatePicker:not(.filter)').datepicker({
				dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
				showOtherMonths: true,
				selectOtherMonths: true,
				changeMonth: true,
				changeYear: true});
            }
            </script>

			<!-- SELECT ACCOUNT -->
           	<apex:pageblockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__selectaccountheading}" columns="1" rendered="{!TheInvoiceCreationWizard.CurrentStep.StepName == 'SelectAccountStep'}">
				<apex:inputField value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__Account__c}"/>
				
			</apex:pageblockSection>
			
			<!--  Run the invoice schedule jobs (if any) -->
			<apex:outputPanel layout="none" rendered="{!TheInvoiceCreationWizard.CurrentStep.StepName == 'RunInvoiceScheduleJobs'}">
			
				<apex:actionFunction action="{!TheInvoiceCreationWizard.GoNext}" name="GoNext" reRender="TheForm" onComplete="rerenderWizardPageComplete();"></apex:actionFunction>
				<div id="InvoiceScheduleJobs">
				
				</div>
				<script>
					$(function () {
		                	loadJobsInline($('#InvoiceScheduleJobs'), '{!JSINHTMLENCODE(JobContextId)}','{!JSENCODE($Label.InitialisingInvoicingdataMessage)}', invoicingJobsComplete);
		            });
		            
		            function invoicingJobsComplete(ranJobs)
		            {
		            	if (ranJobs) // see if there are more to run
		            		refreshJobs();
		            	else
		            		GoNext();
		            }
		            
		        </script>
		        
		        <apex:actionFunction name="refreshJobs" rerender="TheForm"/>
		        
			</apex:outputPanel>	
			
           	<!-- SELECT DELIVERY ELEMENTS TO INCLUDE -->
			<apex:outputPanel layout="none" rendered="{!TheInvoiceCreationWizard.CurrentStep.StepName == 'SelectDeliveryElements'}">
			<apex:pageblockSection >
				<apex:outputField value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__Account__c}"/>
				<apex:pageBlockSectionItem >
							<!-- render the selector but hidden if there is only one choice to preserve the layout and pass through the default to the controller -->
							<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Locale__c.Label}" styleClass="{!IF(TheInvoiceLocales.size == 1,'hidden-item','')}"/>
							<apex:selectList id="invoiceLocaleSelect" value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__Locale__c}" size="1" styleClass="{!IF(TheInvoiceLocales.size == 1,'hidden-item','')}">
								<apex:selectOptions value="{!TheInvoiceLocales}"/>
							</apex:selectList> 
				</apex:pageBlockSectionItem>
				
				<apex:pageBlockSectionItem >
					<apex:outputText value="{!IF (IsNegativeInvoiceMode, $ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__CreditNoteDate__c.Label, $ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__InvoiceDate__c.Label)}" />
					<apex:inputField styleClass="kimbleDatePicker" value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__InvoiceDate__c}">
						<apex:actionSupport event="onchange" action="{!TheInvoiceCreationWizard.InvoiceDateChange}" rerender="InvoiceDeliveryElements"/>
					</apex:inputField>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__InvoiceFormat__c.Label}" />
						<apex:selectList id="invoiceFormatSelect" value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__InvoiceFormat__c}" size="1">
							<apex:selectOptions value="{!TheInvoiceFormats}"/>
						</apex:selectList> 
				</apex:pageBlockSectionItem> 

			</apex:pageblockSection>
			
			<apex:pageblockSection id="InvoiceDeliveryElements" collapsible="false" showheader="true" title="{!IF (IsNegativeInvoiceMode, $Label.kimbleone__genericlabel07, $Label.kimbleone__selectelementstoincludeoninvoiceheading)}" columns="1" >
           		<apex:outputPanel rendered="{!TheInvoiceCreationWizard.TheGroupsAndElementsForSelection.size == 0}">
           			<apex:outputText value="{!IF (IsNegativeInvoiceMode, $Label.kimbleone__genericlabel08, $Label.kimbleone__nothingtoinvoicemessage)}"/>
           		</apex:outputPanel>
           		<!--  if TheInvoiceCreationWizard.TheGroupsAndElementsForSelection.length == 1 then render list else render tree -->
           		<apex:repeat value="{!TheInvoiceCreationWizard.TheGroupsAndElementsForSelection}" var="grp">
           			<apex:pageBlockTable value="{!grp.DeliveryElements__r}" var="element">
						<apex:facet name="header"><apex:outputlink value="/{!grp.Id}"><apex:outputText value="{!grp.Name}"/></apex:outputlink></apex:facet>
						<apex:column width="2%" style="text-align:center;" headerValue="{!$Label.kimbleone__filter}">
							<span onclick="showFilter('{!element.Id}')" class="fa fa-filter filter-items {!IF(TheInvoiceCreationWizard.DeliveryElementItemsFilter[element.Id].HasFilter, 'filter-items-on','filter-items-off')}"></span>
						</apex:column>
						<apex:column width="5%" style="text-align:center;" headerValue="">
							<apex:facet name="header"><div style="text-align:center"><input type="checkbox" onclick="checkAll(this)"/></div></apex:facet>
							<apex:inputField styleClass="include-element" value="{!TheInvoiceCreationWizard.TheDeliveryElementsForSelection[element.Id].InputCheckbox__c}"/>
						</apex:column>
						<apex:column width="40%" value="{!element.Name}" />
						<apex:column width="25%" headervalue="{!IF (IsNegativeInvoiceMode, $Label.kimbleone__genericlabel05, $Label.kimbleone__invoiceableamountlabel)}">
							<apex:outputPanel layout="block" rendered="{!!IsInterCompanyInvoice && !IsNegativeInvoiceMode}">
								<apex:outputPanel layout="block">
									<apex:outputText value="{!$Label.kimbleone__serviceslabel} "/>
									<apex:outputText value="{!element.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!element.KimbleOne__InvoicingCcyServicesInvoiceableAmount__c}" />
								</apex:outputPanel>
								<apex:outputPanel layout="block" rendered="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsExpenseGenerated__c}">
									<apex:outputText value="{!$Label.kimbleone__expenseslabel} "/>
									<apex:outputText value="{!element.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!element.KimbleOne__InvoicingCcyExpensesInvoiceableAmount__c}" />
								</apex:outputPanel>
							</apex:outputPanel>
							<apex:outputPanel layout="block" rendered="{!IsInterCompanyInvoice && !IsNegativeInvoiceMode}">
								<apex:outputPanel layout="block">
									<apex:outputText value="{!$Label.kimbleone__serviceslabel} "/>
									<apex:outputText value="{!TheInvoiceCreationWizard.TheDeliveryElementIntercompanySummariesMap[element.Id].InternalInvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!TheInvoiceCreationWizard.TheDeliveryElementIntercompanySummariesMap[element.Id].IntInvCcyServicesInvoiceableAmount__c}" />
								</apex:outputPanel>
								<apex:outputPanel layout="block" rendered="{!element.InternalRevenueBehaviourRule__r.RevenueGenerationModel__r.KimbleOne__IsExpenseGenerated__c}">
									<apex:outputText value="{!$Label.kimbleone__expenseslabel} "/>
									<apex:outputText value="{!TheInvoiceCreationWizard.TheDeliveryElementIntercompanySummariesMap[element.Id].InternalInvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!TheInvoiceCreationWizard.TheDeliveryElementIntercompanySummariesMap[element.Id].IntInvCcyExpensesInvoiceableAmount__c}" />
								</apex:outputPanel>
							</apex:outputPanel>
							<apex:outputPanel layout="block" rendered="{!!IsInterCompanyInvoice && IsNegativeInvoiceMode}">
								<apex:outputPanel layout="none" rendered="{!TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ServicesAmount != 0 || TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ExpensesAmount != 0}">
									<apex:outputPanel layout="block">
										<apex:outputText value="{!$Label.kimbleone__serviceslabel} "/>
										<apex:outputText value="{!element.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
										<apex:outputText value="{!TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ServicesAmount}" />
									</apex:outputPanel>
									<apex:outputPanel layout="block" rendered="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsExpenseGenerated__c}">
										<apex:outputText value="{!$Label.kimbleone__expenseslabel} "/>
										<apex:outputText value="{!element.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
										<apex:outputText value="{!TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ExpensesAmount}" />
									</apex:outputPanel>
								</apex:outputPanel>
								<apex:outputPanel layout="none" rendered="{!TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ServicesAmount == 0 && TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].ExpensesAmount == 0}">
									<apex:outputPanel layout="block" rendered="{!element.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsExpenseGenerated__c}">
										<apex:outputText value="{!$Label.kimbleone__all} "/>
										<apex:outputText value="{!element.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
										<apex:outputText value="{!TheInvoiceCreationWizard.TheDeliveryElementNegativeInvoiceAmountsMap[element.Id].TotalAmount}" />
									</apex:outputPanel>
								</apex:outputPanel>
							</apex:outputPanel>
						</apex:column>
						<apex:column headervalue="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BillingAccount__c.Label}" rendered="{!!IsInterCompanyInvoice}">
							<apex:outputField value="{!element.KimbleOne__BillingAccount__c}"/>
						</apex:column>
						<apex:column headervalue="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__TaxCode__c.Label}" rendered="{!!IsInterCompanyInvoice}">
							<apex:outputField value="{!element.KimbleOne__TaxCode__c}"/>
						</apex:column>
						<apex:column headerValue="{!$Label.kimbleone__purchaseorderslabel}" rendered="{!!IsInterCompanyInvoice}">
                            <div style="white-space: nowrap;">
                                <apex:outputText value="{!element.PurchaseOrderRule__r.Name}"/>
                            </div>
                            <apex:outputPanel layout="none" rendered="{!!TheInvoiceCreationWizard.PurchaseOrderSelectionEnabled && !IsNegativeInvoiceMode}">
                                <!-- The ALL cases -->
                                <apex:outputPanel layout="block" rendered="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].AllRemaining.InputCurrency__c > 0}">
                                    {!$Label.PurchaseOrderCoverRemainingLabel}&nbsp;<apex:outputField value="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].AllRemaining.InputCurrency__c}"/>
                                </apex:outputPanel>

                                <!--  not the ALL cases -->
                                <apex:outputPanel layout="block" rendered="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].ServicesRemaining.InputCurrency__c > 0}">
                                    {!$Label.ServicesPurchaseOrderCoverRemainingLabel}&nbsp;<apex:outputField value="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].ServicesRemaining.InputCurrency__c}"/>
                                </apex:outputPanel>

                                <apex:outputPanel layout="block" rendered="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].ExpensesRemaining.InputCurrency__c > 0}">
                                    {!$Label.ExpensesPurchaseOrderCoverRemainingLabel}&nbsp;<apex:outputField value="{!TheInvoiceCreationWizard.DeliveryElementPurchaseOrderRemaining[element.id].ExpensesRemaining.InputCurrency__c}"/>
                                </apex:outputPanel>
                            </apex:outputPanel>
                            <apex:outputPanel layout="none" rendered="{!(TheInvoiceCreationWizard.PurchaseOrderSelectionEnabled && !IsNegativeInvoiceMode) || IsNegativeInvoiceMode}">
                                <div id="purchase-order-selection" style="max-height:100px;overflow-y:auto;white-space: nowrap;">
                                    <apex:repeat var="alloc" value="{!TheInvoiceCreationWizard.ThePurchaseOrderAllocations[element.id]}">
                                        <div>
                                            <span style="vertical-align: middle;"><apex:inputField value="{!TheInvoiceCreationWizard.ThePurchaseOrdersForSelection[alloc.Id].InputCheckbox__c}"/></span>
                                            <span><apex:outputText value="{!alloc.PurchaseOrder__r.Name}"/></span>
                                            (<span class="kimble-format-currency" data-currency="{!JSENCODE(alloc.CurrencyISOCode)}"><apex:outputText value="{!alloc.RemainingValue__c}"/></span>&nbsp;<span><apex:outputText value="{!$Label.kimbleone__deliverygrouphomeremaining}"/></span>)
                                        </div>
                                    </apex:repeat>
                                </div>
							</apex:outputPanel>
						</apex:column>
					</apex:pageBlockTable>
				
           		</apex:repeat>
           		<script>
				function checkAll(obj)
				{
					jQuery('.include-element').prop('checked', jQuery(obj).prop('checked'));
    			}
				</script>
           	</apex:pageblockSection>
           	<div id="filter-panel-popup" style="display:none">
           		<apex:outputPanel id="TheFilter">
           			<apex:outputPanel rendered="{!!ISBLANK(TheInvoiceCreationWizard.CurrentFilterId)}">
           				<apex:pageblock >
           					<apex:pageBlockButtons location="top">
           						<apex:commandButton id="applyFilterButton" action="{!TheInvoiceCreationWizard.ApplyElementItemsFilter}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__applyfilter}" rerender="TheForm" oncomplete="hideModalBoxy()"/>
								<apex:commandButton action="{!TheInvoiceCreationWizard.ClearElementItemsFilter}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__clearalllabel}" rerender="TheForm" oncomplete="hideModalBoxy()"/>           						
           					</apex:pageBlockButtons>
           				<apex:pageblockSection collapsible="false" showheader="false" columns="1">
           				<apex:pageBlockSectionItem >
           					<apex:outputText value="" />
	           				<apex:selectRadio value="{!TheInvoiceCreationWizard.DeliveryElementItemsFilter[TheInvoiceCreationWizard.CurrentFilterId].ItemType}" layout="horizontal" border="0" styleclass="deliveryStatus" >
								<apex:selectOptions value="{!TheInvoiceCreationWizard.FilterItemType}" />
		 					</apex:selectRadio>
           				</apex:pageBlockSectionItem>
           				<apex:pageBlockSectionItem >
           					<apex:outputText value="{!IF (IsNegativeInvoiceMode, $Label.kimbleone__genericlabel06, $Label.kimbleone__invoiceuptodate)}" />
							<apex:inputField styleclass="kimbleDatePicker filter" id="invoiceUpToDate" value="{!TheInvoiceCreationWizard.DeliveryElementItemsFilter[TheInvoiceCreationWizard.CurrentFilterId].InvoiceUpToDate.InputDate__c}"/>
						</apex:pageBlockSectionItem>
						<apex:pageBlockSectionItem rendered="{!TheInvoiceCreationWizard.ElementResourcesForFilter.size > 1}">
           					<apex:outputText value="{!$ObjectType.KimbleOne__Resource__c.LabelPlural}" />
							<apex:selectList style="width:300px" id="filterResources" value="{!TheInvoiceCreationWizard.DeliveryElementItemsFilter[TheInvoiceCreationWizard.CurrentFilterId].ResourceIds}" multiselect="true">
           		 				<apex:selectOptions value="{!TheInvoiceCreationWizard.ElementResourcesForFilter}"/>
							</apex:selectList>
						</apex:pageBlockSectionItem>
						</apex:pageblockSection>
						</apex:pageblock>
					</apex:outputPanel>
           		</apex:outputPanel>
           	</div>
           	<script type="text/javascript">
				function showFilter(elementId)
				{
					initialiseModalBoxy('#filter-panel-popup', '{!JSENCODE($Label.Filter)}', jQuery('form[id$=\'TheForm\']'));
					selectElementsFilter(elementId);
				}
				
				function filterLoadComplete()
				{
					jQuery('.kimbleDatePicker.filter').datepicker({
					   		dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
								showOtherMonths: true,
								selectOtherMonths: true
					});

					jQuery('[id$="filterResources"]').select2();
					showModalBoxyWithFocus(jQuery('[id$="applyFilterButton"]'));
				}
				
				var l = {};
				l['contactname'] = '<apex:outputText value="{!$ObjectType.KimbleOne__BillingContact__c.Fields.Name.Label}"/>';
				l['primaryind'] = '<apex:outputText value="{!$Label.kimbleone__primarybillingcontact}"/>';
				l['delete'] = '<apex:outputText value="{!$Label.kimbleone__deletebutton}"/>';
				
				function drawInvoiceContacts()
				{
					var html = '';
					
					html += '<table class="invoice-contacts-table list" border="0" cellpadding="0" cellspacing="0">';
					html += '<tr class="header-row headerRow">';
					html += '<th class="actions-col"></th>';
					html += '<th class="invoice-contact-name-title">' + l['contactname'] + '</th>';
					html += '<th class="primary-cell">' + l['primaryind'] + '</th>';
					html += '</tr>';
					
					// existing rows
					for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
					{
						var invoiceContact = invoiceContacts[invoiceContactCounter];
						
						html += '<tr class="invoice-contact-row" contactId="' + invoiceContact.ContactId + '">';
						
						html += '<td class="remove-invoice-contact action-btn" title="' + l['delete'] + '"><i class="fa fa-trash"></i></td>';
						html += '<td class="invoice-contact-name">' + invoiceContact.ContactName + '</td>';
						html += '<td class="primary-cell">';
						html += '<input type="radio" name="primary-invoice-contacts" ' + (invoiceContact.IsPrimary ? ' checked="checked"' : '') + '/>';
						html += '</td>';
			
						html += '</tr>';			
					}
					
					// new row
					html += '<tr class="invoice-contact-row new-invoice-contact">';
					
					html += '<td class="add-invoice-contact action-btn"></td>';
					html += '<td class="invoice-contact-name">';
					html += '<input type="text" class="find-invoice-contact"/>';
					html += '</td>';
					html += '<td class="primary-cell">';
					html += '</td>';
		
					html += '</tr>';
					
					jQuery('#invoice-contacts').html(html);
		
					initialiseInvoiceContactFind();
				}
				
				function initialiseInvoiceContactFind()
				{
					jQuery('.find-invoice-contact').select2({
						//minimumInputLength: 2,
						multiple: false,
						placeholder: '<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>',
						query: function (params) {
							var find = function() {findInvoiceContacts(params);};        		
							find();
						},
						initSelection : function (element, callback) {
						var data = {id: element.val(), text: element.attr('data-name')};
						callback(data);
						}
					});
					
					jQuery('.find-invoice-contact').on("select2-selecting", function(e) {
						var asPrimary = jQuery('input[name="primary-invoice-contacts"]').length == 0;
						var newContact = {ContactId: e.object.id, ContactName: e.object.text, IsPrimary: asPrimary};
						invoiceContacts.push(newContact);
						invoiceContacts.sort(sortByInvoiceContactName);
						InvoiceContactChanges = true;
						drawInvoiceContacts();
					});
					
					jQuery(document).off('click', '.remove-invoice-contact').on('click', '.remove-invoice-contact', removeInvoiceContact);
					jQuery(document).off('click', 'input[name="primary-invoice-contacts"]').on('click', 'input[name="primary-invoice-contacts"]', setPrimaryContact);
				}
				
				function sortByInvoiceContactName(a,b)
			   	{
			   		return (a.ContactName < b.ContactName) ? -1 : (a.ContactName > b.ContactName) ? 1 : 0; 
			   	}

				function setPrimaryContact()
				{
					var contactId = jQuery(this).closest('.invoice-contact-row').attr('contactId');
					
					for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
					{
						var invoiceContact = invoiceContacts[invoiceContactCounter];
						invoiceContact.IsPrimary = (invoiceContact.ContactId == contactId);
					}
				}
				
				function removeInvoiceContact()
				{
					var contactId = jQuery(this).closest('.invoice-contact-row').attr('contactId');
					
					jQuery(this).closest('.invoice-contact-row').remove();
					
					for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
					{
						var invoiceContact = invoiceContacts[invoiceContactCounter];
						
						if(invoiceContact.ContactId == contactId)
						{
							invoiceContacts.splice(invoiceContactCounter, 1);
							break;
						}
					}
					
					drawInvoiceContacts();
				}			   	
				
				$(function () {
					getReferenceData();
					kimble.formatCurrencies();
				});
			</script>
			<apex:actionFunction action="{!TheInvoiceCreationWizard.SelectElementItemsFilter}" name="selectElementsFilter" rerender="TheFilter" oncomplete="filterLoadComplete();">
				<apex:param name="filterId" value="" />
   			</apex:actionFunction>
			</apex:outputPanel>
			<!-- SELECT DELIVERY ELEMENT ITEMS TO INCLUDE -->
			<apex:outputPanel rendered="{!TheInvoiceCreationWizard.CurrentStep.StepName == 'SelectDeliveryElementItemsToInclude'}">
			<apex:outputPanel id="NetAmountPanel">
				<apex:pageblockSection collapsible="false" showheader="false" columns="3" rendered="{!TheInvoiceCreationWizard.CurrentStep.StepName != 'SelectAccountStep'}">
	           		
	           		<apex:pageBlockSectionItem dataStyle="width:15%">
	           			<apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BillingAccount__c.Label}" />
	           			<apex:outputField value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__Account__c}"/>
	           		</apex:pageBlockSectionItem>
	           		<apex:pageBlockSectionItem dataStyle="width:15%">
	           			<apex:outputText value="{!IF(IsNegativeInvoiceMode, $ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__CreditNoteDate__c.Label, $ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__InvoiceDate__c.Label)}" />
	           			<apex:outputField value="{!TheInvoiceCreationWizard.TheInvoice.KimbleOne__InvoiceDate__c}"/>
	           		</apex:pageBlockSectionItem>
	           		<apex:pageBlockSectionItem dataStyle="width:15%">
	           			<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__NetAmount__c.Label}" />
	           			<span id="DeliveryElementSelectedItemsTotal"></span>	           			
	           		</apex:pageBlockSectionItem>
	           		
	           	</apex:pageblockSection>
           	</apex:outputPanel>

