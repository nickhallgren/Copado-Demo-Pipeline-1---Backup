		    width: 18px;
		}
		th.primary-cell {
		    width: 100px;
		}
		td.primary-cell {
		    text-align: center;
		}
		.select2-container.find-invoice-contact {
		    width: 100% !important;
		    padding-right: 2px;
		}
		</style>

		<script>
			function findInvoiceContacts(params)
			{				
				var existingInvoiceContactIds = [];
				jQuery('.invoice-contact-row:not(.deleted)').each(function() {existingInvoiceContactIds.push(jQuery(this).attr('contactId'));});
			
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InvoiceNewController.GetApplicableBillingContacts}',
			      		accountId, existingInvoiceContactIds, params.term,
			     			function(result, event){          
			            		if (event.status) 
				            {
				             	var data = {};
				             	data.results = result;
				             	params.callback(data);
				         	} 
				         	else if (event.type === 'exception') 
				         	{
				             	alert(event.message);
				         	} 
				         	else 
				         	{
				             	alert(event.message);
				         	}
			        	}, 
			        	{escape: false, timeout: 60000}
			    	);
			}
			
			function processInvoiceContacts()
			{
				if(jQuery('.invoice-contacts-container').length == 0) return;
				
				var theContacts = [];
				
				jQuery('.invoice-contact-row:not(.new-invoice-contact)').each(function() {
					var theContact = {ContactId: jQuery(this).attr('contactId'), ContactName: jQuery(this).find('.invoice-contact-name').text(), IsPrimary: jQuery(this).find('input[name="primary-invoice-contacts"]:checked').length == 1};
					theContacts.push(theContact);
				});
				
				jQuery('.TheInvoiceContacts').val(JSON.stringify(theContacts));
			}
		</script>
    </apex:define>
</apex:composition>

