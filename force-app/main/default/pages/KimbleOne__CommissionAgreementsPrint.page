<apex:page controller="KimbleOne.CommissionAgreementsPrintController" sidebar="false"  showHeader="false" contentType="application/vnd.ms-excel#Scheme_{!$CurrentPage.parameters.id}'.xls" >

		<apex:variable var="PreviousScheme" value=""/>
			<apex:variable var="PreviousName" value=""/>
			<apex:variable var="PreviousSalesOpp" value=""/>
			<apex:variable var="PreviousAccount" value=""/>
			<apex:variable var="PreviousTarget" value=""/>
			
			<table class="list" border="1" cellpadding="0" cellspacing="0" style="border-width: 0px;border-spacing: 0px;border-style: thin;border-color:#F8F8F8 ">
				<tr>
					<th  style="vertical-align:text-top;">
						{!$ObjectType.CommissionScheme__c.Label}
					</th>
					<th style="vertical-align:text-top;">
						{!$ObjectType.CommissionAgreement__c.Fields.User__c.Label}
					</th>
					<th style="vertical-align:text-top;">
						{!$ObjectType.ResourceType__c.Label}
					</th>
					<th style="vertical-align:text-top;">
						{!$ObjectType.BusinessUnit__c.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.AlternativeCommissionSchemeBasis}
					</th>
					<th style="vertical-align:text-top;">
						{!$ObjectType.CommissionAgreement__c.Fields.StartDate__c.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$ObjectType.CommissionAgreement__c.Fields.EndDate__c.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$ObjectType.Account.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.CommissionItemNarrativeHeader}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.MonthNumber}
					</th>
					<th  style="vertical-align:text-top;">
						{!$ObjectType.Invoice__c.Fields.InvoiceDate__c.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$ObjectType.Invoice__c.Fields.Reference__c.Label}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.CommissionItemMeasuredValueHeader}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.CommissionItemTotalMeasuredValueHeader}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.CommissionItemCommissionValueHeader}
					</th>
					<th  style="vertical-align:text-top;">
						{!$Label.CommissionItemTotalCommissionValueHeader}
					</th>
				
				</tr>
				<apex:repeat value="{!CommissionsToPrint}" var="comAg" >
					<tr>
						<td>
							<apex:outputText value="{!IF(PreviousScheme!=comAg.CommissionAgreement.KimbleOne__CommissionScheme__c,comAg.CommissionAgreement.CommissionScheme__r.Name,'')}"/>
		                	<apex:variable var="PreviousScheme" value="{!comAg.CommissionAgreement.KimbleOne__CommissionScheme__c}"/>
						</td>
						<td>
							<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c, comAg.CommissionAgreement.User__r.Name, '')}"/>
		               </td>
						<td>
							<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c, comAg.ResourceType, '')}"/>
		               </td>
						<td>
							<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c, comAg.ResourceBusinessUnit, '')}"/>
		               </td>
				 		<td>
				 			<apex:outputtext rendered="{!PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousSalesOpp!=comAg.CommissionAgreement.KimbleOne__SalesOpportunity__c}">
				 			{!JSENCODE(comAg.CommissionAgreement.SalesOpportunity__r.Name)}</apex:outputtext>
				 			<apex:variable var="PreviousSalesOpp" value="{!comAg.CommissionAgreement.KimbleOne__SalesOpportunity__c}"/>
				 			<apex:variable var="PreviousTarget" value="{!comAg.CommissionAgreement.KimbleOne__PerformanceAnalysis__c}"/>
				 			<apex:variable var="PreviousAccount" value="{!comAg.CommissionAgreement.KimbleOne__Account__c}"/>
							<apex:outputText value="{!IF(PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousTarget!=comAg.CommissionAgreement.KimbleOne__PerformanceAnalysis__c,comAg.CommissionAgreement.PerformanceAnalysis__r.Name,'')}"/>		
				 			<apex:outputText value="{!IF(PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousAccount!=comAg.CommissionAgreement.KimbleOne__Account__c,comAg.CommissionAgreement.Account__r.Name,'')}"/>		
				 		 	<apex:variable var="PreviousName" value="{!comAg.CommissionAgreement.KimbleOne__User__c}"/>
				 		
				 		</td>
				 		<td>
				 			<apex:outputText value="{0,date,dd/MM/yyyy}">
				 				<apex:param value="{!comAg.CommissionAgreement.KimbleOne__StartDate__c}" />
	 						</apex:outputText>
				 		</td>
				 		<td>
				 			<apex:outputText value="{0,date,dd/MM/yyyy}">
				 				<apex:param value="{!comAg.CommissionAgreement.KimbleOne__StartDate__c}" />
	 						</apex:outputText>
	 					</td>
				 		<apex:variable var="counter" value="{!0}"/>
				 		<apex:repeat value="{!comAg.CommissionInvoiceItems}" var="comInv">
				 		<apex:variable var="stl" value="{!if(comAg.CommissionInvoiceItems.size==(counter+1),'border-bottom-color:#000000','')}  "/>
				 		
				 			<apex:outputPanel rendered="{!counter>0}" layout="none" >
				 				<tr>
				 				
				 				<td></td>
				 				<td></td>
				 				<td></td>
				 				<td></td>
				 				<td></td>
				 				<td></td>
				 				<td></td>
				 				<td>
									<apex:outputText value="{!comInv.InvoiceAccount}"/>
					 			</td>
				 				<td>
				 					<apex:outputText value="{!comInv.Narrative}"/>
      			 				</td>

				 				<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,date,dd/MM/yyyy}">
       							<apex:param value="{!comInv.InvoiceDate}" />
 									</apex:outputText>
					 			</td>
					 			
					 			<td>
				 					<apex:outputText value="{!comInv.MonthNumber}"/>
      			 				</td>
					 			
					 			<td>
				 					<apex:outputText value="{!comInv.InvoiceReference}"/>
      			 				</td>

					 			<td style="{!JSENCODE(stl)}">
					 				<apex:outputText value="{0,number,#,##0.00}">
	       							<apex:param value="{!comInv.InvoiceValue}" />
	 							</apex:outputText>
					 	
					 			</td>
					 			<td style="{!JSENCODE(stl)}">
					 				<apex:outputText value="{0,number,#,##0.00}">
	       								<apex:param value="{!comInv.TotalInvoiceValue}" />
	 								</apex:outputText>
					 			</td>
					 			<td style="{!JSENCODE(stl)}">
					 				<apex:outputText value="{0,number,#,##0.00}">
	       								<apex:param value="{!comInv.CommissionValue}" />
	 								</apex:outputText>
					 			</td>
					 			<td  style="{!JSENCODE(stl)}">
					 				<apex:outputText value="{0,number,#,##0.00}">
	       								<apex:param value="{!comInv.CommissionTotal}" />
	 								</apex:outputText>
					 			</td>

				 			</tr>
				 			</apex:outputPanel>
				 			<apex:outputPanel rendered="{!counter=0}" layout="none" >
			 				<td>
								<apex:outputText value="{!comInv.InvoiceAccount}"/>
				 			</td>
				 			<td>
				 					<apex:outputText value="{!comInv.Narrative}"/>
      			 				</td>
				 			<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,date,dd/MM/yyyy}">
       							<apex:param value="{!comInv.InvoiceDate}" />
 									</apex:outputText>
				 			</td>
				 			<td>
			 					<apex:outputText value="{!comInv.MonthNumber}"/>
   			 				</td>
				 			
				 			<td>
			 					<apex:outputText value="{!comInv.InvoiceReference}"/>
   			 				</td>

				 			<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,number,#,##0.00}">
       							<apex:param value="{!comInv.InvoiceValue}" />
 							</apex:outputText>
				 			</td>
				 			<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,number,#,##0.00}">
       								<apex:param value="{!comInv.TotalInvoiceValue}" />
 								</apex:outputText>
				 			</td>
				 			<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,number,#,##0.00}">
       								<apex:param value="{!comInv.CommissionValue}" />
 								</apex:outputText>
				 			</td>
				 			<td style="{!JSENCODE(stl)}">
				 				<apex:outputText value="{0,number,#,##0.00}">
       								<apex:param value="{!comInv.CommissionTotal}" />
 								</apex:outputText>
				 			</td>

				 			</apex:outputPanel>
				 			<apex:variable var="counter" value="{!counter+1}"/>
				 		</apex:repeat>
					</tr>
				</apex:repeat>
			</table>
		
</apex:page>