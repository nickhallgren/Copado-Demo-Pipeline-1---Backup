<apex:page standardController="KimbleOne__SupplierRequisition__c" extensions="KimbleOne.SupplierPurchaseOrderPreviewController" showHeader="true" sidebar="false" tabStyle="KimbleOne__SupplierRequisition__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
      	<c:Menu MenuContextType="SupplierRequisition" MenuContextId="{!KimbleOne__SupplierRequisition__c.Id}" MenuContextName="{!KimbleOne__SupplierRequisition__c.Name}"/>
    </apex:define>
    
    <apex:define name="Content">
    	<style>
    		#content-pane {
    			position: relative;
    		}
    	</style>
    	<iframe frameborder="false" src="{!JSENCODE(PrintPageUrl)}" width="100%"></iframe>
    	<script>
    		$(document).ready(function(){

			 	var salesforceHeaderFooterHeight = isSFClassic() ? 240 : 70;

			 	$('iframe').height($(window).height() - salesforceHeaderFooterHeight);
				
				$(window).resize(function() {
				   $('iframe').height($(window).height() - salesforceHeaderFooterHeight);
				});
			});
    	</script>
    </apex:define>
   </apex:composition>
</apex:page>