<apex:page controller="Dropbox_for_SF.OptionsController" tabstyle="Dropbox__tab" showHeader="true">
    <script>
        var RemoteActions = {};
        RemoteActions.checkFixDfbAccount = '{!$RemoteAction.OptionsController.checkFixDfbAccount}';

        window.onload = function() {
            Visualforce.remoting.Manager.invokeAction(RemoteActions.checkFixDfbAccount, function(result, event){
                if (event.status) {
                    if (result === true){
                        console.log('Fixed DfBAccount setting. Reloading page...');
                        window.location.reload();
                    }
                } else {
                    console.log('RemoteActions.checkFixDfbAccount error: ' + event.message);
                }
            });
        };
    </script>
    
    <style type="text/css">
        .button {
          background: #007ee5;
          background-image: -webkit-linear-gradient(top, #168add, #007ee5);
          background-image: -moz-linear-gradient(top, #168add, #007ee5);
          background-image: -ms-linear-gradient(top, #168add, #007ee5);
          background-image: -o-linear-gradient(top, #168add, #007ee5);
          background-image: linear-gradient(to bottom, #168add, #007ee5);
          -webkit-border-radius: 5;
          -moz-border-radius: 5;
          border-radius: 5px;
          font-family: Arial;
          color: #ffffff !important;
          font-size: 13px;
          padding: 8px 16px 8px 16px;
          text-decoration: none;
        }

        .button:hover {
          background: #008cff;
          text-decoration: none;
        }
        .myLinks{
            color: #015ba7 !important;
            margin-left: 0px !important;
            margin-right: 0px !important;
        }
    </style>

    <apex:includeScript value="{!URLFOR($Resource.Dropbox_for_SF__webassets, 'js/filesize.min.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.Dropbox_for_SF__style, 'css/fi-core.css')}" />

    <apex:sectionHeader title="{!$Label.Dropbox_for_SF__Options_Section_Header}" subtitle="{!$Label.Dropbox_for_SF__Option_Section_Subtitle}" help="https://www.dropbox.com/support"/>
    <apex:form >
        <apex:outputPanel id="errors">
            <apex:pageMessages escape="false" />
        </apex:outputPanel>

        <apex:actionFunction action="{!dummyCall}" name="completeConnection" reRender="errors, connectionSettings, dfbSettings"/>

        <apex:pageBlock title="{!$Label.Dropbox_for_SF__Options_Connection_Settings}" id="connectionSettings">
            <apex:pageBlockButtons location="bottom">
                <apex:commandButton action="{!DBUserDisconnect}" oncomplete="window.location.reload();" rendered="{!NOT(isSFAdmin && isOrgTeamLinked) && isConnected && hasUserAuth}" value="{!$Label.Dropbox_for_SF__Options_Disconnect_User}"/>
                <apex:commandButton action="{!DBTeamDisconnect}" oncomplete="window.location.reload();" rendered="{!isSFAdmin && isOrgTeamLinked}" value="{!$Label.Dropbox_for_SF__Options_Disconnect_Team_Link}"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection >

                <apex:pageBlockSectionItem rendered="{!NOT(isConnected)}">
                    <apex:outputPanel styleClass="requiredInput" layout="block">
                        <apex:outputPanel style="padding:5px;" layout="block" />
                        <a href="#" onclick="window.open('{!$Page.Connect}', '_blank', 'scrollbars=0,tollbar=0,titlebar=0');" class="button">{!$Label.Options_Connect_to_Dropbox}</a>
                        <br/><br/>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!NOT(isConnected)}">
                    <apex:outputlabel style="color:grey">{!$Label.Dropbox_for_SF__Options_Connect_Help}</apex:outputlabel>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="{!isConnected}">
                    <apex:outputLabel value="{!$Label.Dropbox_for_SF__Options_Connected_As}" for="connectedUser"/>
                    <apex:outputText value="{!DBUserName} ({!DBUserEmail})" id="connectedUser"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!isConnected}">
                    <apex:outputlabel style="color:grey">{!$Label.Dropbox_for_SF__Options_Connected_As_Help}</apex:outputlabel>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="{!isConnected && DBTeamName != NULL}">
                    <apex:outputLabel value="{!$Label.Dropbox_for_SF__Options_Team_Name}" for="teamName"/>
                    <apex:outputText value="{!DBTeamName}" id="teamName"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!isConnected && DBTeamName != NULL}">
                    <apex:outputlabel style="color:grey">
                        {!$Label.Dropbox_for_SF__Options_Team_Name_Help}
                    </apex:outputlabel>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="{!isConnected && isUserTeamMember && NOT(isOrgTeamLinked)}">
                    <apex:outputLabel rendered="{!isSFAdmin}" value="" for="teamlink"/>
                    <apex:outputPanel rendered="{!isSFAdmin}" styleClass="requiredInput" layout="block" id="teamlink">
                        <apex:outputPanel style="padding:5px;" layout="block" />
                        <a href="#" onclick="window.open('{!$Page.Connect}', '_blank', 'scrollbars=0,tollbar=0,titlebar=0');" class="button">{!$Label.Options_Link_Team}</a>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!isConnected && isUserTeamMember && NOT(isOrgTeamLinked)}">
                    <apex:outputlabel >{!$Label.Dropbox_for_SF__Not_Connected_As_DfB}</apex:outputlabel>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="{!isConnected && isOrgTeamLinked}" />
                <apex:pageBlockSectionItem rendered="{!isConnected && isOrgTeamLinked && NOT(userHasDfBMemberId)}">
                    <apex:outputlabel >{!$Label.Dropbox_for_SF__Options_Connected_As_DfB_As_User}</apex:outputlabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!isConnected && isOrgTeamLinked && userHasDfBMemberId}">
                    <apex:outputlabel >{!$Label.Dropbox_for_SF__Options_Connected_As_DfB_As_Team}</apex:outputlabel>
                </apex:pageBlockSectionItem>

            </apex:pageBlockSection>
        </apex:pageBlock>

        <c:ConfigureDBXComponent id="dbxConfigBlock" rendered="{!isSFAdmin}"/>

        <apex:pageBlock title="{!$Label.Dropbox_for_SF__Options_Std_Objects}" rendered="{!isSFAdmin}" id="stdObjectSettings">
            <apex:pageBlockButtons location="bottom">
                <apex:commandButton status="fetchStatusStdButtons" value="{!$Label.Dropbox_for_SF__Options_Edit}" action="{!editStdObjectSettings}" rendered="{!NOT(editingStdObjectSettings)}" reRender="stdObjectSettings, errors"/>
                <apex:commandButton status="fetchStatusStdButtons" value="{!$Label.Dropbox_for_SF__Options_Save}" action="{!saveStdObjectSettings}" rendered="{!editingStdObjectSettings}" reRender="stdObjectSettings, errors"/>
                <apex:commandButton status="fetchStatusStdButtons" value="{!$Label.Dropbox_for_SF__Options_Cancel}" action="{!cancelStdObjectSettings}" rendered="{!editingStdObjectSettings}" reRender="stdObjectSettings, errors"/>
                <apex:outputPanel >
                    <apex:actionStatus id="fetchStatusStdButtons" >
                        <apex:facet name="start" >
                            {!$Label.Dropbox_for_SF__Loading}
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </apex:pageBlockButtons>
            <apex:pageBlockTable value="{!stdObjCurrentPageList}" var="obj">
                <apex:column value="{!ObjLabels[obj]}" headerValue="{!$Label.Dropbox_for_SF__Options_Object}"/>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Follow_Salesforce_Record_Names}">
                    <apex:inputField value="{!stdObjSettings[obj].Rename__c}" rendered="{!editingStdObjectSettings}"/>
                    <apex:outputField value="{!stdObjSettings[obj].Rename__c}" rendered="{!NOT(editingStdObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Enable_Templates}">
                    <apex:inputField value="{!stdObjSettings[obj].Template_Enabled__c}" rendered="{!editingStdObjectSettings}"/>
                    <apex:outputField value="{!stdObjSettings[obj].Template_Enabled__c}" rendered="{!NOT(editingStdObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Template_Folder}">
                    <apex:inputField value="{!stdObjSettings[obj].Template_Directory__c}" rendered="{!editingStdObjectSettings}"/>
                    <apex:outputField value="{!stdObjSettings[obj].Template_Directory__c}" rendered="{!NOT(editingStdObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Follow_Salesforce_Sharing}">
                    <apex:inputField value="{!stdObjSettings[obj].Private_Folders__c}" rendered="{!editingStdObjectSettings}"/>
                    <apex:outputField value="{!stdObjSettings[obj].Private_Folders__c}" rendered="{!NOT(editingStdObjectSettings)}"/>
                </apex:column>
            </apex:pageBlockTable>
            <apex:panelGrid columns="8">
                <apex:commandButton status="fetchStatusStdPagination" reRender="stdObjectSettings" value="First" action="{!stdObjSettingsFirst}" disabled="{!editingStdObjectSettings || !stdObjSettingsHasPrevious}" title="First Page"/>
                <apex:commandButton status="fetchStatusStdPagination" reRender="stdObjectSettings" value="Previous" action="{!stdObjSettingsPrevious}" disabled="{!editingStdObjectSettings || !stdObjSettingsHasPrevious}" title="Previous Page"/>
                <apex:commandButton status="fetchStatusStdPagination" reRender="stdObjectSettings" value="Next" action="{!stdObjSettingsNext}" disabled="{!editingStdObjectSettings || !stdObjSettingsHasNext}" title="Next Page"/>
                <apex:commandButton status="fetchStatusStdPagination" reRender="stdObjectSettings" value="Last" action="{!stdObjSettingsLast}" disabled="{!editingStdObjectSettings || !stdObjSettingsHasNext}" title="Last Page"/>

                <apex:outputText >{!(currentStdObjPage * pageSize)+1-pageSize}-{!IF((currentStdObjPage * pageSize>numOfStdObjects), numOfStdObjects,
                     (currentStdObjPage * pageSize))} of {!numOfStdObjects}
                </apex:outputText>

                <apex:outputPanel >
                    <apex:actionStatus id="fetchStatusStdPagination" >
                        <apex:facet name="start" >
                            {!$Label.Dropbox_for_SF__Loading}
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </apex:panelGrid>
        </apex:pageBlock>

        <apex:pageBlock title="{!$Label.Dropbox_for_SF__Options_Custom_Objects}" rendered="{!isSFAdmin && customObjCurrentPageList.size > 0}" id="objectSettings">
            <apex:pageBlockButtons location="bottom">
                <apex:commandButton status="fetchStatusCustomButtons" value="{!$Label.Dropbox_for_SF__Options_Edit}" action="{!editCustomObjectSettings}" rendered="{!NOT(editingCustomObjectSettings)}" reRender="objectSettings, errors"/>
                <apex:commandButton status="fetchStatusCustomButtons" value="{!$Label.Dropbox_for_SF__Options_Save}" action="{!saveCustomObjectSettings}" rendered="{!editingCustomObjectSettings}" reRender="objectSettings, errors"/>
                <apex:commandButton status="fetchStatusCustomButtons" value="{!$Label.Dropbox_for_SF__Options_Cancel}" action="{!cancelCustomObjectSettings}" rendered="{!editingCustomObjectSettings}" reRender="objectSettings, errors"/>
                <apex:outputPanel >
                    <apex:actionStatus id="fetchStatusCustomButtons" >
                        <apex:facet name="start" >
                            {!$Label.Dropbox_for_SF__Loading}
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </apex:pageBlockButtons>
            <apex:pageBlockTable value="{!customObjCurrentPageList}" var="obj">
                <apex:column value="{!ObjLabels[obj]}" headerValue="{!$Label.Dropbox_for_SF__Options_Object}"/>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Follow_Salesforce_Record_Names}">
                    <apex:inputField value="{!customObjSettings[obj].Rename__c}" rendered="{!editingCustomObjectSettings}"/>
                    <apex:outputField value="{!customObjSettings[obj].Rename__c}" rendered="{!NOT(editingCustomObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Enable_Templates}">
                    <apex:inputField value="{!customObjSettings[obj].Template_Enabled__c}" rendered="{!editingCustomObjectSettings}"/>
                    <apex:outputField value="{!customObjSettings[obj].Template_Enabled__c}" rendered="{!NOT(editingCustomObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Template_Folder}">
                    <apex:inputField value="{!customObjSettings[obj].Template_Directory__c}" rendered="{!editingCustomObjectSettings}"/>
                    <apex:outputField value="{!customObjSettings[obj].Template_Directory__c}" rendered="{!NOT(editingCustomObjectSettings)}"/>
                </apex:column>
                <apex:column headerValue="{!$Label.Dropbox_for_SF__Options_Follow_Salesforce_Sharing}">
                    <apex:inputField value="{!customObjSettings[obj].Private_Folders__c}" rendered="{!editingCustomObjectSettings}"/>
                    <apex:outputField value="{!customObjSettings[obj].Private_Folders__c}" rendered="{!NOT(editingCustomObjectSettings)}"/>
                </apex:column>
            </apex:pageBlockTable>
            <apex:panelGrid columns="8">
                <apex:commandButton status="fetchStatusCustomPagination" reRender="objectSettings" value="First" action="{!customObjSettingsFirst}" disabled="{!editingCustomObjectSettings || !customObjSettingsHasPrevious}" title="First Page"/>
                <apex:commandButton status="fetchStatusCustomPagination" reRender="objectSettings" value="Previous" action="{!customObjSettingsPrevious}" disabled="{!editingCustomObjectSettings || !customObjSettingsHasPrevious}" title="Previous Page"/>
                <apex:commandButton status="fetchStatusCustomPagination" reRender="objectSettings" value="Next" action="{!customObjSettingsNext}" disabled="{!editingCustomObjectSettings || !customObjSettingsHasNext}" title="Next Page"/>
                <apex:commandButton status="fetchStatusCustomPagination" reRender="objectSettings" value="Last" action="{!customObjSettingsLast}" disabled="{!editingCustomObjectSettings || !customObjSettingsHasNext}" title="Last Page"/>

                <apex:outputText >{!(currentCustomObjPage * pageSize)+1-pageSize}-{!IF((currentCustomObjPage * pageSize>numOfCustomObjects), numOfCustomObjects,
                     (currentCustomObjPage * pageSize))} of {!numOfCustomObjects}
                </apex:outputText>

                <apex:outputPanel >
                    <apex:actionStatus id="fetchStatusCustomPagination" >
                        <apex:facet name="start" >
                            {!$Label.Dropbox_for_SF__Loading}
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </apex:panelGrid>
        </apex:pageBlock>

        <apex:pageBlock title="{!$Label.Dropbox_for_SF__Access_Settings_Header}" rendered="{!isSFAdmin || (NOT(isSFAdmin) && NOT(isDfbAccount))}" id="dfbSettings">

            <apex:pageBlockSection columns="1" rendered="{!NOT(isDfbAccount)}">
                <apex:pageBlockSectionItem >
                    <div class="fi-upsell">
                        <div class="fi-upsell-left">
                            <img src="{!URLFOR($Resource.style, 'img/fi-upsell.png')}" />
                            <a href="#" onclick="window.open('{!upsellPage}', '__blank');" class="fi-btn fi-btn-blue">{!$Label.Options_Try}</a>
                        </div>
                        <div class="fi-upsell-right">
                            <p>{!$Label.Options_Upsell_Upgrade}</p>
                            <ul>
                                <li>{!$Label.Options_Upsell_Ownership}</li>
                                <li>{!$Label.Options_Upsell_Space}</li>
                                <li>{!$Label.Options_Upsell_Security}</li>
                            </ul>
                        </div>
                    </div>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>

            <apex:pageBlockSection rendered="{!isSFAdmin}">
                <apex:pageBlockSectionItem rendered="{!isDfbAccount}">
                    <apex:outputLink value="{!$Page.Dropbox_for_SF__DropboxAccess}">{!$Label.Dropbox_for_SF__Options_Restrict}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!isDfbAccount}">
                    <apex:outputLabel style="color:grey">&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:commandLink action="{!resetAuth}" value="{!$Label.Dropbox_for_SF__Options_Reset_Auth}" oncomplete="window.location.reload();"
                                      onclick="if(!confirm('{!$Label.Dropbox_for_SF__Options_Reset_Confirm}')){return false};" reRender="errors"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel style="color:grey">&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:commandLink action="{!resetSettings}" value="{!$Label.Dropbox_for_SF__Options_Restore_Default_Settings}" oncomplete="window.location.reload();"
                                        onclick="if(!confirm('{!$Label.Dropbox_for_SF__Options_Reset_Confirm}')){return false};" reRender="errors"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel style="color:grey">&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:commandLink action="{!resetPages}" value="{!$Label.Dropbox_for_SF__Options_Remove_Dropbox_Layout}" oncomplete="window.location.reload();"
                                      onclick="if(!confirm('{!$Label.Dropbox_for_SF__Options_Reset_Confirm}')){return false};" reRender="errors"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel style="color:grey">&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>

        </apex:pageBlock>

    </apex:form>

</apex:page>