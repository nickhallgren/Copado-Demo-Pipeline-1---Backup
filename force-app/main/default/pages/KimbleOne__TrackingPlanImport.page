<apex:page extensions="KimbleOne.TrackingPlanImportController" standardController="KimbleOne__TrackingPlan__c"  sidebar="false" tabStyle="KimbleOne__ReferenceData__c">
<!-- Begin Default Content REMOVE THIS -->

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="TaskManagement.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__TrackingPlan__c.ResourcedActivity__r.KimbleOne__DeliveryGroup__c}" MenuContextName="{!KimbleOne__TrackingPlan__c.ResourcedActivity__r.DeliveryGroup__r.Name}" />
</apex:define>
   
<apex:define name="Content">

	<apex:form id="theForm">
		<div id="ErrorMessages">
			<apex:pageMessages escape="false"/>
		</div>
  		<apex:pageBlock >
  		<apex:pageBlockSection >
  			<apex:outputLabel value="{!$Label.kimbleone__filelabel}" />
  			<apex:inputFile value="{!blobContent}" accept=".xml"/>
	    </apex:pageBlockSection>
  		<apex:pageBlockButtons location="bottom">
			<apex:commandButton action="{!importAndSave}" value="{!$Label.kimbleone__importfromfilelabel}" rendered="{!KimbleOne__TrackingPlan__c.ResourcedActivity__r.KimbleOne__AllowNewTasks__c}"/>
		</apex:pageBlockButtons>
       </apex:pageBlock>
    </apex:form>
</apex:define>
</apex:composition>

</apex:page>