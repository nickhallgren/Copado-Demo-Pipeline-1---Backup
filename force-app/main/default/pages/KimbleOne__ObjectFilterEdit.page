<apex:page standardController="KimbleOne__ObjectFilter__c" extensions="KimbleOne.ObjectFilterEditController" sidebar="false" >

    <apex:composition template="KimbleOne__SiteMaster">
        <!-- page to create / manage object filters -->

        <!-- ActivityCaseFilterId, DeliveryGroupCaseFilterId, ResourceAutoMatchingId-->

        <apex:define name="Menu">
            <c:Menu id="menuPageTitle" MenuContextName="{!pageTitle}"/>
        </apex:define>

        <apex:define name="Content">

            <apex:form id="TheForm">

                <apex:outputPanel id="pageErrors">
                    <apex:pageMessages escape="False" />
                </apex:outputPanel>

                <apex:pageBlock title="{!$ObjectType.KimbleOne__ObjectFilter__c.Label}" >

                    <apex:pageBlockButtons location="bottom" rendered="{!!ISBLANK(KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c)}">
                        <apex:commandButton action="{!SaveAndClose}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__save}" reRender="TheForm"/>
                        <apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}"/>

                    </apex:pageBlockButtons>

                    <apex:pageBlockSection columns="2" rendered="{!ISBLANK(KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputText value="{!$ObjectType.KimbleOne__ObjectFilter__c.Fields.KimbleOne__ContextType__c.Label}" />
                            <apex:selectList value="{!KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c}" size="1">
                                <apex:selectOptions value="{!AllContextTypes}" />
                                <apex:actionSupport event="onchange" action="{!ContextTypeChanged}" rerender="TheForm" oncomplete="initialise();"/>
                            </apex:selectList>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>

                    <apex:pageBlockSection columns="2" rendered="{!!ISBLANK(KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.KimbleOne__ObjectFilter__c.Label}"/>
                            <apex:outputPanel layout="inline" style="position: relative;">
                                <apex:inputText value="{!KimbleOne__ObjectFilter__c.Name}"/>
                                <a class="toolbar-button-single" style="position: absolute;top: -8px;right: -36px;" title="{!JSENCODE($Label.Filter)}"><div class="toolbar-button toggle-btn filter-btn bigger-btn" onclick="showFilterCriteria();"><i class="fa fa-filter"></i></div></a>
                            </apex:outputPanel>
                        </apex:pageBlockSectionItem>

                        <apex:outputField value="{!KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c}"/>

                        <apex:inputHidden id="theCriteria" value="{!KimbleOne__ObjectFilter__c.KimbleOne__Criteria__c}"/>

                    </apex:pageBlockSection>

                </apex:pageBlock>

                <script>
                var contextType = '{!JSENCODE(KimbleOne__ObjectFilter__c.KimbleOne__ContextType__c)}';
                </script>


            </apex:form>

            <div id="FilterContainer">

                <div id="FilterCriteriaPopup" style="display:none;position:relative;">
                    <apex:include pageName="{!$Page.FilterCriteria}"/>
                </div>

            </div>
            
            <script>
	
            function showFilterCriteria()
            {
               initialiseModalBoxy('#FilterContainer', '{!JSENCODE($Label.Filter)}');

               loadFilterCriteria(jQuery('[id$="theCriteria"]').val(),
           			function(){
           			    jQuery("#FilterCriteriaPopup").show();
           			    showModalBoxy();
           			}
				   ,function(newFilter){
					   jQuery("#FilterCriteriaPopup").hide();
					   hideModalBoxy();
					   jQuery('[id$="theCriteria"]').val(JSON.stringify(newFilter));
				   },
				   function(){
				       jQuery("#FilterCriteriaPopup").hide();
				       hideModalBoxy();
       				});
            }

            function initialise() {
                initialiseFilterCriteriaConfig(contextType);
            }

            jQuery(window).load(function()
            {
                if  (contextType != '') initialise();

                //covert breadcrumb into link back to type list page.
                if (getQueryVariable('id')) {
                    jQuery('.breadcrumb-item-link').wrap('<a href="/' + getQueryVariable('id').slice(0,3)+'" />');
                }
            });

        </script>
            
            <style>
        div.field-selector {
            left: 190px !important;
        }
		.toolbar {
			display: table-row;
			width: 100%;
		}
		a.toolbar-button-single {
			padding-right: 3px;
		}
		a.toolbar-button-double > div {
			border-right-style: hidden;
		}
		div.toolbar-button {
			display: inline-block;
			padding: 6px 8px;
			background-color: white;
			border: 1px solid #ccc;
			border-radius: 2px;
			cursor: pointer;
		}
		div.toolbar-button.active-toolbar-button {
			color: white;
			background-color: #888;
		}		
		div.toolbar-button:hover {
			text-decoration: none;
			color: white;
			background-color: #1A9EFF;
		}
		div.toolbar-button .fa {font-size: 14px;}
		div.toolbar-button.disabled {background-color: #ccc;color: darkgray;}
		div.toolbar-button.disabled:hover {background-color: #ccc;color: darkgray;}
		div#filter-buttons {display: inline;}
		
            </style>

        </apex:define>
    </apex:composition>
</apex:page>