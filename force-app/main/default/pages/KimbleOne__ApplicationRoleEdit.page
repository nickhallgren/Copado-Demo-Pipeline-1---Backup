<apex:page standardController="KimbleOne__ApplicationRole__c" extensions="KimbleOne.BusinessUnitsController" sidebar="false">
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu"> 
	<c:Menu MenuContextType="ApplicationRole" MenuContextId="{!KimbleOne__ApplicationRole__c.Id}" MenuContextName="{!KimbleOne__ApplicationRole__c.Name}"/> 
</apex:define>
    
<apex:define name="Content">

	<apex:outputPanel id="mainPanel">
	
		<apex:form >

			<apex:pageMessages escape="false"/>

			<apex:pageBlock >
				<apex:pageBlockButtons location="bottom">
					<apex:commandButton action="{!SaveApplicationRole}" value="{!$Label.kimbleone__save}" />									
				</apex:pageBlockButtons>

				<apex:pageBlockSection columns="2" >
					<apex:inputField value="{!KimbleOne__ApplicationRole__c.Name}" required="true"/>	
					<apex:inputField value="{!KimbleOne__ApplicationRole__c.KimbleOne__IsActive__c}" />	
					<apex:inputField value="{!KimbleOne__ApplicationRole__c.KimbleOne__Description__c}"/>	
					<apex:pageBlockSectionItem rendered="{!KimbleOne__ApplicationRole__c.Id==null}">
						<apex:outputLabel value="{!$Label.kimbleone__clonefromlabel}"/>
           				<apex:selectList value="{!applicationRoleToClone}"  size="1">
							<apex:selectOptions value="{!TheApplicationRoles}" />
						</apex:selectList>		
					</apex:pageBlockSectionItem>
				</apex:pageBlockSection>

			</apex:pageBlock>
		
		</apex:form>
		
 	</apex:outputPanel>
				
</apex:define>
</apex:composition>

</apex:page>