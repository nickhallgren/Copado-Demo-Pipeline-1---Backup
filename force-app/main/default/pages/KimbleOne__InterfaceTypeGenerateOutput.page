<apex:page controller="KimbleOne.InterfaceTypeGenerateOutputController" showHeader="false" sidebar="false" contentType="{!contentType}#{!fileName}" renderAs="{!IF(fileType=='pdf','pdf','html')}" applyBodyTag="false" applyHtmlTag="false">
	<apex:outputPanel rendered="{!fileType != 'pdf'}" layout="none">
        {!Content}
    </apex:outputPanel>

    <apex:outputPanel rendered="{!fileType=='pdf'}" layout="none">
        <html width="100%" height="100%">
            <head>
                <style>
                    @page{
                        size: A4 landscape;
                    }

                    td.fitwidth {
                        width: 1px;
                        white-space: normal;
                    }
                </style>

                <h1 align="left">{!fileName}</h1>
            </head>
            <body width="100%" height="100%">
                <table width="100%" cellpadding="1" cellspacing="0" border="1" class="inner-card-table">
                    <apex:outputPanel rendered="{!CsvFileContent.TheHeader != null}" layout="none">
                        <thead>
                            <tr class="headerRow">
                                <apex:repeat value="{!CsvFileContent.TheHeader.StringValues}" var="column">
                                    <th class="fitwidth"><apex:outputText value="{!column}"/></th>
                                </apex:repeat>
                            </tr>
                        </thead>
                    </apex:outputPanel>
                    <tbody>
                        <apex:repeat value="{!CsvFileContent.TheLines}" var="line">
                            <tr>
                                <apex:repeat value="{!line.StringValues}" var="cellValue">
                                    <td class="fitwidth"><apex:outputText value="{!cellValue}"/></td>
                                </apex:repeat>
                            </tr>
                        </apex:repeat>
                    </tbody>
                </table>
            </body>
        </html>
    </apex:outputPanel>
</apex:page>