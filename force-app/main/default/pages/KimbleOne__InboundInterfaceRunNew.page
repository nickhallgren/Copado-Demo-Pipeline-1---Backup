<apex:page standardController="KimbleOne__InterfaceRun__c" extensions="KimbleOne.InboundInterfaceRunNewController" showHeader="true" sidebar="false" standardStylesheets="true">
<apex:composition template="KimbleOne__SiteMaster">
    	<apex:define name="Menu"></apex:define> 
    
    	<apex:define name="Content">
    		<apex:form id="TheForm" enctype="multipart/form-data">
	    		<div id="pageErrors">
	    			<apex:pageMessages escape="false"/>
				</div>
				<apex:pageBlock title="{!$Label.kimbleone__upload} {!$Label.kimbleone__file}">
					
					<apex:pageBlockButtons location="bottom">
	           			<apex:commandButton action="{!Save}" value="{!$Label.kimbleone__save}" rendered="{!!Finished}"/>
	           			<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}" rendered="{!!Finished}" />	           			
          			</apex:pageBlockButtons>
  			      	
  			      	<apex:pageBlockSection columns="1" collapsible="false" showheader="true" title="{!$Label.kimbleone__upload} {!$Label.kimbleone__detailslabel}" rendered="{!!Finished}">
			      		
			      		<apex:pageBlockSectionItem >
							<apex:outputText value="{!$Label.kimbleone__typelabel}" />
							<apex:selectList id="TypesList" value="{!KimbleOne__InterfaceRun__c.KimbleOne__InterfaceType__c}"  size="1" required="true">
									<apex:actionSupport event="onchange" action="{!SelectInterfaceType}" />
									<apex:selectOptions value="{!TheInboundInterfaceTypes}" />
								</apex:selectList> 
			      		</apex:pageBlockSectionItem>
			      		
			      		<apex:dynamicComponent componentValue="{!UploadContext}" rendered="{!!ISBLANK(ContextObject)}"/>
			      		
			      		<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__InterfaceRun__c.KimbleOne__InterfaceType__c)}">
							<apex:outputText value="{!$Label.kimbleone__file}" />
							<apex:inputFile value="{!TheFileToUpload.body}" filename="{!TheFileToUpload.name}" contentType="{!TheFileToUpload.contentType}"/> 
			      		</apex:pageBlockSectionItem>
			      	</apex:pageBlockSection>
			    	
			    	<apex:outputPanel layout="none" rendered="{!Finished}">
			
					<apex:actionFunction action="{!RedirectListPage}" name="GoHome" reRender="TheForm"></apex:actionFunction>
					<div id="theJobs">
					</div>
					<script>
						$(function () {
			                	loadJobsInline($('#theJobs'), '{!JSINHTMLENCODE(InterfaceRun__c.Id)}','Processing file', GoHome);
			            });
			        </script>
			        
				</apex:outputPanel>
			    	
				</apex:pageBlock>
   			</apex:form>
		</apex:define>
	</apex:composition>
    
</apex:page>