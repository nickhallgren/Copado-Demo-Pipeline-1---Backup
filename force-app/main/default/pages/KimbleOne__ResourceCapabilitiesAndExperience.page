<apex:page standardcontroller="KimbleOne__Resource__c" extensions="KimbleOne.ResourceCapabilitiesAndExperienceCntrllr,KimbleOne.SecurityController" tabStyle="KimbleOne__ReferenceData__c" sidebar="false" >
    <apex:composition template="KimbleOne__SiteMaster">

        <apex:define name="Menu" ></apex:define>

        <apex:define name="Content">

            <style>
            /* Custom LEX styling */
            li.slds-item:hover {
                cursor: pointer;
                color: rgba(0, 68, 135, 1);
                background-color: rgb(244, 246, 249);
            }
            span.slds-icon_container {
                font-size: 18px;
                padding: 4px;
            }
            /* page style */
            span.slds-icon_container.open-demands {
                background-color: #1797c0 !important;
                color: white;
            }
            span.slds-icon_container.my-experience {
                background-color: #3F51B5 !important;
                color: white;
            }
            span.slds-icon_container.my-capabilities {
                background-color: #8bc34a !important;
                color: white;
            }
            span.slds-icon_container.my-lrn-prof {
                background-color: #FF9800 !important;
                color: white;
            }
            span.slds-icon_container .fa-check-square.card-icon {
                margin-right: 1px;
            }
            span.slds-icon_container .fa-tasks.card-icon {
                margin-bottom: -2px;
            }
            span.slds-icon_container .fa-graduation-cap.card-icon {
                margin-right: -2px;
            }
            span.srch-list-stat {
                font-size: 20px;
                font-weight: bold;
                margin-left: 60px;
            }
            span.list-stat {
                font-size: 20px;
                font-weight: bold;
                position: absolute;
                right: 10px;
                top: 3px;
            }
            li.srch {
                position: relative;
            }
            .list-stats {
                position: absolute;
                top: 2px;
                right: 12px;
                text-align: right;
            }
            .itm-pref {
                display: inline-block;
                position: relative;
                margin-left: 12px;
            }
            .itm-pref .list-mini-stat {
                position: absolute;
                top: -6px;
                font-size: 12px;
                right: -12px;
                text-align: left;
                display: inline-block;
                width: 10px;
            }
            .itm-pref i.fa {
                font-size: 16px;
            }
            .itm-pref.IdealRole i.fa {
                color: gold;
            }
            .itm-pref.Consider i.fa {
                color: #008852;
            }
            .itm-pref.DoNotConsider i.fa {
                color: #ff4040;
            }
            li.slds-item {
                position: relative;
            }
            .slds-card__body.slds-card__body_inner.fixed-height-w-of {
                overflow: auto;
                height: 180px;
            }
            .page-container {
                display: table;
                width: 100%;
            }
            .page-row-container {
                display: table-row;
            }
            .page-cell-container {
                display: table-cell;
                padding: 4px;
            }
            .page-cell-container.half-row {
                width: 50%;
                height: 50%;
            }
            .nothing-here {
                padding: 20px;
                font-size: 14px;
                border: 2px dashed #bbbbbb;
                margin: 11px 2px;
                background-color: lemonchiffon;
                text-align: center;
            }
        </style>

            <apex:slds />

            <div class="slds-scope">
                <div class="page-container">
                    <div class="page-row-container">
                        <apex:outputPanel layout="none" rendered="{!EnableExpInt && $ObjectType.KimbleOne__ResourceConsultantDemandPreference__c.accessible}">
                        <div class="page-cell-container half-row">
                            <article class="slds-card open-demand-searches">
                                <div class="slds-card__header slds-grid">
                                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                        <div class="slds-media__figure">
                                            <span class="slds-icon_container open-demands">
                                              <i class="fa fa-search card-icon"></i>
                                            </span>
                                        </div>
                                        <div class="slds-media__body">
                                            <h2 class="slds-card__header-title">
                                                <a href="javascript:void(0);" class="slds-card__header-link slds-truncate adl" title="{!$Label.kimbleone__mydemandsearches}">
                                                    <apex:outputText value="{!$Label.kimbleone__mydemandsearches}"></apex:outputText>
                                                </a>
                                            </h2>
                                        </div>
                                        <div class="slds-no-flex">
                                            <button class="slds-button slds-button_neutral ns"><apex:outputText value="{!$Label.kimbleone__new}" title="{!$Label.kimbleone__expressinterestcreatesearch}"/></button>
                                        </div>
                                    </header>
                                </div>
                                <div class="slds-card__body slds-card__body_inner fixed-height-w-of">
                                    <ul class="slds-has-dividers_around-space">
                                        <apex:repeat value="{!DemandSearches.OpenSearches}" var="openSearch">
                                            <li class="slds-item srch" srch-id="{!openSearch.Id}">
                                                <apex:outputText value="{!openSearch.Name}"></apex:outputText>
                                                <div class="list-stats">
                                                    <apex:outputPanel layout="none" rendered="{!openSearch.NumIdeal > 0}">
                                                        <div class="itm-pref IdealRole" title="{!JSENCODE($Label.DemandSearchIdeal)}">
                                                            <i class="fa fa-star"></i>
                                                            <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumIdeal}"></apex:outputText>
                                                        </div>
                                                    </apex:outputPanel>

                                                    <apex:outputPanel layout="none" rendered="{!openSearch.NumConsider > 0}">
                                                        <div class="itm-pref Consider" title="{!JSENCODE($Label.DemandSearchConsider)}">
                                                            <i class="fa fa-flip-horizontal fa-thumbs-o-up"></i>
                                                            <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumConsider}"></apex:outputText>
                                                        </div>
                                                    </apex:outputPanel>

                                                    <apex:outputPanel layout="none" rendered="{!openSearch.NumDoNotConsider > 0}">
                                                        <div class="itm-pref DoNotConsider" title="{!JSENCODE($Label.DemandSearchDoNotConsider)}">
                                                            <i class="fa fa-flip-horizontal fa-thumbs-o-down"></i>
                                                            <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumDoNotConsider}"></apex:outputText>
                                                        </div>
                                                    </apex:outputPanel>
                                                    <apex:outputText styleClass="srch-list-stat" value="{!openSearch.NumMatches}"></apex:outputText>
                                                </div>
                                            </li>
                                        </apex:repeat>
                                    </ul>
                                    <apex:outputPanel layout="none" rendered="{!DemandSearches.OpenSearches.size == 0}">
                                        <div class="nothing-here"><apex:outputText value="{!$Label.kimbleone__expressinterestnosearches}"></apex:outputText></div>
                                    </apex:outputPanel>
                                </div>
                            </article>
                        </div>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ExperienceHistory__c.accessible}">
                        <div class="page-cell-container half-row">
                            <article class="slds-card my-experience">
                                <div class="slds-card__header slds-grid">
                                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                        <div class="slds-media__figure">
                                            <span class="slds-icon_container my-experience">
                                              <i class="fa fa-tasks card-icon"></i>
                                            </span>
                                        </div>
                                        <div class="slds-media__body">
                                            <h2 class="slds-card__header-title">
                                                <a href="javascript:void(0);" class="slds-card__header-link slds-truncate exp" title="{!$Label.kimbleone__myexperience}">
                                                    <apex:outputText value="{!$Label.kimbleone__myexperience}"></apex:outputText>
                                                </a>
                                            </h2>
                                        </div>
                                        <div class="slds-no-flex">
                                            <button class="slds-button slds-button_neutral exp"><apex:outputText value="{!$Label.kimbleone__view}" title="{!$Label.kimbleone__view}"/></button>
                                        </div>
                                    </header>
                                </div>
                                <div class="slds-card__body slds-card__body_inner fixed-height-w-of">
                                    <ul class="slds-has-dividers_around-space">
                                        <apex:repeat value="{!AssExpStats}" var="assExp">
                                            <li class="slds-item exp">
                                                <apex:outputText value="{!$Label.kimbleone__resourceexperienceassignmentexperience} - {!assExp}"></apex:outputText>
                                                <apex:outputText styleClass="list-stat" value="{!AssExpStats[assExp]}"></apex:outputText>
                                            </li>
                                        </apex:repeat>
                                        <apex:repeat value="{!OtherExpStats}" var="otherExp">
                                            <li class="slds-item exp">
                                                <apex:outputText value="{!$Label.kimbleone__resourceexperienceotherexperience} - {!otherExp}"></apex:outputText>
                                                <apex:outputText styleClass="list-stat" value="{!OtherExpStats[otherExp]}"></apex:outputText>
                                            </li>
                                        </apex:repeat>
                                    </ul>
                                </div>
                            </article>
                        </div>
                        </apex:outputPanel>
                    </div>
                    <div class="page-row-container">
                        <apex:outputPanel layout="none" rendered="{!EnableLearningObj && HasPermission['EditMyResourceTargetCapability']}">
                        <div class="page-cell-container half-row">
                            <article class="slds-card my-lrn-prof">
                                <div class="slds-card__header slds-grid">
                                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                        <div class="slds-media__figure">
                                            <span class="slds-icon_container my-lrn-prof">
                                              <i class="fa fa-graduation-cap card-icon"></i>
                                            </span>
                                        </div>
                                        <div class="slds-media__body">
                                            <h2 class="slds-card__header-title">
                                                <a href="javascript:void(0);" class="slds-card__header-link slds-truncate lrn" title="{!$Label.kimbleone__mylearningobjectives}">
                                                    <apex:outputText value="{!$Label.kimbleone__mylearningobjectives}"></apex:outputText>
                                                </a>
                                            </h2>
                                        </div>
                                        <div class="slds-no-flex">
                                            <button class="slds-button slds-button_neutral lrn"><apex:outputText value="{!$Label.kimbleone__view}" title="{!$Label.kimbleone__view}"/></button>
                                        </div>
                                    </header>
                                </div>
                                <div class="slds-card__body slds-card__body_inner fixed-height-w-of">
                                    <ul class="slds-has-dividers_around-space">
                                        <apex:outputPanel rendered="{!!HasObjs}">
                                            <div class="nothing-here"><apex:outputText value="{!$Label.kimbleone__mlonoobjectives}"></apex:outputText></div>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!HasObjs}">
                                            <ul class="slds-has-dividers_around-space">
                                                <li class="slds-item lrn">
                                                    <apex:outputText value="{!$Label.kimbleone__total}"></apex:outputText>
                                                    <apex:outputText styleClass="list-stat" value="{!ObjsTotal}"></apex:outputText>
                                                </li>
                                            </ul>
                                        </apex:outputPanel>
                                    </ul>
                                </div>
                            </article>
                        </div>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!HasPermission['EditMyResourceCapability']}">
                        <div class="page-cell-container half-row">
                            <article class="slds-card my-capabilities">
                                <div class="slds-card__header slds-grid">
                                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                        <div class="slds-media__figure">
                                            <span class="slds-icon_container my-capabilities">
                                              <i class="fa fa-check-square card-icon"></i>
                                            </span>
                                        </div>
                                        <div class="slds-media__body">
                                            <h2 class="slds-card__header-title">
                                                <a href="javascript:void(0);" class="slds-card__header-link slds-truncate caps" title="{!$Label.kimbleone__mycapabilitieslabel}">
                                                    <apex:outputText value="{!$Label.kimbleone__mycapabilitieslabel}"></apex:outputText>
                                                </a>
                                            </h2>
                                        </div>
                                        <div class="slds-no-flex">
                                            <button class="slds-button slds-button_neutral caps"><apex:outputText value="{!$Label.kimbleone__view}" title="{!$Label.kimbleone__view}"/></button>
                                        </div>
                                    </header>
                                </div>
                                <div class="slds-card__body slds-card__body_inner fixed-height-w-of">
                                    <ul class="slds-has-dividers_around-space">
                                        <apex:repeat value="{!CapStats}" var="cap">
                                            <li class="slds-item caps">
                                                <apex:outputText value="{!cap}"></apex:outputText>
                                                <apex:outputText styleClass="list-stat" value="{!CapStats[cap]}"></apex:outputText>
                                            </li>
                                        </apex:repeat>
                                        <apex:outputPanel rendered="{!!HasCaps}">
                                            <div class="nothing-here"><apex:outputText value="{!$Label.kimbleone__mlonocapabilities}"></apex:outputText></div>
                                        </apex:outputPanel>
                                    </ul>
                                </div>
                            </article>
                        </div>
                        </apex:outputPanel>
                    </div>
                </div>
            </div>
            <script>
                jQuery(window).load(function()
                {
                    initialiseAll();
                });

                function initialiseAll()
                {
                    initialiseActions();
                }

                function initialiseActions()
                {
                    jQuery(document).off('click', '.adl').on('click', '.adl', openDemandList);
                    jQuery(document).off('click', '.srch').on('click', '.srch', openSearch);
                    jQuery(document).off('click', '.caps').on('click', '.caps', openCaps);
                    jQuery(document).off('click', '.lrn').on('click', '.lrn', openLearningProf);
                    jQuery(document).off('click', '.exp').on('click', '.exp', openExp);
                    jQuery(document).off('click', '.ns').on('click', '.ns', createNewSearch);
                }

                function openDemandList()
                {
                    safeNavigateToSForceURL('/{!$ObjectType.ActivityAssignmentDemandSearch__c.keyPrefix}');
                }

                function openSearch()
                {
                    safeNavigateToSObject(jQuery(this).attr('srch-id'));
                }

                function openCaps()
                {
                    safeNavigateToSForceURL('{!$Page.ResourceSelfProfile}' + '?rcae=1');
                }

                function openLearningProf()
                {
                    safeNavigateToSForceURL('{!$Page.ResourceSelfProfile}' + '?mode=learn&rcae=1');
                }

                function openExp()
                {
                    safeNavigateToSForceURL('{!$Page.ResourceSelfExperience}' + '?rcae=1');
                }

                function createNewSearch()
                {
                    safeNavigateToSForceURL('{!$Page.ActivityAssignmentDemandSearch}' + '?rcae=1');
                }
            </script>
        </apex:define>
    </apex:composition>
</apex:page>