<apex:page controller="KimbleOne.JobsPendingController" sidebar="false" showHeader="false" contentType="{!IF(IsJsonResponse, 'text/json', 'text/css')}">

	<apex:outputPanel layout="none" rendered="{!IsJsonResponse}">
		<apex:outputText value="{!PendingJobsJson}"/>
	</apex:outputPanel>

	<apex:outputPanel layout="none" rendered="{!!IsJsonResponse}">
		<style>
		.job
		{
			padding-left: 20px;
			background-repeat: no-repeat;
			padding-right: 12px;
			height: 18px;
			display: block;
			line-height: 18px;
		}
		.Pending 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'pending16.gif')}');
		}
		.Processing 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'running16.gif')}');
		}
		.Completed 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'completed16.gif')}');
		}
		.Failed 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'failed16.gif')}');
		}
		
	</style>
		<script>

	var completed;
	
	var JobSuccess = function(obj)
	{
		this.target.text(obj[0].value('Status__r').value('Enum__c'));
		this.target.removeClass('Processing');
		this.target.addClass(obj[0].value('Status__r').value('Enum__c'));
		
		if (obj[0].value('Status__r').value('Enum__c') == 'Failed')
			this.target.attr('title', obj[0].value('Message__c'));
		
		// if still pending move to the bottom of the list
		if (obj[0].value('Status__r').value('Enum__c') == 'Pending')
		{
			this.target.closest('tr').appendTo(this.target.closest('table'));
		}
		
		if ($('.job.Pending').length == 0 && completed != null)
			completed(true);
		else
			RunAllJobs(completed);
	}
	
	function RunAllJobs(oncomplete)
	{
		completed = oncomplete;
		
		if ($('.job.Pending').length == 0)
		{
			completed(false);
			return;
		}
		
		$('div#title').show();
		$('div#pendingJobsBody').show();
		
		var obj = $('.job.Pending:first');
		
		$(obj).removeClass('Pending');
   		$(obj).addClass('Processing');
   		$(obj).text('Processing');
   		RunJob($(obj).attr('id'), $(obj), JobSuccess);
		
	}
 
</script>

		<div id="title" style="display:none">
			<div class="pbSubheader first tertiaryPalette"><h3><apex:outputText value="{!$CurrentPage.parameters.title}"/></h3></div>
		</div>

		<div id="pendingJobsBody" style="overflow:auto; display:none;min-height:100px;">
			<table border="0" cellpadding="0" cellspacing="0" class="list" >
				<tr class="headerRow">
					<td class="headerRow" colspan="1">
						<h2>{!$Label.ProcessLabel}</h2>
					</td>
					<td class="headerRow" >
						<h2>{!$Label.StatusLabel}</h2>
					</td>
				</tr>
				<apex:repeat value="{!PendingJobs}" var="job">
					<tr>
						<td><apex:outputText value="{!job.KimbleOne__DisplayName__c}"/></td>
						<td><span id="{!JSENCODE(job.id)}" class="job {!JSENCODE(job.Status__r.Enum__c)}"><apex:outputText value="{!job.Status__r.Name}"/></span></td>
					</tr>
				</apex:repeat>
			</table>
		</div>
	</apex:outputPanel>
</apex:page>