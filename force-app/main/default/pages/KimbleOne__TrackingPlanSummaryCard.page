<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.TrackingPlanSummaryCardController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__DeliveryGroup__c">    
    <apex:outputPanel layout="none" rendered="{!HasTrackingPlans}">
	<div class="card inverted variable-width min-horizontal-padding">
		<div class="cardHeading inverted">
				<h3 class="cardTitle"><apex:outputText value="{!$Label.kimbleone__deliverygrouphomeprintperformanceagainstplan}"/></h3>
			</div>
		
			<div class="cardBody">
				<table id="DeliveryGroupTrackingPlans" class="list cardBodyTable" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr class="headerRow">
							<th class="headerRow"><h2>{!$ObjectType.DeliveryElement__c.Fields.Name.Label}</h2></th>
							<th class="headerRow"></th>
							<th class="headerRow"><h2>{!$Label.DeliveryGroupHomeBaseline}</h2></th>
							<th class="headerRow"><h2>{!$Label.DeliveryGroupHomeExpended}</h2></th>
							<th class="headerRow"><h2>{!$Label.DeliveryGroupHomeRemaining}</h2></th>
							<th class="headerRow"><h2>{!$Label.ProjectedLabel}</h2></th>
							<th class="headerRow"><h2>{!$Label.DeliveryGroupHomeVariance}</h2></th>
						</tr>
					</thead>
					<tbody>
						<apex:repeat value="{!TrackingPlanList}" var="trackingPlanInfo" >
							<apex:repeat value="{!trackingPlanInfo.line}" var="trackingPlanDetail">
								<tr class="dataRow">
			    					<td>
										<a class="undecorated-link" href="{!$Page.KimbleOne__TrackingPlanTasks}?id={!trackingPlanDetail.tpId}">
											<apex:outputText value="{!trackingPlanDetail.DisplayName}"/>
										</a>
									</td>
			    					<td>
										<apex:outputLabel value="{!trackingPlanDetail.tptype}"/>
									</td>
									<td style="text-align:right;"> 
										<apex:outputField value="{!trackingPlanDetail.tpbaseline.KimbleOne__InputDecimal__c}" /> 						
									</td>
									<td style="text-align:right;">
										<apex:outputField value="{!trackingPlanDetail.tpexpended.KimbleOne__InputDecimal__c}" /> 						
									</td>
									<td style="text-align:right;">									
										<apex:outputField value="{!trackingPlanDetail.tpremaining.KimbleOne__InputDecimal__c}" /> 						
									</td>
									<td style="text-align:right;">
										<apex:outputField value="{!trackingPlanDetail.tptotal.KimbleOne__InputDecimal__c}" /> 					
									</td>
									<td style="text-align:right;">
										<apex:outputField value="{!trackingPlanDetail.tpvariance.KimbleOne__InputDecimal__c}" /> 
									</td>
								</tr>
							</apex:repeat>
						</apex:repeat>
					</tbody>
				</table>
			</div>
		</div>
	</apex:outputPanel>
</apex:page>