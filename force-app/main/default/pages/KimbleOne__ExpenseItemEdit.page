<apex:page standardcontroller="KimbleOne__ExpenseItem__c" >
 
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="ExpenseClaims.html" />

</apex:define>
    
<apex:define name="Content">

    <apex:outputPanel layout="none">
		<apex:sectionHeader title="{!$Label.kimbleone__kimbletimeandexpenseheader}" subtitle="{!KimbleOne__ExpenseItem__c.ExpenseClaim__r.Name} - {!KimbleOne__ExpenseItem__c.KimbleOne__Reference__c}"/>
	</apex:outputPanel>


	<apex:pageMessages escape="False"/>
 
	<apex:form >  
      
		<apex:pageBlock title="{!$ObjectType.KimbleOne__ExpenseItem__c.label} {!$Label.kimbleone__edit}" mode="edit" >

			<apex:pageBlockButtons >
				<apex:commandButton id="save" action="{!save}" value="{!$Label.kimbleone__save}"/>
				<apex:commandButton id="cancel"  action="{!cancel}" value="{!$Label.kimbleone__cancel}"/>
			</apex:pageBlockButtons>
 
			<!-- Basic Expense Item details -->
			<apex:pageBlockSection >
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ActivityExpenseCategory__c}"/>
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__TimePeriod__c}"/>
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ExpenseGrossAmount__c}"/>
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ExpenseReimbursementAmount__c}"/>
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ExpenseRevenue__c}"/>
				<apex:outputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ExpenseCost__c}"/>
			</apex:pageBlockSection>
           
			<apex:pageBlockSection >
				<apex:inputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__ExpenseNetAmount__c}" required="true"/>
				<apex:inputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__Notes__c}"/>
				<apex:inputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__Attendees__c}" rendered="{!KimbleOne__ExpenseItem__c.ActivityExpenseCategory__r.ExpenseCategory__r.KimbleOne__HasAttendees__c}"/>
				<apex:inputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__StartLocation__c}" rendered="{!KimbleOne__ExpenseItem__c.ActivityExpenseCategory__r.ExpenseCategory__r.KimbleOne__HasStartLocation__c}"/>
				<apex:inputField value="{!KimbleOne__ExpenseItem__c.KimbleOne__EndLocation__c}" rendered="{!KimbleOne__ExpenseItem__c.ActivityExpenseCategory__r.ExpenseCategory__r.KimbleOne__HasEndLocation__c}"/>
			</apex:pageBlockSection>

		</apex:pageBlock>

	</apex:form>
  
</apex:define>

</apex:composition>

</apex:page>