											<div class="deleting Loading" style="display:none"></div>
											<div id="behaviour-rule-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
								   				 <ul class="floating-dropdown-menu">
										        	<li><a href="javascript:newRateCardClick('{!JSENCODE(CostBehaviourRule__c.Id)}', '{!$ObjectType.CostBehaviourRuleRateCard__c.Name}', '{!JSENCODE(CostBehaviourRule__c.RateCardCombinationDefinition__c)}');">{!$Label.New} {!$ObjectType.KimbleOne__RateCard__c.Label}</a></li>																				        
										    	</ul>
											</div>
										</apex:outputPanel>
									</div>
									
									<div class="inner-card-body">
										<table cellpadding="0" cellspacing="0" border="0" class="inner-card-table"><!-- Fixed Width -->
										<colgroup>
											<col width="26px;"/><!-- menu  -->
											<col width="350px;"/><!-- Name  -->
											<col width="120px;"/><!-- Items  -->
											<col width="120px;"/><!-- effective date-->
											<col width="80px;"/><!-- status -->																
										</colgroup>
										<thead>
											<tr class="headerRow">
												<th></th>
												<th></th>
												<th><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></th>
												<th><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRuleRateCard__c.Fields.KimbleOne__EffectiveDate__c.Label}"/></th>
												<th><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRuleRateCard__c.Fields.KimbleOne__Status__c.Label}"/></th>												
											</tr>
										</thead> 
										<tbody>
											<apex:repeat value="{!RateCards}" var="rateCard">
												<tr>
													<td>
														<div data-floating-dropdown="#ratecard-{!rateCard.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
														<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
														<div id="ratecard-{!rateCard.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
												   			 <ul class="floating-dropdown-menu">
														        <apex:outputPanel layout="none" rendered="{!rateCard.Status__r.KimbleOne__Enum__c != 'Active'}">
														        	<li><a href="javascript:editRateCardClick('{!JSENCODE(KimbleOne__CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c)}')">{!$Label.kimbleone__edit}</a></li>
														        	<apex:outputPanel layout="none" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems = 0 && RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems > 0 && HasPermission['ActivateRateCard']}">
														        		<li><a href="javascript:activateRateCardClick('{!JSENCODE(KimbleOne__CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c)}')">{!$Label.kimbleone__activatelink}</a></li>
														        	</apex:outputPanel>
														        </apex:outputPanel>
														        
														        <apex:outputPanel layout="none" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems < 751}">
														        	<li><a href="javascript:editRateCardItemsClick('{!JSENCODE(KimbleOne__CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c)}')">{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
														        </apex:outputPanel>
														        
														        <li><a href="javascript:addRateCardItemsClick('{!JSENCODE(CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(CostBehaviourRule__c.RateCardCombinationDefinition__c)}')">{!$Label.Add} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
														        
														        <li><a href="javascript:uploadItemsClick('{!JSENCODE(CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(CostBehaviourRule__c.RateCardCombinationDefinition__c)}', true)">{!$Label.UploadAndAppend}</a></li>
														        <li><a href="javascript:uploadItemsClick('{!JSENCODE(CostBehaviourRule__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(CostBehaviourRule__c.RateCardCombinationDefinition__c)}', false)">{!$Label.UploadAndReplace}</a></li>
																
																<li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(rateCard.RateCard__c)}');">{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
																 <apex:outputPanel rendered="{!KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c != null}">
																 	<li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c)}');">{!$Label.kimbleone__configurationsetting9}</a></li>
																 </apex:outputPanel>
															 </ul>
														</div>
													
													</td>
													<td><apex:outputText value="{!rateCard.Name}"/></td>
													<td class="center-value"><apex:outputText value="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems}"/><apex:outputPanel title="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems} {!$Label.kimbleone__unmatcheditems}" styleclass="fa fa-exclamation-circle unmatched-items" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems > 0}"/></td>
													<td class="center-value"><apex:outputField value="{!rateCard.KimbleOne__EffectiveDate__c}"/></td>
													<td class="center-value"><apex:outputField value="{!rateCard.Status__r.Name}"/></td>
												</tr>											
											</apex:repeat>
										</tbody>
										</table>
										
									</div>
									
									<div class="inner-card-footer"></div>
								</div>
								</div>
							</apex:outputPanel>
							
						</div> 
						
						<div class="card-footer">
							<span class="card-footer-body"></span>
						</div>
											
					</div>
				</div>
			</apex:outputPanel>
			
			<script>
				
				jQuery(window).load(function(){
					
					<apex:outputPanel layout="none" rendered="{!ISBLANK(KimbleOne__CostBehaviourRule__c.Id)}">
						editBehaviourRuleClick();
					</apex:outputPanel>					
					
				});
			
				function editBehaviourRuleClick()
				{
					initialiseModalBoxy('#BehaviourRulePopup', '{!$ObjectType.CostBehaviourRule__c.label}', jQuery('form[id$=\'BehaviourRuleForm\']'));
					showModalBoxy();					
				}
				
				
				
			</script>
			
			<apex:form id="BehaviourRuleForm">
				<apex:actionRegion >
								   
			   		<div id="BehaviourRulePopup" style="display:none">
