						<div id="BehaviourRuleEditErrors">
					<apex:pageMessages escape="false"/>
					</div>
					<apex:pageBlock title="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Label}">
						<apex:pageBlockButtons location="bottom">
								<apex:commandButton id="saveResourceTypeBtn" styleClass="DisableButtonWhileBusy" action="{!SaveBehaviourRule}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#BehaviourRuleEditErrors');initialiseTooltips();" reRender="BehaviourRuleEdit"/>
								<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
								
							</apex:pageBlockButtons>
							
							<apex:pageBlockSection title="{!$Label.kimbleone__information}" columns="2" collapsible="false">

								<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.Name}" required="true" />
								
								<apex:pageBlockSectionItem >
								<!-- No Suffix -->
								</apex:pageBlockSectionItem>
		
								<!-- Description -->
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__Description__c.Label}" />
									<apex:outputPanel layout="none">
										<div class="requiredInput">
											<div class="requiredBlock"></div>
											<apex:inputTextarea value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__Description__c}" style="width:258px; height:63px" />
										</div>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
								<apex:pageBlockSectionItem >
									<!-- No suffix -->
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem rendered="{!ISBLANK(KimbleOne__CostBehaviourRule__c.Id)}">
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ResourcedActivityType__c.Label}" />
									<apex:selectList value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ResourcedActivityType__c}" size="1" style="width:140px">
										<apex:actionSupport event="onchange" rerender="BehaviourRuleEdit" />
										<apex:selectOptions value="{!TheResourcedActivityTypes}" />
									</apex:selectList>
									
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__CostBehaviourRule__c.Id)}">
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ResourcedActivityType__c.Label}" />
									<apex:outputText value="{!KimbleOne__CostBehaviourRule__c.ResourcedActivityType__r.Name}" />
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem rendered="{!IsDelivery}">
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ProductDomain__c.Label}" />
									<apex:selectList value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ProductDomain__c}" size="1" style="width:140px">
										<apex:selectOptions value="{!TheResourcedProductDomains}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem rendered="{!!IsDelivery}">
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__DisplaySequence__c.Label}" />
									<apex:outputPanel layout="none">
										<div class="requiredInput">
											<div class="requiredBlock"></div>
											<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__DisplaySequence__c}" />
										</div>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ForecastFactor__c.Label}" />
									<apex:outputPanel layout="none">
										<div class="requiredInput">
											<div class="requiredBlock"></div>
											<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ForecastFactor__c}" />
										</div>
									</apex:outputPanel>
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__AcceptCostChanges__c.Label}" />
									<apex:selectList value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__AcceptCostChanges__c}" size="1" style="width:140px">
										<apex:selectOptions value="{!TheAcceptCostChangesOptions}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ApplyDefaultOnCostTypeBasisChange__c.Label}" />
									<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ApplyDefaultOnCostTypeBasisChange__c}" />
								</apex:pageBlockSectionItem>
								
								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__CanEditCostRate__c.Label}" />
									<apex:inputCheckbox value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__CanEditCostRate__c}" id="can-edit-cost-rate"/>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__UseParentCost__c.Label}" />
									<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__UseParentCost__c}" />
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__CanEditSupplierCostRate__c.Label}" />
									<apex:inputCheckbox value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__CanEditSupplierCostRate__c}" id="can-edit-supplier-cost-rate"/>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__UseResourceStandardCostOnTimeEntry__c.Label}" />
									<apex:inputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__UseResourceStandardCostOnTimeEntry__c}" />
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem rendered="{!CanChangeCostType}">
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__DefaultCostType__c.Label}" />
									<apex:selectList value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__DefaultCostType__c}" size="1" style="width:140px">
										<apex:actionSupport event="onchange" rerender="BehaviourRuleEdit" />
										<apex:selectOptions value="{!TheCostTypeOptions}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>

								<apex:pageBlockSectionItem rendered="{!!CanChangeCostType}">
									<apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__DefaultCostType__c.Label}" />
									<apex:outputText value="{!KimbleOne__CostBehaviourRule__c.DefaultCostType__r.Name}"/>
								</apex:pageBlockSectionItem>

							</apex:pageBlockSection>

							<apex:pageBlockSection rendered="{!IsRateCard}" title="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__RateCardCombinationDefinition__c.Label}" columns="2" collapsible="false">
								<apex:outputText id="combinationObjectType" value="{!TheCombinationDefinition.KimbleOne__ObjectType__c}"/>
								<apex:pageBlockSectionItem >
									<!-- No suffix -->
								</apex:pageBlockSectionItem>
								<apex:inputField value="{!TheCombinationDefinition.KimbleOne__KeyDefinition__c}"  style="width:258px;" rendered="{!RateCards.size = 0}"/>
								<apex:outputField value="{!TheCombinationDefinition.KimbleOne__KeyDefinition__c}" rendered="{!!ISBLANK(TheCombinationDefinition.KimbleOne__KeyDefinition__c) && RateCards.size != 0}"/>

								<apex:inputField value="{!TheCombinationDefinition.KimbleOne__KeyFactorField__c}" rendered="{!RateCards.size = 0}"/>
								<apex:outputField value="{!TheCombinationDefinition.KimbleOne__KeyFactorField__c}" rendered="{!!ISBLANK(TheCombinationDefinition.KimbleOne__KeyFactorField__c) && RateCards.size != 0}"/>

								<apex:inputField value="{!TheCombinationDefinition.KimbleOne__Delimiter__c}" rendered="{!RateCards.size = 0}"/>
								<apex:outputField value="{!TheCombinationDefinition.KimbleOne__Delimiter__c}" rendered="{!RateCards.size != 0}"/>

								<apex:pageBlockSectionItem >
									<apex:outputText value="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Fields.KimbleOne__UnitType__c.Label}" />
									<apex:selectList value="{!TheCombinationDefinition.KimbleOne__UnitType__c}" size="1" style="width:140px">
										<apex:selectOptions value="{!TheUnitTypes}" />
									</apex:selectList>
								</apex:pageBlockSectionItem>

							</apex:pageBlockSection>

					</apex:pageBlock>
					</apex:outputPanel>
				</div>
				</apex:actionRegion>

			</apex:form>

			<apex:include pageName="{!$Page.RateCardAndItemsEdit}"/>

