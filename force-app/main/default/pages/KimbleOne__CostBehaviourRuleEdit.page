									<td><span class="property-value"><apex:outputField rendered="{!!ISBLANK(KimbleOne__CostBehaviourRule__c.KimbleOne__RateCardCombinationDefinition__c)}" value="{!KimbleOne__CostBehaviourRule__c.RateCardCombinationDefinition__r.Name}"/></span></td>
								</tr>
								<tr>
									<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__DisplaySequence__c.Label}"/></td>
									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__DisplaySequence__c}"/></span></td>
									
									<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ForecastFactor__c.Label}"/></td>
									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ForecastFactor__c}"/></span></td>
								</tr>
								<tr>
