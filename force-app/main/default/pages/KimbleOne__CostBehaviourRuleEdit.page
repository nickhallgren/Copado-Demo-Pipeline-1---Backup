									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__UseResourceStandardCostOnTimeEntry__c}"/></span></td>
								</tr>
							</table>
							<div class="description"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__Description__c}"/></div>
							
