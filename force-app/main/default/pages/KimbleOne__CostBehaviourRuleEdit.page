									<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__ApplyDefaultOnCostTypeBasisChange__c.Label}"/></td>
									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__ApplyDefaultOnCostTypeBasisChange__c}"/></span></td>
								</tr>
								<tr>
									<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__CanEditCostRate__c.Label}"/></td>
									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__CanEditCostRate__c}"/></span></td>

									<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__CostBehaviourRule__c.Fields.KimbleOne__UseParentCost__c.Label}"/></td>
									<td><span class="property-value"><apex:outputField value="{!KimbleOne__CostBehaviourRule__c.KimbleOne__UseParentCost__c}"/></span></td>
								</tr>
