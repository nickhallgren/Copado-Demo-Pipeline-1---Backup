			            {
			            	window.location.reload();
			         	}
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);	
			         	}
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
  	}
  
	
