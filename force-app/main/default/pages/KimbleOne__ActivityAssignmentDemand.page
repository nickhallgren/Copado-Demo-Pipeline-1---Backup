   	var availabilityScoringClassMap = {};
   	function initialiseAvailabilityScoring()
   	{
   		var json = new Array();
		<apex:outputText value="json={!GanttViewProperties.TheActivityAssignmentClassesJson};" rendered="{!!ISBLANK(GanttViewProperties.TheActivityAssignmentClassesJson)}"/>
		availabilityScoringClassMap = {};

		for(var i = 0; i < json.length; i++) {
			availabilityScoringClassMap[json[i][priorityName]] = json[i][includeAvailabilityScoreName];
		}
   	}
   	   	
   	function includeClassInAvailabilityScore(priority)
   	{
   		return ((priority in availabilityScoringClassMap) && availabilityScoringClassMap[priority]);
   	}
   	
   	var requiredScheduledDays = {};
   	
   	function getRequiredUsageDetails()
   	{
   		var requiredUsageDetails = {};
   		requiredUsageDetails.UnitType = 'Hour';
		requiredUsageDetails.UsageMap = {};

   		if (theAssignment.UsagePattern == null) return requiredUsageDetails;

   		var usageMap = {};
		requiredScheduledDays = {};
		
      	var assignmentUsage = new ActivityAssignmentUsagePattern(theAssignment.HoursPerDay, theAssignment.StartDate.toDate(), theAssignment.UsagePattern, theAssignment.Utilisation, theAssignment.Utilisation);

      	if (assignmentUsage == null) return usageMap;

		for (var i=0;i<=days_between(theAssignment.StartDate.toDate(), theAssignment.EndDate.toDate());i++)
		{
			var contextDate = new Date(theAssignment.StartDate.toDate().getFullYear(), theAssignment.StartDate.toDate().getMonth(), theAssignment.StartDate.toDate().getDate() + i, 0, 0, 0, 0);

			var dayUsage = assignmentUsage.getUsagePatternOnDate(contextDate);
			var usageOnDay = 0;
 			var dte = contextDate.toKimbleUTC();
 			
  	 		if (dayUsage != '')
	 		{
	 			var forecast = dayUsage.split(':')[0];
	 			if (forecast != undefined && forecast != NONFORECASTDAY && forecast != CLOSEDDAY)
	 			{
	 				var usageOnDay = KeyToHoursUsagePatternMap[forecast];
	 				
	 				if (usageOnDay == null) // percentage usage
					{
						// this is a percentage forecast day as no match was made to scheduled letters
	 					usageOnDay = (forecast / 100 * theAssignment.HoursPerDay);
 					}
 					else
 					{
 						// this is a scheduled day
 						requiredScheduledDays[dte] = true;
 					}
	 			}
	  			usageMap[dte] = usageOnDay;
			}
		}
		
		requiredUsageDetails.UsageMap = usageMap;
		
		return requiredUsageDetails;
   	}
   	
   	function findResources(assignmentId)
   	{
   		jQuery('#loadingIndicatorOuterContainer').show();
   		
   		jQuery('#goBtn').addClass('search-working');
   		jQuery('.go-spinner').removeClass('search-working');
   		
   		jQuery('#matching-gantt-lines').empty();
   		excludedResources = {};
   		
   		jQuery('#matching-resources-table-body>tbody').empty();
   		
   		var caps = new Array();
   		jQuery.each(jQuery('.required-capability-rows div[cap-type-id]'), function (i, obj){
   			caps[caps.length] = jQuery(obj).attr('cap-type-id');
   		});
   		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentDemandController.FindResources}',
	       		assignmentId, caps, getFilterCriteria(), candidateResourcesDisplayed,
	      			function(result, event){          
	             		
	             		jQuery('#loadingIndicatorOuterContainer').hide();
	             		jQuery('#goBtn').removeClass('search-working');
				   		jQuery('.go-spinner').addClass('search-working');
				   		
	             		if (event.status) 
			            {
			             	if (result.TotalRecords == 0) 
			             	{
			             		alert(kimble.labels['NoResourcesFound']);
			             		if(autoGo && jQuery('.demand-action').html().length > 0) refreshToolbars();
			             		return;
			             	}
			             	
			             	if (result.TheResources.length < result.TotalRecords)
			             	{
			             		if(caps.length > 0)
			             		{
			             			alert(kimble.labels['TooManyResourcesFoundForCapabilitySearch'].format(result.TheResources.length, result.TotalRecords));
		             			}
		             			else
		             			{
		             				alert(kimble.labels['TooManyResourcesFound'].format(result.TheResources.length, result.TotalRecords));
		             			}
			             	}
			             	resourceScoringMap = {};
			             	
			             	var scoring = (caps.length > 0 || availabilityScoringEnabled);

		             		if(scoring)
		             		{
		             			initialiseScoringColumn();
	             			}
	             			else
	             			{
	             				jQuery('.scoring-column').remove();
	             				if(jQuery('#scoring-view:visible').length > 0) showGanttView();
	             			}
			             	
			             	if(caps.length > 0)
			             	{
			             		calculateCapabilityScores(result.TheResources);
			             		jQuery('.hide-until-caps').removeClass('hide-until-caps');
		             		}
		             		else
		             		{
		             			jQuery('.scoring-btn').addClass('hide-until-caps');
		             			jQuery('.min-rating-col').addClass('hide-until-caps');
		             			
		             			if(jQuery('#scoring-view:visible').length > 0) showGanttView();
		             		}
		             		
		             		if(availabilityScoringEnabled)
		             		{
		             			var minAvailScore = (jQuery('#min-avail-score').val() != undefined && jQuery('#min-avail-score').val() != '' ? jQuery('#min-avail-score').val() : 0);
		             			calculateAvailabilityScores(result.TheResources, minAvailScore);
	             			}					
							
							jQuery('#gantt-vertical-scroll-container').scrollTo(0);
							
		             		if(scoring) result.TheResources.sort(sortByScore);
		             		else result.TheResources.sort(sortByName);
							
			             	repaintResources(result.TheResources);
			             	
			             	// if the capability scoring page is open, repaint it
			             	if(jQuery('#scoring-view:visible').length > 0) showCapabilityScoringView();
			             				             	
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
   	}
   	
