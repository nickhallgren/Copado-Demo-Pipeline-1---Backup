			            	jQuery('#' + resourceId + '.resource-grid-row').remove();
			            	jQuery('#' + resourceId + '.resource-gantt-row').remove();
			            	
			            	//delete assignment rows
			            	jQuery('[parent-id="' + resourceId + '"]').remove();
							jQuery('#' + resourceId + '>div.resource-assignments').remove();
			            	
			            	delete candidateResources[resourceId];

			            	if(Object.keys(candidateResources).length == 0) refreshFulfilmentModePanel();

			            	refreshToolbars();
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
