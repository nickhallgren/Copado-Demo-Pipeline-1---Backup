   	function rejectCandidate(resourceId, obj)
   	{
  		var assignmentId = candidateResources[resourceId].AssignmentId;
  		jQuery(obj).parent().parent().hide();
   		
       if ('{!JSENCODE(Text(TheCandidateRejectionReasons.size))}' > 1)
   		{
