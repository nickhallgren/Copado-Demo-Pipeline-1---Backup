  	}
  	
  	function saveRejectCandidate(resourceId, assignmentId, reason)
  	{
  		jQuery('tr#' + resourceId + '>td:first>a').hide().parent().addClass('Loading');
   		
   		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.RejectCandidate}',
	       		assignmentId, reason, ganttViewStartDate, ganttViewEndDate,
	      			function(result, event){          
