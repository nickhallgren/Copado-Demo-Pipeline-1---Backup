   			initialiseModalBoxy('#CandidateRejectionPopup', '{!JSENCODE($Label.RejectLabel)} {!$ObjectType.ActivityAssignment__c.label}');
   			var rejectReason = $('select[id*="candidateRejectionReason"]');
   			rejectReason.attr('resourceId', resourceId);
   			rejectReason.attr('assignmentId', assignmentId);
   			rejectReason.val('');
   			
   			showModalBoxy();		
   		}
   		else
  		{
  			saveRejectCandidate(resourceId, assignmentId, '')
  		}
   	}
  	
  	function saveRejectCandidatePopup()
  	{
  		var rejectReason = $('select[id*="candidateRejectionReason"]'); 
  		
