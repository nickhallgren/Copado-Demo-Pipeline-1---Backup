   	function getFilterCriteria()
   	{
   		var criteria = new Array();
   		
   		<apex:repeat value="{!criteria}" var="criterion">
   			// {!JSENCODE(criterion.DisplayType)}
   			// {!JSENCODE(criterion.FieldName)}
   			<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'date'}">
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['LessThan'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').datepicker("getDate").toKimbleUTC()}]};
   				
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['Equals'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').datepicker("getDate").toKimbleUTC()}]};
   				
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-gt-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['GreaterThan'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-gt-filter').datepicker("getDate").toKimbleUTC()}]};
   				
   			</apex:outputPanel>
   			
   			<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'numeric'}">
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['LessThan'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-lt-filter').val()}]};
   				
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['Equals'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').val()}]};
   				
   				if ( jQuery('#{!JSENCODE(criterion.Id)}-gt-filter').val() != '')
   					criteria[criteria.length] = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['GreaterThan'])}', Values : [{text:jQuery('#{!JSENCODE(criterion.Id)}-gt-filter').val()}]};
   				
   			</apex:outputPanel>
   			<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'lookup' || criterion.DisplayType == 'dropdown' || criterion.DisplayType == 'text' }">
   			
   			if (jQuery('[id="{!JSENCODE(criterion.Id)}-filter"]').select2('data').length > 0)
   			{
   				var o = {ObjectName : '{!JSINHTMLENCODE(criterion.ObjectName)}', FieldPath : '{!JSINHTMLENCODE(criterion.FieldPath)}', DisplayType : '{!JSINHTMLENCODE(criterion.DisplayType)}', Operator : '{!JSINHTMLENCODE(OperatorMap['IsIn'])}', Values : new Array(), Criteria:'{!JSINHTMLENCODE(criterion.SearchCriteria)}'};
   				
   				jQuery.each(jQuery('[id="{!JSENCODE(criterion.Id)}-filter"]').select2('data'), function (i, obj){
   					var val = new Object();
   					val.id = obj.id;
   					val.text = obj.text;
   					o.Values[o.Values.length] = val;
   				});
   				
   				criteria[criteria.length] = o;
   			}
   			</apex:outputPanel>

   		</apex:repeat>
   		
   		return criteria;
   	}
   	   		
   	function acceptCandidate(resourceId)
