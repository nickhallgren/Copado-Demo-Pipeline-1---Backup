    		<div id="CandidateRejectionPopup" style="display:none">
    			<apex:form >
    			<apex:pageBlock mode="edit">
						<apex:pageBlockButtons location="bottom">
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ActivityAssignment__c.updateable}">
								<input class="btn" id="btnRejectCandidateWithReason" onclick="saveRejectCandidatePopup()" type="button" value="{!$Label.RejectLabel}" style="width:60px;"/>
							</apex:outputPanel>
							<input class="btn" id="btnCancelRejectCandidate" onclick="hideModalBoxy()" type="button" value="{!$Label.Cancel}" style="width:60px;"/>
						</apex:pageBlockButtons>
						<apex:pageblockSection collapsible="false" showheader="false" columns="1" >

							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__ActivityAssignment__c.fields.KimbleOne__CandidateRejectionReason__c.label}" for="candidateRejectionReason"/>
								<apex:selectList id="candidateRejectionReason" value="{!TheCandidateRejectionReason}" size="1" required="true">
									<apex:selectOptions value="{!TheCandidateRejectionReasons}" />
								</apex:selectList>
							</apex:pageBlockSectionItem>

						</apex:pageblockSection>
				</apex:pageBlock>
				</apex:form>
    		</div>

    		<script>

	isUpdateable = {!$ObjectType.KimbleOne__ActivityAssignment__c.updateable};
    var theAssignment = <apex:outputText value="{!AssignmentJson}"/>;

    var availabilityScoringEnabled = <apex:outputText value="{!EnableAvailabilityScoring}"/>;
	var candidateResourcesDisplayed = false;
    var enableDragDrop = {!$ObjectType.KimbleOne__ActivityAssignment__c.updateable};
    var EnableDragDropSetting =  <apex:outputText value="{!EnableDragDropSetting}"/>;
    var autoGo =  <apex:outputText value="{!AssignmentDemandAutoGo}"/>;

    var excludedResources = {};

    jQuery(window).load(function(){

    	jQuery('#layout-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
	   	jQuery('#layout-container').layout({maskIframesOnResize: true, west__size: (availabilityScoringEnabled ? 276 : 266)});

    	jQuery('#period-header-container').paintPeriodsHeader(ganttViewStartDate.toDate(), ganttViewEndDate.toDate(), showNonBusDays);

      	initialiseDetailCurrencies();

      	jQuery('#demand-gantt-container').append(getAssignmentHtml(theAssignment, null, true, null, {firmOnly:false}));
      	jQuery('#demand-gantt-container').find('.activity-assignment-gantt').prop('id', 'draggable');

      	maxGanttSectionHeight = jQuery('#layout-container').height() - jQuery('#period-header-container').height() - jQuery('#demand-gantt-container').height() - scrollbarWidth;
    	jQuery('#matching-gantt-container, #gantt-vertical-scroll-container, #matching-resources-container, #cap-score-resource-rows-container').css('max-height', maxGanttSectionHeight);

    	jQuery(window).resize(function() {
    		jQuery('#layout-container, #demand-view').height(jQuery(window).height() - salesforceHeaderFooterHeight);
    		maxGanttSectionHeight = jQuery('#layout-container').height() - jQuery('#period-header-container').height() - jQuery('#demand-gantt-container').height() - scrollbarWidth;
    		jQuery('#matching-gantt-container, #gantt-vertical-scroll-container, #matching-resources-container, #cap-score-resource-rows-container').css('max-height', maxGanttSectionHeight);

    		jQuery('#demand-gantt-container').empty().append(getAssignmentHtml(theAssignment, null, true, null, {firmOnly:false}));
      		jQuery('#demand-gantt-container').find('.activity-assignment-gantt').prop('id', 'draggable');

      		jQuery('#matching-gantt-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#matching-resources-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#cap-score-resource-rows-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());

      		resetDraggable();
      		refreshViewport(true);

    	});

    	jQuery(window).resize();

    	jQuery('#gantt-vertical-scroll-container').scroll(function() {

  			jQuery('#matching-gantt-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#matching-resources-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
  			jQuery('#cap-score-resource-rows-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());

  			clearTimeout(jQuery.data(this, "scrollTimer"));

  			jQuery.data(this, "scrollTimer", setTimeout(function() {
        			refreshViewport();
    			}, 250));
  		});

      	zoomTo(zoomLevel);

        if (defaultView == 'Usage') jQuery('#showDailyButton').click();
        else if (defaultView == 'Chatter') jQuery('#showChatterButton').click();

      	jQuery('.dragging-scroll').hide();

  		jQuery('.dragging-scroll').hover(
		    function(){

		        if (jQuery('.ui-draggable-dragging').length == 0) return;

		        var scroller;

		        if ($(this).hasClass('scroll-bottom'))
		        	scroller = setInterval( scrollDown, 30 );
		        if ($(this).hasClass('scroll-top'))
		        	scroller = setInterval( scrollUp, 30 );
		        if ($(this).hasClass('scroll-left'))
		        	scroller = setInterval( scrollLeft, 30 );
		        if ($(this).hasClass('scroll-right'))
		        	scroller = setInterval( scrollRight, 30 );

		        $(this).data('scroller', scroller);
		    },
		    function(){
		        var scroller = $(this).data('scroller');
		        clearInterval( scroller );
		    }
		);

		resetDraggable();

		if (matchingCandidates.length > 0)
			repaintResources(matchingCandidates);

		//ON ZOOM HANDLE
		jQuery.subscribe('kimble.zoom', function(e){
			resetDraggable();
		});

		//ON MATCHING RESOURCES GANTT REDRAWN HANDLE
		jQuery.subscribe('kimble.ganttViewUpdated', function(e){

			setScrollHeight();

			if (EnableDragDropSetting && jQuery('.ui-draggable-dragging').length == 0)
			{
				jQuery(".ui-draggable .assignment-draggable").draggable("destroy");

				jQuery('.assignment-draggable').draggable({
							start: function( event, ui ) {
								//show dragging-scroll
								jQuery(this).css('visibility', 'hidden');
								jQuery('.dragging-scroll').show();
							},
							stop: function( event, ui ) {
								//hide dragging-scroll
								jQuery('.dragging-scroll').hide();
								jQuery(this).css('visibility', 'visible');
								jQuery('.drag-active-day').removeClass('drag-active-day');
							},
							drag: function (event, ui) {
								jQuery('.drag-active-day').removeClass('drag-active-day');
								var d = jQuery(document.elementFromPoint(Math.ceil(ui.helper.offset().left), Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));
								if (d.hasClass('day-head'))
									d.toggleClass('drag-active-day');
							},
							revert:"invalid",
							helper:'clone',
							scroll:false,
							appendTo: '#gantt-view'});
			}
			else jQuery('.assignment-draggable').css('cursor', 'default');

			applyIndicatorTitles();

			resetDroppable();

		});

		jQuery.subscribe('kimble.activityassignmentcalendarchange', function(e, data) {
			refreshResource(data.resourceId);
		});

		jQuery.subscribe('kimble.activityassignmenteditchange', function(e, data) {
			refreshResource(data.resourceId);
		});

		jQuery.subscribe('kimble.assignmentReassigned', function(e, theResource){
			if (fulfilmentMode == 'Replace' && !droppingActivity)
			{
				redirectAfterAction();
			}
			else if (!droppingActivity)
			{
				$('[id$="fulfilment-radio-buttons"]').hide();

				if(theResource.IsPreferred != undefined)
				{
					candidateResources[theResource.ResourceId] = {Status:'Proposed', ResourceId:theResource.ResourceId, ResourceName:theResource.ResourceName, AssignmentId:theResource.AssignmentId, IsPreferred:theResource.IsPreferred};

					if(candidateResources && theResource.IsPreferred)
					{
						Object.keys(candidateResources).forEach((k,i) =>
						{
							if(candidateResources[k].ResourceId != theResource.ResourceId)
							{
								candidateResources[k].IsPreferred = false;
							}
						});
					}
				}
				redrawResource(theResource.ResourceGantt);
			}
			else {
				redrawResource(theResource.ResourceGantt);
			}
		});

		jQuery.subscribe('kimble.assignmentEndDated', function(e, d){
			redrawResource(d.TheResource);
		});

