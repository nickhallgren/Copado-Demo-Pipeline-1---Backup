   	function deleteCandidate(resourceId, obj)
   	{
   		var assignmentId = candidateResources[resourceId].AssignmentId;
   		
   		// hide toolbar button
   		jQuery(obj).parent().parent().remove();
   		jQuery('tr#' + resourceId + '>td:first>a').hide().parent().addClass('Loading');
   		
