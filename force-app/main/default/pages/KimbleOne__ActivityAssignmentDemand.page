				        assign(theAssignment, jQuery(this).prop('id'), starting, obj, (fulfilmentMode == 'Candidate'), false, Object.values(candidateResources));
		       		}
		       		else if (EnableDragDropSetting){
		       		
		       			droppingActivity = true;
		       			
				        obj.show().css('position','absolute').css('visibility','').css('left', ui.helper.position().left).css('top', ui.helper.position().top).appendTo(ui.helper.parent());
				        
				        assign(assignmentMap[ui.draggable.attr('assignment-id')], jQuery(this).prop('id'), starting, obj, false, false, Object.values(candidateResources));
					}
					showModalBoxy();
					
			      },
			      over: function(event, ui) {
		      		jQuery('#' + this.id + '.resource-grid-row').addClass('drag-active-resource');
		      	  },
		      	  out: function(event, ui) {
