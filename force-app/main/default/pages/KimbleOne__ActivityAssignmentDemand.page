   	function resetDraggable()
   	{
		jQuery('#draggable.ui-draggable').draggable("destroy");
		
		if ('{!JSINHTMLENCODE(ActivityAssignmentDemand__c.Status__r.Enum__c)}' == 'Fulfilled') return;
			
		if ('{!JSENCODE(IF(ActivityAssignmentDemand__c.ActivityAssignment__r.ResourcedActivity__r.AllowNewRevenueCostItems__c,"true","false"))}' == 'false') return;

		if (zoomLevel > 2) return; //draggable not supported 

		if(fulfilmentMode == '') return;

		var draggableParams = {
			start: function( event, ui ) {if (fulfilmentMode == 'Replace') jQuery(this).hide();}, 
			stop: function( event, ui ) {if (fulfilmentMode == 'Replace') jQuery(this).show();jQuery('.drag-active-day').removeClass('drag-active-day');}, 
			drag: function (event, ui) {
				jQuery('.drag-active-day').removeClass('drag-active-day');
				var d = jQuery(document.elementFromPoint(Math.ceil(ui.helper.offset().left), Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));
				if (d.hasClass('day-head')) 
					d.toggleClass('drag-active-day');
				
			},
			revert:'invalid', 
			helper: 'clone',
			scroll:false, 
			appendTo: '#gantt-view'};

		// TODO126: this should prevent the user dragging the bar on the x axis as their are scheduled time slots and they wouldn't match up
		// however this setting is causing the bar to snap to the left of the gantt
		//if(theAssignment.TheDateTimeSlotMap != undefined && Object.keys(theAssignment.TheDateTimeSlotMap).length > 0) draggableParams.axis = "y";

		jQuery('#draggable').draggable(draggableParams);
