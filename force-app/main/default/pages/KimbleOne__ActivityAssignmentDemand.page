		function toggleAvailabilityScoring(e) {
			if(e.data.includeOn != availabilityScoringEnabled) {
				availabilityScoringEnabled = e.data.includeOn;
				jQuery('.availability-scoring-toggle-on').toggleClass('hidden-item');
				jQuery('.availability-scoring-toggle-off').toggleClass('hidden-item');
				jQuery('#availability-score-filter').toggleClass('hidden-item');
				jQuery('#availability-score-min').toggleClass('hidden-item');
			}
		}
				
		function togglesCandidateResources(e) {
			if(e.data.includeOn != candidateResourcesDisplayed) {
				candidateResourcesDisplayed = e.data.includeOn;
				jQuery('.candidate-resources-toggle-on').toggleClass('hidden-item');
				jQuery('.candidate-resources-toggle-off').toggleClass('hidden-item');
			}
		}
		
		function findLookupValues(reference, dataSourceQuery, fieldName, query, criteria)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentDemandController.FindLookupValues}',
	       		reference, unescapeXML(dataSourceQuery), fieldName, query.term, unescapeXML(criteria),
	      			function(result, event){          
	             		 if (event.status) 
			             {
			             	var data = {};
			             	data.results = result;
			             	query.callback(data);
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
		}
		
		function showDetailsView()
		{
			jQuery('#footer').hide();
			jQuery('#gantt-view').hide();
			jQuery('#chatter-view').hide();
			jQuery('#demand-view').show();			
			jQuery('#scoring-view').hide();
			
			jQuery('div.qtip:visible').qtip('hide');
		}
		
		function showCapabilityScoringView()
		{
			drawCapabilityScoringView();
		
			// temporarily hide any existing assignment rows
			jQuery('tr.resource-assignment').addClass('hide-while-scoring');
			jQuery('div.dragging-scroll').addClass('hide-while-scoring');
			jQuery('a.resource-link').addClass('disable-white-scoring');
			jQuery('#footer').hide();
			jQuery('#gantt-view').hide();
			jQuery('#chatter-view').hide();
			jQuery('#demand-view').hide();
			jQuery('#scoring-view').show();
			
			//align scoring view with resource view
			jQuery('#cap-score-resource-rows-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
			
			jQuery('div.qtip:visible').qtip('hide');
		}
		
		function showGanttView()
		{
			jQuery('tr.resource-assignment').removeClass('hide-while-scoring');
			jQuery('div.dragging-scroll').removeClass('hide-while-scoring');
			jQuery('a.resource-link').removeClass('disable-white-scoring');
			jQuery('#chatter-view').hide();
			jQuery('#demand-view').hide();
			jQuery('#gantt-view').show();
			jQuery('#footer').show();																
			jQuery('#scoring-view').hide();
			
			jQuery(window).resize();
			
		}
	
		function showChatterView()
		{
			jQuery('#footer').hide();
			jQuery('#demand-view').hide();
			jQuery('#gantt-view').hide();
			jQuery('#chatter-view').show();									
			jQuery('#scoring-view').hide();
			
			jQuery('div.qtip:visible').qtip('hide');
		}
		
		function getResourceIconOverlay(resource)
		{
			if (candidateResources[resource.Id] == null) return '';
			
			if (candidateResources[resource.Id].Status == "Declined") 
				return '<i class="fa fa-circle fa-stack-1x resource-status-circle rejected"></i><i class="fa fa-times fa-stack-1x resource-status-rejected"></i>';
			
			if (candidateResources[resource.Id].Status == "Accepted")
				return  '<i class="fa fa-circle fa-stack-1x resource-status-circle accepted"></i><i class="fa fa-check fa-stack-1x resource-status-accepted"></i>';
				
			if (candidateResources[resource.Id].Status == "Proposed")
				return  '<i class="fa fa-circle fa-stack-1x resource-status-circle pending"></i><i class="fa fa-ellipsis-h fa-stack-1x resource-status-pending"></i>';
			
			return '';
		}
		
		function getResourceActionsHtml(resource)
		{
			if (candidateResources[resource.Id] == null || candidateResources[resource.Id].Status == "Accepted")
	   		{
	   		 	return '';
	   		}
	   		else if (candidateResources[resource.Id].Status == "Declined")
	   		{
	   		 	return '<a style="actionLink" href="javascript:void(0)" onclick="deleteCandidate(\'' + resource.Id + '\', this)" title="' + '{!JSENCODE($Label.DeleteButton)}' + '"><i class="fa fa-trash-o"></i></a>'; 	
	   		}
	   		
	   		var actionHtml = '<a style="actionLink" href="javascript:void(0)" onclick="acceptCandidate(\'' + resource.Id + '\', this)" title="' + '{!JSENCODE($Label.AcceptLabel)}' + '"><i class="fa fa-thumbs-o-up"></i></a>';
			actionHtml += '<a style="actionLink" href="javascript:void(0)" onclick="rejectCandidate(\'' + resource.Id + '\', this)" title="' + '{!JSENCODE($Label.RejectLabel)}' + '"><i class="fa fa-thumbs-o-down"></i></a>';
			actionHtml += '<a style="actionLink" href="javascript:void(0)" onclick="deleteCandidate(\'' + resource.Id + '\', this)" title="' + '{!JSENCODE($Label.DeleteButton)}' + '"><i class="fa fa-trash-o"></i></a>';
			 	
			return actionHtml	 		   		
		}

		var demandStatus = '{!JSENCODE(TheDemand.Status__r.Enum__c)}';
		var amStatus = '{!JSENCODE(AutoMatchStatus)}';
		var demandIsPublished = {!ExpIntPublished};
		var amRes = {!ResourceIsAutoMatch};
		var hasExpIntCand = {!HasExpIntCandidates};

		function getDemandActionsHtml()
		{
	   		var actionHtml = '';

			if(Object.keys(candidateResources).length > 0) actionHtml += '<a style="actionLink" href="javascript:void(0)" class="ad-cand-rev-btn" onclick="showCandidateReview();" title="' + '{!JSENCODE($Label.ReviewCandidates)}' + '"><i class="fa fa-thumbs-o-up"></i><i class="fa fa-thumbs-o-down"></i></a>';
			if(enableAutoMatchResourcing && demandStatus != "Fulfilled" && amRes) actionHtml += '<a href="javascript:void(0);" class="demand-auto-match-button" onclick="autoMatchDemandAssignment();" title="{!$Label.SubmitDemandForAutoMatching}" ><i class="fa fa-puzzle-piece"></i></a>';
			if(enableExpressInterest && demandStatus != "Fulfilled" && amStatus != "Pending") actionHtml += '<a href="javascript:void(0);" class="' + (demandIsPublished != true ? ' demand-publish-button' : ' demand-published') + '" onclick="' + (demandIsPublished != true ? 'publishDemandAssignment();' : '') + '" title="' + (demandIsPublished != true ? '{!$Label.PublishDemandForExpressInterest}' : '{!$Label.PublishedDemandForExpressInterest}') + '" ><i class="fa fa-bullhorn"></i></a>';

			return actionHtml
		}
		
		function getDemandIconAndActionHtml()
		{
		    var actionHtml = '';

		    // only render the cog if there are applicable actions
		    if(Object.keys(candidateResources).length > 0 || enableAutoMatchResourcing || enableExpressInterest)
		    {
				actionHtml += '<a class="action-icon" title="' + kimble.labels['ClickForActionsMessage'] + '" actionId="{!ActivityAssignmentDemand__c}"><i class="fa fa-cog"></i></a>';

				actionHtml += '<div id="action-options-{!ActivityAssignmentDemand__c}" class="toolbar-icons" style="display: none;">';
				actionHtml += getDemandActionsHtml();
				actionHtml += '</div>'
			}

			return actionHtml;
		}

		function getDemandStatusHtml()
		{
		    var statusHtml = '';

			if(enableAutoMatchResourcing && amStatus != null && amStatus != '') statusHtml += '<i class="fa fa-puzzle-piece ass-match-ind ' + amStatus + '" title="{!$ObjectType.ActivityAssignmentDemand__c.Fields.AutoMatchStatus__c.label}: ' + kimble.encodeHTML(amStatus) + '"></i>';
			if(enableExpressInterest && demandStatus != "Fulfilled" && demandIsPublished) statusHtml += '<i class="fa fa-bullhorn exp-int-ind' + (hasExpIntCand ? ' HasCandidates' : '') + '" title="' + (hasExpIntCand ? '{!$Label.ExpressInterestCandidatesExist}' : '{!$Label.PublishedDemandForExpressInterest}') + '"></i>';

			return statusHtml;
		}

		var fulfilmentMode = '{!JSINHTMLENCODE(FulfilmentMode)}';
		var droppingActivity = false;

		function resourcingUserChanged()
		{
			updateTheResourcingManager();
		}

		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}

	</script>
