<apex:page id="ResourcePendingApprovalRequestSummary" controller="KimbleOne.ResourcePendingAprvlRequestSummaryCntrlr" tabStyle="KimbleOne__ReferenceData__c" sidebar="false">


    <apex:composition template="KimbleOne__SiteMaster">

        <apex:define name="Menu" ></apex:define>

        <apex:define name="Content">

            <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>

            <style>
            body.hasMotif.customnotabTab.apexPageInline.sfdcBody.brandQuaternaryBgr {
                margin: 0px;
            }
            .section-header {
                font-size: 16px;
                font-weight: bold;
                background-color: #F5F5F5;
                padding: 5px;
                border-radius: 2px;
                line-height: 32px;
                position: relative;
            }

            .approvals-summary-container {
                color: #5E5E5E;
                border: 1px solid #ddd;
                border-radius: 4px;
            }
            .charms-card-body {
			    padding-left: 0px !important;
			}
			.cardTileTitle {
			    margin-top: 7px;
			}
			.cardTile {
		        width: 97px;
    			height: 87px;
			}
			.cardTileIcon {
			    font-size: 30px !important;
			    margin-bottom: 4px;
			}
			.cardTileStat {
			    font-size: 20px;
			}
			.cardTileLink {
				display: inline-block;
				cursor: pointer;
			}

			.labelContainer {
			    text-align:center;
			    width:100%;
			    height:40px;
			    line-height:40px;
            }

            </style>

            <div class="approvals-summary-container no-text-select">
                <div class="section-header">
                    <apex:outputText value="{!$Label.kimbleone__approvalrequestspendingheading}"/>
                </div>

                <apex:outputPanel layout="none" rendered="{!TotalItems > 0}">
                    <div class="charms-card-body">
                        <apex:repeat value="{!TheItemTypes}" var="objectAPIName">
                            <apex:outputPanel layout="none" rendered="{!TheApprovalItemsCountMap[objectAPIName] > 0}">
                                <div object-api-name="{!JSENCODE(objectAPIName)}" class="cardTileStatLink cardTileLink" onclick="goToApprovals('{!TheApprovalObjectTypeUrlMap[objectAPIName]}');">
                                    <div class="cardTile cardTileInfo">
                                        <span class="cardTileIcon cardIconInfo fa {!JSENCODE(TheApprovalObjectTypeIconMap[objectAPIName])}"></span>
                                        <span class="cardTileStat"><apex:outputText value="{!TheApprovalItemsCountMap[objectAPIName]}"/></span>
                                        <span class="cardTileTitle"><apex:outputText value="{!TheApprovalObjectTypeNameMap[objectAPIName]}"/></span>
                                    </div>
                                </div>
                            </apex:outputPanel>
                        </apex:repeat>
                    </div>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!TotalItems == 0}">
                    <div class="labelContainer">
                            {!$Label.NothingToApprove}
                    </div>
                </apex:outputPanel>

            </div>

            <script>

                function goToApprovals(theUrl)
                {
                      safeRedirectParentToSForceURL(theUrl)
                }

            </script>

        </apex:define>

    </apex:composition>

</apex:page>