.task-gantt-box{height: 18px;border: 1px solid #3172d7;position: absolute;left:0px;right:0px;bottom: 3px;vertical-align: middle;border-radius: 2px;}
.task-gantt-box.complete {background-color: #008852;}
/* .task-gantt-box.in-progress {background-color: #E58E1A;} */
.task-gantt-box.in-progress {background-color: lightblue;}
.task-gantt-box.not-started {background-color: lightblue;}
.completed-tasks-shown {background-color: white !important; color: black !important;}
.completed-tasks-hidden {background-color: #008852 !important; color: white !important;}
.task-gantt-pct-complete {position: absolute;height: 8px;background-color: black;width:0%;bottom: 9px;}
.milestone-gantt {position: absolute;bottom: 8px;left:2px;z-index: 49;background-color: gold;border: 1px solid black;width: 10px;height: 10px;-o-transform: rotate(-45deg);-webkit-transform: rotate(-45deg);transform: rotate(-45deg);}
.milestone-gantt.Completed {border-color: gold;}
.milestone-gantt.AutoCompletionPending {border-style: dashed;}
.milestone-gantt.gantt-marker.Planning {background-color: #34b27d;}
.milestone-gantt.gantt-marker.Planning.Completed {border-color: #34b27d;}
#edit-complete-pending { color: #428BCA;margin-left: 5px;font-size: 16px;}

