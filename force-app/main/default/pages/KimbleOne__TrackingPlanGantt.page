		});
		
		function initialise()
		{
			buildEarliestAndLatestDateMaps();
			
			jQuery('#gantt-header-container').paintPeriodsHeader(ganttViewStartDate.toDate(), ganttViewEndDate.toDate(), showNonBusDays);

			getPlan();
			
			jQuery('#gantt-vertical-scroll-container').scroll(function() {
	  			
	  			jQuery('#grid-body-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
	  			
	  			jQuery('#gantt-body-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
	  			
	  			jQuery('#task-assignments-body-container').scrollTo(jQuery('#gantt-vertical-scroll-container').scrollTop());
	  		});
	  		
	  		defaultDetailViewLayout();
		}

		function setDepContainerDimensions()
		{
			jQuery('#dependency-container').css('height', document.querySelector('#gantt-body-container').scrollHeight);
		}
		
		function defaultDetailViewLayout() 
		{
			if (readCookie('kimble.trackingplanscreenstate') == 'gantt')
			{
				showGantt();
				setDefaultViewIndicator('gantt');
			}
			else if (readCookie('kimble.trackingplanscreenstate') == 'details')
			{
				showDetails();
				setDefaultViewIndicator('details');
			}
			else
			{
				showBoth();
				setDefaultViewIndicator('both');
			}
		}

		function setDefaultViewIndicator(viewName)
		{
			jQuery("input:radio[name='view-pref-group']").filter("[value='" + viewName + "']").attr('checked', true);
		}
				
		function setDefaultViewPreference()
		{
	   		createCookie('kimble.trackingplanscreenstate', jQuery(this).prop('value'));
		}

		function resizeTrackingPlan(obj)
		{			
			toggleTrackingPlan(jQuery(this).hasClass('standard-view'));
			
			jQuery(this).toggleClass('standard-view');
			jQuery(this).find('i').toggleClass('fa-expand');
			jQuery(this).find('i').toggleClass('fa-compress');
			jQuery(this).toggleClass('maximised-view');
			
			jQuery(this).prop('title', (jQuery(this).hasClass('maximised-view') ? jQuery(this).attr('restore-title') : jQuery(this).attr('maximise-title')));
		}
		
		function toggleTrackingPlan(maximise)
		{
			jQuery('#side-bar-container, #kimble-page-header-container').toggleClass('hide-for-maximised', maximise);

			jQuery('.sfdcBody').toggleClass('prevent-scroll', maximise);
			if(isSFLightning()) jQuery('.sfdcBody').closest('html').toggleClass('prevent-scroll', maximise);

			jQuery(window).resize();
		}				 	

		function refreshVerticalScroll()
		{
			if (jQuery('#grid-body-container>table').height() > jQuery('#grid-body-container').height())
				jQuery('#verticalScroll').height(jQuery('#grid-body-container>table').height()).show();
			else
				jQuery('#verticalScroll').hide();
		}
		
		var overrideLoadingHide = false;
		
		function getPlan()
		{	   
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.GetPlan}',
					theTrackingPlanId,
						function(result, event){		  
							if (event.status) 
							{
								planItems = result.ThePlanItems;
								externalPlanItems = result.TheExternalPlanItems;
								planWorkItems = result.ThePlanWorkItems;
								planPredecessors = result.ThePlanPredecessors;
								planSuccessors = result.ThePlanSuccessors;
								planResources = result.ThePlanResources;
								plannedMilestonesRequireApproval = result.PlannedMilestoneRequiresApproval;

								deletedItems = {};
								externallyVisiblePlanItemsLoaded = false;
								
								jQuery('#snapshotButton').toggleClass('hidden-item', !enableWorkItemsMap[theOrderedScopingElementIds[0]]);

								refreshPlan((result.ForceReflow || getQueryVariable('reflow') == '1'));
								
								// if we are loading a plan post templating then we reflow
								if(result.ForceReflow || getQueryVariable('reflow') == '1')
								{
									overrideLoadingHide = true;
									reflowPlan(true);
									forceSavePlan();
									
									jQuery.subscribe('kimble.plan-save-complete', function(event){
										resetPlanChanged();
								    	safeNavigateToSForceURL(trackingPlanGanttUrl);
								    });
								}
								
								initialiseActions();
								
								if (jumpTo != null)
								{
									jQuery('[node-id="' + jumpTo + '"]').click();
									jQuery('#gantt-vertical-scroll-container').scrollTop(jQuery('[node-id="' + jumpTo + '"]').position().top);
								}
								
								jQuery.publish('kimble.plan-working-end');				
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
					}, 
					{escape: true, timeout: 60000}
				);
		}

		var externallyVisiblePlanItemsLoaded = false;
		
		function getExternallyVisiblePlanItems(externalPredecessorsBody, itemId, currentItemId, currentItemType, newRow)
		{
			if(externallyVisiblePlanItemsLoaded && !newRow)
			{
				var arow = getExternalPredecessorsHtml(itemId);
				arow.appendTo(externalPredecessorsBody);
				arow.find('#external-predecessor-select').val(currentItemId);
				arow.find('#external-predecessor-type-select').val(currentItemType);
				
				jQuery('.searchable-dropdown:visible:not(.select2-container)').select2();
				
				return;
			}
			
			allExternalPlanItems = {};
			
			jQuery('#addExternalPredecessorButton:visible i').removeClass('fa-plus-square').addClass('fa-circle-o-notch fa-spin ra-pending');
			 
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.GetVisiblePlanItems}',
					theTrackingPlanId,
						function(result, event){		  
							if (event.status) 
							{
								externalPlanItems = result.TheExternalPlanItems;
								externallyVisiblePlanItemsLoaded = true;
								
								if(newRow)
								{
									createNewExternalPredecessorRow(externalPredecessorsBody);
								}
								else
								{
									var arow = getExternalPredecessorsHtml(itemId);
									arow.appendTo(externalPredecessorsBody);
									arow.find('#external-predecessor-select').val(currentItemId);
									arow.find('#external-predecessor-type-select').val(currentItemType);								
									
									jQuery('.searchable-dropdown:visible:not(.select2-container)').select2();
								}
							} 
							else 
							{
								alert(event.message);
							}
						jQuery('#addExternalPredecessorButton:visible i').addClass('fa-plus-square').removeClass('fa-circle-o-notch fa-spin ra-pending');
					}, 
					{escape: true, timeout: 60000}
				);
		}
		
		function addTasksFromTemplateForResourcedActivity(startDate, templateProductId)
		{	   
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.AddTasksFromTemplate}',
					theTrackingPlanId, parseInt(jQuery('span.position-num:last').text()), startDate, templateProductId, 
						function(result, event){		  
							if (event.status) 
							{
								planItems = result.ThePlanItems;
								externalPlanItems = result.TheExternalPlanItems;
								planWorkItems = result.ThePlanWorkItems;
								planPredecessors = result.ThePlanPredecessors;
								planSuccessors = result.ThePlanSuccessors;
								deletedItems = {};
								externallyVisiblePlanItemsLoaded = false;
								refreshPlan();
								// TODO125 display some sort of progress whilst plan is created and resaved
								
								setTimeout(function() { 
									reflowPlan();
									forceSavePlan();
									resetPlanChanged();
									jQuery.publish('kimble.plan-working-end');
								}, 500);
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
								jQuery.publish('kimble.plan-working-end');
							} 
							else 
							{
								alert(event.message);
								jQuery.publish('kimble.plan-working-end');
							}						
					}, 
					{escape: true, timeout: 60000}
				);
		}
				
		function savePlan(itemsMap, silentSave, onError)
		{			
			if(!jQuery('#saveButton').find('i').hasClass('fa-circle-o-notch')) toggleWorking('#saveButton');
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.SavePlan}',
					'<apex:outputText value="{!KimbleOne__TrackingPlan__c}"/>', itemsMap, planPredecessors, deletedItems, planWorkItems, 
						function(result, event){		  
							if (event.status) 
							{
								planItems = result.ThePlanItems;
								externalPlanItems = result.TheExternalPlanItems;
								planWorkItems = result.ThePlanWorkItems;
								planPredecessors = result.ThePlanPredecessors;
								planSuccessors = result.ThePlanSuccessors;
								planResources = result.ThePlanResources;
								
								deletedItems = {};
								externallyVisiblePlanItemsLoaded = false;

								if(!silentSave)
								{
									assignmentsInitialised = false;
									resetPlanChanged();
									
									loadAndRunTrackingPlanJobs('<apex:outputText value="{!KimbleOne__TrackingPlan__c}"/>', 'JobCalculateResourceAggregateUsage', refreshPlan);
									// now called after jobs pending inline run for tracking plan so that assignment aggregate is correct
									//refreshPlan();
								}
								
								//Delete deleted assignments (can be done silently)
								deleteAssignments(onError);											  
							} 
							else if (event.type === 'exception') 
							{
								if (onError != null)
									onError(event.message);
								else
									alert(event.message);	
							} 
							else 
							{
								if (onError != null)
									onError(event.message);
								else
									alert(event.message);
							}

							if(!silentSave)
							{
								jQuery('#toolbar-buttons>a').removeClass('disabled'); 
							}
							toggleWorking('#saveButton');
							jQuery.publish('kimble.plan-save-complete');
					}, 
					{escape: true, timeout: 60000}
				);
			 
		}
		
		var trackingPlanJobsToRun;
		var trackingPlanThreads = 2;
		var activeThreads = 0;
		
		function loadAndRunTrackingPlanJobs(contextId, jobName, callback)
		{
			activeThreads = 0;
			
			jQuery.ajax({type: "GET",
						 url: '{!$Page.JobsPendingInline}?id=' + contextId + '&response=json&jobName=' + jobName,
						 async: true,
						 dataType: "json"})
						 .done(function(data) {
							trackingPlanJobsToRun = data;

						 	if(trackingPlanJobsToRun.length == 0)
						 	{
					 			callback();
					 		}
						 	else
						 	{
						 		activeThreads = 0;
						 		
							 	for (var i=0;i < trackingPlanThreads;i++)
							 	{
									if(trackingPlanJobsToRun.length != 0)
									{
										activeThreads += 1;
										setTimeout(function(){ RunAllTrackingPlanJobs(callback); }, (i+1) * 1000);
									}
								}
							}
						})
						.fail(function(xhr, status, error) {
							if(error !=null && error !="") alert(error);
							callback();
						});
		}
		
		function RunAllTrackingPlanJobs(callback)
		{
			if (trackingPlanJobsToRun.length == 0)
			{
 				activeThreads -= 1;
		 		if(activeThreads == 0)
		 		{
		 			callback();
	 			}
			}
			else
			{				
				var jobId = trackingPlanJobsToRun.shift();
				
				RunTrackingPlanJob(jobId, function(){RunAllTrackingPlanJobs(callback)});
			}
		}
		
		function RunTrackingPlanJob(jobId, onSuccessCallback)
		{
			var callback = {onSuccess : onSuccessCallback, target:null, onFailure : function(e){console.log(e);}};
			sforce.apex.execute(KimbleNamespaceWithPeriod + 'JobWebService','RunJob',{jobId:jobId}, callback);
		}
		
		function managePlanInternally()
		{	   
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.ManagePlanInternally}',
					'<apex:outputText value="{!KimbleOne__TrackingPlan__c.KimbleOne__ResourcedActivity__c}"/>',
						function(result, event){		  
							if (event.status) 
							{
								location.reload();								
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
					}, 
					{escape: true, timeout: 60000}
				);
		}
		
		function createWorkitemSnapshot()
		{
			if(jQuery('#saveButton').hasClass('has-changes'))
			{
				confirm(kimble.labels['UnsavedChangesPlan']);
			}
			else
			{
				jQuery.publish('kimble.plan-working-start');
									
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPlanGanttController.SnapshotWorkItems}',
						'<apex:outputText value="{!KimbleOne__TrackingPlan__c.KimbleOne__ResourcedActivity__c}"/>', 
							function(result, event){		  
								if (event.status) 
								{
									// nothing to do
								} 
								else if (event.type === 'exception') 
								{
									alert(event.message);
								} 
								else 
								{
									alert(event.message);
								}
	
							jQuery.publish('kimble.plan-working-end');
						}, 
						{escape: true, timeout: 60000}
					);
			}
		}		
		
		function showGantt() {
			jQuery('.qtip').qtip('destroy', true);
		
			screenLayout.sizePane( 'east', jQuery('#layout-container').width() - 224 );
			screenLayout.open( 'east' );
		}
		   
		function showBoth() {
			jQuery('.qtip').qtip('destroy', true);
