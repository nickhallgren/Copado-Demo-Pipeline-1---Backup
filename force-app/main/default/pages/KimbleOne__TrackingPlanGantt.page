			jQuery('#gantt-body-container, #gantt-vertical-scroll-container, #grid-body-container, #task-assignments-body-container').css('max-height', maxGanttSectionHeight);
			
			jQuery('.compressible').toggleClass('compressed', compressedViewMode);

			jQuery(window).resize(function() {
			
				if(viewMode == 'grid')
				{
					salesforceHeaderFooterHeight = jQuery('#layout-container').offset().top;
				}
				else if(viewMode =='planner')
				{
					salesforceHeaderFooterHeight = jQuery('.work-items-container').offset().top;
				}

				jQuery('#layout-container, .work-items-container, .iterations-container, .backlog-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
				
				maxGanttSectionHeight = jQuery('#layout-container').height() - jQuery('#grid-header-container').height() - scrollbarWidth;
				jQuery('#gantt-body-container, #gantt-vertical-scroll-container, #grid-body-container, #task-assignments-body-container').css('max-height', maxGanttSectionHeight);
				
