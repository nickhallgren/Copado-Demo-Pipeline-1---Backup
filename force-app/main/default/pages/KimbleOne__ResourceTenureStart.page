<apex:page standardController="KimbleOne__Resource__c" extensions="KimbleOne.ResourceTenureStartController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__Resource__c">

<apex:composition template="KimbleOne__SiteMaster">
	<apex:define name="Menu"><c:Menu rendered="{!!ISBLANK(KimbleOne__Resource__c.Id)}" DefaultHelpPage="MaintainResource.html" MenuContextType="Resource" MenuContextId="{!KimbleOne__Resource__c.Id}" MenuContextName="{!KimbleOne__Resource__c.Name}"/></apex:define>
	<apex:define name="Content">
		<apex:form id="TheForm">
			<div id="pageErrors">
				<apex:pageMessages escape="False" />
			</div>
		
		<apex:pageBlock title="{!$Label.kimbleone__resourcetenurestartheading}">
			<apex:pageBlockButtons location="bottom">
				<apex:commandButton action="{!Cancel}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__cancel}" rerender="TheForm" rendered="{!TheResourceTenureStartWizard.CanCancel}"/>
				<apex:commandButton id="goPreviousBtn" action="{!TheResourceTenureStartWizard.GoPrevious}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__previous}" onComplete="initialiseItems();" reRender="TheForm" rendered="{!TheResourceTenureStartWizard.CanGoPrevious}"/>
				<apex:commandButton id="goNextBtn" action="{!TheResourceTenureStartWizard.GoNext}" styleclass="DisableButtonWhileBusy theNextButton" value="{!TheResourceTenureStartWizard.NextLabel}" onComplete="initialiseItems();" reRender="TheForm" rendered="{!TheResourceTenureStartWizard.CanGoNext}"/>
			</apex:pageBlockButtons>

			<!-- Enter Resource Start Date -->
			<apex:outputPanel rendered="{!TheResourceTenureStartWizard.CurrentStep.StepName == 'EnterResourceStartDate'}">
			<apex:pageblockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__entertenurestartdateheading}" columns="1" >
				
				<apex:outputField value="{!TheResourceTenureStartWizard.TheResource.Name}"/>
				
				<apex:inputField value="{!TheResourceTenureStartWizard.TheResource.KimbleOne__StartDate__c}" styleClass="kimbleDatePicker" required="true"/>
				
			</apex:pageblockSection>
			</apex:outputPanel>
			
			<!-- Assign User -->
			<apex:outputPanel rendered="{!TheResourceTenureStartWizard.CurrentStep.StepName == 'AssignUser'}">
			<apex:pageblockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__assignusertoresourceheading}" columns="2" >

				<apex:pageBlockSectionItem rendered="{!!EnhancedUserLookupEnabled}">
					<apex:outputLabel value="{!$ObjectType.KimbleOne__Resource__c.Fields.KimbleOne__User__c.Label}" />   
					<apex:selectList id="resourceUser" value="{!TheResourceTenureStartWizard.TheResource.KimbleOne__User__c}" size="1" >
						<apex:selectOptions value="{!TheActiveUsers}" />
					</apex:selectList>
     			</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem rendered="{!EnhancedUserLookupEnabled}">
					<apex:outputLabel value="{!$ObjectType.KimbleOne__Resource__c.Fields.KimbleOne__User__c.Label}" />

					<apex:outputPanel layout="none">
						<apex:inputText id="UserInput" value="{!TheResourceTenureStartWizard.TheResource.User__r.Name}"  styleclass="readonly" />
						<apex:inputHidden id="UserInput_lkid" value="{!TheResourceTenureStartWizard.TheResource.KimbleOne__User__c}"/>
						<a href="javascript:openLookup(KimbleLookupPage + '?lkfm=' + jQuery('[id$=\'TheForm\']').attr('id') + '&lknm=' + jQuery('[id$=\'UserInput\']').attr('id') + '&filter=ResourceTenureFilter;' + '&lktp={!$ObjectType.User.KeyPrefix}&ResourceUser={!TheResourceTenureStartWizard.TheResource.KimbleOne__User__c}&typename=ResourceTenureUser',670,'1','&lksrch='+jQuery('[id$=\'UserInput\']').val())" class="kimbleSearch " onclick="setLastMousePosition(event)" ><img src="/s.gif" class="lookupIcon" onblur="this.className = 'lookupIcon';" onfocus="this.className = 'lookupIconOn';" onmouseout="this.className = 'lookupIcon';this.className = 'lookupIcon';" onmouseover="this.className = 'lookupIconOn';this.className = 'lookupIconOn';" /></a>
					</apex:outputPanel>
					
				</apex:pageBlockSectionItem>
				
			</apex:pageblockSection>
			</apex:outputPanel>
			
			<!--Confirm Start Date Resource -->
			<apex:outputPanel rendered="{!TheResourceTenureStartWizard.CurrentStep.StepName == 'ConfirmStartDateResource'}">
			<apex:pageblockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__confirmtenurestartheading}" columns="1" >

				<apex:outputField value="{!TheResourceTenureStartWizard.TheResource.KimbleOne__StartDate__c}"/>
				<apex:outputField value="{!TheResourceTenureStartWizard.TheResource.KimbleOne__User__c}"/>

			</apex:pageblockSection>
			</apex:outputPanel>
			
			<apex:outputPanel rendered="{!TheResourceTenureStartWizard.HasFinished}">
				<script>
					safeNavigateToSForceURL('{!JSENCODE(RedirectResourceHome)}');
				</script>
			</apex:outputPanel>
		</apex:pageBlock>
		</apex:form>

		<script>

		jQuery(window).load(function()
		{
			initialiseItems();
			jQuery(':focus').blur();
		});
		function initialiseItems()
		{
		    SetupDatePicker();
  		}
		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}

		</script>

	</apex:define>
</apex:composition>
</apex:page>