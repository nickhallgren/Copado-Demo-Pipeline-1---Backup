<apex:page controller="KimbleOne.ManualInterventionJobsController" showHeader="true" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	
	<c:Menu rendered="{!!ISBLANK(menuId)}" DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextType="{!menuType}" MenuContextId="{!menuId}" MenuContextName="{!objectName}"/>

</apex:define>  
   
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
	<style>
			.cardBody {
			    padding-left: 10px;
			    padding-top: 0px;
			    padding-right: 10px;
			    padding-bottom: 11px;			
			}
		    .empty-column-content {
		        display: none;
    		}
    		.right-align-cell {
    			text-align: right;
    		}
    		.inner-card-body .bPageBlock {
    			border: none !important;
    		}
    		.inner-card-body .pbBody {
			    margin-top: 12px !important;
			    margin-left: 0px !important;
			    margin-right: 0px !important;
			    margin-bottom: 0px !important;    			
    		}
    		.approval-comments, .rejection-comments {
    			width: 250px;
    			height: 100px;
    		}
    		
    		/*
		    loading panel
			*/
			
			.loadingIndicator {
			   top:0;
			   right:0;
			   width:100%;
			   height:100%;
			   font-weight: bold;
			   position:absolute;
			   text-align:center;
			   /* IE filter */
			   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
			   -moz-opacity:0.7;    /* Mozilla extension */
			   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
			   opacity:0.7; /* CSS3 */
			   z-index:1000;
			   background-color:white;
			}
			
			.loadingIndicator img {
			    margin-right:9px;
			}
			
			#loadingIndicatorInnerContainer { 
			    position:absolute; 
			    top:50%;
			    height:10em; 
			    margin-top:-2em;
			    width:100%;
			}
			
		</style>
			
	<apex:form id="TheForm">
	
	<div id="JobsContainer">
		<apex:outputPanel id="JobsItemsContainer">
		<apex:outputPanel layout="none" rendered="{!TheManualInterventionJobs.size > 0}">
		
		<div class="card variable-width min-horizontal-padding">
			<div class="cardBody">
				<div class="inner-card" >
					<div class="inner-card-header">
						<div class="inner-card-title"><apex:outputText value="{!$Label.kimbleone__manualinterventionjobs}"/></div>						
					</div>
					<div class="inner-card-body">
						<apex:pageBlock >
				          	<apex:pageBlockTable value="{!TheManualInterventionJobs}" var="job">
				            	<apex:column headervalue="{!$Label.kimbleone__actionlinksheader}" style="text-align:center;" styleclass="actionColumn" width="60px">
									<div class="actions" style="height:20px">
										<div><apex:outputLink styleclass="actionLink" value="javascript:void(0)" onclick="retryJob(this, '{!job.JobId}');">{!$Label.kimbleone__retry}</apex:outputLink>&nbsp;|&nbsp;<apex:outputLink styleclass="actionLink" value="javascript:void(0)" onclick="ignoreJob(this, '{!job.JobId}');">{!$Label.kimbleone__ignorelink}</apex:outputLink></div>
																					                                 
					                </div>           
				              </apex:column>
				                        
				              <apex:column headerValue="{!$ObjectType.KimbleOne__Job__c.Label}">
				                  <apex:outputText escape="false" value="{!job.Name}" />
				              </apex:column>	
				               
				              <apex:column headerValue="{!$ObjectType.KimbleOne__Job__c.Fields.KimbleOne__RunDate__c.Label}">
				                  <apex:outputText value="{!job.FormattedRunDate}" style="white-space: no-wrap;"/>
				              </apex:column>
				              
				            	<apex:column headerValue="{!$ObjectType.KimbleOne__Job__c.Fields.KimbleOne__ResolutionMessage__c.Label}">
				                  <apex:outputText escape="false" value="{!job.Message.Message}" style="white-space: pre-wrap;"/>
				              </apex:column>
								
						    </apex:pageBlockTable>
						</apex:pageBlock>
					</div>
				</div>
			</div>
		</div>
		
		
		</apex:outputPanel>
		</apex:outputPanel>
	</div>
					
   <apex:actionFunction name="requery" rerender="TheForm"/>
   
   </apex:form>
   <script>
   
   	function retryJob(obj, jobId)
   	{
   		jQuery(obj).parent().css('visibility','hidden').parent().addClass('Processing');
   		
   		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ManualInterventionJobsController.RetryJob}',
	       		jobId,
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	if (result == null) 
			             	{
			             		jQuery(obj).closest('tr').remove();
			             	}
			             	else
			             	{
			             		//need to requery list
			             		requery();
			             	}
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
   	}
   	
   	function ignoreJob(obj, jobId)
   	{
   		jQuery(obj).parent().css('visibility','hidden').parent().addClass('Processing');
   		
   		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ManualInterventionJobsController.IgnoreJob}',
	       		jobId,
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	jQuery(obj).closest('tr').remove();			        
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         	}, 
	         	{escape: true, timeout: 60000}
	     	);
   	}
   
   </script>
   <style>
		
		.Processing 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'running16.gif')}');
    		background-repeat: no-repeat;
    		background-position: center;
		}
		
	</style>       
</apex:define>

</apex:composition>

</apex:page>