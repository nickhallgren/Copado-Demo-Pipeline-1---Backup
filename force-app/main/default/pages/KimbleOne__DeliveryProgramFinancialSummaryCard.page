<apex:page controller="KimbleOne.DeliveryProgramFinSummaryCardController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__ReferenceData__c">    
<apex:outputPanel layout="none" rendered="{!TheFinancialSummary.TheFinancialSummaryLines.size > 0}">
	<div class="card inverted variable-width min-horizontal-padding">    
	<div class="cardHeading inverted">
		<h3 class="cardTitle"><apex:outputText value="{!$Label.kimbleone__deliverygroupfinancialsummary}"/></h3>
		<apex:outputPanel layout="none" rendered="{!PortfolioMode}">
		<a href="{!$Page.DeliveryPortfolioEdit}?Id={!PortfolioId}"><span class="card-action-icon fa fa-edit"></span></a>
		</apex:outputPanel>
	</div>

	<div class="cardBody">
		<table class="list cardBodyTable {!IF(ShowExpenseTotals, 'has-expenses', '')}" border="0" cellpadding="0" cellspacing="0">
			<thead>
				<tr class="headerRow">
					<th class="headerRow" colspan="2"><h2></h2></th>
					<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
						<th class="headerRow"><h2></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
						<th class="headerRow"><h2></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th colspan="4" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__baselinelabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
						<th colspan="2" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__baselinelabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th colspan="4" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__projectedlabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
						<th colspan="2" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__projectedlabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th colspan="4" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__actuallabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
						<th colspan="2" class="headerRow" style="text-align: center;"><h2><apex:outputText value="{!$Label.kimbleone__actuallabel} ({!TheDisplayCurrencyIsoCode})"/></h2></th>
					</apex:outputPanel>
					<th class="headerRow"></th>
				</tr>
				<tr class="headerRow">
					<th class="headerRow"></th>
					<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
						<th class="headerRow program-name"><h2><apex:outputText value="{!$ObjectType.KimbleOne__DeliveryProgram__c.Fields.Name.Label}"/></h2></th>
					</apex:outputPanel>
					<th class="headerRow engagement-name"><h2><apex:outputText value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.Name.Label}"/></h2></th>
					<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
					<th class="headerRow"></th>
					</apex:outputPanel>
					<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
					<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
					</apex:outputPanel>
					<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
					<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
					</apex:outputPanel>
					<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
					<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
					<apex:outputPanel layout="none" rendered="{!ShowCosts}">
						<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
					</apex:outputPanel>
					<th class="headerRow"></th>
				</tr>
			</thead>
			<tbody>
				<apex:repeat value="{!TheFinancialSummary.TheFinancialSummaryLines}" var="fs">
					<tr class="dataRow delivery-group-row" delivery-group-id="{!fs.Id}">
						<td class="dataCell">
							<div class="title-card-heading-icon">
								<div class="fa fa-square kimble-probability {!JSENCODE(fs.ForecastStatusStyleClass)}" title="{!JSENCODE(fs.ForecastStatusName)}"></div>
							</div>										
						</td>
						<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
							<td class="dataCell">
								<apex:outputLink title="{!$ObjectType.KimbleOne__DeliveryProgram__c.Fields.OwnerId.Label}: {!JSENCODE(fs.Owner)}" styleClass="undecorated-link" value="/{!fs.DeliveryProgramId}"><apex:outputText value="{!fs.DeliveryProgramName}"/></apex:outputLink>
							</td>
						</apex:outputPanel>
						<td class="dataCell">
							<apex:outputLink title="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.OwnerId.Label}: {!JSENCODE(fs.Owner)}" styleClass="undecorated-link" value="/{!fs.Id}"><apex:outputText value="{!fs.DeliveryGroupName}"/></apex:outputLink>
						</td>
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
						<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__serviceslabel}"/></td>
						</apex:outputPanel>
						<td class="dataCell" style="background-color: #EEE;">
							<apex:outputField rendered="{!fs.IsResourced}" value="{!fs.BaselineUsage.KimbleOne__InputDecimal__c} " />
							<apex:outputText rendered="{!fs.IsResourced}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>						
						</td>

						<!--  depending on whether expenses totals are shown the behaviour here is different, the sum contains both services and expenses -->
						<apex:outputPanel layout="none" rendered="{!!ShowExpenseTotals}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineContractRevenue.KimbleOne__InputDecimal__c}" /></td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineContractCost.KimbleOne__InputDecimal__c}" /></td>
								<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(fs.BaselineContractMargin.KimbleOne__InputInteger__c) && fs.BaselineContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.BaselineContractMargin.KimbleOne__InputInteger__c}" /></td>
							</apex:outputPanel>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineServicesContractRevenue.KimbleOne__InputDecimal__c}" /></td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineServicesContractCost.KimbleOne__InputDecimal__c}" /></td>
								<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(fs.BaselineServicesContractMargin.KimbleOne__InputInteger__c) && fs.BaselineServicesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.BaselineServicesContractMargin.KimbleOne__InputInteger__c}" /></td>
							</apex:outputPanel>
						</apex:outputPanel>
												
						<td class="dataCell">
							<apex:outputField rendered="{!fs.IsResourced}" value="{!fs.Usage.KimbleOne__InputDecimal__c} " />
							<apex:outputText rendered="{!fs.IsResourced}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>		
						</td>

						<!--  depending on whether expenses totals are shown the behaviour here is different, the sum contains both services and expenses -->
						<apex:outputPanel layout="none" rendered="{!!ShowExpenseTotals}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!fs.ContractRevenue.KimbleOne__InputDecimal__c}" />
							</td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell">
									<apex:outputField value="{!fs.ContractCost.KimbleOne__InputDecimal__c}" />
								</td>
								<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.ContractMargin.KimbleOne__InputInteger__c) && fs.ContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.ContractMargin.KimbleOne__InputInteger__c}" /></td>
							</apex:outputPanel>
						</apex:outputPanel>						
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!fs.ServicesContractRevenue.KimbleOne__InputDecimal__c}" />
							</td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell">
									<apex:outputField value="{!fs.ServicesContractCost.KimbleOne__InputDecimal__c}" />
								</td>
								<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.ServicesContractMargin.KimbleOne__InputInteger__c) && fs.ServicesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.ServicesContractMargin.KimbleOne__InputInteger__c}" /></td>
							</apex:outputPanel>
						</apex:outputPanel>						
						<td class="dataCell">
							<apex:outputField rendered="{!fs.IsResourced}" value="{!fs.ActualUsage.KimbleOne__InputDecimal__c} " />
							<apex:outputText rendered="{!fs.IsResourced}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>	
						</td>
						<!--  depending on whether expenses totals are shown the behaviour here is different, the sum contains both services and expenses -->
						<apex:outputPanel layout="none" rendered="{!!ShowExpenseTotals}">
						<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.RecognisedMargin.KimbleOne__InputInteger__c) && fs.RecognisedMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.RecognisedMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						</apex:outputPanel>						
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
						<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedServicesRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedServicesCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.RecognisedServicesMargin.KimbleOne__InputInteger__c) && fs.RecognisedServicesMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.RecognisedServicesMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						</apex:outputPanel>						
						<td class="dataCell">
							<div class="DeliveryStatus {!JSENCODE(fs.DeliveryStatusStyleClass)} fa fa-circle" title="{!$Label.StatusLabel}: {!JSENCODE(fs.DeliveryStatusName)}"></div>										
						</td>
					</tr>
					<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals && fs.HasExpenseTotals}">
					<tr class="dataRow delivery-group-expenses-row">
						<td class="dataCell"></td>
						<td class="dataCell"></td>
						<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__expenseslabel}"/></td>
						<td class="dataCell" style="background-color: #EEE;"></td>
						<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineExpensesContractRevenue.KimbleOne__InputDecimal__c}" /></td>
						
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineExpensesContractCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(fs.BaselineExpensesContractMargin.KimbleOne__InputInteger__c) && fs.BaselineExpensesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.BaselineExpensesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
						<td class="rightAlignDataCell">
							<apex:outputField value="{!fs.ExpensesContractRevenue.KimbleOne__InputDecimal__c}" />
						</td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!fs.ExpensesContractCost.KimbleOne__InputDecimal__c}" />
							</td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.ExpensesContractMargin.KimbleOne__InputInteger__c) && fs.ExpensesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.ExpensesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
						<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedExpensesRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedExpensesCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.RecognisedExpensesMargin.KimbleOne__InputInteger__c) && fs.RecognisedExpensesMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.RecognisedExpensesMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
					</tr>
					</apex:outputPanel>
				</apex:repeat>

				<apex:outputPanel layout="none" rendered="{!ShowTotalsPreference}">
					<apex:variable var="totalRow" value="{!TheFinancialSummary.FinancialSummaryTotal}"/>
					<apex:outputPanel layout="none" rendered="{!TheFinancialSummary.TheFinancialSummaryLines.size > 1 && HasExpenseTotals}">
					<tr class="dataRow primary-row total-row">
						<td class="dataCell"></td>
						<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
							<td class="dataCell"></td>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
						<td class="dataCell"></td>
						</apex:outputPanel>
						<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__totalservicesheading}"/></td>
						<td class="dataCell fact-cell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineUsage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineServicesContractRevenue.KimbleOne__InputDecimal__c}" /></td>
						
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineServicesContractCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(totalRow.BaselineServicesContractMargin.KimbleOne__InputInteger__c) && totalRow.BaselineServicesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.BaselineServicesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell fact-cell"><apex:outputField value="{!totalRow.Usage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell">
							<apex:outputField value="{!totalRow.ServicesContractRevenue.KimbleOne__InputDecimal__c}" />
						</td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!totalRow.ServicesContractCost.KimbleOne__InputDecimal__c}" />
							</td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.ServicesContractMargin.KimbleOne__InputInteger__c) && totalRow.ServicesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.ServicesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell fact-cell"><apex:outputField value="{!totalRow.ActualUsage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedServicesRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedServicesCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.RecognisedServicesMargin.KimbleOne__InputInteger__c) && totalRow.RecognisedServicesMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.RecognisedServicesMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
					</tr>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!TheFinancialSummary.TheFinancialSummaryLines.size > 1 && HasExpenseTotals}">
					<tr class="dataRow total-row">
						<td class="dataCell"></td>
						<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
							<td class="dataCell"></td>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!ShowExpenseTotals}">
						<td class="dataCell"></td>
						</apex:outputPanel>
						<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__totalexpensesheading}"/></td>
						<td class="dataCell" style="background-color: #EEE;"></td>
						<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineExpensesContractRevenue.KimbleOne__InputDecimal__c}" /></td>
						
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineExpensesContractCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(totalRow.BaselineExpensesContractMargin.KimbleOne__InputInteger__c) && totalRow.BaselineExpensesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.BaselineExpensesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
						<td class="rightAlignDataCell">
							<apex:outputField value="{!totalRow.ExpensesContractRevenue.KimbleOne__InputDecimal__c}" />
						</td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!totalRow.ExpensesContractCost.KimbleOne__InputDecimal__c}" />
							</td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.ExpensesContractMargin.KimbleOne__InputInteger__c) && totalRow.ExpensesContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.ExpensesContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
						<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedExpensesRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedExpensesCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.RecognisedExpensesMargin.KimbleOne__InputInteger__c) && totalRow.RecognisedExpensesMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.RecognisedExpensesMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
					</tr>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!HasExpenseTotals || TheFinancialSummary.TheFinancialSummaryLines.size > 1}">
					<tr class="dataRow primary-row total-row">
						<td class="dataCell"></td>
						<apex:outputPanel layout="none" rendered="{!IsParentProgram}">
							<td class="dataCell"></td>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!HasExpenseTotals && ShowExpenseTotals}">
						<td class="dataCell"></td>
						</apex:outputPanel>
						<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__total}"/></td>
						<td class="dataCell fact-cell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineUsage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineContractRevenue.KimbleOne__InputDecimal__c}" /></td>
						
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!totalRow.BaselineContractCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(totalRow.BaselineContractMargin.KimbleOne__InputInteger__c) && totalRow.BaselineContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.BaselineContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell fact-cell"><apex:outputField value="{!totalRow.Usage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell">
							<apex:outputField value="{!totalRow.ContractRevenue.KimbleOne__InputDecimal__c}" />
						</td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell">
								<apex:outputField value="{!totalRow.ContractCost.KimbleOne__InputDecimal__c}" />
							</td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.ContractMargin.KimbleOne__InputInteger__c) && totalRow.ContractMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.ContractMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell fact-cell"><apex:outputField value="{!totalRow.ActualUsage.KimbleOne__InputDecimal__c}" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/><apex:outputText value=" ({!totalRow.UsageUnits})" styleClass="inline-usage-units" rendered="{!totalRow.ShowUsageTotals && !ISBLANK(totalRow.UsageUnits)}"/></td>
						<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedRevenue.KimbleOne__InputDecimal__c}" /></td>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<td class="rightAlignDataCell"><apex:outputField value="{!totalRow.RecognisedCost.KimbleOne__InputDecimal__c}" /></td>
							<td class="rightAlignDataCell" style="{!IF(!ISBLANK(totalRow.RecognisedMargin.KimbleOne__InputInteger__c) && totalRow.RecognisedMargin.KimbleOne__InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!totalRow.RecognisedMargin.KimbleOne__InputInteger__c}" /></td>
						</apex:outputPanel>
						
						<td class="dataCell"></td>
					</tr>
					</apex:outputPanel>					
				</apex:outputPanel>				
			</tbody>
		</table>
	</div>
