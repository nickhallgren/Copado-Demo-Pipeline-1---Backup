<apex:page Controller="KimbleOne.DeliveryElementProposalEditController" extensions="KimbleOne.ActivityAssignmentRemoteActions" showHeader="false" sidebar="false">
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__ActivityAssignmentUsagePattern)}" />
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'InsightStyle.css')}"/>

	<div id="jobsPanel" style="display:none"></div>
	
	<apex:form id="TheProposalElementForm">
	<apex:actionRegion >
	
	<div id="editProposalElementPopup" style="display:none">
		 <apex:outputPanel id="PopupContent">
		 <apex:actionStatus id="DeliveryLoadingStatus">
                <apex:facet name="start">
                    <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
                        <div id="loadingIndicatorInnerContainer">
                            <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
			<div id="ProposalElementsErrorPanel"><apex:pageMessages id="MessagesPanel" escape="false" /></div>
			<div id="assignment-error" style="display:none"><span><div class="message errorM3"><table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;"><tbody><tr valign="top"><td><img alt="error" class="msgIcon" src="/s.gif" title="{!$Label.Error}"/></td><td class="messageCell"><div class="messageText" id="assignment-error-text"><br/></div></td></tr><tr><td></td><td></td></tr></tbody></table></div></span></div>
			<div id="validationPageMessageContainer" style="display:none"><apex:pageMessage id="validationPageMessage" severity="error" strength="2" summary="{!$Label.kimbleone__targetmarginexceedsmaximum}"/></div>
			<apex:outputPanel rendered="{!!ISBLANK(TheDeliveryElement)}">
					
					<apex:pageBlock mode="edit">				
						
						<apex:pageBlockButtons location="bottom" id="ButtonsBlock" styleclass="ButtonsBlock">
							<input type="button" id="saveButton" onclick="saveTheElement();jQuery('#loadingIndicatorOuterContainerGroups').parent().show();" class="btn DisableButtonWhileBusy" value="{!$Label.SaveAndClose}" />
                            <input type="button" id="saveAndReloadButton" onclick="saveAndReloadTheElement();" class="btn DisableButtonWhileBusy" value="{!$Label.Save}" />
							<apex:outputPanel layout="none" rendered="{!TheDeliveryElement.CanDelete}">
								<input type="button" id="deleteButton" onclick="deleteTheElement();" class="btn DisableButtonWhileBusy" value="{!$Label.DeleteButton}"/>
							</apex:outputPanel>
							<input type="button" id="CancelButton" onclick="hideStackedModalBoxy();" class="btn" value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
				
						<apex:outputPanel id="ElementConfigurationContainer">

						<apex:outputPanel layout="none" rendered="{!ShowExpenseInsight}">
							<div class="insight-container expense-cat-average insight-collapsed insight-hidden" account-id="{!JSENCODE(TheDeliveryElement.TheDeliveryElement.DeliveryGroup__r.Account__c)}" display-currency="{!JSENCODE(TheDeliveryElement.TheDeliveryElement.CurrencyISOCode)}">
								<div class="docked-insight-container docked-offset">
									<div class="docked-insight"></div>
								</div>
								<div class="insight-item">
									<span class="miniCardIcon cardIconInfo fa fa-lightbulb-o"></span>
								</div>
							</div>
						</apex:outputPanel>

						<apex:outputPanel layout="none" rendered="{!ShowResourceTypeMarginInsight && $ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__TemporalForecastCostRate__c.Accessible}">
							<div class="insight-container resource-type-margin insight-collapsed insight-hidden" account-id="{!JSENCODE(TheDeliveryElement.TheDeliveryElement.DeliveryGroup__r.Account__c)}" display-currency="{!JSENCODE(TheDeliveryElement.TheDeliveryElement.CurrencyISOCode)}">
								<div class="docked-insight-container docked-offset">
									<div class="docked-insight"></div>
								</div>
								<div class="insight-item">
									<span class="miniCardIcon cardIconInfo fa fa-lightbulb-o"></span>
								</div>
							</div>
						</apex:outputPanel>
								
						<apex:pageblockSection id="headerFields" collapsible="false" showheader="false" columns="2">
							
							<apex:inputField value="{!TheDeliveryElement.TheDeliveryElement.KimbleOne__ShortName__c}"/>
                            <apex:pageBlockSectionItem id="location-panel" rendered="{!ActivityLocationEnabled}">
								<apex:outputLabel for="LocationList">
									<apex:outputText value="{!$ObjectType.KimbleOne__ResourcedActivity__c.Fields.KimbleOne__Location__c.Label}" />
								</apex:outputLabel>
							
								<apex:outputPanel layout="none">
									<apex:outputPanel layout="none" rendered="{!!UseLocationEnhancedLookup}">
										<apex:selectList id="default-location-list" value="{!TheDeliveryElement.TheOperatingActivity.KimbleOne__Location__c}" size="1"  >
											<apex:selectOptions value="{!TheLocationOptions}" />
										</apex:selectList>
									</apex:outputPanel>

									<apex:outputPanel layout="none" rendered="{!UseLocationEnhancedLookup}">
										<apex:actionRegion >
											<apex:inputField id="default-location-field" styleclass="kimbleSearch " value="{!TheDeliveryElement.TheOperatingActivity.KimbleOne__Location__c}">
											</apex:inputField>
										</apex:actionRegion>
									</apex:outputPanel>
									<apex:outputPanel layout="none" rendered="{!TheDeliveryElement.IsLocationRequired}">
										<div class="toolbar-button" title="{!$Label.kimbleone__label001}">
											<i class="fa fa-arrow-down cascade-location-change" onclick="cascadeLocationChange();"/>
										</div>
									</apex:outputPanel>
								</apex:outputPanel>

							</apex:pageBlockSectionItem>
                            							
							<!-- TOP DOWN SERVICES EXPECTED REVENUE -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesRevenue && TheDeliveryElement.RevenueForecastMode = 'DeliveryElement'}">
                                   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractRevenue__c.Label} ({!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c})"/>
                                   <apex:inputField id="element-expected-revenue" styleclass="kimble-number" value="{!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCcyExpectedContractRevenue__c}" onchange="calculateAssignmentRevenuesAndCosts()"/>
                            </apex:pageBlockSectionItem>
                            
                            <!-- TOP DOWN SERVICE GENERATED REVENUE -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesRevenue && TheDeliveryElement.TheProduct.RevenueMilestoneGenerated && TheDeliveryElement.RevenueForecastMode != 'DeliveryElement'}">
                                   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractRevenue__c.Label} ({!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c})"/>
                                   <input type="text" id="element-generated-revenue" value="" class="kimble-number kimble-format-currency" readonly="readonly"/>
                            </apex:pageBlockSectionItem>
							
							<!-- BOTTOM UP SERVICES REVENUE -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesRevenue && !TheDeliveryElement.TheProduct.RevenueMilestoneGenerated && TheDeliveryElement.RevenueForecastMode = 'RevenueItem'}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractRevenue__c.Label} ({!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c})"/>
                                   <input type="text" id="element-services-revenue" value="" class="kimble-number kimble-format-currency" readonly="readonly"/>
							</apex:pageBlockSectionItem>
							
							<!-- TOP DOWN SERVICES COST -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode == 'DeliveryElement'}">
                                   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractCost__c.Label} ({!TheDeliveryElement.TheDeliveryElement.CurrencyIsoCode})"/>
                                   <apex:inputField id="element-expected-cost" styleclass="kimble-number" value="{!TheDeliveryElement.TheDeliveryElement.KimbleOne__ExpectedContractCost__c}" />
                            </apex:pageBlockSectionItem>
							
							<!-- BOTTOM UP SERVICES COST -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode != 'DeliveryElement'}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractCost__c.Label} ({!TheDeliveryElement.TheDeliveryElement.CurrencyISOCode})"/>
                                   <input type="text" id="element-services-cost" value="" class="kimble-number kimble-format-currency" readonly="readonly"/>
							</apex:pageBlockSectionItem>
							
							<!-- BOTTOM UP OVERIDDEN SERVICES COST (includes formatting placeholder) -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode != 'DeliveryElement' && !ISBLANK(TheDeliveryElement.TheRateCardItemMap)}"></apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode != 'DeliveryElement' && !ISBLANK(TheDeliveryElement.TheRateCardItemMap)}">
								   <apex:outputText styleClass="cost-override"  value="{!$Label.kimbleone__standardlabel} {!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ServicesContractCost__c.Label} ({!TheDeliveryElement.TheDeliveryElement.CurrencyISOCode})"/>
                                   <input type="text" id="element-services-cost-overriden" value="" class="kimble-number cost-override kimble-format-currency" readonly="readonly"/>
							</apex:pageBlockSectionItem>
							
							<!-- TOP DOWN SERVICES MARGIN -->
<!-- 							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesRevenue && TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode == 'DeliveryElement'}"> -->
<!--                                    <apex:outputText value="Services Contract Margin (%)"/> -->
<!--                                    <input type="text" id="element-expected-margin" value="" class="headline-margin-value" readonly="readonly"/> -->
<!--                             </apex:pageBlockSectionItem> -->
							
							<!-- BOTTOM UP SERVICES MARGIN -->
<!-- 							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasServicesRevenue && TheDeliveryElement.TheProduct.HasServicesCost && TheDeliveryElement.CostForecastMode != 'DeliveryElement'}"> -->
<!-- 								   <apex:outputText value="Services Contract Margin (%)"/> -->
<!--                                    <input type="text" id="element-services-margin" value="" class="headline-margin-value" readonly="readonly"/> -->
<!--                             </apex:pageBlockSectionItem> -->

							<!-- BOTTOM UP EXPENSES REVENUE -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.RevenueExpenseGenerated}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ExpensesContractRevenue__c.Label} ({!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c})"/>
                                   <input type="text" id="element-expenses-revenue" class="kimble-number kimble-format-currency" readonly="readonly"/>
							</apex:pageBlockSectionItem>
							
							<!-- BOTTOM UP EXPENSES COST -->
							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.HasExpensesCost}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__ExpensesContractCost__c.Label} ({!TheDeliveryElement.TheDeliveryElement.CurrencyISOCode})"/>
                                   <input type="text" id="element-expenses-cost" class="kimble-number kimble-format-currency" readonly="readonly"/>
							</apex:pageBlockSectionItem>
														
							<!-- BOTTOM UP EXPENSES MARGIN -->
<!-- 							<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.RevenueExpenseGenerated && TheDeliveryElement.TheProduct.HasExpensesCost}"> -->
<!-- 								   <apex:outputText value="Expenses Contract Margin (%)"/> -->
<!--                                    <input type="text" id="element-expenses-margin" class="headline-margin-value" readonly="readonly"/> -->
<!-- 							</apex:pageBlockSectionItem> -->

							<!-- DISCOUNT -->
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheDiscountScheme)}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DiscountScheme__c.Label}"/>
								   <apex:outputField value="{!TheDiscountScheme.Name}"/>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem />
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheDiscountScheme) && TheDiscountScheme.SchemeModel__r.SchemeRateType__r.KimbleOne__Enum__c = 'Flat'}">
								   <apex:outputText value="{!$ObjectType.KimbleOne__DiscountScheme__c.Fields.KimbleOne__DiscountPercentage__c.Label}"/>
								   <apex:outputField value="{!TheDiscountScheme.KimbleOne__DiscountPercentage__c}"/>
							</apex:pageBlockSectionItem>
														
						</apex:pageblockSection>
						
						<script>
                        	var showExpensesRevCol = {!IF(TheDeliveryElement.TheProduct.RevenueExpenseGenerated, 'true','false')};
                        	var currencyConversionFactor = {!TheDeliveryElement.CurrencyConversionFactor};
                        	var showRoles = {!IF(TheDeliveryElement.TheRoles.size > 1,'true','false')};
                        	var earliestOpenDate = '{!JSENCODE(EarliestDate)}';
							var currencyCode = '{!JSENCODE(TheDeliveryElement.TheDeliveryElement.CurrencyISOCode)}';
							var invoicingCurrencyCode = '{!JSENCODE(TheDeliveryElement.TheDeliveryElement.InvoicingCurrencyISOCode__c)}';

                        	var canModel = {!IF(TheDeliveryElement.TheOperatingActivity.AllowModelAssignment__c, 'true','false')};
                        </script>
						
						<apex:outputPanel layout="none" rendered="{!TheDeliveryElement.ShowMilestonesPanel || TheDeliveryElement.ShowAnnuitiesPanel || TheDeliveryElement.TheProduct.RevenueUsageGenerated || TheDeliveryElement.TheProduct.CostUsageGenerated}">				
                        <div class="ionTabs" id="config-tabs" data-name="config-group">
                        	<ul class="ionTabs__head">
                            	<apex:outputPanel rendered="{!TheDeliveryElement.ShowMilestonesPanel}" layout="none">
                            		<li class="ionTabs__tab milestones-tab" data-target="milestone-config"><apex:outputText value="{!$ObjectType.KimbleOne__Milestone__c.LabelPlural}"/></li>
                            	</apex:outputPanel>
                            	<apex:outputPanel rendered="{!TheDeliveryElement.ShowAnnuitiesPanel}" layout="none">
                            		<li class="ionTabs__tab annuities-tab" data-target="annuities-config"><apex:outputText value="{!$ObjectType.KimbleOne__Annuity__c.LabelPlural}"/></li>
                            	</apex:outputPanel>
                            	<apex:outputPanel rendered="{!TheDeliveryElement.TheProduct.RevenueUsageGenerated || TheDeliveryElement.TheProduct.CostUsageGenerated}" layout="none">						
	                               
                                   <li class="ionTabs__tab assignments-tab" data-target="assignment-config"><apex:outputText value="{!$Label.kimbleone__assignmentsheading}"/></li>
                                   <apex:outputPanel layout="none" rendered="{!TheDeliveryElement.TheProduct.RevenueExpenseGenerated || TheDeliveryElement.TheProduct.CostExpenseGenerated}">
                                       <li class="ionTabs__tab expenses-tab" data-target="expense-config"><apex:outputText value="{!$Label.kimbleone__expenseslabel}"/></li>
                                   </apex:outputPanel>

	                           </apex:outputPanel>
							</ul>

                            <div class="ionTabs__body" style="height:275px; overflow-y: auto;">
                                    <apex:outputPanel id="ElementAnnuitiesContainer" rendered="{!TheDeliveryElement.ShowAnnuitiesPanel}" layout="none">
                                   	<script>
                                   		var annuityBehaviourRulesMap = kimble.parseJSON("{!JSENCODE(TheDeliveryElement.TheAnnuityBehaviourRulesJson)}");
                                   	</script>
                                   	<div class="ionTabs__item" data-name="annuities-config">
                                   		<apex:variable value="{!0}" var="rowNum"/>

											<apex:pageBlockTable id="annuity-config-table" var="annuity" value="{!TheDeliveryElement.TheAnnuities}">

			                                   <apex:column >
			                                   		<span class="fa fa-trash-o inline-btn" onclick="var d = confirmDelete();if(!d) return;removeAnnuity({!ROUND(rowNum,0)})"></span>
			                                   </apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__Annuity__c.Label}">
			                                       <apex:inputField value="{!annuity.TheAnnuity.Name}" style="width:100px"/>
			                                   </apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__AnnuityBehaviourRule__c.Label}">
			                                       <apex:selectList id="annuity-behaviour-rule" value="{!annuity.TheAnnuity.KimbleOne__AnnuityBehaviourRule__c}" size="1" onchange="annuityChange('{!TEXT(ROUND(rowNum,0))}')">
				                                        <apex:selectOptions value="{!TheDeliveryElement.TheAnnuityBehaviours}"/>
				                                    </apex:selectList>
			                                   </apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__StartDate__c.Label}">
			                                       <apex:inputField id="annuity-start-date" value="{!annuity.TheAnnuity.KimbleOne__StartDate__c}" styleclass="kimbleDatePicker"  onchange="annuityStartDateChange(jQuery(this).closest('tr'));annuityChange('{!TEXT(ROUND(rowNum,0))}')"/>
			                                   </apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__NumberOfPeriods__c.Label}">
			                                       <apex:inputField id="annuity-number-of-periods" style="width:72px" value="{!annuity.TheAnnuity.KimbleOne__NumberOfPeriods__c}" onchange="annuityNumberOfPeriodsChange(jQuery(this).closest('tr'));annuityChange('{!TEXT(ROUND(rowNum,0))}')"/>
			                                   </apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__EndDate__c.Label}">
			                                       <apex:inputField id="annuity-end-date" value="{!annuity.TheAnnuity.KimbleOne__EndDate__c}" styleclass="kimbleDatePicker"  onchange="annuityEndDateChange(jQuery(this).closest('tr'));annuityChange('{!TEXT(ROUND(rowNum,0))}')"/>
			                                   </apex:column>

			                                   <apex:column rendered="{!TheDeliveryElement.TheProduct.RevenueAnnuityGenerated}">
			                                       <apex:facet name="header">
			                                       	<div>{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__InvoicingCurrencyRevenueRate__c.Label}</div>
			                                       	<div class="tiny-label">{!IF(TheDeliveryElement.TheProduct.UnitGenerated, $Label.kimbleone__perunit, '')}</div>
			                                       </apex:facet>
			                                       <apex:inputField style="width:72px" value="{!annuity.TheAnnuity.KimbleOne__InvoicingCurrencyRevenueRate__c}" onchange="annuityRevenueChange('{!TEXT(ROUND(rowNum,0))}')"/>
			                                       (<apex:outputText value="{!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c}"/>)
			                                   </apex:column>

			                                   <apex:column headervalue="{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRateRule__c.Label}" rendered="{!TheDeliveryElement.TheProduct.CostAnnuityGenerated}">
			                                       <apex:selectList id="annuity-cost-rate-rule" value="{!annuity.TheAnnuity.KimbleOne__CostRateRule__c}" size="1" onchange="annuityChange('{!TEXT(ROUND(rowNum,0))}')">
				                                        <apex:selectOptions value="{!TheDeliveryElement.TheCostRateRules}"/>
				                                    </apex:selectList>
			                                   </apex:column>

			                                    <apex:column rendered="{!TheDeliveryElement.TheProduct.CostAnnuityGenerated}">
												   <apex:facet name="header">
														<div>{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRate__c.Label} </div>
														<div class="tiny-label">{!IF(TheDeliveryElement.TheProduct.UnitGenerated, $Label.kimbleone__perunit, '')}</div>
												   </apex:facet>
												   <div id="row-num-container" data-row-num="{!TEXT(ROUND(rowNum,0))}"></div>
												   <apex:outputPanel id="annuity-cost-panel">
												   <apex:inputField style="width:72px" value="{!annuity.TheAnnuity.KimbleOne__CostRate__c}"  onchange="annuityCostChange(this)"  rendered="{!annuity.TheAnnuity.KimbleOne__CostRateRule__c = TheDeliveryElement.FixedCostRateId}"/>
												   <apex:inputField style="width:72px" value="{!annuity.TheAnnuity.KimbleOne__CostRateFactor__c}"  onchange="annuityCostChange(this)"  rendered="{!annuity.TheAnnuity.KimbleOne__CostRateRule__c = TheDeliveryElement.CostFactorId}"/>
												   (<apex:outputText value="{!TheDeliveryElement.TheDeliveryElement.CurrencyIsoCode}" rendered="{!annuity.TheAnnuity.KimbleOne__CostRateRule__c = TheDeliveryElement.FixedCostRateId}"/><apex:outputText value="%" rendered="{!annuity.TheAnnuity.KimbleOne__CostRateRule__c = TheDeliveryElement.CostFactorId}"/>)
												   </apex:outputPanel>
												</apex:column>

			                                   <apex:column headerValue="{!$ObjectType.KimbleOne__UnitType__c.LabelPlural}" rendered="{!TheDeliveryElement.TheProduct.UnitGenerated}">
			                                       <apex:selectList value="{!annuity.TheAnnuity.KimbleOne__UnitsUnitType__c}" size="1">
				                                        <apex:selectOptions value="{!TheDeliveryElement.TheAnnuityUnitTypes}"/>
				                                    </apex:selectList>
			                                   </apex:column>

			                                   <apex:column rendered="{!TheDeliveryElement.TheProduct.UnitGenerated}" headerValue="{!$Label.kimbleone__units}">
			                                       <apex:inputField style="width:42px" value="{!annuity.TheAnnuity.KimbleOne__InitialNumberOfUnits__c}" onchange="annuityChange('{!TEXT(ROUND(rowNum,0))}')"/>
			                                   </apex:column>

			                                   <apex:column rendered="{!TheDeliveryElement.TheProduct.RevenueAnnuityGenerated}" headerValue="{!$Label.kimbleone__totalrevenuelabel}">
			                                   		<apex:outputText value="{!TheDeliveryElement.TheDeliveryElement.KimbleOne__InvoicingCurrencyIsoCode__c}"/>&nbsp;
			                                   		<apex:outputText id="annuity-total-revenue" value="{!annuity.InvoicingCurrencyTotalRevenue}" styleclass="kimble-format-currency"/>
			                                   </apex:column>

			                                   <apex:column rendered="{!TheDeliveryElement.TheProduct.CostAnnuityGenerated}" headerValue="{!$Label.kimbleone__totalcostlabel}">
			                                       <apex:outputText value="{!TheDeliveryElement.TheDeliveryElement.CurrencyIsoCode}"/>&nbsp;
			                                       <apex:outputText id="annuity-total-cost" value="{!annuity.TotalCost}" styleclass="kimble-format-currency"/>
			                                   </apex:column>

			                                   <apex:column >
			                                   <apex:variable value="{!rowNum+1}" var="rowNum"/>
			                                   </apex:column>

			                                   <apex:facet name="footer"><span class="fa fa-plus-square"></span>&nbsp;<a href="javascript:addAnnuity();">{!$Label.Add}{!$ObjectType.KimbleOne__Annuity__c.Label}</a></apex:facet>

			                               </apex:pageBlockTable>
                                   	</div>
                                   	</apex:outputPanel>
                                   <apex:outputPanel rendered="{!TheDeliveryElement.ShowMilestonesPanel}" layout="none">
                                   	<div class="ionTabs__item" data-name="milestone-config">

                                   		<apex:outputPanel id="ElementRecurringMilestonesContainer" rendered="{!TheDeliveryElement.RevenueForecastMode = 'Recurring' || TheDeliveryElement.CostForecastMode = 'Recurring'}">
											<apex:pageblockSection collapsible="false" showheader="false" columns="2">
                            					<apex:pageBlockSectionItem >
			                            			<apex:outputText value="{!$Label.kimbleone__recurringmilestonestartdate}"/>
                                  					<apex:inputField value="{!TheDeliveryElement.RecurringMilestoneStartDate.KimbleOne__InputDate__c}" styleclass="kimbleDatePicker"/>
                                  				</apex:pageBlockSectionItem>

                                  				<apex:pageBlockSectionItem >
			                            			<apex:outputText value="{!$Label.kimbleone__recurringmilestoneperiods}"/>
                                  					<apex:inputField id="recurring-periods" value="{!TheDeliveryElement.RecurringMilestonePeriods.KimbleOne__InputInteger__c}" onchange="calculateRecurringMilestoneRevenueAndCosts();"/>
                                  				</apex:pageBlockSectionItem>

		                                		<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.CostMilestoneGenerated}">
			                            			<apex:outputPanel layout="none">
			                            				<apex:outputText value="{!$Label.kimbleone__costlabel}" />
			                            				<apex:outputText value=" {!$Label.kimbleone__perunit}" rendered="{!TheDeliveryElement.TheProduct.UnitGenerated}" />
			                            				<apex:outputText value=" ({!TheDeliveryElement.TheDeliveryElement.KimbleOne__SupplierInvoicingCurrencyIsoCode__c})"/>
			                            			</apex:outputPanel>
                                  					<apex:inputField id="recurring-cost" value="{!TheDeliveryElement.RecurringMilestoneSupplierInvoicingValue.KimbleOne__InputDecimal__c}"  onchange="calculateRecurringMilestoneRevenueAndCosts();"/>
                                  				</apex:pageBlockSectionItem>

                                  				<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.TheProduct.RevenueMilestoneGenerated}">
			                            			<apex:outputPanel layout="none">
			                            				<apex:outputText value="{!$Label.kimbleone__revenuelabel}" />
