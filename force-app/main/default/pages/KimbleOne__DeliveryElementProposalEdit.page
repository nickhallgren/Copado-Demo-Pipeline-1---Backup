        		var expectedRev = kimble.parseNumber(expectedRevenue) / currencyConversionFactor;

        		if (modeConfig.mode == 'TargetMargin' && jQuery('[id$="element-target-margin"]').val() != '' && expectedRev != 0) //defaults revenue rate and calcs totalUsage
	        	{
