        function calculateAssignmentTotalCost(assignment, usagePattern, convFactor)
        {
        	var costRates = [];

        	if (assignment.CostSummary != null && assignment.CostSummary.length > 0)
        	{
        		costRates = assignment.CostSummary;
        	}
        	else
        	{
        		if (assignment.CostRateBasis == null || assignment.CostRateBasis.length == 0) return;

        		var combinedDates = {};

				assignment.CostExchangeRate.forEach(function(rate) {
					var dte = rate.D;
					if (dte.toDate() < assignment.StartDate.toDate()) dte = assignment.StartDate;

					combinedDates[dte] = {};
				})

				assignment.CostRateBasis.forEach(function(rate) {
					var dte = rate.D;
					if (dte.toDate() < assignment.StartDate.toDate()) dte = assignment.StartDate;

					combinedDates[dte] = {};
				})

				Object.keys(combinedDates).sort(function(a, b) {return a.toDate() > b.toDate()}).forEach(function(d){

				  var matchingExRates = assignment.CostExchangeRate.filter(function(x){return x.D.toDate() <= d.toDate()});
				  var matchingBasisRates = assignment.CostRateBasis.filter(function(x){return x.D.toDate() <= d.toDate()});

				  costRates.push({D:d, R:matchingExRates[matchingExRates.length-1].R * matchingBasisRates[matchingBasisRates.length-1].R * costRateForecastFactor});
				})
			}

        	var totalCost = 0;

            for (var i=0; i<costRates.length; i++)
			{
				var rate = costRates[i];
				var fromDate = rate.D.toDate()
				var toDate;

				if (costRates.length > i + 1)
					toDate = costRates[i+1].D.toDate().kimbleAddDays(-1);
				else
					toDate = assignment.EndDate.toDate();

				var remainingUsage = usagePattern.getUsageInHoursForDateRange(fromDate, toDate);

				totalCost += remainingUsage / convFactor * rate.R;
			}

        	return totalCost;
        }

