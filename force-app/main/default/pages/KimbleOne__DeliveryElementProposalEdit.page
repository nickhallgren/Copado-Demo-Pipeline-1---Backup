		function dockInsight(event)
		{
			var headerLabel = '';
			var insightContainerSelector = '';

			var insightHeaderHtml = '';
			var insightBodyHtml = '';

			if(jQuery(this).parent('div.expense-cat-average').length)
			{
				headerLabel = expCatInsightHeaderLabel;
				insightContainerSelector = '.expense-cat-average';
				insightBodyHtml += generateExpenseCategoryAverageInsightTipHtml();
			}
			if(jQuery(this).parent('div.resource-type-margin').length)
			{
				headerLabel = resourceTypeMarginInsightHeaderLabel;
				insightContainerSelector = '.resource-type-margin';
				insightBodyHtml += generateResourceTypeAverageMarginInsightTipHtml();
			}

			insightHeaderHtml = '<div class="insight-header">' + headerLabel + '</div><div class="collapse-docked-insight"><span class="cardIconInfo fa fa-lightbulb-o"></span><span class="cardIconInfo fa fa-angle-double-right"></span></div>';

			jQuery(this).hide();
			jQuery(this).closest('div.insight-container' + insightContainerSelector).removeClass('insight-collapsed');
			jQuery(this).closest('div.insight-container' + insightContainerSelector).find('.docked-insight').html(insightHeaderHtml + insightBodyHtml);
			jQuery(this).closest('div.insight-container' + insightContainerSelector).find('.docked-insight').show('fade');
