			if(expenseInsight != undefined && expenseInsight.OrderedExpenseCategoryIds != undefined && expenseInsight.OrderedExpenseCategoryIds.length && expenseInsight.TheExpenseCategoryAverageInsightMap[expenseCategoryId] != undefined && (forceUpdate || obj.parent('td').find('[id$="expense-net-amount"]').val() == ''))
			{
