                if (showExpensesRevCol)
                	totalExpenseRev += kimble.parseNumber($row.find('[id$="expense-remaining-revenue"]').val());

                $row.find('[id$="expense-remaining-cost"]').prop('readonly', true);
            });

            var summaryRow = '<tr class="summary-cell summary-row dataRow"><td colspan="6">' + addExpenseHtml + '</td><td class="kimble-number">' + kimble.formatNumber(totalExpenseCost, '#,##0.00') + '</td>';

