       	function calculateMilestoneRevenuesAndCosts()
       	{

       		var totalMilestoneCost = 0;
            var totalMilestoneRev = 0;

            var milestonesConfigTable = jQuery('[id$="milestone-config-table"]');

            if (milestonesConfigTable.length == 0) return;

            var hasCost = false;
            var hasRev = false;

            jQuery.each(milestonesConfigTable.find('tbody>tr'), function (i, row) {

                var $row = jQuery(row);

            	if ($row.find('[milestone-type="Cost"]').length == 1)
            	{
            		if ($row.find('[id$="milestone-units"]').length == 1)
            		{
            			totalMilestoneCost += (kimble.parseNumber($row.find('[milestone-type="Cost"] input').val()) * kimble.parseNumber($row.find('[id$="milestone-units"]').val()));
            		}
            		else
            		{
            			totalMilestoneCost += kimble.parseNumber($row.find('[milestone-type="Cost"] input').val());
            		}
            		hasCost = true;
            	}
            	else
            	{
            		if ($row.find('[id$="milestone-units"]').length == 1)
            		{
            			totalMilestoneRev += (kimble.parseNumber($row.find('[milestone-type="Revenue"] input').val()) * kimble.parseNumber($row.find('[id$="milestone-units"]').val()));
            		}
            		else
            		{
            			totalMilestoneRev += kimble.parseNumber($row.find('[milestone-type="Revenue"] input').val());
            		}
            		hasRev = true;
            	}
            });

            if(hasCost) jQuery('[id$="element-services-cost"]').val(kimble.formatNumber(totalMilestoneCost, '#,##0.00'));
            if(hasRev) jQuery('[id$="element-generated-revenue"]').val(kimble.formatNumber(totalMilestoneRev, '#,##0.00'));
       	}

