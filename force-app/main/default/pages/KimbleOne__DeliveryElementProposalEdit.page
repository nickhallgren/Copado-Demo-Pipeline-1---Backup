       	function calculateContactCostFromRates()
       	{
       		//update contract cost by multiplying the Source Cost by the inputted rate
       		//element-cost = rate * expected-element-cost
       		var ratesTable = jQuery('#element-rates-table');

       		if (ratesTable.length == 0) return;

       		var contractCost = 0;
       		var overriddenContractCost = 0;
       		var rateOverride = false;

       		jQuery.each(ratesTable.find('tbody>tr'), function (i, row) {

       			var $row = jQuery(row);
       			//multiply two inputs together
       			var rate;
       			var standardRate;

       			if ($row.find('input:checked').length == 0)
       			{
       				$row.find('.override-rates').hide();
       				//$row.find('.standard-rates').show();
       				rate = kimble.parseNumber($row.find('.standard-rates>input').val());
       				rateOverride = false;
       				jQuery('.cost-override').hide();
       			}
       			else
       			{
       				//$row.find('.standard-rates').hide();
       				$row.find('.override-rates').show();
       				rate = kimble.parseNumber($row.find('.override-rates>input').val());
       				standardRate = kimble.parseNumber($row.find('.standard-rates>input').val());
       				rateOverride = true;
       				jQuery('.cost-override').show();
       			}

       			var val = kimble.parseNumber($row.find('.source-value').val());

       			contractCost += (rate * val);

       			if(rateOverride)
       			{
       				overriddenContractCost += (standardRate * val);
       			}

       		});

       		jQuery('#element-services-cost').val(kimble.formatNumber(contractCost, '#,##0.00'));

       		if(rateOverride)
       		{
       			jQuery('#element-services-cost-overriden').val(kimble.formatNumber(overriddenContractCost, '#,##0.00'))
       		}
       	}

       	function calculateRecurringMilestoneRevenueAndCosts()
       	{
       		var totalMilestoneCost = kimble.parseNumber(jQuery('[id$="recurring-periods"]').val()) * kimble.parseNumber(jQuery('[id$="recurring-cost"]').val());
       		var totalMilestoneRev = kimble.parseNumber(jQuery('[id$="recurring-periods"]').val()) * kimble.parseNumber(jQuery('[id$="recurring-revenue"]').val());

       		if(jQuery('[id$="recurring-units"]').length > 0)
       		{
       			totalMilestoneCost = totalMilestoneCost * kimble.parseNumber(jQuery('[id$="recurring-units"]').val());
       			totalMilestoneRev = totalMilestoneRev * kimble.parseNumber(jQuery('[id$="recurring-units"]').val());
       		}

       		if (jQuery('[id$="recurring-cost"]').length == 1)
            	jQuery('[id$="element-services-cost"]').val(kimble.formatNumber(totalMilestoneCost, '#,##0.00'));

            if (jQuery('[id$="recurring-revenue"]').length == 1)
            	jQuery('[id$="element-generated-revenue"]').val(kimble.formatNumber(totalMilestoneRev, '#,##0.00'));
