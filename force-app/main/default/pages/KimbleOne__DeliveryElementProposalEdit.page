       	<script>

		var allowAssignmentToMilestoneLink = {!AllowAssignmentToMilestoneLink};

		var pageLabels = {};
		pageLabels['NewCostEffectiveFromMessage'] = '{!JSENCODE($Label.NewCostEffectiveFromMessage)}';

       	function initialiseProposalElementEdit()
       	{
       		jQuery(document).off('mouseover','.default-revenue-rate');
       		jQuery(document).on('mouseover', '.default-revenue-rate', function(event) {
       		    var j = jQuery(this);

			 	var tipHtml = '';
			 	var $row = j.closest('tr');

			 	var usageConversionFactor = 1;

                var hrsPerDay = $row.find('[id$="assignment-panel"]').attr('hours-per-day');
               	if(forecastUnitType != invoiceUnitType)
               	{
               		//Day -> Hour
               		if (forecastUnitType == 'Day')
               			usageConversionFactor = hrsPerDay;
               		else //Hour -> Day
               			usageConversionFactor = 1/hrsPerDay;
               	}

                var rate = $row.find('[id$="assignment-default-revenue-rate"]').val();

                var formattedMesage = $row.find('[id$="assignment-panel"]').attr('inv-ccy') + ' ' + (kimble.formatNumber(rate / usageConversionFactor, '#,##0.00'));

                tipHtml += '<div class="default-revenue-message">' + formattedMesage + '</div>';

			 	//tooltips
	            j.qtip('destroy', true);

			 	j.qtip({
		            overwrite: true,
					show: {
		                solo:true,
		                ready: true // Show immediately - important!
		            },
					style: {
						classes: 'qtip-light qtip-shadow'
			        },
					content: {
						text: tipHtml,
						title: '{!$ObjectType.Resource__c.Fields.StandardRevenue__c.Label}'
					},
			        position: {
					   	my: 'top left',
						at: 'bottom right',
					   	target: jQuery(this)
					}
		        });
            });

			jQuery(document).on('click','.assignment-cost-rate-effective-date-container', function(e) {
				jQuery(this).closest('td').find('[id$="assignment-cost-rate-effective-date"]').trigger('focus');
   			});

       		jQuery(document).on('mouseover', '.future-cost-change', function (event) {
			 	var j = jQuery(this);

			 	var costs = JSON.parse(j.closest('td').find('[id$="assignment-cost-summary"]').val());
			 	var tipHtml = '';
			 	var $row = j.closest('tr');

			 	var usageConversionFactor = 1;

                var hrsPerDay = $row.find('[id$="assignment-panel"]').attr('hours-per-day');
               	if(forecastUnitType != invoiceUnitType)
               	{
               		//Day -> Hour
               		if (forecastUnitType == 'Day')
               			usageConversionFactor = hrsPerDay;
               		else //Hour -> Day
               			usageConversionFactor = 1/hrsPerDay;
               	}

			 	for(var i=0; i<costs.length;i++)
				{
					var formattedMesage = pageLabels['NewCostEffectiveFromMessage'].format(kimble.formatNumber(costs[i].R / usageConversionFactor, '#,##0.00'), kimble.formatDate(costs[i].D));
					tipHtml += '<div class="cost-change-message">' + formattedMesage + '</div>';
				}

            	//tooltips
	            j.qtip('destroy', true);

			 	j.qtip({
		            overwrite: true,
					show: {
		                solo:true,
		                ready: true // Show immediately - important!
		            },
					style: {
						classes: 'qtip-light qtip-shadow'
			        },
					content: {
						text: tipHtml,
						title: 'Costs'
					},
			        position: {
					   	my: 'top left',
						at: 'bottom right',
					   	target: jQuery(this)
					}
		        });
		       });

       		kimble.formatCurrencies();

       		if (jQuery('#config-tabs').length > 0)
       		{
       			jQuery.ionTabs('#config-tabs', {type: 'none'});

                if (jQuery('.ionTabs__tab_state_active').length == 0)
                {
                	if (jQuery('.expenses-tab').length != 0) jQuery.ionTabs.setTab("config-group", "expense-config");

                	if (jQuery('.assignments-tab').length != 0) jQuery.ionTabs.setTab("config-group", "assignment-config");

                	if (jQuery('.milestones-tab').length != 0) jQuery.ionTabs.setTab("config-group", "milestone-config");

                	if (jQuery('.annuities-tab').length != 0) jQuery.ionTabs.setTab("config-group", "annuities-config");
                }
                else if(jQuery('.assignments-tab.ionTabs__tab_state_active').length)
                {
                	initialiseResourceTypeAverageMarginInsights();
                }
                else if(jQuery('.expenses-tab.ionTabs__tab_state_active').length)
                {
                	initialiseExpenseCategoryAverageInsights();
                }
            }

       		jQuery('.usage-forecast-mode-switch-container').each(function() {
				jQuery(this).qtip({
					content:{
						text:jQuery(this).children('.tool-tip-content'),
						title:jQuery(this).children('.tool-tip-content').children('.tool-tip-content-container').attr('title'),
						button: 'Close'
					},
					position: {
			            adjust: {
			                method: 'flip flip'
			            },
			            viewport: $(window)
			        },
			        show: {
      					event: 'click',
      					solo: true
   					},
   					hide: false,
					style: {classes: 'qtip-light qtip-shadow qtip-rounded'}})
			});

       		applyUsageMode(jQuery('[id$="element-usage-mode"]').val());

       		calculateAllRevenuesCosts();

       		jQuery('.kimbleDatePicker:not(.hasDatepicker)').datepicker({
                    dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
                    minDate: earliestOpenDate.toDate(),
                    showOtherMonths: true,
                    selectOtherMonths: true});

       		jQuery(document).on('change','[id$="element-expected-revenue"]', function(event) {
       			var j = jQuery(this);
       			j.val(kimble.formatNumber(kimble.parseNumber(j.val()), '#,##0.00'));

       		});

       		jQuery(document).on('change', '.revenue-rate-input', function (event) {

				var $row = jQuery(this).closest('tr');

				var hrsPerDay = $row.find('[id$="assignment-panel"]').attr('hours-per-day');
				var revConversionFactor;

               	$row.find('[id$="assignment-revenue-rate"]').val(kimble.parseNumber(jQuery(this).val()) * convertRate(revenueUnitTypeEnum, forecastUnitType, hrsPerDay));

				calculateAssignmentRevenuesAndCosts()
			});

			jQuery(document).on('change', '.cost-rate-input', function (event) {

				var $row = jQuery(this).closest('tr');

				if($row.length == 0) return;

				var usageConversionFactor = 1;
				var hrsPerDay = $row.find('[id$="assignment-panel"]').attr('hours-per-day');
				if(forecastUnitType != invoiceUnitType)
				{
					//Day -> Hour
					if (forecastUnitType == 'Day')
						usageConversionFactor = hrsPerDay;
					else //Hour -> Day
						usageConversionFactor = 1/hrsPerDay;
				}

				var newCostSummary = [];
				var latestAdded = false;

				var isNewAssignment = $row.find('[id$="assignment-cost-summary"]').data('isNew');

				if (isNewAssignment) {
				    newCostSummary = $row.find('[id$="assignment-cost-summary"]').data('origValue');
				    newCostSummary[0].R = kimble.parseNumber(jQuery(this).val()) * usageConversionFactor;
    			}
    			else {


					var latestCost = {D:kimble.parseDate($row.find('[id$="assignment-cost-rate-effective-date"]').val()), R:kimble.parseNumber(jQuery(this).val()) * usageConversionFactor};

					$row.find('[id$="assignment-cost-summary"]').data('origValue').forEach(function(cost) {
						if (!latestAdded) {
							if (cost.D.toDate().valueOf() < latestCost.D.toDate().valueOf()) {
								newCostSummary.push(cost);
							}
							else {
								latestAdded = true;
								newCostSummary.push(latestCost);
							}
						}
					});

					if (!latestAdded) newCostSummary.push(latestCost);
				}

				$row.find('[id$="assignment-cost-summary"]').val(JSON.stringify(newCostSummary));

				var costRateSummary = newCostSummary;
				$row.find('[id$="assignment-cost-summary"]').val(JSON.stringify(costRateSummary));
				$row.find('[id$="assignment-cost-rate"]').val(kimble.parseNumber(jQuery(this).val()) * usageConversionFactor);

				if (!isNewAssignment) {
					$row.find('.assignment-cost-rate-effective-date-container').show();
					$row.find('[id$="assignment-cost-rate-effective-date"]').trigger('focus');
				}

				calculateAssignmentRevenuesAndCosts()
			});

            jQuery(document).off('change', '.discount-pct-input');
       		jQuery(document).on('change', '.discount-pct-input', function (event) {

				var $row = jQuery(this).closest('tr');

                //need to set revenue-rate-input - then call .change()
                var defaultRate = $row.find('[id$="assignment-default-revenue-rate"]').val(); //in revenue entry units

                $row.find('[id$="assignment-revenue-rate"]').val(defaultRate - (kimble.parseNumber(jQuery(this).val())/100 * defaultRate));

				calculateAssignmentRevenuesAndCosts()
			});

			jQuery(document).on('click', '.ionTabs__tab.assignments-tab', function (event) {
				initialiseResourceTypeAverageMarginInsights();
			});

			jQuery(document).on('click', '.ionTabs__tab.expenses-tab', function (event) {
				initialiseExpenseCategoryAverageInsights();
			});

			jQuery(document).on('click', '.ionTabs__tab:not(.expenses-tab)', function (event) {
				jQuery('.insight-container.expense-cat-average').addClass('insight-hidden');
			});

			jQuery(document).on('click', '.ionTabs__tab:not(.assignments-tab)', function (event) {
				jQuery('.insight-container.resource-type-margin').addClass('insight-hidden');
			});

			if(allowAssignmentToMilestoneLink)
			{
				jQuery(document).off('click', '.assignment-milestone-btn').on('click', '.assignment-milestone-btn', showMilestoneLinks);
				jQuery(document).off('click', '.assignment-milestone-cancel').on('click', '.assignment-milestone-cancel', hideMilestoneLinks);
				jQuery(document).off('click', '.milestone-option').on('click', '.milestone-option', linkMilestone);
			}
			refreshExpenseCostInsights();

			disableAppliedModelRows();

			//resize containers
			jQuery('.ionTabs__body').height(jQuery('#editProposalElementPopup').height() - 113 - jQuery('[id$="headerFields"]').height());

			jQuery('#loadingIndicatorOuterContainer').parent().hide();
       	}

		function convertRate(fromUnitType, toUnitType, hoursPerDay) {

		if (fromUnitType == toUnitType) return 1;

		if (fromUnitType == 'Month' || toUnitType == 'Month') {

			//This must be a decimal so that division below works
			if (toUnitType == 'Month') {
				if (fromUnitType == 'Day')
					return averageDaysPerMonth;
				else
				    return hoursPerDay * averageDaysPerMonth;
			}

			if (fromUnitType == 'Month') {
				if (toUnitType == 'Day')
					return 1 / averageDaysPerMonth;
				else
					return 1 / averageDaysPerMonth / hoursPerDay;
			}
		}

		//Day to hour
		if (toUnitType == 'Hour') return 1 / hoursPerDay;

		//convert Hour to day
		return hoursPerDay;
	}

       	function toggleUsageForecastMode(obj, newMode)
       	{
       		if (jQuery(obj).parent().hasClass('selected')) return;

       		jQuery('#usage-forecast-mode').find('.selected').removeClass('selected');
       		jQuery(obj).parent().addClass('selected');
       		jQuery('#usage-forecast-mode').attr('selected-mode',newMode);

       		jQuery('[id$="element-usage-mode"]').val(newMode);

       		applyUsageMode(newMode);

       		calculateAssignmentRevenuesAndCosts();

			disableAppliedModelRows();

			validateTargetMargin(jQuery('[id$="element-target-margin"]').val());
       	}

       	function applyUsageMode(newMode)
       	{
       		if (newMode == 'UsageItem')
       		{
       			if (hasRealRevenue) jQuery('[id$="element-expected-revenue"]').closest('tr').hide();
       			jQuery('[id$="element-target-margin"]').prop('readonly', true);
       			jQuery('[id$="element-expected-usage"]').prop('readonly', true);
       		}
       		else
       		{
       			jQuery('[id$="element-expected-revenue"]').closest('tr').show();

       			jQuery('[id$="element-expected-revenue"]').prop('readonly', newMode == 'DerivedRevenue' || newMode == 'UsageDerivedRevenue');
       			jQuery('[id$="element-target-margin"]').prop('readonly', newMode == 'ExpectedUsage');
       			jQuery('[id$="element-expected-usage"]').prop('readonly', newMode == 'TargetMargin' || newMode == 'UsageDerivedRevenue');
       		}
       	}

       	function cancelUsageForecastModePopup()
		{
			jQuery('.usage-forecast-mode-switch-container').qtip("hide");
		}

       	function saveProposalElementComplete()
       	{
       		if(hideStackedModalBoxyWithErrorCheck('#ProposalElementsErrorPanel'))
       			jQuery.publish('kimble.proposalElementUpdated');
       		else
       			initialiseProposalElementEdit();
       	}

       	function calculateAllRevenuesCosts()
       	{
       		calculateRecurringMilestoneRevenueAndCosts();

