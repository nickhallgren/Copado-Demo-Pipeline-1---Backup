                }

                var expenseCategoryId = $row.find('[id$="expense-category-id"]').val()
                var units = kimble.parseNumber($row.find('[id$="expense-units"]').val());
                var netAmount = kimble.parseNumber($row.find('[id$="expense-net-amount"]').val());

                var costPerUnit = netAmount;
                var revPerUnit = netAmount;

                $row.find('[id$="expense-remaining-cost"]').val(kimble.formatNumber(costPerUnit * units, '#,##0.00'));

                totalExpenseCost += kimble.parseNumber($row.find('[id$="expense-remaining-cost"]').val());

