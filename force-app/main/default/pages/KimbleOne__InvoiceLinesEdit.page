 		function updateJson()
 		{
 			jQuery('#invoice-error').hide();
 			
 			var theSections = new Array();
 			
 			var lineNumber = 1;
 			var lineError = false;
 			var sectionError = false;
 			
 			jQuery.each($('.invoiceSection:visible'), function (i, section) {
 				
 				var theSection = $(section);
 				var theSectionJson = $(section).data('jsonSection');
 				theSectionJson.InvoiceLines = new Array();
 				
 				var hasItems = false;
 				
 				jQuery.each(theSection.find('.invoiceLine:visible'), function (j, line){
	 				
	 				var lineJson = $(line).data('jsonLine');
	 				theSectionJson.InvoiceLines[j] = lineJson;
	 				
	 				if(lineJson.InvoiceLineItems.length > 0)
	 				{ 
	 					if( lineJson.Narrative == '')
	 						lineError = true; 
	 					else
	 					{	
	 						lineNumber ++;
	 						hasItems = true;
	 					}
	 				}
	 			});
 				
 				if (hasItems && theSectionJson.Name == '')
 					sectionError = true; 					
 				
 				theSections[i] = theSectionJson;
 			});
 			
 			var error = '';
 			
 			if(lineError)
 			{
 				error = 'Invoice line narrative is required.';
 			}
 			else if(sectionError)
 			{
 				error = 'Section name is required.';
 			}
 			
 			if (error != '')
 			{
 				jQuery('#invoice-error').show();
       			jQuery('#invoice-error-text').text(error);
 				return false; 			
 			}
 			
 			$('.JsonSectionsAndLines').val(JSON.stringify(theSections));
 			
 			return true;
 		}
 		
 		function newSection()
 		{
 			$('.invoiceSection:hidden:first').show();
 		}
 		
 		function newSectionLine()
 		{
 			$('.invoiceSection-selected').parent().find('.invoiceLine:hidden:first').show();
 		}
 		
 		
 function findAndRemove(array, property, value) {
   $.each(array, function(index, result) {
      if(result != undefined && result[property] == value) {
      {
          //Remove from array
          array.splice(index, 1);
          return;
      }
      }    
   });
}

