		var lineItemHtml = '<li class="lineItem"><div class="name"></div><div class="date"></div><div class="amount"></div></li>';
		//var newJson = '{"NetAmount":0,"Narrative":"","InvoiceLineItems":[],"Id":"new"}';
		var newSectionJson = '{"Name":"","InvoiceLines":[],"Id":"new"}';
		var newLineJson = '{"NetAmount":0,"Narrative":"","InvoiceLineItems":[],"Id":"new"}';
		
		$(document).ready(function(){
		
			jQuery('.saveAction').click(function(e) {
            	if (updateJson()) return true;
            	
