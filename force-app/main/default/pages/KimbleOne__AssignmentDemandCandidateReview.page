                function getDemandTableCapabilitiesHtml(d)
                {
                    var html = '';

                    var lbl = '{!$ObjectType.RequiredCapability__c.LabelPlural}';

                    html += '<tr class="cap-hdr">';
                    html += '<td><div>' + lbl + '</div></td>'; //row headings
                    html += '<td></td>';

                    d.OrderedCandidateIds.forEach(function(k)
                    {
                        html += '<td></td>';
                    });
                    d.OrderedNegativeCandidateIds.forEach(function(k)
                    {
                        html += '<td></td>';
                    });

                    html += '</tr>';

                    d.OrderedCapabilityIds.forEach(function(ck)
                    {
                        var cap = d.Capabilities[ck];

                        var ratingVal = (cap.RatingType == 'NumericRating' ? (cap.MinimumNumericRating != null ? cap.MinimumNumericRating : 0) : 1);
                        var ratingValDisp = (cap.RatingType == 'NumericRating' ? (cap.MinimumNumericRatingText != undefined && cap.MinimumNumericRatingText != null ? cap.MinimumNumericRatingText : (cap.MinimumNumericRating != null ? cap.MinimumNumericRating : '')) : '<i class="fa fa-check"></i>');

                        html += '<tr class="cap-det' + (cap.IsMandatory ? ' mand-cap' : '') + '">';
                        html += '<td><div class="cap-n">' + cap.TypeName + (cap.IsMandatory ? '<i class="fa fa-asterisk"></i>' : '') + '</div></td>'; //row headings
                        html += '<td><div class="cap-r">' + ratingValDisp + '</div></td>';

                        d.OrderedCandidateIds.forEach(function(k)
                        {
                            var c = d.CandidateMap[k];
                            var cRatingValDisp = '';
                            if(ck in c.ResCaps)
                            {
                                var cCap = c.ResCaps[ck];
                                var cRatingVal = (cCap.RatingType == 'NumericRating' ? (cCap.NumericRating != null ? cCap.NumericRating : 0) : 1);
                                cRatingValDisp = (cCap.RatingType == 'NumericRating' ? (cCap.NumericRatingCode != undefined && cCap.NumericRatingCode != null ? cCap.NumericRatingCode : (cCap.NumericRating != null ? cCap.NumericRating : '')) : '<i class="fa fa-check"></i>');
                                var matchInd = (ratingVal == cRatingVal ? '<i class="fa fa-check-square meets-cap-ind"></i>' : (ratingVal < cRatingVal ? '<i class="fa fa-arrow-circle-up exceeds-cap-ind pos-ind"></i>' : (ratingVal > cRatingVal ? '<i class="fa fa-arrow-circle-down below-cap-ind rev-ind"></i>' : '')));

                                var expInd = '';
                                if(cCap.ExpDteUTC != undefined
                                    && cCap.ExpDteUTC != null)
                                {
                                    var expiryDateAsDate = kimble.parseDate(kimble.formatDate(cCap.ExpDteUTC), true);
                                    var expiryDateWithoutTime = new Date(expiryDateAsDate.getFullYear(), expiryDateAsDate.getMonth(), expiryDateAsDate.getDate(), 0, 0, 0, 0);

                                    var expiryClass = '';
                                    if(expiryDateWithoutTime < new Date()) expiryClass = ' expired';
                                    expInd += '<i expiry-date="' + cCap.ExpDteUTC + '" class="expiry-cap-ind rev-ind fa fa-exclamation-circle' + expiryClass + '"></i>'
                                }

                                html += '<td class="cap-held"><div class="c-cap-r">' + cRatingValDisp + matchInd + expInd + '</div></td>';
                            }
                            else
                            {
                                cRatingVal = (cap.IsMandatory ? '<i class="fa fa-exclamation-triangle mand-cap-missing"></i>' : '') + '<i class="fa fa-times"></i>';
                                html += '<td class="cap-missing"><div class="c-cap-r">' + cRatingVal + '</div></td>';
                            }
                        });

                        d.OrderedNegativeCandidateIds.forEach(function(k)
                        {
                            html += '<td class="no-dets"></td>';
                        });

                        html += '</tr>';
                    });

                    return html;
                }

