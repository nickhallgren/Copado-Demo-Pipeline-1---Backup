                function populateDemand()
                {
                    jQuery('#demand-hdr-container').html(getDemandDetailsHeaderHtml(theDemand));
                    jQuery('#demand-rej-reasons-container').html(getDemandRejReasonsHtml(theDemand));
                    jQuery('#demand-dets-container').html(getDemandDetailsHtml(theDemand));

                    initialiseDynamicElements_Demand();

                    hideWorking_Demand()
                    hideSaving_Demand()
                    showModalBoxy();
                }

                function getDemandDetails()
                {
                    showWorking_Demand();

                    Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.AssignmentDemandCandidateReviewCntrllr.GetDemandDetails}',
                        dId,
                            function(result, event){
                                if (event.status)
                                {
                                    theDemand = result;
                                    populateDemand();
                                    //resetHasChanges();
                                }
                                else
                                {
                                    alert(event.message);
                                }

                                hideWorking_Demand();
                        },
                     {escape: false, timeout: 60000});
                }
            </script>
