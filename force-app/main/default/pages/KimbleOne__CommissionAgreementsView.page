<apex:page controller="KimbleOne.CommissionAgreementsPrintController" sidebar="false"  showHeader="{!IF($CurrentPage.parameters.type=='print',false,true)}" contentType="{!IF($CurrentPage.parameters.type=='print','application/vnd.ms-excel#Scheme_'+$CurrentPage.parameters.id+'.xls','')}">
 
 
<apex:composition template="KimbleOne__SiteMaster">
	 
	<apex:define name="Menu" >
		<apex:outputPanel layout="none" style="{!IF($CurrentPage.parameters.type=='print','display: none','')}">
 	   		<c:Menu rendered="{!CommissionScheme.Id!=null}" DefaultHelpPage="SalesMarketing.html" MenuContextType="CommissionScheme" MenuContextId="{!CommissionScheme.Id}" MenuContextName="{!CommissionScheme.Name}"/>
 	   </apex:outputPanel>
    </apex:define>
	<apex:define name="Content">
						<style>
						.HeaderRightAligned
						{
						text-align:right
						}
					</style>
		
		<apex:pageBlock id="CommissionAgreements" title="">
			<apex:variable var="PreviousScheme" value=""/>
			<apex:variable var="PreviousName" value=""/>
			<apex:variable var="PreviousSalesOpp" value=""/>
			<apex:variable var="PreviousAccount" value=""/>
			<apex:variable var="PreviousTarget" value=""/>
			
			
			<apex:pageBlockTable value="{!CommissionsToPrint}" var="comAg" >
								<apex:facet name="header">
						 	<apex:outputLink value="{!$Page.KimbleOne__CommissionAgreementsPrint}?Id={!$CurrentPage.parameters.id}">{!$Label.kimbleone__converttoexcellabel}</apex:outputLink>
					</apex:facet>
					<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionScheme__c.Label}" style="vertical-align:text-top;">
							<apex:outputText value="{!IF(PreviousScheme!=comAg.CommissionAgreement.KimbleOne__CommissionScheme__c,comAg.CommissionAgreement.CommissionScheme__r.Name,'')}"/>
		                	<apex:variable var="PreviousScheme" value="{!comAg.CommissionAgreement.KimbleOne__CommissionScheme__c}"/>
					</apex:column>
					
					<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionAgreement__c.Fields.KimbleOne__User__c.Label}" style="vertical-align:text-top;">
				 			<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c,comAg.CommissionAgreement.User__r.Name,'')}"/>
				 	</apex:column>

					<apex:column headerValue="{!$ObjectType.KimbleOne__ResourceType__c.Label}" style="vertical-align:text-top;">
				 			<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c, comAg.ResourceType,'')}"/>
				 	</apex:column>

					<apex:column headerValue="{!$ObjectType.KimbleOne__BusinessUnit__c.Label}" style="vertical-align:text-top;">
				 			<apex:outputText value="{!IF(PreviousName != comAg.CommissionAgreement.KimbleOne__User__c, comAg.ResourceBusinessUnit,'')}"/>
				 	</apex:column>

					<apex:column headerValue="{!$Label.kimbleone__alternativecommissionschemebasis}" style="vertical-align:text-top;">
				 		<apex:outputLink value="{!$Page.KimbleOne__CommissionAgreementsSales}?id={!comAg.CommissionAgreement.SalesOpportunity__r.Id}"
				 			rendered="{!PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousSalesOpp!=comAg.CommissionAgreement.KimbleOne__SalesOpportunity__c}">
							{!comAg.CommissionAgreement.SalesOpportunity__r.Name}
						</apex:outputLink>
							<apex:variable var="PreviousSalesOpp" value="{!comAg.CommissionAgreement.KimbleOne__SalesOpportunity__c}"/>
				 			<apex:variable var="PreviousTarget" value="{!comAg.CommissionAgreement.KimbleOne__PerformanceAnalysis__c}"/>
				 			<apex:variable var="PreviousAccount" value="{!comAg.CommissionAgreement.KimbleOne__Account__c}"/>
							<apex:outputText value="{!IF(PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousTarget!=comAg.CommissionAgreement.KimbleOne__PerformanceAnalysis__c,comAg.CommissionAgreement.PerformanceAnalysis__r.Name,'')}"/>		
				 			<apex:outputText value="{!IF(PreviousName!= comAg.CommissionAgreement.KimbleOne__User__c || PreviousAccount!=comAg.CommissionAgreement.KimbleOne__Account__c,comAg.CommissionAgreement.Account__r.Name,'')}"/>		
				 		 	<apex:variable var="PreviousName" value="{!comAg.CommissionAgreement.KimbleOne__User__c}"/>
				 	</apex:column>
				 	
				 	<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionAgreement__c.Fields.KimbleOne__StartDate__c.Label}" style="vertical-align:text-top;"
						value="{!comAg.CommissionAgreement.KimbleOne__StartDate__c}"/>
					<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionAgreement__c.Fields.KimbleOne__EndDate__c.Label}" style="vertical-align:text-top;"
						value="{!comAg.CommissionAgreement.KimbleOne__EndDate__c}"/>
						
					
				 				 
				 	
				 	<apex:column >
				 <apex:pageBlockTable value="{!comAg.CommissionInvoiceItems}" var="comInv">

					<apex:column headerValue="{!$ObjectType.Account.Label}" >
							<apex:outputText value="{!comInv.InvoiceAccount}"/>
	      			</apex:column>

					<apex:column headerValue="{!$Label.kimbleone__commissionitemnarrativeheader}" >
							<apex:outputText value="{!comInv.Narrative}"/>
	      			</apex:column>
					
					<apex:column headerValue="{!$Label.kimbleone__datelabel}">
						<apex:outputText value="{0,date,dd/MM/yyyy}">
       						<apex:param value="{!comInv.InvoiceDate}" />
 						</apex:outputText>
					</apex:column>

					<apex:column headerValue="{!$Label.kimbleone__monthnumber}" >
							<apex:outputText value="{!comInv.MonthNumber}"/>
	      			</apex:column>

					<apex:column headerValue="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Reference__c.Label}">
							<apex:outputText value="{!comInv.InvoiceReference}" />
					</apex:column>
					<apex:column headerValue="{!$Label.kimbleone__commissionitemmeasuredvalueheader}"  style="text-align:right" headerClass="HeaderRightAligned" >
				 		<apex:outputText value="{0,number,#,##0.00}">
       							<apex:param value="{!comInv.InvoiceValue}" />
 						</apex:outputText>
				 	
				 	</apex:column>	
						
				 	<apex:column headerValue="{!$Label.kimbleone__commissionitemtotalmeasuredvalueheader}"  style="text-align:right" headerClass="HeaderRightAligned" >
				 		<apex:outputText value="{0,number,#,##0.00}">
       							<apex:param value="{!comInv.TotalInvoiceValue}" />
 						</apex:outputText>
				 	
				 	</apex:column>
					<apex:column headerValue="{!$Label.kimbleone__commissionitemcommissionvalueheader}"  style="text-align:right" headerClass="HeaderRightAligned" >
						<apex:outputText value="{0,number,#,##0.00}">
       							<apex:param value="{!comInv.CommissionValue}" />
 						</apex:outputText>
					</apex:column>

					<apex:column style="text-align:right" headerClass="HeaderRightAligned" headerValue="{!$Label.kimbleone__commissionitemtotalcommissionvalueheader}">
						<apex:outputText value="{0,number,#,##0.00}">
       							<apex:param value="{!comInv.CommissionTotal}"  />
 						</apex:outputText>
					</apex:column>	
				 	<!-- 
				 	<apex:column headerValue="{!$ObjectType.CommissionAgreement__c.Fields.TotalMeasureValue__c.Label}"  value="{!comAg.CommissionAgreement.TotalMeasureValue__c}" />
				 	<apex:column headerValue="{!$Label.CommissionInvoiceValueHeader}"  >
				 		<apex:outputText value="{!$Label.CommissionCalcErrorHeader}" rendered="{!comAg.Error==$Label.CommissionCalcErrorHeader}" style="font-color:#FF0000;font-weight: bold;" />
				 		<apex:outputText value="{!comAg.InvoiceValue}" rendered="{!comAg.Error!=$Label.CommissionCalcErrorHeader}"/>
				 	</apex:column>
				 	<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionAgreement__c.Fields.KimbleOne__StartDate__c.Label}" value="{!comAg.CommissionAgreement.KimbleOne__StartDate__c}"  >
				 	</apex:column>
				 	<apex:column headerValue="{!$ObjectType.KimbleOne__CommissionAgreement__c.Fields.KimbleOne__EndDate__c.Label}" value="{!comAg.CommissionAgreement.KimbleOne__EndDate__c}"  >
				 	</apex:column>
				 	
				 	 -->	
		</apex:pageBlockTable>
		</apex:column>
			 </apex:pageBlockTable>
		
		</apex:pageBlock>
	</apex:define>
</apex:composition>
</apex:page>