<apex:page standardController="Lead" extensions="CognizantLeadScopingController" tabstyle="Lead" lightningStylesheets="true" >  
    <p style="text-align: center; font-size: 24px; color:blue"><strong> Advanced Technology Group Pre-Sales Support Request</strong></p>
    <p style="text-align: center; font-size: 16px">Welcome, thank you for reaching out!<br></br> As the first step in engaging pre-sales support from the ATG's Sales and Solution Engineering team,
    <br></br> please fill out the information below. Once you submit the form, an ATG Pursuit Lead will reach out to you shortly.
    <br></br> Please fill out all the information to the best of your abilities. </p>
    <apex:form id="leadForm">
        <apex:pageBlock mode="edit" >
            <apex:pageMessages />
            <apex:pageBlockSection title="Client Information" >
                <apex:inputField value="{!lead.firstname}"/>
                <apex:inputField value="{!lead.lastname}"/>
                <apex:inputField value="{!lead.email}"/>
                <apex:inputField value="{!lead.Vertical_Market__c}"/>
            </apex:pageBlockSection>
            <apex:pageBlockSection title="Client Partner Information" >
                 <apex:inputField value="{!lead.company}"
                                  label="Who is the client?"/>
                 <apex:inputField value="{!lead.Does_Client_Use_Salesforce_currently__c}"
                                 label="Do they currently leverage Salesforce as part of their technology stack in any way?"/>
                <apex:inputField value="{!lead.Tied_to_an_RFP_Response__c}"
                                 label="Is this Oportunity tied to an RFP response?"/>
                                <apex:inputField value="{!lead.If_so_how_do_they_use_Salesforce_today__c}"/>
                <apex:inputField value="{!lead.Client_level_of_Cognizant_Relationship__c}"
                                 label="At what level within the client does Cognizants relationship live? (CEO; CTO; Director of IT; etc.)"/>
                <apex:inputField value="{!lead.ATG_Prioritized_Revenue_Stream__c}"
                                 label="Which ATG prioritized revenue stream is this opportunity tied to?"/>
                <apex:inputField value="{!lead.Existing_Cognizant_Customer__c}"
                                 label="Is this an existing Cognizant customer?"/>
                          <apex:inputField value="{!lead.Other_Offering_Form_tied_to_Project__c}"
                                 label="If other; please specify what is the offering/platform tied to the opportunity"/>
                <apex:inputField value="{!lead.Expected_Growth_within_Account_this_year__c}"
                                 label="If so; what is the expected growth within the account this year?"/>
                <apex:inputField value="{!lead.Annual_Revenue_generated_by_Account__c}"
                                 label="What is the annual revenue generated by this account for Cognizant?"/>
             </apex:pageBlockSection>
             <apex:pageBlockSection title="Deal Pursuit Information" >
                    <apex:inputField value="{!lead.Who_are_Cognizant_s_Competitors__c}"
                                     label="Who are Cognizant's competitors within the account"/>
                    <apex:inputField value="{!lead.Partnered_with_Vendor__c}"
                                     label="Are we partnered with the Vendor as part of the deal?"/>
                    <apex:inputField value="{!lead.Deploying_a_whole_team__c}"
                                     label="Would we be deploying an entire team for this opportunity? (PM, BA, Architect, Devs, and QA)"/>
                    <apex:inputField value="{!lead.Delivery_Model_Onshore_Offshore__c}"
                                     label="What is the expected delivery model of the opportunity (Onshore-USA/Offshore)?"/>
                    <apex:inputField value="{!lead.Mixture_of_Resources_Accepted__c}"
                                     label="Will the client accept a mixture of senior, mid, and junior resources on the project?"/>
                    <apex:inputField value="{!lead.What_are_the_Blended_rate_expectations__c}"
                                     label="What are the blended rate expectations for the account?"/>
                    <apex:inputField value="{!lead.X185_onshore_and_110_offshore_accepted__c}"
                                     label="Would a blended rate of $185 for onshore (USA) and $110 nearshore resources be acceptable?"/>
                    <apex:inputField value="{!lead.Expected_Lead_time_for_Start_of_Project__c}"
                                     label="What is the expected lead time for the start of the project?"/>
                    <apex:inputField value="{!lead.Is_Cognizant_bidding_on_all_non_ATG_work__c}"
                                     label="If there are multiple work streams within this opportunity, is Cognizant bidding on all of the work outside of just what ATG would be assisting with?"/>
                    <apex:inputField value="{!lead.Additional_Comments__c}"/>
                </apex:pageBlockSection>
                <apex:pageBlockSection title="Attach and upload up to three file's relevant to this pursuit" >
                    <apex:inputFile value="{!file1}" fileName="{!fileName1}" />
                    <apex:inputFile value="{!file2}" fileName="{!fileName2}" />
                    <apex:inputFile value="{!file3}" fileName="{!fileName3}" />
                </apex:pageBlockSection>
                <apex:pageBlockButtons location="bottom">
                <apex:commandButton action="{!save}" value="Save" />
              </apex:pageBlockButtons>
            </apex:pageBlock>
     </apex:form>
 </apex:page>