<apex:page standardcontroller="KimbleOne__SalesOpportunity__c" extensions="KimbleOne.SalesOppLostController"  sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="LoseOpportunityDisconnected.html" MenuContextType="Proposal" MenuContextId="{!KimbleOne__SalesOpportunity__c.KimbleOne__Proposal__c}" MenuContextName="{!KimbleOne__SalesOpportunity__c.Name}"/>
	
</apex:define>
    
<apex:define name="Content">
 	<style>
		.boxy-content {display:none;}
	</style>
	   
	<apex:outputPanel id="SalesOpportunityMainPanel" >

		<apex:pageMessages escape="false"/>

       	<apex:form >
       		<apex:pageBlock id="SalesOpportunityDetailPanel" title="{!$Label.kimbleone__salesopprecordlostreasonheader}">
				<apex:inputHidden value="{!KimbleOne__SalesOpportunity__c.KimbleOne__ForecastStatus__c}"/>
				
				<apex:pageBlockSection >
					<apex:inputfield id="closeDate" required="true" value="{!KimbleOne__SalesOpportunity__c.KimbleOne__CloseDate__c}" styleClass="kimbleDatePicker"/>
				</apex:pageBlockSection>

				<apex:pageBlockSection >				
					<apex:inputfield id="lostReason" required="true" value="{!KimbleOne__SalesOpportunity__c.KimbleOne__WonLostReason__c}" />
				</apex:pageBlockSection>

				<apex:pageBlockSection >				
					<apex:inputfield id="lostNarrative" required="true" value="{!KimbleOne__SalesOpportunity__c.KimbleOne__WonLostNarrative__c}" style="width:300px;height:150px"/>
				</apex:pageBlockSection>

				<apex:pageBlockButtons location="bottom">
	           		<apex:commandButton id="saveLoseOpportunityBtn" action="{!saveAndRedirect}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__save}" oncomplete="initialiseItems();" reRender="SalesOpportunityMainPanel"/>
	           	</apex:pageBlockButtons>
				
			</apex:pageBlock>
		</apex:form>
	</apex:outputPanel>

	<script>

		jQuery(window).load(function()
		{
			initialiseItems();
			jQuery(':focus').blur();
		});

		function initialiseItems()
		{
			SetupDatePicker();
		}

		function SetupDatePicker()
		{
		//dateFormat: 'yy-mm-dd',
		jQuery('.kimbleDatePicker').datepicker({
			dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
			showOtherMonths: true,
			selectOtherMonths: true,
			changeMonth: true,
			changeYear: true});
		}

	</script>


</apex:define>

</apex:composition>

</apex:page>