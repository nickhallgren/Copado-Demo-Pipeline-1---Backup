<apex:page standardController="KimbleOne__Invoice__c" action="{!CheckStatus}"  extensions="KimbleOne.InvoiceEditController" showHeader="true" sidebar="false" tabStyle="KimbleOne__Invoice__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
      	<c:Menu DefaultHelpPage="ManagingInvoices.html" MenuContextType="Invoice" MenuContextId="{!KimbleOne__Invoice__c.Id}"  MenuContextName="{!KimbleOne__Invoice__c.KimbleOne__Reference__c}"/>
    </apex:define>
    
    <apex:define name="Content">
    	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
    	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

    	<apex:form id="TheForm">
    	<div id="pageErrors">
    		<apex:pageMessages escape="False" />
		</div>
		
		<style>
			/* Invoice contacts */
			div.select2-container.find-invoice-contact a.select2-choice {
				height: 18px !important;
				line-height: 18px !important;
				background-image: none !important;
				border-radius: 0px !important;
				color: black !important;
				padding-left: 4px !important;
			}
			div.select2-container.find-invoice-contact .select2-choice div {
				border-left: none !important;
			}
			td.action-btn {
			    font-size: 16px;
			    text-align: center;
			    cursor: pointer;
			    width: 18px;
			}
			th.primary-cell {
			    width: 100px;
			}
			td.primary-cell {
			    text-align: center;
			}
			.select2-container.find-invoice-contact {
			    width: 100% !important;
			    padding-right: 2px;
			}
		</style>
		
		<apex:pageBlock title="{!$Label.kimbleone__editinvoiceheading}">
			<apex:pageblockButtons >
				<apex:commandButton action="{!SaveInvoice}" onclick="processInvoiceContacts();" value="{!$Label.kimbleone__save}"/>
			</apex:pageblockButtons>
			<apex:pageBlockSection columns="2" title="{!$Label.kimbleone__invoicedetailsheading}">
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__Account__c}" />
				<apex:pageBlockSectionItem >
					<apex:outputLabel for="invoiceStatus" value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Status__c.Label}"></apex:outputLabel>
					<apex:outputField id="invoiceStatus" value="{!KimbleOne__Invoice__c.Status__r.Name}" />
				</apex:pageBlockSectionItem> 
				
				<apex:inputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceDate__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c == Draft}" styleClass="kimbleDatePicker"/>
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceDate__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c != Draft}"/>
				
				<apex:inputField required="true" value="{!KimbleOne__Invoice__c.KimbleOne__InvoicePaymentTermDays__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c == Draft}"/>
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoicePaymentTermDays__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c != Draft}"/>
				
				<apex:pageBlockSectionItem rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c == Draft}">
						<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__BusinessUnitTradingEntity__c.Label}" />
						<apex:inputText value="{!KimbleOne__Invoice__c.KimbleOne__BusinessUnitTradingEntity__c}" styleclass="kimblecustomlookup GetTradingEntityList null true false" required="true"/> 
				</apex:pageBlockSectionItem>
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__BusinessUnitTradingEntity__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c != Draft}"/>
				
				
				<apex:pageBlockSectionItem rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c == Draft}">
						<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__ReceivableBankAccount__c.Label}" />
						<apex:inputText value="{!KimbleOne__Invoice__c.KimbleOne__ReceivableBankAccount__c}" styleclass="kimblecustomlookup GetBankAccountList null true false" required="true"/> 
				</apex:pageBlockSectionItem>
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__ReceivableBankAccount__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c != Draft}"/>
				
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__NetAmount__c}"/>
				
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__GrossAmount__c}"/>
				
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__TaxAmount__c.Label}"></apex:outputLabel>
					<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__TaxAmount__c}" rendered="{!KimbleOne__Invoice__c.KimbleOne__TaxAmount__c != 0}"/>
				</apex:pageBlockSectionItem>
				
				<apex:pageBlockSectionItem >
				&nbsp;
				</apex:pageBlockSectionItem>
				
				<apex:inputText value="{!KimbleOne__Invoice__c.KimbleOne__Contact__c}" styleclass="kimblecustomlookup GetAllAccountContacts {!KimbleOne__Invoice__c.KimbleOne__Account__c} false true" rendered="{!!ShowMultipleContacts && !UseEnhancedContactLookup}"/>
				
				<apex:inputField id="enhanced-input-contact" value="{!KimbleOne__Invoice__c.KimbleOne__Contact__c}" styleclass="kimbleSearch " html-data-typename="AccountContact" rendered="{!!ShowMultipleContacts && UseEnhancedContactLookup}" html-data-filter="{!('Account__c:' + KimbleOne__Invoice__c.KimbleOne__Account__c)}"/>
				
				<apex:pageBlockSectionItem rendered="{!ShowMultipleContacts}" >
					<apex:outputLabel styleClass="billing-contacts-label" value="{!$ObjectType.KimbleOne__BillingContact__c.LabelPlural}"/>
					<div class="invoice-contacts-container">
						<div id="invoice-contacts">
						</div>
					</div>		 	
				</apex:pageBlockSectionItem>
				
				<apex:inputField value="{!KimbleOne__Invoice__c.KimbleOne__Notes__c}"/>
				
			</apex:pageBlockSection>
			
			<apex:pageBlockSection columns="2" title="{!$Label.kimbleone__presentationdetailsheading}">
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceFormat__c}" />
				
				<apex:pageBlockSectionItem rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c == Draft}">
						<apex:outputText value="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__InvoiceTemplate__c.Label}" />
						<apex:inputText value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceTemplate__c}" styleclass="kimblecustomlookup GetCommercialDocumentTemplateList Invoice true false"/> 
				</apex:pageBlockSectionItem>
				<apex:inputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceTemplate__c}" rendered="{!KimbleOne__Invoice__c.Status__r.KimbleOne__Enum__c != Draft}"/>
				
				<apex:inputField value="{!KimbleOne__Invoice__c.KimbleOne__InvoiceContextDescription__c}" rendered="{!KimbleOne__Invoice__c.InvoiceFormat__r.KimbleOne__ShowContext__c}" />
			</apex:pageBlockSection>
			
			<apex:pageBlockSection columns="2" title="{!$Label.kimbleone__customdetailsheading}" rendered="{!$ObjectType.KimbleOne__Invoice__c.FieldSets.KimbleOne__InvoiceDetails.size != 0}">
				<apex:repeat value="{!$ObjectType.KimbleOne__Invoice__c.FieldSets.KimbleOne__InvoiceDetails}" var="i">
					<apex:inputField rendered="{!!CONTAINS(i.FieldPath,'.')}" value="{!KimbleOne__Invoice__c[i]}" styleClass="{!IF(AND($ObjectType.KimbleOne__Invoice__c.Fields[i].type == 'date',$ObjectType.KimbleOne__Invoice__c.Fields[i].updateable),'kimbleDatePicker','')}"/>
					<apex:outputField rendered="{!CONTAINS(i.FieldPath,'.')}" value="{!KimbleOne__Invoice__c[i]}"/>
				</apex:repeat>
   			</apex:pageBlockSection>
			
			<apex:pageBlockSection columns="1" title="{!$Label.kimbleone__rejectioncommentsheading}" rendered="{!WasPreviouslyRejected}">
				<apex:outputField value="{!KimbleOne__Invoice__c.KimbleOne__ApprovalComments__c}"/>
			</apex:pageBlockSection>

			<apex:inputText styleClass="TheInvoiceContacts" style="display:none" value="{!TheInvoiceContactsJson}"/>
			
		</apex:pageBlock>
		
		<script>
			function setFocusOnLoad(){}

			jQuery(function () {
				if(jQuery('.invoice-contacts-container').length) drawInvoiceContacts();
			});

			var invoiceContacts = (jQuery('.TheInvoiceContacts').val() == '' ? [] : jQuery.parseJSON(jQuery('.TheInvoiceContacts').val()))
			var accountId = '<apex:outputText value="{!KimbleOne__Invoice__c.KimbleOne__Account__c}"/>';
			
			var l = {};
			l['contactname'] = '<apex:outputText value="{!$ObjectType.KimbleOne__BillingContact__c.Fields.Name.Label}"/>';
			l['primaryind'] = '<apex:outputText value="{!$Label.kimbleone__primarybillingcontact}"/>';
			l['delete'] = '<apex:outputText value="{!$Label.kimbleone__deletebutton}"/>';
			
			function drawInvoiceContacts()
			{
				var html = '';
				
				html += '<table class="invoice-contacts-table list" border="0" cellpadding="0" cellspacing="0">';
				html += '<tr class="header-row headerRow">';
				html += '<th class="actions-col"></th>';
				html += '<th class="invoice-contact-name-title">' + l['contactname'] + '</th>';
				html += '<th class="primary-cell">' + l['primaryind'] + '</th>';
				html += '</tr>';
				
				// existing rows
				for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
				{
					var invoiceContact = invoiceContacts[invoiceContactCounter];
					
					html += '<tr class="invoice-contact-row" contactId="' + invoiceContact.ContactId + '">';
					
					html += '<td class="remove-invoice-contact action-btn" title="' + l['delete'] + '"><i class="fa fa-trash"></i></td>';
					html += '<td class="invoice-contact-name">' + invoiceContact.ContactName + '</td>';
					html += '<td class="primary-cell">';
					html += '<input type="radio" name="primary-invoice-contacts" ' + (invoiceContact.IsPrimary ? ' checked="checked"' : '') + '/>';
					html += '</td>';
		
					html += '</tr>';			
				}
				
				// new row
				html += '<tr class="invoice-contact-row new-invoice-contact">';
				
				html += '<td class="add-invoice-contact action-btn"></td>';
				html += '<td class="invoice-contact-name">';
				html += '<input type="text" class="find-invoice-contact"/>';
				html += '</td>';
				html += '<td class="primary-cell">';
				html += '</td>';
	
				html += '</tr>';
				
				jQuery('#invoice-contacts').html(html);
	
				initialiseInvoiceContactFind();
			}
			
			function initialiseInvoiceContactFind()
			{
				jQuery('.find-invoice-contact').select2({
					//minimumInputLength: 2,
					multiple: false,
					placeholder: '<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>',
					query: function (params) {
						var find = function() {findInvoiceContacts(params);};        		
						find();
					},
					initSelection : function (element, callback) {
					var data = {id: element.val(), text: element.attr('data-name')};
					callback(data);
					}
				});
				
				jQuery('.find-invoice-contact').on("select2-selecting", function(e) {
					var asPrimary = jQuery('input[name="primary-invoice-contacts"]').length == 0;
					var newContact = {ContactId: e.object.id, ContactName: e.object.text, IsPrimary: asPrimary};
					invoiceContacts.push(newContact);
					invoiceContacts.sort(sortByInvoiceContactName);
					InvoiceContactChanges = true;
					drawInvoiceContacts();
				});
				
				jQuery(document).off('click', '.remove-invoice-contact').on('click', '.remove-invoice-contact', removeInvoiceContact);
				jQuery(document).off('click', 'input[name="primary-invoice-contacts"]').on('click', 'input[name="primary-invoice-contacts"]', setPrimaryContact);
			}
			
			function sortByInvoiceContactName(a,b)
		   	{
		   		return (a.ContactName < b.ContactName) ? -1 : (a.ContactName > b.ContactName) ? 1 : 0; 
		   	}

			function setPrimaryContact()
			{
				var contactId = jQuery(this).closest('.invoice-contact-row').attr('contactId');
				
				for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
				{
					var invoiceContact = invoiceContacts[invoiceContactCounter];
					invoiceContact.IsPrimary = (invoiceContact.ContactId == contactId);
				}
			}
			
			function removeInvoiceContact()
			{
				var contactId = jQuery(this).closest('.invoice-contact-row').attr('contactId');
				
				jQuery(this).closest('.invoice-contact-row').remove();
				
				for(var invoiceContactCounter = 0; invoiceContactCounter < invoiceContacts.length; invoiceContactCounter++)
				{
					var invoiceContact = invoiceContacts[invoiceContactCounter];
					
					if(invoiceContact.ContactId == contactId)
					{
						invoiceContacts.splice(invoiceContactCounter, 1);
						break;
					}
				}
				
				drawInvoiceContacts();
			}
				
			function findInvoiceContacts(params)
			{				
				var existingInvoiceContactIds = [];
				jQuery('.invoice-contact-row:not(.deleted)').each(function() {existingInvoiceContactIds.push(jQuery(this).attr('contactId'));});
			
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InvoiceEditController.GetApplicableBillingContacts}',
			      		accountId, existingInvoiceContactIds, params.term,
			     			function(result, event){          
			            		if (event.status) 
				            {
				             	var data = {};
				             	data.results = result;
				             	params.callback(data);
				         	} 
				         	else if (event.type === 'exception') 
				         	{
				             	alert(event.message);
				         	} 
				         	else 
				         	{
				             	alert(event.message);
				         	}
			        	}, 
			        	{escape: false, timeout: 60000}
			    	);
			}
			
			function processInvoiceContacts()
			{
				if(jQuery('.invoice-contacts-container').length == 0) return;
				
				var theContacts = [];
				
				jQuery('.invoice-contact-row:not(.new-invoice-contact)').each(function() {
					var theContact = {ContactId: jQuery(this).attr('contactId'), ContactName: jQuery(this).find('.invoice-contact-name').text(), IsPrimary: jQuery(this).find('input[name="primary-invoice-contacts"]:checked').length == 1};
					theContacts.push(theContact);
				});
				
				jQuery('.TheInvoiceContacts').val(JSON.stringify(theContacts));
			}

			jQuery(window).load(function()
			{
				initialiseItems();
                jQuery(':focus').blur();
			});

			function initialiseItems()
			{
				SetupDatePicker();
			}

			function SetupDatePicker()
			{
				//dateFormat: 'yy-mm-dd',
				jQuery('.kimbleDatePicker').datepicker({
						dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true,
						changeMonth: true,
						changeYear: true});
			}
		</script>		
		
		</apex:form>
	</apex:define>
</apex:composition>

</apex:page>