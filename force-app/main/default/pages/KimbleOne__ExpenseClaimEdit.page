		<apex:outputPanel layout="none" rendered="{!EnhancedView}">
		<script>
			jQuery(document).ready(function(){
				initialiseEnhancedView();
			});

			var toolbarTop;
			var receiptTop;
			var expenseViewerHeight;
			function initialiseEnhancedView()
			{
				// fix the header on scroll
				jQuery(window).unbind('scroll');
				jQuery(window).scroll(scrollFixed);

				// fix the receipt panel on scroll
				receiptTop = jQuery('#right').offset().top;
				toolbarTop = jQuery('#fixed-header-container').offset().top;

                initialiseReceiptPanel();
			}

			function scrollFixed()
			{
			    // fix the header to the top of the page, includes the page errors elements if error are present
				var winScroll = jQuery(window).scrollTop();

				// fix the toolbar header panel on scroll
				var toolbarPanel = jQuery('#fixed-header-container');

				if (winScroll > toolbarTop) {
					toolbarPanel.addClass("sticky");
				} else {
					toolbarPanel.removeClass("sticky");
				}
			}

			var sfHeaderHeight = jQuery('#AppBodyHeader').height();

			function initialiseReceiptPanel()
			{
			    // height is based on whether or not the page has a header (classic vs lightning)
			    // and whether or not the thumbnails panel is shown
			    jQuery('#right div.receipt-btns').css('top', 67 + jQuery('#thumbnails').height());
			    jQuery('#right').css('top', sfHeaderHeight + jQuery('#kimble-page-header-container').height() + 1);

			    setReceiptPanelHeight(20 + jQuery('#thumbnails').height());

			    // actions with receipt should reset the has changes timer as the user is interacting with the page
			    pauseTimer();
            }

			function setReceiptPanelHeight(offset)
			{
			    jQuery('#receipt-container .pbBody').height(jQuery(window).height() - jQuery('#AppBodyHeader').height() - jQuery('#kimble-page-header-container').height() - jQuery('#receipt-container .pbHeader').height() - offset);
			   	expenseViewerHeight = jQuery('#receipt-container .pbBody').height() - offset;
            }

			function toggleAutoSave() {
				autoSaveOn = !autoSaveOn;
				jQuery(".autoSaveMode").toggleClass('fa-toggle-off').toggleClass('fa-toggle-on');

				if(!autoSaveOn) clearTimer();
			}
			function enableAutoSave(autoSaveOnIn) {
				autoSaveOn = autoSaveOnIn;
				jQuery(".autoSaveMode").toggleClass('fa-toggle-off', !autoSaveOn).toggleClass('fa-toggle-on', autoSaveOnIn);

				if(!autoSaveOn) clearTimer();
			}
			
			var selectedImgScale;
			var selectedImg;
			
            function resetReceiptFit(){
				selectedImg = document.getElementsByClassName('receiptImage')[0];
				var boxHeight = expenseViewerHeight;
				var boxWidth = jQuery('#receipt-scroller').width();
				
				if(selectedImg != null)
				{
					if((selectedImg.height - boxHeight) > (selectedImg.width - boxWidth)) 
					{
						selectedImg.style.height = boxHeight + 'px';
						selectedImg.style.width = '';
					}
					else 
					{
						selectedImg.style.width = boxWidth + 'px';
						selectedImg.style.height = '';
					}
					
					selectedImgScale = 1;
					selectedImg.style.transform = 'scale(' + selectedImgScale + ')';
				
					$("#receipt-scroller").toggle().toggle();

                    // actions with receipt should reset the has changes timer as the user is interacting with the page
                    pauseTimer();
				}
            }
            
            function receiptScaleUp(){
				selectedImgScale = selectedImgScale + 0.2;
				
				selectedImg.style.transform = 'scale(' + selectedImgScale + ')';
				
				$("#receipt-scroller").toggle().toggle();

                // actions with receipt should reset the has changes timer as the user is interacting with the page
			    pauseTimer();
            }
            
            function receiptScaleDown(){
				if(selectedImgScale > 0.25) selectedImgScale = selectedImgScale - 0.2;
				
				selectedImg.style.transform = 'scale(' + selectedImgScale + ')';
				
				$("#receipt-scroller").toggle().toggle();

                // actions with receipt should reset the has changes timer as the user is interacting with the page
			    pauseTimer();
            }
            
            function receiptFullSize(){
				if(selectedImg != null)
				{
					selectedImg.style.height = 'unset';
					selectedImg.style.width = 'unset';
					selectedImg.style.maxWidth = 'unset';
					selectedImg.style.maxHeight = 'unset';
					selectedImg.style.transform = '';
					
				    var imgHeight = selectedImg.height;
					selectedImg.style.maxWidth = '800px';
					selectedImg.style.maxHeight = expenseViewerHeight + 'px';
				    selectedImgScale = imgHeight / expenseViewerHeight;
				    if(selectedImgScale < 1) selectedImgScale = 1;
					selectedImg.style.transform = 'scale(' + selectedImgScale + ')';
				
					$("#receipt-scroller").toggle().toggle();

                    // actions with receipt should reset the has changes timer as the user is interacting with the page
                    pauseTimer();
				}
            }
            
            function showPreviousAttachment(){
				var links = document.getElementsByClassName('ReceiptAttachmentLink');
				var selectedlink = document.getElementsByClassName('ui-state-highlight')[0];
				var selectedimg = selectedlink.getElementsByTagName('img');
				
				var index;
				var indexOfPrev;
				
				for (index = 0; index < links.length; index++) {
					if(links[index].getAttribute('onclick') == selectedimg[0].getAttribute('onclick')) indexOfPrev = index - 1;
				}
				
				if(links[indexOfPrev] != null) links[indexOfPrev].click();
				else links[links.length - 1].click();


                // actions with receipt should reset the has changes timer as the user is interacting with the page
			    pauseTimer();
            }
            
            function showNextAttachment(){
				var links = document.getElementsByClassName('ReceiptAttachmentLink');
				var selectedlink = document.getElementsByClassName('ui-state-highlight')[0];
				var selectedimg = selectedlink.getElementsByTagName('img');
				
				var index;
				var indexOfNext;
				
				for (index = 0; index < links.length; index++) {
					if(links[index].getAttribute('onclick') == selectedimg[0].getAttribute('onclick')) indexOfNext = index + 1;
				}
				
				if(links[indexOfNext] != null) links[indexOfNext].click();
				else links[0].click();

                // actions with receipt should reset the has changes timer as the user is interacting with the page
			    pauseTimer();
            }

            function initialiseReceipt() 
			{
                initialiseReceiptPanel();

		        var scroller = document.querySelector('#receipt-scroller');
		        if(scroller == '' || scroller == null) return; 

				var isDown = false;
				var startX;
				var startY;
				
				scroller.addEventListener('mousedown', (e) => {
					e.preventDefault();
					scroller.style.cursor = 'grabbing';
					isDown = true;
					scroller.classList.add('active');
					startX = e.pageX - scroller.offsetLeft;
					startY = e.pageY - scroller.offsetTop;
					scrollLeft = scroller.scrollLeft;
					scrollTop = scroller.scrollTop;

					// actions with receipt should reset the has changes timer as the user is interacting with the page
			        pauseTimer();
				});
				scroller.addEventListener('mouseleave', () => {
					isDown = false;
					scroller.classList.remove('active');
				});
				scroller.addEventListener('mouseup', () => {
					scroller.style.cursor = 'grab';
					isDown = false;
					scroller.classList.remove('active');
				});
				scroller.addEventListener('mousemove', (e) => {
					if(!isDown) return;
					e.preventDefault();
					const x = e.pageX - scroller.offsetLeft;
					const y = e.pageY - scroller.offsetTop;
					const walk = (x - startX);
					const walkY = (y - startY);
					scroller.scrollLeft = scrollLeft - walk;
					scroller.scrollTop = scrollTop - walkY;

					// actions with receipt should reset the has changes timer as the user is interacting with the page
			        pauseTimer();
				});
			}
			
		</script>
		</apex:outputPanel>

		<script>
			var enhancedView = {!EnhancedView};
			var autoSaveEnabled = {!AutoSaveEnabled};
			var autoSaveOn = {!AutoSaveEnabled};

			jQuery(window).load(function(){
					initialiseItems();
			});
			function SetupDatePicker()
			{
				//dateFormat: 'yy-mm-dd',
				jQuery('.kimbleDatePicker:not(.unrestricted)').datepicker({
						dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true,
						changeMonth: true,
						changeYear: true,
						beforeShowDay: assignmentBounds});

				jQuery('.kimbleDatePicker.unrestricted').datepicker({
						dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true,
						changeMonth: true,
						changeYear: true});
			}

			function activityChanged()
			{
			    SetupDatePicker();
            }
		
			function showFileUploadPopup(pos)
			{
				initialiseModalBoxy('#fileUploadPopupDiv', '{!JSENCODE($Label.UploadReceiptHeading)}');
				$('#expenseItemAttachmentPosition').val(pos);
				showModalBoxy();
				document.getElementById('fileUploadIFrame').src = document.getElementById('fileUploadIFrame').src;
			}

			function highlightAttachment(attachmentId)
			{
			    jQuery('div.attachment-ind').removeClass('ui-state-highlight').addClass('ui-widget-inactive');
			    jQuery('div.attachment-ind[attachment-id="' + attachmentId + '"]').addClass('ui-state-highlight').removeClass('ui-widget-inactive');
   			}

			function cancelAttachment()
			{
				hideModalBoxy();
			}
			
			function addAttachment(id)
			{
				if($('#expenseItemAttachmentPosition').val() == '')
					addClaimAttachment(id);
				else
					addItemAttachment(id, $('#expenseItemAttachmentPosition').val());
			}
			
			function assignmentBounds(date) {
		  		
		  		var startDates = jQuery.parseJSON($('.SelectedActivityStartDatesJson').text() != '' ? $('.SelectedActivityStartDatesJson').text() : '{}');
		  		var endDates = jQuery.parseJSON($('.SelectedActivityEndDatesJson').text() != '' ? $('.SelectedActivityEndDatesJson').text() : '{}');

		  		var overlaps = false;
		  		
		  		jQuery.each(startDates, function(i, obj){
		  			if (date >= sforce.internal.stringToDate(obj) && date <= sforce.internal.stringToDate(endDates[i]))
		  				overlaps = true;
		  		});
		  		
		  		if (!overlaps)
		  			return [false,"NotAssigned","{!$Label.NotAssignedMessage}"];
		  			
		  		return [true, ''];
			}
			
			function showExchangeRate(obj, toCurrencyISOCode)
			{
				var expenseRow = $(obj).closest('tr.expense-item');
				
				var exchangeRate = expenseRow.find('.exchangeRate');
				var oldExchangeRate = expenseRow.find('.oldExchangeRate');
				var forDate = expenseRow.find('.kimbleDatePicker').val();
				if ($(obj).val() == toCurrencyISOCode)
				{
					exchangeRate.val(1);
					oldExchangeRate.val(1);
					exchangeRate.parent().parent().hide();
					exchangeRate.parent().parent().next().hide();
					expenseRow.find('.taxAmountLabel').text('(' + $(obj).val() + ')');
				}
				else
				{
					expenseRow.find('.exchangeRateLabel').text('(' + $(obj).val() + ' to ' + toCurrencyISOCode + ')');
					expenseRow.find('.taxAmountLabel').text('(' + $(obj).val() + ')');
					GetFormattedCurrencyExchangeRateForDate(exchangeRate,oldExchangeRate, $(obj).val(), toCurrencyISOCode, forDate);
				}
			}
			
			function GetFormattedCurrencyExchangeRateForDate(exchangeRate, oldExchangeRate, fromCurrencyISOCode, toCurrencyISOCode, forDate)
			{
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ExpenseClaimEditController.GetFormattedCurrencyExchangeRateForDate}',
            		fromCurrencyISOCode, toCurrencyISOCode, forDate,
           			function(result, event){
                
		                if (event.status) 
		                {
		                	exchangeRate.parent().parent().show();
							exchangeRate.parent().parent().next().show();
							exchangeRate.val(jQuery.formatNumber(result,{format:'#,##0.000000', locale:kimble.locale, isFullLocale:false})); 
							oldExchangeRate.val(result);
							calculateGrossAmount(exchangeRate);           	          	
		            	} 
		            	else if (event.type === 'exception') 
		            	{
		                	alert(event.message);
		            	} 
		            	else 
		            	{
		                	alert(event.message);
		            	}
		            }, 
		            {escape: true, timeout: 60000}
		        );
			}
			
			function calculateGrossAmount(obj)
			{
				var expenseRow = jQuery(obj).closest('tr.expense-item');
				
				if (expenseRow.find('.expenseIncurredAmount').val() == null || expenseRow.find('.expenseIncurredAmount').val() == '') return;
				var incurredAmt = jQuery.parseNumber(expenseRow.find('.expenseIncurredAmount').val(),{format:'#,##0.00', locale:kimble.locale, isFullLocale:false});  
				var expenseGrossAmount = expenseRow.find('.expenseGrossAmount');
				var exchangeRate = jQuery.parseNumber(expenseRow.find('.exchangeRate').val(),{format:'#,##0.000000', locale:kimble.locale, isFullLocale:false}); 
				var expenseTaxAmount = expenseRow.find('.tax-amount-edit');
				var forDate = expenseRow.find('.kimbleDatePicker').datepicker("getDate");
				
				if (forDate == null || forDate.length == 0)
					forDate = jQuery.datepicker.parseDate(kimble.regional.dateFormat,expenseRow.find('.incurred-date').text());
				
				if (isNaN(incurredAmt)) return;
				
				if (!isNaN(exchangeRate) && exchangeRate > 0)
				{	
					var expenseGrossAmt = (incurredAmt * exchangeRate).toFixed(2);
					expenseGrossAmount.text($.formatNumber(expenseGrossAmt,{format:'#,##0.00', locale:kimble.locale, isFullLocale:false}));
					if(expenseRow.find('.expenseGrossAmountField').length > 0)
						expenseRow.find('.expenseGrossAmountField').val($.formatNumber(expenseGrossAmt,{format:'#,##0.00', locale:kimble.locale, isFullLocale:false}));
				}
				
				var taxCodeId = expenseRow.find('.tax-code-select').val();
				
				if (taxCodeId == '') return;
				
				//find rate for code on incurred date
				var taxCode = taxRatesJson[taxCodeId];
				var taxRate;
				
				jQuery.each(Object.keys(taxCode), function(i, val) {
					if (forDate.valueOf() >= val.toDate().valueOf()) 
					{
						taxRate = taxCode[val];
						return false;
					}
				});
				
				//recalc tax amount if readonly or null
				if (expenseTaxAmount.prop('readonly') || expenseTaxAmount.val() == '')
				{
					var expenseTaxAmt = (incurredAmt * (1 - 100/(100 + taxRate))).toFixed(2);
					expenseTaxAmount.val(jQuery.formatNumber(expenseTaxAmt,{format:'#,##0.00', locale:kimble.locale, isFullLocale:false}));
				}

				calculateReimbursementAmount();
			}

			function calculateReimbursementAmount()
			{
			    jQuery('.recalc-reimbursement-amt').removeClass('hidden-item');
			    jQuery('.total-reimbursement-amt').addClass('calc');

				recalculateReimbursementAmount();
   			}
			
			function calculateExchangeRateForReimbursementAmount(obj)
			{
				var expenseRow = $(obj).closest('tr.expense-item');
				var exchangeRate = expenseRow.find('.exchangeRate');
				var incurredAmt = expenseRow.find('.expenseIncurredAmount').val()
				if (incurredAmt != null && incurredAmt != ''){
					var newExchangeRate = $(obj).val()/expenseRow.find('.expenseIncurredAmount').val();
					exchangeRate.val(   jQuery.formatNumber(newExchangeRate,{format:'#,##0.000000', locale:kimble.locale, isFullLocale:false}) );
				}
			}
			
			function expenseCategoryChange(obj)
			{
			    jQuery(obj).prop('title', jQuery(obj).find('option:selected').text());

				var row = jQuery(obj).closest('tr.expense-item');
				var categoryId = ''
				
				if(row.find('[id$="expenseCategoryDisplay"]').length > 0)
				{
					categoryId = row.find('[id$="expenseCategoryDisplay"]').attr('category-id');
				}
				else
				{
					categoryId = row.find('[id$="expenseCategorySelect"]').val();
				}
				
				if (categoryId == '')
				{
					//hide all and blank values??
					row.find('#per-occurrence-category').hide();
					row.find('#per-unit-category').hide();
					row.find('#has-attendees').hide();
					row.find('#start-end-location').hide();
					return;
				}
				
				var expenseCategory = expenseCategories[categoryId];
				
				if(expenseCategory.IsPerOccurrence) 
				{
					row.find('#per-occurrence-category').show();
					row.find('#per-unit-category').hide();
					
					if (row.find('.tax-code-select').val() == '' || !expenseCategory.CanEditTaxCode)
					{
						var defaultTaxCodeId = expenseCategory.DefaultTaxCodeId;
						var matchingApplicabilities = taxApplicabilityJson[expenseCategory.CategoryId];
						if (matchingApplicabilities != null && matchingApplicabilities.length > 0)
						{
							var forDate = row.find('.kimbleDatePicker').datepicker("getDate");

							if (forDate == null || forDate.length == 0) forDate = jQuery.datepicker.parseDate(kimble.regional.dateFormat,row.find('.incurred-date').text());

							for (var i=0; i<matchingApplicabilities.length;i++)
							{
								if (forDate >= matchingApplicabilities[i].FromDate.toDate() && (matchingApplicabilities[i].ToDate == null || forDate <= matchingApplicabilities[i].ToDate.toDate()))
								{
									defaultTaxCodeId = matchingApplicabilities[i].TaxCodeId;
									break;
        						}
       						}
      					}

      					row.find('.tax-code-select').val(defaultTaxCodeId);
					}
					//default tax rate for tax code if tax rate is null
					if (row.find('.tax-amount-edit').val() == '') calculateGrossAmount(row.find('.tax-amount-edit')[0]);
					
					if (expenseCategory.CanEditTaxCode || expenseCategory.CanEditTaxAmount)
					{
						row.find('#tax-amount-panel').show();
					}
					else
					{
						row.find('#tax-amount-panel').hide();
					}					

					row.find('.tax-code-select').find('option:not(:selected)').prop('disabled', !expenseCategory.CanEditTaxCode);
					
					row.find('.tax-amount-edit').prop('readonly',!expenseCategory.CanEditTaxAmount);							
				}
				else
				{
					row.find('#per-occurrence-category').hide();
					row.find('.tax-code-select').val('');
					row.find('#per-unit-category').show();
					row.find('#unit-type-suffix').text(expenseCategory.UnitTypeSuffix);
				}
			
				if (expenseCategory.HasAttendees)
					row.find('#has-attendees').show();					
				else
					row.find('#has-attendees').hide();
					
				if (expenseCategory.HasStartLocation || expenseCategory.HasEndLocation)
				{
					row.find('#start-end-location').show();
					
					if (expenseCategory.HasStartLocation)
						row.find('.start-location').show();
					else
						row.find('.start-location').hide();
						
					if (expenseCategory.HasEndLocation)
						row.find('.end-location').show();
					else
						row.find('.end-location').hide();
					
				}
				else
				{
					row.find('#start-end-location').hide();
				}

				row.find('select[id$="expenseCategorySelect"]').prop('title', function(){ return this.text; });
				
				calculateGrossAmount(row.find('.tax-amount-edit')[0]);
				
				calculateReimbursementAmount();
			}

			function taxCodeChanged(obj)
			{
			    jQuery(obj).prop('title', jQuery(obj).find('option:selected').text());

			    // null out expenseTaxAmount so it is recalculated
			    var expenseRow = jQuery(obj).closest('tr.expense-item');
				var expenseTaxAmount = expenseRow.find('.tax-amount-edit');
			    expenseTaxAmount.val('');
   			}
			
			var taxRatesJson = {};
			
			<apex:outputPanel layout="none" rendered="{!!ISBLANK(TaxCodeRatesJson)}">
      				taxRatesJson = kimble.parseJSON("{!JSENCODE(TaxCodeRatesJson)}");
      		</apex:outputPanel>

      		var taxApplicabilityJson = {};

			<apex:outputPanel layout="none" rendered="{!!ISBLANK(TaxCodeApplicabilitiesJson)}">
      				taxApplicabilityJson = kimble.parseJSON("{!JSENCODE(TaxCodeApplicabilitiesJson)}");
      		</apex:outputPanel>
		
			function initialiseItems()
			{
				SetupDatePicker();
				
				jQuery.each(jQuery('[id$="TheExpenseItems"]>tbody>tr'), function(i, obj){
					if(jQuery(obj).find('select[id$="expenseCategorySelect"]').length > 0) expenseCategoryChange(jQuery(obj).find('select[id$="expenseCategorySelect"]'));
				});
				
				if(jQuery("#addExpenseBtn").length > 0)
				{
					jQuery("[id$='expense-claim-footer-buttons']").removeClass("hidden-buttons").attr("display", "block");
				}

				if(enhancedView)
				{
				    initialiseChangeHandlers();
				    initialiseResizeHandler();
				}
			}

			function initialiseChangeHandlers()
			{
			    var hasItems = jQuery('.expense-item').length == 0 ? false : true;

			    var textSelector = 'div.editPage input' + (hasItems ? '' : ':not([id$="expenseClaimName"])') + ', div.editPage textarea';
			    jQuery(document).on('keyup', textSelector, pauseTimer);
			    jQuery(document).on('change', textSelector, setHasChanges);

			    var changeSelector = 'div.editPage input.kimbleDatePicker, div.editPage input[type="checkbox"], div.editPage select' + (hasItems ? '' : ':not([id$="ActivityList"])');
			    jQuery(document).on('change', changeSelector, setHasChanges);
   			}

   			function initialiseResizeHandler()
   			{
				jQuery(window).resize(function() {
					initialiseReceipt();
				});
      		}
			
			function cloneExpenseClaim()
			{
				initialiseModalBoxy('#CloneExpenseClaimPopup', '{!$ObjectType.ExpenseClaim__c.labelplural}', jQuery('form[id$=\'CloneExpenseClaimPopupForm\']'));
			}
		
			function disableButtons()
			{
				jQuery('[id$="SelectExpenseClaimToCloneButton"], [id$="CancelExpenseClaimCloneButton"]').prop('disabled', true).addClass('btnDisabled');
			}
		
			function hideWorking()
			{
				jQuery('#loadingIndicatorOuterContainer').hide();
			}
			
			function showWorking()
			{
				jQuery('#loadingIndicatorOuterContainer').show();
			}

			function hideSaving()
			{
				jQuery('#savingIndicatorOuterContainer').hide();
			}

			function showSaving()
			{
				jQuery('#savingIndicatorOuterContainer').show();
			}

			function updateFixedHeaderTotal()
   			{
   			    if(enhancedView)
   			    {
   			        jQuery('.recalc-reimbursement-amt').addClass('hidden-item');
    			    jQuery('.total-reimbursement-amt').removeClass('calc');
				}
      		}

      		function scrollToNewItem()
      		{
      		    if(enhancedView)
   			    {
   			        jQuery('html, body').animate({
						scrollTop: jQuery(".expense-item:last-child").offset().top
					}, 500);

					// stop auto save until something new happens
					clearTimer();
				}
        	}

			function cancelClaimRedirect(theURL)
			{
				var resId = '<apex:outputText value="{!resourceIdParam}"/>';
				var perId = '<apex:outputText value="{!timesheetPeriodIdParam}"/>';
				var src = '<apex:outputText value="{!srcParam}"/>';
				var targetPageUrl = (src == null || src == '' || src == 't' ? '<apex:outputText value="{!$Page.KimbleOne__Timesheet}"/>' : '<apex:outputText value="{!$Page.KimbleOne__TimesheetGrid}"/>');

			    if(getQueryVariable('ts') == 1 && resId != '' && resId != null && perId != '' && perId != null)
			    {
			        var newURL = targetPageUrl + '?periodId=PERIOD_ID_PLACEHOLDER&Id=RESOURCE_ID_PLACEHOLDER';
					var timesheetURL = newURL.replace('RESOURCE_ID_PLACEHOLDER',resId).replace('PERIOD_ID_PLACEHOLDER',perId);
			        safeNavigateToSForceURL(timesheetURL);
       			}
       			else if(getQueryVariable('ts') == 2 && perId != '' && perId != null)
       			{
			        var newURL = targetPageUrl + '?periodId=PERIOD_ID_PLACEHOLDER';
					var timesheetURL = newURL.replace('PERIOD_ID_PLACEHOLDER',perId);
			        safeNavigateToSForceURL(timesheetURL);
       			}
				else
			    {
					safeNavigateToSForceURL(theURL);
			    }
			}

			var saveTimer;
			var countdownTimerVal;
			// the onscreen countdown is 10 seconds long, but the 20 second total timer means effectively 10 seconds are counted before
			// the user is made aware the auto save has started is to prevent the user thinking they need to rush!
			var onPageTimerVal = 10;
			var graceTimerVal = 20;
			function setHasChanges()
			{
			    if(!enhancedView) return;

				if(!(jQuery('.submit-actions .toolbar-button').hasClass('has-changes')))
				{
					jQuery(window).off('.has-changes').on('beforeunload.has-changes', function(){
						return kimble.labels['UnsavedChangesHeading'] + "\n\n" + kimble.labels['UnsavedChangesMessage'];
					});

					jQuery('.submit-actions .toolbar-button').addClass('has-changes');
				}
                resetTimer();
			}

			function pauseTimer()
			{
			    if(jQuery('.submit-actions .toolbar-button').hasClass('has-changes')) resetTimer();
            }

			function resetTimer()
			{
                clearTimer();

				if(autoSaveOn)
				{
				    startTimer();
				}
            }

			function autoSave()
			{
			    showSaving();
			    // note calling the saveAndStay() js method doesn't then register any change events on the claim name (why!)
			    // so instead manually fire the click which seems to fire the bound events correctly
			    jQuery('#save-stay .dd-menu-btn').click();
   			}

			var changesReset = false;
			function resetHasChanges()
			{
			    changesReset = jQuery('.submit-actions .toolbar-button').hasClass('has-changes');

				jQuery('.submit-actions .toolbar-button').removeClass('has-changes');
				jQuery(window).off('.has-changes');
				clearTimer();
			}

			function startTimer()
			{
				countdownTimerVal = graceTimerVal;
				saveTimer = setInterval(decrementCountdownTimer, 1000);
				jQuery('.auto-save-line').addClass('hidden-item');
				jQuery('.auto-save-line').css('width', '100%');
      		}

			function clearTimer()
			{
			    if(!enhancedView) return;

				countdownTimerVal = graceTimerVal;
				clearInterval(saveTimer);
				jQuery('.auto-save-line').addClass('hidden-item');
				jQuery('.auto-save-line').css('width', '100%');
			}

			var timerLineWidth;
			function updateOnScreenTimer()
			{
			    if(!enhancedView) return;

				if(jQuery('.auto-save-line').hasClass('hidden-item'))
				{
				    jQuery('.auto-save-line').removeClass('hidden-item');
				    timerLineWidth = jQuery('.auto-save-line').width();
				}
				jQuery('.auto-save-line').width((timerLineWidth / onPageTimerVal) * countdownTimerVal);
   			}

			function decrementCountdownTimer()
			{
			    if(!enhancedView) return;

			    // pause the timer whilst any popup is open or the page is working
			    if(jQuery('.boxy-content:visible').length > 0 || jQuery('.loadingIndicator:visible').length > 0) return;

				countdownTimerVal = countdownTimerVal - 1;

				if(countdownTimerVal <= onPageTimerVal && countdownTimerVal >= 0) updateOnScreenTimer(countdownTimerVal);

				if(countdownTimerVal < 0)
				{
					clearTimer();
					autoSave();
				}
   			}

			function checkSaveResult()
			{
			    if(!enhancedView) return;

				if(saveFailed != undefined && saveFailed && changesReset)
				{
				    setHasChanges();
				    clearTimer();
				}

				changesReset = false;
   			}
		</script>
		
	</apex:define>
	
	</apex:composition>
</apex:page>