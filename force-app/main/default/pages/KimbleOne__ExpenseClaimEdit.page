<apex:page standardController="KimbleOne__ExpenseClaim__c" sidebar="false" extensions="KimbleOne.ExpenseClaimEditController" action="{!CheckStatus}">
	<apex:composition template="KimbleOne__SiteMaster">
		 
	<apex:define name="Menu">
		<c:Menu DefaultHelpPage="ExpenseClaims.html" MenuContextName="{!IF(ISBLANK(TheClaim.Id), $Label.kimbleone__new, TheClaim.Name)}"/>
	</apex:define>

	<apex:define name="Content">

		<style>
			.thumbnailContainer{background-color:#FFF;border-color: gray;margin-bottom:4px;}
			.expenseItem{height:32px;background-image: url('{!URLFOR($Resource.KimbleOne__TimesheetIcons, 'Expense_Draft.png')}');background-repeat: no-repeat;background-position-x: 8px;}
           	.expenseItemHeading {margin: 1px;padding: 3px 10px;	position: relative;vertical-align: middle;line-height: 32px;}
           	.copyExpenseBtn {padding: 3px 10px;}
           	.expenseItemContent {padding: 0px 10px;overflow-x:auto;}
			.travelBasis>tbody>tr>td{border:0px !important;}
