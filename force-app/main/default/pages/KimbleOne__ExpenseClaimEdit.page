				text-align: center;
				cursor: default;
			}
			span.curr-field {
				padding-right: 6px;
				font-size: 18px;
			}
			span[id$="ReimbursementAmountHeader"] {
				font-size: 26px;
			}
			.exchangeRate,
			.expenseIncurredAmount,
			.expenseTaxAmount,
			.expenseGrossAmountField,
			.expenseUnitField {
				text-align: right;
			}
			.full-width {
			    width: 100%;
				padding: 2px !important;
				margin: 3px 0px 0px 3px;
   			}
			div#claim-totals {
				color: #5E5E5E;
			}
			.total-reimbursement-amt {
			    display: inline-block;
			}
			.total-reimbursement-amt.calc {
			    opacity: 0.3;
            }
			i.recalc-reimbursement-amt {
                position: absolute;
                left: 50%;
                top: 5px;
                font-size: 20px;
                color: orange;
			}
			.status-pill {
				font-size: 12px;
				padding: 4px 6px;
				border-radius: 4px;
				display: inline-block;
				border: none !important;
			}
