			}
			.expenseGrossAmount.no-padding {
				padding: 2px 0px 2px 0px;
			}
			.exchangeRate,
			.expenseIncurredAmount,
			.expenseTaxAmount,
			.expenseGrossAmountField,
			.expenseUnitField {
