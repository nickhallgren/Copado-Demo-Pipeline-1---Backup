			.inline-label {
			    font-weight: bold;
			    font-size: 10px;
			    margin-right: 5px;
			    display: inline;
			}
			.in-cell-row {
				white-space: nowrap;
				text-align: right;
				margin-bottom: 2px;
			}
			.in-cell-row.with-sep
			{
				border-top: 1px solid #ededed;
    			padding-top: 2px;
   			}
			.exchangeRateLabel {
				display: inline;
				margin-right: 5px;
			}
			.inline-curr-code {
