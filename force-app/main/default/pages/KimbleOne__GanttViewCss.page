/*
	loading panel
*/

.loadingIndicator {
   top:0;
   right:0;
   width:100%;
   height:100%;
   font-weight: bold;
   position:absolute;
   text-align:center;
   /* IE filter */
   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
   -moz-opacity:0.7;    /* Mozilla extension */
   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
   opacity:0.7; /* CSS3 */
   z-index:1000;
   background-color:white;
}

.loadingIndicator img {
	margin-right:9px;
}

#loadingIndicatorInnerContainer { 
	position:absolute; 
	top:50%;
	height:10em; 
	margin-top:-2em;
	width:100%;
}


/*LAYER AND ZOOM STYLES */
#footer {
	height: 31px;
	position:absolute;
	bottom:22px;
	right:25px;			
}

.zoom-in, .zoom-out {
 	cursor: pointer;  
	display: inline-block;
 	height: 30px;
 	text-align: center;
 	font-size: 31px !important;
	vertical-align: middle;
	white-space: nowrap;
	color: #737373 !important;
	opacity: 0.6;
}

.zoom-in:hover, .zoom-out:hover {
	color: #9FD7FF !important;
	opacity: 1;
	text-decoration: none;
}
		
#zoom-level {
		background-image: url({!URLFOR($Resource.KimbleOne__AssignmentImages, 'assignmentSprite.png')});
		background-repeat: no-repeat;
		display: none;
		height: 108px;
		text-align: center;
		vertical-align: middle;
		white-space: nowrap;
		width: 25px;
		zoom: 1;
		position:absolute;
		right: 16px;
		bottom: 27px;
	}

.layer-select {
		cursor: pointer;
		display: inline-block;
		height: 30px;
		text-align: center;
		vertical-align: middle;
		white-space: nowrap;
		margin-right:10px;
		color: #737373 !important;
		opacity: 0.6;
		font-size: 31px !important;
		}
		
.layer-select-on, .layer-select:hover {
		color: #9FD7FF !important;
		opacity: 1;
		text-decoration: none;
		}

.layer-select-icon {
 		position: absolute;
