/* activity-assignment-gantt styling */
.gantt-container
{
	white-space:nowrap;
	display:table;
	width:100%;
}
.gantt-container-middle
{
	display:inline-block;
	display: table-cell;
  		vertical-align: middle;		
}
.activity-assignment-gantt
{
	display: inline-block;
	position:relative;
	white-space: nowrap;
}
.activity-assignment-gantt-border
{
	position: absolute;
    top: 0px;
    bottom: 0px;
    left: 0px;
    right: 0px;
    border: 1px solid #bbb;
    z-index: 10;
    line-height: 24px;
	text-indent: 8px;
	font-weight: bold;
	color: #FFE;
	white-space: nowrap;
	pointer-events: none;
}
div[ass-type="AppliedModel"].activity-assignment-gantt,
div[ass-type="ActivatedModel"].activity-assignment-gantt {
	opacity: 0.3;
}
.agg-row
{
	background-color:#F4C2C2;
	white-space: nowrap;
	overflow-x: hidden;
	margin-bottom:2px;
}

#matching-resources-table-body td {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.outside-employment 
{
	background-image: url('{!URLFOR($Resource.KimbleOne__AssignmentImages, 'Unavailable.png')}');
}
