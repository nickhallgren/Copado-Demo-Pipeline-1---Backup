	height: 18px;
	display: block;
}

/*
	layout control
*/

.ui-layout-center,.ui-layout-east {
	padding: 0;
}

.ui-layout-content {
	padding: 0px;
}

/*
	resizable columns
*/

.results-grid-table {
	width: auto;
	table-layout: fixed;
    border-collapse: collapse;
    width: 0; /* otherwise Chrome will not increase table size */
}

.results-grid-table th, .results-grid-table td { 
     overflow: hidden;
     white-space: nowrap;
} 

.columnLabel {
    display: inline-block;
    width: 100%;
}

/* PAGE OVERRIDDES */
.gantt-container
{
	padding-bottom: 1px;
	border-bottom: 1px solid #eee;
	width:100%
}
.ui-state-active
{
	border:0px;
}

</style>
<script src="https://maps.googleapis.com/maps/api/js?key={!JSENCODE(GanttViewProperties.GoogleMapsApiKey)}"></script>	
</apex:define>

</apex:composition>

</apex:page>