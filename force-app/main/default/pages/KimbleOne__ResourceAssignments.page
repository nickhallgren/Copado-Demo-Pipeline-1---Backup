}

.candidate-resource
{
	background-image: url({!URLFOR($Resource.AssignmentImages, 'Assignment_Possible.png')});
	background-size: contain;
	width: 19px;
	height: 18px;
	display: block;
}

.candidate-pending
{
	background-image: url({!URLFOR($Resource.AssignmentImages, 'Assignment_ForApproval.png')});
	background-size: contain;
