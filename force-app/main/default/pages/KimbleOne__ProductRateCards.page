<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.ProductRateCardsController" sidebar="false" >
    <apex:composition template="KimbleOne__SiteMaster">

        <apex:define name="Menu">

            <c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>

        </apex:define>

        <apex:define name="Content">

            <apex:pageMessages escape="false"/>

            <apex:outputPanel id="MainPanel">

                    <apex:pageBlock id="DetailPanel">

                        <apex:pageBlockButtons >
                            <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ProductRateCard__c.createable}">
                                <input class="btn" type="button"
                                       onclick="newRateCardClick('{!JSENCODE(Product__c.Id)}', '{!$ObjectType.ProductRateCard__c.Name}', '');"
                                       value="{!$Label.New} {!$ObjectType.ProductRateCard__c.label}" />
                            </apex:outputPanel>
                        </apex:pageBlockButtons>

                        <apex:pageBlockTable value="{!RateCards}" var="rateCard">
                            <apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
                                <div data-floating-dropdown="#ratecard-{!rateCard.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
                                <div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
                                <div id="ratecard-{!rateCard.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
                                    <ul class="floating-dropdown-menu">
                                        <li><a href="javascript:editRateCardClick('{!JSENCODE(Product__c.Id)}', '{!JSENCODE(rateCard.Id)}', '')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit}</a></li>

                                        <apex:outputPanel layout="none" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems < 751}">
                                            <li><a href="javascript:editRateCardItemsClick('{!JSENCODE(Product__c.Id)}', '{!JSENCODE(rateCard.Id)}', '')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
                                        </apex:outputPanel>

                                        <li><a href="javascript:addRateCardItemsClick('{!JSENCODE(Product__c.Id)}', '{!JSENCODE(rateCard.Id)}', '')"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.Add} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>

                                        <li><a href="javascript:uploadItemsClick('{!JSENCODE(Product__c.Id)}', '{!JSENCODE(rateCard.Id)}', '', true)"><i class="fa fa-upload dropdown-icon"></i>{!$Label.UploadAndAppend}</a></li>
                                        <li><a href="javascript:uploadItemsClick('{!JSENCODE(Product__c.Id)}', '{!JSENCODE(rateCard.Id)}', '', false)"><i class="fa fa-upload dropdown-icon"></i>{!$Label.UploadAndReplace}</a></li>

                                        <li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(rateCard.RateCard__c)}', true);"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
                                        <apex:outputPanel rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].RateCardKeyDefinitionCombinationId != null}">
                                            <li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(!RateCardItemsSummaryMap[rateCard.RateCard__c].RateCardKeyDefinitionCombinationId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
                                        </apex:outputPanel>
                                    </ul>
                                </div>
                            </apex:column>

                            <apex:column headerValue="{!$ObjectType.KimbleOne__RateCard__c.Fields.Name.Label}" value="{!rateCard.RateCard__r.Name}" />
                            <apex:column headerValue="{!$ObjectType.KimbleOne__ProductRateCard__c.Fields.KimbleOne__EffectiveDate__c.Label}" value="{!rateCard.KimbleOne__EffectiveDate__c}" />
                            <apex:column headerValue="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}">
                                <apex:outputText value="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems}"/>
                            </apex:column>

                        </apex:pageBlockTable>

                    </apex:pageBlock>
            </apex:outputPanel>

            <apex:include pageName="{!$Page.RateCardAndItemsEdit}"/>

        </apex:define>
    </apex:composition>
</apex:page>