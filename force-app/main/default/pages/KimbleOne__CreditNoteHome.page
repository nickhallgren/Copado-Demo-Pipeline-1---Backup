<apex:page standardController="KimbleOne__CreditNote__c" extensions="KimbleOne.CreditNoteHomeController,KimbleOne.SecurityController,KimbleOne.TooltipsController" showHeader="true" sidebar="false" tabStyle="KimbleOne__CreditNote__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
      	<c:Menu DefaultHelpPage="CreateCreditNote.html" MenuContextType="CreditNote" MenuContextId="{!KimbleOne__CreditNote__c.Id}" MenuContextName="{!KimbleOne__CreditNote__c.KimbleOne__Reference__c}"/>
    </apex:define>
    
    <apex:define name="Content">
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

		<!-- Kimble Guidance -->
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
		<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/CreditNoteHomeNarratives/' + UserNarrativeLanguageCode + '.js')}" />

			<apex:outputPanel layout="none" rendered="{!CreditNoteHomeTipOverrideEnabled}">
				<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
			</apex:outputPanel>
		</apex:outputPanel>

    	<style>
    	.documents-table{
			min-width: 400px;
			max-height: 500px;
		}
		.status-icons {
    		float: right;
    	    display: inline-flex;
		}
		.email-icon > i.bottom-ind {
		    font-size: 22px;
			color: #505050;
		}
			
		.email-icon > i.top-ind {
		    color: #505050;
		    left: 16px;
		    position: absolute;
    		top: 13px;
   	 		background-color: white;
   			font-size: 13px;
		}
			
		.email-icon {
		    position: relative;
		    margin-left: 10px;
		}
		
		.download-icon > i.bottom-ind {
		    font-size: 22px;
			color: #505050;
			margin-top: 2px;
			
		}
		.download-icon > i.top-ind {
		    color: #505050;
		    left: 16px;
		    position: absolute;
    		top: 13px;
   	 		background-color: white;
   			font-size: 13px;
		}
		.download-icon{
		 	position: relative;
		    margin-left: 10px;
		}
		/* SELECT 2 STYLING */
		.select2-results li {margin-left:0px;}
		.select2-container-multi .select2-choices
		{
			border: 2px solid rgb(224,224,224);
			background-image:none;
		}
		.select2-container-multi .select2-choices .select2-search-choice {
		    border: 1px solid #aaaaaa;
		    border-radius: 4px;
		    padding: 5px 20px 5px 5px;
			background-image:none;
		}
		
		.select2-container-multi .select2-search-choice-close {
			background-image:  url({!URLFOR($Resource.KimbleOne__AssignmentImages, 'assignmentSprite.png')});
			background-position: -2px -29px;
			background-repeat: no-repeat;
			left:auto;
		}
		
		.select2-container-multi .select2-choices .select2-search-choice .select2-search-choice-close:hover {
			background-position: -2px -1px;
		}
    	</style>
    
    
    
    	<apex:form id="TheForm">
    	<apex:pageMessages escape="false"/>
    	
    	<apex:pageBlock title="{!$ObjectType.KimbleOne__CreditNote__c.Label}">
    		
    		<apex:pageBlockButtons location="top">
    			<apex:commandButton id="sendCreditNoteForApprovalBtn" action="{!SendForApproval}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__submitforapprovalbutton}" rerender="TheForm, ApprovalHistoryPanel" rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c = 'Draft' && $ObjectType.KimbleOne__CreditNote__c.updateable}"/>
    			<apex:commandButton id="deleteCreditNoteBtn" action="{!Del}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__deletebutton}" rerender="TheForm" rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c = 'Draft' && $ObjectType.KimbleOne__CreditNote__c.deletable}"/>
    			<apex:commandButton id="dispatchCreditNoteBtn" action="{!Dispatch}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__dispatch}" rerender="TheForm" rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c = 'Approved' && $ObjectType.KimbleOne__CreditNote__c.updateable && HasPermission['DispatchInvoice']}"/>
    			<apex:outputPanel layout="none" rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c = 'Approved' && $ObjectType.KimbleOne__CreditNote__c.updateable && HasPermission['DispatchInvoice']}">
    				<input id="dispatchAndSendEmailBtn" class="btn" type="button" onclick="initialiseModalBoxy('#sendEmailPopup', '{!JSENCODE($Label.DispatchEmailCreditNoteLabel)}', jQuery('form[id$=\'TheForm\']'));initialiseEmail('yes');" value="{!$Label.DispatchEmailLabel}" />
    			</apex:outputPanel>
    			<apex:outputPanel layout="none" rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c = 'Dispatched'}">
    				<input id="sendEmailBtn" class="btn" type="button" onclick="initialiseModalBoxy('#sendEmailPopup', '{!JSENCODE($Label.EmailCreditNoteLabel)}', jQuery('form[id$=\'TheForm\']'));initialiseEmail('no');" value="{!$label.EmailCreditNoteLabel}" />
    				<input id="downloadBtn" class="btn" type="button" onclick="initialiseModalBoxy('#DownloadPopup', '{!JSENCODE($Label.Download)} {!$ObjectType.KimbleOne__CreditNote__c.Label}', jQuery('form[id$=\'TheForm\']'));initialiseDownload();" value="{!$Label.Download}" />
    			</apex:outputPanel>
    			<div class="status-icons">
    				<apex:outputPanel layout="none" rendered="{!KimbleOne__CreditNote__c.KimbleOne__IsEmailed__c}">
	    			<div class="email-icon" title="{!JSENCODE(EmailSentLabel)}">
		    			<i class="fa fa-bottom-o email-ind"></i>
		    			<i class="fa fa-top-circle sent-ind"></i>
	    			</div>
	    			</apex:outputPanel>
	    			<apex:outputPanel layout="none" rendered="{!KimbleOne__CreditNote__c.KimbleOne__IsDownloaded__c}">
	    			<div class="download-icon" title="{!JSENCODE(DownloadedLabel)}">
		    			<i class="fa fa-download bottom-ind"></i>
		    			<i class="fa fa-check-circle top-ind"></i>
	    			</div>
	    			</apex:outputPanel>
    			</div>
    		</apex:pageBlockButtons>
						
			<apex:pageBlockSection columns="2" title="{!$Label.kimbleone__creditnotedetailsheading}">
				<apex:outputField id="creditNoteAccount" value="{!KimbleOne__CreditNote__c.KimbleOne__Account__c}" />
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__Status__c.Label}"></apex:outputLabel>
					<apex:outputField id="creditNoteStatus" value="{!KimbleOne__CreditNote__c.Status__r.Name}" />
				</apex:pageBlockSectionItem> 

				<apex:outputField value="{!KimbleOne__CreditNote__c.KimbleOne__Contact__c}" rendered="{!!ISBLANK(KimbleOne__CreditNote__c.KimbleOne__Contact__c)}"/>
				<apex:pageBlockSectionItem rendered="{!!ISBLANK(KimbleOne__CreditNote__c.KimbleOne__Contact__c)}">
				<apex:outputLabel value="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__SecondaryAddressees__c.Label}" rendered="{!!ISBLANK(KimbleOne__CreditNote__c.KimbleOne__SecondaryAddressees__c)}"></apex:outputLabel>
				<apex:outputField value="{!KimbleOne__CreditNote__c.KimbleOne__SecondaryAddressees__c}" rendered="{!!ISBLANK(KimbleOne__CreditNote__c.KimbleOne__SecondaryAddressees__c)}"/>
				</apex:pageBlockSectionItem>
				
				<apex:outputField id="creditNoteDate" value="{!KimbleOne__CreditNote__c.KimbleOne__CreditNoteDate__c}"/>
				
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__Invoice__c.Label}"></apex:outputLabel>
					<apex:outputField id="creditNoteInvoice" value="{!KimbleOne__CreditNote__c.Invoice__r.KimbleOne__ReferenceLink__c}" />
				</apex:pageBlockSectionItem> 
				
				<apex:outputField id="creditNoteReasonCode" value="{!KimbleOne__CreditNote__c.KimbleOne__ReasonCode__c}"/>
				
				<apex:outputField id="creditNoteReasonDescription" value="{!KimbleOne__CreditNote__c.KimbleOne__ReasonDescription__c}"/>
				
				<apex:outputField id="creditNoteNetAmount" value="{!KimbleOne__CreditNote__c.KimbleOne__NetAmount__c}"/>

				<apex:outputField id="creditNoteGrossAmount" value="{!KimbleOne__CreditNote__c.KimbleOne__GrossAmount__c}"/>
				
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__TaxAmount__c.Label}"></apex:outputLabel>
					<apex:outputField id="creditNoteTaxAmount" value="{!KimbleOne__CreditNote__c.KimbleOne__TaxAmountSum__c}" rendered="{!KimbleOne__CreditNote__c.KimbleOne__TaxAmountSum__c != 0}"/>
				</apex:pageBlockSectionItem>
				
				<apex:outputText id="credit-note-reference" value="{!KimbleOne__CreditNote__c.KimbleOne__Reference__c}"/>
								
   			</apex:pageBlockSection>
			
			<apex:pageBlockSection rendered="{!KimbleOne__CreditNote__c.Status__r.KimbleOne__Enum__c == 'Dispatched'}">
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$Label.kimbleone__filelabel}" ></apex:outputLabel>
					<a id="theDispatchedCreditNoteFilename" href="/servlet/servlet.FileDownload?file={!JSENCODE(TheDispatchedCreditNoteAttachment.Id)}">{!JSENCODE(TheDispatchedCreditNoteAttachment.Name)}</a>
				</apex:pageBlockSectionItem>
			
			</apex:pageBlockSection>
			
			<apex:repeat value="{!TheCreditNoteSections}" var="section">
 				<apex:pageBlockSection columns="1" title="{!section.Name}" collapsible="false">
					<apex:pageBlockTable value="{!section.CreditNoteLines__r}" var="line">
						<apex:column id="creditNoteLineNumber" width="15%" value="{!line.KimbleOne__LineNumber__c}"/>
						<apex:column id="creditNoteNarrativeLine" width="55%" value="{!line.KimbleOne__Narrative__c}"/>
						<apex:column id="creditNoteNetAmountLine" width="15%" value="{!line.KimbleOne__NetAmount__c}"/>
						<apex:column id="creditNoteTaxAmountLine" width="15%" value="{!line.KimbleOne__TaxAmount__c}"/>
					</apex:pageBlockTable>
				</apex:pageBlockSection>
			</apex:repeat>
			</apex:pageBlock>
			
			<apex:actionFunction action="{!InitialiseEmail}" name="initialiseEmail" rerender="sendEmailPanel" oncomplete="showModalBoxy()">
				<apex:param name="dispatchFirst" value="" />
			</apex:actionFunction>
			<apex:actionFunction action="{!InitialiseDownload}" name="initialiseDownload" rerender="DownloadPanel" oncomplete="showModalBoxy()">
			</apex:actionFunction>
			
			<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
			<div style="display:none;" kimble-tip="null"></div>

            <apex:actionFunction action="{!SendEmail}" name="sendEmailClick" rerender="sendEmailPanel" oncomplete="hideModalBoxyWithErrorCheck('#sendEmailErrors')">
                <apex:param name="dynamicContactsList" value="" />
            </apex:actionFunction>
			
			<div id="sendEmailPopup" style="display:none">
				<apex:outputPanel id="sendEmailPanel">
				<apex:pageBlock >
						<div id="sendEmailErrors"><apex:pageMessages escape="false"/></div>
						<apex:pageBlockButtons location="bottom">
                            <apex:outputPanel rendered="{!!IsDispatchBeforeSendingEmail}"><input class="btn" type="button" onclick="sendEmailClick($('#dynamicContacts').val());" value="{!$Label.kimbleone__ok}" /></apex:outputPanel>
							<apex:commandButton value="{!$Label.kimbleone__ok}" styleclass="DisableButtonWhileBusy" action="{!DispatchAndSendEmail}" oncomplete="hideModalBoxyWithErrorCheck('#sendEmailErrors')" rerender="sendEmailPanel" rendered="{!IsDispatchBeforeSendingEmail}"/>
							
							<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
						<apex:pageBlockSection columns="1">
							<apex:pageBlockSectionItem rendered="{!!UseEnhancedContactsLookup}">
								<apex:outputLabel value="{!$Label.kimbleone__to}..."></apex:outputLabel>
								<apex:outputPanel layout="block">
									<apex:selectList value="{!ContactsToEmail}" styleclass="select-contacts select2-filter" size="1" multiselect="true" style="width: 300px;">
										<apex:selectOptions value="{!TheAccountContacts}" />
									</apex:selectList>
									<script>
										jQuery('.select-contacts').select2();
									</script>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!UseEnhancedContactsLookup}">
									<apex:outputLabel value="{!$Label.kimbleone__to}..."></apex:outputLabel>
                                    <apex:outputPanel layout="none" >
									<input type="text" id="dynamicContacts" class="contacts-dynamic" style="width: 300px;"/>

									<script>
										jQuery('.contacts-dynamic').select2({
												minimumInputLength: 2,
												multiple: true,
												query: function (params) {
													var find = function() {findContacts(params);};        		
													find();
												},
												initSelection : function (element, callback) {
													var data = {id: element.val(), text: element.attr('data-name')};
													callback(data);
												}
										});

										var defaultValuesMap = jQuery.parseJSON('<apex:outputText value="{!defaultContactMap}"/>');
										
										var data = [];
										
										for(i=0; i<Object.keys(defaultValuesMap).length; i++)
										{
										    var theId = Object.keys(defaultValuesMap)[i];
											data.push({id:theId, text:defaultValuesMap[theId]});
          								}
          								
										jQuery('.contacts-dynamic').select2('data',data);
									</script>

								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$Label.kimbleone__emailtemplatelabel}"></apex:outputLabel>
								<apex:selectList id="emailTemplate" value="{!TheSelectedDocTemplateId}" size="1">
									<apex:selectOptions value="{!TheEmailTemplates}" />
								</apex:selectList>
							</apex:pageBlockSectionItem>
							
						</apex:pageBlockSection>
						
					</apex:pageBlock>
			</apex:outputPanel>
			</div>
			
			<div id="DownloadPopup" style="display:none">
				<apex:outputPanel id="DownloadPanel">
				<apex:inputText value="{!SelectedDocuments}" styleClass="SelectedDocuments" style="display:none"/>
					<apex:pageBlock >
						<div id="dowloadErrors"><apex:pageMessages escape="false"/></div>
						<apex:pageBlockButtons location="bottom">
							<apex:commandButton value="{!$Label.kimbleone__ok}" styleclass="DisableButtonWhileBusy" action="{!DownloadCreditNote}" onclick="performDownloads()" oncomplete="hideModalBoxyWithErrorCheck('#dowloadErrors')" rerender="DownloadPanel"/>
							<input class="btn DisableButtonWhileBusy" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
						</apex:pageBlockButtons>
						<apex:outputPanel layout="block" styleClass="documents-table">
							<apex:pageblocktable value="{!TheDispatchedCreditNoteAttachments}" var="att" >
								<apex:column style="width:20px">
									<input type="checkbox" class="document-cb" data-id="{!att.id}" theDownload="/servlet/servlet.FileDownload?file={!JSENCODE(att.id)}"/></apex:column>
								<apex:column value="{!att.name}"/>
							</apex:pageblocktable>
						</apex:outputPanel>
					</apex:pageBlock>
				</apex:outputPanel>
			</div>
			
			</apex:form>
			
			<apex:outputPanel layout="none" id="ApprovalHistoryPanel">
			<apex:include pageName="{!$Page.ApproveRejectItem}" rendered="{!InPageApproveRejectEnabled}"/>
			<apex:relatedList list="ProcessSteps" id="CreditNoteApprovalHistory"></apex:relatedList>

			<apex:outputPanel layout="none" rendered="{!InPageApproveRejectEnabled}">
			<script>
				jQuery(window).load(function()
				{
					var approvalItemId = '<apex:outputText value="{!KimbleOne__CreditNote__c.Id}"/>';

					overrideSFApproveRejectLink(approvalItemId);
				});
			</script>
			</apex:outputPanel>

			<script>
						$(document).ready(function(){
    						$(function() {
    							hideSalesForceApprovalProcessButtons();
    						})
    						
    						initialisePageTips();
    					});
    					function hideSalesForceApprovalProcessButtons()
    					{
    							$('input[name="piSubmit"]').remove();
    							$('input[name="piRemove"]').remove();
    					}
    					
    					
						function performDownloads(){
							var selectedDocsStr = '';
						
							$('.document-cb:checked').each(function(i, el) {
								selectedDocsStr = selectedDocsStr + $(el).attr('data-id')+',';
		    					window.open('/servlet/servlet.FileDownload?file='+$(el).attr('data-id'));
		    				});
		    				
		    				
		    				$('.SelectedDocuments').val(selectedDocsStr);
						}
						
						/* Tooltips */
						var enableTips = <apex:outputText value="{!TooltipsEnabled}"/>;
						var BaseHelpURL = '<apex:outputText value="{!URLFOR($Resource.KimbleOne__KimbleHelp, '')}"/>';
						var DetailedHelpLabel = '<apex:outputText value="{!$Label.kimbleone__detailedhelp}"/>';
						var MoreLabel = '<apex:outputText value="{!$Label.kimbleone__more}"/>';
						var TipsEnabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsenabled}"/>';
						var TipsDisabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsdisabled}"/>';
					
						function initialisePageTips()
						{
							ApplyTipAttributes();
							initialiseTips();
						}
						
						// add tip attributes to elements
						function ApplyTipAttributes()
						{
							if(enableTips)
							{
							    jQuery('[id$="creditNoteAccount"]').attr('kimble-tip','Account');
							    
								jQuery('[id$="creditNoteDate"]').attr('kimble-tip','CreditNoteDate');
                                jQuery('[id$="deleteCreditNoteBtn"]').attr('kimble-tip','Delete');
                                jQuery('[id$="dispatchCreditNoteBtn"]').attr('kimble-tip','Dispatch').attr('kimble-tip-extended-text','DispatchExtendedText').attr('kimble-tip-help-link','DispatchHelpLink');
                                jQuery('[id$="dispatchAndSendEmailBtn"]').attr('kimble-tip','DispatchAndEmail').attr('kimble-tip-extended-text','DispatchAndEmailExtendedText');
                                jQuery('[id$="creditNoteGrossAmount"]').attr('kimble-tip','GrossAmount');
                                jQuery('[id$="creditNoteInvoice"]').attr('kimble-tip','Invoice').attr('kimble-tip-extended-text','InvoiceExtendedText');
                                jQuery('[id$="creditNoteLineNumberheader"]').attr('kimble-tip','LineNumber').attr('kimble-tip-extended-text','LineNumberExtendedText');
                                jQuery('[id$="creditNoteNarrativeLineheader"]').attr('kimble-tip','Narrative');
                                jQuery('[id$="creditNoteNetAmount"]').attr('kimble-tip','NetAmount');
                                jQuery('[id$="creditNoteNetAmountLineheader"]').attr('kimble-tip','NetAmountLine');
                                jQuery('[id$="creditNoteReasonCode"]').attr('kimble-tip','ReasonCode').attr('kimble-tip-extended-text','ReasonCodeExtendedText');
                                jQuery('[id$="creditNoteReasonDescription"]').attr('kimble-tip','ReasonDescription').attr('kimble-tip-extended-text','ReasonDescriptionExtendedText');
                                jQuery('[id$="credit-note-reference"]').attr('kimble-tip','Reference');
                                jQuery('[id$="creditNoteStatus"]').attr('kimble-tip','Status');
                                jQuery('[id$="sendCreditNoteForApprovalBtn"]').attr('kimble-tip','SubmitForApproval');
                                jQuery('[id$="creditNoteTaxAmount"]').attr('kimble-tip','TaxAmount');
                                jQuery('[id$="creditNoteTaxAmountLineheader"]').attr('kimble-tip','TaxAmountLine');
							}
						}
						
				</script>
			</apex:outputPanel>
			
			<apex:relatedList list="ActivityHistories" id="CreditNoteActivities"></apex:relatedList>
			
		<script>
			function updateTipsConfigSetting(newTipSetting)
			{
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
					newTipSetting,
						function(result, event){
							if (event.status)
							{
								var data = {};
								data.results = result;
								loadGuidance();
							}
							else
							{
								alert(event.message);
							}
					},
					{escape: false, timeout: 60000}
				);
			}
			
			function findContacts(params) {
				
				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.CreditNoteHomeController.FindContacts}',
							params.term, '{!JSENCODE(CreditNote__c.Account__c)}', 
							function(result, event){          
								if (event.status) 
							{
								var data = {};
								data.results = result;
								params.callback(data);
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
						}, 
						{escape: false, timeout: 60000}
					);
			}
		</script>
	</apex:define>
</apex:composition>

</apex:page>