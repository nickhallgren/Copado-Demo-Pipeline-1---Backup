				<thead>
					<tr>
						<th width="12%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.Name.Label}</th>					
						<th width="40%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.Summary__c.Label}</th>
						<th width="12%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.RaisedByContact__c.Label}</th>					
						<th width="12%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.RaisedDate__c.Label}</th>					
						<th width="12%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.IssueImpact__c.Label}</th>
						<th width="12%" class="dashboardHeaderCell">{!$ObjectType.Issue__c.Fields.Status__c.Label}</th>					
					</tr>
					<tr>
						<th colspan="6">
							<hr/>
						</th>
					</tr>
				</thead>
				<tbody>
				
				<apex:repeat value="{!HighestIssues}" var="i">
						<tr>
							<td class="dashboardLabelCell">
								<apex:outputText styleClass="dashboardPropertyValueCellText" value="{!i.Name}"/>
							</td>
							<td class="dashboardLabelCell">
								<apex:outputText styleClass="dashboardPropertyValueCellText" value="{!i.KimbleOne__Summary__c}"/>
							</td>
							<td class="dashboardLabelCell">
								<apex:outputText styleClass="dashboardPropertyValueCellText" value="{!i.RaisedByContact__r.Name}"/>
							</td>
							<td class="dashboardLabelCellNumber">
								<apex:outputField styleClass="dashboardPropertyValueCellNumber" value="{!i.KimbleOne__RaisedDate__c}"/>
							</td>
							<td class="dashboardLabelCell">
								<apex:outputText styleClass="dashboardPropertyValueCellText" value="{!i.IssueImpact__r.Name}"/>
							</td>
							<td class="dashboardLabelCell">
								<apex:outputText styleClass="dashboardPropertyValueCellText" value="{!i.Status__r.Name}"/>
							</td>							
						</tr>			
				</apex:repeat>
				
				</tbody>
			</table>

	</apex:pageBlock>	
 	
 	
	<apex:pageBlock >
		<br/>	
			<h5><apex:outputText value="{!$Label.kimbleone__deliverygrouphomeprintperformanceagainstplan}" rendered="{!TrackingPlanList.size>0}"></apex:outputText></h5>

			<apex:repeat value="{!TrackingPlanList}" var="trackingPlanInfo">
