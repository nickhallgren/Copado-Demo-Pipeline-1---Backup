<apex:page standardcontroller="KimbleOne__Resource__c" extensions="KimbleOne.ResourceExpenseClaimSummaryController" tabStyle="KimbleOne__ReferenceData__c" sidebar="false" >
    <apex:composition template="KimbleOne__SiteMaster">

    <apex:define name="Menu" ></apex:define>

    <apex:define name="Content">
    <style>
        body.hasMotif.customnotabTab.apexPageInline.sfdcBody.brandQuaternaryBgr {
            margin: 0px;
        }
        .exp-claims-summary-container {
            color: #5E5E5E;
            border: 1px solid #ddd;
            padding: 6px;
            margin-bottom: 10px;
            border-radius: 4px;
        }
        .section-header {
            font-size: 16px;
            font-weight: bold;
            background-color: #F5F5F5;
            padding: 5px;
            border-radius: 2px;
            line-height: 32px;
            position: relative;
        }
        .new-exp-btn {
            position: absolute;
            right: 44px;
        }
        .new-exp-template-btn {
            position: absolute;
            right: 4px;
        }
        .expense-summary-header-btn {
            padding: 6px;
            border: 1px solid #ccc;
            border-radius: 2px;
            cursor: pointer;
            background-color: white;
            display: inline-block;
            margin-left: 5px;
            width: 20px;
            text-align: center;
            position: relative;
        }
        .expense-summary-header-btn .fa {
            font-size: 18px;
            color: #6f6f6f;
        }
        .expense-summary-header-btn i.fa-plus-square {
            position: absolute;
            right: 3px;
            bottom: 3px;
            font-size: 11px;
            background-color: white;
        }
        .expense-summary-header-btn i.fa-star {
            position: absolute;
            right: 3px;
            bottom: 3px;
            font-size: 11px;
            background-color: white;
        }
        .hover-btn:hover .fa {
            color: green !important;
        }        
        .stat-container {
            display: inline-block;
            background: white;
            padding: 10px;
            border-radius: 4px;
            margin-top: 5px;
            min-width: 150px;
            cursor: pointer;
        }
        .stat-container:hover {
            background-color: #e3f3ff;
        }
        .status-pill {
            font-size: 10px;
            padding: 4px;
            border-radius: 2px;
            display: inline-block;
            border: none !important;
        }
        .stat-container[data-status-enum="Rejected"] .status-pill {
            color: white;
            background-color: #B42D34;
        }
        .stat-container[data-status-enum="Draft"] .status-pill {
            color: white;
            background-color: #949599;
        }
        .stat-container[data-status-enum="ReadyForApproval"] .status-pill {
            color: white;
            background-color: #404041;
        }
        .stat-container[data-status-enum="Approved"] .status-pill {
            color: white;
            background-color: #008852;
        }
        .stat-container[data-status-enum="PendingPayment"] .status-pill {
            color: white;
            background-color: #FFC107;
        }
        .stat-container[data-status-enum="Paid"] .status-pill {
            color: white;
            background-color: #2196F3;
        }
        .no-text-select {
          -webkit-touch-callout: none; /* iOS Safari */
            -webkit-user-select: none; /* Safari */
             -khtml-user-select: none; /* Konqueror HTML */
               -moz-user-select: none; /* Firefox */
                -ms-user-select: none; /* Internet Explorer/Edge */
                    user-select: none; /* Non-prefixed version, currently
                                          supported by Chrome and Opera */
        }
        .exp-claims-container .entry-card {
            display: inline-block;
            width: 170px;
            vertical-align: top;
        }
        .entry-card.openable:hover,
        .entry-card.openable:hover .entry-card-body {
            background-color: #e7f4f8;
        }
        .entry-card.openable {
            cursor: pointer;
        }
        .entry-card-status {
            display: table-cell;
            vertical-align: middle;
            text-align: center;
        }
        .expense-entry-card .entry-card-status {
            width: 100%;
            text-align: left;
        }
        .expense-amt .kimbleCurrencyCode {
            font-size: 12px;
        }
        .expense-amt {
            font-size: 16px;
            font-weight: bold;
            text-align: right;
            margin-top: 28px
        }
        .entry-card-body .activity-name,
        .entry-card-body .claim-name,
        .entry-card-body .claim-dte {
            font-size: 11px !important;
            padding-bottom: 4px !important;
            display: block;
        }
        .entry-card-body .activity-name {
            font-weight: bold;
        }
        .entry-card-body .reference-val {
            font-size: 11px !important;
            margin-top: 2px !important;
            font-weight: normal;
            display: block;
        }
        .entry-card .claim-comments-ind {
            font-size: 18px;
            margin-top: 10px;
        }
        .entry-card-icon .te-icon {
            position: absolute;
        }
        .entry-card-icon img {
            width: 22px;
        }
        .entry-card {
            border-radius: 4px;
            border-collapse: collapse;
            margin-bottom: 6px;
            margin-right: 6px;
            position: relative;
        }
        .entry-card-body {
            padding: 8px;
            border-bottom-right-radius: 4px;
            border-bottom-left-radius: 4px;
            min-height: 78px;
        }
        .entry-card-header {
            display: table;
            height: 33px;
            width: 100%;
        }
        .entry-card-icon {
            display: table-cell;
            padding: 6px;
            position: relative;
        }
        .entry-card.Approved {
            border: 1px solid #d1edc5;
            background-color: #e5f3ed;
            color: #008852;
        }
        .entry-card.Approved .entry-card-header {
            border-bottom: 1px solid #d1edc5;
        }
        .status-pill.Approved {
            color: white;
            background-color: #008852;
        }
        .entry-card.Draft {
            border: 1px solid #dddddd;
            background-color: white;
            color: #949599;
        }
        .entry-card.Draft .entry-card-header {
            border-bottom: 1px solid #dddddd;
        }
        .entry-card.Draft .entry-card-body {
            background-color: white;
        }
        .status-pill.Draft {
            color: white;
            background-color: #949599;
        }
        .entry-card.ReadyForApproval {
            border: 1px solid #dddddd;
            background-color: #e7e7e8;
            color: #404041;
        }
        .entry-card.ReadyForApproval .entry-card-header {
            border-bottom: 1px solid #dddddd;
        }
        .status-pill.ReadyForApproval {
            color: white;
            background-color: #404041;
        }
        .entry-card.Rejected {
            border: 1px solid #e4b8ba;
            background-color: #F6E4DE;
            color: #B42D34;
        }
        .entry-card.Rejected .entry-card-header {
            border-bottom: 1px solid #e4b8ba;
        }
        .entry-card.Rejected .entry-card-body {
            background-color: white;
        }
        .status-pill.Rejected {
            color: white;
            background-color: #B42D34;
        }
        .entry-card.PendingPayment .entry-card-header {
            border-bottom: 1px solid #e4b8ba;
        }
        .entry-card.PendingPayment .entry-card-body {
            background-color: white;
        }
        .status-pill.PendingPayment {
            color: white;
            background-color: #FFC107;
        }
        .entry-card.Paid .entry-card-header {
            border-bottom: 1px solid #c2f1f7;
        }
        .entry-card.Paid {
            border: 1px solid #c2f1f7;
            background-color: #c3e4ff;
        }
        .status-pill.Paid {
            color: white;
            background-color: #2196F3;
        }
        .entry-card.Draft .entry-card-body,
        .entry-card.Draft .entry-card-actions,
        .entry-card.Rejected .entry-card-body,
        .entry-card.Rejected .entry-card-actions,
        .entry-card.Forecast .entry-card-body,
        .entry-card.Forecast .entry-card-actions {
            background-color: white;
        }
        span.curr-field {
            padding-right: 6px;
            font-size: 18px;
        }
        .total-amt {
            padding-top: 5px;
            font-size: 26px;
            height: 31px;
            opacity: 0;
        }
        .num-claims {
            padding-top: 0px;
        }
        .num-claims {
            font-style: italic;
            color: #0070d2;
        }
        span.claim-num {
            padding-right: 2px;
        }
    </style>

    <apex:outputPanel layout="none">
        <apex:outputText value="{!$Label.kimbleone__expenseclaimsummarynarrative01}" rendered="false"/>
        <apex:outputText value="{!$Label.kimbleone__expenseclaimsummarynarrative02}" rendered="false"/>
        <apex:outputText value="{!$Label.kimbleone__expenseclaimsummarynarrative03}" rendered="false"/>
        <apex:outputText value="{!$Label.kimbleone__expenseclaimsummarynarrative04}" rendered="false"/>
        <apex:outputText value="{!$Label.kimbleone__expenseclaimsummarynarrative05}" rendered="false"/>
    </apex:outputPanel>

    <div class="exp-claims-summary-container no-text-select">
        <div class="section-header">
            <apex:outputText value="{!$Label.kimbleone__expenseclaimsummary}"/>
            <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ExpenseItem__c.createable}">
                <apex:outputLink value="{!$Page.KimbleOne__ExpenseClaimEdit}?resourceId={!ResourceId}" styleClass="new-exp-btn" title="+ {!$ObjectType.KimbleOne__ExpenseItem__c.label}" target="_top" rendered="{!$User.UIThemeDisplayed == 'Theme3'}"><div class="expense-summary-header-btn hover-btn new-expense-item-btn"><i class="fa fa-money"></i><i class="fa fa-plus-square"></i></div></apex:outputLink>
                <apex:outputLink value="{!$Page.KimbleOne__ExpenseClaimEdit}?resourceId={!ResourceId}" styleClass="new-exp-btn" title="+ {!$ObjectType.KimbleOne__ExpenseItem__c.label}" rendered="{!$User.UIThemeDisplayed == 'Theme4d'}"><div class="expense-summary-header-btn hover-btn new-expense-item-btn"><i class="fa fa-money"></i><i class="fa fa-plus-square"></i></div></apex:outputLink>
                <apex:outputLink value="{!$Page.KimbleOne__TaskAssignmentTemplates}?Id={!ResourceId}" styleClass="new-exp-template-btn" title="+ {!$ObjectType.KimbleOne__ExpenseItemTemplate__c.label}" target="_top" rendered="{!ExpenseItemTemplatesEnabled && $User.UIThemeDisplayed == 'Theme3'}"><div class="expense-summary-header-btn hover-btn new-expense-item-template-btn"><i class="fa fa-money"></i><i class="fa fa-star"></i></div></apex:outputLink>
                <apex:outputLink value="{!$Page.KimbleOne__TaskAssignmentTemplates}?Id={!ResourceId}" styleClass="new-exp-template-btn" title="+ {!$ObjectType.KimbleOne__ExpenseItemTemplate__c.label}" rendered="{!ExpenseItemTemplatesEnabled && $User.UIThemeDisplayed == 'Theme4d'}"><div class="expense-summary-header-btn hover-btn new-expense-item-template-btn"><i class="fa fa-money"></i><i class="fa fa-star"></i></div></apex:outputLink>
            </apex:outputPanel>
        </div>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberRejectedClaims > 0}">
        <div class="stat-container" data-status-enum="Rejected" data-claim-id="{!TheSummary.TheStatistics.RejectedClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatusrejected)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalRejectedAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberRejectedClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberRejectedClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberDraftClaims > 0}">
        <div class="stat-container" data-status-enum="Draft" data-claim-id="{!TheSummary.TheStatistics.DraftClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatusdraft)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalDraftAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberDraftClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberDraftClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberSubmittedClaims > 0}">
        <div class="stat-container" data-status-enum="ReadyForApproval" data-claim-id="{!TheSummary.TheStatistics.SubmittedClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatussubmitted)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalSubmittedAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberSubmittedClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberSubmittedClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberApprovedClaims > 0}">
        <div class="stat-container" data-status-enum="Approved" data-claim-id="{!TheSummary.TheStatistics.ApprovedClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatusapproved)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalApprovedAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberApprovedClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberApprovedClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberPendingPaymentClaims > 0}">
        <div class="stat-container" data-status-enum="PendingPayment" data-claim-id="{!TheSummary.TheStatistics.PendingPaymentClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatuspendingpayment)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalPendingPaymentAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberPendingPaymentClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberPendingPaymentClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!TheSummary.TheStatistics.NumberPaidClaims > 0}">
        <div class="stat-container" data-status-enum="Paid" data-claim-id="{!TheSummary.TheStatistics.PaidClaimId}">
            <div class="stat-header">
                <apex:outputText styleClass="status-pill" value="{!UPPER($Label.kimbleone__estatuspaid)}"/>
                <div class="total-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleClass="curr-field"/><apex:outputText value="{!TheSummary.TheStatistics.TotalPaidAmt}" styleClass="curr-amt"/></div>
                <div class="num-claims"><apex:outputText styleClass="claim-num" value="{!TheSummary.TheStatistics.NumberPaidClaims}"/><apex:outputText value="{!IF(TheSummary.TheStatistics.NumberPaidClaims > 1, TheSummary.ClaimsNarrative, TheSummary.ClaimNarrative)}"/></div>
            </div>
        </div>
        </apex:outputPanel>
    </div>

    <apex:outputPanel layout="block" styleClass="exp-claims-container" id="theClaims">
    <apex:repeat value="{!TheSummary.TheClaims}" var="expenseClaim">
        <apex:variable var="Status" value="{!IF(OR(ISBLANK(expenseClaim.TheClaim.KimbleOne__ApprovalStatus__c), expenseClaim.TheClaim.KimbleOne__ApprovalStatus__c = 'Unapproved', expenseClaim.TheClaim.Status__r.KimbleOne__Enum__c = 'Paid'), expenseClaim.TheClaim.Status__r.KimbleOne__Enum__c, JSINHTMLENCODE(expenseClaim.TheClaim.KimbleOne__ApprovalStatus__c))}"/>

        <div class="entry-card expense-entry-card no-text-select openable hidden-item {!Status}" data-claim-id="{!expenseClaim.TheClaim.Id}" data-status-enum="{!Status}">
            <div class="entry-card-header">
                <div class="entry-card-icon"><apex:image styleClass="entry-icon" value="{!URLFOR($Resource.KimbleOne__TimesheetIcons, 'Expense_' + JSINHTMLENCODE(Status) + '.png')}"/></div>
                <div class="entry-card-status"><div class="status-pill {!Status}">{!JSINHTMLENCODE(UPPER(expenseClaim.DisplayStatus))}</div></div>
            </div>
            <div class="entry-card-body">
                <apex:outputText styleClass="claim-name" value="{!expenseClaim.TheClaim.KimbleOne__ShortName__c}" rendered="{!!ISBLANK(expenseClaim.TheClaim.KimbleOne__ShortName__c)}"/>
                <apex:outputText styleClass="claim-dte utc-dte" value="{!expenseClaim.IncurredDateUTC}"/>
                <apex:outputText styleClass="activity-name" value="{!expenseClaim.ActivityName}"/>
                <apex:outputText styleClass="reference-val" value="{!expenseClaim.TheClaim.KimbleOne__Reference__c}"/>
                <apex:outputPanel rendered="{!AND(expenseClaim.TheClaim.KimbleOne__ApprovalStatus__c = 'Rejected', !ISBLANK(expenseClaim.TheClaim.KimbleOne__ApprovalComments__c))}" title="{!expenseClaim.TheClaim.KimbleOne__ApprovalComments__c}"><div class="claim-comments-ind"><i class="fa fa-exclamation-circle"></i></div></apex:outputPanel>
                <div class="expense-amt"><apex:outputText value="{!TheSummary.TheStatistics.ReimbursmentCurrency}" styleclass="kimbleCurrencyCode"/><apex:outputField value="{!expenseClaim.TheClaim.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c}" /></div>
            </div>
        </div>
    </apex:repeat>
    </apex:outputPanel>

    <apex:form id="TheForm">
        <apex:actionFunction name="getClaimsAtStatus" action="{!GetClaimsAtStatus}" onComplete="showClaimsAtStatus(targetStatus);" reRender="theClaims">
            <apex:param name="targetStatus" value="" />
        </apex:actionFunction>
    </apex:form>

    <script>
        jQuery(window).load(function()
        {
            initialiseExpenseSummary();
        });

        function initialiseExpenseSummary()
        {
            initialiseDatesAndCurrencies();
            initialiseActions();
        }

        function initialiseActions()
        {
            jQuery(document).off('click', '.stat-container').on('click', '.stat-container', showClaims);
            jQuery(document).off('click', '.entry-card.openable').on('click', '.entry-card.openable', openClaim);
        }

        var targetStatus;

        function showClaims()
        {
            targetStatus = jQuery(this).attr('data-status-enum');
            var claimIdFilter = jQuery(this).attr('data-claim-id');

            // if there is only one claim at this status, jump straight to it (the claim id attribute will be set)
            if(claimIdFilter != '')
            {
                safeRedirectParentToSForceURL('/' + claimIdFilter);
            }
            else
            {
                // only fetch claims for this status if we haven't yet fetched them; assumption
                // is that if they in the summary then there must be at least one claim for this status
                if(jQuery('.entry-card[data-status-enum="' + targetStatus + '"]').length == 0)
                    getClaimsAtStatus(targetStatus);
                else
                    showClaimsAtStatus(targetStatus);
            }
        }

        function showClaimsAtStatus(status)
        {
            jQuery('.entry-card[data-status-enum="' + status + '"]').removeClass('hidden-item');
            jQuery('.entry-card:not([data-status-enum="' + status + '"])').addClass('hidden-item');

            initialiseDatesAndCurrencies();

            jQuery('html, body').animate({
                scrollTop: jQuery("div.exp-claims-container").offset().top
            }, 500);
        }

        function openClaim()
        {
            var claimId = jQuery(this).attr('data-claim-id');

            safeRedirectParentToSForceURL('/' + claimId);
        }

        function initialiseDatesAndCurrencies()
        {
            kimble.formatDates('.utc-dte');

            kimble.formatCurrencies('.curr-amt');
            jQuery('.total-amt').fadeTo('slow', 1);
        }
    </script>
    </apex:define>
    </apex:composition>
</apex:page>