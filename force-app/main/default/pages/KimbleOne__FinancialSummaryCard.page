<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.FinancialSummaryCardController,KimbleOne.SecurityController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__DeliveryGroup__c">    
	<div class="card inverted variable-width min-horizontal-padding financials-summary-card">
		<div class="cardHeading inverted">
			<h3 id="financialSummaryCardHeading" class="cardTitle"><apex:outputText value="{!$Label.kimbleone__deliverygroupfinancialsummary} ({!TheDisplayCurrencyIsoCode})"/></h3>
			<apex:outputPanel layout="block" styleclass="currency-mode-toggle-container" rendered="{!CanToggleCurrencyIsoCode}">
				<apex:outputPanel layout="inline" styleclass="undecorated-link" onclick="toggleFinancialCurrency('base', '{!JSENCODE(BaseCurrencyIsoCode)}')" rendered="{!TheDisplayCurrencyIsoCode != BaseCurrencyIsoCode}"><apex:outputText value="{!BaseCurrencyIsoCode}"/></apex:outputPanel>
				<apex:outputText value="{!BaseCurrencyIsoCode}" rendered="{!TheDisplayCurrencyIsoCode = BaseCurrencyIsoCode}"/>

				<apex:outputPanel layout="inline" styleclass="k-tgl fa fa-toggle-on" style="margin:0px 4px 0px 4px;" onclick="toggleFinancialCurrency('base', '{!JSENCODE(BaseCurrencyIsoCode)}')" rendered="{!TheDisplayCurrencyIsoCode = InvoicingCurrencyIsoCode}"></apex:outputPanel>
				<apex:outputPanel layout="inline" styleclass="k-tgl fa fa-toggle-off" style="margin:0px 4px 0px 4px;" onclick="toggleFinancialCurrency('invoicing', '{!JSENCODE(InvoicingCurrencyIsoCode)}')" rendered="{!TheDisplayCurrencyIsoCode = BaseCurrencyIsoCode}"></apex:outputPanel>

				<apex:outputPanel layout="inline" styleclass="undecorated-link" onclick="toggleFinancialCurrency('invoicing', '{!JSENCODE(InvoicingCurrencyIsoCode)}')" rendered="{!TheDisplayCurrencyIsoCode != InvoicingCurrencyIsoCode}"><apex:outputText value="{!InvoicingCurrencyIsoCode}"/></apex:outputPanel>
				<apex:outputText value="{!InvoicingCurrencyISOCode}" rendered="{!TheDisplayCurrencyIsoCode = InvoicingCurrencyISOCode}"/>
			</apex:outputPanel>
		</div>
	
		<div class="cardBody">

			<table class="list cardBodyTable" border="0" cellpadding="0" cellspacing="0">
				<thead>
					<tr class="headerRow">
						<th class="headerRow" colspan="{!IF(!AllElementsSameProbability, 3, 2)}"><h2></h2></th>
						<th colspan="2" class="headerRow"><h2></h2></th>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th id="finacialsBaselineColumn" colspan="4" class="headerRow" style="text-align: center;"><h2>{!$Label.BaselineLabel} </h2></th>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
							<th id="finacialsBaselineColumn" colspan="2" class="headerRow" style="text-align: center;"><h2>{!$Label.BaselineLabel} </h2></th>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th id="finacialsProjectedColumn" colspan="4" class="headerRow" style="text-align: center;"><h2>{!$Label.ProjectedLabel} </h2></th>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
							<th id="finacialsProjectedColumn" colspan="2" class="headerRow" style="text-align: center;"><h2>{!$Label.ProjectedLabel} </h2></th>
						</apex:outputPanel>
						
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th id="finacialsActualColumn" colspan="4" class="headerRow" style="text-align: center;"><h2>{!$Label.ActualLabel} </h2></th>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!!ShowCosts}">
							<th id="finacialsActualColumn" colspan="2" class="headerRow" style="text-align: center;"><h2>{!$Label.ActualLabel} </h2></th>
						</apex:outputPanel>
					</tr>
					<tr class="headerRow">
						<th class="headerRow" colspan="{!IF(!AllElementsSameProbability, 3, 2)}"><h2></h2></th>
						<th class="headerRow"><h2>{!$ObjectType.DeliveryElement__c.Fields.Name.Label}</h2></th>
						<th class="headerRow"></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
							<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
						</apex:outputPanel>
						<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
							<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
						</apex:outputPanel>
						<th class="headerRow"><h2>{!$Label.kimbleone__usagelabel}</h2></th>
						<th class="headerRow"><h2>{!$Label.kimbleone__revenuelabel}</h2></th>
						<apex:outputPanel layout="none" rendered="{!ShowCosts}">
							<th class="headerRow"><h2>{!$Label.kimbleone__costlabel}</h2></th>
							<th class="headerRow"><h2>{!$Label.kimbleone__marginlabel} (%)</h2></th>
						</apex:outputPanel>
					</tr>
				</thead>
				<tbody>	
					<apex:repeat value="{!TheElementSequenceList}" var="theTopLevelElement">
						<apex:variable var="fs" value="{!TheFinancialSummary.TheFinancialSummaryMap[theTopLevelElement.TheElementId]}"/>
						<apex:variable var="elementIsBaselined" value="{!fs.IsBaselined}"/>
						<apex:variable var="elementIsWAR" value="{!fs.IsWAR}"/>
						<apex:variable var="elementIsWARPending" value="{!fs.IsWARPending}"/>
						<apex:variable var="elementIsWARWithActuals" value="{!elementIsWAR && !ISNULL(fs.ActualUsage.InputDecimal__c) && fs.ActualUsage.InputDecimal__c > 0}"/>
						<tr class="dataRow primary-row">
							<td class="dataCell row-label-cell" id="{!JSINHTMLENCODE(fs.Id)}">
 								<apex:outputPanel layout="none" rendered="{!fs.ProbabilityCode = 'P1'}">
									<div data-floating-dropdown="#{!fs.Id}-menu-data" class="fa fa-bars delivery-element-menu burger-menu"></div>
									<div class="Loading" style="display:none"></div>
									<div id="{!fs.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
							   			 <ul class="floating-dropdown-menu">
									        <apex:outputPanel layout="none" rendered="{!HasPermission['BaselineDeliveryElement']}">
										        <li><a href="javascript:baselineElement('{!JSINHTMLENCODE(fs.Id)}');"><i class="fa fa-bookmark dropdown-icon"></i>{!$Label.BaselineThisElement}</a></li>
											</apex:outputPanel>
											 <apex:outputPanel layout="none" rendered="{!IsBaselineOverrideEnabled && elementIsBaselined && HasPermission['OverrideDeliveryElementBaseline']}">
												 <li><a href="javascript:baselineOverride('{!JSINHTMLENCODE(fs.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$Label.BaselineLabel}</a></li>
											 </apex:outputPanel>
										 </ul>
									</div>
 								</apex:outputPanel>
							</td>
							<apex:outputPanel layout="none" rendered="{!!AllElementsSameProbability}">
								<td class="dataCell row-label-cell">
									<div class="fa fa-square kimble-probability {!JSENCODE(fs.ForecastStatusStyleClass)}" title="{!JSENCODE(fs.ForecastStatusName)}"></div>
								</td>
							</apex:outputPanel>
							<td class="dataCell row-label-cell">
								<apex:outputPanel layout="none" rendered="{!!AllElementsOperatedSeparately}">
									<span title="{!IF(fs.IsOperatedWith, $Label.OperatedWithParentLabel + ': ' + fs.OperatedWithElementName, $Label.OperatedSeparatelyLabel)}"><i class="fa fa-pie-chart operated-with-ind {!IF(fs.IsOperatedWith, 'with-primary', '')}"></i></span>
								</apex:outputPanel>
								<apex:outputPanel layout="none" rendered="{!elementIsWARPending}">
									<span class="delivery-element-war-indicator fa fa-exclamation-triangle war-icon-pending" title="{!JSINHTMLENCODE($Label.WorkingAtRiskSubmittedForApproval)}"></span>
								</apex:outputPanel>
								<apex:outputPanel layout="none" rendered="{!!elementIsWARPending}">
									<span class="delivery-element-war-indicator {!IF(elementIsWAR,'fa fa-exclamation-triangle ' + IF(elementIsWARWithActuals,'war-icon-alert','war-icon-warn'),'')}" title="{!IF(elementIsWAR, $Label.WorkingAtRiskHeading + ' - ' + $ObjectType.ForecastStatus__c.Fields.ContingencyPercentage__c.Label + ': ' + fs.ContingencyPercentageAsString + '%','')}"></span>
								</apex:outputPanel>
							</td>
							<td class="dataCell row-label-cell">
								<span class="cursor-pointer" id="{!fs.Id}" onblur="safeHideSFInlineHover('{!fs.Id}');" onfocus="safeShowSFInlineHover('{!fs.Id}','{!fs.Id}');" onmouseout="safeHideSFInlineHover('{!fs.Id}');" onmouseover="safeShowSFInlineHover('{!fs.Id}','{!fs.Id}');">
									<apex:outputText value="{!fs.DeliveryElementName}"/>
								</span>
							</td>
							<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__serviceslabel}"/></td>
							<td class="dataCell fact-cell" style="background-color: #EEE;">
								<apex:outputField rendered="{!fs.HasBaselineUsage}" value="{!fs.BaselineUsage.InputDecimal__c} " />
								<apex:outputText rendered="{!fs.HasBaselineUsage}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>						
							</td>
							<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineServicesContractRevenue.InputDecimal__c}" /></td>
							
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineServicesContractCost.InputDecimal__c}" /></td>
								<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(fs.BaselineServicesContractMargin.InputInteger__c) && fs.BaselineServicesContractMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.BaselineServicesContractMargin.InputInteger__c}" /></td>
							</apex:outputPanel>
							
							<td class="dataCell fact-cell">
								<apex:outputField rendered="{!fs.IsResourced}" value="{!fs.Usage.InputDecimal__c} " />
								<apex:outputText rendered="{!fs.IsResourced}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>		
							</td>
							<td class="rightAlignDataCell">
								<a class="undecorated-link" href="{!IF(fs.RevenueIsUsageGenerated, $Page.KimbleOne__ActivityAssignmentsDelivery , IF (fs.RevenueIsMilestoneGenerated, $Page.KimbleOne__DeliveryGroupMilestones ,$Page.KimbleOne__DeliveryGroupAnnuities)) + '?Id=' + KimbleOne__DeliveryGroup__c.Id}">									
									<apex:outputPanel rendered="{!fs.IsNotionalRevenue}" layout="none">
										<span class="fa fa-info-circle notional-revenue" title="{!$Label.kimbleone__notionallabel}: {!fs.NotionalContractRevenueFormatted}"/>
									</apex:outputPanel>
									<apex:outputField value="{!fs.ServicesContractRevenue.InputDecimal__c}" />
								</a>
							</td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell">
									<a class="undecorated-link" href="{!IF(fs.CostIsUsageGenerated, $Page.KimbleOne__ActivityAssignmentsDelivery , IF (fs.CostIsMilestoneGenerated, $Page.KimbleOne__DeliveryGroupMilestones ,$Page.KimbleOne__DeliveryGroupAnnuities)) + '?Id=' + KimbleOne__DeliveryGroup__c.Id}">
										<apex:outputField value="{!fs.ServicesContractCost.InputDecimal__c}" />
									</a>
								</td>
								<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.ServicesContractMargin.InputInteger__c) && fs.ServicesContractMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.ServicesContractMargin.InputInteger__c}" /></td>
							</apex:outputPanel>
							
							<td class="dataCell fact-cell">
								<apex:outputField rendered="{!fs.IsResourced}" value="{!fs.ActualUsage.InputDecimal__c} " />
								<apex:outputText rendered="{!fs.IsResourced}" styleClass="inline-usage-units" value=" ({!fs.UsageUnits})"/>	
							</td>
							<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedServicesRevenue.InputDecimal__c}" /></td>
							<apex:outputPanel layout="none" rendered="{!ShowCosts}">
								<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedServicesCost.InputDecimal__c}" /></td>
								<td class="rightAlignDataCell" style="{!IF(!ISBLANK(fs.RecognisedServicesMargin.InputInteger__c) && fs.RecognisedServicesMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!fs.RecognisedServicesMargin.InputInteger__c}" /></td>
							</apex:outputPanel>
						</tr>
						<apex:variable value="{!fs.HasExpenseTotals}" var="displayExpenseTotals"/>
						<apex:outputPanel layout="none" rendered="{!displayExpenseTotals}">
							<tr class="dataRow">
								<apex:outputPanel layout="none" rendered="{!!AllElementsSameProbability}">
									<td class="dataCell"></td>
								</apex:outputPanel>
								<td class="dataCell"></td>
								<td class="dataCell"></td>
								<td class="dataCell"></td>
								<td class="dataCell line-heading"><apex:outputText value="{!$Label.kimbleone__expenseslabel}"/></td>
								<td class="dataCell fact-cell" style="background-color: #EEE;"></td>
								<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineExpensesContractRevenue.InputDecimal__c}" /></td>
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineExpensesContractCost.InputDecimal__c}" /></td>
									<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!fs.BaselineExpensesContractMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
								<td class="dataCell fact-cell"></td>
								<td class="rightAlignDataCell"><apex:outputField value="{!fs.ExpensesContractRevenue.InputDecimal__c}" /></td>
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell"><apex:outputField value="{!fs.ExpensesContractCost.InputDecimal__c}" /></td>
									<td class="rightAlignDataCell"><apex:outputField value="{!fs.ExpensesContractMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
								<td class="dataCell fact-cell"></td>
								<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedExpensesRevenue.InputDecimal__c}" /></td>
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedExpensesCost.InputDecimal__c}" /></td>
									<td class="rightAlignDataCell"><apex:outputField value="{!fs.RecognisedExpensesMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
							</tr>
						</apex:outputPanel>

						<!-- TheScopedWithElements belonging to the parent element -->						
						<apex:repeat value="{!theTopLevelElement.TheScopedWithElements}" var="theTopLevelElementScopedWithElement">
							<apex:variable var="topLevelElementScopedWithElementfs" value="{!TheFinancialSummary.TheFinancialSummaryMap[theTopLevelElementScopedWithElement.TheElementId]}"/>
							<apex:variable var="elementIsWAR" value="{!topLevelElementScopedWithElementfs.IsWAR}"/>
							<apex:variable var="elementIsWARPending" value="{!topLevelElementScopedWithElementfs.IsWARPending}"/>
							<apex:variable var="elementIsWARWithActuals" value="{!elementIsWAR && !ISNULL(topLevelElementScopedWithElementfs.ActualUsage.InputDecimal__c) && topLevelElementScopedWithElementfs.ActualUsage.InputDecimal__c > 0}"/>
							<tr class="dataRow">
								<td class="dataCell row-label-cell" id="{!JSINHTMLENCODE(topLevelElementScopedWithElementfs.Id)}">
									<apex:outputPanel layout="none" rendered="{!topLevelElementScopedWithElementfs.ProbabilityCode = 'P1'}">
										<div data-floating-dropdown="#{!topLevelElementScopedWithElementfs.Id}-menu-data" class="fa fa-bars delivery-element-menu burger-menu"></div>
										<div class="Loading" style="display:none"></div>
										<div id="{!topLevelElementScopedWithElementfs.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
											 <ul class="floating-dropdown-menu">
												<apex:outputPanel layout="none" rendered="{!HasPermission['BaselineDeliveryElement']}">
													<li><a href="javascript:baselineElement('{!JSINHTMLENCODE(topLevelElementScopedWithElementfs.Id)}');"><i class="fa fa-bookmark dropdown-icon"></i>{!$Label.BaselineThisElement}</a></li>
												</apex:outputPanel>
											 </ul>
										</div>
									</apex:outputPanel>
								</td>
								<apex:outputPanel layout="none" rendered="{!!AllElementsSameProbability}">
									<td class="dataCell row-label-cell">
										<!-- we don't display forecast status on scoped with elements -->
									</td>
								</apex:outputPanel>
								<td class="dataCell row-label-cell">
									<apex:outputPanel layout="none" rendered="{!!AllElementsOperatedSeparately}">
										<!-- we don't display operated with status on scoped with elements -->
									</apex:outputPanel>
									<apex:outputPanel layout="none" rendered="{!elementIsWARPending}">
										<span class="delivery-element-war-indicator fa fa-exclamation-triangle war-icon-pending" title="{!JSINHTMLENCODE($Label.WorkingAtRiskSubmittedForApproval)}"></span>
									</apex:outputPanel>
									<apex:outputPanel layout="none" rendered="{!!elementIsWARPending}">
										<span class="delivery-element-war-indicator {!IF(elementIsWAR,'fa fa-exclamation-triangle ' + IF(elementIsWARWithActuals,'war-icon-alert','war-icon-warn'),'')}" title="{!IF(elementIsWAR, $Label.WorkingAtRiskHeading + ' - ' + $ObjectType.ForecastStatus__c.Fields.ContingencyPercentage__c.Label + ': ' + topLevelElementScopedWithElementfs.ContingencyPercentageAsString + '%','')}"></span>
									</apex:outputPanel>
								</td>
								<td class="dataCell row-label-cell">
									<span class="cursor-pointer" id="{!topLevelElementScopedWithElementfs.Id}" onblur="safeHideSFInlineHover('{!topLevelElementScopedWithElementfs.Id}');" onfocus="safeShowSFInlineHover('{!topLevelElementScopedWithElementfs.Id}','{!topLevelElementScopedWithElementfs.Id}');" onmouseout="safeHideSFInlineHover('{!topLevelElementScopedWithElementfs.Id}');" onmouseover="safeShowSFInlineHover('{!topLevelElementScopedWithElementfs.Id}','{!topLevelElementScopedWithElementfs.Id}');">
										<span class="scoped-with-element-ind fa fa-angle-right"/>
										<span class="scoped-with-element"><apex:outputText value="{!topLevelElementScopedWithElementfs.DeliveryElementName}"/></span>
									</span>
								</td>
								<td class="dataCell row-label-cell line-heading"><apex:outputText value="{!$Label.kimbleone__serviceslabel}"/></td>
								<td class="dataCell fact-cell" style="background-color: #EEE;">
									<apex:outputField rendered="{!topLevelElementScopedWithElementfs.HasBaselineUsage}" value="{!topLevelElementScopedWithElementfs.BaselineUsage.InputDecimal__c} " />
									<apex:outputText rendered="{!topLevelElementScopedWithElementfs.HasBaselineUsage}" styleClass="inline-usage-units" value=" ({!topLevelElementScopedWithElementfs.UsageUnits})"/>						
								</td>
								<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!topLevelElementScopedWithElementfs.BaselineServicesContractRevenue.InputDecimal__c}" /></td>
								
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell" style="background-color: #EEE;"><apex:outputField value="{!topLevelElementScopedWithElementfs.BaselineServicesContractCost.InputDecimal__c}" /></td>
									<td class="rightAlignDataCell" style="background-color: #EEE; {!IF(!ISBLANK(topLevelElementScopedWithElementfs.BaselineServicesContractMargin.InputInteger__c) && topLevelElementScopedWithElementfs.BaselineServicesContractMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!topLevelElementScopedWithElementfs.BaselineServicesContractMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
								
								<td class="dataCell fact-cell">
									<apex:outputField rendered="{!topLevelElementScopedWithElementfs.IsResourced}" value="{!topLevelElementScopedWithElementfs.Usage.InputDecimal__c} " />
									<apex:outputText rendered="{!topLevelElementScopedWithElementfs.IsResourced}" styleClass="inline-usage-units" value=" ({!topLevelElementScopedWithElementfs.UsageUnits})"/>		
								</td>
								<td class="rightAlignDataCell">
									<a class="undecorated-link" href="{!IF(topLevelElementScopedWithElementfs.RevenueIsUsageGenerated, $Page.KimbleOne__ActivityAssignmentsDelivery , IF (topLevelElementScopedWithElementfs.RevenueIsMilestoneGenerated, $Page.KimbleOne__DeliveryGroupMilestones ,$Page.KimbleOne__DeliveryGroupAnnuities)) + '?Id=' + KimbleOne__DeliveryGroup__c.Id}">
										<apex:outputField value="{!topLevelElementScopedWithElementfs.ServicesContractRevenue.InputDecimal__c}" />
									</a>
								</td>
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell">
										<a class="undecorated-link" href="{!IF(topLevelElementScopedWithElementfs.CostIsUsageGenerated, $Page.KimbleOne__ActivityAssignmentsDelivery , IF (topLevelElementScopedWithElementfs.CostIsMilestoneGenerated, $Page.KimbleOne__DeliveryGroupMilestones ,$Page.KimbleOne__DeliveryGroupAnnuities)) + '?Id=' + KimbleOne__DeliveryGroup__c.Id}">
											<apex:outputField value="{!topLevelElementScopedWithElementfs.ServicesContractCost.InputDecimal__c}" />
										</a>
									</td>
									<td class="rightAlignDataCell" style="{!IF(!ISBLANK(topLevelElementScopedWithElementfs.ServicesContractMargin.InputInteger__c) && topLevelElementScopedWithElementfs.ServicesContractMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!topLevelElementScopedWithElementfs.ServicesContractMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
								
								<td class="dataCell fact-cell">
									<apex:outputField rendered="{!topLevelElementScopedWithElementfs.IsResourced}" value="{!topLevelElementScopedWithElementfs.ActualUsage.InputDecimal__c} " />
									<apex:outputText rendered="{!topLevelElementScopedWithElementfs.IsResourced}" styleClass="inline-usage-units" value=" ({!topLevelElementScopedWithElementfs.UsageUnits})"/>	
								</td>
								<td class="rightAlignDataCell"><apex:outputField value="{!topLevelElementScopedWithElementfs.RecognisedServicesRevenue.InputDecimal__c}" /></td>
								<apex:outputPanel layout="none" rendered="{!ShowCosts}">
									<td class="rightAlignDataCell"><apex:outputField value="{!topLevelElementScopedWithElementfs.RecognisedServicesCost.InputDecimal__c}" /></td>
									<td class="rightAlignDataCell" style="{!IF(!ISBLANK(topLevelElementScopedWithElementfs.RecognisedServicesMargin.InputInteger__c) && topLevelElementScopedWithElementfs.RecognisedServicesMargin.InputInteger__c < 0, 'color:red;font-weight:bold;','')}"><apex:outputField value="{!topLevelElementScopedWithElementfs.RecognisedServicesMargin.InputInteger__c}" /></td>
								</apex:outputPanel>
							</tr>
							<!-- Scoped With Elements don't have expenses -->
						</apex:repeat>						
						<!-- End of TheScopedWithElements belonging to the change request -->						


						<!-- TheChangeRequestElements -->						
						<apex:repeat value="{!theTopLevelElement.TheChangeRequestElements}" var="theChangeRequestElement">
							<apex:variable var="changeRequestfs" value="{!TheFinancialSummary.TheFinancialSummaryMap[theChangeRequestElement.TheElementId]}"/>
							<apex:variable var="elementIsBaselined" value="{!changeRequestfs.IsBaselined}"/>
							<apex:variable var="elementIsWAR" value="{!changeRequestfs.IsWAR}"/>
							<apex:variable var="elementIsWARPending" value="{!changeRequestfs.IsWARPending}"/>
							<apex:variable var="elementIsWARWithActuals" value="{!elementIsWAR && !ISNULL(changeRequestfs.ActualUsage.InputDecimal__c) && changeRequestfs.ActualUsage.InputDecimal__c > 0}"/>
							<tr class="dataRow">
