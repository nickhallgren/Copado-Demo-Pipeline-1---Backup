<apex:page standardController="KimbleOne__CandidateResource__c" extensions="KimbleOne.CandidateResourceProfileController" sidebar="false" tabStyle="CapabilityProfile__tab" >
	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="CandidateResource" MenuContextId="{!KimbleOne__CandidateResource__c.Id}" MenuContextName="{!KimbleOne__CandidateResource__c.Name}"/>
		</apex:define>

		<apex:define name="Content">
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>

			<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__CandidateResourceCapability__c.accessible}">
				<style>
		input#capability-type-filter {
			border: none;
			height: 30px;
			font-size: 15px;
			padding-left: 20px;
			border-radius: 4px;
    		width: 390px;
		}
		.title-card-body {
			background-color: initial;
    	}
		.breadcrumb-header {
		    font-weight: bold;
		    font-size: 14px;
		    padding: 8px;
		    background-color: #F5F5F5;
		    border: 1px solid #DDD;
		    border-radius: 4px;
		    margin-left: 2px;
		    margin-right: 2px;
		}
		#capability-search-results .cap-row {
		    cursor: pointer;
		}
		.header-row {
		    height: 20px;
		    font-weight: bold;
		}
		.cap-row {
	        position: relative;
            display: table;
    		width: 100%;
		}
		.cap-row div {
	        display: table-cell;
		}
		i.cap-state {
		    font-size: 20px;
		    position: absolute;
		    right: 12px;
		    top: 8px;
		}
		i.cap-state.fa-check-square {
		    color: green;
		}
		.cap-state.fa-plus-square-o {
/* 		    margin-right: 11px; */
		}
		.cap-row .type-name {
		    font-size: 14px;
		    padding: 8px 40px 8px 10px;
		}
		.cap-row.collapsed {
			display: none;
		}
		.cap-row:not(.header-row):hover {
		    background: #e1f6ff;
		}
		.browse-btn , .save-btn {
		    margin-right: 11px;
    		margin-bottom: 2px;
		    font-size: 26px;
		}
		.top-right-search-icon {
	        position: absolute;
		    right: 10px;
    		top: 7px;
		    font-size: 26px;
		}
		.search-container {
            display: table-cell;
	        padding: 0px 5px 5px 5px;
		    width: 500px;
		}
		.search-container-header.title-card {
		    padding-left: 5px;
	        margin-bottom: 5px;
            position: relative;
		}
		.action-btn {
			color: #BBB;
			cursor: pointer;
		}
		.action-btn:hover {
			color: #333;
		}
		.rating-cell input {
		    transform: scale(1.3);
		}
		#resource-capabilities .cap-row:not(.last-row) {
		    border-bottom: 1px solid #dcdcdc;
		}
		.browse-btn.action-btn.top-right-search-icon {
		    right: 32px;
		}
		#capability-search-results .breadcrumb-header {
			cursor: pointer;
			margin-bottom: 5px;
		}
		#resource-capabilities div {
		    vertical-align: middle;
		}
		#resource-capabilities .rating-cell {
		    width: 80px;
		    text-align: center;
		}
		#resource-capabilities .rating-cell span {
		    font-size: 16px;
		}
		.save-btn.has-changes {
		    color: #ffa500;
		}
		.remove-cap {
		    width: 10px;
		    padding-left: 5px;
		    cursor: pointer;
		    font-size: 14px;
		}
		.cap-row.is-deleted {
		    text-decoration: line-through;
		    background-color: #dcdcdc;
		}
		.cap-row.is-deleted input, .cap-row.is-deleted select {
		    display: none;
		}
		.cap-row.has-changes div.action-btn, .cap-row.new div.action-btn {
		    border-left: 4px solid #ffa500;
	        padding-left: 6px;
		}
		.page-container {
			display: table;
			width: 100%
		}

		/* Winter 18 Lightning Style Overrides - START */
		/* Only required to format the pageBlock which is required to maintain fonts and styling in Lightning */
		div[id$='sf-formatting-container'] .pbBody {
		    margin: 0px !important;
		    background-color: white;
		}
		div[id$='sf-formatting-container'].bPageBlock {
		    border: none !important;
			overflow-x: hidden;
		}
	</style>

				<apex:pageBlock id="sf-formatting-container">
					<div class="page-container">
						<div class="search-container">
							<div class="search-container-header title-card">
								<input id="capability-type-filter" placeholder="{!$Label.CapabilitySearchPlaceholder}"/>
								<i class="searching-ind top-right-search-icon hidden-item fa fa-spin fa-circle-o-notch"></i>
								<i class="browse-btn action-btn top-right-search-icon fa fa-list-ul" title="{!$Label.Browse}"></i>
							</div>
							<div id="capability-search-results">
							</div>
						</div>

						<div class="resource-capabilities-container">
							<div id="capabilities-title">
								<div class="title-card-container">
									<div class="title-card">
										<div class="title-card-heading" >
											<div class="title-card-heading-text">
												<apex:outputText title="{!$ObjectType.KimbleOne__CandidateResourceCapability__c.labelPlural}" value="{!$ObjectType.KimbleOne__CandidateResourceCapability__c.labelPlural}"/>
											</div>
										</div>

										<div class="title-card-body">
											<i class="save-btn action-btn fa fa-save" title="{!$Label.Save}"></i>
										</div>
									</div>
								</div>
							</div>
							<div id="resource-capabilities">
							</div>
						</div>
					</div>
				</apex:pageBlock>
				<apex:variable value="{!Resource.ResourceType__r.KimbleOne__ResourceClass__c}" var="resourceClass"/>

				<script>
		var defaultNumericRating = <apex:outputText value="{!DefaultNumericRating}"/>;
		var numericRatingOptions;

		var capabilityHierarchyDelimiter = '{!JSENCODE(CapabilityHierarchyDelimiter)}';
		var noneLabel = '<apex:outputText value="{!$Label.kimbleone__none}"/>';

		var CandidateResourceCapabilityMap = {};
		var CandidateResourceCapabilityIdsMap = {};

		jQuery(window).load(function()
		{
			initialise();
			getCandidateResourceCapabilities();
		});

		function initialise()
		{
			jQuery(document).off('click', '.browse-btn').on('click', '.browse-btn', fetchAllCapabilities);

			jQuery(document).off('click', '.save-btn.fa-save').on('click', '.save-btn.fa-save', saveAll);

			jQuery(document).off('click', '.remove-cap.action-btn').on('click', '.remove-cap.action-btn', toggleRemoveCapRow);

			jQuery(document).off('keyup', '#capability-type-filter').on('keyup', '#capability-type-filter', lookupCapabilities);
			jQuery(document).off('click', '#capability-search-results .cap-row').on('click', '#capability-search-results .cap-row', toggleSelect);
			jQuery(document).off('click', '#capability-search-results .breadcrumb-header').on('click', '#capability-search-results .breadcrumb-header', toggleCapabilityHeader);

			jQuery(document).off('change', '.rating-cell.BooleanRating input').on('change', '.rating-cell.BooleanRating input', booleanRatingChange);
			jQuery(document).off('change', '.rating-cell.NumericRating select').on('change', '.rating-cell.NumericRating select', numericRatingChange);
		}

		var capabilityLookupTimeout;

		function toggleRemoveCapRow()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			CandidateResourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;
			jQuery(this).closest('div.cap-row').addClass('has-changes');

			// remove
			if(jQuery(this).closest('div.cap-row').find('i.fa-trash').length)
			{
				CandidateResourceCapabilityIdsMap[capabilityTypeId].IsDeleted = true;
				jQuery(this).closest('div.cap-row').addClass('is-deleted');
				jQuery(this).closest('div.cap-row').find('.fa-trash').removeClass('fa-trash').addClass('fa-undo');
			}
			else
			{
				// undo
				CandidateResourceCapabilityIdsMap[capabilityTypeId].IsDeleted = false;
				jQuery(this).closest('div.cap-row').removeClass('is-deleted');
				jQuery(this).closest('div.cap-row').find('.fa-undo').removeClass('fa-undo').addClass('fa-trash');
			}

			setHasChanges();
		}

		function booleanRatingChange()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			CandidateResourceCapabilityIdsMap[capabilityTypeId].BooleanRating = jQuery(this).val();
			CandidateResourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;

			jQuery(this).closest('div.cap-row').addClass('has-changes');
			setHasChanges();
		}

		function numericRatingChange()
		{
			var capabilityTypeId = jQuery(this).closest('div.cap-row').attr('cap-id');
			CandidateResourceCapabilityIdsMap[capabilityTypeId].NumericRating = jQuery(this).val();
			CandidateResourceCapabilityIdsMap[capabilityTypeId].HasChanges = true;

			jQuery(this).closest('div.cap-row').addClass('has-changes');
			setHasChanges();
		}

		function setHasChanges()
		{
			jQuery(window).off('.has-changes').on('beforeunload.has-changes', function(){
		        return kimble.labels['UnsavedChangesHeading'] + "\n\n" + kimble.labels['UnsavedChangesMessage'];
		    });

			jQuery('.save-btn').addClass('has-changes');
		}

		function resetHasChanges()
		{
			jQuery('.save-btn').removeClass('has-changes');
			jQuery(window).off('.has-changes');
		}

		function toggleSelect()
		{
			var theCapabilityRow = jQuery(this);

			theCapabilityRow.find('.cap-state').toggleClass('fa-check-square');
			theCapabilityRow.find('.cap-state').toggleClass('fa-plus-square-o');

			var breadcrumb = jQuery('.breadcrumb-header[header-id="' + theCapabilityRow.attr('header-id') + '"]').text();
			var capTypeId = theCapabilityRow.attr('cap-id');

			if(theCapabilityRow.find('.cap-state').hasClass('fa-check-square'))
			{
				setHasChanges();

				var capability = {IsNew: true};
				capability.TypeId = capTypeId;
				capability.TypeName = theCapabilityRow.find('.type-name').text();

				capability.RatingType = (theCapabilityRow.hasClass('NumericRating') ? 'NumericRating' : 'BooleanRating');

				if(capability.RatingType == 'BooleanRating')
				{
					capability.BooleanRating = true;
				}
				else if(capability.RatingType == 'NumericRating')
				{
					capability.NumericRating = defaultNumericRating;
				}

				if(!(breadcrumb in CandidateResourceCapabilityMap)) CandidateResourceCapabilityMap[breadcrumb] = [];

           		CandidateResourceCapabilityMap[breadcrumb].push(capability);
           		CandidateResourceCapabilityIdsMap[capTypeId] = capability;
			}
			else
			{
				var remainingCapabilityMap = [];

				for(var capabilityCounter = 0; capabilityCounter < CandidateResourceCapabilityMap[breadcrumb].length; capabilityCounter++)
			    {
					var capability = CandidateResourceCapabilityMap[breadcrumb][capabilityCounter];
					if(capability.TypeId != capTypeId)
					{
						remainingCapabilityMap.push(capability);
					}
			    }

			    if(remainingCapabilityMap.length)
			    {
			    	CandidateResourceCapabilityMap[breadcrumb] = remainingCapabilityMap;
		    	}
		    	else
		    	{
		    		// nothing left - remove the header
		    		delete CandidateResourceCapabilityMap[breadcrumb];
		    	}

           		delete CandidateResourceCapabilityIdsMap[capTypeId];
			}

			drawCandidateResourceCapabilities();
		}

		function toggleCapabilityHeader()
		{
			var theCapabilityHeaderRow = jQuery(this);
			jQuery('.cap-row[header-id="' + theCapabilityHeaderRow.attr('header-id') + '"]').toggle();
		}

		function getCandidateResourceCapabilities()
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.CandidateResourceProfileController.GetCandidateResourceCapabilities}',
				'{!Resource.Id}',
				function(result, event)
				{
					if (event.status)
					{
						numericRatingOptions = result.NumericRatingOptions;
						buildCapabilityMap(result.Capabilities, CandidateResourceCapabilityMap);
						drawCandidateResourceCapabilities(true);
					}
					else if (event.type === 'exception')
					{
						alert(event.message);
					}
					else
					{
						alert(event.message);
					}
				},
				{escape: true, timeout: 60000});
		}

		function drawCandidateResourceCapabilities(andSearch)
		{
			var html = '';

			var sortedCapabilityMapKeys = [];

			if(Object.keys(CandidateResourceCapabilityMap).length)
			{
				html += '<div class="cap-row header-row">';
				html += '<div class="type-name"></div>';
				html += '<div class="rating-cell">' + '<apex:outputText value="{!$ObjectType.KimbleOne__CandidateResourceCapability__c.Fields.KimbleOne__NumericRating__c.Label}"/>' + '</div>';
				html += '</div>';

				sortedCapabilityMapKeys = Object.keys(CandidateResourceCapabilityMap).sort();
			}

			for(var breadcrumbCounter = 0; breadcrumbCounter < sortedCapabilityMapKeys.length; breadcrumbCounter++)
			{
			    var breadcrumb = sortedCapabilityMapKeys[breadcrumbCounter];
				html += '<div class="breadcrumb-header">' + breadcrumb + '</div>';

				if(CandidateResourceCapabilityMap[breadcrumb].length)
				{
					var sortedCapabilities = CandidateResourceCapabilityMap[breadcrumb].sort(typeNameSort);

				    for(var capabilityCounter = 0; capabilityCounter < sortedCapabilities.length; capabilityCounter++)
				    {
						var capability = sortedCapabilities[capabilityCounter];
						html += '<div class="cap-row ' + (capabilityCounter == sortedCapabilities.length - 1 ? 'last-row' : '') + (capability.IsNew ? ' new' : '') + (capability.HasChanges ? ' has-changes' : '') + (capability.IsDeleted ? ' is-deleted' : '') + (capability.RatingType ? ' ' + capability.RatingType : '') + '" cap-id="' + capability.TypeId + '"' + (capability.Id ? ' res-cap-id="' + capability.Id + '"' : '') + '>';
						html += '<div class="remove-cap action-btn"><i class="fa fa-trash"></i></div>';

						html += '<div class="type-name">' + capability.TypeName + '</div>';
						html += '<div class="rating-cell ' + capability.RatingType + '">';
						if(capability.RatingType == 'NumericRating')
						{
							html += '<select>';
							html += '<option ' + (capability.NumericRating ? '' : ' selected') + '>' + noneLabel + '</option>';
							for(var optionCounter = 0; optionCounter < Object.keys(numericRatingOptions).length; optionCounter++)
							{
								var theOption = numericRatingOptions[Object.keys(numericRatingOptions)[optionCounter]];
								html += '<option value="' + theOption.id + '"' + (capability.NumericRating == theOption.id ? ' selected' : '') + ( theOption.info != undefined && theOption.info != '' ? ' title="' + theOption.info + '"' : '') + '>' + theOption.text + '</option>';
							}
							html += '</select>';
						}
						else if(capability.RatingType == 'BooleanRating')
						{
							html += '<input type="checkbox"' + (capability.BooleanRating ? ' checked="checked"' : '') + '/>';
						}
						html += '</div>';
						html += '</div>';

						CandidateResourceCapabilityIdsMap[capability.TypeId] = capability;
				    }
			    }
			}

			jQuery('#resource-capabilities').html(html);

			if(andSearch) fetchAllCapabilities();

			initialiseCandidateResourceCapabilityActions();
		}

		function typeNameSort(a,b)
		{
			if (a.TypeName < b.TypeName)
				return -1;

			if (a.TypeName > b.TypeName)
				return 1;

			return 0;
		}

		function initialiseCandidateResourceCapabilityActions()
		{
			jQuery('.kimbleDatePicker').datepicker({
		   		dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true
			});
		}

		function lookupCapabilities()
		{
			window.clearTimeout(capabilityLookupTimeout);

			var term = jQuery(this).val();

			if(term.length < 2)
			{
				return;
			}

			capabilityLookupTimeout = window.setTimeout(function() {

				jQuery('.searching-ind').removeClass('hidden-item');
				jQuery('#capability-type-filter').prop('readonly', true);

				Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.CandidateResourceProfileController.LookupCapabilities}',
					term, '{!JSENCODE(resourceClass)}',
					function(result, event)
					{
						if (event.status)
						{
							var capabilityMap = {};
							buildCapabilityMap(result, capabilityMap, CandidateResourceCapabilityIdsMap);
							drawSearchResult(capabilityMap);
						}
						else if (event.type === 'exception')
						{
							alert(event.message);
						}
						else
						{
							alert(event.message);
						}

						jQuery('.searching-ind').addClass('hidden-item');
						jQuery('#capability-type-filter').prop('readonly', false);
					},
					{escape: true, timeout: 60000}
			)}, 1000);
		}

		function fetchAllCapabilities()
		{
			jQuery('.searching-ind').removeClass('hidden-item');
			jQuery('#capability-type-filter').prop('readonly', true);

			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.CandidateResourceProfileController.LookupCapabilities}',
				'', '{!JSENCODE(resourceClass)}',
				function(result, event)
				{
					if (event.status)
					{
						var capabilityMap = {};
						buildCapabilityMap(result, capabilityMap, CandidateResourceCapabilityIdsMap);
						drawSearchResult(capabilityMap, true);
					}
					else if (event.type === 'exception')
					{
						alert(event.message);
					}
					else
					{
						alert(event.message);
					}

					jQuery('.searching-ind').addClass('hidden-item');
					jQuery('#capability-type-filter').prop('readonly', false);
				},
				{escape: true, timeout: 60000});
		}

		function drawSearchResult(capabilityMap, collapsed)
		{
			var html = '';

			for(var breadcrumbCounter = 0; breadcrumbCounter < Object.keys(capabilityMap).length; breadcrumbCounter++)
			{
			    var breadcrumb = Object.keys(capabilityMap)[breadcrumbCounter];
				html += '<div class="breadcrumb-header" header-id="' + breadcrumbCounter + '">' + breadcrumb + '</div>';

			    for(var capabilityCounter = 0; capabilityCounter < capabilityMap[breadcrumb].length; capabilityCounter++)
			    {
					var capability = capabilityMap[breadcrumb][capabilityCounter];

					html += '<div header-id="' + breadcrumbCounter + '" class="cap-row' + (collapsed ? ' collapsed' : '') + (capability.RatingType ? ' ' + capability.RatingType : '') + '" cap-id="' + capability.TypeId + '">';
					html += '<div class="type-name">' + capability.TypeName + '</div>';
					html += '<i class="cap-state fa fa-plus-square-o"></i>';
					html += '</div>';
			    }
			}

			jQuery('#capability-search-results').html(html);

			jQuery("#capability-search-results ").animate({ scrollTop: 0 }, "fast");
		}

		function buildCapabilityMap(result, capabilityMap, excludeCapabilityIdsMap)
		{
			var input = result;
			var output = [];

			for (var i = 0; i < input.length; i++)
			{
				var theCapabilityType = input[i];

				// restricted capability details will not be returned
    			if(theCapabilityType.TypeSearchName == undefined) continue;

			    var chain = theCapabilityType.TypeSearchName.split(capabilityHierarchyDelimiter);
			    var currentNode = output;

			    for (var j = 0; j < chain.length; j++)
			    {
			        var wantedNode = chain[j];
			        var lastNode = currentNode;

			        for (var k = 0; k < currentNode.length; k++)
			        {
			            if (currentNode[k].name == wantedNode)
			            {
			                currentNode = currentNode[k].children;
			                break;
			            }
			        }

			        // If we couldn't find an item in this list of children
			        // that has the right name, create one:
			        if (lastNode == currentNode)
			        {
			            var newNode = currentNode[k] = {name: wantedNode, children: []};

			            if(j == (chain.length - 1))
			            {
			            	newNode.capabilityId = theCapabilityType.TypeId;
			            	var breadcrumb = chain.slice(0, chain.length-1).join(' > ');

			            	// only push if not excluded (already selected)
			            	if(excludeCapabilityIdsMap == undefined || excludeCapabilityIdsMap && !(newNode.capabilityId in excludeCapabilityIdsMap))
			            	{
				            	if(!(breadcrumb in capabilityMap)) capabilityMap[breadcrumb] = [];
			            		capabilityMap[breadcrumb].push(theCapabilityType);
		            		}
		            	}
			            currentNode = newNode.children;
			        }
			    }
			}
		}

		function saveAll()
		{
			var saveBtn = jQuery(this)

			// build list of capabilities from page
			var theRows = jQuery('#resource-capabilities .cap-row.has-changes, #resource-capabilities .cap-row.new');

			var capabilitiesToUpsert = [];
			for(var rowCounter = 0; rowCounter < theRows.length; rowCounter++)
		    {
				var theCapabilityRow = jQuery(theRows[rowCounter]);

				var capability = {};

				if(theCapabilityRow.attr('res-cap-id') != undefined && theCapabilityRow.attr('res-cap-id') != '')
				{
					capability.Id = theCapabilityRow.attr('res-cap-id');
				}
				capability.TypeId = theCapabilityRow.attr('cap-id');

				if(theCapabilityRow.find('.rating-cell.NumericRating').length && theCapabilityRow.find('.rating-cell.NumericRating select').val() != noneLabel) capability.NumericRating = theCapabilityRow.find('.rating-cell.NumericRating select').val();
				if(theCapabilityRow.find('.rating-cell.BooleanRating').length) capability.BooleanRating = theCapabilityRow.find('.rating-cell.BooleanRating input').prop('checked');

				capability.IsDeleted = theCapabilityRow.hasClass('is-deleted');

	    		capabilitiesToUpsert.push(capability);
		    }

			if(!capabilitiesToUpsert.length)
			{
				resetHasChanges();
				return;
			}

			saveBtn.removeClass('fa-save').addClass('fa-circle-o-notch').addClass('fa-spin');
			jQuery('#capability-type-filter').prop('readonly', true);

			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.CandidateResourceProfileController.SaveCandidateResourceCapabilities}',
				'{!Resource.Id}', capabilitiesToUpsert,
				function(result, event)
				{
					if (event.status)
					{
						resetHasChanges();
						CandidateResourceCapabilityMap = {};
						numericRatingOptions = result.NumericRatingOptions;
						buildCapabilityMap(result.Capabilities, CandidateResourceCapabilityMap);
						drawCandidateResourceCapabilities();
					}
					else if (event.type === 'exception')
					{
						alert(event.message);
					}
					else
					{
						alert(event.message);
					}

					saveBtn.addClass('fa-save').removeClass('fa-circle-o-notch').removeClass('fa-spin');
					jQuery('#capability-type-filter').prop('readonly', false);
				},
				{escape: true, timeout: 60000});
		}
	</script>
			</apex:outputPanel>
		</apex:define>
	</apex:composition>
</apex:page>