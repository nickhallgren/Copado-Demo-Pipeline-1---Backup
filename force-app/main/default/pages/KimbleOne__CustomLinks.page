<apex:page controller="KimbleOne.CustomLinksController" sidebar="false">
    <apex:composition template="KimbleOne__SiteMaster">
        <apex:define name="Content">

            <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>

            <style>
                a.page-link {
                    display: block;
                    padding: 10px 15px;
                    border-bottom: 1px solid #DDD;
                    background-color: white;
                    border-radius: 3px;
                    height: 26px;
                }
                .link-icon {
                    font-size: 26px;
                    vertical-align: middle;
                    width: 35px;
                    margin-right: 10px;
                    text-align: center;
                    display: inline-block;
                }
                .linkText {
                    display: inline-block;
                    padding-top: 8px;
                }
                .all-links {
                    display: block;
                }
                a.page-link:hover {
                    background-color: #e3f3ff;
                }               
            </style>

            <div class="all-links">
            <apex:repeat value="{!TheLinks}" var="theLink">
                <apex:outputLink styleClass="page-link" value="{!theLink.PageRef}" rendered="{!!ISBLANK(theLink.PageRef)}"><i class="{!IF(ISBLANK(theLink.StyleClass), '', theLink.StyleClass)} link-icon"></i><div class="linkText"><apex:outputText value="{!theLink.Name}"/></div></apex:outputLink>
            </apex:repeat>
            </div>
        </apex:define>
    </apex:composition>
</apex:page>