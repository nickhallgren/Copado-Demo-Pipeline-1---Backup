        function getAssignmentRowHtml(a, selected, loseAssignment)
        {
            var accessObj = initialResult.ActivityAccessMap[getFieldValue(a, activityIdField)];

            var parentId = getFieldValue(a, parentIdField);

            if (parentId == '') parentId = null;

            var noParent = (parentId == null);
            var supportedAssignment = (noParent || getFieldValue(a, parentTypeField) == 'AppliedModel');

            var hasAccess = false;

            var assignmentType = getFieldValue(a, assignmentTypeEnumField);

            if (accessObj != null)
            {
                if (accessObj.HasEditAccess && getFieldValue(a, probabilityField) != 'P0' && assignmentType != 'AppliedModel' && assignmentType != 'ActivatedModel')
                    hasAccess = true;
            }
            else
            {
                // is this a new
                hasAccess = jQuery('#' + getFieldValue(a, activityIdField)).length > 0;
            }

            if (hasAccess) {
                hasAccess = initialResult.ResourceAccessMap[getFieldValue(a, resourceIdField)];
            }

            var hasTorE = (getFieldValue(a, timeEntryCountField) > 0 || getFieldValue(a, expenseItemDateField) != '' )
            var isProfiled = getFieldValue(a, isProfiledField);
            var isModelAssigment = (assignmentType == 'Model' || assignmentType == 'AppliedModel' || assignmentType == 'ActivatedModel');

            var row = '<tr ' + (parentId != null?'parent-id="' + parentId  + '"':'') + ' class="dataRow ' + (a[activityAssignmentsField] != null?' branch ':'') + (!supportedAssignment?' candidate sortable-child-row ':'') + (!hasAccess?'read-only':'') + '" assignment-id="' + a.Id + '" id="' + a.Id + '" activity-id="' + getFieldValue(a, activityIdField) + '" ass-type="' + getFieldValue(a, assignmentTypeEnumField) + '" lose-ass="' + loseAssignment + '" + has-tore="' + hasTorE + '">';

            //checbox
            row += '<td>';

            if (hasAccess) row += '<input class="select-assignment" ' + (selected ? 'checked="true" ':'') + ' name="ActivityAssignments" type="checkbox"/>';

            row += '</td>';

            //cog
            row += '<td>' + (hasAccess && supportedAssignment?'<i class="fa fa-cog assignment-actions"/>':'') + '</td>';

            //activity
            if (initialResult.ShowActivity)
            {
                row += '<td>' + getFieldValue(a, activityField) + '</td>';
            }

            //resource
            row += '<td class="' + (hasAccess && supportedAssignment && !isModelAssigment ?'editable':'readonly') + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.Resource__c.Name}"><div class="edit-field"><span class="indent"/>' + getFieldValue(a, resourceField) + '<i class="fa fa-pencil"/></div></td>';

            //role

            if (supportedAssignment)
                row += '<td class="' + (hasAccess?'editable':'readonly') + '" match-on="' + getFieldValue(a, resourcedActivityTypeField) + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.ActivityRole__c.Name}"><div class="edit-field">' + getFieldValue(a, roleField) + '<i class="fa fa-pencil"/></div></td>';
            else
                row += '<td class="">{!JSENCODE($Label.ProposedCandidate)}</td>';

            //location
            if (showLocation)
            {
                if (supportedAssignment)
                    row += '<td class="' + (hasAccess && supportedAssignment?'editable':'readonly') + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.Location__c.Name}"><div class="edit-field">' + getFieldValue(a, locationField) + '<i class="fa fa-pencil"/></div></td>';
                else
                    row += '<td class="">-</td>';
            }

            //revenue rate
            if (supportedAssignment)
            {
                var revUnits = getFieldValue(a, revenueEntryUnitType);
                if (revUnits == '') revUnits = getFieldValue(a, invoiceUnitType);

                var fEnum = getFieldValue(a, forecastUnitTypeEnumField);
                var rEnum = getFieldValue(a, revenueEntryUnitTypeEnumField);
                if (rEnum == '') rEnum = getFieldValue(a, invoiceUnitTypeEnumField);

                var rateFactor = 1;

                if (rEnum == 'Month') {
                    // need to convert day/hour to month
                     if (fEnum == 'Day')
                        rateFactor = dayToRevenueEntryConversionFactor;
                     else
                        rateFactor = dayToRevenueEntryConversionFactor *  getFieldValue(a, hoursPerDayField);
                }
                else {
                    if  (rEnum != fEnum) {
                         if (fEnum == 'Day')
                            rateFactor = 1 / getFieldValue(a, hoursPerDayField);
                        else
                            rateFactor = getFieldValue(a, hoursPerDayField);
                    }
                }

                var revRate = getFieldValue(a, revenueRateField) * rateFactor;

                row += '<td class="' + (hasAccess?'editable':'readonly') + '" match-on="' + getFieldValue(a, invoicingCurrencyCodeField) + revUnits + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.InvoicingCurrencyForecastRevenueRate__c.Name}" data-sort-type="number" data-sort-value="' + revRate + '"><div class="edit-field">' + getFieldValue(a, invoicingCurrencyCodeField) + '&nbsp;' + kimble.formatNumber(revRate, '#,##0.00') + '&nbsp;/&nbsp;' + revUnits + '<i class="fa fa-pencil"/></div></td>';
            }
            else
                row += '<td>-</td>';

            //cost rate
            if ({!$ObjectType.ActivityAssignment__c.fields.TemporalForecastCostRate__c.Updateable})
            {
                var temporalCost = getFieldValue(a, temporalForecastCostRateField);

                if (temporalCost != '') {
                    var costs = parseCostSummaryJson(temporalCost);

                    //Need to convert from Forecast Unit Type To Invoice unit type!
                    var fEnum = getFieldValue(a, forecastUnitTypeEnumField);
                    var iEnum = getFieldValue(a, invoiceUnitTypeEnumField);

                    var costVal = costs[costs.length-1].R;

                    if (fEnum != iEnum) {
                        if (fEnum == 'Day')
                            costVal = costVal / getFieldValue(a, hoursPerDayField);
                        else
                            costVal = costVal * getFieldValue(a, hoursPerDayField);
                    }

                    row += '<td class="' + (getFieldValue(a, canEditCostField) == true && hasAccess && supportedAssignment?'editable':'readonly') + '" match-on="' + getFieldValue(a, currencyCodeField) + getFieldValue(a, invoiceUnitType) + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.InvoicingCostRate__c.Name}" data-sort-type="number" data-sort-value="' + costVal + '"><div class="edit-field">' + getFieldValue(a, currencyCodeField) + '&nbsp;' + kimble.formatNumber(costVal, '#,##0.00') + '&nbsp;/&nbsp;' + getFieldValue(a, invoiceUnitType) + '<i class="fa fa-pencil"/></div></td>';
                }
                else {
                    row += '<td></td>';
                }
            }

            var entrySpec = usageBehaviorRulesMap[getFieldValue(a, usageBehaviourFieldId)].EntrySpecification;

            //start date
            row += '<td class="' + (hasAccess && entrySpec != 'TaskUsage'?'editable':'readonly') + ' apply-date-sort" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.StartDate__c.Name}"><div class="edit-field">' + kimble.formatDate(kimble.UTCStringFromMilliseconds(getFieldValue(a, startDateField))) + '<i class="fa fa-pencil"/></div></td>';

            //end date
            row += '<td class="' + (hasAccess && !isProfiled && entrySpec != 'DerivedEndDate' && entrySpec != 'TaskUsage'?'editable':'readonly') + ' apply-date-sort" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.ForecastP3EndDate__c.Name}"><div class="edit-field">' + kimble.formatDate(kimble.UTCStringFromMilliseconds(getFieldValue(a, endDateField))) + '<i class="fa fa-pencil"/></div></td>';

            //usage behaviour
            row += '<td class="' + (hasAccess && !isProfiled?'editable':'readonly') + '" match-on="' + getFieldValue(a, activityIdField) + '"  data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.UsageBehaviourRule__c.Name}"><div class="edit-field">' + getFieldValue(a, usageBehaviourField) + '<i class="fa fa-pencil"/></div></td>';

            //remaining usage
            row += '<td class="' + (hasAccess && !isProfiled && entrySpec != 'DerivedUsage' && entrySpec != 'TaskUsage' && entrySpec != 'NoForecast'?'editable':'readonly') + '" match-on="' + getFieldValue(a, forecastUnitTypeField) + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.EntryRemainingUsage__c.Name}" data-sort-type="number" data-sort-value="' + getFieldValue(a, remainingUsageField) + '"><div class="edit-field">' + kimble.formatNumber(getFieldValue(a, remainingUsageField),'#,##0.##') + '&nbsp;' + getFieldValue(a, forecastUnitTypeField) + '<i class="fa fa-pencil"/></div></td>';

            //utilisation
            row += '<td class="' + (hasAccess && !isProfiled && entrySpec != 'DerivedUtilisation' && entrySpec != 'TaskUsage' && entrySpec != 'NoForecast'?'editable':'readonly') + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.BaselineUtilisationPercentage__c.Name}"  data-sort-type="number" data-sort-value="' + getFieldValue(a, utilisationField) + '"><div class="edit-field">' + kimble.formatNumber(getFieldValue(a, utilisationField),'#,##0') + '%<i class="fa fa-pencil"/></div></td>';

            if(showMaxUsage)
            {
                var mx = usageBehaviorRulesMap[getFieldValue(a, usageBehaviourFieldId)].ShowMaxUsage;
                var v = '-';

                if (mx && getFieldValue(a, maxUsageField) != '') v = kimble.formatNumber(getFieldValue(a, maxUsageField),'#,##0.##') + '&nbsp;' + getFieldValue(a, forecastUnitTypeField);

                row += '<td class="' + (hasAccess && !isProfiled && mx?'editable':'readonly') + '" match-on="' + getFieldValue(a, forecastUnitTypeField) + '" data-fld-name="{!$ObjectType.ActivityAssignment__c.Fields.MaximumUsage__c.Name}"><div class="edit-field">' + v + '<i class="fa fa-pencil"/></div></td>';
            }

            //field sets
            for (var j=0;j<customFields.length;j++)
            {
               var fldVal = getFieldValue(a, customFields[j]);

               var fldType = initialResult.TheFieldSets[customFields[j]].DisplayType;

               var val;
               var isNumeric = false;
               if (fldVal == '')
               {
                   val = '';
               }
               else if (fldType == 'INTEGER' || fldType == 'LONG')
			   {
					val = kimble.formatNumber(fldVal, '#,###');
					isNumeric = true;
			   }
               else if (fldType == 'DOUBLE' || fldType == 'PERCENT')
               {
                    val = kimble.formatNumber(fldVal, '#,###.####');
                    isNumeric = true;
               }
               else if (fldType == 'DATE')
               {
                    val = kimble.formatDate(kimble.UTCStringFromMilliseconds(fldVal));
               }
               else
               {
                    val = fldVal;
               }

               var sortHtml = '';

               if (isNumeric) sortHtml = 'data-sort-type="number" data-sort-value="' + fldVal + '"';

               row += '<td class="' + (hasAccess && initialResult.TheFieldSets[customFields[j]].IsEditable?'editable':'readonly') + '" data-fld-name="' + initialResult.TheFieldSets[customFields[j]].FieldName + '" ' + sortHtml + ' ><div class="edit-field">' + val + '<i class="fa fa-pencil"/></div></td>';

            }

           row += '</tr>';

            return row;
        }

        function parseCostSummaryJson (j)
        {
            return kimble.parseJSON(j.replace(/"CostRate"/g, '"R"').replace(/"FromDate"/g, '"D"'));
        }

        function newActivityAssignmentClick(activityId)
        {
            initialiseModalBoxy('#ActivityAssignmentNewEdit', '{!JSENCODE($Label.New)} {!$ObjectType.ActivityAssignment__c.label}');
            ActivityAssignmentNewEdit.newAssignment(activityId);
        }

        function editActivityAssignmentClick(assignmentId)
        {
            jQuery('.assignment-tools').qtip('destroy', true);
            initialiseModalBoxy('#ActivityAssignmentNewEdit', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ActivityAssignment__c.label}');
            ActivityAssignmentNewEdit.getAssignmentToEdit(assignmentId);
        }

        function editAssignmentRatesClick(assignmentId)
        {
            jQuery('.assignment-tools').qtip('destroy', true);
            initialiseModalBoxy('#ActivityAssignmentRates', '{!$ObjectType.ActivityAssignmentRate__c.labelPlural}', jQuery('form[id$=\'TheForm\']'));
		    ActivityAssignmentRates.getAssignmentRates(assignmentId);
        }

	    function editAssignmentCalendarClick(assignmentId)
	    {
	        jQuery('.assignment-tools').qtip('destroy', true);
	        openAssignmentCalendar(assignmentId);
	    }

	    function editAssignmentNotesClick(assignmentId)
	    {
	        jQuery('.assignment-tools').qtip('destroy', true);
	        initialiseModalBoxy('#NotesPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ActivityAssignment__c.label} {!$ObjectType.ActivityAssignment__c.Fields.LongNotes__c.label}');
		    loadAssignmentNotes(assignmentId);
        }

        function loseAssignmentClick(assignmentId)
        {
            jQuery('.assignment-tools').qtip('destroy', true);
            initialiseModalBoxy('#LostAssignmentPopup', '{!JSENCODE($Label.Cancel)} {!$ObjectType.ActivityAssignment__c.label}');
		    loadActivityAssignmentToLose(assignmentId);
        }

        function deleteActivityAssignmentClick(assignmentId)
        {
            jQuery('.assignment-tools').qtip('destroy', true);

            var del = false;

            del = confirmDelete();

            if (del)
            {
                jQuery('#' + assignmentId + ' .assignment-actions').addClass('Loading');

                deleteTheActivityAssignment(assignmentId, function(){
                     jQuery('#' + assignmentId + ' .assignment-actions').removeClass('Loading');
                });
            }
        }

        function cloneActivityAssignmentClick(assignmentId)
        {
            jQuery('.assignment-tools').qtip('destroy', true);
            initialiseModalBoxy('#CloneAssignmentPopup', '{!$ObjectType.ActivityAssignment__c.label}');
		    initialiseClone(assignmentId);
        }

        function showEditPopup()
        {
            jQuery('[id$="action-type"]')[0].selectedIndex = 0;
            showModalBoxy();
            if(onpopupload != null) onpopupload();
        }

</script>
            <apex:form id="TheForm">

                <apex:actionRegion >
