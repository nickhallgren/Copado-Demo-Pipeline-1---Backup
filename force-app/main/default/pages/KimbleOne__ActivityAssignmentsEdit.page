        function changeOptionsChange()
        {
            var action = jQuery('[id$="action-type"').val();
            var parent = jQuery('[id$="action-type"').closest('td');

            parent.find('input').val('').change();

            if  (action == 'ShiftStartDateByDays')
            {
                parent.find('.start-date-offset').show();
                parent.find('.dateInput').hide();
            }
            else
            {
                parent.find('.start-date-offset').hide();
                parent.find('.dateInput').show();
            }
        }

        function saveAssignmentUpdates()
        {
            if(jQuery('[id$="EditFieldError"] > span')[0].children.length > 0) return;

            jQuery('#loadingIndicatorOuterContainer').show();

            jQuery('.save-problem').qtip('destroy', true);
            jQuery('.save-problem').remove();

            jQuery('#PopupContents .btn').prop('disabled', true).addClass('btnDisabled');

            assignmentsToSave = {};

            var selectedAssignmentId = jQuery('#PopupContents').attr('assignment-id');

            totalPages = 1;
            processedPages = 0;

            if (jQuery('#selected-records').is(':checked')) {

                if (jQuery('#' + selectedAssignmentId + ' input').is(':checked') == false)
                    jQuery('#' + selectedAssignmentId).find('input').prop('checked', true);

                var fldName = jQuery('#PopupContents').attr('data-field-name');

                jQuery.each(jQuery('.select-assignment:checked'), function(i, inp){

                    var $row = jQuery(inp).closest('tr');

                    if ($row.find('[data-fld-name = "' + fldName + '"]').hasClass('editable'))
                    {
                        var activityId = $row.attr('activity-id');

                        if (assignmentsToSave[activityId] == null)
                            assignmentsToSave[activityId] = [[]];

                        var lastActivityArray = assignmentsToSave[activityId][assignmentsToSave[activityId].length-1];

                        //if last array size < 100 then add to it
                        if (lastActivityArray.length < 50)
                        {
                            lastActivityArray.push($row.attr('assignment-id'));
                        }
                        else
                        {
                            assignmentsToSave[activityId].push([]);
                            assignmentsToSave[activityId][assignmentsToSave[activityId].length-1].push($row.attr('assignment-id'));
                            totalPages ++;
                        }
                    }
                });
            }
            else
            {
                $row = jQuery('#' + selectedAssignmentId);

                assignmentsToSave[$row.attr('activity-id')] = [[selectedAssignmentId]];
            }

            saveAllSelectedAssignments();
		}

        function saveAllSelectedAssignments()
        {
            if (Object.keys(assignmentsToSave).length == 0)
            {
                 jQuery('#PopupContents .btn').prop('disabled', false).removeClass('btnDisabled');

		         jQuery('#loadingIndicatorOuterContainer').hide();

                 hideModalBoxy();

                 if (jQuery('.save-problem').length > 0)
                    alert('{!JSENCODE($Label.OneOrMoreItemsHaveAnError)}');

                 drawAssignmentsComplete();

		         return;
            }

            var activityId = Object.keys(assignmentsToSave)[0];

            var selectedAssignments = assignmentsToSave[activityId].shift();

            if (assignmentsToSave[activityId].length == 0) delete assignmentsToSave[activityId];

            saveArrayOfAssignments(selectedAssignments, saveAllSelectedAssignments);
        }

        var processedPages;

        function saveArrayOfAssignments(selectedAssignments, oncomplete)
        {
            var fldName = jQuery('#PopupContents').attr('data-field-name');
            var fldValue = getUpdateFieldValue();

            var action = jQuery('[id$="action-type"').val();

            if(action == 'ShiftStartDateByDays')
                fldValue = jQuery('.start-date-offset').val();


            if (action == null || action == '') action = 'UpdateValue'

            if (totalPages > 1) jQuery('#save-progress').show().find('span').text('{!JSENCODE($Label.SavingBulkAssignmentsProgress)}'.format(processedPages, totalPages));

            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentsEditController.SaveAssignments}',
       		    selectedAssignments, fldName, action, fldValue,
      			function(result, event){
             		if (event.status)
		            {
		             	//show update problems
                        jQuery.each(jQuery(result.Problems), function (i, p) {

                            var $row = jQuery('#' + p.Id);
                            $row.find('td:first').append(jQuery('<i class="fa fa-exclamation-circle save-problem" title="' + p.Message +  '"/>'));
                        });

                        jQuery('.save-problem').qtip({style: {classes: 'qtip-light hide-qtip-border'}});

                        //replace rows
                        jQuery.each(jQuery(result.TheAssignments), function(i, a)
                        {
                            var $row = jQuery('#' + a.Id);

                            $row.fadeOut(1000, function() {
                               var $newRow = jQuery(getAssignmentRowHtml(a, true));
                               if ($row.hasClass('expanded')) $newRow.addClass('expanded');
                               $newRow.insertAfter(jQuery(this).hide());
                               jQuery(this).remove();
                               $newRow.fadeIn(1000);
                            });
                        });
		         	}
		         	else if (event.type === 'exception')
		         	{
		             	alert(event.message);
		         	}
		         	else
		         	{
		             	alert(event.message);
		         	}

                    processedPages ++;

                    oncomplete();

		         },
		         {escape: false, timeout: 60000});
        }

        function refreshAssignmentsById(assignmentIds)
        {
            jQuery('#loadingIndicatorOuterContainer').show();

            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentsEditController.GetAssignmentsById}',
       		    assignmentIds,
      			function(result, event){
             		if (event.status)
		            {
		             	jQuery.each(jQuery(result), function(i, a)
                        {
                            var $row = jQuery('#' + a.Id);

                            if ($row.length == 0)
                            {
                                var $tbl = jQuery('#assignments-table');
                                var $newRow = jQuery(getAssignmentRowHtml(a, false));
                                $tbl.find('tbody').prepend(jQuery($newRow));

                                $newRow.hide().fadeIn(1000);
                            }
                            else
                            {
                                $row.fadeOut(1000, function() {
                                   var $newRow = jQuery(getAssignmentRowHtml(a, false));
                                   if ($row.hasClass('expanded')) $newRow.addClass('expanded');
                                   $newRow.insertAfter(jQuery(this).hide());
                                   jQuery(this).remove();
                                   $newRow.fadeIn(1000);
                                });
                             }
                        });
		         	}
		         	else if (event.type === 'exception')
		         	{
		             	alert(event.message);
		         	}
		         	else
		         	{
		             	alert(event.message);
		         	}

		         	jQuery('#loadingIndicatorOuterContainer').hide();
		         },
		         {escape: false, timeout: 60000});
        }

        function getUpdateFieldValue()
		{
		    var $inp = jQuery('.input-value');

            if (jQuery('#PopupContents').attr('data-field-name') == '{!$ObjectType.ActivityAssignment__c.Fields.InvoicingCostRate__c.Name}') {

                var costUpdate = {EffectiveDate: kimble.parseDate(jQuery('.effective-date').val()), Value:kimble.parseNumber($inp.val())};

                return JSON.stringify(costUpdate);
            }

            if ($inp.is(':checkbox')) return $inp.is(':checked');

            var typ = $inp.attr('data-field-type');
            var val = null;

            if (typ == 'REFERENCE')
			{
			    val = $inp.closest('td').find('[id $= "lkid"]').val();
			}
			else if (typ == 'INTEGER' || typ == 'LONG')
			{
				val = kimble.parseNumber($inp.val(), '#,###');
			}
			else if (typ == 'DOUBLE' || typ == 'PERCENT')
			{
				val = kimble.parseNumber($inp.val(),'#,###.####');
			}
			else if (typ == 'DATE')
			{
				val = kimble.parseDate($inp.val());
			}
			else
			{
				val = $inp.val();
			}

           return val;
        }

