                        <apex:param name="assignmentId" value="" />
                        <apex:param name="fieldName" value="" />
                        <apex:param name="count" value="" />
                    </apex:actionFunction>
                </apex:actionRegion>

                <div id="EditFieldPopup" style="display:none" >
