            {
                html += '<th class="headerRow sortable"><h2>{!$ObjectType.ActivityAssignment__c.Fields.Location__c.Label}</h2></th>';
            }

            html += '<th class="headerRow sortable"><h2>{!$ObjectType.ActivityAssignment__c.Fields.TemporalForecastRevenueRate__c.Label}</h2></th>';

