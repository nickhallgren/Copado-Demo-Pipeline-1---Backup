        function drawAssignments(result)
        {
            var $tbl = jQuery('#assignments-table');
            jQuery('.table-filter').remove();

            $tbl.find('thead').empty().append(getTableHeaderHtml());
            $tbl.find('tbody').empty();

            var html = '';

            for (var i=0;i<result.TheAssignments.length;i++)
            {
                var a = result.TheAssignments[i];

                var row = getAssignmentRowHtml(a, false, result.RecordLostReasonAssignments.includes(a.Id));

                $tbl.find('tbody').append(jQuery(row));

                if (a[activityAssignmentsField] != null)
                {
                    var candidates = a[activityAssignmentsField];

                    for(var j=0;j<candidates.length;j++)
                    {
                        var candidateRow = getAssignmentRowHtml(candidates[j], false, false);

                        $tbl.find('tbody').append(jQuery(candidateRow));
                    }
                }
            }

            drawAssignmentsComplete();
        }

