                <div id="AssignmentFilterPopup" style="display:none;">
                    <!-- var assignmentFilter = []; function refreshActivities() -->
                    <div id="AssignmentFilters">
                        <div class="assignment-filter-header">{!$Label.AssignmentsFilter}<i onclick="jQuery('#AssignmentFilterPopup').hide();" class="filter-collapse-btn fa fa-angle-double-up" title="{!$Label.Close}"></i></div>

                        <apex:outputPanel layout="none" rendered="{!EnableLostAssignmentsFilter}">
                            <div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!$Label.kimbleone__showcancelledassignments}
                                <apex:inputField id="showLostAssignmentsCheckbox" value="{!ShowLostAssignments.KimbleOne__InputCheckbox__c}" style="margin-bottom: 0px; vertical-align: bottom;" /></div>
                        </apex:outputPanel>

                        <apex:repeat value="{!TheFilterCriteria}" var="criterion">

                            <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'REFERENCE'}">
                                <div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!criterion.Name}</div>
                                <input class="assignment-filter assignment-lookup-filter" data-criteria="{!criterion.Criterion}" type="hidden" id="criterion-{!criterion.Name}" style="width:100%"/>
                            </apex:outputPanel>

                            <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'STRING'}">
                                <div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!criterion.Name}</div>
                                <input class="assignment-filter assignment-string-filter" data-criteria="{!criterion.Criterion}" type="text" id="criterion-{!criterion.Name}" style="width:99%"/>
                            </apex:outputPanel>

                            <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'BOOLEAN'}">
                                <div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!criterion.Name}<input data-criteria="{!criterion.Criterion}" style="margin-bottom: 0px; vertical-align: bottom;" type="checkbox" class="assignment-filter assignment-boolean-filter"/></div>
                            </apex:outputPanel>

                            <!-- NUMERIC / DATES -->

                        </apex:repeat>

                        <input class="btn" id="applyFilterButton" onclick="applyAssignmentFilter();" type="Button" value="{!$Label.GoButton}"/>

                        <input class="btn" id="clearFilterButton" onclick="clearAssignmentFilter();" type="Button" value="{!$Label.ClearAllLabel}"/>

                    </div>
                    <script>

    	function clearAssignmentFilter()
    	{
    		jQuery('#AssignmentFilterPopup').hide();

    		assignmentFilter = [];

    		jQuery.each(jQuery('.assignment-filter'), function(i, obj) {

    			var $obj = jQuery(obj);

    			if($obj.hasClass('assignment-lookup-filter') && $obj.val() != '')
    				$obj.select2('val', '');

    			if($obj.hasClass('assignment-string-filter') && $obj.val() != '')
    				$obj.val('');

    			if($obj.hasClass('assignment-boolean-filter') && $obj.prop('checked'))
    				$obj.prop('checked', false);
    		});

    		jQuery('[id$="showLostAssignmentsCheckbox"]').prop('checked', false);

    		jQuery('.filterAssignmentButton').removeClass('toolbar-button-selected');

    		getAssignments(false, []);
    	}

    	function applyAssignmentFilter()
    	{
    		jQuery('#AssignmentFilterPopup').hide();

    		var assignmentFilter = [];

    		jQuery.each(jQuery('.assignment-filter'), function(i, obj) {

    			var $obj = jQuery(obj);

    			if($obj.hasClass('assignment-lookup-filter') && $obj.val() != '')
    				assignmentFilter.push({Criterion:$obj.attr('data-criteria'), Values:$obj.val().split(',')});

    			if($obj.hasClass('assignment-string-filter') && $obj.val() != '')
    				assignmentFilter.push({Criterion:$obj.attr('data-criteria'), SearchTerm:$obj.val()});

    			if($obj.hasClass('assignment-boolean-filter') && $obj.prop('checked'))
    				assignmentFilter.push({Criterion:$obj.attr('data-criteria'), BooleanValue:true});
    		});

    		if (assignmentFilter.length == 0)
    			jQuery('.filterAssignmentButton').removeClass('toolbar-button-selected');
    		else
    			jQuery('.filterAssignmentButton').addClass('toolbar-button-selected');

    		getAssignments(jQuery('[id$="showLostAssignmentsCheckbox"]').prop('checked'), assignmentFilter);
    	}

    	function lookupCriterion(criterion, query)
        {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentsEditController.FindCriterionValues}',
                criterion, query.term, kimble.parseJSON('{!JSENCODE(FilterIdsJson)}'),
                    function(result, event){
                         if (event.status)
                         {
                            var data = {};

                            data.results = result;
                            query.callback(data);
                        }
                        else if (event.type === 'exception')
                        {
                            alert(event.message);
                        }
                        else
                        {
                            alert(event.message);
                        }
                },
                {escape: false, timeout: 60000}
            );
        }

    	</script>
