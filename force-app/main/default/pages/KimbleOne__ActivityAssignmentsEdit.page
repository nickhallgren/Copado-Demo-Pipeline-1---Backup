                        <apex:outputPanel layout="block" id="EditFieldError"><apex:pageMessages escape="false"/></apex:outputPanel>
                    </div>
                    <div id="PopupContents" data-field-name="{!TheFieldName}" assignment-id="{!TheClickedRecordId}">
                    <apex:pageBlock id="ActivityAssignment" mode="edit" rendered="{!!ISBLANK(TheAssignmentToUpdate)}">
                        <apex:pageBlockButtons location="bottom" id="ButtonsBlock" styleclass="ButtonsBlock">
                            <input type="button" onclick="saveAssignmentUpdates()" class="btn" value="{!$Label.Save}" />
                            <input type="button"  onclick="hideModalBoxy();" class="btn" value="{!$Label.Cancel}" />
                        </apex:pageBlockButtons>

                    <apex:pageblockSection collapsible="false" showheader="false" columns="1" title="{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ActivityAssignment__c.label}">

                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!TheFieldLabel}"/>
                            <apex:outputPanel layout="none">

                                <apex:selectList id="action-type" size="1" rendered="{!TheChangeOptions.size > 1}" onchange="changeOptionsChange()">
                                    <apex:selectOptions value="{!TheChangeOptions}" />
                                </apex:selectList>

                                <apex:selectList styleclass="input-value" value="{!TheAssignmentToUpdate[TheFieldName]}" size="1" rendered="{!TheFieldOptions.Size > 0}" >
                                    <apex:selectOptions value="{!TheFieldOptions}" />
                                </apex:selectList>

                                <apex:inputField id="editpanelInputField" required="false" styleclass="input-value {!ClassNames}" html-data-field-type="{!FieldType}" value="{!TheAssignmentToUpdate[TheFieldName]}" rendered="{!TheFieldOptions.Size == 0}">
                                    <apex:actionSupport event="onchange" rerender="EditFieldError"/>
                                </apex:inputField>

                                <apex:inputField required="false" styleclass="start-date-offset" value="{!StartDateOffset.KimbleOne__InputInteger__c}" rendered="{!!ISBLANK(StartDateOffset)}">
                                    <apex:actionSupport event="onchange" rerender="EditFieldError"/>
                                </apex:inputField>

                            </apex:outputPanel>
                        </apex:pageBlockSectionItem>

                        <apex:pageBlockSectionItem rendered="{!ShowEffectiveDateField}">
                            <apex:outputLabel value="{! $ObjectType.ActivityAssignment__c.Fields.ForecastCostRateEffectiveDate__c.Label}"/>
                            <apex:inputField value="{!StartDateOffset.KimbleOne__InputDate__c}" styleclass="effective-date kimbleDatePicker" html-data-min-date="{!EarliestOpenPeriodDate}"/>
                        </apex:pageBlockSectionItem>

                    </apex:pageblockSection>
                        <script>
                        function initialiseDatePicker()
                        {
                            //Check if field is of type DATE
                            if('{!FieldType}' == 'DATE')
                            {   jQuery('[id$="editpanelInputField"]').addClass('kimbleDatePicker');
                                jQuery('[id$="editpanelInputField"]').datepicker({
                                    dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
                                    showOtherMonths: true,
                                    selectOtherMonths: true,
                                    changeMonth: true,
                                    changeYear: true});
                                    jQuery('[id$="editpanelInputField"]').focus();
                            }

                            jQuery('.effective-date').datepicker({
                                    dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
                                    showOtherMonths: true,
                                    minDate:jQuery('.effective-date').data('minDate').toDate(),
                                    maxDate:new Date(),
                                    selectOtherMonths: true,
                                    changeMonth: true,
                                    changeYear: true});

                        }
                    </script>
                    <apex:outputPanel layout="none" rendered="{!NumberOfSelectedRecords > 1}">
                        <apex:pageblockSection collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__applychangesto}"></apex:pageblockSection>
                        <div class="apply-to-section">
                            <div><input id="the-record-clicked" type="radio" checked="checked" name="apply-changes-group" value="single"/><label for="the-record-clicked">{!$Label.TheRecordClicked}</label></div>
                            <div><input id="selected-records" type="radio" name="apply-changes-group" value="all"/><label for="selected-records">{!$Label.All}&nbsp;<b><apex:outputText value="{!NumberOfSelectedRecords}"/></b>&nbsp;selected records</label></div>
