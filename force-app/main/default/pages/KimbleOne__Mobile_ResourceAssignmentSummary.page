<apex:page docType="html-5.0" standardcontroller="KimbleOne__Resource__c" extensions="KimbleOne.ResourceAssignmentSummaryController" showHeader="false" sidebar="false" standardStylesheets="false" >
    <apex:composition template="KimbleOne__Mobile_SiteMaster">
        <apex:define name="Content">

            <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
            <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
            <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'InsightStyle.css')}"/>
            <apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>

            <apex:includeScript value="{!URLFOR($Resource.KimbleOne__ChartJs)}" />
            <style>
        .tool-tip-info {
            color: #428BCA;
        }
        .tool-tip-inline-icon {
            font-size: 15px;
            display: inline-block;
            vertical-align: bottom;
            margin-left: 3px;
        }
        canvas.assignment-forecast-chart,
        canvas.assignment-usage-chart {
            display: inline-block;
            position:relative;
            z-index:1;
        }
        div.assignment-usage-chart-container {
            width: 300px;
            height: 300px;
            position: relative;
        }
        div.assignment-usage-chart-container.has-detail {
            cursor: pointer;
        }
        span.activity-name {
            font-size: 26px;
            font-weight: bold;
            display: block;
        }
        div.assignment-forecast-chart-container {
            height: 100px;
        }
        .assignment-details-container {
            vertical-align: top;
            padding: 2px 6px 2px 6px;
            border-radius: 4px;
            margin-bottom: 10px;
            text-align: center;
        }
        .inner-card {
            display: inline-block;
            vertical-align: top;
            margin-right: 8px;
            min-width: inherit;
            box-shadow: rgba(0, 0, 0, 0) 1px 2px 5px;
        }
        span.card-field-label {
            display: block;
        }
        span.adjustment-amt {
            margin: 0px 4px 0px 3px;
        }
        span.adjustments.card-field-label {
            font-style: italic;
            margin-top: 5px;
            font-weight: normal;
            font-size: 14px;
        }
        span.allowed {
            font-size: 22px;
            margin-top: 5px;
            margin-right: 5px;
            display: inline-block;
        }
        .allowed-amt {
            font-size: 50px;
            font-weight: bold;
            position: absolute;
            width: 100%;
            height: 60px;
            text-align: center;
            top: 97px;
        }
        .adjustment-ind {
            position: absolute;
            top: 100px;
            left: 181px;
            font-size: 16px;
            color: #428BCA;
        }
        .assignment-usage-details-container {
            display: none;
        }
        .time-entries-list {
            width: 100%;
            margin-top: 10px;
        }
        .time-entries-list caption {
            font-weight: bold;
            text-align: left;
            padding: 5px
        }
        .time-entries-list.actual caption {
            background-color: #1988ff;
            color: white;
        }
        .time-entries-list.scheduled caption {
            background-color: #d5d3d0;
        }
        .decimal-val {
            display: none;
        }

        #resource-container{
             width: 100%;
              text-align: center;
        }
    </style>

            <apex:outputPanel id="ResourceAssignments" layout="block">
                <div data-role="page" id="container" class="container">
                    <div id="resource-container" >
                        <div class="inner-cards-container">
                            <apex:repeat value="{!TheAssignments}" var="assignment">
                                <div id="{!assignment.Id}" class="inner-card">
                                    <c:ActivityAssignmentCardBody TheAssignment="{!assignment}" />
                                </div>
                            </apex:repeat>
                        </div>
                    </div>
                </div>
            </apex:outputPanel>

            <script>

       jQuery(document).on("pagecontainershow", function (e, ui) {

           jQuery('.decimal-val').each(function() {
                var decimalVal = parseFloat(jQuery(this).text());

                jQuery(this).text(kimble.localeNumberFormat(decimalVal));
            });

            jQuery('.decimal-val').show();

            jQuery('.assignment-usage-chart-container').click(function(e) {
                jQuery(this).parent('.inner-card-body').find('.assignment-usage-details-container').slideToggle();
            });
        });
    </script>
        </apex:define>
    </apex:composition>


</apex:page>