<apex:page standardcontroller="KimbleOne__Proposal__c" extensions="KimbleOne.RisksSalesController" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu"> 

	<c:Menu DefaultHelpPage="Risks.html" MenuContextType="Proposal" MenuContextId="{!KimbleOne__Proposal__c.Id}" MenuContextName="{!KimbleOne__Proposal__c.Name}"/>

</apex:define>  
   
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'RiskStyle.css')}"/>
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

	<!-- Hidden fields for use in controller -->
	<apex:outputField value="{!KimbleOne__Proposal__c.KimbleOne__Account__c}" rendered="False"/>
	<apex:variable var="IsProposalWon" value="{!KimbleOne__Proposal__c.ForecastStatus__r.ProbabilityCode__r.KimbleOne__Enum__c == P1ForecastStatusProbabilityCodeEnumValue}"/>

    <apex:form id="TheForm">
		<apex:outputPanel id="RisksManagerPanel" >
				<div id="dashboardContainer" class="dashboardContainer">
					<div id="riskDashboardSummaryContainer" context-id="{!KimbleOne__Proposal__c.Id}" pageSource="ProposalRiskSummaryCard" class="cardContainer"></div>
				</div>
		    	<apex:pageBlock id="RisksManagerBlock">  
		    		<div id="RiskManagerErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
		    	  	<apex:outputLabel value="{!KimbleOne__Proposal__c.Name}" rendered="false"/>

					<div class="toolbar-container">
						<div class="toolbar">
							<div id="toolbar-buttons">
								<apex:outputPanel layout="none" rendered="{!!IsProposalWon && $ObjectType.KimbleOne__Risk__c.createable}"> 
									<label class="hover-mutton select-btn">
										<a class="toolbar-button" onclick="newRisk();">{!$Label.kimbleone__new} {!$ObjectType.KimbleOne__Risk__c.label}</a>
									</label>
								</apex:outputPanel>
								<apex:outputPanel layout="none" rendered="{!!IsProposalWon && RelatedItems.size > 1 && $ObjectType.KimbleOne__Risk__c.createable}">
									<label class="hover-mutton select-btn">
										<a class="toolbar-button" onclick="ReinitialiseCopyRiskPopup();">{!$Label.kimbleone__copyrisksfromrelatedlabel}</a>
									</label>
								</apex:outputPanel>

								<a class="toolbar-button filterRiskButton" title="{!$Label.Filter} {!$ObjectType.Risk__c.Label}" onclick="jQuery('#RisksFilterPopup').show();" href="javascript:void(0);"><i class="fa fa-filter"></i></a>
								
								<apex:outputPanel rendered="{!NumberOfClosedRisks > 0 && ShowClosedRisks == true}">
									<a class="show-hide-closed-risks" onclick="showHideClosedRisks();">
										<apex:outputText escape="false" value="{!$Label.kimbleone__hideclosedrisks}">
											<apex:param value="{!NumberOfClosedRisks}"></apex:param>
										</apex:outputText>
									</a>
								</apex:outputPanel>
								<apex:outputPanel rendered="{!NumberOfClosedRisks > 0 && ShowClosedRisks == false}">
									<a class="show-hide-closed-risks" onclick="showHideClosedRisks();">
										<apex:outputText escape="false" value="{!$Label.kimbleone__showclosedrisks}">
											<apex:param value="{!NumberOfClosedRisks}"></apex:param>
										</apex:outputText>
									</a>
								</apex:outputPanel>
							</div>
						</div>
					</div>
					
	       			<apex:actionStatus id="RiskListRefresh">
		                <apex:facet name="start">
		                    <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
		                        <div id="loadingIndicatorInnerContainer">
		                            <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
		                        </div>
		                    </div>
		                </apex:facet>
		            </apex:actionStatus>

					<apex:pageBlockTable id="risksListEnhanced" value="{!risksList}" var="riskLine" styleClass="risks-grid kimble-enhanced-table">
		       			<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}" rendered="{!!IsProposalWon}">																							
							<apex:outputLink styleClass="actionLink risk-id-{!JSINHTMLENCODE(riskLine.id)}" value="javascript:void(0)" onclick="editRisk('{!JSINHTMLENCODE(riskLine.id)}');" title="{!$Label.kimbleone__edit}" rendered="{!$ObjectType.KimbleOne__Risk__c.updateable}"><span class="fa fa-pencil"></span></apex:outputLink>
			  				<apex:outputLink styleClass="actionLink risk-id-{!JSINHTMLENCODE(riskLine.id)}" value="javascript:void(0)" onclick="deleteSelectedRisk('{!JSINHTMLENCODE(riskLine.id)}');" title="{!$Label.kimbleone__delete}" rendered="{!$ObjectType.KimbleOne__Risk__c.deletable}"><span class="fa fa-trash second-action-link"></span></apex:outputLink>
			  				<div class="Loading risk-id-{!JSINHTMLENCODE(riskLine.id)}" style="display:none"></div> 
						</apex:column>
						<apex:column headerValue="{!$ObjectType.KimbleOne__Risk__c.Fields.Name.Label}" headerClass="sortable">
							<apex:outputLink value="{!$Page.KimbleOne__RiskView}?id={!riskLine.Id}" styleClass="risk-reference-link"><apex:outputText value="{!riskLine.Name}"/></apex:outputLink>
						</apex:column>
						<apex:repeat value="{!$ObjectType.KimbleOne__Risk__c.FieldSets.KimbleOne__RiskSummaryDetails}" var="r">
							<apex:column styleClass="risk-summary-column {!r}" value="{!riskLine[r]}" headerValue="{!r.Label}" headerClass="sortable"/>
		 				</apex:repeat>
						<apex:column headerValue="{!$ObjectType.KimbleOne__DeliveryGroup__c.Label}" headerClass="sortable" rendered="{!MultiGroup}">
							<apex:outputField value="{!riskLine.KimbleOne__DeliveryGroup__c}" rendered="{!!ISBLANK(riskLine.KimbleOne__DeliveryGroup__c)}"/>
							<apex:outputText value="{!$Label.kimbleone__all}" rendered="{!ISBLANK(riskLine.KimbleOne__DeliveryGroup__c)}"/>
						</apex:column>
					</apex:pageBlockTable>
		    	</apex:pageBlock>
		    	
		    	<script>
		    		var DefaultRiskCategory;
		    	
			    	jQuery(document).ready(function()
					{							
						jQuery.each( jQuery('.dashboardContainer'), function(i, dashboardContainer) {
								jQuery('div[pageSource]', dashboardContainer).each(function() {
						   		loadDashboardComponent(jQuery( this ));					   			
						   });
						})			
						
						jQuery('.kimble-enhanced-table').enhancedTable();
						
						jQuery('.risk-cat-filter-dropdown').select2();
						jQuery('.risk-severity-filter-dropdown').select2();
						jQuery('.risk-impact-filter-dropdown').select2();
						jQuery('.risk-probability-filter-dropdown').select2();
						jQuery('.risk-status-filter-dropdown').select2();
						
						DefaultRiskCategory = '<apex:outputText value="{!TheRiskCategoryPageParam}"/>';
						if(DefaultRiskCategory != null && DefaultRiskCategory != undefined && DefaultRiskCategory != '') 
						{
							$('.filterRiskButton').addClass('toolbar-button-selected');
						}
					});
					
                    jQuery(window).load(function()
                    {        
                        setupDateSort();
                        removeTableLinks();
                    });
                    
                    function setupDateSort()
                    {
                        jQuery.each(jQuery('td[class*=RaisedDate__c]'), function(i, obj){
                            jQuery(obj).attr('data-sort-type','number').attr('data-sort-value',kimble.parseDate(jQuery(obj).text(), true).valueOf());
                        });
                    }
                    
                    function removeTableLinks()
                    {
                        jQuery.each(jQuery('td[class*=RiskCategory__c],td[class*=RiskStatus__c],td[class*=RiskSeverity__c],td[class*=RiskImpact__c],td[class*=RiskProbability__c]'), function(i, obj){
                            jQuery(obj).addClass('disable-link');
                            jQuery(obj).find('span').find('a').prop('style','color:black !important;');    
                        });
                    }
					
					function deleteSelectedRisk(riskLinkId)
					{
						var d = confirmDelete();if(!d) return;
						
						jQuery('.actionLink.risk-id-' + riskLinkId).hide();
						jQuery('.Loading.risk-id-' + riskLinkId).show();
						
						deleteRisk(riskLinkId);
					}
					
					function resetSearchInput()
					{
						jQuery('.kimble-enhanced-table').enhancedTable();  
						
						InitialiseFilterHighlight();
						setupDateSort();
                        removeTableLinks();
					}
		    	</script>
		</apex:outputPanel>

		<apex:actionFunction action="{!deleteRisk}" name="deleteRisk" rerender="RisksManagerPanel,dashboardContainer" oncomplete="RefreshRisks();">
       		<apex:param name="rId" value="" />
       	</apex:actionFunction>

		<apex:actionFunction action="{!ShowHideClosedRisks}" name="showHideClosedRisks" rerender="RisksManagerPanel" oncomplete="RefreshRisks();">
			<apex:param name="rId" value="" />
		</apex:actionFunction>

		<apex:actionFunction action="{!newRiskForCategory}" name="newRiskForCategory" rerender="" oncomplete="">
       		<apex:param name="riskCategoryId" value="" />
       	</apex:actionFunction>
 
		<apex:actionFunction action="{!editRisk}" name="editRisk" rerender="" oncomplete="">
       		<apex:param name="rId" value="" />
       	</apex:actionFunction>
		
		<apex:actionFunction action="{!newRisk}" name="newRisk" rerender="RisksManagerPanel" oncomplete="">
		</apex:actionFunction>

		<apex:actionFunction action="{!ReinitialiseCopyRiskPopup}" name="ReinitialiseCopyRiskPopup" reRender="CopyRisksFromRelatedItems" oncomplete="copyRisksFromRelatedItem();copyRisksPopupLoadComplete();showModalBoxy();"/>
		<apex:actionFunction action="{!RefreshRisks}" status="RiskListRefresh" name="RefreshRisks" reRender="risksListEnhanced, RisksManagerBlock,dashboardContainer" oncomplete="resetSearchInput();"/>
		<apex:actionFunction action="{!ClearRisksFilter}" status="RiskListRefresh" name="ClearRisksFilter" reRender="risksListEnhanced, RisksManagerBlock, RiskFilters" oncomplete="resetSearchInput();"/>

		<div id="RisksFilterPopup" style="display:none;">
			<div id="RiskFilters">

				<div class="risks-filter-header">{!$ObjectType.Risk__c.LabelPlural} {!$Label.Filter}<i onclick="jQuery('#RisksFilterPopup').hide();" class="filter-collapse-btn fa fa-angle-double-up" title="{!$Label.Close}"></i></div>

				<div style="height: 5px;"/>

				<div class="filter-row">
					<apex:outputPanel rendered="{!RiskCategoryInFieldSet}">
						<apex:outputLabel styleClass="filter-row-category" value="{!$ObjectType.KimbleOne__RiskCategory__c.Label}"/>
						<apex:selectList id="riskCategoryFilter" styleClass="risk-cat-filter-dropdown" value="{!TheRiskCategoryIds}" multiselect="true">
							<apex:selectOptions id="SelectedRiskCategories" value="{!RiskCategories}"/>
						</apex:selectList>
					</apex:outputPanel>
				</div>

				<div class="filter-row">
					<apex:outputPanel rendered="{!RiskSeverityInFieldSet}">
						<apex:outputLabel styleClass="filter-row-category" value="{!$ObjectType.KimbleOne__Risk__c.fields.KimbleOne__RiskSeverity__c.label}"/>
						<apex:selectList id="riskSeverityFilter" styleClass="risk-severity-filter-dropdown" value="{!TheRiskSeverityIds}" multiselect="true">
							<apex:selectOptions value="{!RiskSeverities}"/>
						</apex:selectList>
					</apex:outputPanel>
				</div>

				<div class="filter-row">
					<apex:outputPanel rendered="{!RiskProbabilityInFieldSet}">
						<apex:outputLabel styleClass="filter-row-category" value="{!$ObjectType.KimbleOne__Risk__c.fields.KimbleOne__RiskProbability__c.label}"/>
						<apex:selectList id="riskProbabilityFilter" styleClass="risk-probability-filter-dropdown" value="{!TheRiskProbabilityIds}" multiselect="true">
							<apex:selectOptions value="{!RiskProbabilities}"/>
						</apex:selectList>
					</apex:outputPanel>
				</div>

				<div class="filter-row">
					<apex:outputPanel rendered="{!RiskImpactInFieldSet}">
						<apex:outputLabel styleClass="filter-row-category" value="{!$ObjectType.KimbleOne__Risk__c.fields.KimbleOne__RiskImpact__c.label}"/>
						<apex:selectList id="riskImpactFilter" styleClass="risk-impact-filter-dropdown" value="{!TheRiskImpactIds}" multiselect="true">
							<apex:selectOptions value="{!RiskImpacts}"/>
						</apex:selectList>
					</apex:outputPanel>
				</div>

				<div class="filter-row">
					<apex:outputPanel rendered="{!RiskStatusInFieldSet}">
						<apex:outputLabel styleClass="filter-row-category" value="{!$ObjectType.KimbleOne__Risk__c.fields.KimbleOne__RiskStatus__c.label}"/>
						<apex:selectList id="riskStatusFilter" styleClass="risk-status-filter-dropdown" value="{!TheRiskStatusIds}" multiselect="true">
							<apex:selectOptions value="{!RiskStatuses}"/>
						</apex:selectList>
					</apex:outputPanel>
				</div>

				<div class="filter-row">
					<input class="btn" id="applyFilterButton" onclick="applyRisksFilter();" type="Button" value="{!$Label.kimbleone__gobutton}"/>
					<input class="btn" id="clearFilterButton" onclick="clearRisksFilter();" type="Button" value="{!$Label.kimbleone__clearalllabel}"/>
				</div>
			</div>
		</div>

	</apex:form>

     	  <apex:form id="CopyRisksPopupForm">

    <div id="CopyRisksPopup" style="display:none"> 
  
		<apex:outputPanel id="CopyRisksFromRelatedItems">
           		<apex:pageBlock >
            		<div id="CopyRisksFromRelatedItemsErrors">
           				<apex:pageMessages escape="false"/>
           			</div>          		 
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton styleClass="DisableButtonWhileBusy" action="{!copyRisksFromRelatedItem}" value="{!$Label.kimbleone__addselected}" oncomplete="hideModalBoxyWithErrorCheck('#CopyRisksFromRelatedItemsErrors');RefreshRisks();" reRender="CopyRisksFromRelatedItems,RisksManagerPanel,risksListEnhanced,dashboardContainer"/>
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>

					<apex:outputLabel value="{!$Label.kimbleone__relateditemlabel}" styleClass="assessment-label"/>
					<apex:actionRegion >
						<apex:selectList styleClass="assessment-dropdown" value="{!SelectedRelatedItem}" size="1" multiselect="false">
		           			<apex:selectOptions value="{!RelatedItems}"/>
							<apex:actionSupport status="RiskRefresh" event="onchange" action="{!PopulateRelatedRisks}" rerender="RelatedRisksList"   />
		       			</apex:selectList>
		       			
		       			<apex:actionStatus id="RiskRefresh">
			                <apex:facet name="start">
			                    <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
			                        <div id="loadingIndicatorInnerContainer">
			                            <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
			                        </div>
			                    </div>
			                </apex:facet>
			            </apex:actionStatus>
					</apex:actionRegion>

					<apex:outputPanel id="RelatedRisksList">
					<div class="table-wrapper">
             		<apex:pageBlockTable styleClass="related-risk-table" value="{!TheRelatedRisks}" var="TheRelatedRisk">
             			<apex:column width="5%">
		                    <apex:facet name="header">
		                        <apex:inputCheckbox styleClass="select-all" onclick="selectAllCheckboxes()"/>
		                    </apex:facet>
		                    <apex:inputCheckbox styleClass="row-selector" value="{!TheRelatedRisk.IsSelected}"/>
		                </apex:column>

             			<apex:column width="20%">
		                    <apex:facet name="header">
		                        <apex:outputText value="{!$ObjectType.KimbleOne__RiskCategory__c.Label}"/>
		                    </apex:facet>
		                    <apex:outputText value="{!TheRelatedRisk.TheRisk.RiskCategory__r.Name}"/>
		                </apex:column>
		                
               			<apex:column width="43%">
		                    <apex:facet name="header">
		                        <apex:outputText value="{!$ObjectType.KimbleOne__Risk__c.Fields.KimbleOne__Summary__c.Label}"/>
		                    </apex:facet>
		                    <apex:outputText value="{!TheRelatedRisk.TheRisk.KimbleOne__Summary__c}"/>
		                </apex:column>
		                
               			<apex:column width="10%">
		                    <apex:facet name="header">
		                        <apex:outputText value="{!$ObjectType.KimbleOne__RiskImpact__c.Label}"/>
		                    </apex:facet>
		                    <apex:outputText value="{!TheRelatedRisk.TheRisk.RiskImpact__r.Name}"/>
		                </apex:column>
		                
               			<apex:column width="10%">
		                    <apex:facet name="header">
		                        <apex:outputText value="{!$ObjectType.KimbleOne__RiskProbability__c.Label}"/>
		                    </apex:facet>
		                    <apex:outputText value="{!TheRelatedRisk.TheRisk.RiskProbability__r.Name}"/>
		                </apex:column>
		                
               			<apex:column width="10%">
		                    <apex:facet name="header">
		                        <apex:outputText value="{!$ObjectType.KimbleOne__RiskSeverity__c.Label}"/>
		                    </apex:facet>
		                    <apex:outputText value="{!TheRelatedRisk.TheRisk.RiskSeverity__r.Name}"/>
		                </apex:column>
		                
<!-- 						compensate for the scrollbar -->
			            <apex:column width="2%"/>
			        </apex:pageBlockTable>
			        </div>
			        <script>
			        	resetSelectAll();
			        	
	        			function resetSelectAll()
						{
							jQuery("input.select-all").each(function(){jQuery(this).prop('checked', false);});
						}
			        </script>
            		</apex:outputPanel>
        		</apex:pageBlock>
	

        </apex:outputPanel> 
  	</div>	
         	</apex:form>

	<script>
		/*jQuery(document).ready(function()
		{							
			jQuery.each( jQuery('.dashboardContainer'), function(i, dashboardContainer) {
					jQuery('div[pageSource]', dashboardContainer).each(function() {
			   		loadDashboardComponent(jQuery( this ));					   			
			   });
			})			
			
		});*/
    	function clearRisksFilter()
    	{
    		jQuery('#RisksFilterPopup').hide();
    		
            $('.filterRiskButton').removeClass('toolbar-button-selected');
    	    jQuery('.hide-closed-checkbox').prop('checked',false);
    	    
			jQuery.each(jQuery('.select2-container-multi'), function(i, obj) {
				jQuery(obj).select2('val', '');
			});
    		
    		ClearRisksFilter();
    	}

    	function applyRisksFilter()
    	{
    		jQuery('#RisksFilterPopup').hide();

    		RefreshRisks();
    	}
    	
    	function InitialiseFilterHighlight()
    	{
    	    $('.filterRiskButton').removeClass('toolbar-button-selected');
    	    
            if($('.hide-closed-checkbox').is(":checked")) 
                $('.filterRiskButton').addClass('toolbar-button-selected');
                
            jQuery.each(jQuery('.select2-container-multi'), function(i, obj) {
				if(jQuery(obj).select2('val').length > 0) $('.filterRiskButton').addClass('toolbar-button-selected');
			});    
        }
		
		function loadDashboardComponent(dashboardComponent)
		{
			var pageSourceName = dashboardComponent.attr('pageSource');
	   		
	   		jQuery.ajax({ url: kimble.pages[pageSourceName] + dashboardComponent.attr('context-id')})
				.done(function(html) {
					dashboardComponent.empty();
					
					if(html != null && html != '')
					{
						jQuery(html).appendTo("#" + dashboardComponent.attr('id'));
					}
					else
					{
						// nothing to render in the component
						// remove the container for this component to allow the page to re-flow
						dashboardComponent.remove();
					}
				})
				.fail(function(xhr, status, error) {
					if(error !=null && error !="") {
						console.log('ajax component load error: ' + error);
						// hide the container for this component
						dashboardComponent.hide();
					}									
				})			
		}
			
		function copyRisksFromRelatedItem()
		{
			initialiseModalBoxy('#CopyRisksPopup', '{!JSENCODE($Label.New)} {!$ObjectType.Risk__c.labelplural}', jQuery('form[id$=\'CopyRisksPopupForm\']'));
		}
			
		function openRisksFilter()
		{
			initialiseModalBoxy('#RisksFilterPopup', '{!JSENCODE($Label.New)} {!$ObjectType.Risk__c.labelplural}', jQuery('form[id$=\'RisksFilterPopupForm\']'));
		}
 			
  		function selectAllCheckboxes()
  		{
  			if(jQuery("input.select-all:visible")[0].checked)
  			{
            	jQuery("input.row-selector:visible").each(function(){jQuery(this).prop('checked', true);});
           	}
           	else
           	{
           		jQuery("input.row-selector:visible").each(function(){jQuery(this).prop('checked', false);});
			}
        }

		function copyRisksPopupLoadComplete()
		{
		}

 		</script>
 		
