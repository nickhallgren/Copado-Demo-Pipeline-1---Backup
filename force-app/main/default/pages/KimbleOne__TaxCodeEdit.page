<apex:page standardController="KimbleOne__TaxCode__c" extensions="KimbleOne.TaxCodeEditController" sidebar="false" >

<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>

<style>

	.inner-card-container
	{
		display:block;
	}
	.cardHeadingContainer
	{
		display: table;
		width: 100%;
		background-color: #FFF;
		border-color: #DDD;
		color: #333;
		background-color: #FFF;
		border-color: #DDD;
		border-bottom: 1px solid #DDD;
		border-top-right-radius: 3px;
		border-top-left-radius: 3px;
		font-size: 18px;
	}
	.cardHeadingCell
	{
		display: table-cell;
	   vertical-align: middle;
	   padding: 4px 15px;
	   border-right: 1px solid #DDD;
	}
	.cardHeadingCellFixed
	{
		width:1px;
		white-space:nowrap;
	}
	.burger-menu
	{
		margin-left:0px;
	}
	.cardProperties {
		  font-size: 12px;
		}
	.title-card-body-field
	{
		margin:0px;
		padding-right:4px;
		padding-left:0px;
		padding-top:0px;
		padding-bottom:0px;
		vertical-align: middle;
	}
	.title-card-body-charm
	{
		cursor:pointer;
		font-size:26px;
		width: 35px;
	}
	.property-label
	{
		font-weight:bold;
		text-align:right;
	}
	.property-value
	{
		padding-right: 60px;
	}
	.details-header
	{
		margin-left: 10px;
		margin-right: 10px;
		margin-bottom: 3px;
		margin-top: 10px;
	}

</style>

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="Finance.html" MenuContextName="{!KimbleOne__TaxCode__c.Name}" BreadCrumbLink="/{!$ObjectType.KimbleOne__TaxCode__c.KeyPrefix}" BreadCrumbName="{!$ObjectType.KimbleOne__TaxCode__c.LabelPlural}"/>
</apex:define>
	
<apex:define name="Content">
<apex:outputPanel id="ContainerPageErrors">
	<apex:pageMessages />
</apex:outputPanel>

<apex:outputPanel id="TaxCodeContainer" styleclass="tax-code-container cardContainer" rendered="{!!ISBLANK(KimbleOne__TaxCode__c.Id)}" style="margin-bottom: 150px;">
	<div class="tax-code card">
		<div class="cardHeadingContainer">
			<div style="display:table-row">
				<div class="cardHeadingCell">
					<div class="card-heading-icon fa fa-percent" ></div>
					<div class="card-title-container">
						<h3 class="cardTitle"><apex:outputText value="{!KimbleOne__TaxCode__c.Name}"/></h3>
					</div>
				</div>

				<div class="cardMenu cardHeadingCell cardHeadingCellFixed">
					<div data-floating-dropdown="#{!TaxCode__c.Id}-menu-data" class="fa fa-bars tax-code-menu burger-menu"></div>
					<div class="deleting Loading" style="display:none"></div>
					<div id="{!TaxCode__c.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
						<ul class="floating-dropdown-menu">
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCode__c.updateable}">
								<li><a href="javascript:initialiseEditTaxCode('{!TaxCode__c.Id}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__TaxCode__c.Label}</a></li>
							</apex:outputPanel>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<div class="cardBody">
			<div class="details-header">
				<table cellpadding="4" cellspacing="0" border="0">
					<tr>
						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__IsAbstract__c.Label}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c}"/></span></td>

						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__TaxCode__c.Label}" rendered="{!!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__TaxCode__c}"  rendered="{!!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c}"/></span></td>
					</tr>
					<tr>
						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__ShowOnInvoice__c.Label}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__ShowOnInvoice__c}"/></span></td>

						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__InvoiceTaxCodeName__c.Label}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__InvoiceTaxCodeName__c}"/></span></td>
					</tr>
					<tr>
						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__SupplierInvoiceTaxStatement__c.Label}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__SupplierInvoiceTaxStatement__c}"/></span></td>
					</tr>
					<tr>
						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__InputTaxCalculationMethod__c.Label}" rendered="{!!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c && ISBLANK(KimbleOne__TaxCode__c.KimbleOne__TaxCode__c)}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__InputTaxCalculationMethod__c}" rendered="{!!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c && ISBLANK(KimbleOne__TaxCode__c.KimbleOne__TaxCode__c)}"/></span></td>

						<td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__OutputTaxCalculationMethod__c.Label}"/></td>
						<td><span class="property-value"><apex:outputField value="{!KimbleOne__TaxCode__c.KimbleOne__OutputTaxCalculationMethod__c}"/></span></td>
					</tr>
				</table>
			</div>
		</div>

		<div class="cardBody">
			<div class="inner-cards-container">

				<apex:outputPanel layout="none" rendered="{!KimbleOne__TaxCode__c.KimbleOne__IsAbstract__c}">

					<div class="inner-card-container">
						<div class="inner-card">
							<div class="inner-card-header">
								<div class="inner-card-header-icon" ></div>
								<div class="inner-card-title">
									<apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.LabelPlural}"/>
								</div>
								<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCode__c.updateable && $ObjectType.KimbleOne__TaxCode__c.createable}">
									<div data-floating-dropdown="#child-tax-code-menu-data" class="fa fa-bars burger-menu"></div>
									<div class="deleting Loading" style="display:none"></div>
									<div id="child-tax-code-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
										<ul class="floating-dropdown-menu">
											<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCode__c.createable}">
												<li><a href="javascript:initialiseEditTaxCode('','true');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.Add} {!$ObjectType.KimbleOne__TaxCode__c.Label}</a></li>
											</apex:outputPanel>
										</ul>
									</div>
								</apex:outputPanel>
							</div>

							<div class="inner-card-body">
								<table cellpadding="0" cellspacing="0" border="0" class="inner-card-table" width="100%"><!-- Fixed Width -->
									<colgroup>
										<col width="10%;"/><!-- menu  -->
										<col width="45%"/><!--Name-->
										<col width="45%"/>
									</colgroup>
									<thead>
									<tr class="headerRow">
										<th></th>
										<th>{!$ObjectType.TaxCode__c.Fields.Name.Label}</th>
										<th>{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__OutputTaxCalculationMethod__c.Label}</th>
										<th></th>
									</tr>
									</thead>
									<tbody>
									<apex:repeat value="{!ChildTaxCodes}" var="taxCode">
										<tr>
											<td>
												<div data-floating-dropdown="#child-tax-code-{!taxCode.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
												<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
												<div id="child-tax-code-{!taxCode.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
													<ul class="floating-dropdown-menu">
														<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCode__c.updateable}">
															<li><a href="javascript:initialiseEditTaxCode('{!taxCode.Id}','true');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__TaxCode__c.Label}</a></li>
														</apex:outputPanel>
														<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCode__c.deletable}">
															<li><a href="javascript:deleteTaxCodeClick('{!taxCode.Id}','true');"><i class="fa fa-trash-o dropdown-icon"></i>{!$Label.DeleteButton} {!$ObjectType.KimbleOne__TaxCode__c.Label}</a></li>
														</apex:outputPanel>
													</ul>
												</div>
											</td>
											<td class="center-value">{!taxCode.Name}</td>
											<td class="center-value"><apex:outputField value="{!taxCode.KimbleOne__OutputTaxCalculationMethod__c}"/></td>
										</tr>
									</apex:repeat>
									</tbody>
								</table>
							</div>

							<div class="inner-card-footer"></div>
						</div>
					</div>
				</apex:outputPanel>

				<apex:outputPanel layout="none" rendered="{!KimbleOne__TaxCode__c.KimbleOne__InputTaxCalculationMethod__c == calcMethodSimpleId}">

					<div class="inner-card-container">
						<div class="inner-card">
							<div class="inner-card-header">
								<div class="inner-card-header-icon" ></div>
								<div class="inner-card-title">
									<apex:outputText value="{!$ObjectType.KimbleOne__TaxRate__c.LabelPlural}"/>
								</div>
								<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxRate__c.createable}">
									<div data-floating-dropdown="#tax-rate-menu-data" class="fa fa-bars burger-menu"></div>
									<div class="deleting Loading" style="display:none"></div>
									<div id="tax-rate-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
										<ul class="floating-dropdown-menu">
											<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxRate__c.createable}">
												<li><a href="javascript:initialiseEditTaxRate();"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.Add} {!$ObjectType.KimbleOne__TaxRate__c.Label}</a></li>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxRate__c.deletable}">

											</apex:outputPanel>
										</ul>
									</div>
								</apex:outputPanel>
							</div>

							<div class="inner-card-body">
								<table cellpadding="0" cellspacing="0" border="0" class="inner-card-table" width="100%">
									<colgroup>
										<col width="10%"/><!-- Menu -->
										<col width="45%"/><!-- Rate  -->
										<col width="45%"/><!-- Effective Date-->
									</colgroup>
									<thead>
									<tr class="headerRow">
										<th></th>
										<th><apex:outputText value="{!$ObjectType.KimbleOne__TaxRate__c.Fields.KimbleOne__TaxRate__c.Label}"/></th>
										<th><apex:outputText value="{!$ObjectType.KimbleOne__TaxRate__c.Fields.KimbleOne__EffectiveDate__c.Label}"/></th>
									</tr>
									</thead>
									<tbody>
									<apex:repeat value="{!TaxRates}" var="taxRate">
										<tr>
											<td>
												<div data-floating-dropdown="#tax-rate-{!taxRate.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
												<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
												<div id="tax-rate-{!taxRate.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
													<ul class="floating-dropdown-menu">
														<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxRate__c.updateable}">
															<li><a href="javascript:initialiseEditTaxRate('{!taxRate.Id}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__TaxRate__c.Label}</a></li>
														</apex:outputPanel>
														<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxRate__c.deletable}">
															<li><a href="javascript:deleteTaxRateClick('{!taxRate.Id}');"><i class="fa fa-trash-o dropdown-icon"></i>{!$Label.DeleteButton} {!$ObjectType.KimbleOne__TaxRate__c.Label}</a></li>
														</apex:outputPanel>
													</ul>
												</div>
											</td>
											<td class="center-value"><apex:outputField value="{!taxRate.KimbleOne__TaxRate__c}"/></td>
											<td class="center-value"><apex:outputField value="{!taxRate.KimbleOne__EffectiveDate__c}"/></td>
										</tr>
									</apex:repeat>
									</tbody>
								</table>
							</div>

							<div class="inner-card-footer"></div>
						</div>
					</div>

				</apex:outputPanel>

				<apex:outputPanel layout="none" rendered="{!KimbleOne__TaxCode__c.KimbleOne__OutputTaxCalculationMethod__c == calcMethodRateCardId && NOT(ISBLANK(KimbleOne__TaxCode__c.KimbleOne__RateCardCombinationDefinition__c))}">

					<div class="inner-card-container">
						<div class="inner-card">
							<div class="inner-card-header">
								<div class="inner-card-header-icon" ></div>
								<div class="inner-card-title">
									<span><apex:outputText styleclass="card-field-label" value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__RateCardCombinationDefinition__c.Label}"/><apex:outputField styleclass="card-field-value" value="{!KimbleOne__TaxCode__c.KimbleOne__RateCardCombinationDefinition__c}"/></span>
								</div>
								<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TaxCodeRateCard__c.createable}">
									<div data-floating-dropdown="#card-menu-data" class="fa fa-bars burger-menu"></div>
									<div class="deleting Loading" style="display:none"></div>
									<div id="card-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
										<ul class="floating-dropdown-menu">
											<li><a href="javascript:initialiseEditRateCard('');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.RateCard__c.Label}</a></li>
										</ul>
									</div>
								</apex:outputPanel>
							</div>

							<div class="inner-card-body">
								<table cellpadding="0" cellspacing="0" border="0" class="inner-card-table" width="100%">
									<colgroup>
										<col width="10%;"/><!-- menu  -->
										<col width="30%;"/><!-- name -->
										<col width="30%;"/><!-- Items  -->
										<col width="30%;"/><!-- effective date-->
									</colgroup>
									<thead>
									<tr class="headerRow">
										<th></th>
										<th></th>
										<th><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></th>
										<th><apex:outputText value="{!$ObjectType.KimbleOne__TaxCodeRateCard__c.Fields.KimbleOne__EffectiveFromDate__c.Label}"/></th>
									</tr>
									</thead>
									<tbody>
									<apex:repeat value="{!RateCards}" var="rateCard">
										<tr>
											<td>
												<div data-floating-dropdown="#ratecard-{!rateCard.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
												<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
												<div id="ratecard-{!rateCard.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
													<ul class="floating-dropdown-menu">
														<li><a href="javascript:initialiseEditRateCard('{!JSENCODE(rateCard.Id)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.RateCard__c.Label}</a></li>
														<li><a href="javascript:editRateCardItemsClick('{!JSENCODE(rateCard.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(TaxCode__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
														<li><a href="javascript:addRateCardItemsClick('{!JSENCODE(rateCard.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(TaxCode__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.Add} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
														<li><a href="javascript:uploadItemsClick('{!JSENCODE(rateCard.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(TaxCode__c.RateCardCombinationDefinition__c)}', true)"><i class="fa fa-upload dropdown-icon"></i>{!$Label.UploadAndAppend}</a></li>
														<li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(rateCard.RateCard__c)}','{!combinationDefinition.IsFactored__c}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
														<apex:outputPanel rendered="{!KimbleOne__TaxCode__c.KimbleOne__RateCardCombinationDefinition__c != null}">
															<li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(TaxCode__c.RateCardCombinationDefinition__c)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
														</apex:outputPanel>
													</ul>
												</div>
											</td>
											<td><apex:outputText value="{!rateCard.RateCard__r.Name}"/></td>
											<td class="center-value"><apex:outputText value="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems}"/><apex:outputPanel title="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems} {!$Label.kimbleone__unmatcheditems}" styleclass="fa fa-exclamation-circle unmatched-items" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems > 0}"/></td>
											<td class="center-value"><apex:outputField value="{!rateCard.KimbleOne__EffectiveFromDate__c}"/></td>
										</tr>
									</apex:repeat>
									</tbody>
								</table>

							</div>

							<div class="inner-card-footer"></div>
						</div>
					</div>

				</apex:outputPanel>
			</div>
		</div>

	</div>
</apex:outputPanel>

<apex:form id="editTaxCodeForm">
	<div id="TaxCodePopup" style="display:none; width:680px;">
		<apex:outputPanel id="TaxCodeEdit">
			<div id="TaxCodeEditErrors">
				<apex:pageMessages escape="false"/>
			</div>
			<apex:pageBlock title="{!$ObjectType.KimbleOne__TaxCode__c.Label}">
				<apex:pageBlockButtons location="bottom" >
					<apex:commandButton id="saveTaxCodeButton" styleClass="DisableButtonWhileBusy" action="{!SaveTaxCode}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#TaxCodeEditErrors');" reRender="TaxCodeEdit"/>
					<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
				</apex:pageBlockButtons>

				<apex:pageBlockSection columns="2" collapsible="false">

					<apex:inputField id="taxCodeName" value="{!selectedTaxCode.Name}" required="true" onBlur="setInvoiceName();"/>

					<apex:pageBlockSectionItem />

				</apex:pageBlockSection>

				<apex:outputPanel id="fieldsPanel" layout="block">
					<apex:actionRegion >
					<apex:pageBlockSection columns="2" collapsible="false">
					<apex:inputField value="{!selectedTaxCode.KimbleOne__IsAbstract__c}"  rendered="{!!childCodeEditMode}">
						<apex:actionSupport event="onchange"  action="{!IsAbstractChanged}" reRender="fieldsPanel" onComplete="setInvoiceName();"/>
					</apex:inputField>

					<apex:pageBlockSectionItem rendered="{!!childCodeEditMode}">
						<apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__TaxCode__c.Label}" rendered="{!!selectedTaxCode.KimbleOne__IsAbstract__c}"/>
						<apex:inputField value="{!selectedTaxCode.KimbleOne__TaxCode__c}" rendered="{!!selectedTaxCode.KimbleOne__IsAbstract__c}" >
							<apex:actionSupport event="onchange" reRender="fieldsPanel"/>
						</apex:inputField>
					</apex:pageBlockSectionItem>

					<apex:inputField id="showOnInvoice" value="{!selectedTaxCode.KimbleOne__ShowOnInvoice__c}" onChange="setInvoiceName();"/>

					<apex:inputField id="taxCodeInvoiceName" value="{!selectedTaxCode.KimbleOne__InvoiceTaxCodeName__c}"/>

					<apex:inputField value="{!selectedTaxCode.KimbleOne__SupplierInvoiceTaxStatement__c}"/>

					<apex:pageBlockSectionItem />

					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__InputTaxCalculationMethod__c.Label}" rendered="{!!selectedTaxCode.KimbleOne__IsAbstract__c && ISBLANK(selectedTaxCode.KimbleOne__TaxCode__c)}"/>
						<apex:selectList value="{!selectedTaxCode.KimbleOne__InputTaxCalculationMethod__c}" size="1"  rendered="{!!selectedTaxCode.KimbleOne__IsAbstract__c && ISBLANK(selectedTaxCode.KimbleOne__TaxCode__c)}">
							<apex:selectOptions value="{!InputTaxCalcMethods}"/>
						</apex:selectList>
					</apex:pageBlockSectionItem>

					<apex:pageBlockSectionItem rendered="{!!childCodeEditMode && ISBLANK(selectedTaxCode.KimbleOne__TaxCode__c)}">
						<apex:outputText value="{!$ObjectType.KimbleOne__TaxCode__c.Fields.KimbleOne__OutputTaxCalculationMethod__c.Label}"/>
						<apex:selectList value="{!selectedTaxCode.KimbleOne__OutputTaxCalculationMethod__c}" size="1">
							<apex:selectOptions value="{!OutputTaxCalMethods}"/>
							<apex:actionSupport event="onchange" reRender="fieldsPanel"/>
						</apex:selectList>
					</apex:pageBlockSectionItem>

					</apex:pageBlockSection>
					</apex:actionRegion>

					<apex:PageBlockSection title="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Label}" columns="2" collapsible="false" rendered="{!selectedTaxCode.KimbleOne__OutputTaxCalculationMethod__c == calcMethodRateCardId && !childCodeEditMode && ISBLANK(selectedTaxCode.KimbleOne__TaxCode__c)}">

						<apex:pageBlockSectionItem >
							<apex:outputText value="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Fields.KimbleOne__ObjectType__c.Label}" />
							<apex:outputField value="{!combinationDefinition.KimbleOne__ObjectType__c}" />
						</apex:pageBlockSectionItem>

						<apex:pageBlockSectionItem />

						<apex:pageBlockSectionItem >
							<apex:outputText value="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Fields.KimbleOne__KeyDefinition__c.Label}"/>
							<apex:inputField value="{!combinationDefinition.KimbleOne__KeyDefinition__c}"/>
						</apex:pageBlockSectionItem>

						<apex:pageBlockSectionItem >
							<apex:outputText value="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Fields.KimbleOne__Delimiter__c.Label}"/>
							<apex:inputField value="{!combinationDefinition.KimbleOne__Delimiter__c}"/>
						</apex:pageBlockSectionItem>

					</apex:pageBlockSection>
				</apex:outputPanel>

			</apex:pageBlock>

		</apex:outputPanel>
	</div>
	<apex:actionFunction name="initialiseEditTaxCode" action="{!loadSelectedTaxCode}" immediate="true" reRender="TaxCodeEdit" onComplete="editTaxCodeClick();">
		<apex:param name="selectedCodeId" value=""/>
		<apex:param name="isChildCode" value=""/>
	</apex:actionFunction>
</apex:form>

<apex:form id="editTaxRateForm">

	<div id="TaxRatePopup" style="display:none">
		<apex:outputPanel id="TaxRateEdit">
			<div id="TaxRateEditErrors">
				<apex:pageMessages escape="false"/>
			</div>

			<apex:pageBlock title="{!$ObjectType.KimbleOne__TaxRate__c.Label}">
				<apex:pageBlockButtons location="bottom">
					<apex:commandButton id="saveTaxRateButton" styleClass="DisableButtonWhileBusy" action="{!SaveTaxRate}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#TaxRateEditErrors');" reRender="TaxRateEdit, TaxCodeContainer"/>
					<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
				</apex:pageBlockButtons>

				<apex:pageBlockSection columns="2" collapsible="false">

					<apex:inputField value="{!selectedTaxRate.KimbleOne__EffectiveDate__c}" styleClass="kimbleDatePicker"/>
					<apex:pageBlockSectionItem />
					<apex:inputField value="{!selectedTaxRate.KimbleOne__TaxRate__c}"/>

				</apex:pageBlockSection>
			</apex:pageBlock>

		</apex:outputPanel>
	</div>
	<apex:actionFunction name="initialiseEditTaxRate" action="{!loadSelectedTaxRate}" immediate="true" reRender="TaxRateEdit" onComplete="editTaxRateClick()">
		<apex:param name="selectedRateId" value=""/>
	</apex:actionFunction>
</apex:form>

<apex:form id="EditTaxCodeRateCardForm">
	<div id="TaxCodeRateCardPopup" style="display:none">
		<apex:outputPanel id="TaxCodeRateCardPopupPanel">
				<apex:pageBlock >
					<div id="TaxCodeRateCardPopupErrors">
						<apex:pageMessages escape="false"/>
					</div>

					<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!SaveTaxCodeRateCard}" value="{!$Label.kimbleone__save}" styleClass="DisableButtonWhileBusy" oncomplete="hideModalBoxyWithErrorCheck('#TaxCodeRateCardPopupErrors');" reRender="TaxCodeRateCardPopupPanel, TaxCodeContainer"/>
						<apex:commandButton rendered="{!NOT(ISBLANK(selectedTaxCodeRateCard.KimbleOne__RateCard__c)) && RateCardItemsSummaryMap[selectedTaxCodeRateCard.KimbleOne__RateCard__c].TotalItems == 0}" id="deleteRateCardBtn" styleClass="DisableButtonWhileBusy" action="{!DeleteRateCard}" value="{!$Label.kimbleone__delete}" oncomplete="hideModalBoxyWithErrorCheck('#TaxCodeRateCardPopupErrors');;" reRender="TaxCodeRateCardPopupPanel,TaxCodeContainer"/>
						<input class="btn" type="button" styleClass="DisableButtonWhileBusy" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>

					<apex:pageblockSection collapsible="false" showheader="false" columns="1">

						<apex:pageBlockSectionItem >
							<apex:outputText value="{!$ObjectType.KimbleOne__RateCard__c.Fields.Name.Label}"/>
							<apex:inputField styleClass="rate-card-name" value="{!selectedTaxCodeRateCard.Name}" required="true"/>
						</apex:pageBlockSectionItem>

						<apex:inputField value="{!selectedTaxCodeRateCard.KimbleOne__EffectiveFromDate__c}" styleClass="kimbleDatePicker"/>
						<apex:inputField value="{!selectedTaxCodeRateCard.KimbleOne__EffectiveToDate__c}" styleClass="kimbleDatePicker"/>

					</apex:pageBlockSection>

				</apex:pageBlock>

		</apex:outputPanel>
	</div>
	<apex:actionFunction name="initialiseEditRateCard" action="{!loadSelectedRateCard}" immediate="true" reRender="TaxCodeRateCardPopupPanel" onComplete="editTaxCodeRateCardClick();">
		<apex:param value="" name="selectedRateCardId"/>
	</apex:actionFunction>
</apex:form>

	<apex:form >
		<apex:actionFunction name="deleteTaxCodeClick" action="{!DeleteTaxCode}" reRender="ContainerPageErrors">
			<apex:param value="" name="taxCodeForDelete"/>
		</apex:actionFunction>
		<apex:actionFunction name="deleteTaxRateClick" action="{!DeleteTaxRate}" reRender="ContainerPageErrors">
			<apex:param value="" name="taxRateForDelete"/>
		</apex:actionFunction>
	</apex:form>

	<script>

	jQuery(window).load(function()
	{
		<apex:outputPanel layout="none" rendered="{!ISBLANK(KimbleOne__TaxCode__c.Id)}">
			initialiseEditTaxCode('');
		</apex:outputPanel>
	});

	 function SetupDatePicker()
	{
		jQuery('.kimbleDatePicker').datepicker({
		dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
		showOtherMonths: true,
		selectOtherMonths: true,
		changeMonth: true,
		changeYear: true
		});
	}

	function editTaxCodeClick()
	{
		initialiseModalBoxy('#TaxCodePopup', '{!$ObjectType.KimbleOne__TaxCode__c.Label}', jQuery('form[id$=\'editTaxCodeForm\']'));
		showModalBoxy();
 	}

 	function editTaxRateClick()
 	{
 	    initialiseModalBoxy('#TaxRatePopup', '{!$ObjectType.KimbleOne__TaxRate__c.Label}',jQuery('form[id$=\'editTaxRateForm\']'));
 	    showModalBoxy();
		SetupDatePicker();
		jQuery(':focus').blur();
  	}

	function editTaxCodeRateCardClick()
	{
		initialiseModalBoxy('#TaxCodeRateCardPopup', '{!$ObjectType.TaxCodeRateCard__c.Label}', jQuery('form[id$=\'EditTaxCodeRateCardForm\']'));
		showModalBoxy();
		SetupDatePicker();
 	}

 	function setInvoiceName()
 	{
 	    if(jQuery('[id$="showOnInvoice"]').prop('checked'))
 	    {
			var codeName = jQuery('[id$="taxCodeName"]').val();
			var invoiceName = jQuery('[id$="taxCodeInvoiceName"]').val();

			if(codeName && codeName.trim().length > 0 && !invoiceName || invoiceName.trim().length == 0)
			{
				jQuery('[id$="taxCodeInvoiceName"]').val(codeName);
			}
		}
  	}


	</script>

	<apex:include pageName="{!$Page.RateCardAndItemsEdit}"/>

</apex:define>
</apex:composition>
</apex:page>