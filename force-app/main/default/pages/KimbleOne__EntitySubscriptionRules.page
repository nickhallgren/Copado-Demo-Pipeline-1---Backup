<apex:page controller="KimbleOne.EntitySubscriptionRulesController" sidebar="false" tabStyle="KimbleOne__ReferenceData__c">

<apex:composition template="KimbleOne__SiteMaster">
<apex:define name="Menu"> 

	<c:Menu MenuContextName="{!$ObjectType.KimbleOne__EntitySubscriptionRule__c.LabelPlural}"/>

</apex:define>  
    
<apex:define name="Content">
    <apex:form >
		<div id="EntitySubscriptionRulesErrors">
        	<apex:pageMessages escape="false"/>
        </div>
		<apex:outputPanel id="EntitySubscriptionRulesMainPanel" > 
		    	<apex:pageBlock id="EntitySubscriptionRulesBlock" >  
		    	    <apex:pageBlockButtons location="top">						
						<apex:commandButton action="{!NewRule}" value="{!$Label.kimbleone__new} {!$ObjectType.KimbleOne__EntitySubscriptionRule__c.label}" onclick="initialiseModalBoxy('#EntitySubscriptionRulePopUp', '{!JSENCODE($Label.kimbleone__new)} {!$ObjectType.KimbleOne__EntitySubscriptionRule__c.Label}');" oncomplete="showModalBoxy();" reRender="EntitySubscriptionRulePopUpPanel"/>						
					</apex:pageBlockButtons>
		    	
					<apex:pageBlockTable value="{!TheRules}" var="rule">
		       			<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
		       				<apex:outputLink value="#" onclick="initialiseModalBoxy('#EntitySubscriptionRulePopUp', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__EntitySubscriptionRule__c.Label}');editEntitySubscriptionRule('{!JSINHTMLENCODE(rule.id)}');">{!$Label.kimbleone__edit}</apex:outputLink> &nbsp;|&nbsp;
							<apex:outputLink value="#" onclick="var d = confirmDelete();if(!d) return; deleteEntitySubscriptionRule('{!JSINHTMLENCODE(rule.id)}');">{!$Label.kimbleone__delete}</apex:outputLink>
						</apex:column>				
						<apex:column value="{!rule.Name}" headerValue="{!$ObjectType.KimbleOne__EntitySubscriptionRule__c.Fields.Name.Label}"/>
						<apex:column headerValue="{!$ObjectType.KimbleOne__EntitySubscriptionRule__c.Fields.KimbleOne__EntityType__c.Label}">
							<apex:outputLabel value="{!rule.EntityType__r.Name}" />
						</apex:column>
						<apex:column value="{!TheResourceGroupsMap[rule.KimbleOne__Resource__c].Name}" headerValue="{!$Label.kimbleone__resourcegrouplabel}"/>
					</apex:pageBlockTable>
		    	</apex:pageBlock>
		</apex:outputPanel> 

		<apex:actionFunction action="{!DeleteRule}"  name="deleteEntitySubscriptionRule" rerender="EntitySubscriptionRulesMainPanel" oncomplete="">
       		<apex:param name="ruleId" value="" />
       	</apex:actionFunction>
 
		<apex:actionFunction action="{!ReadRule}" name="editEntitySubscriptionRule" rerender="EntitySubscriptionRulePopUpPanel" oncomplete="showModalBoxy();">
       		<apex:param name="ruleId" value="" />
       	</apex:actionFunction>
    
    </apex:form>

	<div id="EntitySubscriptionRulePopUp" style="display:none">

		<apex:outputPanel id="EntitySubscriptionRulePopUpPanel" > 
     		<apex:form >
     		  	<div id="EntitySubscriptionRulePopUpErrors">
    	      		<apex:pageMessages escape="false"/>
	       		</div> 
           		<apex:pageBlock >
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!SaveRule}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#EntitySubscriptionRulePopUpErrors');" reRender="EntitySubscriptionRulePopUpPanel, EntitySubscriptionRulesMainPanel"/>
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
             		<apex:pageblockSection collapsible="false" showheader="false" columns="1">
              			
						<apex:inputField value="{!TheRuleToEdit.Name}" required="true"/>									              
               			<apex:inputField value="{!TheRuleToEdit.KimbleOne__EntityType__c}" required="true"/>
               			<apex:pageblockSectionItem >
							<apex:outputLabel value="{!$Label.kimbleone__resourcegrouplabel}"/>
							<apex:selectList id="GroupsList" value="{!TheRuleToEdit.KimbleOne__Resource__c}"  size="1" required="true">
								<apex:selectOptions value="{!TheResourceGroupOptions}" />
							</apex:selectList>							          			               	
               			</apex:pageblockSectionItem>
		            </apex:pageBlockSection>
                    		            
	        		</apex:pageBlock>
	
         	</apex:form>

        </apex:outputPanel> 

	</div>
</apex:define>
</apex:composition>

</apex:page>