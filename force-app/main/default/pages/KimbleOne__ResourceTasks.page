<apex:page standardcontroller="KimbleOne__Resource__c" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="Resource" MenuContextId="{!KimbleOne__Resource__c.Id}" MenuContextName="{!KimbleOne__Resource__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
 
	<apex:pageMessages escape="false"/>
 
	<apex:pageBlock >

		<apex:pageBlockSection title="{!$Label.kimbleone__resourcetasks}" collapsible="false">
      
			<apex:relatedList list="ActivityHistories" />

			<apex:relatedList list="OpenActivities" />
    
		</apex:pageBlockSection>

	</apex:pageBlock>
  
</apex:define>

</apex:composition>

</apex:page>