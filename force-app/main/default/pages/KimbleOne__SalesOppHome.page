<apex:page standardcontroller="KimbleOne__SalesOpportunity__c" extensions="KimbleOne.SalesOppHomeController,KimbleOne.SecurityController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu MenuContextType="Proposal" MenuContextId="{!KimbleOne__SalesOpportunity__c.KimbleOne__Proposal__c}" MenuContextName="{!KimbleOne__SalesOpportunity__c.Name}"/>
</apex:define>
     
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>
	    
    <chatter:feedWithFollowers entityId="{!KimbleOne__SalesOpportunity__c.Id}"/>
	
	<apex:form id="TheForm">
    
    <apex:pageMessages escape="false"/>
    
    <apex:variable value="{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__ResponseRequiredDate__c.Name}" var="responseRequiredDateFieldName" />  
    
    <apex:outputPanel id="SalesOpp" >

	<div id="proposal-title">
		<apex:outputPanel id="ProposalCard" layout="none">
		<div class="title-card-container">
		<div class="title-card">
			<div class="title-card-heading" title="{!JSINHTMLENCODE(KimbleOne__SalesOpportunity__c.Name)}">
				<div class="title-card-heading-icon">
					<apex:variable value="{!KimbleOne__SalesOpportunity__c.Proposal__r.ForecastStatus__r.KimbleOne__StyleClass__c}" var="ForecastStyleValue"/>
					<div class="fa fa-square kimble-probability {!JSINHTMLENCODE(ForecastStyleValue)}"></div>
				</div>
				<div class="title-card-heading-text">
					<apex:outputText value="{!KimbleOne__SalesOpportunity__c.Name}"/>
				</div>
			</div>
			
			<div class="title-card-body">
				<div class="title-card-body-field">
					<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ForecastStatus__c.Label}" />
					<span ><apex:outputField styleClass="center-aligned-block" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.ForecastStatus__r.Name}"/></span>
				</div>
				<div class="title-card-body-field">
					<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__AcceptanceDate__c.Label}" />
					<span ><apex:outputField styleClass="center-aligned-block" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__AcceptanceDate__c}"/></span>
				</div>
				<div class="title-card-body-field">
					<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractRevenue__c.Label}" />
					<span ><apex:outputField id="proposal-contract-revenue" styleClass="center-aligned-block" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractRevenue__c}"/></span>
				</div>
				<div class="title-card-body-field">
					<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractCost__c.Label}" />
  					<span ><apex:outputField styleClass="center-aligned-block" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractCost__c}"/></span>
				</div>
				<div class="title-card-body-field">
					<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractMargin__c.Label}" />
  					<span ><apex:outputField styleClass="center-aligned-block" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractMargin__c}"/></span>
				</div>
	  			<div id="embeddedCharmsContainer" pageSource="ProposalCharmsCard" parentContext="{!$Page.SalesOppHome}"></div>
			</div>

			<!-- Currently only one menu option so promoted validity check to the whole burger menu and structure so we aren't left with an empty dropdown -->
			<apex:outputPanel layout="none" rendered="{!CanRevert && HasPermission['RevertWonSalesOpportunity']}">	
				<div class="title-card-menu">
					<div id="proposal-menu" data-floating-dropdown="#{!JSENCODE(SalesOpportunity__c.Id)}-menu-data" class="title-card-menu fa fa-bars burger-menu"></div>
				</div>	
			
				<div id="{!JSENCODE(SalesOpportunity__c.Id)}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
					<ul class="floating-dropdown-menu">
						<li><a href="javascript:initialiseModalBoxy('#RevertSalesOppPopup', '{!JSENCODE($Label.ReOpenWonSalesOpportunityLabel)}');showModalBoxy()"><i class="fa fa-undo dropdown-icon"></i>{!$Label.ReOpenButton}</a></li>
					</ul>
				</div>
			</apex:outputPanel>

		</div>
		</div>
		</apex:outputPanel>
	</div>


	<apex:pageBlock id="mainSalesOppHomePB">
	
		<apex:pageBlockSection collapsible="false" title="{!$Label.kimbleone__opportunitydetailsheader}" >
    		
    		<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__Account__c}"/>
      		<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__CustomerAccount__c}"/>
      		
      		<apex:pageBlockSectionItem >
				<apex:outputText value="{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__ForecastStatus__c.Label}"/>
	    		<apex:outputField value="{!KimbleOne__SalesOpportunity__c.ForecastStatus__r.Name}"/>
      		</apex:pageBlockSectionItem>
    		<apex:pageBlockSectionItem />
      		
      		<apex:pageBlockSectionItem rendered="{!showResponseRequiredDate}">
				<apex:outputText value="{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__ResponseRequiredDate__c.Label}"/>
				<apex:outputLink title="{!ChangeResponseRequiredDateLinkTitle}" value="#" onclick="initialiseModalBoxy('#ResponseRequiredPopup', '{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__ResponseRequiredDate__c.Label}');showModalBoxy()">
					<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__ResponseRequiredDate__c}"/></apex:outputLink>	
			</apex:pageBlockSectionItem> 
			
			<apex:pageBlockSectionItem >
				<apex:outputText value="{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__CloseDate__c.Label}"/>
				<apex:outputLink title="{!ChangeCloseDateLinkTitle}" value="#" onclick="initialiseModalBoxy('#CloseDatePopup', '{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__CloseDate__c.Label}');showModalBoxy()">
					<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__CloseDate__c}"/></apex:outputLink>	
			</apex:pageBlockSectionItem>
			<apex:pageBlockSectionItem rendered="{!!showResponseRequiredDate}"/>
      					
      		<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__OpportunitySource__c}"/>
      		<apex:pageBlockSectionItem />
      		
      		<apex:outputField value="{!KimbleOne__SalesOpportunity__c.KimbleOne__Description__c}"/>
      		<apex:pageBlockSectionItem />

      		<apex:repeat value="{!$ObjectType.KimbleOne__SalesOpportunity__c.FieldSets.KimbleOne__SalesOpportunityDetails}" var="f">
     			<apex:outputField value="{!KimbleOne__SalesOpportunity__c[f]}" rendered="{!f != responseRequiredDateFieldName}"/>
   			</apex:repeat>
      		
 		</apex:pageBlockSection>
 		
 		<apex:pageBlockSection collapsible="false" title="{!$Label.kimbleone__proposaldetailslabel}" >
 		
 			<apex:outputField id="proposalBusinessUnit" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__BusinessUnit__c}"/>
 			<apex:outputField id="proposalProposition" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__Proposition__c}"/>

      		<apex:outputField id="proposalRevenue" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractRevenue__c}"/>
      		<apex:outputField id="proposalCost" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractCost__c}" rendered="{!ShowCost}"/>
      		<apex:outputField id="proposalMargin" value="{!KimbleOne__SalesOpportunity__c.Proposal__r.KimbleOne__ContractMargin__c}" rendered="{!ShowCost}"/>
      		<apex:pageBlockSectionItem />
      		
 		</apex:pageBlockSection>
 		
	</apex:pageBlock>

	</apex:outputPanel>
	
	</apex:form>
	
	<div id="ResponseRequiredPopup" style="display:none">
  
		<apex:outputPanel id="ResponseRequired">
			
     	  <apex:form >
           		<apex:pageBlock >
           		
           			<div id="ResponseRequiredErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!upsertSalesOpportunity}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#ResponseRequiredErrors');initialiseItems();RefreshMenu();" reRender="SalesOpp, ResponseRequired, CloseDate, WarningsPanel"/>
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="1">
              			
              			<apex:inputfield value="{!SalesOpportunity.KimbleOne__ResponseRequiredDate__c}" styleClass="kimbleDatePicker" required="true"/>
               			
		            </apex:pageBlockSection>
            
        		</apex:pageBlock>

         	</apex:form>

        </apex:outputPanel> 
    
	</div>
	
	<div id="CloseDatePopup" style="display:none">
  
		<apex:outputPanel id="CloseDate">
			
     	  <apex:form >
           		<apex:pageBlock >
           		
           			<div id="CloseDateErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!upsertSalesOpportunity}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#CloseDateErrors');initialiseItems();RefreshMenu();" reRender="SalesOpp, ResponseRequired, CloseDate, WarningsPanel"/>
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="1">
              			
              			<apex:inputfield value="{!SalesOpportunity.KimbleOne__CloseDate__c}" styleClass="kimbleDatePicker" required="true"/>
               			
		            </apex:pageBlockSection>
            
        		</apex:pageBlock>

         	</apex:form>

        </apex:outputPanel> 
  
	</div>
	
	<div id="RevertSalesOppPopup" style="display:none">
	
		<apex:outputPanel id="RevertSalesOpp">
	
			<apex:form >
				<apex:pageBlock >
					
					<div id="revertSalesOppErrors">
						<apex:pageMessages escape="false"/>
					</div>
					
					<apex:pageBlockButtons location="bottom">
						<apex:commandButton value="{!$Label.kimbleone__save}" action="{!RevertSalesOpportunity}" oncomplete="hideModalBoxyWithErrorCheck('#revertSalesOppErrors')" rerender="TheForm" />
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}" />
					</apex:pageBlockButtons>
						
					<apex:pageBlockSection columns="1">
					
						<apex:pageBlockSectionItem >
							<apex:outputLabel value="{!$ObjectType.KimbleOne__SalesOpportunity__c.Fields.KimbleOne__ForecastStatus__c.Label}"/>
               				<apex:selectList id="forecastStatus" value="{!KimbleOne__SalesOpportunity__c.KimbleOne__ForecastStatus__c}" required="true" size="1" >
								<apex:selectOptions value="{!SalesForecastStatuses}" />
							</apex:selectList>
						</apex:pageBlockSectionItem>
						<apex:inputField id="closeDate" required="true" value="{!KimbleOne__SalesOpportunity__c.KimbleOne__CloseDate__c}" styleClass="kimbleDatePicker"/>
						
					</apex:pageBlockSection>
						
				</apex:pageBlock>
			</apex:form>

		</apex:outputPanel>
	
	</div>
	<apex:variable value="{!KimbleOne__SalesOpportunity__c.KimbleOne__Proposal__c}" var="proposalId"/>
	<script>
		jQuery(document).ready(function()
		{					
			var ProposalId = '{!JSENCODE(proposalId)}';
			
			jQuery('div[pageSource]').each(function() {
	   		var theComponent = jQuery( this );
	   		var pageSourceName = theComponent.attr('pageSource');
	   		var parentContextParam = (theComponent.attr('parentContext') != undefined && theComponent.attr('parentContext') != null ? '&parentContext=' + theComponent.attr('parentContext') : '');
	   		
	   		// kick off the population of the page with an ajax call
			jQuery.ajax({ url: kimble.pages[pageSourceName] + ProposalId + parentContextParam})
				.done(function(html) {
					jQuery(html).appendTo("#" + theComponent.attr('id'));
				})
				.fail(function(xhr, status, error) {
					if(error !=null && error !="") alert(error);								
				})				
			});
		});

		jQuery(window).load(function()
		{
			initialiseItems();
		});

		function initialiseItems()
		{
		    SetupDatePicker();
  		}

		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}
	</script>

</apex:define>

</apex:composition>

</apex:page>