<apex:page standardController="KimbleOne__Issue__c" extensions="KimbleOne.IssueEditController"  sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="Issues.html" MenuContextType="{!IF(ISBLANK(KimbleOne__Issue__c.KimbleOne__Proposal__c), 'DeliveryGroup','Proposal')}" MenuContextId="{!IF(ISBLANK(KimbleOne__Issue__c.KimbleOne__Proposal__c), KimbleOne__Issue__c.KimbleOne__DeliveryGroup__c,KimbleOne__Issue__c.KimbleOne__Proposal__c)}" MenuContextName="{!IF(ISBLANK(KimbleOne__Issue__c.KimbleOne__Proposal__c), KimbleOne__Issue__c.DeliveryGroup__r.Name ,KimbleOne__Issue__c.Proposal__r.Name)}"/>
</apex:define>  
   
<apex:define name="Content">

	<!-- Hidden fields for use in controller -->
	<apex:outputField value="{!KimbleOne__Issue__c.KimbleOne__SalesOpportunity__c}" rendered="False"/>
	<apex:outputField value="{!KimbleOne__Issue__c.KimbleOne__DeliveryGroup__c}" rendered="False"/>
	
	<apex:pageMessages escape="false"/>

	<chatter:feedWithFollowers entityId="{!KimbleOne__Issue__c.Id}" rendered="{!ShowChatter}"/>

    <apex:form >
		<apex:outputPanel id="IssueEditPanel" >
				
		    	<apex:pageBlock id="IssueEditBlock" title="{!$ObjectType.KimbleOne__Issue__c.Label}">    

           			<div id="IssueEditErrors">
           				<apex:pageMessages escape="false"/>
           			</div>
           			           		
					<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!save}" value="{!$Label.kimbleone__save}" oncomplete="getReferenceData(); initialiseItems();" reRender="IssueEditPanel"/>
						<apex:commandButton value="{!$Label.kimbleone__cancel}" oncomplete="window.history.back();" reRender=""/>
					</apex:pageBlockButtons>
					
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
             		 
             		    <!--Adding check to see if issue reference is editable-->
						<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!AllowReferenceEdit}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.Name.Label}" />
             				<apex:inputfield id="IssueNameInput" value="{!KimbleOne__Issue__c.Name}" />
           				</apex:pageBlockSectionItem>
           				
             			<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!!AllowReferenceEdit && ISBLANK(KimbleOne__Issue__c.Id)}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.Name.Label}" />
             				<apex:outputText value="{!$Label.kimbleone__autogeneratedlabel}" />
           				</apex:pageBlockSectionItem>

             			<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!!AllowReferenceEdit && !ISBLANK(KimbleOne__Issue__c.Id)}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.Name.Label}" />
             				<apex:outputText id="IssueNameInput" value="{!KimbleOne__Issue__c.Name}" />
           				</apex:pageBlockSectionItem>          				

						<apex:pageBlockSectionItem >              
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.KimbleOne__IssueImpact__c.Label}"/>
               				<apex:selectList id="IssueImpactInput" value="{!KimbleOne__Issue__c.KimbleOne__IssueImpact__c}" size="1" multiselect="false" required="false">
		           				<apex:selectOptions value="{!RiskImpacts}"/>
		           			</apex:selectList> 
						</apex:pageBlockSectionItem>
						
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__IsInternal__c}" /> 
						
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__SharedWithCustomer__c}" rendered="{!DeliveryGroupSharedWithCustomer || KimbleOne__Issue__c.DeliveryGroup__r.KimbleOne__SharedWithCustomer__c}" /> 
						<apex:pageBlockSectionItem rendered="{!!DeliveryGroupSharedWithCustomer}" /> 
						
						<apex:pageBlockSectionItem >              
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.KimbleOne__Status__c.Label}"/>
							<apex:inputText value="{!KimbleOne__Issue__c.KimbleOne__Status__c}" styleclass="kimbledropdown IssueStatus"/>
						</apex:pageBlockSectionItem>
						
						<apex:pageBlockSectionItem >              
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Issue__c.Fields.KimbleOne__IssueCategory__c.Label}"/>
               				<apex:selectList id="IssueCategoryInput" value="{!KimbleOne__Issue__c.KimbleOne__IssueCategory__c}" size="1" multiselect="false" required="false">
		           				<apex:selectOptions value="{!IssueCategories}"/>
		           			</apex:selectList> 
						</apex:pageBlockSectionItem>
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__ClosedDate__c}" styleClass="kimbleDatePicker"/>
					
					</apex:pageBlockSection>					
					
					<apex:pageblockSection collapsible="false" showheader="false"  columns="1">
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__Summary__c}" style="width:500px;"/>
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__Description__c}" style="width:500px;"/>						
					</apex:pageBlockSection>						

					<apex:pageblockSection collapsible="false" showheader="false"  columns="2">							
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__RaisedByContact__c}" styleclass="kimbleSearch" /> 
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__OwnedByContact__c}" styleclass="kimbleSearch" />
						<apex:outputfield value="{!KimbleOne__Issue__c.KimbleOne__Risk__c}" />
						<apex:inputfield value="{!KimbleOne__Issue__c.KimbleOne__RaisedDate__c}" styleClass="kimbleDatePicker"/>
						<apex:pageBlockSectionItem />
				
						<apex:repeat value="{!$ObjectType.KimbleOne__Issue__c.FieldSets.KimbleOne__IssueDetails}" var="f">
		     				<apex:inputField rendered="{!!CONTAINS(f.FieldPath,'.')}" value="{!KimbleOne__Issue__c[f]}" required="{!f.Required}"  styleClass="{!IF(AND($ObjectType.KimbleOne__Issue__c.Fields[f].type == 'date',$ObjectType.KimbleOne__Issue__c.Fields[f].updateable),'kimbleDatePicker','')}" />
							<apex:outputField rendered="{!CONTAINS(f.FieldPath,'.')}" value="{!KimbleOne__Issue__c[f]}"/>
   						</apex:repeat>
		            </apex:pageBlockSection>						
   										
		    	</apex:pageBlock>
		</apex:outputPanel>
    
    </apex:form>

	<script>
		jQuery(window).load(function()
		{
		initialiseItems();
		});
		function initialiseItems()
		{
		SetupDatePicker();
		}
		function SetupDatePicker()
		{
		//dateFormat: 'yy-mm-dd',
		jQuery('.kimbleDatePicker').datepicker({
		dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
		showOtherMonths: true,
		selectOtherMonths: true,
		changeMonth: true,
		changeYear: true});
		}
	</script>

    </apex:define>
    </apex:composition>

</apex:page>