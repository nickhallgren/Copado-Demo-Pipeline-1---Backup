								</apex:outputPanel>
								<apex:outputPanel layout="block">
									<input type="checkbox" class="GroupByRevenueType" onclick="changeRevenueType()"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>


							<apex:outputPanel layout="block" >
