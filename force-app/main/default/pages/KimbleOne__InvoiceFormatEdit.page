							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.Name.Label}" styleClass="NameLbl"/>
								<apex:outputPanel layout="block" styleClass="requiredInput">
									<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
									<apex:inputText value="{!invoiceFormat.Name}" styleClass="Name inp"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__InvoiceMode__c.inlineHelpText}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__InvoiceMode__c.Label}" styleClass="InvoiceModeLbl"/>
								<apex:selectList value="{!invoiceFormat.KimbleOne__InvoiceMode__c}" size="1" styleclass="InvoiceMode" onChange="changeInvoiceMode()">
									<apex:selectOptions value="{!InvoiceModeEnums}" />
								</apex:selectList>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__IsInternal__c.inlineHelpText}">
 								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__IsInternal__c.Label}"/>
								<apex:inputCheckbox value="{!invoiceFormat.KimbleOne__IsInternal__c}" styleclass="IsInternal"  onChange="showHideTabsBasedOnInternalOrSupplier()"/>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__IsSupplier__c.inlineHelpText}">
 								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__IsSupplier__c.Label}"/>
								<apex:inputCheckbox value="{!invoiceFormat.KimbleOne__IsSupplier__c}" styleclass="IsSupplier" onChange="showHideTabsBasedOnInternalOrSupplier()"/>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RoundingRule__c.Label}" styleClass="RoundingRuleLbl" />
								<apex:outputPanel layout="block" styleClass="requiredInput">
									<apex:outputPanel layout="block" styleClass="requiredBlock"/>
									<apex:selectList value="{!invoiceFormat.KimbleOne__RoundingRule__c}" size="1" styleclass="RoundingRule">
										<apex:selectOptions value="{!RoundingRules}" />
									</apex:selectList>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__ShowContext__c.inlineHelpText}">
 								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__ShowContext__c.Label}"/>
								<apex:inputCheckbox value="{!invoiceFormat.KimbleOne__ShowContext__c}" styleclass="ShowContext"/>
							</apex:pageBlockSectionItem>

						</apex:pageblockSection>
