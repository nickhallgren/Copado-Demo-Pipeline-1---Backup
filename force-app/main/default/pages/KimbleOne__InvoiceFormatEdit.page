	//Sorting revenue types
	function changeRevenueType(){
	    if(jQuery(".GroupByRevenueType").prop( "checked")){
	        jQuery("#RevenueTypeSortPanel").show();
     	}
     	else{
     	    jQuery("#RevenueTypeSortPanel").hide();
      	}
 	}
	function refreshRevenueTypeOrder(){
	    var revenueTypeOrder = [];
		jQuery.each(theInvoiceFormat.Rules.GroupingRules,function(key,theRule){
			var theSortItem = {};
			theSortItem.Sequence = theRule.Sequence;
			theSortItem.ObjectType = theRule.ObjectType;
			theSortItem.Label = jQuery("#"+theRule.ObjectType+"-tab").attr("label");
			if (theSortItem.Label != undefined)
			revenueTypeOrder.push(theSortItem);
		});

		revenueTypeOrder.sort(function (a, b) {
			if(a.Sequence > b.Sequence)
				return  1;
			return -1;

		});

		changeRevenueType();

		var revenueTypeOrderTable =  jQuery("#RevenueTypeSortPanel>div>table>tbody");
		revenueTypeOrderTable.html("");

		var newCurrentRevenueTypeLinksHtml = [];

		jQuery.each(revenueTypeOrder,function(key,revenueType){
		    var tr = jQuery('<tr>').attr('fieldId',revenueType.Sequence);
			tr.click(function(e){selectRevenueType(jQuery(this).attr('fieldId'));e.preventDefault();});
				tr.append(jQuery('<td>').text(revenueType.Sequence));
				tr.append(jQuery('<td>').text(revenueType.Label));
				revenueTypeOrderTable.append(tr);
				newCurrentRevenueTypeLinksHtml.push(jQuery("#InvoicableItemsTabs>ul>li."+revenueType.ObjectType+"-tab-title"));
		});

		jQuery("#InvoicableItemsTabs>ul").html("");
		jQuery.each(newCurrentRevenueTypeLinksHtml,function(key,newLi){
		    jQuery("#InvoicableItemsTabs>ul").append(newLi);
	   });

		jQuery('#InvoicableItemsTabs').tabs('destroy');
		constructTabs();
		return revenueTypeOrder;
 	}

 	function moveRevenueTypeUp(){
		if (currentlySelectedKey == 1)
			return;

		var previousField = null;
		var newKey = null;
		jQuery.each(theInvoiceFormat.Rules.GroupingRules,function(key,theRevenueTypeGroup){
		    if(theRevenueTypeGroup.Sequence == currentlySelectedKey){
        	 	newKey = parseInt(theRevenueTypeGroup.Sequence) - 1;
        	 	theRevenueTypeGroup.Sequence  = newKey;
        	 }
        	 else if(theRevenueTypeGroup.Sequence == parseInt(currentlySelectedKey)-1)
        	 	theRevenueTypeGroup.Sequence = parseInt(currentlySelectedKey);
        });
		refreshRevenueTypeOrder()
		selectRevenueType(newKey);

	}
	function selectRevenueType(id){
		jQuery('#RevenueTypeSortPanel>div>table>tbody>tr').css('background-color','#FFFFFF');
	    jQuery('#RevenueTypeSortPanel>div>table>tbody>tr[fieldId='+id+']').css('background-color','#C0C0C0');
	    currentlySelectedKey = id;
	}
	function moveRevenueTypeDown(){
		if (currentlySelectedKey == Object.keys(theInvoiceFormat.Rules.GroupingRules).length)
			return;

		var isFoundField = null;
		var newKey = null;

		jQuery.each(theInvoiceFormat.Rules.GroupingRules,function(key,theRevenueTypeGroup){
		    if(theRevenueTypeGroup.Sequence == currentlySelectedKey){
        	 	newKey = parseInt(theRevenueTypeGroup.Sequence) + 1;
        	 	theRevenueTypeGroup.Sequence = newKey;
        	 }
        	else if(theRevenueTypeGroup.Sequence == parseInt(currentlySelectedKey)+1)
        	 	theRevenueTypeGroup.Sequence = currentlySelectedKey;
		});

		refreshRevenueTypeOrder()
		selectRevenueType(newKey);
	}
	//end sorting revenue types
	function showHideTabsBasedOnInternalOrSupplier(){
	    var isInternal = jQuery('.IsInternal').prop("checked");
	    var isSupplier = jQuery('.IsSupplier').prop("checked") ;

		if(isSupplier){
			jQuery('.CostOnly').show();
			jQuery('.RevenueOnly').hide();
		}
		else{
			jQuery('.CostOnly').hide();
			jQuery('.RevenueOnly').show();
		}

	    var revenueTypeOrder = refreshRevenueTypeOrder();
	    var firstVisibleKey = undefined;
	    jQuery.each(revenueTypeOrder,function(key,revenueType){
			var obj = revenueType.ObjectType;

			if(obj == "{!$ObjectType.DepositAdjustment__c.Name}" || obj == "{!$ObjectType.CreditAdjustment__c.Name}" || obj == "{!$ObjectType.RevenueAdjustment__c.Name}"
	        	|| obj == "{!$ObjectType.PeriodRevenue__c.Name}" || obj == "{!$ObjectType.Credit__c.Name}" || obj == "{!$ObjectType.DiscountItem__c.Name}"
	        	|| obj == "{!$ObjectType.Deposit__c.Name}"){
	        	if(isSupplier)
	        		jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").hide();
	        	else{
	        		jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").show();
	        		if(firstVisibleKey == undefined)
	        			firstVisibleKey = key;
	        	}
          	}
			else if(obj == "{!$ObjectType.InternalRevenueShare__c.Name}"){
				if(!isInternal || isSupplier)
					jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").hide();
				else{
		    		jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").show();
		    		if(firstVisibleKey == undefined)
	        			firstVisibleKey = key;
		    	}
			}
			else if(obj == "{!$ObjectType.PeriodCost__c.Name}"){
			    if(!isSupplier)
					jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").hide();
				else{
					jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").show();
					if(firstVisibleKey == undefined)
	        			firstVisibleKey = key;
				}
			}
			else{
			    jQuery("#InvoicableItemsTabs>ul>li."+obj+"-tab-title").show();
				if(firstVisibleKey == undefined)
	        		firstVisibleKey = key;
   			}
		});

		jQuery( "#InvoicableItemsTabs" ).tabs("option", "active", firstVisibleKey);


 	}
	function GetInvoiceFormat()
	{
		jQuery('#loadingIndicatorOuterContainer').show();
		var invoiceFormatId = '{!JSENCODE($CurrentPage.parameters.id)}';
		if(invoiceFormatId == '') invoiceFormatId = null;
		var cloneId = '{!JSENCODE($CurrentPage.parameters.cloneId)}'; 	
		if(cloneId == '') cloneId = null;
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InvoiceFormatEditController.GetInvoiceFormat}',
			invoiceFormatId, cloneId,
				function(result, event){          
					if (event.status) {
						theInvoiceFormat = result;
						reloadAll();
						completeLoad();
					}
					else if (event.type === 'exception') alert(event.message);
			    		else alert(event.message);
			    		jQuery('#loadingIndicatorOuterContainer').hide();
			    }, 
			    {escape: false, timeout: 60000});
	}
	
	function ErrorMsgLine(fieldname){
		return '<li>'+('{!$label.RequiredValue}').replace('{0}', fieldname)+'</li>';
	}
	
	function SaveInvoiceFormat(){
		
		var toValidate =  ["Name", "SingleDateNarrative", "DateRangeNarrative", "RatePerUnitNarrative", "RatePerUnitPerPeriodNarrative", "NumberOfUnitsNarrative", "RoundingRule"];
		
		var errorMessages = '';
		
		jQuery.each(toValidate, function(i, toVali){
			var cls = '.'+toVali;
			if(jQuery(cls).val() == '')
				errorMessages += ErrorMsgLine(jQuery(cls+'Lbl').text());
		});
		 
		jQuery.each(jQuery('.tabContainer'), function(key, panel){
			var item = jQuery(panel).attr('item');
			var objLabel = jQuery(panel).attr('label');
			var cls = '.'+item+'-Narrative'
			if(jQuery(cls).select2("val").length == 0)
				errorMessages += ErrorMsgLine(objLabel+' - '+jQuery(cls+'Lbl').text());
			var groupCriterias = theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias;
			if(groupCriterias != undefined && groupCriterias.length > 0){
				var grpcls = '.'+item+'-GroupNameNarrative';
				if(jQuery(grpcls).select2("val").length == 0)
					errorMessages += ErrorMsgLine(objLabel+' - '+jQuery(grpcls+'Lbl').text());
			}	
			
			jQuery.each(jQuery("#"+item+"-tab").find('.DefaultNarrativeField'),function(key, defaultfieldItem){
				if(jQuery(defaultfieldItem).val() == ''){
					var label = $("label[for='" + jQuery(defaultfieldItem).attr('id') + "']").text();
					errorMessages += ErrorMsgLine(objLabel+' - '+label);
				}
			});
		});
			  
		  
		 if( jQuery('.NarattiveSourceAggregate').is(":visible") && jQuery('.NarattiveSourceAggregate').val() == '')
		 	errorMessages += ErrorMsgLine(jQuery('.NarattiveSourceAggregateLbl').text());
		 	
		if(errorMessages != ''){
			jQuery('#InvoiceFormatErrorsMsg').html(errorMessages);
			jQuery('#InvoiceFormatErrors').show();
			return;
		}
		jQuery('#InvoiceFormatErrors').hide();
		jQuery('.GroupNameNarrative').select2("destroy");
		jQuery('.Narrative').select2("destroy");
		jQuery('#loadingIndicatorOuterContainer').show();
		theInvoiceFormat.SingleDateNarrative = jQuery('.SingleDateNarrative').val();
		theInvoiceFormat.DateRangeNarrative = jQuery('.DateRangeNarrative').val();
		theInvoiceFormat.RatePerUnitNarrative = jQuery('.RatePerUnitNarrative').val();
		theInvoiceFormat.NumberOfUnitsNarrative = jQuery('.NumberOfUnitsNarrative').val();
		theInvoiceFormat.RatePerUnitPerPeriodNarrative = jQuery('.RatePerUnitPerPeriodNarrative').val();
		
		theInvoiceFormat.Name = jQuery('.Name').val();
		theInvoiceFormat.InvoiceMode = jQuery('.InvoiceMode').val();
		theInvoiceFormat.ShowContext =jQuery('.ShowContext').prop( "checked") ;
		theInvoiceFormat.IsInternal =jQuery('.IsInternal').prop( "checked") ;
		theInvoiceFormat.IsSupplier =jQuery('.IsSupplier').prop( "checked") ;
		theInvoiceFormat.RoundingRule = jQuery('.RoundingRule').val();
		theInvoiceFormat.Rules.GroupByRevenueType = jQuery('.GroupByRevenueType').prop( "checked");

		theInvoiceFormat.ShowResourceNumberOfUnitsInColumn = jQuery('.ShowResourceNumberOfUnitsInColumn').prop( "checked");
		theInvoiceFormat.ShowResourceRateInColumn = jQuery('.ShowResourceRateInColumn').prop( "checked");
		theInvoiceFormat.ShowTimeInTabularFormat = jQuery('.ShowTimeInTabularFormat').prop( "checked");
		
		if (jQuery('.InvoiceMode').val() == '{!JSENCODE(InvoiceModeEnumAutoId)}'){
			theInvoiceFormat.IncludeCredit = jQuery("input[id$='IncludeCredit']").prop("checked");
			theInvoiceFormat.IncludeCreditAdjustment = jQuery("input[id$='IncludeCreditAdjustment']").prop("checked");
			theInvoiceFormat.IncludeDiscountItem = jQuery("input[id$='IncludeDiscountItem']").prop("checked");
			theInvoiceFormat.IncludeInternalRevenueShare = jQuery("input[id$='IncludeInternalRevenueShare']").prop("checked");
			theInvoiceFormat.IncludeDepositAdjustment = jQuery("input[id$='IncludeDepositAdjustment']").prop("checked");
			theInvoiceFormat.IncludeDeposit = jQuery("input[id$='IncludeDeposit']").prop("checked");
			theInvoiceFormat.IncludeExpenseItem = jQuery("input[id$='IncludeExpenseItem']").prop("checked");
			theInvoiceFormat.IncludeMilestone = jQuery("input[id$='IncludeMilestone']").prop("checked");
			theInvoiceFormat.IncludePeriodRevenue = jQuery("input[id$='IncludePeriodRevenue']").prop("checked");
			theInvoiceFormat.IncludePeriodCost = jQuery("input[id$='IncludePeriodCost']").prop("checked");
			theInvoiceFormat.IncludeRevenueAdjustment = jQuery("input[id$='IncludeRevenueAdjustment']").prop("checked");
			theInvoiceFormat.IncludeTimeEntry = jQuery("input[id$='IncludeTimeEntry']").prop("checked");
		}
		else{
			theInvoiceFormat.IncludeDepositAdjustment = false; theInvoiceFormat.IncludeDeposit = false;
			theInvoiceFormat.IncludeCreditAdjustment = false; theInvoiceFormat.IncludeCredit = false; theInvoiceFormat.IncludeDiscountItem = false; theInvoiceFormat.IncludeInternalRevenueShare = false;
			theInvoiceFormat.IncludeExpenseItem = false; theInvoiceFormat.IncludeMilestone = false; theInvoiceFormat.IncludePeriodRevenue = false;
			theInvoiceFormat.IncludePeriodCost = false; theInvoiceFormat.IncludeRevenueAdjustment = false; theInvoiceFormat.IncludeTimeEntry = false;
		}
		//GroupNameNarratives done
		jQuery.each(jQuery('.tabContainer'), function(key, panel){
			var item = jQuery(panel).attr('item');
		 	var rule = theInvoiceFormat.Rules.GroupingRules[item];
			if(rule == undefined){
				theInvoiceFormat.Rules.GroupingRules[item] = Object();
				rule = theInvoiceFormat.Rules.GroupingRules[item];
			}
			rule.Name = jQuery(panel).find(".RuleName").val();
			rule.DefaultUnitTypeNarrative = jQuery(panel).find(".DefaultUnitTypeNarrative").val();
			rule.DefaultUnitTypeId = jQuery(panel).find(".DefaultUnitTypeId").val();
			rule.DefaultRate = jQuery(panel).find(".DefaultRate").val();
			rule.DefaultInvoicingCurrency = jQuery(panel).find(".DefaultInvoicingCurrency").val();
			
			if (jQuery(panel).find(".DefaultPeriodRate").length > 0 ){
				rule.DefaultPeriodUnitTypeId = jQuery(panel).find(".DefaultPeriodUnitTypeId").val();
				rule.DefaultPeriodUnitTypeNarrative = jQuery(panel).find(".DefaultPeriodUnitTypeNarrative").val();
			}
			if (jQuery(panel).find(".DefaultPeriodRate").length > 0 )
				rule.DefaultPeriodRate = jQuery(panel).find(".DefaultPeriodRate").val();
				
			
		});
		
		var isNew = (theInvoiceFormat.Id == undefined);
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InvoiceFormatEditController.SaveInvoiceFormat}',
			theInvoiceFormat,
				function(result, event){          
					if (event.status){
						theInvoiceFormat = result;
			         	if (isNew && theInvoiceFormat.Id != null)
							safeNavigateToSForceURL('{!$Page.InvoiceFormatEdit}?id='+theInvoiceFormat.Id);
			           	reloadAll();
			           	rememberSelectedRevenueTab();
  			           	displaySaveSuccessMsg();
			        } 
				 	else if (event.type === 'exception') alert(event.message);
			    		else alert(event.message);
			    		jQuery('#loadingIndicatorOuterContainer').hide();
			    }, 
			    {escape: false, timeout: 60000});
	}
		
	function displaySaveSuccessMsg()
	{
	    jQuery('#InvoiceFormatSaveSuccessful').show();
	    
		setTimeout(function(){
			jQuery('#InvoiceFormatSaveSuccessful').fadeOut('slow');
		}, 3000);
 	}	
		
	 jQuery(function() {
	 	GetInvoiceFormat();
	  	collapseAllDefaultNarrativeSourcesSection();
	  	constructTabs();
	  });

	 function constructTabs(){
	     jQuery( "#InvoicableItemsTabs" ).tabs({ activate: function(event ,ui){
	         	currentItem = ui.newTab.attr('item');
	 				loadFieldSelector();
            		currentlySelectedKey = undefined;
            		refreshGroupingCriterias(currentItem);
            }
         });
  	}

  	function completeLoad(){
  	    currentItem = jQuery(jQuery("#InvoicableItemsTabs>ul>li")[jQuery( "#InvoicableItemsTabs" ).tabs("option", "active")]).attr('item');
		loadFieldSelector();
	  	showHideTabsBasedOnInternalOrSupplier();
   	}

   	function rememberSelectedRevenueTab(){
   	    jQuery.each(jQuery("#InvoicableItemsTabs>ul>li"),function(key,tab){
			if (jQuery(tab).attr("item") == currentItem)
				jQuery( "#InvoicableItemsTabs" ).tabs("option", "active", key);
		});
	}

  	</script>
			
