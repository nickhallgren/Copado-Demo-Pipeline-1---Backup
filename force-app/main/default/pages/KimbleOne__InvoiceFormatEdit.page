	function selectInvoiceNarrativeSourceType()
	{
		showOrHideNarattiveSourceType();
		
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.InvoiceFormatEditController.GetInvoiceNarrativeSourceTypeObjects}',
			jQuery('.NarattiveSourceType').val(),
				function(result, event){          
					if (event.status){
			           	var data = {};
			           	var filters = result;
			           	filterObjectsForSourceType = result;
			           	var rootObject = '{!$ObjectType.InvoiceableItem__c.Name}';
						if (currentItem == '{!$ObjectType.PeriodCost__c.Name}')
							rootObject = '{!$ObjectType.SupplierInvoiceableItem__c.Name}';
						
						var narattiveSourceTypeVal = jQuery('.NarattiveSourceType').val();
						var fieldTypes = null;
						if (narattiveSourceTypeVal == 'Date') fieldTypes = dateFieldTypes;
						if (narattiveSourceTypeVal == 'NumberOfUnits' || narattiveSourceTypeVal == 'RatePerUnit' || narattiveSourceTypeVal == 'RatePerUnitPerPeriod' || narattiveSourceTypeVal == 'UnitSum') fieldTypes = numberFieldTypes;
							
			           	//jQuery('.NarattiveSourceField').fieldSelector({rootObject:rootObject, fieldFilters: filters});
			           	
			          	var filter = {
							 	keep : function(field, object, path) {
							 		var narattiveSourceTypeVal = jQuery('.NarattiveSourceType').val();
							 		var fieldType =  field.type.toLowerCase() ;
							 		
							 		if (object.name == '{!$ObjectType.InvoiceableItem__c.Name}' || object.name == '{!$ObjectType.SupplierInvoiceableItem__c.Name}')
							 			return (filterObjectsForSourceType.includes(field.name) && fieldType == 'reference' ) || false;
							 		else {
								 		if (narattiveSourceTypeVal == 'Field')
											return true; 
										else if (narattiveSourceTypeVal == 'Date')
											return (fieldType == 'date' || fieldType == 'datetime');
										else if (narattiveSourceTypeVal == 'NumberOfUnits' || narattiveSourceTypeVal == 'RatePerUnit' || narattiveSourceTypeVal == 'RatePerUnitPerPeriod' || narattiveSourceTypeVal == 'UnitSum') 
											return (fieldType == 'numeric' || fieldType == 'double' || fieldType=='decimal' || fieldType=='currency');
									}	
								}
							};
			           	jQuery('.NarattiveSourceField').fieldSelector({rootObject:rootObject, filter: filter});
			           
			           	
					} 
				 	else if (event.type === 'exception') alert(event.message);
			    		else  alert(event.message);
			    }, 
			    {escape: false, timeout: 60000});
	}

