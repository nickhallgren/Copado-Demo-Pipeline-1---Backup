			<script>
			//var cos = '{!$Component.TheForm.InvoiceFormatEditBlock.TheRepeater.0.DefaultNarrativeSources}';
			
			function collapseAllDefaultNarrativeSourcesSection(){
				//TODO- This is Hacky, will need to make changes if salesforce code changes
				jQuery.each(jQuery("img[id$='DefaultNarrativeSources']"), function(key, section){
					jQuery(section).trigger('click');
					jQuery(section).click(function(){ loadFieldSelector();  });
				});
			}
	
	function changeInvoiceMode(){
		if (jQuery('.InvoiceMode').val() == '{!JSENCODE(InvoiceModeEnumAutoId)}'){
			jQuery.each(jQuery(".Include"), function(k,v){
				jQuery(v).show();
				var id = jQuery(v).attr('id');
				jQuery("label[for='"+id+"']").show();
			});
		}
		else{
			jQuery.each(jQuery(".Include"), function(k,v){
				jQuery(v).hide();
				var id = jQuery(v).attr('id');
				jQuery("label[for='"+id+"']").hide();
			});
		}
	}	
			
	var theInvoiceFormat;
		
	//JSENCODE(
	function loadFieldSelector()
	{
		var tab = currentItem+"-tab";

		var rootObject = '{!$ObjectType.InvoiceableItem__c.Name}';
		if (currentItem == '{!$ObjectType.PeriodCost__c.Name}')
			rootObject = '{!$ObjectType.SupplierInvoiceableItem__c.Name}';
			
		var filter = {
			keep : 
				function(field, object, path) {
					var objectsToAllow = [currentItem, '{!$ObjectType.DeliveryElement__c.Name}'];
					var fieldType =  field.type.toLowerCase() ;
					if (object.name == '{!$ObjectType.InvoiceableItem__c.Name}' || object.name == '{!$ObjectType.SupplierInvoiceableItem__c.Name}')
						return (objectsToAllow.includes(field.name) && fieldType == 'reference' ) || false;
					else
					return true;
				}
			};
			jQuery("#"+tab).find(".GroupCriteriaSearch").fieldSelector({rootObject:rootObject, filter: filter});
			jQuery.each(jQuery("#"+tab).find('.DefaultNarrativeField'),function(key, defaultfieldItem){
				jQuery(defaultfieldItem).fieldSelector({rootObject:rootObject, filter: filter});
			});
			        
	}
	
	
	function changedShowTimeInTabularFormat(){
	
		if( jQuery('.ShowTimeInTabularFormat').prop( "checked")){
			jQuery('.ShowResourceNumberOfUnitsInColumn').attr('disabled',false);
			jQuery('.ShowResourceRateInColumn').attr('disabled',false);
		}
		else{
			jQuery('.ShowResourceNumberOfUnitsInColumn').prop( "checked", false);
			jQuery('.ShowResourceNumberOfUnitsInColumn').attr('disabled',true);
			jQuery('.ShowResourceRateInColumn').prop( "checked", false);
			jQuery('.ShowResourceRateInColumn').attr('disabled',true);
		}
	}
	
	
	function addNewGroupingCriteria(item){
		var tab = item+"-tab";
		var value = jQuery("#"+tab).find(".GroupCriteriaSearch").val();
		if (value != '' ){
			if( theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias == undefined)
				theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias = [];
			
			var maxPosition = 0;
			var isAlreadyThere = undefined;
			jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias,function(key,theField){
				if( theField.Sequence > maxPosition)
					maxPosition = theField.Sequence;
				
				if( theField.FieldName == value)
					isAlreadyThere = true;
			});
			
			if (isAlreadyThere)
				return;
			
			var fieldInList = new Object();
			fieldInList.Sequence = String(parseInt(maxPosition) + 1);
			fieldInList.FieldName = value;
			
			jQuery("#"+tab).find(".GroupCriteriaSearch").val('');
			
			theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias.push( fieldInList);
			
			refreshGroupingCriterias(item);
		}
	}

	function refreshGroupingCriterias(item){
		var tab = item+"-tab";
		jQuery("#"+tab).find('.selectedFieldsListTable>tbody>tr').remove();
		jQuery.each(getSortedGroupingCriterias(item),function(key,theField){
			if (theField != undefined){
				var tr= jQuery('<tr>').attr('fieldId',theField.Sequence);
				tr.click(function(e){selectCurrentGroupingCriteria(jQuery(this).attr('fieldId'));e.preventDefault();});
				tr.append(jQuery('<td>').text(theField.Sequence));
				tr.append(jQuery('<td>').text(theField.FieldName));
				jQuery("#"+tab).find(".selectedFieldsListTable").append(tr);
			}
		});
	}
	
	var currentlySelectedKey;
	
	function selectCurrentGroupingCriteria(id)
	{
		jQuery('.selectedFieldsListTable>tbody>tr').css('background-color','#FFFFFF');
	    jQuery('.selectedFieldsListTable>tbody>tr[fieldId='+id+']').css('background-color','#C0C0C0');
	    currentlySelectedKey = id;
	}
	
	function moveGroupingCriteriaUp(item){
		if (currentlySelectedKey == 1)
			return;
			
		var previousField = null;
		var newKey = null;
		
		jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias,function(key,theField){
			 if(theField.Sequence ==  currentlySelectedKey)
        	 {
        	 	
        	 	newKey = parseInt(theField.Sequence) - 1;
        	 	theField.Sequence = String(newKey); 
        	 	previousField.Sequence = String(parseInt(previousField.Sequence) + 1);
        	 	return false;
        	 }	
        	 previousField = theField;
		});
		
		
		refreshGroupingCriterias(item);
		selectCurrentGroupingCriteria(newKey);
        	 	
	}
	
	function moveGroupingCriteriaDown(item){
		if (currentlySelectedKey == theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias.length)
			return;
	
		var isFoundField = null;
		var newKey = null;
		
		jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias,function(key,theField){
			if(isFoundField){
				theField.Sequence =  String(parseInt(theField.Sequence) - 1); 
				return false;//break loop
			}
		
			if(theField.Sequence == currentlySelectedKey)
	        	{
	        	 	newKey = parseInt(theField.Sequence) + 1;
	        	 	theField.Sequence = String(newKey); 
	        	 	selectCurrentGroupingCriteria(theField.Sequence);
	        	 	isFoundField = true;
	        	}	
		});
		
		refreshGroupingCriterias(item);
		selectCurrentGroupingCriteria(newKey);
	}
	
	function removeGroupingCriteria(item){
		
		if (currentlySelectedKey == null)
			return;
		
		var isFoundField = null;
		var newKey = null;
		
		var indexToDelete = null;
		jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias,function(key,theField){
			if(theField.Sequence == currentlySelectedKey)
        		indexToDelete = key;
        });
		var newSelectedFieldsForItems = [];
		
		jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias, function(key,theField){
			if(key > indexToDelete)
				theField.Sequence = String(parseInt( theField.Sequence) - 1); 
			
			if (key != indexToDelete)
				newSelectedFieldsForItems.push(theField);
		});
		
		theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias = newSelectedFieldsForItems;
		refreshGroupingCriterias(item);
		currentlySelectedKey = null;
	}
	
	function getSortedGroupingCriterias(item) 
	{
		var newSelectedFieldsForItems = [];
		var mapPositionToSet = {};
		var pos = [];
		var count = 0;
		if(theInvoiceFormat.Rules.GroupingRules[item] != undefined && theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias != undefined){
			jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias, function(key,theField){
				 pos.push(theField.Sequence);
	        	 	mapPositionToSet[theField.Sequence] = key;
	        	 	count++;
			});
		}
		
	    	var possort = pos.sort(function(a, b){return a-b});
	    	jQuery.each(possort,function(i,po){
	    		var key = mapPositionToSet[po];
	      	var value = theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias[key];
	      	newSelectedFieldsForItems.push(value);
	    	});
	    	theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias = [];
			
	    	jQuery.each(newSelectedFieldsForItems,function(key,fieldMap){
	    		  theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias.push(fieldMap);
	    	});
    		return theInvoiceFormat.Rules.GroupingRules[item].GroupCriterias;
	}
	
	function showOrHideNarattiveSourceType(){
		if(jQuery('.NarattiveSourceType').val() != '{!JSENCODE(InvoiceNarrativeSourceField)}'){
			jQuery(".NarattiveSourceAggregate").hide();
			jQuery(".NarattiveSourceAggregateLbl").hide();
			return false;
		}
		return true;
	}
	
	function GetFieldAggregateFunctions(){
	
		if (!showOrHideNarattiveSourceType())
			return;
		
		var fullName = jQuery('.NarattiveSourceField').val();
		var distinctObjectsAndFields = [];
		
		var rootObject = '{!$ObjectType.InvoiceableItem__c.Name}';
		if (currentItem == '{!$ObjectType.PeriodCost__c.Name}')
			rootObject = '{!$ObjectType.SupplierInvoiceableItem__c.Name}';
						
		distinctObjectsAndFields.push(rootObject);
		
		jQuery.each(fullName.split('.'), function(key, objectOrField){
			distinctObjectsAndFields.push(objectOrField);
		});
		
		var previousObject = rootObject; 
		jQuery.each(distinctObjectsAndFields, function(key, objectOrField){
		
			if ( previousObject != undefined){
				var sfObject = sforce.connection.describeSObject(previousObject);
				
				if (objectOrField.endsWith('__r') || objectOrField ==  rootObject){
					jQuery.each(sfObject.fields, function(index1, value) {
						if (value.relationshipName == objectOrField){
							previousObject = value.referenceTo;
						}
					});
				}
				else{
					jQuery.each(sfObject.fields, function(index1, value) {
						if(objectOrField == value.name){
						
							var fieldType = value.type;
							jQuery('.NarattiveSourceAggregate>option').remove();
								
							if(fieldType=='numeric' || fieldType=='double' || fieldType=='decimal' || fieldType=='currency')
							{
								jQuery(".NarattiveSourceAggregate").append(jQuery('<option>').attr('value','').text(''));
								jQuery(".NarattiveSourceAggregate").append(jQuery('<option>').attr('value','Min').text('Min'));
								jQuery(".NarattiveSourceAggregate").append(jQuery('<option>').attr('value','Max').text('Max'));
								jQuery(".NarattiveSourceAggregate").append(jQuery('<option>').attr('value','Sum').text('Sum'));
								
								jQuery(".NarattiveSourceAggregate").show();
								jQuery(".NarattiveSourceAggregateLbl").show();
							}
							else if(fieldType=='date' || fieldType=='datetime')
							{
								jQuery(".NarattiveSourceAggregate").append(jQuery('<option>').attr('value','Min').text('Min'));
