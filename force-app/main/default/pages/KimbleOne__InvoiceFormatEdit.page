									<apex:outputLabel value="{!$Label.kimbleone__revenuelabel} {!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitPerPeriodNarrative__c.Label}" styleClass="RevenueOnly"/>
								</apex:outputPanel>
								<apex:outputPanel layout="block" styleClass="requiredInput">
									<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
								<apex:inputText value="{!invoiceFormat.KimbleOne__RatePerUnitPerPeriodNarrative__c}" styleClass="RatePerUnitPerPeriodNarrative inp"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__NumberOfUnitsNarrative__c.inlineHelpText}" >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__NumberOfUnitsNarrative__c.Label}" styleClass="NumberOfUnitsNarrativeLbl"/>
								<apex:outputPanel layout="block" styleClass="requiredInput">
									<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
								<apex:inputText value="{!invoiceFormat.KimbleOne__NumberOfUnitsNarrative__c}" styleClass="NumberOfUnitsNarrative inp"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem />
							<apex:pageBlockSectionItem />
						</apex:pageblockSection>

						<apex:pageblockSection collapsible="true" showheader="true"  columns="1" title="{!$ObjectType.KimbleOne__InvoiceSection__c.Label}  Ordering">
							<apex:pageBlockSectionItem >
								<apex:outputPanel >
									<apex:outputLabel value="Define Cost Type Order" styleClass="CostOnly"/>
