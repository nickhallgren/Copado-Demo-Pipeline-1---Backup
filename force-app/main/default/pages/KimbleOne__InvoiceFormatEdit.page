	function getNewNarrativeFieldValue(curentValue, toRemove){
		var newObjectNarrativeStr = '';
		var isFound = false;
		if (curentValue != undefined){
			jQuery.each( curentValue.split(" "), function(key, theSeq){
				if (isFound && theSeq.startsWith('{') && theSeq.endsWith('}'))
					theSeq = '{'+String(parseInt(theSeq.replace('{','').replace('}','')) - 1)+'}';
					
				if (theSeq != '{'+toRemove+'}' || isFound)
					newObjectNarrativeStr = newObjectNarrativeStr + (newObjectNarrativeStr!=''?' ':'') + theSeq ; 
					
				if (theSeq == '{'+toRemove+'}') 
					isFound = true;
			});
		}
		return newObjectNarrativeStr;
	}	
	
