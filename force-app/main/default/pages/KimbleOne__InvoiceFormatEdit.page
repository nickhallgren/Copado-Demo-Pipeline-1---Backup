							</apex:outputPanel>
							<input class="btn" type="button" onclick="safeNavigateToSForceURL('/{!$ObjectType.InvoiceFormat__c.keyPrefix}');" value="{!$Label.Cancel}"/>
						</apex:pageBlockButtons>

						<apex:pageblockSection collapsible="false" showheader="false"
