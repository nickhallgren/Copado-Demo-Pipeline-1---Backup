								</apex:outputPanel>
								<apex:outputPanel layout="block" styleClass="requiredInput">
									<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
									<apex:inputText value="{!invoiceFormat.KimbleOne__RatePerUnitNarrative__c}" styleClass="RatePerUnitNarrative inp"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem helpText="{!$ObjectType.KimbleOne__InvoiceFormat__c.Fields.KimbleOne__RatePerUnitPerPeriodNarrative__c.inlineHelpText}" >
