 	 	jQuery('.NumberOfUnitsNarrative').val(theInvoiceFormat.NumberOfUnitsNarrative);
 	 	jQuery('.DateRangeNarrative').val(theInvoiceFormat.DateRangeNarrative);
		jQuery('.RatePerUnitPerPeriodNarrative').val(theInvoiceFormat.RatePerUnitPerPeriodNarrative);
		jQuery("input[id$='IncludeDepositAdjustment']").prop("checked", theInvoiceFormat.IncludeDepositAdjustment);
		jQuery("input[id$='IncludeCredit']").prop("checked", theInvoiceFormat.IncludeCredit);
		jQuery("input[id$='IncludeCreditAdjustment']").prop("checked", theInvoiceFormat.IncludeCreditAdjustment);
		jQuery("input[id$='IncludeDiscountItem']").prop("checked", theInvoiceFormat.IncludeDiscountItem);
		jQuery("input[id$='IncludeInternalRevenueShare']").prop("checked", theInvoiceFormat.IncludeInternalRevenueShare);
		jQuery("input[id$='IncludeDeposit']").prop("checked", theInvoiceFormat.IncludeDeposit);
