			else if (jQuery(control).attr('item') == '{!$ObjectType.ExpenseItem__c.Name}') theInvoiceFormat.ExpenseItemNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.Milestone__c.Name}') 	theInvoiceFormat.MilestoneNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.PeriodRevenue__c.Name}') 	theInvoiceFormat.PeriodRevenueNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.PeriodCost__c.Name}') theInvoiceFormat.PeriodCostNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.RevenueAdjustment__c.Name}') 	theInvoiceFormat.RevenueAdjustmentNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.Deposit__c.Name}') theInvoiceFormat.DepositNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.DepositAdjustment__c.Name}') 	theInvoiceFormat.DepositAdjustmentNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.Credit__c.Name}') 	theInvoiceFormat.CreditNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.CreditAdjustment__c.Name}') 	theInvoiceFormat.CreditAdjustmentNarrative = val;
			else if (jQuery(control).attr('item') == '{!$ObjectType.DiscountItem__c.Name}') 	theInvoiceFormat.DiscountItemNarrative = val;
			else if ((jQuery(control).attr('item') == '{!$ObjectType.InternalRevenueShare__c.Name}') && ({!IsIntercompanyEnabled})) 	theInvoiceFormat.InternalRevenueShareNarrative = val;
