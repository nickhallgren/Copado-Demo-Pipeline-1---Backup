												<td style="width: 5%">Sequence</td> <td style="width: 85%;">Revenue Type</td>
											</tr>
										</thead>
										<tbody> </tbody></table>
							</div>
							<div class="buttons fieldsAndButtons-item">
								<input class="btn fieldListActionBtn" onclick="moveRevenueTypeUp()" type="button" value="Up"/> <input class="btn fieldListActionBtn" onclick="moveRevenueTypeDown()" type="button" value="Down"/>
							</div>
						</div>
								</apex:outputPanel>
						</apex:pageblockSection>
						<div id="InvoicableItemsTabs">
							<ul>
								<apex:repeat var="item" value="{!InvoicableItems}">
