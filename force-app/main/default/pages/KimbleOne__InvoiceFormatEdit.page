	function convertNarativeToParts(narrativeStr){
		var parts = [];
		var word = '';
		for (var i = 0; i < narrativeStr.length; i++) {
			var thisChar = narrativeStr.charAt(i);
			var added = false;
			if( thisChar == '{')
			{
				if(word != '') {
					parts.push(word);
					word = '';
				}
			}
			if( word.startsWith('{'))
			{
				word = word + thisChar;
				if(thisChar == "}"){
					parts.push(word);
					word = '';
					added = true;
				}
			}
			else if( thisChar == ' '){
				if(word != '') parts.push(word);
				parts.push('[SPACE]');
				word = '';
				added = true;
			}
			else{
			
				if (thisChar == ',') word = word + '[COMMA]';
				else word = word + thisChar;
			}
			if(!added && i == narrativeStr.length - 1)
				parts.push(word);
		}
		return parts;
	}
	
	function CreateNarrativeControl(item, narrativeControlName, selectChoicesArr){
		/**Using select2 control. Contains hacks to allow it contain muiltiples words/characters of same value
			Hack basically works by making it look same on the disaply but making it look different in values by appending values with a counter
		**/
		var selectChoicesArr_ = [];
		var count = 0;
		jQuery.each( selectChoicesArr, function(key, theSeq){
			if (!theSeq.startsWith('{') && !theSeq.endsWith('}')){
				count++; 
				theSeq = String(count)+'[TEXTBODY]'+theSeq ;//JSON.stringify({id : String(count), text: theSeq })
			}
			selectChoicesArr_.push(theSeq);
		});

		var narrativeControl = jQuery(narrativeControlName);
		var choiceSources = [];
		if(theInvoiceFormat.Rules.GroupingRules[item].NarrativeSources != undefined){
			jQuery.each(theInvoiceFormat.Rules.GroupingRules[item].NarrativeSources,function(key,theSource){
				choiceSources.push({id:'{'+key+'}',	text: theSource.Name});//, type:
			});
		}
		
		narrativeControl.select2({
			tags: choiceSources,
			tokenSeparators: [",,","  "],
			formatSelection: function (obj) {
				if (obj.id != undefined && obj.id.startsWith('{') && obj.id.endsWith('}')) return '<b><<</b>'+obj.text+'<b>>></b>'; 
				else {
					if(obj.text.includes('[TEXTBODY]')) {
						var textBody = (obj.text.split('[TEXTBODY]')[1]);
						while(textBody.includes('[COMMA]')) textBody = textBody.replace("[COMMA]",",");
						while(textBody.includes('[SPACE]')) textBody = textBody.replace("[SPACE]","&nbsp");
						return textBody;
					}
					else return obj.text;
				}
			},
			escapeMarkup: function(m) { return m; }
		});
		narrativeControl.select2('val', selectChoicesArr_);
		narrativeControl.select2("container").find("ul.select2-choices").attr('parentcontrol', narrativeControlName );
		narrativeControl.select2("container").find("ul.select2-choices").sortable({
		    containment: 'parent',
		    start: function() { jQuery(jQuery(this).attr('parentcontrol')).select2("onSortStart"); },
		    update: function() { jQuery(jQuery(this).attr('parentcontrol')).select2("onSortEnd"); }
		});
		narrativeControl.on("change", function(e) {  
			if (e.added != undefined){
				var added = e.added.id;
				var currentValues = jQuery(this).select2("val");
				var count = 0; var newValues = []; var newItem = undefined; var i = 0;
				if(!added.startsWith('{') && !added.endsWith('}') && !added.includes('[TEXTBODY]')){
					newItem = added;
					if (newItem == ' ') newItem = '[SPACE]';
					if (newItem == ',') newItem = '[COMMA]';
				}
				jQuery.each( currentValues, function(key, theSeq){
					if(theSeq.includes('[TEXTBODY]'))
						count = parseInt(theSeq.split('[TEXTBODY]')[0]);
					if(i < currentValues.length-1 && theSeq != '')
						newValues.push(theSeq);
					i++;
				});
				if(newItem != undefined){
					count++;
					newValues.push(String(count)+'[TEXTBODY]'+newItem);
				}
				else
					newValues.push(added);
				jQuery(this).select2("val", newValues);				
			}
		   narrativeControlChange(this);
		});
	}
	
	function narrativeControlChange(control){
		var curentValue = jQuery(control).select2("val");
		var val = '';
		jQuery.each( curentValue, function(key, theSeq){
			
			if(theSeq.includes('[TEXTBODY]')) {
				var textBody = (theSeq.split('[TEXTBODY]')[1]);
				while(textBody.includes('[COMMA]'))  textBody = textBody.replace("[COMMA]",",");
				while(textBody.includes('[SPACE]')) textBody = textBody.replace("[SPACE]"," ");
				val = val + textBody;
			}
			else 
				val = val + theSeq;
		});
		var rule = theInvoiceFormat.Rules.GroupingRules[jQuery(control).attr('item')];
		if(jQuery(control).is('.GroupNameNarrative'))	rule.GroupNameNarrative = val;
		else if (jQuery(control).is('.Narrative')){
