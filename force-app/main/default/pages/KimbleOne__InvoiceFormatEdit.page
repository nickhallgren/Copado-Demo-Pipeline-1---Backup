<apex:page standardController="KimbleOne__InvoiceFormat__c" extensions="KimbleOne.InvoiceFormatEditController" sidebar="false" showHeader="true">


<apex:composition template="KimbleOne__SiteMaster">
	<apex:define name="Menu">
			<c:Menu id="menuPageTitle" DefaultHelpPage="CustomizingInvoiceFormats.html" MenuContextName="{!$ObjectType.KimbleOne__InvoiceFormat__c.Label}"/>
	</apex:define>

	<apex:define name="Content">	
		<c:JQueryFieldSelectorAddIn />

		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
	
			
<Style>
.inp{
	width: 200px;
}			
/* SELECT 2 STYLING */
.select2-results li {margin-left:0px;}
.select2-container-multi .select2-choices
{
	border: 2px solid rgb(224,224,224);
	background-image:none;
}
.select2-container-multi .select2-choices .select2-search-choice {
	border: 2px solid rgb(0, 148, 255);
	border-radius: 6px;
	padding: 5px 20px 5px 4px;
	background-image:none;
}

.select2-container-multi .select2-search-choice-close {
	background-image:  url({!URLFOR($Resource.KimbleOne__AssignmentImages, 'assignmentSprite.png')});
	background-position: -2px -29px;
	background-repeat: no-repeat;
	left:auto;
}

.select2-container-multi .select2-choices .select2-search-choice .select2-search-choice-close:hover {
	background-position: -2px -1px;
}
.GroupCriteriaSearch {
	width: 530px;
}


.tabContainer {
	
}

.fields {
	padding-right: 20px;
	display: inline-block;
	display: table-column;
}

.buttons {
	overflow: hidden;
	display: inline-grid;
	height: 90px;
	width: 80px; 
}

.selectedFieldsListTable {
	width: 90%;
	table-layout: fixed;
}

.selectedFieldsListTable td {
	overflow: hidden;
	text-overflow: ellipsis;
	word-wrap: break-word;
	white-space: normal;
}

.selectedFieldsListTable tr {
	height: 30px;
}

.fieldsAndButtons {
	display: grid;
	grid-template-columns: auto auto;
}

.fieldsAndButtons-item {
	border: 0px solid rgba(0, 0, 0, 0);
	padding-right: 10px;
}

.fieldListActionBtn {
	height: 25px;
}


/* Loading idicator */
		.loadingIndicator img {
	    	margin-right:9px;
		}
	
		.loadingIndicator {
		   top:0;
		   right:0;
		   width:100%;
		   height:100%;
		   font-weight: bold;
		   position:absolute;
		   text-align:center;
		   /* IE filter */
		   filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
		   -moz-opacity:0.7;    /* Mozilla extension */
		   -khtml-opacity:0.7;  /* Safari/Conqueror extension */
		   opacity:0.7; /* CSS3 */
		   z-index:1000;
		   background-color:white;
		}
	
		#loadingIndicatorInnerContainer { 
		    position:absolute; 
		    top:50%;
		    height:10em; 
		    margin-top:-2em;
		    width:100%;
		}
		#loadingIndicatorOuterContainer { 
			display:none;
		}

  		.GroupByPosition{
		    border-radius: 5px;
  			background: #909090;
  			padding: 10px;
			width: 230px;
			position: absolute;
  			right: 0px;
  			margin-right: 2px;
		}
		.GroupByPositionSummary{
		    border-radius: 5px;
  			background: #909090;
  			padding: 10px;
			width: 230px;
			color: white;
		}
</Style>

			<apex:outputPanel layout="none" rendered="{!!ISBLANK(NoAccessMessage)}">
				<apex:outputText value="{!NoAccessMessage}"/>
			</apex:outputPanel>
			
			<apex:outputPanel layout="none" rendered="{!ISBLANK(NoAccessMessage)}">

			<apex:form id="TheForm" >
				<apex:actionFunction action="{!Cancel}" name="CancelInvoiceFormat"  rerender="TheForm" />
				
				<apex:outputPanel id="InvoiceFormatPanel">

					<div id="InvoiceFormatErrors" style="display:none">
						<apex:pageMessage summary="{!$Label.kimbleone__errors}" severity="warning" strength="2" rendered="true">
							<ul id="InvoiceFormatErrorsMsg" style=" margin:0px ;padding:0">
								
							</ul>
						</apex:pageMessage>
					</div>
					<apex:pagemessages escape="false" />

					<div id="InvoiceFormatSaveSuccessful" style="display:none">
						<apex:pageMessage summary="{!$ObjectType.KimbleOne__InvoiceFormat__c.label} {!$Label.kimbleone__changessavedmessage}" severity="confirm" strength="3" />
					</div>
					
					<div>
						<div id="loadingIndicatorOuterContainer" class="loadingIndicator">
						    	<div id="loadingIndicatorInnerContainer">
						        	<img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
						  	</div>
						</div>
						<div id="TheMainFormContainer">
				
				
					<apex:pageBlock id="InvoiceFormatEditBlock"
						title="{!$ObjectType.KimbleOne__InvoiceFormat__c.Label}">

						<apex:pageBlockButtons location="both">
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__InvoiceFormat__c.updateable}">
