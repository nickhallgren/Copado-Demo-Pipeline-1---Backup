			<c:Menu HelpSource="CfgGuide" DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextName="Configuration Catalog Edit" BreadCrumbLink="{!$Page.KimbleOne__ConfigurationDataManagement}" BreadCrumbName="{!$Label.kimbleone__configdatamgmtlabel}"/>
		</apex:define>
		<apex:define name="Content">
			<!-- implement switch to run on dev -->
			<apex:canvasApp developerName="{!ConfigCatalogCanvasAppName}" height="2000" width="100%" maxHeight="infinite" parameters="{mode:'master'}"/>
