<apex:page standardcontroller="KimbleOne__CostAdjustment__c" extensions="KimbleOne.CostAdjustmentApproveController,KimbleOne.SecurityController" standardStylesheets="true" showHeader="true" sidebar="false" >
  	<apex:Composition template="KimbleOne__SiteMaster">
		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="Approvingapprovalrequests.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__CostAdjustment__c.DeliveryElement__r.KimbleOne__DeliveryGroup__c}" MenuContextName="{!KimbleOne__CostAdjustment__c.DeliveryElement__r.DeliveryGroup__r.Name}"/>
		</apex:define>
		<apex:define name="Content">
			
			<!-- Cost Adjustment Details -->
			<apex:form id="TheForm">
				
				<apex:outputPanel id="costAdjustmentPanel">
							    		    
					<apex:outputPanel id="pageErrors">
   						<apex:pageMessages escape="False" />
					</apex:outputPanel>

					<apex:pageBlock title="{!$ObjectType.KimbleOne__CostAdjustment__c.Label} - {!KimbleOne__CostAdjustment__c.Name}">
			 		    	
			 		    <apex:pageBlockButtons location="top">
    						<apex:commandButton id="sendForApprovalBtn" action="{!SendForApproval}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__sendforapprovalbutton}" rerender="TheForm, ApprovalHistoryPanel" rendered="{!KimbleOne__CostAdjustment__c.Status__r.KimbleOne__Enum__c = 'Draft' && $ObjectType.KimbleOne__CostAdjustment__c.updateable && KimbleOne__CostAdjustment__c.DeliveryElement__r.KimbleOne__AllowNewCostAdjustments__c}"/>
    						<apex:commandButton id="revertBtn" action="{!Revert}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__reverttodraft}" rerender="TheForm" rendered="{!CanRevertCostAdjustment && HasPermission['RevertApprovedCostAdjustment'] && KimbleOne__CostAdjustment__c.DeliveryElement__r.KimbleOne__AllowNewCostAdjustments__c}"/>
					   	</apex:pageBlockButtons>
			 		    	
			 		    <apex:pageBlockSection columns="2">
							
							<apex:outputField value="{!KimbleOne__CostAdjustment__c.Account__r.Name}"/>																																								
									
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__CostAdjustment__c.Fields.KimbleOne__CostAdjustmentReason__c.Label}"></apex:outputLabel>
								<apex:outputField value="{!KimbleOne__CostAdjustment__c.CostAdjustmentReason__r.Name}"/>																					
							</apex:pageBlockSectionItem>
									
							<apex:outputField value="{!KimbleOne__CostAdjustment__c.Name}"/>
																		
							<apex:outputField value="{!KimbleOne__CostAdjustment__c.KimbleOne__Description__c}"/>
									
							<apex:outputField value="{!KimbleOne__CostAdjustment__c.KimbleOne__AdjustmentDate__c}"/>
									
							<apex:outputField value="{!KimbleOne__CostAdjustment__c.KimbleOne__AdjustmentCost__c}"/>
									
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__CostAdjustment__c.Fields.KimbleOne__Status__c.Label}"></apex:outputLabel>
								<apex:outputField value="{!KimbleOne__CostAdjustment__c.Status__r.Name}"/>
							</apex:pageBlockSectionItem>
									
						</apex:pageBlockSection>
			 		
			 		</apex:pageBlock>
				
				</apex:outputPanel>
			
			</apex:form>
				
			<!-- Cost Adjustment Items Details -->
			<apex:outPutPanel id="costAdjustmentItemPanel">
				
				<apex:pageBlock >
	 						
					<apex:pageBlockSection collapsible="false" showheader="true" columns="1">
								
						<apex:facet name="header">
							{!$ObjectType.KimbleOne__CostAdjustmentItem__c.LabelPlural}
						</apex:facet>
						
						<apex:facet name="body">
						
							<apex:pageBlockTable value="{!CostAdjustmentItems}" var="WOItem">
																	
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__DeliveryElement__c.Label}" width="100px" style="text-align:left;" value="{!WOItem.KimbleOne__DeliveryElement__c}"></apex:column>																		
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__AdjustmentCost__c.Label}" style="text-align:right;" width="100px" value="{!WOItem.KimbleOne__AdjustmentCost__c}"></apex:column>
										
								<!-- Invoice Types -->
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__ActivityAssignment__c.Label}" width="100px" style="text-align:center;" value="{!WOItem.ActivityAssignment__r.Name}"></apex:column>
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__TimeEntry__c.Label}" width="100px" style="text-align:center;" value="{!WOItem.TimeEntry__r.Resource__r.Name} {!WOItem.TimeEntry__r.TimePeriod__r.Name}"></apex:column>
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__ExpenseItem__c.Label}" width="100px" style="text-align:center;" value="{!WOItem.ExpenseItem__r.Resource__r.Name} {!WOItem.ExpenseItem__r.ActivityExpenseCategory__r.Name}"></apex:column>																							
								<apex:column headerValue="{!$ObjectType.KimbleOne__CostAdjustmentItem__c.Fields.KimbleOne__Milestone__c.Label}" width="100px" style="text-align:center;" value="{!WOItem.Milestone__r.Name}"></apex:column>
										
							</apex:pageBlockTable>
						
						</apex:facet>
					
					</apex:pageBlockSection>

				</apex:pageBlock>
			
			</apex:outPutPanel>
			
			<!-- Approval History -->
			<apex:include pageName="{!$Page.ApproveRejectItem}" rendered="{!InPageApproveRejectEnabled}"/>
			<apex:relatedList list="ProcessSteps" id="CostAdjustmentApprovalHistory"></apex:relatedList>

			<apex:outputPanel layout="none" rendered="{!InPageApproveRejectEnabled}">
			<script>
				jQuery(window).load(function()
				{
					var approvalItemId = '<apex:outputText value="{!KimbleOne__CostAdjustment__c.Id}"/>';

					overrideSFApproveRejectLink(approvalItemId);
				});
			</script>
			</apex:outputPanel>

			<script>
					$(document).ready(function(){
    					$(function() {
    						hideSalesForceApprovalProcessButtons();
    					})
    				});
    				function hideSalesForceApprovalProcessButtons()
    				{
    						$('input[name="piSubmit"]').remove();
    						$('input[name="piRemove"]').remove();
    				}
			</script>
		
		</apex:define>
	
	</apex:Composition>

</apex:page>