<apex:page standardController="KimbleOne__SupplierPurchaseOrder__c" extensions="KimbleOne.SupplierPurchaseOrderEditController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__ReferenceData__c">
<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
      	<c:Menu MenuContextType="SupplierRequisition" MenuContextId="{!supplierRequisition.Id}" MenuContextName="{!supplierRequisition.Name}"/>
    </apex:define> 
    
    <apex:define name="Content">
    	<apex:form id="TheForm">
    	<div id="pageErrors">
    		<apex:pageMessages escape="False" />
		</div>
		<apex:pageBlock title="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__SupplierPurchaseOrder__c.label}">
		
			<apex:pageBlockButtons location="bottom">
           		
           		<apex:commandButton action="{!Save}" value="{!$Label.kimbleone__save}" />
           		<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}" />
            	
            </apex:pageBlockButtons>
			
			
			<apex:pageblockSection collapsible="false" showheader="true" columns="1">

				<apex:pageBlockSectionItem >
					<apex:outputText value="{!$ObjectType.KimbleOne__SupplierPurchaseOrder__c.Fields.KimbleOne__BusinessUnitTradingEntity__c.Label}" />
					<apex:outputPanel layout="none">
						<apex:selectList value="{!KimbleOne__SupplierPurchaseOrder__c.KimbleOne__BusinessUnitTradingEntity__c}" size="1">
							<apex:selectOptions value="{!buTradingEntityOptions}" />
						</apex:selectList>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputText value="{!$ObjectType.KimbleOne__SupplierPurchaseOrder__c.Fields.KimbleOne__SupplierPurchaseOrderTemplate__c.Label}" />
					<apex:outputPanel layout="none">
						<apex:selectList value="{!KimbleOne__SupplierPurchaseOrder__c.KimbleOne__SupplierPurchaseOrderTemplate__c}" size="1">
							<apex:selectOptions value="{!poTemplateOptions}" />
						</apex:selectList>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

		    </apex:pageBlockSection>
		</apex:pageBlock>
		</apex:form>
	</apex:define>
</apex:composition>

</apex:page>