<apex:page standardController="KimbleOne__Product__c" 	extensions="KimbleOne.ExpenseCategoryProfileTemplatesCntrllr" sidebar="false">

	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">

			<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>

		</apex:define>

		<apex:define name="Content">


			<apex:pageMessages escape="false"/>

			<apex:outputPanel id="TemplatesMainPanel">

				<apex:form >
					<apex:pageBlock id="TemplatesDetailPanel">

						<apex:pageBlockButtons >
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.createable}">
								<input class="btn" type="button"
										onclick="initialiseModalBoxy('#TemplatesPopup', '{!JSENCODE($Label.New)} {!$ObjectType.ExpenseCategoryProfileTemplate__c.label}');newTemplate()"
										value="{!$Label.New} {!$ObjectType.ExpenseCategoryProfileTemplate__c.label}" />
							</apex:outputPanel>
						</apex:pageBlockButtons>

						<apex:pageBlockTable value="{!ExpenseCategoryProfileTemplates}"
							var="aTemplate">
							<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
								<apex:outputPanel rendered="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.updateable}">
									<apex:outputLink value="#" onclick="initialiseModalBoxy('#TemplatesPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.label}');editTemplate('{!JSINHTMLENCODE(aTemplate.id)}')">{!$Label.kimbleone__edit}</apex:outputLink>
								</apex:outputPanel>
	           					&nbsp; | &nbsp;
								<apex:commandLink onclick="var d = confirmDelete();if(!d) return;"
									action="{!deleteExpenseCategoryProfileTemplate}" rendered="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.deletable}"
									reRender="TemplatesMainPanel">{!$Label.kimbleone__delete}
									<apex:param name="eptId" value="{!aTemplate.Id}" />
								</apex:commandLink>
							</apex:column>

							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.Fields.Name.Label}"
								value="{!aTemplate.Name}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.Fields.KimbleOne__ExpenseCategory__c.Label}"
								value="{!aTemplate.ExpenseCategory__r.Name}" />
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.Fields.KimbleOne__NumberOfUnits__c.Label}"
								value="{!aTemplate.KimbleOne__NumberOfUnits__c}" />
							<apex:column headerClass="sortable">
       	 		    			<apex:facet name="header">{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.Fields.KimbleOne__NetAmount__c.Label}</apex:facet>
       	 		    			<apex:outputPanel layout="none">
									<apex:outputText value="{!KimbleOne__Product__c.CurrencyIsoCode} {!aTemplate.KimbleOne__NetAmount__c}"  styleclass="kimbleCurrencyCode" />
							
							</apex:outputPanel>
				</apex:column>
					
						</apex:pageBlockTable>

					</apex:pageBlock>

					<apex:actionFunction action="{!newExpenseCategoryProfileTemplate}"
						name="newTemplate"
						rerender="TemplatesPopupPanel"
						oncomplete="showModalBoxy();" />

					<apex:actionFunction action="{!editExpenseCategoryProfileTemplate}"
						name="editTemplate"
						rerender="TemplatesPopupPanel"
						oncomplete="showModalBoxy();">
						<apex:param name="eptId" value="" />
					</apex:actionFunction>

				
				</apex:form>
			</apex:outputPanel>



			<div id="TemplatesPopup" style="display: none"><apex:outputPanel id="TemplatesPopupPanel">
				<apex:form >
					<apex:pageBlock >

						<div id="TemplatesPopupErrors"><apex:pageMessages escape="false"/>
						</div>
						<apex:pageBlockButtons location="bottom">
							<apex:commandButton action="{!upsertExpenseCategoryProfileTemplate}"
								value="{!$Label.kimbleone__save}"
								oncomplete="hideModalBoxyWithErrorCheck('#TemplatesPopupErrors')"
								styleclass="DisableButtonWhileBusy"
								reRender="TemplatesPopupPanel, TemplatesMainPanel" />
							<input class="btn" type="button" onclick="hideModalBoxy();"
								value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>

						<apex:pageblockSection collapsible="false" showheader="false" columns="1">

							<apex:inputfield value="{!aTemplateObject.Name}"
								required="true" />
							
													
									
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__ExpenseCategoryProfileTemplate__c.Fields.KimbleOne__ExpenseCategory__c.Label}" />
								<apex:actionRegion >
									<apex:selectList value="{!aTemplateObject.KimbleOne__ExpenseCategory__c}" size="1"  required="true">
										<apex:selectOptions value="{!TheExpenseCategories}" />
									</apex:selectList>
								</apex:actionRegion>
							</apex:pageBlockSectionItem>
							
							<apex:inputfield value="{!aTemplateObject.KimbleOne__NumberOfUnits__c}" required="true"/>
							<apex:inputfield value="{!aTemplateObject.KimbleOne__NetAmount__c}" required="true"/>
							
						</apex:pageblockSection>
							
						
					</apex:pageBlock>
				</apex:form>

			</apex:outputPanel></div>
			
			


		</apex:define>
	</apex:composition>

	<style>
		div#MilestoneTemplatesPopup {
		    width: 530px;
		}
		.detailList .labelCol {
		    width: 30% !important;
		}
		tr.assignment-row:hover {
			background-color: #e3feff;
		}
		tr.assignment-row.other-milestone {
			background-color: #eee;
		}
		.link-unlink-action {
			cursor: pointer;
		}
	</style>
	
</apex:page>