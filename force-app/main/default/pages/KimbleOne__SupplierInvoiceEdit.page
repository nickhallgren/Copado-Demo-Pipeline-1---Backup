<apex:page standardController="KimbleOne__SupplierInvoice__c" action="{!CheckStatus}"  extensions="KimbleOne.SupplierInvoiceEditController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__SupplierInvoice__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
    	<c:Menu MenuContextType="SupplierInvoice" MenuContextId="{!KimbleOne__SupplierInvoice__c.id}" MenuContextName="{!KimbleOne__SupplierInvoice__c.name}"/>
    </apex:define> 
    
    <apex:define name="Content">
    	<apex:form id="TheForm">
    	<div id="pageErrors">
    		<apex:pageMessages escape="False" />
		</div>
		<apex:pageBlock title="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__SupplierInvoice__c.label}">
		
			<apex:pageBlockButtons location="bottom">
           		
           		<apex:commandButton action="{!Save}" value="{!$Label.kimbleone__save}" />
           		<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}" />
            	
            </apex:pageBlockButtons>
			
			
			<apex:pageblockSection collapsible="false" showheader="true" columns="2">

           		<apex:inputField value="{!KimbleOne__SupplierInvoice__c.Name}" rendered="{!KimbleOne__SupplierInvoice__c.KimbleOne__IsManualReference__c}"/>
           		<apex:outputField value="{!KimbleOne__SupplierInvoice__c.Name}" rendered="{!!KimbleOne__SupplierInvoice__c.KimbleOne__IsManualReference__c}"/>

           		<apex:inputField value="{!KimbleOne__SupplierInvoice__c.KimbleOne__InvoiceDate__c}" styleClass="kimbleDatePicker" />

				<apex:pageBlockSectionItem >
					<apex:outputText value="{!$ObjectType.KimbleOne__SupplierInvoice__c.Fields.KimbleOne__BusinessUnitTradingEntity__c.Label}" />
					<apex:outputPanel layout="none">
						<apex:selectList value="{!KimbleOne__SupplierInvoice__c.KimbleOne__BusinessUnitTradingEntity__c}" size="1">
							<apex:selectOptions value="{!buTradingEntityOptions}" />
						</apex:selectList>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputText value="{!$ObjectType.KimbleOne__SupplierInvoice__c.Fields.KimbleOne__SupplierInvoiceTemplate__c.Label}" />
					<apex:outputPanel layout="none">
						<apex:selectList value="{!KimbleOne__SupplierInvoice__c.KimbleOne__SupplierInvoiceTemplate__c}" size="1">
							<apex:selectOptions value="{!invoiceTemplateOptions}" />
						</apex:selectList>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

           		<apex:inputField value="{!KimbleOne__SupplierInvoice__c.KimbleOne__InvoicePaymentTermDays__c}"/>

           		<apex:inputField value="{!KimbleOne__SupplierInvoice__c.KimbleOne__Notes__c}"/>

		    </apex:pageBlockSection>
		</apex:pageBlock>
		</apex:form>

		<script>

		jQuery(window).load(function()
		{
			initialiseItems();
		});

		function initialiseItems()
		{
		    SetupDatePicker();
  		}

		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}

		</script>

	</apex:define>
</apex:composition>

</apex:page>