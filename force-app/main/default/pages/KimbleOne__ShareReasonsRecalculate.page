<apex:page standardController="KimbleOne__ShareReason__c" recordSetVar="ShareReasons" action="{!Initialise}" extensions="KimbleOne.ShareReasonsRecalculateController" showHeader="true" sidebar="false">
	
<!-- Page used to configure / re-calculate sharing rules -->
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu"></apex:define>  
   
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	
	<div class="cardContainer">
		
		<div class="card">
			<div class="cardHeadingContainer">
				<div style="display:table-row">
					<div class="cardHeadingCell">
						<div class="card-heading-icon fa fa-share-alt" ></div>
						<div class="card-title-container"><h3 class="cardTitle">Sharing Recalculation</h3></div>
					</div>
					<div class="cardProperties cardHeadingCell cardHeadingCellFixed">
						<div class="title-card-body-field">
  							<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Job__c.Fields.KimbleOne__ContextId__c.Label}" />
  							<span><apex:outputText styleClass="center-aligned-block" value="{!RecalculationContextId}"/></span>
  						</div>					  					
					</div>
				</div>
			
			</div>
			<div class="cardBody">
					
					<div style="display:table-row">
						<div style="display:table-cell;vertical-align:top;padding-right:200px">
							<table cellpadding="2" cellspacing="2">
								<tr>
									<td style="text-align: right;"><apex:outputLabel styleclass="label-heading" value="{!$Label.kimbleone__start}:"/></td>
									<td><apex:outputText value="{!StartDateTime}"/></td>
								</tr>
								<tr>
									<td style="vertical-align: top;"><apex:outputLabel styleclass="label-heading" value="{!$Label.kimbleone__detailslabel}:"/></td>
									<td>
										<apex:repeat value="{!SelectedReasons}" var="reason">
											<div class="share-reason">
												<apex:outputLink styleclass="undecorated-link" value="/{!reason.Id}" ><apex:outputText value="{!reason.Name}"/></apex:outputLink>
											</div>
										</apex:repeat>
									</td>
								</tr>
							</table>
							
						</div>
						<div style="display:table-cell;vertical-align:top;">
							<div style="" class="sharing-jobs">
								   <div class="donut-chart less-fifty-pct" >
								    <div class="slice one"></div>
								    <div id="less-fifty" class="slice two"></div>
								    <div class="chart-center">
								       <span>
								    		<div class="pct-value"><span style="display:none" id="batchError">Failed</span><a style="display:none;text-decoration:none;" id="StartRecalculationButton" href="javascript:start()">Start</a></div>
								   			<div class="failures" style="display:none">
								    			<i class="fa fa-warning" style="font-size: 18px;color: #B42E34;"></i>
											</div>
										</span>
								    </div>
								    
								   </div>
								  
								  <div class="donut-chart more-fifty-pct" style="display:none;">
								    <div class="slice one"></div>
								    <div id="more-fifty" class="slice two"></div>
								    <div class="chart-center">
								      <span>
								    		<div class="pct-value"></div>
								   			<div class="failures" style="display:none">
								    			<i class="fa fa-warning" style="font-size: 18px;color: #B42E34;"></i>
											</div>
										</span>
								    </div>
								  </div> 
							</div>
						</div>
					</div>		
			</div>
		</div><!-- card -->
		
	</div>
	
	<script>
	
		jQuery(window).load(function(){
          	
          	getBatchStatus();
          	
        });
        
        var processingId = '{!JSENCODE(RecalculationContextId)}';
        
        var batchIds = kimble.parseJSON("{!JSENCODE(BatchIdsJson)}");
        
        function startRecalculation()
       	{
       		if (jQuery('.object-total').length != 0) return;
       		
       		jQuery('#StartRecalculationButton').show();
       	}
       	
       	function start()
        {
        	jQuery('#StartRecalculationButton').hide();
        	
        	Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ShareReasonsRecalculateController.StartRecalculation}',
     				processingId,
     					function(result, event){          
	             		if (event.status) 
			            {
							getProgress();		
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         }, 
	         {escape: true, timeout: 60000});
		}
		
        function getProgress()
        {
        	Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ShareReasonsRecalculateController.GetProgress}',
        		processingId,
      					function(result, event){          
		             		if (event.status) 
				            {
								var progress = result;
								
								if (progress.PercentComplete <= 50)
								{
									var deg = 180 + (progress.PercentComplete * 3.6);
									jQuery('#less-fifty').css({transform: 'rotate(' + deg + 'deg)'}).parent().show();
									jQuery('#more-fifty').parent().hide();
									
									if (progress.FailedCount > 0)
										jQuery('.less-fifty-pct').addClass('failed');
								}
								else
								{
									var deg = progress.PercentComplete * 3.6;
									jQuery('#more-fifty').css({transform: 'rotate(' + deg + 'deg)'}).parent().show();
									jQuery('#less-fifty').parent().hide();
									
									if (progress.FailedCount > 0)
										jQuery('.more-fifty-pct .slice').addClass('failed');
								}
								
								if (progress.FailedCount > 0)
								{
									jQuery('.failures').show();
									jQuery('.failures i').text(progress.FailedCount);
									jQuery('.pct-value').addClass('failed-text');
								}
								
								jQuery('.pct-value').text(progress.PercentComplete + '%');
								
								if (progress.PercentComplete != 100)
								{
									// Wait 3 seconds to getProgress again
        							setTimeout(getProgress, 3000);
        						}
				         	} 
				         	else if (event.type === 'exception') 
				         	{
				             	alert(event.message);
				         	} 
				         	else 
				         	{
				             	alert(event.message);
				         	}
		         }, 
		         {escape: true, timeout: 60000});
        }
        
        function getBatchStatus()
        {
        	Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ShareReasonsRecalculateController.GetBatchStatus}',
        		batchIds,
      					function(result, event){          
		             		if (event.status) 
				            {
								var batchStatus = result;
								
								if (batchStatus.IsComplete && !batchStatus.HasErrors)
								{
									startRecalculation();
								}
								else if (!batchStatus.IsComplete)
								{
									setTimeout(getBatchStatus, 3000);
								}
								
								if (batchStatus.HasErrors)
								{
									jQuery('#batchError').show();
								}								
				         	} 
				         	else if (event.type === 'exception') 
				         	{
				             	alert(event.message);
				         	} 
				         	else 
				         	{
				             	alert(event.message);
				         	}
		         }, 
		         {escape: true, timeout: 60000});
        }
        
        	
	</script>
	<style>
				.share-reason {
			    	padding-bottom: 4px;
				}
				.sharing-jobs {
				    margin: 0 20px 0 0;
				}
				
				.donut-chart.more-fifty-pct {
				    width: 200px;
				    height: 200px;
				    background: #e1e1e1;
				}
				.donut-chart.less-fifty-pct {
				    width: 200px;
				    height: 200px;
				    background: #48b2c1;
				}
				.donut-chart {
				    position: relative;
				    border-radius: 50%;
				    overflow: hidden;
				}
				.donut-chart.more-fifty-pct .slice.one {
				    clip: rect(0 200px 100px 0);
				    -webkit-transform: rotate(90deg);
				    transform: rotate(90deg);
				    background: #48b2c1;
				}

				.donut-chart.more-fifty-pct .slice.two {
				    clip: rect(0 100px 200px 0);
				    -webkit-transform: rotate(327.6deg);
				    transform: rotate(180deg); /*180 -> 360*/
				    background: #48b2c1;
				}
				
				.donut-chart.less-fifty-pct .slice.one {
				    clip: rect(0 200px 100px 0);
				    -webkit-transform: rotate(90deg);
				    transform: rotate(270deg);
				    background: #e1e1e1;
				}
				
				.donut-chart.less-fifty-pct .slice.two {
				    clip: rect(0 100px 200px 0);
				    -webkit-transform: rotate(180deg);
				    transform: rotate(180deg); /*180 -> 360*/
				    background: #e1e1e1;
				}
				
				.donut-chart .slice {
				    position: absolute;
				    top: 0;
				    left: 0;
				    width: 100%;
				    height: 100%;
				}
				.chart-center {
				    top: 25px;
				    left: 25px;
				    width: 150px;
				    height: 150px;
				    background: #fff;
				}
				.donut-chart .chart-center {
				    position: absolute;
				    border-radius: 50%;
				}
				
				.chart-center>span {
				    font-size: 40px;
				    color: #48b2c1;
				    width: 140px;
				    height: 140px;
				    display: table-cell;
				    vertical-align: middle;
				    padding-left: 10px;
				    text-align: center;
				    padding-top: 4px;
				}
				
				.failed
				{
					background: #B42E34 !important;
				}
				.failed-text
				{
					color:#353535; !important;
				}
				.failures
				{
					height:10px;
				}
				
				
				/*
					CARD STYLE
				*/
				.cardHeadingContainer
		    {
		    	display: table;
				width: 100%;
				background-color: #FFF;
				border-color: #DDD;
				color: #333;
				background-color: #FFF;
				border-color: #DDD;
				border-bottom: 1px solid #DDD;
				border-top-right-radius: 3px;
				border-top-left-radius: 3px;
				font-size: 18px;
		    }
		    .cardHeadingCell
		    {
		    	display: table-cell;
			   vertical-align: middle;
			   padding: 4px 15px;
			   border-right: 1px solid #DDD;
		    }
		    .cardHeadingCellFixed
		    {
		    	width:1px;
		    	white-space:nowrap;
		    }
		     .cardProperties {
			  font-size: 12px;
			}
			.title-card-body-field
			{
				margin:0px;
				padding-right:4px;
				padding-left:0px;
				padding-top:0px;
				padding-bottom:0px;
				vertical-align: middle;
			}
			</style>
</apex:define>
</apex:composition>	

</apex:page>