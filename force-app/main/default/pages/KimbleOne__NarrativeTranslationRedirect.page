<apex:page standardController="KimbleOne__Narrative__c">
	<apex:variable var="redirectTo" value="{!$Page.KimbleOne__TranslationManagement}?domain=narrative"/>
	<script>
		safeRedirectToSForceURL('{!JSENCODE(redirectTo)}');

		function isSFClassic()
		{
			return ( (typeof sforce == 'undefined' || typeof sforce.one == 'undefined') );
		}
		
		function safeRedirectToSForceURL(theURL)
		{
			if(isSFClassic())
			{
				// SF Classic
				window.location = theURL;
			}
			else
			{
				// SF Lightning
				sforce.one.navigateToURL(theURL, true);
			}
		}		
	</script>
</apex:page>