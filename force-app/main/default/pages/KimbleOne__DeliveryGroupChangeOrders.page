<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupChangeOrdersController" showHeader="true" sidebar="false">
<apex:composition template="KimbleOne__SiteMaster">

	<apex:define name="Menu">
		<c:Menu DefaultHelpPage="ChangeManagement.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}"/>
	</apex:define> 
	     
	<apex:define name="Content">
		<apex:form id="TheForm">
		<apex:pageMessages escape="false"/>
		<apex:pageBlock title="{!$ObjectType.KimbleOne__ChangeOrder__c.LabelPlural}">
			<apex:pageblockbuttons location="top">
				<apex:outputPanel layout="none" rendered="{!AllowNew && $ObjectType.KimbleOne__ChangeOrder__c.createable}">
					<input id="newChangeOrderButton" class="btn" type="button" onclick="newChangeOrder('{!JSINHTMLENCODE(DeliveryGroup__c.Id)}');" value="{!$Label.New} {!$ObjectType.ChangeOrder__c.label}" />
				</apex:outputPanel>
			</apex:pageblockbuttons>
			<apex:pageBlockTable value="{!TheChangeOrders}" var="changeOrder">
				<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
					<apex:outputLink styleClass="actionLink" value="/{!changeOrder.Id}">{!$Label.kimbleone__view}</apex:outputLink>
					&nbsp; | &nbsp;
					<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ChangeOrder__c.updateable}">
						<apex:outputLink styleClass="actionLink" value="{!$Page.KimbleOne__ChangeOrderEdit}?id={!changeOrder.Id}">{!$Label.kimbleone__edit}</apex:outputLink>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!TheChangeOrdersDeletableMap[changeOrder.Id] && $ObjectType.KimbleOne__ChangeOrder__c.deletable}">
						&nbsp; | &nbsp;
						<a href="javascript:void(0)" onclick="if (confirmDelete()) deleteChangeOrder('{!changeOrder.Id}');">{!$Label.Delete}</a>
					</apex:outputPanel>
					
				</apex:column>
				<apex:column value="{!changeOrder.KimbleOne__Reference__c}"/>
				<apex:column value="{!changeOrder.Name}"/>
				<apex:column value="{!changeOrder.ChangeOrderBehaviourRule__r.Name}"/>
				<apex:column value="{!changeOrder.KimbleOne__Status__c}"/>
								
			</apex:pageBlockTable>
			
		</apex:pageBlock>
		
		<apex:actionFunction action="{!DeleteChangeOrder}" name="deleteChangeOrder" rerender="TheForm">
      		<apex:param name="changeOrderId" value="" />
      	</apex:actionFunction>
		
		</apex:form>
		
		<apex:form id="ChangeOrderForm">
		<div id="ChangeOrderPopup" style="display:none">
			<apex:outputPanel id="ChangeOrderPopupPanel">
	   	     	
	   	     	<div id="ChangeOrderErrors">
	           		<apex:pageMessages id="ChangeOrderMessages" escape="false"/>
	           	</div>
	   			
	   			<apex:pageBlock >
	            
	           	<apex:pageBlockButtons location="bottom">
	           		<apex:commandButton id="saveChangeOrder" styleclass="DisableButtonWhileBusy saveChangeOrder" action="{!insertChangeOrder}" value="{!$Label.kimbleone__save}" oncomplete="DisableButton('NewElement');if($('#ChangeOrderErrors>span')[0].children.length == 0) hideModalBoxy();" reRender="TheForm, ChangeOrderPopupPanel"/>
	            	<input id="cancelChangeOrder" class="btn DisableButtonWhileBusy" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
	  			</apex:pageBlockButtons>
	            
	            <apex:pageblockSection collapsible="false" showheader="false" columns="1">
	               
					<apex:outputfield value="{!TheDeliveryGroup.Name}"/> 
					
					<apex:inputField value="{!TheChangeOrder.KimbleOne__ShortName__c}" />
	 			   	
	            </apex:pageBlockSection>
	            
				</apex:pageBlock>
					
					
	        </apex:outputPanel> <!-- end newChangeOrder -->
		</div>
		</apex:form>
		<apex:form >
			<apex:actionFunction action="{!NewDeliveryGroupChangeOrder}" name="newDeliveryGroupChangeOrder" rerender="ChangeOrderPopupPanel" oncomplete="showModalBoxy()">
       			<apex:param name="deliveryGroupId" value="" />
       		</apex:actionFunction>
     	</apex:form>
     	
		<script>
			function newChangeOrder(groupId)
			{
				initialiseModalBoxy('#ChangeOrderPopup', '{!JSENCODE($Label.New)}  {!$ObjectType.ChangeOrder__c.label}', jQuery('form[id$=\'ChangeOrderForm\']'));
				newDeliveryGroupChangeOrder(groupId);
			}
		</script>
	</apex:define>
</apex:composition>
</apex:page>