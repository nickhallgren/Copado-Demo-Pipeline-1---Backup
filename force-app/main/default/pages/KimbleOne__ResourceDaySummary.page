	    padding: 5px;
	    min-width: 485px;
	}
	.resource-summary-header{
		padding: 12px;
	    font-size: 14px;
	    background-color: #f1f1f1;
	    color: #454545;
	    font-weight: bold;
	    margin-bottom: 4px;
	    position: relative;
	}
	.resource-total-usage {
	    position: absolute;
	    top: 77px;
	    left: 44px;
	    z-index: 99999;
	    font-weight: bold;
	    width: 38px;
	    text-align: center;
	}
	table.allocation-table {
		padding: 0px 4px 5px 4px;
	    width: 100%;
	}
	.td-label {
	    text-align: center;
	    padding: 8px 0px 8px 0px;
	    font-size: 12px;
	}
	td.td-value {
	    font-size: 16px;
	    font-weight: bold;
	    color: #454545;
	    text-align: right;
	    padding-left: 8px;
	}
	.resource-assignments-container {
	    display: inline-block;
	    max-height: 120px;
	    overflow-y: auto;
	    overflow-x: hidden;
	}
	.resource-assignments-container td div{
		border: 1px solid #aaa;
	    border-radius: 2px;
	    height: 22px;
	    line-height: 22px;
	    width: 30px;
	    margin: auto;
	    text-align:center;
	}
	.resource-body {
	    white-space: nowrap;
	}
	.resource-assignments-body {
	    max-height: 100px;
	    overflow-y: auto;
	}

	.resource-assignments-container th span {
	white-space: nowrap;
	font-size: 0.75em;
	overflow: hidden;
	display: inline-block;
	height: 25px;
	line-height: 25px;
	text-align: center;
	border-bottom: solid #e0e3e5 1px;
	border-right: solid #e0e3e5 1px;
	background-color: #f2f3f3;
	text-overflow: ellipsis;
	width: 36px;
	}
	
	.resource-assignments-container span.selected,
	.resource-events td.ev-today {
    	background-color: gold !important;
	}
	
	.resource-assignments-container th:first-child span{width:180px;font-size:11px;padding-left: 6px;font-weight:bold;text-align: left;}
	
	.resource-assignments-container .assignment-name
	{
		text-overflow: ellipsis;
    	white-space: nowrap;
    	overflow: hidden;
    	padding-left: 2px;
    	width: 170px;
    	display: inline-block;
    	height: 32px;
    	line-height: 32px;
	}

	.assignment-class
	{
	display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 4px;
    margin-bottom: 12px;}
    
	.context-date {
	    font-weight: bold;
	    margin-right: 5px;
	}
	
	table.resource-events thead {
	    font-weight: bold;
	    background-color: #f2f3f3;
	}
	.day-charms {
		position: absolute;
		right: 12px;
		top: 7px;
	}
	.day-charms i {
		font-size: 22px;
		margin-right: 5px;
	}
	.day-charms i.important-event  {
		color: #2196F3;
	}
	.day-charms i.assignment-over-utilised  {
		color: #ffb600;
	}
	.day-charms i.all-over-utilised  {
		color: #B42E34;
	}
	table.resource-events {
		margin-left: 123px;
		margin-bottom: 3px;
	}
	td.subject-col {
	    width: 392px;
	}
	/* These are needed here because the tracking plan gantt page doesn't have this CSS loaded' */
	.assignment-class-none
	{
		background-color: black;
		color:white;
	}
	.assignment-class-0
	{
		background: #F4C2C2 !important;
		color:white !important;
	}
	.assignment-class-1, .assignment-class-1 a
	{
		background-image: url('{!URLFOR($Resource.AssignmentImages, 'Unavailable.png')}') !important;
		color:white !important;
	}
	.assignment-class-2, .assignment-class-2 a 
	{
		background: #4CC417 !important;
		color:white !important;
	}
	.assignment-class-3, .assignment-class-3 a
	{
		background: #FFBF00 !important;
		color:white !important;
	}
	.assignment-class-4, .assignment-class-4 a
	{
		background: #FF00FF !important;
		color:white !important;
	}
	.assignment-class-5, .assignment-class-5 a
	{
		background: #FFFF8D !important;
	}
	.assignment-class-6, .assignment-class-6 a
	{
		background: #c9a8e0 !important;
		color:white !important;
	}
	.assignment-class-7, .assignment-class-7 a
	{
		background: #CCFF00 !important;
	}
	.assignment-class-8, .assignment-class-8 a
	{
