<apex:page controller="KimbleOne.ResourceDaySummaryController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__ReferenceData__c">

<div class="resources-container">
	<apex:repeat value="{!TheResources}" var="resource">
		<div class="resource-summary-card">
			<div class="resource-summary-header"><span class="context-date"><apex:outputText value="{!ContextDate}:"/></span><span class="resource-name"><apex:outputText value="{!resource.Name}"/></span><div class="day-charms"></div></div>
			
			<div class="resource-body">
				<div class="resource-aggregate-detail-container">
					<div class="resource-aggregate-detail" data-req-usage="{!IF(!ISBLANK(resource.TheRequiredUsage), resource.TheRequiredUsage, 0)}" data-hrs-per-day="{!resource.HoursPerDay}" data-json="{!resource.PriorityUsageMapJson}">
						<table class="allocation-table">
							<tr>
								<apex:outputPanel layout="none" rendered="{!!ISBLANK(resource.TheRequiredUsage)}">
								<td class="td-label"><apex:outputText value="{!$Label.kimbleone__requiredhourslabel}"/></td><td class="td-value"><span class="resource-req-usage"></span></td>
								</apex:outputPanel>
								<td class="td-label"><apex:outputText value="{!$Label.kimbleone__usedhourslabel}"/></td><td class="td-value"><span class="resource-used-usage"></span></td>
								<td class="td-label"><apex:outputText value="{!$Label.kimbleone__availablehourslabel}"/></td><td class="td-value"><span class="resource-available-usage"></span></td>
							</tr>
						</table>
					</div>
				</div>
				
				<!-- fixed height / scrollable -->
				<div class="resource-assignments-container">
					<table border="0" cellpadding="0" cellspacing="0">
						<thead>
						</thead>
						<tbody>
							<apex:repeat value="{!resource.Assignments}" var="assignment">
							<tr class="assignment-usage" data-cls="{!assignment.StyleClass}" data-name="{!assignment.Name}" data-owner="{!assignment.Owner}" data-hrs="{!assignment.HoursPerDay}" data-util="{!assignment.Utilisation}" data-start-date="{!assignment.StartDate}" data-scheduled-only="{!assignment.ScheduledDaysOnly}" data-usage-pattern="{!assignment.UsagePatternPart}">
								
							</tr>
							</apex:repeat>
						</tbody>
					</table>
					
				</div>
				<apex:outputPanel layout="none" rendered="{!resource.HasEvents}">
				<table border="0" cellpadding="0" cellspacing="0" class="resource-events list">
					<thead>
						<tr>
							<td><apex:outputText value="{!$Label.kimbleone__calendartasksheading}"/></td>
							<td class="subject-col"><apex:outputText value="{!$ObjectType.Event.Fields.Subject.Label}"/></td>
						</tr>
					</thead>
					<tbody>
						<apex:repeat value="{!resource.Events}" var="e">
							<apex:repeat value="{!resource.Events[e]}" var="event">
								<tr>
									<apex:variable value="{!IF(ContextDate == event.EventDate, 'ev-today', 'ev-otherday')}" var="cellClass"/>
									<td class="{!cellClass}"><apex:outputText value="{!event.EventDate}"/></td>
									<td><apex:outputText value="{!event.Subject}"/></td>
								</tr>
							</apex:repeat>
						</apex:repeat>
					</tbody>
				</table>
				</apex:outputPanel>
			</div>
			
			
		</div>
	</apex:repeat>
</div>

<script>
	var summaryViewStartDate = '{!YEAR(StartDate)}-{!MONTH(StartDate)}-{!DAY(StartDate)}';
	var summaryViewEndDate = '{!YEAR(EndDate)}-{!MONTH(EndDate)}-{!DAY(EndDate)}';
	
	var daySummaryLabels = {};
	daySummaryLabels['ResourceOverUtilisedOnAssignmentWarning'] = '<apex:outputText value="{!$Label.kimbleone__resourceoverutilisedwarning}"/>';
	daySummaryLabels['ResourceOverUtilisedOnAllAssignmentsWarning'] = '<apex:outputText value="{!$Label.kimbleone__resourceoverutilisedonallassignmentswarning}"/>';
	daySummaryLabels['ImportantEvents'] = '<apex:outputText value="{!$Label.kimbleone__calendartasksheading}"/>';
	daySummaryLabels['ImportantEventsMessage'] = '<apex:outputText value="{!$Label.kimbleone__calendartasksmessage}"/>';
	daySummaryLabels['ActivityOwner'] = '<apex:outputText value="{!$ObjectType.KimbleOne__ResourcedActivity__c.Fields.OwnerId.Label}"/>';
	
	var theContextDate = '<apex:outputText value="{!$CurrentPage.Parameters.dte}"/>';
	
	function drawSummaryGantts()
	{
		var hasAssignments = false;
		
		if(jQuery('.assignment-usage').length)
		{
			var periodHeaderHtml = '<tr><th><span>{!$ObjectType.ActivityAssignment__c.LabelPlural}</span></th>';
			
			for (var i=0;i<days_between(summaryViewStartDate.toDate(), summaryViewEndDate.toDate());i++)
			{
				var contextDate = new Date(summaryViewStartDate.toDate().getFullYear(), summaryViewStartDate.toDate().getMonth(), summaryViewStartDate.toDate().getDate() + i, 0, 0, 0, 0);
				
				if (!isDateNonBusDay(contextDate))
				{
					var selected = (contextDate.toKimbleUTC() == theContextDate ? ' selected ' : '');
					
					periodHeaderHtml += ('<th><span class="' + selected + '">' + kimble.regional.dayNames[contextDate.getDay()].substring(0,3) + ' ' + contextDate.getDate() +'</span></th>');
				
				}
			}
			
			periodHeaderHtml += '</tr>';
			
			jQuery('.resource-assignments-container>table>thead').append(periodHeaderHtml);
			
			//draw the assignment daily numbers
			jQuery.each(jQuery('.assignment-usage'), function (i, obj){
				var j = jQuery(obj);
				
				var usage = j.attr('data-usage-pattern');
				var hrsPerDay = new Number(j.attr('data-hrs'));
				var utilisation = new Number(j.attr('data-util'));
				var startDate = j.attr('data-start-date');
				var scheduledOnly = (j.attr('data-scheduled-only') == 'true');
				
				var assignmentHtml = '<td ><span class="assignment-class ' + j.attr('data-cls') + ' "></span><span class="assignment-name" title="' + daySummaryLabels['ActivityOwner'] + ': ' + j.attr('data-owner') + '">' + j.attr('data-name') + '</span></td>';
				var usagePattern = new ActivityAssignmentUsagePattern(hrsPerDay,startDate.toDate(),usage,utilisation,utilisation);
				
				for (var i=0;i<days_between(summaryViewStartDate.toDate(), summaryViewEndDate.toDate());i++)
				{
					var contextDate = new Date(summaryViewStartDate.toDate().getFullYear(), summaryViewStartDate.toDate().getMonth(), summaryViewStartDate.toDate().getDate() + i, 0, 0, 0, 0);
					
					if (!isDateNonBusDay(contextDate))
					{
						assignmentHtml += '<td>';
						
						if (contextDate >= startDate.toDate())
						{
							var dayUsage = usagePattern.getUsagePatternOnDate(contextDate);
							
							if (dayUsage != null)
							{
								var forecast = dayUsage.split(':')[0]; 
		 						var actual = dayUsage.split(':')[1];
		 						
		 						var classes = '';
		 						var cellVal = 0;
		 						
		 						if (actual != '0')
		 						{
		 							classes += ' assignment-time-entry';
		 							cellVal = actual;
		 						}
		 						else if (forecast != undefined )
		 						{
					      			if (forecast == NONFORECASTDAY || forecast == CLOSEDDAY)
					      			{
					      				classes += ' non-forecast-day ';
					      			}
					      			else
					      			{
										var f = KeyToHoursUsagePatternMap[forecast];
								
										if (f == null && !scheduledOnly) // percentage usage
										{
											f = new Number(forecast) * hrsPerDay / 100;
										}
										
										cellVal = (f == null ? 0 : f);
									}
								}
								
								hasAssignments = true;
								assignmentHtml += '<div class="' + classes + '">' + kimble.formatNumber(cellVal, '#.##') + '</div>';
							}		
						}
						assignmentHtml += '</td>';
					}
				}
				j.append(assignmentHtml);
			});
		}

		if(!hasAssignments)	jQuery('.resource-assignments-container').hide();
		
		drawAggregateDetail();
	}
	
	drawSummaryGantts();
	 
	function drawAggregateDetail() {
		
		jQuery.each(jQuery('.resource-aggregate-detail'), function(i, obj){
			
			var dayCharms = jQuery(obj).closest('.resource-summary-card').find('.day-charms');
			dayCharms.empty();
			
			var usage = JSON.parse(jQuery(obj).attr('data-json'));
			var hrsPerDay = new Number(jQuery(obj).attr('data-hrs-per-day'));
			var requiredUsage = new Number(kimble.parseNumber(jQuery(obj).attr('data-req-usage')));
			
			var remainingUsage = hrsPerDay;
			var totHrs = 0;
			
			jQuery.each(Object.keys(classificationStyleMap), function(i, key) {
				
				if (usage[key] != null && classificationStyleMap[key] != undefined && classificationStyleMap[key].IsUtilPct)
				{
					totHrs += usage[key];
				}
			});

			remainingUsage = Math.max(hrsPerDay - totHrs, 0);
			
			jQuery(obj).find('.resource-req-usage').text(kimble.formatNumber(requiredUsage,'0.##'))
			if(requiredUsage > hrsPerDay) dayCharms.append('<i class="fa fa-exclamation-triangle assignment-over-utilised" title="' + daySummaryLabels['ResourceOverUtilisedOnAssignmentWarning'] + '"/>');

			jQuery(obj).find('.resource-used-usage').text(kimble.formatNumber(totHrs,'0.##'));
			// only flag over utilised on all assignments if there are other assignments (which we can infer from the totalhrs which excludes this assignment being non-zero)
			if(totHrs > 0 && (totHrs + requiredUsage) > hrsPerDay) dayCharms.append('<i class="fa fa-exclamation-circle all-over-utilised" title="' + daySummaryLabels['ResourceOverUtilisedOnAllAssignmentsWarning'] + '"/>');

			jQuery(obj).find('.resource-available-usage').text(kimble.formatNumber(remainingUsage,'0.##'));

			if(jQuery(obj).closest('.resource-summary-card').find('.ev-today').length) dayCharms.append('<i class="fa fa-calendar important-event" title="' + daySummaryLabels['ImportantEventsMessage'] + '"/>');		
		});
	}
	 
</script>

<style>
