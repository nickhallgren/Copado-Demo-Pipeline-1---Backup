<apex:page standardController="KimbleOne__DeliveryElement__c">
	<apex:variable var="redirectTo" value="{!IF(KimbleOne__DeliveryElement__c.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsUsageGenerated__c, $Page.KimbleOne__ActivityAssignmentsDelivery + '?filterid=' + (IF(ISBLANK(KimbleOne__DeliveryElement__c.KimbleOne__DeliveryElementOperatedWith__c), KimbleOne__DeliveryElement__c.KimbleOne__ResourcedActivity__c, KimbleOne__DeliveryElement__c.DeliveryElementOperatedWith__r.KimbleOne__ResourcedActivity__c)) + '&Id=' + KimbleOne__DeliveryElement__c.KimbleOne__DeliveryGroup__c, IF (KimbleOne__DeliveryElement__c.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsMilestoneGenerated__c, $Page.KimbleOne__DeliveryGroupMilestones ,$Page.KimbleOne__DeliveryGroupAnnuities) + '?Id=' + KimbleOne__DeliveryElement__c.KimbleOne__DeliveryGroup__c)}"/>
	<script>
		safeRedirectToSForceURL('{!JSENCODE(redirectTo)}');

		function isSFClassic()
		{
			return ( (typeof sforce == 'undefined' || typeof sforce.one == 'undefined') );
		}
		
		function safeRedirectToSForceURL(theURL)
		{
			if(isSFClassic())
			{
				// SF Classic
				window.location = theURL;
			}
			else
			{
				// SF Lightning
				sforce.one.navigateToURL(theURL, true);
			}
		}		
	</script>
</apex:page>