       	<apex:actionFunction action="{!ReadPeriodCost}" name="loadPeriodCost" rerender="PeriodCostEdit" oncomplete="showModalBoxy()">
       		<apex:param name="costId" value="" />
       	</apex:actionFunction>
       	
	</apex:form>
    
    <!-- POPUP SCRIPTS -->
    <script>
    	var showPeriodRevenue = '{!JSENCODE($CurrentPage.parameters.periodRevenueId)}';
    	var showPeriodCost = '{!JSENCODE($CurrentPage.parameters.periodCostId)}';
    	var earliestOpenDate = '{!EarliestOpenDate}';
    	
    	var behaviourRules = kimble.parseJSON("{!JSENCODE(BehaviourRulesJson)}");
    	
    	function addNewAnnuity()
		{
			initialiseModalBoxy('#AnnuityEditPopup', '{!JSENCODE($Label.New)}  {!$ObjectType.Annuity__c.label}', jQuery('form[id$=\'AnnuityEditForm\']'));
			newAnnuity();
		}
		
		function viewAnnuityDetail(annuityId)
		{
			initialiseModalBoxy('#AnnuityEditPopup', '{!JSENCODE($Label.Edit)}  {!$ObjectType.Annuity__c.label}', jQuery('form[id$=\'AnnuityEditForm\']'));
			readAnnuity(annuityId);
		}
		
		function AnnuityPeriod(startDate, endDate, units, locked)
		{
			this.startDate = startDate;
			this.endDate = endDate;
			this.units = units;
			this.locked = locked;
			
			this.name = formatAnnuityPeriodDate(this.startDate.toDate()) + ' - ' + formatAnnuityPeriodDate(this.endDate.toDate());
		}
		
		function formatAnnuityPeriodDate(theDate)
		{
			return theDate.getDate() + ' ' + kimble.regional.monthNamesShort[theDate.getMonth()];
		}
		
		function calculateEndDate(startDate, num) 
		{
		    var endDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate(), 0, 0, 0, 0);
		    
		    var currentMonth = endDate.getMonth();
		    endDate.setMonth(endDate.getMonth() + num)
		
		    if (endDate.getMonth() != ((currentMonth + num) % 12)){
		        endDate.setDate(0);
		    }
		    
		    return new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate() -1, 0, 0, 0, 0);
		}
		
		function addMonths(dateObj, num) 
		{
		    var newDate = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), 0, 0, 0, 0);
		    var currentMonth = newDate.getMonth();
		    
		    newDate.setMonth(newDate.getMonth() + num)
		
		    if (newDate.getMonth() != ((currentMonth + num) % 12)){
		        newDate.setDate(0);
		    }
		    
		    return newDate;
		}
		
		function behaviourRuleChange()
		{
			setAnniversaryDay();
			
			recalculateAnnuityPeriods();
		}
		
		function getAnnuityStartDate()
		{
			if (jQuery('[id$="annuity-start-date-input"]').length == 1)
			{
				return kimble.parseDate(jQuery('[id$="annuity-start-date-input"]').val(), true);
			}
			else
			{
				return kimble.parseDate(jQuery('[id$="annuity-start-date"]').text(), true);
			}
		}
		
		function numberOfPeriodsChange()
		{
			var numberOfMonths = kimble.parseNumber(jQuery('[id$="number-of-periods"]').val());
			
			jQuery('[id$="annuity-end-date-input"]').val(kimble.formatDate(calculateEndDate(getAnnuityStartDate(), numberOfMonths).toKimbleUTC()));
			
			recalculateAnnuityPeriods();
		}
		
		function getTheNumberOfDaysInMonth(year, month) 
		{
    		return new Date(year, month + 1, 0).getDate();
		}
		
		function startDateChange()
		{
			setAnniversaryDay();
			
			recalculateAnnuityPeriods();
		}
		
		function setAnniversaryDay()
		{
			var startDate = getAnnuityStartDate();
			
			if (startDate == null) return;
			
			var mode = behaviourRules[jQuery('[id$="behaviour-rule"]').val()];
			
			if (jQuery('[id$="annuity-end-date-input"]').val() == '')
			{
				//auto calc end date based on number of periods
				var numberOfMonths = kimble.parseNumber(jQuery('[id$="number-of-periods"]').val());
				
				if (numberOfMonths == null || numberOfMonths == 0) numberOfMonths = 1;
				
				jQuery('[id$="annuity-end-date-input"]').val(kimble.formatDate(calculateEndDate(getAnnuityStartDate(), numberOfMonths).toKimbleUTC()));		
			}
			
			if (jQuery('[id$="annuity-earliest-change-date"]').val() == '')
			{
				if (mode == 'Forward')
				{
					jQuery('[id$="annuity-anniversary-day"]').val(kimble.parseDate(jQuery('[id$="annuity-start-date-input"]').val(), true).getDate());
				}
				else if (mode == 'Backward')
				{
					jQuery('[id$="annuity-anniversary-day"]').val(addDays(kimble.parseDate(jQuery('[id$="annuity-end-date-input"]').val(), true),1).getDate());
				}
				else if (mode == 'StartOfMonth')
				{
				    jQuery('[id$="annuity-anniversary-day"]').val(1);
    			}
			}
		}
		
		function endDateChange()
		{
			setAnniversaryDay();
			
			recalculateAnnuityPeriods();
		}
		
		function recalculateAnnuityPeriods()
		{
			//recalc all periods based on anniversary day
			
			var range = new Array();
			
			var i = 1;
			
			var startDate = getAnnuityStartDate();
			
			if (startDate == null) return;
			
			var endDate = kimble.parseDate(jQuery('[id$="annuity-end-date-input"]').val(), true);
			
			if (endDate == null)
			{
				//auto calc end date based on number of periods
				var numberOfMonths = kimble.parseNumber(jQuery('[id$="number-of-periods"]').val());
				
				if (numberOfMonths == null || numberOfMonths == 0) numberOfMonths = 1;
				
				jQuery('[id$="annuity-end-date-input"]').val(kimble.formatDate(calculateEndDate(getAnnuityStartDate(), numberOfMonths).toKimbleUTC()));
				
				endDate = kimble.parseDate(jQuery('[id$="annuity-end-date-input"]').val(), true);			
			}
			
			var anniversaryDay = new Number(jQuery('[id$="annuity-anniversary-day"]').val());
			
			var mode = behaviourRules[jQuery('[id$="behaviour-rule"]').val()];
			
			var units;
			
			if (jQuery('[id$="number-of-units"]').length == 1)
				units = kimble.parseNumber(jQuery('[id$="number-of-units"]').val());
			
			if (units == null) units = 1;
			
			var unitsPattern = jQuery('[id$="annuity-units-pattern"]').val();
			
			unitsPattern = generateUnitsPattern(startDate, endDate, unitsPattern, units);
			
			jQuery('[id$="annuity-units-pattern"]').val(unitsPattern);
			
			var unitsPatternArray = unitsPattern.split(',');
			
			var earliestChangeDateVal = jQuery('[id$="annuity-earliest-change-date"]').val();
			var earliestChangeDate;
			
			if (earliestChangeDateVal != '')
				earliestChangeDate = earliestChangeDateVal.toDate();
				
			//Re generate the periods
			
			var contextDate = startDate;
			
			var numberOfDays = daysBetween(endDate, startDate);
			
			var periodStartDate = startDate;
			var periodEndDate;
			var isComplete = false;
			
			for (var i=0;i<=numberOfDays;i++)
			{
				contextDate = addDays(startDate,i);
				
				var numDaysInMonth = getTheNumberOfDaysInMonth(contextDate.getFullYear(), contextDate.getMonth());
				
				if (addDays(contextDate,1).getDate() == anniversaryDay || (anniversaryDay > numDaysInMonth && contextDate.getDate() == numDaysInMonth)) // close this period
				{
					range.push(new AnnuityPeriod(periodStartDate.toKimbleUTC(), contextDate.toKimbleUTC(), unitsPatternArray[daysBetween(periodStartDate, startDate)], periodStartDate < earliestChangeDate));
					
					isComplete = (contextDate.valueOf() == endDate.valueOf());
					periodStartDate = addDays(contextDate, 1);
				}
			}
			
			if (!isComplete) range.push(new AnnuityPeriod(periodStartDate.toKimbleUTC(), endDate.toKimbleUTC(), unitsPatternArray[daysBetween(periodStartDate, startDate)], periodStartDate < earliestChangeDate));
					
			drawAnnuityPeriods(range);
		}
		
		function updateNumberOfUnits()
		{
			//find first editable cell
			var firstCell = jQuery('.input-units:not([readonly]):first()');
			
			if (firstCell.length == 0) return;
			
			firstCell.val(jQuery('[id$="number-of-units"]').val());
			
			cascadeUnitChange(firstCell[0]);
		}
		
		function isLastDayOfMonth(dte)
		{			
			return dte.valueOf() == new Date(dte.getFullYear(), dte.getMonth() + 1, 0, 0, 0, 0, 0).valueOf();		
		}
		
		function drawAnnuityPeriods(range)
		{
			var html = '';
			
			jQuery.each(range, function (i, period){
			
				html += '<tr class="dataRow"><td>' + (i+1) + '</td><td>' + period.name + '</td><td><input ' + (period.locked ? 'readonly' : '') + ' start-date="' + period.startDate + '" onchange="cascadeUnitChange(this)" type="text" value="' + kimble.formatNumber(period.units,'#') + '" class="input-units"/></td></tr>';
			
			});
			
			jQuery('#annuity-periods>tbody').empty();
			
			jQuery(html).appendTo(jQuery('#annuity-periods>tbody'));
		}
		
		function generateUnitsPattern(startDate, endDate, unitsPattern, units)
		{
			var existingPattern;
			if (unitsPattern != '') existingPattern = unitsPattern.split(',');
			
			var newPattern = '';
			
			var contextDate = startDate;
			
			var i = 0;
			
			while (contextDate <= endDate)
			{
				var u;
				if (existingPattern != null) u = existingPattern[i];
				
				if (u == null || u == '') u = units;
				
				newPattern += (u + ',');
				
				contextDate = new Date(contextDate.getFullYear(), contextDate.getMonth(), contextDate.getDate() + 1, 0, 0, 0, 0);
				i++;
			}
			
			return newPattern;
			
		}
		
		function cascadeUnitChange(obj)
		{
			var jObj = jQuery(obj);
			
			var changeStartDate = jObj.attr('start-date').toDate();
			
			var units = kimble.parseNumber(jObj.val());
			
			if (units == null) units = 1;
			
			var unitsPattern = jQuery('[id$="annuity-units-pattern"]').val();
			
			var startDate = getAnnuityStartDate();
			
			var newUsagePattern = '';
			
			//push units down from this date to inputs and units pattern
			jQuery.each(unitsPattern.split(','), function (i, u) {
				
				if (u == '') return;
				var contextDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate() + i, 0, 0, 0, 0);	
				
				if (contextDate < changeStartDate) 
					newUsagePattern += (u + ',');
				else
					newUsagePattern += (units + ',');
			});
			
			jQuery('[id$="annuity-units-pattern"]').val(newUsagePattern);
			
			jQuery.each(jQuery('.input-units'), function (i, inp) {
			
				if (jQuery(inp).attr('start-date').toDate() >= changeStartDate)
					jQuery(inp).val(kimble.formatNumber(units, '#'));
			});
		}
		
		function SetupDatePicker()
		{
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					minDate: earliestOpenDate.toDate(),
					showOtherMonths: true,
					selectOtherMonths: true});
			
			jQuery.each(jQuery('.format-currency'), function (i, val) {
			
				var j = jQuery(val);
				j.text(kimble.formatNumber(j.text(), '#,###.00'));
			
			});
		}
		
		function completeItems()
		{
			jQuery('#completeItemsButton, #revertItemsButton, #cancelCompleteItemsButton').prop('disabled', true).addClass('btnDisabled');
			
			var ar = new Array();
			jQuery.each(jQuery('#items-to-status-change input:checked'), function (i, obj) {
				ar.push(jQuery(obj).prop('id'));
			});
			
			completeSelectedItems(ar);
		}
		
		function revertItems()
		{
			jQuery('#completeItemsButton, #revertItemsButton, #cancelCompleteItemsButton').prop('disabled', true).addClass('btnDisabled');
			
			var ar = new Array();
			jQuery.each(jQuery('#items-to-status-change input:checked'), function (i, obj) {
				ar.push(jQuery(obj).prop('id'));
			});
			
			revertSelectedItems(ar);
		}
		
		function revertItem(id)
		{
			jQuery('#revertItemButton, #cancelPeriodCost, #cancelPeriodRevenue').prop('disabled', true).addClass('btnDisabled');
			revertSelectedItems([id]);
		}
		
		function completeSelectedItems(a)
		{
			// saving....
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupAnnuitiesController.CompleteRevenuesAndCosts}',
	       		a,
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	refreshElements();
			             	hideModalBoxy();
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
			         	jQuery('#completeItemsButton, #revertItemsButton, #cancelCompleteItemsButton').prop('disabled', false).removeClass('btnDisabled');
	         }, 
	         {escape: true, timeout: 60000});
		}
		
		function revertSelectedItems(a)
		{
			// saving....
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupAnnuitiesController.RevertRevenuesAndCosts}',
	       		a,
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	refreshElements();
			             	hideModalBoxy();
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
			         	jQuery('#completeItemsButton, #revertItemsButton, #cancelCompleteItemsButton').prop('disabled', false).removeClass('btnDisabled');
	         }, 
	         {escape: true, timeout: 60000});
		}
    </script>
    
    <!-- INITIALISE GRID / GANTT -->
    <script>
                                      
	var annuityData = {};
	
    var treeState = {};
    
    var annuitiesScreenLayout;
    var scrollbarWidth = 16;
    var salesforceHeaderFooterHeight = isSFClassic() ? 225 : 110;
    var pageInitialising = true;
    
	jQuery(window).load(function(){
	    initialise();
	});
    
    function initialiseLayout()
    {
        // create the layout - with data-table wrapper as the layout-content element
        annuitiesScreenLayout = jQuery('#layout-container').layout({
            maskIframesOnResize: true, 
            livePaneResizing:   true
        ,   east__size:         .51
        });
        
        jQuery.subscribe('kimble.menustatechange', function(){
            annuitiesScreenLayout.resizeAll();
        });
    }
    
    function initialise()
    {
    	jQuery('#layout-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
                
        initialiseLayout(); 
        
        refreshElements();
        
        jQuery('#gantt-vertical-scroll-container').scroll(function() {
            
            jQuery('#gantt-container').scrollTop(jQuery('#gantt-vertical-scroll-container').scrollTop());
            jQuery('#grid-body-container').scrollTop(jQuery('#gantt-vertical-scroll-container').scrollTop()); 
                      
        });
        
        jQuery(window).resize(function() {
            jQuery('#layout-container').height(jQuery(window).height() - salesforceHeaderFooterHeight);
            
            var maxHeight = jQuery('#grid-layout').height() - jQuery('#grid-header-container').height() - 18; //scrollbar
            jQuery('#gantt-vertical-scroll-container, #grid-body-container, #gantt-container').css('max-height',maxHeight);
            
            refreshVerticalScroll();
            
        });
        
        //subscribe to popup events
        jQuery.subscribe('kimble.annuityChanged', function(){
           refreshElements();
        });
 
        jQuery.subscribe('kimble.annuityDeleted', function(){
            refreshElements();
        });
         
        defaultDetailViewLayout();   
        
        if (showPeriodRevenue != '')
		{
			initialisePeriodRevenue(showPeriodRevenue);
			showPeriodRevenue = '';
		}
		
		if (showPeriodCost != '')
		{
			initialisePeriodCost(showPeriodCost);
			showPeriodCost = '';
		}
    }
    
	function refreshElements()
	{
		jQuery('#loadingIndicatorOuterContainer').parent().show();
	    
	    Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupAnnuitiesController.GetTheAnnuities}',
			'{!JSENCODE(ContextId)}',
				function(result, event){          
				    if (event.status) 
				    {
				      	annuityData = result;
				      	initialiseGrid();
				  	} 
				  	else if (event.type === 'exception') 
				  	{
				      	alert(event.message);
				  	} 
				  	else 
				  	{
				      	alert(event.message);
				  	}
				  	
				  	 jQuery('#loadingIndicatorOuterContainer').parent().hide();
				}, 
				{escape: true, timeout: 60000});
	}
	
	function initialiseGrid() 
    {
    	buildAnnuitiesTable();    
        
        drawGantts();
           
        jQuery.each(Object.keys(treeState), function (i, key) {jQuery('[node-id="' + key + '"] .indent').click();});
        
        jQuery(window).resize();
        
        if (pageInitialising) pageInitialising = false;
    }
    
    var theSortedPeriods;

	function drawGantts()
	{
			jQuery('#period-header-container').empty();
	        
	        jQuery('#gantt-container').empty();
	        
	        if (annuityData.TheDeliveryElements == null) return;
	        
	        var periodHeaderHtml = '';
	        
			firstPeriod = null;
			
			theSortedPeriods = Object.keys(annuityData.TheTimePeriods).sort(sortPeriods());
			
			jQuery.each(theSortedPeriods, function (i, periodId) {
				var period = annuityData.TheTimePeriods[periodId];
				periodHeaderHtml += '<div title="{!$Label.ViewAnnuitiesMessage}" class="timeline-period ' + (period.IsOpen?'open ':'') + '" data-type="period" data-id="' + periodId + '" id="' + periodId + '">' + period.Name + '</div>';
			});
			
			jQuery(periodHeaderHtml).appendTo(jQuery('#period-header-container'));
			
			jQuery('#gantt-container').width(jQuery('#period-header-container>.timeline-period').length * 80 + 100);
			
			//debugger;
			
			jQuery.each(Object.keys(annuityData.TheDeliveryElements).sort(sortMap(annuityData.TheDeliveryElements)), function (i, eleId) {
	            
	            var p = jQuery('#gantt-container');
	            var element = annuityData.TheDeliveryElements[eleId];
	            
	            p.append(getElementTimelineHtml(element));
	         
				var ganttHtml = '';
				
				jQuery.each(Object.keys(element.TheAnnuities).sort(sortMap(element.TheAnnuities)), function (k, annuityId) {
				
					var annuity = element.TheAnnuities[annuityId];
					
					var left = getPositionForDate(annuity.StartDate);
					
					ganttHtml += '<div style="left:' + left + 'px;" class="gantt-container tree-node" parent-node-id="' + eleId + '" node-id="' + annuityId + '"><div class="annuity-periods">';
					
					jQuery.each(annuity.ThePeriods, function (x, annuityPeriod){
						var units = annuity.Units.split(',')[daysBetween(annuityPeriod.StartDate.toDate(), annuity.StartDate.toDate())];
						
						//need to calc period width as a % of 80
						var days = Math.min(28, days_between(annuityPeriod.EndDate.toDate(), annuityPeriod.StartDate.toDate()));
						var width = days/28 * 80;
						
						ganttHtml += '<div class="annuity-period" style="width:' + width + 'px"><span title="' + kimble.formatDate(annuityPeriod.StartDate) + '" class="fa fa-angle-left annuity-period-left"></span>';
						
						if (annuity.ShowUnits) ganttHtml += ('<span class="annuity-units">' + units + '</span>');
						
						ganttHtml += ('<span title="' + kimble.formatDate(annuityPeriod.EndDate) + '" class="fa fa-angle-right annuity-period-right"></span></div>');
					});
					
					ganttHtml += '</div><div class="revenue-periods">';
					
					var revenueHtml = '';
					var costHtml = '';
					
					jQuery.each(theSortedPeriods, function (i, periodId) {
					
						var period = annuityData.TheTimePeriods[periodId];
						
						if (annuity.ThePeriodRevenues[periodId] != null)
						{
							var rev = 0;
							var width = 80;
							var isOpen = false;
							var isRejected = false;
							
							var revenues = annuity.ThePeriodRevenues[periodId];
							
							if (revenues[0].StartDate.toDate() > period.StartDate.toDate())
							{
								var ending = period.EndDate.toDate();
								ending = new Date(ending.getFullYear(), ending.getMonth(), ending.getDate() + 1, 0, 0, 0, 0).toKimbleUTC();
								width = getPositionForDate(ending) - getPositionForDate(revenues[0].StartDate);
							}
							
							if (period.EndDate.toDate() > revenues[revenues.length - 1].EndDate.toDate())
							{
								width = getPositionForDate(revenues[revenues.length - 1].EndDate) - getPositionForDate(revenues[revenues.length - 1].StartDate);
							}
							
							
							jQuery.each(revenues, function (x, revenuePeriod) {
								rev += revenuePeriod.Value;
								
								if (revenuePeriod.ApprovalStatus == 'Rejected') isRejected = true;
								
								if (revenuePeriod.IsOpen) isOpen = true;
							});
							
							revenueHtml += '<div title="{!$Label.ViewAnnuitiesMessage}" annuity-id="' + annuity.Id + '" annuity-type="revenue" data-id="' + periodId + '" style="width:' + width + 'px;" class="revenue-period ' + (isOpen?'open':'') + (isRejected?' rejected':'') +'">' + kimble.formatNumber(rev) + '</div>';
						}
						
						if (annuity.ThePeriodCosts[periodId] != null)
						{
							var cost = 0;
							var width = 80;
							var isOpen = false;
							var isRejected = false;
							
							var costs = annuity.ThePeriodCosts[periodId];
							
							if (costs[0].StartDate.toDate() > period.StartDate.toDate())
