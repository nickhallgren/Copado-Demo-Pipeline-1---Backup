							});
						}
					}
				});
		});
		
		//html += '<tfoot class="rhs-button-bar"><tr><td style="text-align:center" colspan="6"><input class="btn" onclick="completeItems();" type="button" value="<apex:outputText value="{!$Label.kimbleone__complete}"/>" />&nbsp;<input class="btn" id="cancel" type="button" value="<apex:outputText value="{!$Label.kimbleone__cancel}"/>" onclick="hideModalBoxy();"/></td></tr></tfoot>';
		
		html += '</table>';
		
		return html;
	
	}

