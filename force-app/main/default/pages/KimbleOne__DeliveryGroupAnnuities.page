    <apex:form >
		<apex:actionFunction action="{!NewAnnuity}" name="newAnnuity" rerender="AnnuityEdit" oncomplete="SetupDatePicker();showModalBoxy()">
   		</apex:actionFunction>
   		
		<apex:actionFunction action="{!ReadAnnuity}" name="readAnnuity" rerender="AnnuityEdit" oncomplete="recalculateAnnuityPeriods();SetupDatePicker();showModalBoxy()">
       		<apex:param name="annuityId" value="" />
       	</apex:actionFunction>
       	
       	<apex:actionFunction action="{!ReadPeriodRevenue}" name="loadPeriodRevenue" rerender="PeriodRevenueEdit" oncomplete="showModalBoxy()">
       		<apex:param name="revenueId" value="" />
