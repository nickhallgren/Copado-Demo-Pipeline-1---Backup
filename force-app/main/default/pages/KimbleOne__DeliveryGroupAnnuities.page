<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupAnnuitiesController,KimbleOne.SecurityController"  showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__DeliveryGroup__c">

<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
     	
     	<c:Menu DefaultHelpPage="Annuities.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}" />
     	 
    </apex:define>

    <apex:define name="Content">
    
    <apex:pageBlock title="{!$ObjectType.KimbleOne__Annuity__c.LabelPlural}">
        <apex:pageBlockButtons location="top">
            <table>
                <tr>
                    <td>
                    	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__Annuity__c.createable && TheDeliveryElement.DeliveryGroup__r.DeliveryStage__r.KimbleOne__AllowNewRevenueCostItems__c}"><input id="newAnnuityButton" class="btn" type="button" onclick="addNewAnnuity();" value="{!$Label.New} {!$ObjectType.Annuity__c.label}" /></apex:outputPanel>
                    </td>
                    <td class="rightAlignCell">
                        
                    </td>
                    <td class="rightAlignCell">
                        <apex:image id="btnCloseEast" style="width:26px;" html-data-floating-dropdown="#annuity-view-details-btn-menu-data" html-data-vertical-offset="-61" styleClass="btn annuity-view-pref-trigger" url="{!URLFOR($Resource.KimbleOne__AssignmentImages, 'LHS.png')}" onclick="showDetails()" title="{!$Label.kimbleone__showdetailslabel}" />
                        <apex:image id="btnSplitScreen" style="width:26px;" html-data-floating-dropdown="#annuity-view-both-btn-menu-data" html-data-vertical-offset="-61" styleClass="btn annuity-view-pref-trigger" url="{!URLFOR($Resource.KimbleOne__AssignmentImages, 'Split.png')}" onclick="showBoth()" title="{!$Label.kimbleone__showdetailsandganttlabel}" />
                        <apex:image id="btnExpandEast" style="width:26px;" html-data-floating-dropdown="#annuity-view-gantt-btn-menu-data" html-data-vertical-offset="-61" styleClass="btn annuity-view-pref-trigger" url="{!URLFOR($Resource.KimbleOne__AssignmentImages, 'RHS.png')}" onclick="showGantt()" title="{!$Label.kimbleone__showganttlabel}" />

						<div id="annuity-view-details-btn-menu-data" class="annuity-view-pref floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
							<ul class="floating-dropdown-menu">
								<li id="btnDetailsDefault"><label><input type="radio" name="view-pref-group" value="details"/>{!$Label.DefaultViewLabel}</label></li>
							</ul>
						</div>
						<div id="annuity-view-both-btn-menu-data" class="annuity-view-pref floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
							<ul class="floating-dropdown-menu">
								<li id="btnBothDefault"><label><input type="radio" checked="checked" name="view-pref-group" value="both"/>{!$Label.DefaultViewLabel}</label></li>
							</ul>
						</div>
						<div id="annuity-view-gantt-btn-menu-data" class="annuity-view-pref floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
							<ul class="floating-dropdown-menu">
								<li id="btnGanttDefault"><label><input type="radio" name="view-pref-group" value="gantt"/>{!$Label.DefaultViewLabel}</label></li>
							</ul>
						</div>
					</td>
                </tr>
            </table>
        </apex:pageBlockButtons>
        
        <div id="container" class="zoom-level-1">
            
            <apex:actionStatus id="AnnuityListLoadingStatus">
                <apex:facet name="start">
                    <div id="loadingIndicatorOuterContainer" class="loadingIndicator">
                        <div id="loadingIndicatorInnerContainer">
                            <img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <div id="layout-container"  style="margin-right:18px;">
                <div id="grid-layout" class="ui-layout-center" style="overflow-y: hidden;">
                    <apex:outputPanel id="AnnuitiesList" styleClass="AnnuitiesListContainer">                             
                                 
                    <div id="grid-header-container">
                        
                    </div>
                    
                    <div id="grid-body-container" style="overflow-y:hidden; display: inline-block;">
                       
                    </div>
                    
                    </apex:outputPanel>
                </div><!-- grid-layout -->
                
                <div id="east-layout" class="ui-layout-east" style="overflow:hidden">
                    
                    <div id="gantt-view" style="overflow-y:hidden;height: 100%;">
                        <div id="period-header-container" style="white-space: nowrap;"></div>
                    
                        <div id="gantt-container" style="position:relative; display: inline-block; overflow: hidden;">
                            
                        </div><!-- gantt-container -->
                    </div>
                
                </div><!-- east-layout -->
                
            </div><!-- layout-container -->
            
            <div id="gantt-vertical-scroll-container">
                <div id="verticalScroll" style="width:20px;display:none;"></div>
            </div>
            
   
        </div>
                
    </apex:pageBlock>
    
    <apex:form id="AnnuityEditForm">
		<!--DO NOT REMOVE THE FOLLOWING LINE. THIS IS NEEDED IN ORDER TO DISPLAY DATE PICKERS IN THE POPUP CORRECTLY.
						SALESFORCE NEEDS TO LOAD AT LEAST ONE DATEPICKER FIELD IN INITIAL PAGE SOURCE OTHERWISE IT DOESN'T WORK CORRECTLY-->
		<span style="display:none"><apex:inputField value="{!DateHack.KimbleOne__InputDate__c}"/></span>
	<div id="AnnuityEditPopup" style="display:none;">
  
		<apex:outputPanel id="AnnuityEdit">

       			<div id="AnnuityEditErrors">
           			<apex:pageMessages id="AnnuityEditMessages" escape="false" />
           		</div>

			    <apex:pageMessage summary="{!FromDateBasis}" severity="info" strength="2" rendered="{!!ISBLANK(EarliestChangeDate)}"/>

           		<apex:pageBlock >
           		 
            		<apex:pageBlockButtons id="pageBlockButtons" location="bottom" styleClass="AnnuityEditButtonPanel">
						<apex:commandButton id="saveAnnuity" rerender="AnnuityEdit" styleclass="DisableButtonWhileBusy" action="{!SaveAnnuity}" value="{!$Label.kimbleone__save}" oncomplete="recalculateAnnuityPeriods();SetupDatePicker();hideModalBoxyWithErrorCheck('#AnnuityEditErrors');refreshElements();" disabled="{!!TheDeliveryElement.DeliveryGroup__r.DeliveryStage__r.KimbleOne__AllowNewRevenueCostItems__c}" />
						<apex:commandButton id="deleteAnnuity" onclick="var d = confirmDelete();if(!d) return;DisableButtonPanel('AnnuityEditButtonPanel','',[]);" rerender="AnnuityEdit" styleclass="" action="{!DeleteAnnuity}" value="{!$Label.kimbleone__deletebutton}" oncomplete="hideModalBoxyWithErrorCheck('#AnnuityEditErrors');refreshElements();" rendered="{!!ISBLANK(TheAnnuity.Id) && CanEditAnnuity && ISBLANK(EarliestChangeDate)}" disabled="{!!TheDeliveryElement.DeliveryGroup__r.DeliveryStage__r.KimbleOne__AllowNewRevenueCostItems__c}"/>
						<input id="cancelAnnuity" class="btn"  type="button" onclick="hideModalBoxy();" value="{!$Label.kimbleone__cancel}"/>
					</apex:pageBlockButtons>
             		
             		<div id="annuity-details" style="display:inline-block;width:400px;vertical-align:top;">
             		
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="1">
              			
              			<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheElementOptions) && TheElementOptions.size > 1}" >
		                   	<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__DeliveryElement__c.Label}</apex:outputLabel>
		                   	<apex:actionRegion >
			                   	<apex:selectList id="delivery-element-select" value="{!TheAnnuity.KimbleOne__DeliveryElement__c}" size="1" disabled="{!TheAnnuity.id != null}">
			                   		<apex:selectOptions value="{!TheElementOptions}"/>
			                   		<apex:actionSupport event="onchange" action="{!DeliveryElementChange}" rerender="AnnuitySection, AnnuityCostsPanel" oncomplete="SetupDatePicker()"/>
			                   	</apex:selectList>
		                   	</apex:actionRegion>
		               	</apex:pageBlockSectionItem>
              		</apex:pageblockSection>
              		
 	              	<apex:variable var="IsPerUnit" value="{!TheDeliveryElement.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsUnitGenerated__c || TheDeliveryElement.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsUnitGenerated__c}"/>

              		<apex:pageblockSection id="AnnuitySection" collapsible="false" showheader="false"  columns="1">
              			
               			<apex:inputfield id="annuity-name" value="{!TheAnnuity.Name}" required="true" />
               			
               			<apex:pageBlockSectionItem rendered="{!CanEditAnnuity}">
               				<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__AnnuityBehaviourRule__c.Label}</apex:outputLabel>
               				<apex:selectList id="behaviour-rule" value="{!TheAnnuity.KimbleOne__AnnuityBehaviourRule__c}" size="1" onchange="behaviourRuleChange()">
		                   		<apex:selectOptions value="{!TheBehaviourRules}"/>
		                   	</apex:selectList>
               			</apex:pageBlockSectionItem>

              			<apex:inputfield id="annuity-start-date-input" value="{!TheAnnuity.KimbleOne__StartDate__c}" styleClass="kimbleDatePicker" rendered="{!CanEditAnnuity && ISBLANK(EarliestChangeDate)}" required="true" onchange="startDateChange()"/>
              			
              			<apex:outputField id="annuity-start-date" value="{!TheAnnuity.KimbleOne__StartDate__c}" rendered="{!!CanEditAnnuity || !ISBLANK(EarliestChangeDate)}" />
              			
              			<apex:pageBlockSectionItem rendered="{!CanEditAnnuity && ISBLANK(EarliestChangeDate)}">
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__NumberOfPeriods__c.Label}</apex:outputLabel>
                   			<apex:inputfield html-data-min-val="{!TheAnnuity.KimbleOne__NumberOfPeriods__c}" id="number-of-periods" value="{!TheAnnuity.KimbleOne__NumberOfPeriods__c}" onchange="numberOfPeriodsChange()"/>
               			</apex:pageBlockSectionItem>
               			
               			<apex:inputfield id="annuity-end-date-input" value="{!TheAnnuity.KimbleOne__EndDate__c}" styleClass="kimbleDatePicker" rendered="{!CanEditAnnuity}" required="true" onchange="endDateChange()"/>
              			
              			<apex:outputField id="annuity-end-date" value="{!TheAnnuity.KimbleOne__EndDate__c}" rendered="{!!CanEditAnnuity}" />



		                <apex:pageBlockSectionItem rendered="{!HasRevenue && CanEditAnnuity}">
							<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__InvoicingCurrencyRevenueRate__c.Label} ({!InvoicingCurrencyISOCode})</apex:outputLabel>
							<apex:actionRegion >
				                <apex:inputfield id="annuity-revenue-input" value="{!TheAnnuity.KimbleOne__InvoicingCurrencyRevenueRate__c}" required="true">
									<apex:actionSupport event="onchange" status="annuityRevenueRateCalcStatus" action="{!CalculateInternalValues}" reRender="annuity-internal-revenue-input" rendered="{!TheAnnuity.KimbleOne__IsIntercompany__c}"/>
								</apex:inputField>
							</apex:actionRegion>
						</apex:pageBlockSectionItem>

						<apex:pageBlockSectionItem rendered="{!CanEditAnnuity && HasRevenue && isElementInterCompanyInvoiceable}">
							<apex:outputLabel >{!$Label.kimbleone__intercompany} {!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__RevenueRate__c.Label} {!JSINHTMLENCODE(TheAnnuity.KimbleOne__InternalInvoicingCurrencyIsoCode__c)}</apex:outputLabel>
							<apex:outputPanel layout="none">
								<div class="requiredInput">
									<apex:outputPanel layout="none" rendered="{!TheDeliveryElement.InternalRevenueBehaviourRule__r.KimbleOne__CanEditInternalRevenue__c && HasPermission['OverrideInternalRevenue']}"><div class="requiredBlock"></div></apex:outputPanel>
									<apex:actionStatus id="annuityRevenueRateCalcStatus">
										<apex:facet name="start">
											<span style="font-weight: bold;color: #4A4A56;font-size: 91%;"><img src="{!URLFOR($Resource.KimbleOne__LoadingImage)}"/>{!$Label.kimbleone__loading}</span>
										</apex:facet>
										<apex:facet name="stop">
											<apex:outputPanel id="annuity-internal-revenue-input" layout="none">
												<apex:inputField value="{!TheAnnuity.KimbleOne__IntInvCcyInternalRevenueRate__c}" rendered="{!TheDeliveryElement.InternalRevenueBehaviourRule__r.KimbleOne__CanEditInternalRevenue__c && HasPermission['OverrideInternalRevenue']}"/>
												<apex:outputField value="{!TheAnnuity.KimbleOne__IntInvCcyInternalRevenueRate__c}" rendered="{!!TheDeliveryElement.InternalRevenueBehaviourRule__r.KimbleOne__CanEditInternalRevenue__c || !HasPermission['OverrideInternalRevenue']}"/>
											</apex:outputPanel>
										</apex:facet>
									</apex:actionStatus>
								</div>
							</apex:outputPanel>
						</apex:pageBlockSectionItem>

               			<apex:pageBlockSectionItem rendered="{!HasRevenue && !CanEditAnnuity}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__InvoicingCurrencyRevenueRate__c.Label} ({!InvoicingCurrencyISOCode})</apex:outputLabel>
                   			<apex:outputtext id="annuity-revenue" value="{!TheAnnuity.KimbleOne__InvoicingCurrencyRevenueRate__c}"  styleclass="format-currency" />
               			</apex:pageBlockSectionItem>

               			<apex:pageBlockSectionItem rendered="{!HasRevenue && !CanEditAnnuity && isElementInterCompanyInvoiceable}" >
							<apex:outputLabel >{!$Label.kimbleone__intercompany} {!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__RevenueRate__c.Label} {!JSINHTMLENCODE(TheAnnuity.KimbleOne__InternalInvoicingCurrencyIsoCode__c)}</apex:outputLabel>
                   			<apex:outputtext id="annuity-internal-revenue" value="{!TheAnnuity.KimbleOne__IntInvCcyInternalRevenueRate__c}"  styleclass="format-currency" />
               			</apex:pageBlockSectionItem>

               		</apex:pageBlockSection>
						
					<apex:pageblockSection id="AnnuityCostsPanel" collapsible="false" showheader="false"  columns="1">
              			
	              		<apex:variable var="IsPerUnit" value="{!TheDeliveryElement.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsUnitGenerated__c || TheDeliveryElement.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsUnitGenerated__c}"/>
 	              		<apex:variable var="HasCost" value="{!TheDeliveryElement.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsPeriodGenerated__c}"/>

              			<apex:pageBlockSectionItem rendered="{!TheDeliveryElement.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsPeriodGenerated__c && TheDeliveryElement.Product__r.ProductDomain__r.CostGenerationModel__r.KimbleOne__IsPeriodGenerated__c && CanEditAnnuity}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRateRule__c.Label}</apex:outputLabel>
                   			<apex:actionRegion >
								<apex:selectRadio id="annuity-cost-rate-rule" layout="lineDirection" value="{!TheAnnuity.KimbleOne__CostRateRule__c}">
							     	<apex:selectOptions value="{!TheCostRateRules}"/>
							     	<apex:actionSupport event="onchange" rerender="AnnuityEditMessages, AnnuityCostsPanel" />
							    </apex:selectRadio>
							</apex:actionRegion>

               			</apex:pageBlockSectionItem>
              			
              			<apex:pageBlockSectionItem rendered="{!HasCost && CanEditAnnuity && TheAnnuity.KimbleOne__CostRateRule__c = FixedCostRateId}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRate__c.Label} ({!TheDeliveryElement.CurrencyIsoCode})</apex:outputLabel>
                   			<apex:inputfield id="annuity-cost-input" value="{!TheAnnuity.KimbleOne__CostRate__c}" required="true"/>
               			</apex:pageBlockSectionItem>
               			
               			<apex:pageBlockSectionItem rendered="{!HasCost && !CanEditAnnuity && TheAnnuity.KimbleOne__CostRateRule__c = FixedCostRateId}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRate__c.Label} ({!TheDeliveryElement.CurrencyIsoCode})</apex:outputLabel>
                   			<apex:outputtext id="annuity-cost" value="{!TheAnnuity.KimbleOne__CostRate__c}" styleclass="format-currency"/>
               			</apex:pageBlockSectionItem>
               			
               			<apex:pageBlockSectionItem rendered="{!HasCost && CanEditAnnuity && TheAnnuity.KimbleOne__CostRateRule__c = CostFactorId}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRateFactor__c.Label} (%)</apex:outputLabel>
                   			<apex:inputfield id="annuity-cost-factor-input" value="{!TheAnnuity.KimbleOne__CostRateFactor__c}" required="true"/>
               			</apex:pageBlockSectionItem>
               			
               			<apex:pageBlockSectionItem rendered="{!HasCost && !CanEditAnnuity && TheAnnuity.KimbleOne__CostRateRule__c = CostFactorId}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__CostRateFactor__c.Label} (%)</apex:outputLabel>
                   			<apex:outputtext id="annuity-cost-factor" value="{!TheAnnuity.KimbleOne__CostRateFactor__c}" styleclass="format-currency"/>
               			</apex:pageBlockSectionItem>
               			 
						<apex:pageBlockSectionItem rendered="{!IsPerUnit}" >
                   			<apex:outputLabel >{!$ObjectType.KimbleOne__Annuity__c.Fields.KimbleOne__UnitsUnitType__c.Label}</apex:outputLabel>
            				<apex:selectList id="unit-type" value="{!TheAnnuity.KimbleOne__UnitsUnitType__c}" size="1">
		                   		<apex:selectOptions value="{!TheRevenueUnitTypes}"/>
		                   	</apex:selectList>
						</apex:pageBlockSectionItem>
						
						<apex:pageBlockSectionItem rendered="{!IsPerUnit && ISBLANK(TheAnnuity.Id)}" >
                   			<apex:outputLabel ><apex:outputText value="{!$Label.kimbleone__unitslabel}"/></apex:outputLabel>
                   			<apex:inputfield id="number-of-units" value="{!InitialNumberOfUnits.KimbleOne__InputInteger__c}" onchange="updateNumberOfUnits();" />
               			</apex:pageBlockSectionItem>
						
						&nbsp;
						
		            </apex:pageBlockSection>
		            
            		<apex:inputHidden id="annuity-units-pattern" value="{!TheAnnuity.KimbleOne__UnitsPattern__c}"/>
            		
            		<apex:inputHidden id="annuity-earliest-change-date" value="{!EarliestChangeDate}"/>
            		
            		<apex:inputHidden id="annuity-anniversary-day" value="{!TheAnnuity.KimbleOne__DayOfMonth__c}"/>
            		
            		</div>
            		
            		<apex:outputPanel style="display:inline-block;vertical-align:top;max-height:371px;overflow-y: scroll;" rendered="{!IsPerUnit}">
            			
            			<table id="annuity-periods" class="list" cellpadding="0" border="0" cellspacing="0" style="table-layout: fixed;border-collapse: collapse;width: 0;">
            				<colgroup>
            					 <col style="width: 30px;"/><!-- Pos -->
            					 <col style="width: 180px;"/><!-- Period -->
            					 <col style="width: 100px;"/><!-- Units -->
            				</colgroup>
            				<thead>
	            				<tr class="headerRow">
	            					<th></th>
	            					<th><apex:outputText value="{!$Label.kimbleone__datelabel}"/></th>
	            					<th><apex:outputText value="{!$Label.kimbleone__unitslabel}"/></th>	
	            				</tr>
            				</thead>
            				<tbody>
            				
            				</tbody>
            			
            			</table>
            			
            		</apex:outputPanel>
            		
        		</apex:pageBlock>				
         
        </apex:outputPanel>
  		
  	</div>	
	</apex:form>

    <div id="PeriodRevenueEditPopup" style="display:none;">
  
		<apex:outputPanel id="PeriodRevenueEdit">
				
       			<apex:pageBlock >
           		 
            		<apex:pageBlockButtons id="pageBlockButtons" location="top">
            			<apex:outputPanel layout="none" rendered="{!CanRevertRevenue}">
							<input id="revertItemButton" class="btn" onclick="revertItem('{!ThePeriodRevenue.Id}');" type="button" value="{!$Label.ReOpenButton}"/>
						</apex:outputPanel>
						<input id="cancelPeriodRevenue" class="btn"  type="button" onclick="hideModalBoxy();" value="{!$Label.kimbleone__cancel}"/>
					</apex:pageBlockButtons>
    				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
    				
    					<apex:outputField value="{!ThePeriodRevenue.DeliveryElement__r.Name}"/>
    					<apex:outputField value="{!ThePeriodRevenue.Annuity__r.Name}"/>
    					
    					<apex:outputField value="{!ThePeriodRevenue.TimePeriod__r.Name}"/>
    					<apex:pageBlockSectionItem >
    						<apex:outputLabel >{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__Status__c.Label}</apex:outputLabel>
    						<apex:outputField value="{!ThePeriodRevenue.Status__r.Name}"/>
    					</apex:pageBlockSectionItem>
    					
    					<apex:pageBlockSectionItem >
    						<apex:outputLabel >{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__InvoicingCurrencyForecastRevenue__c.Label}</apex:outputLabel>
    						<apex:outputPanel layout="none">
    							<apex:outputField value="{!ThePeriodRevenue.KimbleOne__InvoicingCurrencyIsoCode__c}"/>&nbsp;
								<apex:outputField value="{!ThePeriodRevenue.KimbleOne__InvoicingCurrencyForecastRevenue__c}"/>
							</apex:outputPanel>
    					</apex:pageBlockSectionItem>
    					
    					<apex:pageBlockSectionItem >
    						<apex:outputLabel >{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__ApprovalStatus__c.Label}</apex:outputLabel>
    						<apex:outputField value="{!ThePeriodRevenue.KimbleOne__ApprovalStatus__c}"/>
    					</apex:pageBlockSectionItem>
    					
    					<apex:outputField value="{!ThePeriodRevenue.KimbleOne__Approver1User__c}"/>
    					<apex:outputField value="{!ThePeriodRevenue.KimbleOne__Approver2User__c}"/>
    					
    				</apex:pageblockSection>
    			</apex:pageBlock>
    				
    			<!-- Approval History -->
				<apex:relatedList list="ProcessSteps" subject="{!ThePeriodRevenue}" id="PeriodRevenueApprovalHistory" ></apex:relatedList>
				<script>
						jQuery(document).ready(function(){
    						jQuery(function() {
    							hideSalesForceApprovalProcessButtons();
    						})
    					});
    					function hideSalesForceApprovalProcessButtons()
    					{
    							jQuery('input[name="piSubmit"]').remove();
    							jQuery('input[name="piRemove"]').remove();
    					}
				</script>
    			
    	</apex:outputPanel>
    </div>
    
    <div id="PeriodCostEditPopup" style="display:none;">
  
		<apex:outputPanel id="PeriodCostEdit">
				
       			<apex:pageBlock >
           		 
            		<apex:pageBlockButtons id="pageBlockButtons" location="top">
            			<apex:outputPanel layout="none" rendered="{!CanRevertCost}">
							<input id="revertItemButton" class="btn" onclick="revertItem('{!ThePeriodCost.Id}');" type="button" value="{!$Label.ReOpenButton}"/>
						</apex:outputPanel>
						<input id="cancelPeriodCost" class="btn"  type="button" onclick="hideModalBoxy();" value="{!$Label.kimbleone__cancel}"/>
					</apex:pageBlockButtons>
    				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
    				
    					<apex:outputField value="{!ThePeriodCost.DeliveryElement__r.Name}"/>
    					<apex:outputField value="{!ThePeriodCost.Annuity__r.Name}"/>
    					
    					<apex:outputField value="{!ThePeriodCost.TimePeriod__r.Name}"/>
    					<apex:pageBlockSectionItem >
    						<apex:outputLabel >{!$ObjectType.KimbleOne__PeriodCost__c.Fields.KimbleOne__Status__c.Label}</apex:outputLabel>
    						<apex:outputField value="{!ThePeriodCost.Status__r.Name}"/>
    					</apex:pageBlockSectionItem>
    					
    					<apex:outputField value="{!ThePeriodCost.KimbleOne__ForecastCost__c}"/>
    					
    					<apex:pageBlockSectionItem >
    						<apex:outputLabel >{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__ApprovalStatus__c.Label}</apex:outputLabel>
    						<apex:outputField value="{!ThePeriodCost.KimbleOne__ApprovalStatus__c}"/>
