	function getElementTimelineHtml(element)
	{
		var timelineHtml = '<div class="gantt-timeline-container tree-node" node-id="' + element.Id + '>';
		
		if (element.StartDate == null || element.EndDate == null) return timelineHtml + '</div>';
		
		//width to first period
		
		var left = getPositionForDate(element.StartDate) - 4;
		
		var ending = element.EndDate.toDate();
		ending = new Date(ending.getFullYear(), ending.getMonth(), ending.getDate() + 1, 0, 0, 0, 0).toKimbleUTC();
		
		var width = getPositionForDate(ending) - left + 4;
		
		timelineHtml += '<div class="day-content" style="left:' + left + 'px;width:' + width + 'px"><div class="gantt-timeline"></div><div id="left" class="gantt-timeline-left"></div><div id="right" class="gantt-timeline-right"></div></div>';
		
		timelineHtml += '</div>';
	
		return timelineHtml;		
	}
	
	function getPositionForDate(dte)
	{
		var left;
		var contextDate = dte.toDate();
		
		jQuery.each(theSortedPeriods, function (i, periodId) {
			var period = annuityData.TheTimePeriods[periodId];
			
			if (contextDate <= period.EndDate.toDate())
			{
				left = jQuery('#' + period.Id).position().left + jQuery('#gantt-view').scrollLeft()
				
				var daysInPeriod = daysBetween(period.EndDate.toDate(), period.StartDate.toDate()) + 1;
				var daysThroughPeriod = daysBetween(contextDate, period.StartDate.toDate());
				var pctThroughPeriod =  daysThroughPeriod / daysInPeriod;
				
				left += (80 * pctThroughPeriod);
				return false;
			}
		});
		
		if (left == null) left = jQuery('.timeline-period:last').position().left + jQuery('.timeline-period:last').width() + jQuery('#gantt-view').scrollLeft();
		
		return left;
	}
	
	function generateAnnuityPeriodTipHtml(periodId, annuityId, typ)
	{
		var html = '<table id="items-to-status-change" class="period-tooltip" cellspacing="0" cellpadding="0" border="0">';
		html += '<thead><tr><th class="annuity-select-col">{!$Label.SelectLabel}</th><th class="annuity-name-col">{!$ObjectType.Annuity__c.Label}</th><th class="annuity-start-dte-col">{!$ObjectType.Annuity__c.Fields.StartDate__c.Label}</th><th class="annuity-end-dte-col">{!$ObjectType.Annuity__c.Fields.EndDate__c.Label}</th><th class="annuity-type-col">{!$Label.TypeLabel}</th><th class="annuity-value-col">{!$Label.ValueLabel}</th><th class="annuity-approval-status-col">{!$ObjectType.KimbleOne__PeriodRevenue__c.Fields.KimbleOne__ApprovalStatus__c.Label}</th><th class="annuity-status-col">{!$Label.StatusLabel}</th></tr></thead>';
		
		jQuery.each(Object.keys(annuityData.TheDeliveryElements).sort(sortMap(annuityData.TheDeliveryElements)), function (i, eleId) {
	            
	           var element = annuityData.TheDeliveryElements[eleId];
	            
	           jQuery.each(Object.keys(element.TheAnnuities).sort(sortMap(element.TheAnnuities)), function (k, aId) {
				
					if (annuityId == aId || annuityId == null)
					{
						var annuity = element.TheAnnuities[aId];
						
						if ((typ == null || typ == 'revenue') && annuity.ThePeriodRevenues[periodId] != null)
						{
							jQuery.each(annuity.ThePeriodRevenues[periodId], function(x, periodRevenue) {
							
								var selectorHtml = periodRevenue.CanComplete ? '<input class="btn" id="' + periodRevenue.Id + '" type="checkbox" checked></input>' : '';
			
								html += '<tr><td class="annuity-select-col">' + selectorHtml + '</td><td class="annuity-name-col"><a href="javascript:initialisePeriodRevenue(\'' + periodRevenue.Id + '\')">' + annuity.Name + '</a></td><td class="annuity-start-dte-col">' + kimble.formatDate(periodRevenue.StartDate) + '</td><td class="annuity-end-dte-col">' + kimble.formatDate(addDays(periodRevenue.EndDate.toDate(), -1).toKimbleUTC()) + '</td><td class="annuity-type-col">{!$Label.RevenueLabel}</td><td class="annuity-value-col">' + kimble.formatNumber(periodRevenue.Value, annuity.InvoicingCurrencyISOCode + ' #,###.00') + '</td><td>' + (periodRevenue.ApprovalStatus || '')  + '</td><td class="annuity-status-col">' + periodRevenue.Status + '</td></tr>';		
