<apex:page Controller="KimbleOne.ActivityAssignmentNewEditController" extensions="KimbleOne.ActivityAssignmentRemoteActions,KimbleOne.SecurityController" showHeader="false" sidebar="false">
	<div id="jobsPanel" style="display:none"></div>
	<div id="assignmentEditPanel">
	<apex:outputPanel id="Error-panel" layout="none">
	<div id="errors"><apex:pageMessages id="MessagesPanel" escape="false" /></div>
	<div id="assignment-warning" style="display:none"><span><div class="message warningM3"><table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;"><tbody><tr valign="top"><td><img alt="warning" class="msgIcon" src="/s.gif" title="{!$Label.WarningHeading}"/></td><td class="messageCell"><div class="messageText" id="assignment-warning-text"><br/></div></td></tr><tr><td></td><td></td></tr></tbody></table></div></span></div>
	<div id="assignment-error" style="display:none"><span><div class="message errorM3"><table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;"><tbody><tr valign="top"><td><img alt="error" class="msgIcon" src="/s.gif" title="{!$Label.Error}"/></td><td class="messageCell"><div class="messageText" id="assignment-error-text"><br/></div></td></tr><tr><td></td><td></td></tr></tbody></table></div></span></div>
	</apex:outputPanel>
	<apex:form >
	<div id="edit-assignment-container">

		<div id="edit-assignment-core-details">
			<div id="assignmentRefreshingContainer" class="loadingIndicator">
				<div id="loadingIndicatorInnerContainer">
					<img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.Loading}
				</div>
				</div>
			<apex:pageBlock id="ActivityAssignment" mode="edit">
		<apex:pageBlockButtons location="bottom" id="ButtonsBlock" styleclass="ButtonsBlock">
			<apex:outputPanel id="ButtonsPanel">
				<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ActivityAssignment__c.updateable}">
					<input type="button" id="SaveActivityAssignmentButton" onclick="ActivityAssignmentNewEdit.saveAssignment(false)" class="btn" value="{!$Label.Save}" />
					<input type="button" id="SaveAndNewActivityAssignmentButton" onclick="ActivityAssignmentNewEdit.saveAssignment(true);" class="btn" value="{!$Label.SaveAndNew}" />
				</apex:outputPanel>
				<input type="button" id="CancelActivityAssignmentButton" onclick="ActivityAssignmentNewEdit.cancel();" class="btn" value="{!$Label.Cancel}" />
					
			</apex:outputPanel>
		</apex:pageBlockButtons>

		<apex:pageblockSection collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__assignmentdefinitionheading}">
			
			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
				<apex:outputLabel for="ActivityList">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ResourcedActivity__c.Label}" />
				</apex:outputLabel>
				<div class="requiredInput" id="owning-activity-row">
					<div class="requiredBlock"></div>
					<select id="simple-input-owning-activity" onchange="(jQuery('#num-assignments-row:visible').length == 0 ? ActivityAssignmentNewEdit.newAssignment(jQuery('#simple-input-owning-activity').val()) : ActivityAssignmentNewEdit.newModelAssignment(jQuery('#simple-input-owning-activity').val()));"></select>
				</div>

			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
				<apex:outputLabel for="ResourceList">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Resource__c.Label}" />
				</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div class="requiredInput standard-resource" id="resource-row">
						<div class="requiredBlock"></div>

						<apex:selectList id="simple-input-resource" value="{!DummyAssignment.KimbleOne__Resource__c}" size="1" onchange="ActivityAssignmentNewEdit.resourceInputChange('Resource');" rendered="{!!UseResourceEnhancedLookup}" >
							<apex:selectOptions value="{!TheResourceOptions}" />
						</apex:selectList>

						<apex:actionRegion >
							<apex:outputPanel id="resource-panel">
								<apex:inputField id="enhanced-input-resource" value="{!DummyAssignment.KimbleOne__Resource__c}" styleclass="kimbleSearch "  rendered="{!UseResourceEnhancedLookup}">
									<apex:actionSupport onsubmit="ActivityAssignmentNewEdit.disableButtons();" event="onchange" action="{!ValidateInput}" rerender="resource-panel, Error-panel" oncomplete="ActivityAssignmentNewEdit.resourceInputChange('Resource');"/>
								</apex:inputField>
							</apex:outputPanel>
						</apex:actionRegion>

					</div>
					<div class="requiredInput model-resource" id="resource-row">
						<div class="requiredBlock"></div>

						<apex:selectList id="simple-input-model-resource" value="{!DummyAssignment.KimbleOne__Resource__c}" size="1" onchange="ActivityAssignmentNewEdit.resourceInputChange('Resource');" rendered="{!!UseResourceEnhancedLookup}" >
							<apex:selectOptions value="{!TheModelResourceOptions}" />
						</apex:selectList>

						<apex:actionRegion >
							<apex:outputPanel id="model-resource-panel">
								<apex:inputField id="enhanced-input-model-resource" value="{!DummyAssignment.KimbleOne__Resource__c}" styleclass="kimbleSearch " html-data-typename="LookupObjectModelResource" rendered="{!UseResourceEnhancedLookup}">
									<apex:actionSupport onsubmit="ActivityAssignmentNewEdit.disableButtons();" event="onchange" action="{!ValidateInput}" rerender="model-resource-panel, Error-panel" oncomplete="ActivityAssignmentNewEdit.resourceInputChange('Resource');"/>
								</apex:inputField>
							</apex:outputPanel>
						</apex:actionRegion>

					</div>
				</apex:outputPanel>
			
			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel for="WithGroupMembers">
					<apex:outputText value="{!$Label.kimbleone__resourcegroupchildassignmentslabel}" />
				</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div id="with-group-members-row">
						<apex:inputField id="with-group-members" onchange="ActivityAssignmentNewEdit.withGroupMembersChange();" value="{!DummyAssignment.KimbleOne__IsUsageProfiled__c}"  />
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputLabel for="NumberOfActivityAssignments">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__NumberOfActivityAssignments__c.Label}" />
				</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div id="num-assignments-row">
						<apex:inputField id="num-ftes" value="{!DummyAssignment.KimbleOne__NumberOfActivityAssignments__c}"  />
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputLabel for="IsFrameworkAssignment">
					<apex:outputText value="{!$Label.kimbleone__isframeworkassignment}" />
				</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div id="is-framework-assignment-row">
						<apex:inputField id="is-framework-assignment" value="{!DummyAssignment.KimbleOne__IsUsageProfiled__c}"  />
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputLabel for="ActivityRoleList">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ActivityRole__c.Label}" />
				</apex:outputLabel>
				
				<apex:outputPanel layout="none">
				<div class="requiredInput" id="role-row">
					<div class="requiredBlock"></div>
					<select id="simple-input-role" onchange="ActivityAssignmentNewEdit.resourceInputChange('Role');"></select>
				</div>	
				</apex:outputPanel>
						
			</apex:pageBlockSectionItem>
			
			<apex:pageBlockSectionItem >
				<apex:outputLabel for="LocationList">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Location__c.Label}" />
				</apex:outputLabel>
			
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="location-row">
						<div class="requiredBlock"></div>
				
						<apex:selectList id="simple-input-location" value="{!DummyAssignment.KimbleOne__Location__c}" size="1" onchange="ActivityAssignmentNewEdit.resourceInputChange('Location');" rendered="{!!UseLocationEnhancedLookup}" >
							<apex:selectOptions value="{!TheLocationOptions}" />
						</apex:selectList>
						
						<apex:actionRegion >
						<apex:outputPanel id="location-panel">
							<apex:inputField id="enhanced-input-location" styleclass="kimbleSearch " value="{!DummyAssignment.KimbleOne__Location__c}" rendered="{!UseLocationEnhancedLookup}">
								<apex:actionSupport event="onchange" action="{!ValidateInput}" rerender="location-panel, Error-panel" oncomplete="ActivityAssignmentNewEdit.resourceInputChange('Location');"/>
							</apex:inputField>
							</apex:outputPanel>
						</apex:actionRegion>
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem id="assignment-code" rendered="{!ShowAssignmentCode}">
				<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Code__c.Label}</apex:outputLabel>
				<apex:inputField value="{!DummyAssignment.KimbleOne__Code__c}" styleClass="input-assignment-code"/>
			</apex:pageBlockSectionItem>
				
			<apex:pageBlockSectionItem >
				<apex:outputLabel for="ActivityTimePattern">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ActivityTimePattern__c.Label}" />
				</apex:outputLabel>
				
				<apex:outputPanel layout="none">
				<div class="requiredInput" id="time-pattern-row">
					<div class="requiredBlock"></div>
					<select id="simple-input-time-pattern" onchange="ActivityAssignmentNewEdit.timePatternInputChange();"></select>
				</div>	
				</apex:outputPanel>
						
				</apex:pageBlockSectionItem>
				
			</apex:pageBlockSection>

			<apex:pageblockSection collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__assignmentratesheading}">
			
			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
				<apex:outputLabel >{!$ObjectType.ActivityAssignment__c.Fields.TemporalForecastRevenueRate__c.Label} <span id="invoicing-currency"></span></apex:outputLabel>
				<apex:outputPanel layout="none">

					<div class="requiredInput" id="revenue-row">
						<div class="requiredBlock"></div>
						<input type="text" id="revenue-rate" onchange="ActivityAssignmentNewEdit.revenueRateChange();"/>
					</div>
					<span style="font-size:70%">{!$Label.PerAbbreviationLabel}<span class="revenue-entry-units"></span></span>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem dataStyleClass="cost-section" rendered="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__TemporalForecastCostRate__c.Accessible}" labelstyle="width:30%" dataStyle="width:70%">
					<apex:outputLabel >{!$ObjectType.ActivityAssignment__c.Fields.TemporalForecastCostRate__c.Label} <span id="base-currency"></span></apex:outputLabel>
					<apex:outputPanel layout="none">
						<div class="requiredInput" id="cost-row">
							<div class="requiredBlock"></div>
							<input type="text" id="cost-rate" onchange="ActivityAssignmentNewEdit.costRateChange()"/>
						</div>
						<span style="font-size:70%">{!$Label.PerAbbreviationLabel}<span class="invoicing-units"></span></span>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem dataStyleClass="supplier-cost-section" labelstyle="width:30%" dataStyle="width:70%" rendered="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__TemporalForecastCostRate__c.Accessible}">
					<apex:outputLabel >{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__SupplierInvoicingCurrencyCostRate__c.Label}</apex:outputLabel>
					<apex:outputPanel layout="none">
						<div class="requiredInput" id="supplier-cost-row">
							<div class="requiredBlock"></div>
							<apex:selectList id="simple-input-supplier-currency" value="{!DummyAssignment.KimbleOne__SupplierInvoicingCurrencyISOCode__c}" size="1" onchange="ActivityAssignmentNewEdit.supplierInvoicingCurrencyInputChange();">
								<apex:selectOptions value="{!TheCurrencyOptions}" />
							</apex:selectList>
							<input type="text" id="supplier-cost-rate" onchange="ActivityAssignmentNewEdit.supplierInvoicingRateInputChange();"/>
						</div>
						<span style="font-size:70%">{!$Label.PerAbbreviationLabel}<span class="forecast-rate"></span></span>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem rendered="{!ShowAssignmentMargin && $ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__TemporalForecastCostRate__c.Accessible}" labelstyle="width:30%" dataStyle="width:70%">
					<apex:outputLabel >{!$Label.kimbleone__marginonremainingusagelabel} (%)</apex:outputLabel>
					<apex:outputPanel layout="inline"><span id="assignment-margin"></span>
						<div id="assignment-margin-basis">[<apex:outputText value="{!$Label.kimbleone__revenue}"/><span id="assignment-margin-rev"></span><apex:outputText value="{!$Label.kimbleone__cost}"/><span id="assignment-margin-cost"></span>]</div>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

			</apex:pageblockSection>

			<apex:pageblockSection id="schedulePB" collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__assignmentscheduleheading}">

			<apex:pageBlockSectionItem >
				<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}" />
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="start-date-row">
						<div class="requiredBlock"></div>

						<apex:inputField id="start-date" required="false" value="{!DummyAssignment.KimbleOne__StartDate__c}" styleclass="kimbleDatePicker " />
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%" >
				<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__IsUsageProfiled__c.Label}" />
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="is-usage-profiled-row">
						<apex:inputField id="is-usage-profiled" value="{!DummyAssignment.KimbleOne__IsUsageProfiled__c}" onchange="ActivityAssignmentNewEdit.usageProfileChanged()" />
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
				<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UsageBehaviourRule__c.Label}" />

				<apex:outputPanel layout="none">
					<div class="requiredInput" id="usage-behaviour-row">
						<div class="requiredBlock"></div>
						<select id="UsageBehaviourRule"></select>
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			<!-- TODO Disable when usage adjustments is on -->
			<apex:pageBlockSectionItem >
				<apex:outputLabel style="white-space:nowrap;">{!$Label.AssignmentEntryRemainingEffort} (<span class="forecast-units"></span>)</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="remaining-usage-row">
						<div class="requiredBlock"></div>
						<apex:inputField id="EntryRemainingUsage" value="{!DummyAssignment.KimbleOne__EntryRemainingUsage__c}" onchange="ActivityAssignmentNewEdit.remainingUsageChange()"/>
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
				<apex:outputLabel >{!$ObjectType.ActivityAssignment__c.Fields.MaximumUsage__c.Label} (<span id="max-units"></span>) </apex:outputLabel>
				<apex:outputPanel layout="none">

					<div class="requiredInput" id="max-usage-row">
						<div class="requiredBlock"></div>
						<apex:inputField id="MaxUsage" value="{!DummyAssignment.KimbleOne__MaximumUsage__c}" />
					</div>
				</apex:outputPanel>
			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputLabel style="white-space:nowrap;">{!$ObjectType.ActivityAssignment__c.Fields.UnforecastUsage__c.Label} (<span class="unforecast-units"></span>)</apex:outputLabel>
				<apex:outputPanel layout="none">
					<div id="unforecast-usage-row">
						<apex:inputField id="UnforecastUsage" value="{!DummyAssignment.KimbleOne__UnforecastUsage__c}" />
						<span style="cursor: pointer;font-size: 16px;vertical-align: middle;" class="fa fa-times-circle remove-unforecast-usage" title="{!$Label.Remove} {!$ObjectType.ActivityAssignment__c.Fields.UnforecastUsage__c.Label}"></span>
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UtilisationPercentage__c.Label} (%)" />
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="utilisation-row">
						<div class="requiredBlock"></div>
						<apex:inputField id="EntryUtilisation" value="{!DummyAssignment.KimbleOne__BaselineUtilisationPercentage__c}" />
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			<apex:pageBlockSectionItem >
				<apex:outputText value="{!$Label.kimbleone__endingonlabel}" />
				<apex:outputPanel layout="none">
					<div class="requiredInput" id="end-date-row">
						<div class="requiredBlock"></div>

						<apex:inputField id="EntryEndDate" styleclass="kimbleDatePicker " value="{!DummyAssignment.KimbleOne__ForecastP3EndDate__c}" />
					</div>
				</apex:outputPanel>

			</apex:pageBlockSectionItem>

			</apex:pageblockSection>

	</apex:pageBlock>
		</div>
		<div id="edit-additional-assignment-fields">
			<apex:pageBlock mode="edit">
				<div id="internal-revenue-section">
					<apex:pageblockSection collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__intercompany} {!$Label.kimbleone__assignmentratesheading}">
						<apex:pageBlockSectionItem labelstyle="width:30%" dataStyle="width:70%">
							<apex:outputLabel >{!$ObjectType.ActivityAssignment__c.Fields.IntInvCcyForecastInternalRevenueRate__c.Label} <span id="internal-invoicing-currency"></span></apex:outputLabel>
							<apex:outputPanel layout="none">
								<div class="requiredInput" id="internal-revenue-row">
									<div class="requiredBlock"></div>
									<input type="text" id="internal-revenue-rate" />
								</div>
								<span style="font-size:70%">{!$Label.PerAbbreviationLabel}<span class="invoicing-units"></span></span>
							</apex:outputPanel>
						</apex:pageBlockSectionItem>

						<apex:pageBlockSectionItem >
							<apex:outputLabel value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__OverrideInternalRate__c.Label}"/>
							<apex:outputPanel layout="none">
								<div id="internal-revenue-override-row">
									<apex:inputField id="internal-revenue-override" value="{!DummyAssignment.KimbleOne__OverrideInternalRate__c}" onchange="ActivityAssignmentNewEdit.isInternalRevenueOverriddenChanged()" />
								</div>
							</apex:outputPanel>
						</apex:pageBlockSectionItem>
					</apex:pageblockSection>
				</div>

				<apex:pageblockSection rendered="{!ShowAssignmentKeyFields}" collapsible="false" showheader="true" columns="1" title="{!$Label.kimbleone__assignmentkeyfields}">
					<apex:repeat value="{!TheKeyFields}" var="f" >
						<apex:inputField styleclass="assignment-key-field {!IF(AND(f.DisplayType == "DATE",$ObjectType.KimbleOne__ActivityAssignment__c.Fields[f.Name].updateable),'kimbleDatePicker','')}" html-data-reference="{!f.RelatedObjectName}" html-data-fld-type="{!f.DisplayType}" html-data-fld-name="{!f.Name}" required="{!f.IsRequired}" value="{!DummyAssignment[f.Name]}" />
					</apex:repeat>
				</apex:pageblockSection>
			</apex:pageBlock>
		</div>
	</div>

		<apex:actionRegion >
			<apex:actionFunction action="{!CancelAssignment}" name="rerenderErrorsAndResources" rerender="simple-input-resource, resource-panel, simple-input-model-resource, model-resource-panel, Error-panel" />
		</apex:actionRegion>
	</apex:form>
	</div>

	<style>
	.resize-assignment-helper {
	    border: 1px dotted #4A4A56;
	    backgrpound-color:whitesmoke;
	}
	.assignment-resizing div {visibility: hidden;}
	.assignment-resizing {border-style: dashed; background-color:#eee;}
	.assignment-resizing i {
	    position: absolute;
    	font-size: 14px;
    	top: 4px;
    	right: 5px;
 	}

 	.assignment-moving div {visibility: hidden;}
	.assignment-moving {position:fixed !important;border-style: dashed; background-color:#eee;z-index:100;}
	.assignment-moving i {
	    position: absolute;
    	font-size: 14px;
    	top: 4px;
    	left: 5px;
 	}

	.moving-dates {
		position: absolute;
		visibility: visible !important;
		font-size: 12px !important;
		top: -12px;
		background-color: #fefefe;
		left: 42px;
		border: 1px solid #bbb;
		padding: 4px 4px 4px 4px;
		border-radius: 3px;
		display:none;
		box-shadow: rgba(31, 31, 31, 0.16) 4px 3px 8px;
		padding-left:20px
	}

	.assignment-moving .moving-dates{
		display:block;
		height: 13px;
 	}
	.moving-dates::before {content: "\f05d";
		color:green;
		font-family: FontAwesome;
		position: absolute;
		left: 2px;
		top: 2px;
		font-weight: normal;
		font-size: 16px;}

	.invalid-drop .moving-dates::before {content: "\f05e";
		color:red;
		font-family: FontAwesome;
		position: absolute;
		left: 2px;
		top: 2px;
		font-weight: normal;
		font-size: 16px;}
    div#edit-assignment-container>div {
    	display: inline-block;
    	vertical-align: top;
	}
	div#assignment-margin-basis {
		font-size: 90%;
		display: none;
	}

	span#assignment-margin-rev {
		padding-left: 4px;
		padding-right: 4px;
	}

	span#assignment-margin-cost {
		padding-left: 4px;
	}

	span.model-add-info {
		font-weight: normal;
		padding-left: 5px;
 	}

	/* Used to remove the gap above the section to avoid misalignment with left hand side section header */
	div#internal-revenue-section {
		margin-bottom: 15px;
		border-bottom: 1px solid #fff;
	}

	div#edit-additional-assignment-fields .pbSubheader:not(.first) {
		margin-top: initial;
		border-top: none;
	}
	</style>

<script>
	var showAssignmentMargin = {!ShowAssignmentMargin};

	var ActivityAssignmentNewEdit = new ActivityAssignmentNewEditController();

	var pageLabels = {};
	pageLabels['NewCostEffectiveFromMessage'] = '{!JSENCODE($Label.NewCostEffectiveFromMessage)}';
	pageLabels['AssignmentScheduleHeading'] = '{!JSENCODE($Label.AssignmentScheduleHeading)}';
	pageLabels['ModelAssignmentScheduleHeading'] = '({!JSENCODE($Label.GenericLabel20)})';

	var hasInternalRevenueUpdateAccess = {!$ObjectType.ActivityAssignment__c.fields.IntInvCcyForecastInternalRevenueRate__c.updateable};
	var hasInternalRevenueReadAccess = {!$ObjectType.ActivityAssignment__c.fields.IntInvCcyForecastInternalRevenueRate__c.accessible};

	var hasSupplierCostUpdateAccess = {!$ObjectType.ActivityAssignment__c.fields.SupplierInvoicingCurrencyCostRate__c.updateable};

	function parseCostSummaryJson (j)
	{
		return kimble.parseJSON(j.replace(/"CostRate"/g, '"R"').replace(/"FromDate"/g, '"D"'));
	};

	function parseRevenueSummaryJson (j)
	{
		return kimble.parseJSON(j.replace(/"RevenueRate"/g, '"R"').replace(/"FromDate"/g, '"D"'));
	};

	function ActivityAssignmentNewEditController()
	{
		jQuery('#assignmentRefreshingContainer').hide();

		this.hasPendingJobs = false;

		this.theAssignmentToEditOriginal = null;
		this.theAssignmentToEdit = null;
		this.theAssignmentEditBehaviour = null;
		this.theSelectedResource = null;
		this.usageBehaviorRuleMap = null;

		jQuery(document).off('click', '.temporal-date');
		jQuery(document).on('click', '.temporal-date', function (event) {
			var inp = jQuery(this).find('input');

			inp.datepicker({dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
								maxDate:0,
								minDate:kimble.formatDate(ActivityAssignmentNewEdit.theAssignmentEditBehaviour.EarliestCostRateChangeDate),
								showOtherMonths: true,
								selectOtherMonths: true,
								onSelect: function(dateText, inst) {
								    jQuery(this).attr('title', dateText);
								    inp.trigger('change');
								    inp.datepicker('destroy');}
								});

			inp.datepicker('show');
		});

		jQuery(document).off('change', '.temporal-date input');
		jQuery(document).on('change', '.temporal-date input', function (event) {
			ActivityAssignmentNewEdit.theAssignmentToEdit.ForecastCostRateEffectiveDate = kimble.parseDate(jQuery(this).val());
			ActivityAssignmentNewEdit.rebuildTemporalCosts();
		});

		jQuery(document).off('click', '.future-cost-change');
		jQuery(document).on('mouseover', '.future-cost-change', function (event) {
				var j = jQuery(this);

				var assignment = j.data('assignment');
				var costs = parseCostSummaryJson(assignment.CostRateSummary);

				var tipHtml = '';
				var $row = j.closest('tr');

				var usageConversionFactor = assignment.ForecastToInvoiceConversionFactor;

				for(var i=0; i<costs.length;i++)
				{
					var formattedMesage = pageLabels['NewCostEffectiveFromMessage'].format(kimble.formatNumber(costs[i].R * usageConversionFactor, '#,##0.00'), kimble.formatDate(costs[i].D));
					tipHtml += '<div class="cost-change-message">' + formattedMesage + '</div>';
				}

				//tooltips
				j.qtip('destroy', true);

				j.qtip({
					overwrite: true,
					show: {
						solo:true,
						ready: true // Show immediately - important!
					},
					style: {
						classes: 'qtip-light qtip-shadow qtip-rounded'
					},
					content: {
						text: tipHtml,
						title: 'Costs'
					},
					position: { adjust: { method: 'flip flip'
						},
						viewport: $(window)
					}
				});
			   });

		this.applyInlineGanttEditBehaviour = function($ganttNode, theAssignment, highlightDay, activeDay, draggable, resizable)
		{
			if (!theAssignment.ActivityAllowsNewItems) return;

			if (theAssignment.ParentId != null) return;

			if (theAssignment.AssignmentType == 'AppliedModel' || theAssignment.AssignmentType == 'ActivatedModel') return;
			$ganttNode.removeClass('can-reassign');

			if (theAssignment.LatestTimeEntryDate == null && theAssignment.HasExpense == false && draggable)
			{
				$ganttNode.addClass('can-reassign');
			}

			// Can extend
			var context = ActivityAssignmentNewEdit;

			if (theAssignment.UsageBehaviourRule.EntrySpecification != 'DerivedEndDate' && resizable)
			{
				//earliest actual or scheduled date
				$ganttNode.resizable({
				    //helper: 'resize-assignment-helper',
				    handles: 'e',
				    scroll:false,
				    start: function(event, ui) {
				      	ui.element.addClass('assignment-resizing');

				      	var assignmentUsage = new ActivityAssignmentUsagePattern(theAssignment.HoursPerDay, theAssignment.StartDate.toDate(), theAssignment.UsagePattern, theAssignment.Utilisation, theAssignment.Utilisation);

						var minDate = theAssignment.StartDate.toDate();

						if (assignmentUsage.latestFirmDate != null) minDate = assignmentUsage.latestFirmDate;

						if (assignmentUsage.latestApprovedTimeDate != null && minDate.valueOf() < assignmentUsage.latestApprovedTimeDate.valueOf()) minDate = assignmentUsage.latestApprovedTimeDate;

						var $minDate = jQuery('[dte="' + minDate.valueOf() + '"]');
						var minWidth = 0;

						if ($minDate.length > 0)
						{
						    minWidth =  jQuery('[dte="' + minDate.valueOf() + '"]').offset().left - ui.element.offset().left;
      					}

						ui.element.attr('min-width', minWidth);
        			},
				    stop: function( event, ui ) {
				        var dte = activeDay(); //this is the new end date!

				        var onCancel = function(ui) {
				            // Move the element to its original position.
							ui.element.css(ui.originalPosition);
							// Modify the element's width& height to the original value.
							ui.element.css(ui.originalSize).removeClass('assignment-resizing');
            			}

				        if (dte == null)
				        {
				        	onCancel(ui);
            			}
            			else if (dte.toKimbleUTC() == theAssignment.EndDate){
							 onCancel(ui);
       					}
            			else
            			{
				        	// Need to replace entire-row with pure placeholder!
                            var $child = jQuery(handlebarsTemplates['child-row-placeholder-template'].call(this, {
                                Id:theAssignment.Id, ParentId:ui.element.closest('.parent-container').attr('obj-id'), Name:'{!JSENCODE($Label.Label024)}'.format(matchingResources[theAssignment.ResourceId].Name)
                            }));

                            $child.find('.gantt-cells').append(handlebarsTemplates['gantt-placeholder-template'].call(this, {
                                StartDate: theAssignment.StartDate, EndDate:dte.toKimbleUTC()
                            }));

							// replace child
							ui.element.closest('.child-container').replaceWith($child);

				        	context.extendAssignment($ganttNode.attr('object-id'),dte.toKimbleUTC(), function(){onCancel(ui)});
				        }
				    },
                	resize: function(event, ui) {

						var minWidth = new Number(ui.element.attr('min-width'));

						if (ui.size.width < minWidth) ui.element.width(minWidth);

						highlightDay(event, ui, 'right');
                	}
                });
   			}
 		}

		this.extendAssignment = function(assignmentId, endDate, onCancel) {

		    Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.ExtendAssignment}',
       		assignmentId, endDate, false,
      			function(result, event){
             		if (event.status)
		            {
		             	jQuery.publish('kimble.assignmentChanged', {assignmentId:assignmentId});
		         	}
		         	else if (event.type === 'exception')
		         	{
		             	alert(event.message);
		             	onCancel();
		         	}
		         	else
		         	{
		             	alert(event.message);
		             	onCancel();
		         	}
		         },
		         {escape: false, timeout: 60000});
  		}

