		this.initialiseAssignment = function (data){
			jQuery('[id$="SaveActivityAssignmentButton"], [id$="SaveAndNewActivityAssignmentButton"]').prop('disabled', true).addClass('btnDisabled');

			var context = ActivityAssignmentNewEdit;

			context.theAssignmentEditBehaviour = data;
			context.theAssignmentToEdit = context.theAssignmentEditBehaviour.TheActivityAssignment;
			context.theAssignmentToEditOriginal = JSON.parse(JSON.stringify(context.theAssignmentToEdit));
            context.TemporalCostsDisabled = false;

			context.theSelectedResource = context.theAssignmentEditBehaviour.TheSelectedResource;

			if (context.theSelectedResource != null)
				context.theAssignmentToEditOriginal.ResourceName = context.theSelectedResource.Resource.Name;

			jQuery('.invoicing-units').text(context.theAssignmentEditBehaviour.InvoicingUnits);
			jQuery('.revenue-entry-units').text(context.theAssignmentEditBehaviour.RevenueEntryUnits);
			jQuery('.forecast-units, .unforecast-units, #max-units').text(context.theAssignmentEditBehaviour.ForecastingUnits);
			jQuery('.forecast-rate').text(context.theAssignmentEditBehaviour.ForecastingRateUnits);
			jQuery('#invoicing-currency').text(context.theAssignmentToEdit.InvoicingCurrency);
			jQuery('#base-currency').text(context.theAssignmentEditBehaviour.BaseCurrency);
			jQuery('#supplier-invoicing-currency').text(context.theAssignmentToEdit.SupplierInvoicingCurrency);

			// clear any existing errors or warnings from a previous version of the screen
			jQuery('#assignment-error-text').text('');
			jQuery('#assignment-error').hide();
			jQuery('#assignment-warning-text').text('');
			jQuery('#assignment-warning').hide();
			jQuery('#assignmentEditPanel #errors .messageText').text('');
			jQuery('#assignmentEditPanel #errors').hide();
			jQuery('#assignmentEditPanel #resource-row:visible .errorMsg').text('');
			jQuery('#assignmentEditPanel #resource-row:visible .kimbleSearch').removeClass('error');

			var owningActivityRow = jQuery('#owning-activity-row');
			owningActivityRow.closest('tr').show();

			var owningActivitySelect = owningActivityRow.find('select');
			owningActivitySelect.empty();
			jQuery.each(context.theAssignmentEditBehaviour.TheScopingActivities, function(i, opt){
				jQuery('<option>').val(opt.id).text(opt.text).appendTo(owningActivitySelect);
			});

			if (context.theAssignmentEditBehaviour.TheScopingActivities.length <= 1)
			{
				owningActivityRow.closest('tr').hide();
			}

			var withGroupMembersRow = jQuery('#with-group-members-row');
			withGroupMembersRow.closest('tr').hide();

			var asModelFields = jQuery('#num-assignments-row');
			asModelFields.closest('tr').hide();

			var frameworkAssignmentRow = jQuery('#is-framework-assignment-row');

			frameworkAssignmentRow.closest('tr').show();
			if (!context.theAssignmentEditBehaviour.ShowFrameworkOption)
			{
				frameworkAssignmentRow.closest('tr').hide();
			}

			var roleRow = jQuery('#role-row');
			roleRow.closest('tr').show();
			roleRow.find('.requiredBlock').css('display', context.theAssignmentEditBehaviour.IsRoleMandatory?'':'none');

			if (context.theAssignmentEditBehaviour.TheActivityRoles.length > 1)
			{
				var roleSelect = roleRow.find('select');
				roleSelect.empty();
				jQuery.each(context.theAssignmentEditBehaviour.TheActivityRoles, function(i, opt){
					jQuery('<option>').val(opt.id).text(opt.text).appendTo(roleSelect);
				});
			}
			else
			{
				roleRow.closest('tr').hide();
			}

			var timePatternRow = jQuery('#time-pattern-row');

			var timePatternSelect = timePatternRow.find('select');
			timePatternSelect.empty();

			jQuery.each(Object.keys(context.theAssignmentEditBehaviour.TheActivityTimePatterns), function(i, key){
				jQuery('<option>').val(context.theAssignmentEditBehaviour.TheActivityTimePatterns[key].Id).text(context.theAssignmentEditBehaviour.TheActivityTimePatterns[key].Name).appendTo(timePatternSelect);
			});

			timePatternRow.closest('tr').hide();

			var locationRow = jQuery('#location-row');
			locationRow.closest('tr').show();
			locationRow.find('.requiredBlock').css('display', context.theAssignmentEditBehaviour.IsLocationMandatory?'':'none');

			if (jQuery('#location-row').find('select').length == 1 && jQuery('#location-row').find('select').find('option').length == 0)
				locationRow.closest('tr').hide();

			var revenueRow =  jQuery('#revenue-row');
			revenueRow.closest('tr').show();
			jQuery('#assignment-margin').closest('tr').show();

			if(!context.theAssignmentEditBehaviour.HasRevenue)
			{
				revenueRow.closest('tr').hide();
				jQuery('#assignment-margin').closest('tr').hide();
			}

			var internalRevenueSection = jQuery('#internal-revenue-section');
			internalRevenueSection.hide();

			var internalRevenueRow = jQuery('#internal-revenue-row');
			internalRevenueRow.closest('tr').hide();

			jQuery('#internal-revenue-override-row').find('input').prop('checked', this.theAssignmentToEdit.IsOverridden == true);

			var internalRevenueOverrideRow = jQuery('#internal-revenue-override-row');
			internalRevenueOverrideRow.closest('tr').hide();

			var supplierInvoiceRow = jQuery('#supplier-invoice-row');
			supplierInvoiceRow.closest('tr').show();

			if (jQuery('#supplier-invoice-row').find('select').length == 1 && jQuery('#supplier-invoice-row').find('select').find('option').length == 0)
				locationRow.closest('tr').hide();

			jQuery('#start-date-row a').css('display', this.theAssignmentToEdit.CanChangeResource?'':'none');

			//Usage Profiled
			jQuery('#is-usage-profiled-row').closest('tr').css('display', this.theAssignmentToEdit.IsUsageProfiled?'':'none');
			jQuery('#is-usage-profiled-row').find('input').prop('checked', this.theAssignmentToEdit.IsUsageProfiled == true);

			//Usage behaviour
			var usageBehaviourRow = jQuery('#usage-behaviour-row');
			usageBehaviourRow.closest('tr').css('display', !this.theAssignmentToEdit.IsUsageProfiled?'':'none');
			var usageSelect = usageBehaviourRow.find('select');
			usageSelect.empty();

			this.usageBehaviorRuleMap = {};

			jQuery.each(context.theAssignmentEditBehaviour.TheUsageBehaviourRules, function(i, opt){
				jQuery('<option>').val(opt.Id).text(opt.Name).appendTo(usageSelect);
				context.usageBehaviorRuleMap[opt.Id] = opt;
			});

			jQuery('#remaining-usage-row').closest('tr').css('display', !this.theAssignmentToEdit.IsUsageProfiled?'':'none');
			jQuery('#utilisation-row').closest('tr').css('display', !this.theAssignmentToEdit.IsUsageProfiled?'':'none');
			jQuery('#end-date-row').closest('tr').css('display', !this.theAssignmentToEdit.IsUsageProfiled?'':'none');

			jQuery('#num-assignments-row input').prop('disabled', context.theAssignmentToEdit.IsUsageProfiled);

			context.copyToAssignmentEditUI();

			// copy custom fields
			jQuery.each(jQuery('.assignment-key-field'), function (i, obj) {

				var fld = jQuery(obj);

				var typ = fld.attr('data-fld-type');

				var val = ActivityAssignmentNewEdit.theAssignmentEditBehaviour.TheAssignmentObject[fld.attr('data-fld-name')];

				if (val != null && val != '')
				{
					if (typ == 'REFERENCE')
					{
						var ref = fld.attr('data-reference');

						var sObject = sforce.connection.query("SELECT Id, Name FROM " + ref + " WHERE Id = '" + val + "'");
						fld.val(sObject.records.Name);

						fld.closest('td').find('[id $= "lkid"]').val(val);
					}
					else if (typ == 'INTEGER' || typ == 'LONG')
					{
						fld.val(kimble.formatNumber(val, '#,###'));
					}
					else if (typ == 'DOUBLE' || typ == 'PERCENT')
					{
						fld.val(kimble.formatNumber(val, '#,###.####'));
					}
					else if (typ == 'DATE')
					{
						fld.val(kimble.formatDate((new Date(val)).toKimbleUTC()));
					}
					else if (typ == 'BOOLEAN')
					{
						fld.prop('checked', val);
					}
					else
					{
						fld.val(val);
					}
				}
				else
				{
				    if (typ == 'BOOLEAN')
				    	fld.prop('checked', false);
				    else
						fld.val('');
    			}
			});

			context.enableFields();

			usageSelect.change();

			context.enableButtons();

			jQuery('#edit-additional-assignment-fields').css('min-height', (jQuery('#edit-assignment-core-details').height()-42), 'max-height', (jQuery('#edit-assignment-core-details').height()-42));
		}

