		this.remainingUsageChange = function(){
			if (jQuery('#max-usage-row').closest('tr').is(':visible') && (jQuery('#max-usage-row input').val() == '' || jQuery('#max-usage-row input').val() == '0'))
			{
				var context = ActivityAssignmentNewEdit;

				var v = context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].PreserveUsageMaximumUsagePercentage;

				if (v == null) v = 0;

				var remaining = kimble.parseNumber(jQuery('#remaining-usage-row input').val(),'#,##0.##');

				var mx = remaining + (remaining * v / 100);

				jQuery('#max-usage-row input').val(kimble.formatNumber(mx, '#,##0.##'));
   			}
  		}

