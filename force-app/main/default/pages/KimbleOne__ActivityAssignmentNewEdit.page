		this.usageBehaviourRuleChange = function(){
			var context = ActivityAssignmentNewEdit;

			jQuery('#unforecast-usage-row input').prop('disabled',true);
			jQuery('#remaining-usage-row input').prop('disabled',true);
			jQuery('#utilisation-row input').prop('disabled',true);
			jQuery('#end-date-row input').prop('disabled',true);
			jQuery('#start-date-row input').prop('disabled',context.theAssignmentToEdit.IsAppliedModelAssignment);
			jQuery('#max-usage-row').closest('tr').hide();

			if(jQuery('#usage-behaviour-row select').prop('disabled')) return;

			if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification == "DerivedEndDate")
			{
				jQuery('#remaining-usage-row input').prop('disabled',false);
				jQuery('#utilisation-row input').prop('disabled',false);
			}
			else if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification == "DerivedUsage")
			{
				jQuery('#utilisation-row input').prop('disabled',false);
				jQuery('#end-date-row input').prop('disabled',false);
			}
			else if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification == "DerivedUtilisation")
			{
				jQuery('#remaining-usage-row input').prop('disabled',false);
				jQuery('#end-date-row input').prop('disabled',false);
			}
			else if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification == "TaskUsage")
			{
				jQuery('#start-date-row input').prop('disabled',true);
				jQuery('#remaining-usage-row input').prop('disabled',true);
				jQuery('#end-date-row input').prop('disabled',true);
				jQuery('#utilisation-row input').prop('disabled',true);
			}
			else if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification == "NoForecast")
			{
			    jQuery('#end-date-row input').prop('disabled',false);
   			}

			if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].EntrySpecification != "DerivedUsage" && context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].FixedUsage && context.theAssignmentToEdit.Id != null)
				jQuery('#remaining-usage-row input').prop('disabled',true);

			if (context.usageBehaviorRuleMap[jQuery('#usage-behaviour-row select').val()].ShowMaxUsage)
				jQuery('#max-usage-row').closest('tr').show();
			else
				jQuery('#max-usage-row').closest('tr').hide().find('#max-usage-row input').val('');

			var internalRevenueSection = jQuery('#internal-revenue-section');
			var internalRevenueRow = jQuery('#internal-revenue-row');
			var internalRevenueOverrideRow = jQuery('#internal-revenue-override-row');

			if (context.theAssignmentToEdit.IsIntercompany && hasInternalRevenueReadAccess)
			{
				internalRevenueSection.show();
				internalRevenueRow.closest('tr').show();
				if (context.theAssignmentEditBehaviour.CanEditInternalRevenue)
					internalRevenueOverrideRow.closest('tr').show();
				else
					internalRevenueOverrideRow.closest('tr').hide();
			}
			else
			{
				internalRevenueSection.hide();
				internalRevenueRow.closest('tr').hide();
				internalRevenueOverrideRow.closest('tr').hide();
			}

			context.copyToAssignmentObject();

			if (context.theAssignmentToEdit.TheActivityTimePatternId == null) return;

			recalculateUsage(context.theAssignmentToEdit, context.theSelectedResource, context.usageBehaviorRuleMap, context.theAssignmentEditBehaviour.TheActivityTimePatterns[context.theAssignmentToEdit.TheActivityTimePatternId].HoursPerDay);

			context.calculateTotalCostAndRevenue();

			context.copyToAssignmentEditUI();
		}

