		this.resourceAvailability = function(date) 
		{
	  		var context = ActivityAssignmentNewEdit;
	  		
	  		if (context.theSelectedResource == null) return [false,null];
	  		
	  		var earliestOpenDate = context.theAssignmentEditBehaviour.EarliestAssignableDate.toDate();

	  		var availabilityStartDate = context.theSelectedResource.AvailabilityPattern.StartDate.toDate();
	  		
	  		var earliestOffsetInDays = Math.round((date.getTime() - earliestOpenDate.getTime()) / (1000*60*60*24));
	  		
	  		var availabilityOffsetInDays = Math.round((date.getTime() - availabilityStartDate.getTime()) / (1000*60*60*24));
	  		
	  		if (earliestOffsetInDays < 0)
	  			return [false,"closedperiod","Closed Period"];

	  		if (context.theAssignmentToEdit.AllocatableMinStartDate != null && (date < context.theAssignmentToEdit.AllocatableMinStartDate.toDate() || date > context.theAssignmentToEdit.AllocatableMaxEndDate.toDate()))
	  			return [false,"closedperiod","Outside allocatable range"];

	  		//Start date cannot be after latest start date
	  		if (this.id.endsWith('start-date') && context.theAssignmentToEdit.LatestStartDate != null && date > context.theAssignmentToEdit.LatestStartDate.toDate())
	  			return [false, "closedperiod", "Time Entry Exists"];
	  		
	  		//End date cannot be before latest time entry
	  		if (this.id.endsWith('EntryEndDate') && context.theAssignmentToEdit.EarliestEndDate != null && date < context.theAssignmentToEdit.EarliestEndDate.toDate())
	  			return [false, "closedperiod", "Time Entry Exists"];
	  		
	  		var availabilityChar = context.theSelectedResource.AvailabilityPattern.UsagePattern.substring(availabilityOffsetInDays,availabilityOffsetInDays + 1);
	  		
	  		if (availabilityChar == '|')
	  			return [false,"closedperiod","Closed Period"];
	  		
	  		if (availabilityChar == '!')
	  			return [false,"Unavailable","Unavailable"];
	  		
	  		if (availabilityChar == '-')
	  			return [false,"NonBusDay","Non business day"];
	  		
	  		if (availabilityOffsetInDays < 0)
	  			return [true,"closedperiod","Closed Period"];
	  		
	  		var dayUsage = context.theSelectedResource.Resource.AggregatePattern[date.toKimbleUTC()];
	  		
	  		if (dayUsage == null) return [true, null];
	  		
	  		var prob = dayUsage.p;
	  		
	  		if (prob == null) return [true, null];
	  		
	  	 	return [true, classificationStyleMap[Object.keys(prob)[0].Cls] + ' no-background'];
	  		
	  	}
	}

	function calculateAssignmentTotalRevenue(assignment, usagePattern, convFactor)
	{
	    var exRates = kimble.parseJSON(assignment.RevenueRateExchangeRateSummary.replace(/"Rate"/g, '"R"').replace(/"FromDate"/g, '"D"'));

		var invRevRate = assignment.InvoicingCurrencyForecastRevenueRate;

		var totalRev = 0;

		for (var i=0; i<exRates.length; i++)
		{
			var exRate = exRates[i];
			var fromDate = exRate.D.toDate();
			var toDate;

			if (exRates.length > i + 1)
				toDate = exRates[i+1].D.toDate().kimbleAddDays(-1);
			else
				toDate = assignment.EndDate.toDate();

			var remainingUsage = usagePattern.getUsageInHoursForDateRange(fromDate, toDate);

			totalRev += remainingUsage / convFactor * invRevRate * exRate.R;
		}

		return totalRev;
 	}

	function calculateAssignmentTotalCost(assignment, usagePattern, convFactor)
	{
		var costRates = kimble.parseJSON(assignment.CostRateSummary.replace(/"Rate"/g, '"R"').replace(/"FromDate"/g, '"D"'));

		var totalCost = 0;

		for (var i=0; i<costRates.length; i++)
		{
			var rate = costRates[i];
			var fromDate = rate.D.toDate()
			var toDate;

			if (costRates.length > i + 1)
				toDate = costRates[i+1].D.toDate().kimbleAddDays(-1);
			else
				toDate = assignment.EndDate.toDate();

			var remainingUsage = usagePattern.getUsageInHoursForDateRange(fromDate, toDate);

			totalCost += remainingUsage / convFactor * rate.R;
		}

		return totalCost;
	}

