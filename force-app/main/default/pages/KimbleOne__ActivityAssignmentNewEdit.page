		this.saveAssignment = function(andNew) {

			var context = ActivityAssignmentNewEdit;

			context.copyToAssignmentObject();

			if (context.theAssignmentToEdit.ResourceId == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Resource__c.Label}'));
			if (context.theAssignmentEditBehaviour.IsRoleMandatory && context.theAssignmentToEdit.ActivityRoleId == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ActivityRole__c.Label}'));
			if (context.theAssignmentEditBehaviour.IsLocationMandatory && context.theAssignmentToEdit.LocationId == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Location__c.Label}'));
			if (context.theAssignmentEditBehaviour.HasRevenue && context.theAssignmentEditBehaviour.CanEditRevenue && jQuery('#revenue-row input').val() == '') return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.ActivityAssignment__c.Fields.TemporalForecastRevenueRate__c.Label}'));
			if (context.theAssignmentEditBehaviour.HasInterCompanyAccounting && jQuery('#internal-revenue-row input').val() == '') return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.ActivityAssignment__c.Fields.IntInvCcyForecastInternalRevenueRate__c.Label}'));

			if (context.theAssignmentToEdit.StartDate == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}'));
			if (context.theAssignmentToEdit.UsageBehaviourRuleId == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UsageBehaviourRule__c.Label}'));
			if (context.theAssignmentToEdit.Utilisation == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.ActivityAssignment__c.Fields.UtilisationPercentage__c.Label}'));
			if (context.theAssignmentToEdit.RemainingUsage == null) return alert(kimble.labels['RequiredValue'].format('{!JSENCODE($Label.AssignmentEntryRemainingEffort)}'));
			if (context.theAssignmentToEdit.EndDate == null) return alert(kimble.labels['RequiredValue'].format('{!JSENCODE($Label.EndingOnLabel)}'));
			if(jQuery('#max-usage-row').is(':visible') && context.theAssignmentToEdit.MaximumUsage == null) return alert(kimble.labels['RequiredValue'].format('{!$ObjectType.ActivityAssignment__c.Fields.MaximumUsage__c.Label}'));
            if(jQuery('#max-usage-row').is(':visible') && context.theAssignmentToEdit.MaximumUsage < context.theAssignmentToEdit.RemainingUsage) return alert(kimble.labels['CannotBeGreaterThan'].format('{!JSENCODE($Label.AssignmentEntryRemainingEffort)}', '{!$ObjectType.ActivityAssignment__c.Fields.MaximumUsage__c.Label}'));

			if (context.theAssignmentToEdit.EarliestTimeEntryDate != null && context.theAssignmentToEdit.StartDate.toDate() > context.theAssignmentToEdit.EarliestTimeEntryDate.toDate())
			{
				alert(kimble.labels['FirmTimeBeforeStartDateMessage']);
				return;
			}

			var customFields = [];

			jQuery.each(jQuery('.assignment-key-field'), function (i, obj) {

				var fld = jQuery(obj);

				var typ = fld.attr('data-fld-type');
				var fldName = fld.attr('data-fld-name');
				var val = null;

				if (typ == 'REFERENCE')
				{
					val = fld.closest('td').find('[id $= "lkid"]').val();
				}
				else if (typ == 'INTEGER' || typ == 'LONG')
				{
					val = kimble.parseNumber(fld.val(), '#,###');
				}
				else if (typ == 'DOUBLE' || typ == 'PERCENT')
				{
					val = kimble.parseNumber(fld.val(),'#,###.####');
				}
				else if (typ == 'DATE')
				{
					val = kimble.parseDate(fld.val());
				}
				else if (typ == 'BOOLEAN')
				{
					val = fld.prop('checked');
				}
				else
				{
					val = fld.val();
				}

				customFields.push({Name:fldName, DisplayType:typ, Value:val});
			});

			context.theAssignmentToEdit.CustomFields = customFields;

			context.disableButtons();
			jQuery('#assignmentRefreshingContainer').show();

			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.SaveActivityAssignment}',
       		context.theAssignmentToEdit,
      			function(result, event){
      			    jQuery('#assignmentRefreshingContainer').hide();

             		if (event.status)
		            {
		             	jQuery.publish('kimble.assignmentCreated', {assignmentId:result});

		             	if(andNew)
		             	{
		             		context.newAssignment(context.theAssignmentToEdit.TheScopingActivityId);
		             		context.hasPendingJobs = true;
		             	}
		             	else
		             	{
		             		jQuery('#jobsPanel').height(jQuery('#assignmentEditPanel').height()).width(jQuery('#assignmentEditPanel').width()).show();
		             		jQuery('#assignmentEditPanel').hide();
		             		loadJobsPopup(jQuery('#jobsPanel'), context.theAssignmentToEdit.TheScopingActivityId, context.saveAssignmentComplete);
		             	}
		         	}
		         	else if (event.type === 'exception')
		         	{
		             	alert(event.message);
		         	}
		         	else
		         	{
		             	alert(event.message);
		         	}

		         	context.enableButtons();
		         },
		         {escape: false, timeout: 60000});
			}

		this.copyToAssignmentObject = function() {
			var context = ActivityAssignmentNewEdit;

			context.theAssignmentToEdit.TheScopingActivityId = kimble.parseId(jQuery('#owning-activity-row select').val());

			var resourceId = kimble.parseId(jQuery('#resource-row:visible input:hidden[id$="lkid"], #resource-row:visible select').val());

			if (resourceId != '000000000000000')
				context.theAssignmentToEdit.ResourceId = resourceId;
			else
				context.theAssignmentToEdit.ResourceId = null;

			context.theAssignmentToEdit.ActivityRoleId = kimble.parseId(jQuery('#role-row select').val());
			context.theAssignmentToEdit.TheActivityTimePatternId = kimble.parseId(jQuery('#time-pattern-row select').val());

            var locationId = kimble.parseId(jQuery('#location-row input:hidden[id$="lkid"], #location-row select').val());
            
			if (locationId != '000000000000000')
				context.theAssignmentToEdit.LocationId = locationId;
			else
				context.theAssignmentToEdit.LocationId = null;

			// this checks field security and if the currency dropdown is shown
			if (hasSupplierCostUpdateAccess && jQuery('#supplier-cost-row select').length)
				context.theAssignmentToEdit.SupplierInvoicingCurrency = jQuery('#supplier-cost-row select').val();

			if(jQuery('input.input-assignment-code').length) context.theAssignmentToEdit.Code = jQuery('input.input-assignment-code').val();

			context.theAssignmentToEdit.StartDate = kimble.parseDate(jQuery('#start-date-row input').val());
			context.theAssignmentToEdit.UsageBehaviourRuleId = kimble.parseId(jQuery('#usage-behaviour-row select').val());

			context.theAssignmentToEdit.IsUsageProfiled = jQuery('#is-usage-profiled-row').find('input').prop('checked');

			context.theAssignmentToEdit.RemainingUsage = kimble.parseNumber(jQuery('#remaining-usage-row input').val(),'#,##0.##');

			if(jQuery('#max-usage-row').is(':visible'))
				context.theAssignmentToEdit.MaximumUsage = kimble.parseNumber(jQuery('#max-usage-row input').val(),'#,##0.##');

			context.theAssignmentToEdit.Utilisation = kimble.parseNumber(jQuery('#utilisation-row input').val(),'#,##');
			context.theAssignmentToEdit.EndDate = kimble.parseDate(jQuery('#end-date-row input').val());

			context.theAssignmentToEdit.WithGroupMembers = jQuery('#with-group-members-row').find('input').prop('checked') == true;
			context.theAssignmentToEdit.NumberOfActivityAssignments = kimble.parseNumber(jQuery('#num-assignments-row input').val(),'#,##0.##');
			context.theAssignmentToEdit.IsFrameworkAssignment = jQuery('#is-framework-assignment-row').find('input').prop('checked') == true;

			if (context.theAssignmentEditBehaviour.HasInterCompanyAccounting)
			{
				var intRev = kimble.parseNumber(jQuery('#internal-revenue-row input').val(),'#,##0.##');

			    context.theAssignmentToEdit.InternalInvoicingCurrencyForecastRevenueRate = intRev / context.theAssignmentToEdit.ForecastToInvoiceConversionFactor;

				if (context.theAssignmentEditBehaviour.CanEditInternalRevenue)
					context.theAssignmentToEdit.IsOverridden = jQuery('#internal-revenue-override-row').find('input').prop('checked') == true;
   			}
		}

		this.saveAssignmentComplete = function(){
			var context = ActivityAssignmentNewEdit;
			context.hasPendingJobs = false;

			//raise event assignment changed with new assignment gantt
		    jQuery.publish('kimble.assignmentChanged', {resourceId:context.theAssignmentToEdit.ResourceId, assignmentId:context.theAssignmentToEdit.Id});

		    hideModalBoxy();

			jQuery('#jobsPanel').hide();
		    jQuery('#assignmentEditPanel').show();

		}

		this.copyToAssignmentEditUI = function(){
			var context = ActivityAssignmentNewEdit;

			jQuery('#owning-activity-row select').val(context.theAssignmentToEdit.TheScopingActivityId);

			if (context.theAssignmentToEdit.IsModelAssignment || context.theAssignmentToEdit.IsAppliedModelAssignment || context.theAssignmentToEdit.IsActivatedModelAssignment)
			{
				context.enableModelFields();
				jQuery('#num-assignments-row').find('input').val(kimble.formatNumber((context.theAssignmentToEdit.NumberOfActivityAssignments != undefined && context.theAssignmentToEdit.NumberOfActivityAssignments != null && context.theAssignmentToEdit.NumberOfActivityAssignments != '' ? context.theAssignmentToEdit.NumberOfActivityAssignments : 1),'#,##0.##'));
			}
			else
			{
				context.hideModelFields();
			}

			if (context.theSelectedResource != null)
			{
				jQuery('#resource-row:visible input:text').val(unescapeHTML(context.theSelectedResource.Resource.Name));
				jQuery('#resource-row:visible input:hidden[id$="lkid"],#resource-row:visible select').val(context.theAssignmentToEdit.ResourceId);

				// if using select and resource isn't in the list then add it to the select list.
				if (jQuery('#resource-row:visible select').length == 1 && jQuery('#resource-row:visible select').val() == null) {
					jQuery('#resource-row:visible select').append('<option selected="true" value="' + context.theAssignmentToEdit.ResourceId + '">' + context.theSelectedResource.Resource.Name + '</option>');
				}

				if (context.theSelectedResource.AllowGroupMembers)
				{
					jQuery('#with-group-members-row').closest('tr').show();

					jQuery('#with-group-members-row').find('input').prop('checked', context.theAssignmentToEdit.WithGroupMembers).prop('disabled', context.theAssignmentToEdit.Id != null);
				}
				else
				{
					//default to true
					jQuery('#with-group-members-row').find('input').prop('checked', true);
					jQuery('#with-group-members-row').closest('tr').hide();
				}
			}
			else
			{
				jQuery('#resource-row:visible input:text').val('');
				jQuery('#resource-row:visible input:hidden[id$="lkid"],#resource-row:visible select').val('');

				jQuery('#with-group-members-row').find('input').prop('checked', true);
				jQuery('#with-group-members-row').closest('tr').hide();
			}

			jQuery('#is-framework-assignment-row').find('input').prop('checked', context.theAssignmentToEdit.IsFrameworkAssignment);

			jQuery('#role-row select').val(context.theAssignmentToEdit.ActivityRoleId);
			jQuery('#time-pattern-row select').val(context.theAssignmentToEdit.TheActivityTimePatternId);

			jQuery('#location-row input:text').val(context.theAssignmentToEdit.LocationName);
			jQuery('#location-row input:hidden[id$="lkid"],#location-row select').val(context.theAssignmentToEdit.LocationId);

			jQuery('input.input-assignment-code').val((context.theAssignmentToEdit.Code != undefined ? context.theAssignmentToEdit.Code : ''));

			jQuery('#supplier-cost-row select').val(context.theAssignmentToEdit.SupplierInvoicingCurrency);

			this.applySupplierCostRate();
			this.applyRevenueRate();

			if (context.theAssignmentEditBehaviour.HasInterCompanyAccounting)
			{
			    jQuery('#internal-invoicing-currency').text(context.theAssignmentToEdit.InternalInvoicingCurrencyIsoCode);

			    var intRev = context.theAssignmentToEdit.InternalInvoicingCurrencyForecastRevenueRate * context.theAssignmentToEdit.ForecastToInvoiceConversionFactor;
        		jQuery('#internal-revenue-row input').val(jQuery.formatNumber(intRev, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));

				jQuery('#internal-revenue-override-row').find('input').prop('checked', context.theAssignmentToEdit.IsOverriden).prop('disabled', !context.theAssignmentEditBehaviour.CanEditInternalRevenue);
			}

			this.applyCostRate();

			jQuery('#start-date-row input').val(kimble.formatDate(context.theAssignmentToEdit.StartDate));

			if (context.theAssignmentToEdit.UsageBehaviourRuleId != null)
				jQuery('#usage-behaviour-row select').val(context.theAssignmentToEdit.UsageBehaviourRuleId);

			if (context.theAssignmentToEdit.RemainingUsage != null)
				jQuery('#remaining-usage-row input').val(kimble.formatNumber(context.theAssignmentToEdit.RemainingUsage,'#,##0.##'));
			else
				jQuery('#remaining-usage-row input').val('');

			if (context.theAssignmentToEdit.MaximumUsage != null)
				jQuery('#max-usage-row input').val(kimble.formatNumber(context.theAssignmentToEdit.MaximumUsage,'#,##0.##'));
			else
   				jQuery('#max-usage-row input').val('');

			if (context.theAssignmentToEdit.UnforecastUsage != null && context.theAssignmentToEdit.UnforecastUsage != 0)
			{
				jQuery('#unforecast-usage-row').closest('tr').show();
				jQuery('#unforecast-usage-row input').val(kimble.formatNumber(context.theAssignmentToEdit.UnforecastUsage,'#,##0.##'));
				jQuery('#remaining-usage-row input').prop('disabled',true);
			}
			else
			{
				jQuery('#unforecast-usage-row').closest('tr').hide();
				jQuery('#unforecast-usage-row input').val('');
			}

			if (context.theAssignmentToEdit.Utilisation != null)
				jQuery('#utilisation-row input').val(kimble.formatNumber(context.theAssignmentToEdit.Utilisation,'#,##0.##'));
			else
				jQuery('#utilisation-row input').val('');

			jQuery('#end-date-row input').val(kimble.formatDate(context.theAssignmentToEdit.EndDate));

			jQuery('.allocatable-usage').remove();

			if (context.theAssignmentToEdit.AllocatableUsage != null)
            {
                var $info = jQuery('<span title="Total Remaining usage to be allocated: ' + context.theAssignmentToEdit.AllocatableUsage  + '" class="fa fa-info-circle allocatable-usage"/>');
                jQuery('#remaining-usage-row input').after($info);
            }
		}

		this.calculateTotalCostAndRevenue = function () {

			var context = ActivityAssignmentNewEdit;
			//TODO:
			if (showAssignmentMargin)
            {
                jQuery('#assignment-margin-basis').hide();
                if (jQuery('#revenue-rate').length > 0)
                {
                	var assignmentUsage = new ActivityAssignmentUsagePattern(context.theAssignmentToEdit.HoursPerDay, context.theAssignmentToEdit.StartDate.toDate(), context.theAssignmentToEdit.UsagePattern, context.theAssignmentToEdit.Utilisation, context.theAssignmentToEdit.Utilisation);
                	var totalCost = calculateAssignmentTotalCost(context.theAssignmentToEdit, assignmentUsage, context.theAssignmentToEdit.ForecastToHourConversionFactor);
                	//jQuery('#assignment-total-cost').text('{!JSENCODE($label.Total)} ' + context.theAssignmentEditBehaviour.BaseCurrency + ' ' +  kimble.formatNumber(totalCost, '#,##0.##'));

					var	totalRev = calculateAssignmentTotalRevenue(context.theAssignmentToEdit, assignmentUsage, context.theAssignmentToEdit.ForecastToHourConversionFactor);
					//jQuery('#assignment-total-revenue').text(kimble.formatNumber(totalRev, '#,##0.##'));

                	var margin = totalRev > 0 ? (totalRev-totalCost) / totalRev * 100 : 0;
                	jQuery('#assignment-margin').text(kimble.formatNumber(margin, '#,##0.##'));
                	jQuery('#assignment-margin-basis').show();
                	jQuery('#assignment-margin-rev').text(context.theAssignmentEditBehaviour.BaseCurrency + ' ' + kimble.formatNumber(totalRev, '#,##0.##'));
                	jQuery('#assignment-margin-cost').text(context.theAssignmentEditBehaviour.BaseCurrency + ' ' + kimble.formatNumber(totalCost, '#,##0.##'));
                }
            }
  		}

		this.resourceChange = function () {
			var context = ActivityAssignmentNewEdit;
			
			var thefield = '{!$ObjectType.ActivityAssignment__c.fields.ResourceInitials__c.Name}';
			if (jQuery('[data-fld-name="' + thefield + '"]').length == 1)
			{
				var theInitials = context.theAssignmentToEdit.Initials;
				jQuery('[data-fld-name="' + thefield + '"]').val(theInitials);
		    }
		};

		this.costRateChange = function () {
			var context = ActivityAssignmentNewEdit;

			if (jQuery('#cost-row input').length > 0)
			{
				var costRate = kimble.parseNumber(jQuery('#cost-row input').val(),'#,##0.00');
				var forecastRate = costRate / context.theAssignmentToEdit.ForecastToInvoiceConversionFactor;
				var rateChanged = forecastRate != context.theAssignmentToEdit.ForecastCostRate;

				if (rateChanged) {
					context.theAssignmentToEdit.ForecastCostRate = forecastRate

					if (!context.theAssignmentEditBehaviour.HasTemporalCost) return;

					if (context.TemporalCostsDisabled) return;

					if (context.theAssignmentToEdit.Id != null) context.theAssignmentToEdit.ForecastCostRateEffectiveDate = new Date().toKimbleUTC();

					context.rebuildTemporalCosts();

					jQuery('#cost-row .temporal-date').show().click();
				}
		    }

			if (context.theAssignmentToEdit.IsIntercompany && rateChanged)
			{
				context.calculateInternalRate();
			}

		    context.calculateTotalCostAndRevenue();
		};

		this.rebuildTemporalCosts = function () {

			var context = this;

			if(context.theAssignmentToEditOriginal.CostRateSummary == null) context.theAssignmentToEditOriginal.CostRateSummary = '[]';

			if (context.theAssignmentEditBehaviour.CanEditCost) {

				var newCostSummary = [];
				var latestAdded = false;

				if  (context.theAssignmentToEdit.ForecastCostRateEffectiveDate == null) context.theAssignmentToEdit.ForecastCostRateEffectiveDate = context.theAssignmentToEdit.StartDate;

				var latestCost = {D:context.theAssignmentToEdit.ForecastCostRateEffectiveDate, R:kimble.parseNumber(jQuery('#cost-row input').val(),'#,##0.00') / ActivityAssignmentNewEdit.theAssignmentToEdit.ForecastToInvoiceConversionFactor};

				parseCostSummaryJson(context.theAssignmentToEditOriginal.CostRateSummary).forEach(function(cost) {
					if (!latestAdded) {
						if (cost.D.toDate().valueOf() < context.theAssignmentToEdit.ForecastCostRateEffectiveDate.toDate().valueOf()) {
							newCostSummary.push(cost);
						}
						else {
							latestAdded = true;
							newCostSummary.push(latestCost);
						}
					}
				});

				if (!latestAdded && (newCostSummary.length == 0 || latestCost.R.toFixed(2) != newCostSummary[newCostSummary.length-1].R.toFixed(2))) newCostSummary.push(latestCost);

				context.theAssignmentToEdit.CostRateSummary = JSON.stringify(newCostSummary);
			}

			if (context.theAssignmentToEdit.CostRateSummary != null && context.theAssignmentToEdit.CostRateSummary != '') {
				var summary = JSON.parse(context.theAssignmentToEdit.CostRateSummary);

				jQuery('#cost-row .future-cost-change').remove();
				if (summary.length > 1)
				{
					var $futureCostChange = jQuery('<span class="fa fa-info-circle future-cost-change"/>');
					$futureCostChange.data('assignment', context.theAssignmentToEdit);
					jQuery('#cost-row input:last').after($futureCostChange);
				}
            }
  		}

		this.revenueRateChange = function () {
			var context = ActivityAssignmentNewEdit;

			var invRevRate = kimble.parseNumber(jQuery('#revenue-row input').val(),'#,##0.00') / context.theAssignmentToEdit.ForecastToRevenueConversionFactor;
			var rateChanged = invRevRate != context.theAssignmentToEdit.InvoicingCurrencyForecastRevenueRate;

			context.theAssignmentToEdit.InvoicingCurrencyForecastRevenueRate = invRevRate;

			context.theAssignmentToEdit.RevenueRateSummary = '[{"D":"' + context.theAssignmentToEdit.StartDate + '","R":' + (context.theAssignmentToEdit.InvoicingCurrencyForecastRevenueRate) + '}]';

		    if (context.theAssignmentEditBehaviour.RevenueChangeEffectiveDate != null && context.theAssignmentEditBehaviour.RevenueChangeEffectiveDate != '')
		    {
		    	var $changeApplicableWhen = jQuery('<span class="fa fa-info-circle effective-change" title="Change effective ' + kimble.formatDate(context.theAssignmentEditBehaviour.RevenueChangeEffectiveDate)  + '"/>');
                jQuery('#revenue-row input').after($changeApplicableWhen);

		    }

			if (context.theAssignmentToEdit.IsIntercompany && rateChanged)
			{
				context.calculateInternalRate();
			}

		    context.calculateTotalCostAndRevenue();
		};

		this.applyRevenueRate = function () {

			var context = ActivityAssignmentNewEdit;

			jQuery('#revenue-row input').val('');

			var revenueRate = context.theAssignmentToEdit.InvoicingCurrencyForecastRevenueRate * context.theAssignmentToEdit.ForecastToRevenueConversionFactor;

        	jQuery('#revenue-row input').val(jQuery.formatNumber(revenueRate, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false}));

		};

		this.applyCostRate = function () {
			var context = ActivityAssignmentNewEdit;

			jQuery('#cost-row input').val('');
			jQuery('#cost-row .future-cost-change').remove();
			jQuery('#cost-row .temporal-date').remove();

			if (context.theAssignmentToEdit.CostRateSummary == null || context.theAssignmentToEdit.CostRateSummary == '') return;

			var costRateSummary = parseCostSummaryJson(context.theAssignmentToEdit.CostRateSummary);

		    if (costRateSummary.length == 0) return;

			var costRate;

			//if costs are editable show latest cost
			if (context.theAssignmentEditBehaviour.CanEditCost || context.theAssignmentEditBehaviour.CostRateEditable) {
