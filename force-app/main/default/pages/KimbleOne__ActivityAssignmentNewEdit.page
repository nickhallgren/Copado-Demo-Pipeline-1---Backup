		this.quickAssign = function(assignmentId, resourceId, newStartDate, oncomplete, onCancel, onerror) {
		    var context = ActivityAssignmentNewEdit;
		    Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.QuickAssignResource}',
       		assignmentId, resourceId, newStartDate,
      			function(result, event){
             		if (event.status)
		            {
		             	if (result == true) {
		             	 	// retry save due to row lock error
		             	 	var retry = function() {
		             	 	    context.quickAssign(assignmentId, resourceId, newStartDate, oncomplete, onCancel, onerror);
                  			};
							console.log('Retrying quick assign for ' + assignmentId);

                  			//retry save in half a second
                  			window.setTimeout(retry, 500);

                		} else {
                			oncomplete(assignmentId);
                  		}
		         	}
		         	else if (event.type === 'exception')
		         	{
		             	onerror(event.message);
		         	}
		         	else
		         	{
		             	onerror(event.message);
		         	}
		         },
		         {escape: false, timeout: 60000});
  		}

