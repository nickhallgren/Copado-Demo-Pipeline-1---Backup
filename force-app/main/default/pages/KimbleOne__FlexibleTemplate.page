<apex:page controller="KimbleOne.FlexibleTemplateController" showHeader="false" applyHtmlTag="false" language="{!IF($CurrentPage.parameters.languageCode!='',$CurrentPage.parameters.languageCode,LanguageCode)}" renderAs="{!IF($CurrentPage.parameters.renderAs=='html','html','pdf')}">
<html>
	<head>
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__PdfHeaderFooterStyle, HeaderFooterStyleSheetName)}"/>
		<apex:stylesheet value="{!$Resource.KimbleOne__InvoiceCreditNoteStyle}" />
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__FlexibleTemplateStyle, 'FlexibleTemplateStyle.css')}"/>
		
		<apex:outputPanel layout="none" rendered="{!CustomStyleSheet}">
			<apex:stylesheet value="{!JSENCODE(CustomStyleSheetResourcePath)}" />
		</apex:outputPanel>
		
		<apex:variable var="DraftCSS" value="Draft" rendered="{!$CurrentPage.parameters.IsDraft = 'true'}">
		    <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__Watermark,'watermark.css')}" />
		</apex:variable>
	</head>
	<body>
		<apex:outputText value="{!ErrorMessage}" rendered="{!!ISBLANK(ErrorMessage)}"/>
		<apex:dynamicComponent componentValue="{!Content}"/>
	</body>
</html>
</apex:page>