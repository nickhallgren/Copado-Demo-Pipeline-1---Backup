<apex:page standardController="KimbleOne__Assumption__c" extensions="KimbleOne.AssumptionEditController"  sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="Issues.html" MenuContextType="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), 'DeliveryGroup','Proposal')}" MenuContextId="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), KimbleOne__Assumption__c.KimbleOne__DeliveryGroup__c,KimbleOne__Assumption__c.KimbleOne__Proposal__c)}" MenuContextName="{!IF(ISBLANK(KimbleOne__Assumption__c.KimbleOne__Proposal__c), KimbleOne__Assumption__c.DeliveryGroup__r.Name ,KimbleOne__Assumption__c.Proposal__r.Name)}"/>
</apex:define>  
   
<apex:define name="Content">

	<!-- Hidden fields for use in controller -->
	<apex:outputField value="{!KimbleOne__Assumption__c.KimbleOne__Proposal__c}" rendered="false"/>
	<apex:outputField value="{!KimbleOne__Assumption__c.KimbleOne__DeliveryGroup__c}" rendered="false"/>
	
	<apex:pageMessages escape="false"/>

	<chatter:feedWithFollowers entityId="{!KimbleOne__Assumption__c.Id}" rendered="{!ShowChatter}"/>
	
    <apex:form >
		<apex:outputPanel id="AssumptionEditPanel" >
				
		    	<apex:pageBlock id="AssumptionEditBlock" title="{!$ObjectType.KimbleOne__Assumption__c.Label}">    
           			<div id="AssumptionEditErrors">
           				<apex:pageMessages escape="false"/>
           			</div>

					<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!save}" value="{!$Label.kimbleone__save}" oncomplete="getReferenceData();SetupDatePicker();" reRender="AssumptionEditPanel"/>
						<apex:commandButton value="{!$Label.kimbleone__cancel}" oncomplete="window.history.back();" reRender=""/>
					</apex:pageBlockButtons>
					
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="2"> 
             		
             			<!--Adding check to see if assumption reference is editable-->
						<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!AllowReferenceEdit}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Assumption__c.Fields.Name.Label}" />
             				<apex:inputfield id="AssumptionNameInput" value="{!KimbleOne__Assumption__c.Name}"/>
           				</apex:pageBlockSectionItem>
             	
             			<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!!AllowReferenceEdit && ISBLANK(KimbleOne__Assumption__c.Id)}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Assumption__c.Fields.Name.Label}" />
             				<apex:outputText value="{!$Label.kimbleone__autogeneratedlabel}" />
           				</apex:pageBlockSectionItem>

             			<apex:pageBlockSectionItem dataStyle="width:30%" labelStyle="width:10%" rendered="{!!AllowReferenceEdit && !ISBLANK(KimbleOne__Assumption__c.Id)}">
             				<apex:outputLabel value="{!$ObjectType.KimbleOne__Assumption__c.Fields.Name.Label}" />
             				<apex:outputText id="RiskNameInput" value="{!KimbleOne__Assumption__c.Name}" />
           				</apex:pageBlockSectionItem>

						<apex:pageBlockSectionItem >              
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Assumption__c.Fields.KimbleOne__Impact__c.Label}"/>
							<apex:selectList value="{!KimbleOne__Assumption__c.KimbleOne__Impact__c}" size="1">
								<apex:selectOptions value="{!TheImpactTypes}" />
							</apex:selectList>
						</apex:pageBlockSectionItem>
						
						<apex:inputfield value="{!KimbleOne__Assumption__c.KimbleOne__IsValid__c}" /> 
						
						<apex:inputField value="{!KimbleOne__Assumption__c.KimbleOne__ImpactDescription__c}" />
					</apex:pageBlockSection>
					
					<apex:pageblockSection collapsible="false" showheader="false"  columns="1">
						<apex:inputfield value="{!KimbleOne__Assumption__c.KimbleOne__Summary__c}" style="width:500px;"/>
						<apex:inputfield value="{!KimbleOne__Assumption__c.KimbleOne__Description__c}" style="width:500px;"/>
					</apex:pageBlockSection>

					<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
						<apex:repeat value="{!$ObjectType.KimbleOne__Assumption__c.FieldSets.KimbleOne__AssumptionDetails}" var="f">
		     				<apex:inputField rendered="{!!CONTAINS(f.FieldPath,'.')}" value="{!KimbleOne__Assumption__c[f]}" required="{!f.Required}" styleClass="{!IF(AND($ObjectType.KimbleOne__Assumption__c.Fields[f].type == 'date',$ObjectType.KimbleOne__Assumption__c.Fields[f].updateable),'kimbleDatePicker','')}" />
							<apex:outputField rendered="{!CONTAINS(f.FieldPath,'.')}" value="{!KimbleOne__Assumption__c[f]}"/>
   						</apex:repeat>
		            </apex:pageBlockSection>						

		    	</apex:pageBlock>
		</apex:outputPanel>
    
    </apex:form>
	<script>
		jQuery(window).load(function(){
			initialiseItems();
		});
		function initialiseItems()
		{
		    SetupDatePicker();
  		}
		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}
	</script>
    </apex:define>

    </apex:composition>

</apex:page>