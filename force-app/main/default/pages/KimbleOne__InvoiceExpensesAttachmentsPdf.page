<apex:page standardcontroller="KimbleOne__Invoice__c" extensions="KimbleOne.InvoiceExpensesAttachmentsPdfController" showHeader="false" sidebar="false" renderas="pdf">
	
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__PdfHeaderFooterStyle, 'PdfHeaderFooterStyle-Legacy.css')}"/>
	<apex:stylesheet value="{!$Resource.KimbleOne__InvoiceCreditNoteStyle}" />
	
	<c:PdfHeaderFooter type="header" position="right" rendered="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowLogo__c}">
		<div>					
			<apex:image value="{!documentUrl}" styleClass="image" height="{!$Label.kimbleone__invoiceprintt1imageheight}" width="{!$Label.kimbleone__invoiceprintt1imagewidth}"></apex:image>
		</div>
	</c:PdfHeaderFooter>

	<c:PdfHeaderFooter type="header" position="left" textStyleClass="title">
		<div>					
			<apex:outputText escape="false" value="{!KimbleOne__Invoice__c.KimbleOne__Reference__c}"></apex:outputText>
		</div>
	</c:PdfHeaderFooter>

	<!-- Following two lines ensure that the header is not repeated on each subsequent page -->
	<c:PdfHeaderFooter type="header" position="left" textStyleClass="title">
	</c:PdfHeaderFooter>
	<c:PdfHeaderFooter type="header" position="right" textStyleClass="title">
	</c:PdfHeaderFooter>

	<c:PdfHeaderFooter type="footer" position="left" textStyleClass="textLeft" rendered="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowFooter__c}">{!JSENCODE(KimbleOne__Invoice__c.BusinessUnitTradingEntity__r.KimbleOne__InvoiceFooter__c)}</c:PdfHeaderFooter>
	<c:PdfHeaderFooter type="footer" position="right" textStyleClass="textRight" rendered="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowPageNumbers__c}" showPageNumbers="true"/>
	
	<apex:repeat value="{!ResourcesWithExpenseAttachments}" var="resource">
	<div>
		<span class="boldLabel"><apex:outputText value="{!resource.Name}"/></span>
	</div>
		<apex:repeat value="{!ResourcesAndAttachments[resource.Id]}" var="attachment">
			<div>		
				<apex:image width="75%" value="/servlet/servlet.FileDownload?file={!attachment.Id}" ></apex:image>
			</div>
		</apex:repeat>
	</apex:repeat>
</apex:page>