<apex:page standardController="KimbleOne__ActivityAssignmentClass__c" extensions="KimbleOne.ActivityAssignmentClassHomeController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">
	 
<apex:define name="Menu">
	<c:Menu DefaultHelpPage="ManagingAssignments.html" MenuContextName="{!KimbleOne__ActivityAssignmentClass__c.Name}"/>
</apex:define>
	
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Page.KimbleOne__GanttViewCss)}"/>
	<apex:form id="TheForm">
		<style>
		td.dataCol.gantt-demo {
			background-color: black;
			color:white;
			border-radius: 2px;
		}
		.class-container {
			width: 100%;
			display: table-cell;
		}
		.page-container {
			display: table-row;
		}
		.nav-container {
			width: 240px !important;
			display: inline-block;
			vertical-align: top;
			border-radius: 4px;
			background-color: #f8f8f8;
			border: 1px solid #ececec;
			margin-right: 2px;
		}
		.title-container {
			padding: 10px 12px;
			font-weight: bold;
			font-size: 14px;
			border-bottom: 1px solid #dbdbdb;
		}
		.cls-nav {
			padding: 9px;
			margin: 4px 6px 4px 3px;
			border-radius: 2px;
			position: relative;
		}
		i.this-cls-ind {
			position: absolute;
			right: 9px;
			font-size: 14px;
			top: 9px;
		}
		i.this-cls-ind {
			color: #729BC8;
		}
		.cls-nav.this-cls i.this-cls-ind {
			display: block;
		}
		.cls-nav:not(.this-cls) i.this-cls-ind {
			display: none;
		}
		th.labelCol {
			white-space: nowrap !important;
		}
		</style>
    
    	<apex:outputPanel id="pageErrors">
    		<apex:pageMessages escape="False" />
		</apex:outputPanel>

		<div class="page-container">
			<div class="nav-container">
				<div class="title-container">
					<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignmentClass__c.LabelPlural}"></apex:outputText>
				</div>
				<apex:repeat value="{!AllClasses}" var="cls">
					<div class="cls-nav {!JSENCODE(cls.KimbleOne__StyleClass__c)} {!IF(KimbleOne__ActivityAssignmentClass__c.Id == cls.Id, 'this-cls', '')}" cls-id="{!JSENCODE(cls.Id)}"><apex:outputText value="{!cls.Name}"></apex:outputText><i class="fa fa-circle this-cls-ind"></i></div>
				</apex:repeat>
			</div>
			<div class="class-container">

			<apex:pageBlock title="{!$ObjectType.KimbleOne__ActivityAssignmentClass__c.Label}" >
				<apex:pageBlockButtons location="bottom">
					<apex:commandButton action="{!Save}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__save}" reRender="TheForm"/>
					<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}"/>
				</apex:pageBlockButtons>

				<apex:pageblockSection collapsible="false" showheader="false" columns="2" >
					<apex:inputField value="{!KimbleOne__ActivityAssignmentClass__c.Name}"/>
					<apex:inputField value="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__IncludeInAggregateUtilisationPercentage__c}"/>
					<apex:pageBlockSectionItem dataStyleClass="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__StyleClass__c} gantt-demo">
						<apex:outputLabel value="{!$ObjectType.KimbleOne__ActivityAssignmentClass__c.fields.KimbleOne__StyleClass__c.label}" />
						<apex:inputField id="classStyleClass" value="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__StyleClass__c}" />
					</apex:pageBlockSectionItem>
					<apex:inputField value="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__IncludeInAvailabilityScorePercentage__c}" />
					<apex:outputField value="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__Priority__c}"/>
					<apex:inputField value="{!KimbleOne__ActivityAssignmentClass__c.KimbleOne__IncludeInAutoMatchScorePercentage__c}" />
				</apex:pageblockSection>

			</apex:pageBlock>
			</div>
		</div>


		<script>
		jQuery(document).ready(function() {
			jQuery('td.gantt-demo input').on("keyup", function(e) {
			   jQuery('td.gantt-demo').attr('class', 'dataCol gantt-demo').addClass(jQuery(this).val());
			});
		});
		</script>

	</apex:form>


</apex:define>

</apex:composition>

</apex:page>