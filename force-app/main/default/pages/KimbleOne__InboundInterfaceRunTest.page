<apex:page controller="KimbleOne.InboundInterfaceRunTestController" showHeader="true" sidebar="false" standardStylesheets="true">
<apex:composition template="KimbleOne__SiteMaster">
	<apex:define name="Menu"></apex:define> 

	<apex:define name="Content">
		<style>
		textarea {
			width: 821px;
			height: 89px;
		}
		</style>
		<apex:form id="TheForm">
			<apex:pageBlock title="{!$ObjectType.KimbleOne__InterfaceRun__c.Label}">
					<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!Go}" value="Go" rerender="TheForm" styleclass="DisableButtonWhileBusy"/>
						<apex:commandButton action="{!Clear}" value="Clear" rerender="TheForm" styleclass="DisableButtonWhileBusy"/>
					</apex:pageBlockButtons>
						<apex:pageBlockSection columns="1" collapsible="false">
							<apex:pageBlockSectionItem >
							<apex:outputLabel value="{!$Label.kimbleone__typelabel}" />
							<apex:inputText value="{!InterfaceTypeName}" />
						</apex:pageBlockSectionItem>
						
						<apex:pageBlockSectionItem >
							<apex:outputLabel value="Request" />
							<apex:inputTextArea value="{!BodyText}"/>
						</apex:pageBlockSectionItem>
						
						<apex:pageBlockSectionItem >
							<apex:outputLabel value="Response" />
							<apex:inputTextArea value="{!ResponseText}"/>
						</apex:pageBlockSectionItem>
						
					</apex:pageBlockSection>
				</apex:pageBlock>
		</apex:form>
		</apex:define>
	</apex:composition>

</apex:page>