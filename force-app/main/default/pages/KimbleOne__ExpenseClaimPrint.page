<apex:page standardController="KimbleOne__ExpenseClaim__c" extensions="KimbleOne.ExpenseClaimPrintController"
	showheader="false" sidebar="false"
	 renderAs="{!IF($CurrentPage.parameters.renderAs=='html','html','pdf')}">
<html>
	<head>
		<style>
			<apex:outputPanel layout="none" rendered="{!ShowStartLocation || ShowEndLocation}">@page{size: landscape;}</apex:outputPanel>
			body { font-size:10.0pt;font-family:"Sans-Serif"}
			.pdfTable{font-size:8.0pt;}
			.lCol {text-align:left;width:18%;vertical-align:top;}
			.dCol {font-weight: bold;width:30%;vertical-align:top;}
			.inBCol{width:4%}
			.kimbleCurrencyCode { margin-right: 3px; }
			table.sigTable tr td { height: 30px }
		</style>
		
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__PdfHeaderFooterStyle, 'PdfHeaderFooterStyle-A4.css')}"/>
		<apex:stylesheet value="{!$Resource.KimbleOne__InvoiceCreditNoteStyle}" />
	
	</head> 
  	<apex:variable var="clientApprovalMode" value="{!IF($CurrentPage.parameters.forClientApproval=='1','true','false')}"/>

<!-- 	This output is switched on the basis of the forClientApproval page param so that we could patch in a new -->
<!-- 	document that seeks client approval for expense items which is in a different format to the standard document -->
<!-- 	but shares much of the same data content -->

<!-- output panels are used below to basically separate this page into two pages -->
	  	
  	<apex:pageBlock >		
	
	</apex:pageBlock>
	
	<!-- 	Employee focused output -->
	<apex:outputPanel layout="none" rendered="{!clientApprovalMode=='false'}">	
			<apex:pageBlock >

				<table style="width:100%">
					<tr>
						<td class="lCol"><apex:outputlabel value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Reference__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.KimbleOne__Reference__c}" /></td>
						<td class="inBCol"></td>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ApprovalStatus__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.KimbleOne__ApprovalStatus__c}" /></td>
					</tr>
					
					<tr>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Resource__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.Resource__r.Name}" /></td>
						<td></td>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Approver1User__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.Approver1User__r.Name}" /></td>
					</tr>
					
					<tr>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.Name.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.ResourcedActivity__r.DeliveryGroup__r.Name}" /></td>
						<td></td>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Approver2User__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.Approver2User__r.Name}" /></td>
					</tr>
					
					<tr>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ResourcedActivity__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.ResourcedActivity__r.Name}" /></td>
						<td></td>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ApprovalComments__c.Label}" />	</td>
						<td class="dCol"><apex:outputText value="{!TheClaim.KimbleOne__ApprovalComments__c}" /></td>
					</tr>
					<tr>
						<td colspan="3"/>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Status__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.Status__r.Name}" /></td>
					</tr>
					<tr>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__TotalExpenseRevenue__c.Label}" /></td>
						<td class="dCol"><apex:outputField value="{!TheClaim.KimbleOne__TotalExpenseRevenue__c}" /></td>
						<td/>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__InvoicingCurrencyTotalExpenseRevenue__c.Label}" /></td>
						<td class="dCol">
							<apex:outputPanel layout="none">
									<apex:outputText value="{!TheClaim.KimbleOne__InvoicingCurrencyIsoCode__c} " styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!TheClaim.KimbleOne__InvoicingCurrencyTotalExpenseRevenue__c}" />
								</apex:outputPanel>
						</td>
					</tr>
					<tr>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__TotalExpenseCost__c.Label}" /></td>
						<td class="dCol"><apex:outputField value="{!TheClaim.KimbleOne__TotalExpenseCost__c}" /></td>
						<td/>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c.Label}" /></td>
						<td class="dCol">
							<apex:outputPanel layout="none">
									<apex:outputText value="{!TheClaim.KimbleOne__ReimbursementCurrencyIsoCode__c} " styleclass="kimbleCurrencyCode" />
									<apex:outputField value="{!TheClaim.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c}" />
								</apex:outputPanel>
						</td>
					</tr>
					<tr>
						<td colspan="3"/>
						<td class="lCol"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ResourcePayment__c.Label}" /></td>
						<td class="dCol"><apex:outputText value="{!TheClaim.KimbleOne__ResourcePayment__c}" /></td>
					</tr>
					
				</table>
					
					<br/>
					
					<apex:pageBlockTable styleclass="pdfTable" value="{!ExpenseClaimExpenseItems}"
							var="item"  cellpadding="2" border="1">
							<apex:column value="{!item.Timeperiod__r.KimbleOne__StartDate__c}" headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
							<apex:column value="{!item.KimbleOne__Reference__c}" headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__Reference__c.Label}" />
							<apex:column headerValue="{!$Label.kimbleone__description}">
								<apex:outputText value="{!item.ActivityExpenseCategory__r.Name} {!IF(item.ActivityExpenseCategory__r.ExpenseCategory__r.Name!=item.ActivityExpenseCategory__r.Name,'('+item.ActivityExpenseCategory__r.ExpenseCategory__r.Name+')','')} "/>
								<br/>
								<apex:outputText value="{!item.KimbleOne__Notes__c}"/>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExpenseUnits__c.Label}">
								<apex:outputText value="{!item.KimbleOne__ExpenseUnits__c} {!item.ActivityExpenseCategory__r.ExpenseCategory__r.UnitType__r.Name}" rendered="{!item.ActivityExpenseCategory__r.ExpenseCategory__r.UnitType__r.Name!=null}" />
							</apex:column>

							<apex:column headerValue="{!$Label.kimbleone__incurredamount}">
								<apex:outputText value="{!item.KimbleOne__IncurredCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
								<apex:outputField value="{!item.KimbleOne__IncurredCurrencyGrossAmount__c}"/>
							</apex:column>
							
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExchangeRateConversionFactor__c.Label}">
								<apex:outputField value="{!item.KimbleOne__ExchangeRateConversionFactor__c}"/>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExpenseGrossAmount__c.Label}">
								<apex:outputField value="{!item.KimbleOne__ExpenseGrossAmount__c}"/>
								<apex:facet name="footer">
									<apex:outputPanel layout="none">
										<apex:outputField value="{!TotalIncurredGrossAmount.KimbleOne__InputCurrency__c}"/>
									</apex:outputPanel>
								</apex:facet>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExpenseNetAmount__c.Label}">
								<apex:outputField value="{!item.KimbleOne__ExpenseNetAmount__c}"/>
								<apex:facet name="footer">
									<apex:outputPanel layout="none">
										<apex:outputField value="{!TotalExpenseNetAmount.KimbleOne__InputCurrency__c}"/>
									</apex:outputPanel>
								</apex:facet>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__ExpenseTaxAmount__c.Label}">
								<apex:outputField value="{!item.KimbleOne__ExpenseTaxAmount__c}"/>
								<apex:facet name="footer">
									<apex:outputPanel layout="none">
										<apex:outputField value="{!TotalExpenseTaxAmount.KimbleOne__InputCurrency__c}"/>
									</apex:outputPanel>
								</apex:facet>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__Attendees__c.Label}">
								<apex:outputField value="{!item.KimbleOne__Attendees__c}"/>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__StartLocation__c.Label}" rendered="{!ShowStartLocation}">
								<apex:outputField value="{!item.KimbleOne__StartLocation__c}"/>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__EndLocation__c.Label}" rendered="{!ShowEndLocation}">
								<apex:outputField value="{!item.KimbleOne__EndLocation__c}"/>
							</apex:column>
							<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IsReceipted__c.Label}">
								<apex:outputField value="{!item.KimbleOne__IsReceipted__c}"/>
							</apex:column>

						</apex:pageBlockTable>
				</apex:pageBlock>
				
				<br/>
				
				<apex:relatedList list="ProcessSteps"></apex:relatedList>		
		</apex:outputPanel>

		<!-- Client Approval focused output -->
		<apex:outputPanel layout="none" rendered="{!clientApprovalMode=='true'}">
			<c:PdfHeaderFooter type="header" position="left">
	    		<apex:pageBlock >
					<table style="width:250px">
						<tr>
							<td class="boldLabel"><apex:outputlabel value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Reference__c.Label}:" /></td>
							<td class=""><apex:outputText value="{!TheClaim.KimbleOne__Reference__c}"/></td>
						</tr>
						<tr>
							<td class="boldLabel"><apex:outputText value="{!$ObjectType.KimbleOne__Resource__c.Fields.Name.Label}:" /></td>
							<td class=""><apex:outputText value="{!TheClaim.Resource__r.Name}" /></td>
						</tr>
					</table>
				</apex:pageBlock>
			</c:PdfHeaderFooter>			
			<c:PdfHeaderFooter type="header" position="right">
	    		<div>                   
	        		<apex:image value="{!documentUrl}" styleClass="image" height="{!$Label.kimbleone__invoiceprintt1imageheight}" width="{!$Label.kimbleone__invoiceprintt1imagewidth}"></apex:image>
	    		</div>
			</c:PdfHeaderFooter>			
			<c:PdfHeaderFooter type="footer" position="right" textStyleClass="textRight"  showPageNumbers="true"/>
			
			<apex:pageBlock >
				<table style="width:50%">
					<tr>
						<td class="boldLabel"><apex:outputText value="{!$ObjectType.Account.Fields.Name.Label}:" /></td>
						<td class=""><apex:outputText value="{!TheClaim.ResourcedActivity__r.DeliveryGroup__r.Account__r.Name}" /></td>
					</tr>
					<tr>
						<td class="boldLabel"><apex:outputText value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.Name.Label}:" /></td>
						<td class=""><apex:outputText value="{!TheClaim.ResourcedActivity__r.DeliveryGroup__r.Name}" /></td>
					</tr>
					<tr>
						<td class="boldLabel"><apex:outputText value="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ResourcedActivity__c.Label}:" /></td>
						<td class=""><apex:outputText value="{!TheClaim.ResourcedActivity__r.Name}" /></td>
					</tr>
				</table>
			</apex:pageBlock>
			<br/>

			<apex:pageBlock >

	    	<table style="border: none" width="100%">			
			    <apex:repeat value="{!ExpenseItemsDateOrderedList}" var="itemDate" >
		    		<tr>
		    			<td width="22%" style="vertical-align:top; padding-top:4px;">
							<apex:outputlabel styleClass="boldLabel" value="{!$Label.kimbleone__datelabel}: " /><apex:outputField value="{!itemDate.KimbleOne__InputDate__c}" />
		    			</td>
		    			<td>
						    <table border="1" class="" cellspacing="0" width="100%">
								<tr>
									<td class="boldLabel" width="30%"><apex:outputlabel value="{!$Label.kimbleone__description}" /></td>
									<td class="boldLabel" style="text-align: right;" width="20%"><apex:outputlabel value="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IncurredCurrencyGrossAmount__c.Label}" /> </td>
									<td class="boldLabel" style="text-align: right;" width="20%"><apex:outputlabel value="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__InvoicingCurrencyExpenseRevenue__c.Label}" /> </td>
								</tr>
							    <apex:repeat value="{!ExpenseItemsByDateMap[itemDate.KimbleOne__InputDate__c]}" var="itm" >
									<tr>
										<td>
											<apex:outputText value="{!itm.ActivityExpenseCategory__r.Name} {!IF(itm.ActivityExpenseCategory__r.ExpenseCategory__r.Name!=itm.ActivityExpenseCategory__r.Name,'('+itm.ActivityExpenseCategory__r.ExpenseCategory__r.Name+')','')} "/>
											<br/>
											<apex:outputText value="{!itm.Notes__c}"/>
										</td>
										<td style="text-align: right;">
											<apex:outputText value="{!itm.IncurredCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" rendered="{! !ISBLANK(itm.IncurredCurrencyGrossAmount__c) }" />
											<apex:outputField value="{!itm.IncurredCurrencyGrossAmount__c}"/>
										</td>
										<td style="text-align: right;">
											<apex:outputText value="{!itm.InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
											<apex:outputField value="{!itm.InvoicingCurrencyExpenseRevenue__c}"/>
										</td>
									</tr>
								</apex:repeat>
								<apex:variable value="{!ExpenseInvoicingCcyRevenueTotalMap[itemDate.KimbleOne__InputDate__c]}" var="groupExpenseRevenueTotal" />
								<tr>
									<td class="boldLabel" style="text-align: right;">{!$Label.Total}:&nbsp;</td>
									<td class="boldLabel" style="text-align: right;"></td>
									<td class="boldLabel" style="text-align: right;">
										<apex:outputText value="{!TheClaim.KimbleOne__InvoicingCurrencyIsoCode__c} " styleclass="kimbleCurrencyCode" />
										<apex:outputField value="{!groupExpenseRevenueTotal.InputDecimal__c}"/>
									</td>
								</tr>
							</table>
		    			</td>
		    		</tr>
					<!-- empty row needed to separate different expense item groups -->
		    		<tr>
			    		<td>&nbsp;</td>
			    		<td>&nbsp;</td>
		    		</tr>
			    </apex:repeat>
		    	<!-- overall total row -->
	    		<tr>
	    			<td>
	    			</td>
	    			<td>
	    				<table border="1" class="" cellspacing="0" width="100%">
							<tr>
								<td class="boldLabel" width="30%" style="text-align: right;">{!$Label.OverallTotalHeading}:&nbsp;</td>
								<td class="boldLabel" width="20%" style="text-align: right;">
									<apex:outputText value="{!TheClaim.KimbleOne__InvoicingCurrencyIsoCode__c} " styleclass="kimbleCurrencyCode" />
									<apex:outputField styleClass="boldLabel" value="{!TotalExpenseInvoicingCcyRevenueAmount.KimbleOne__InputDecimal__c}"/>
								</td>
							</tr>
						</table>
	    			</td>		    		
	    		</tr>
		    </table>
			<br/>				
			</apex:pageBlock>
			
			<br/>
			<br/>
			<apex:pageBlock >
				<table border="1" class="sigTable" cellspacing="0" width="100%">
					<tr>
						<td class="boldLabel" width="50%">{!$ObjectType.Resource__c.Label}</td>
						<td class="boldLabel" width="50%">{!$Label.ClientLabel}</td>
					</tr>
					<tr>
						<td style="height: 50px">
							{!$Label.SignedLabel}:
						</td>
						<td style="height: 50px">
							{!$Label.SignedLabel}:
						</td>
					</tr>
					<tr>
						<td>
							{!$Label.kimbleone__datelabel}:
						</td>
						<td>
							{!$Label.kimbleone__datelabel}:
						</td>
					</tr>
					<tr>
						<td>
							{!$Label.Name}:
						</td>
						<td>
							{!$Label.Name}:
						</td>
					</tr>
				</table>
			</apex:pageBlock>		
		</apex:outputPanel>
		
		</html>
</apex:page>