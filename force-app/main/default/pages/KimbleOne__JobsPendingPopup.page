<apex:page controller="KimbleOne.JobsPendingController" sidebar="false" showHeader="false" contentType="text/css">
<style>
		.job
		{
			padding-left: 20px;
			background-repeat: no-repeat;
			padding-right: 12px;
			height: 18px;
			display: block;
			line-height: 18px;
		}
		.Pending 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'pending16.gif')}');
		}
		.Processing 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'running16.gif')}');
		}
		.Completed 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'completed16.gif')}');
		}
		.Failed 
		{
			background-image: url('{!URLFOR($Resource.JobImages, 'failed16.gif')}');
		}
		
	</style>
	<script>

	var completed;
	var failures = false;
	
	var JobSuccess = function(obj)
	{
		this.target.text(obj[0].value('Status__r').value('Enum__c'));
		this.target.removeClass('Processing');
		this.target.addClass(obj[0].value('Status__r').value('Enum__c'));
		
		if (obj[0].value('Status__r').value('Enum__c') == 'Failed')
		{
			this.target.attr('title', obj[0].value('Message__c'));
			failures = true;
		}
		
		if ($('.job.Pending').length == 0 && completed != null)
		{
			if (failures)
				$('#okButton').show();
			else
				completed();
		}
		else
			RunAllJobs(completed);
	}
	
	function RunAllJobs(oncomplete)
	{
		completed = oncomplete;
		
		if ($('.job.Pending').length == 0)
		{
			completed();
			return;
		}
		
		$('div#title').show();
		$('div#pendingJobsBody').show();
		
		var obj = $('.job.Pending:first');
		
		$(obj).removeClass('Pending');
   		$(obj).addClass('Processing');
   		RunJob($(obj).attr('id'), $(obj), JobSuccess);
		
	}
	
	function okButtonClick()
	{
		completed();
	}
 
</script>
<apex:pageBlock title="{!$Label.kimbleone__savinglabel}">
	<apex:pageblockbuttons location="bottom">
		<input id="okButton" type="button" class="btn" value="{!$Label.Ok}" onclick="okButtonClick()" style="display:none"/>
	</apex:pageblockbuttons>
	<div id="pendingJobsBody" style="overflow:auto;min-height:100px">  
	<apex:pageblockSection collapsible="false" showheader="false" columns="1" >
        <apex:pageBlockTable value="{!PendingJobs}" var="job">
	   	<apex:column headervalue="{!$Label.kimbleone__processlabel}" value="{!job.KimbleOne__DisplayName__c}"/>
	   	
	   	<apex:column headervalue="{!$Label.kimbleone__statuslabel}">
	   		<span id="{!JSENCODE(job.id)}" class="job {!JSENCODE(job.Status__r.Enum__c)}"><apex:outputText value="{!job.Status__r.Name}"/></span>
	   	</apex:column>
	   </apex:pageBlockTable>
     
	</apex:pageBlockSection>
	</div>
	 
</apex:pageBlock>
</apex:page>