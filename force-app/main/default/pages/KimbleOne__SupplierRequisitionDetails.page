<apex:page standardController="KimbleOne__SupplierRequisition__c" extensions="KimbleOne.SupplierRequisitionDetailsController,KimbleOne.SecurityController,KimbleOne.FilesAndAttachmentsController" showHeader="true" sidebar="false" tabStyle="KimbleOne__SupplierRequisition__c" >

<apex:composition template="KimbleOne__SiteMaster">
	 
<apex:define name="Menu">

	<c:Menu MenuContextType="SupplierRequisition" MenuContextId="{!KimbleOne__SupplierRequisition__c.Id}" MenuContextName="{!IF(ISBLANK(KimbleOne__SupplierRequisition__c.KimbleOne__SupplierPurchaseOrder__c),KimbleOne__SupplierRequisition__c.Name,KimbleOne__SupplierRequisition__c.SupplierPurchaseOrder__r.Name)}"/>

</apex:define>
        	
   <apex:define name="Content">
		<style>
		.contact-table {
			display: block;
			min-width: 200px;
			max-height: 300px;
			overflow-y: auto;
		}
		.contacts-header {
			display: none;
		}
		h1.contacts-title {
			width: 100%;
			margin: 5px 0 5px 0;
			text-align: center;
			display: block;
		}
		.add-rem-container {
			max-width:30px;
			padding-top:25px;
		}
		.add-rem-container input {
			width: 100%;
			margin-top: 5px;
		}
		</style>
  

	<chatter:feedWithFollowers entityId="{!KimbleOne__SupplierRequisition__c.Id}"/>

	<apex:outputPanel id="TravelReq">

		<apex:form id="TheForm">
		<div id="pageErrors">
    		<apex:pageMessages escape="False" />
		</div>
		<apex:pageBlock title="{!$ObjectType.KimbleOne__SupplierRequisition__c.Label}">
	
			<apex:pageBlockButtons location="top">
				<apex:commandButton action="{!SubmitForApproval}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__submitforapprovalbutton}" reRender="TheForm" rendered="{!CanSubmitForApproval && $ObjectType.KimbleOne__SupplierRequisition__c.updateable}" />
				<apex:commandButton action="{!Cancel}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__cancelrequisition}" reRender="TheForm" rendered="{!CanCancel && $ObjectType.KimbleOne__SupplierRequisition__c.updateable}" /> 
				<apex:commandButton id="dispatchSupplierPOBtn" action="{!Dispatch}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__dispatch}" rerender="TheForm" rendered="{!KimbleOne__SupplierRequisition__c.Status__r.KimbleOne__Enum__c = 'Approved' && $ObjectType.KimbleOne__SupplierRequisition__c.updateable}"/> <!-- && HasPermission['DispatchSupplierPO']}"/>  -->
    			<apex:outputPanel layout="none" rendered="{!KimbleOne__SupplierRequisition__c.Status__r.KimbleOne__Enum__c = 'Dispatched'}">
    				<input id="sendEmailBtn" class="btn" type="button" onclick="initialiseModalBoxy('#sendEmailPopup', '{!JSENCODE($Label.EmailSupplierPOLabel)}', jQuery('form[id$=\'TheForm\']'));initialiseEmail();" value="{!$Label.EmailSupplierPOLabel}" />
    			</apex:outputPanel>
    			<apex:commandButton action="{!Close}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__closerequisition}" reRender="TheForm" rendered="{!CanClose && $ObjectType.KimbleOne__SupplierRequisition__c.updateable}" /> 
    		</apex:pageBlockButtons>	
				           		
			<apex:pageBlockSection collapsible="false" title="{!$ObjectType.KimbleOne__SupplierRequisition__c.Label}" columns="2">
    			
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__Resource__c}"/>
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__SupplierAccount__c}"/>
    			
    			<apex:outputField id="resourcedActivity" value="{!KimbleOne__SupplierRequisition__c.KimbleOne__ResourcedActivity__c}" rendered="{!ISBLANK(KimbleOne__SupplierRequisition__c.KimbleOne__DeliveryGroup__c)}"/>
           		<apex:outputField id="deliveryGroup" value="{!KimbleOne__SupplierRequisition__c.KimbleOne__DeliveryGroup__c}" rendered="{!!ISBLANK(KimbleOne__SupplierRequisition__c.KimbleOne__DeliveryGroup__c)}"/>
           		<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__SupplierContact__c}"/>
    			
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__RequisitionDate__c}"/>
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__ExpectedReceiptDate__c}"/>
    			
           		<apex:pageBlockSectionItem >
           			<apex:outputLabel value="{!$ObjectType.KimbleOne__SupplierRequisition__c.Fields.KimbleOne__Status__c.Label}"/>
           			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.Status__r.Name}"/>
    			</apex:pageBlockSectionItem>
           		<apex:outputField value="{!KimbleOne__SupplierRequisition__c.SupplierRequisitionVersion__r.KimbleOne__NetAmount__c}"/>
    			
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.SupplierRequisitionType__r.Name}"/>
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.SupplierPurchaseOrder__r.KimbleOne__ExpiryDate__c}"/>
           		
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__ShippingAddress__c}"/>
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__BusinessUnitTradingEntity__c}"/>
    			
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__Notes__c}"/>
    			<apex:outputField value="{!KimbleOne__SupplierRequisition__c.KimbleOne__SupplierNotes__c}"/>
    			
			</apex:pageBlockSection>
			
			<apex:pageBlockSection >
	
				<apex:repeat value="{!$ObjectType.KimbleOne__SupplierRequisition__c.FieldSets.KimbleOne__SupplierRequisitionDetails}" var="f" >
	     			<apex:outputField value="{!KimbleOne__SupplierRequisition__c[f]}" />
	   			</apex:repeat>

			</apex:pageBlockSection>

			<apex:actionFunction action="{!InitialiseEmail}" name="initialiseEmail" rerender="sendEmailPanel" oncomplete="showModalBoxy()"></apex:actionFunction>
			
			<div id="sendEmailPopup" style="display:none">
				<apex:outputPanel id="sendEmailPanel">
				<apex:pageBlock >
						<div id="sendEmailErrors"><apex:pageMessages escape="false"/></div>
						<apex:pageBlockButtons location="bottom">
							<apex:commandButton value="{!$Label.kimbleone__ok}" styleclass="DisableButtonWhileBusy" action="{!SendEmail}" oncomplete="hideModalBoxyWithErrorCheck('#sendEmailErrors')" rerender="sendEmailPanel" />
							<input class="btn DisableButtonWhileBusy" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
						</apex:pageBlockButtons>
						
						<apex:pageBlockSection columns="3">
							
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$Label.kimbleone__emailtemplatelabel}"></apex:outputLabel>
								<apex:selectList id="emailTemplate" value="{!TheSelectedDocTemplateId}" size="1">
									<apex:selectOptions value="{!TheEmailTemplates}" />
								</apex:selectList>
							</apex:pageBlockSectionItem>
							
							<apex:pageblocksectionitem />
							
							<apex:pageblocksectionitem />
							
							<apex:pageblocksectionitem >
							<apex:outputPanel layout="block">
							<h1 class="contacts-title">{!$Label.kimbleone__availablecontacts}</h1>
							<apex:outputPanel layout="block" styleClass="contact-table">
							<apex:pageblocktable value="{!TheContactslNotToEmail}" var="contact" headerClass="contacts-header">
								<apex:column ><input type="checkbox" class="add-contact-cb" data-id="{!contact.id}"/></apex:column>
								<apex:column value="{!contact.name}"/>
							</apex:pageblocktable>
							</apex:outputPanel>
							</apex:outputPanel>
							</apex:pageblocksectionitem>
							
							<apex:pageblocksectionitem >
								<apex:outputpanel layout="block" styleClass="add-rem-container">
								<input type="button" class="btn DisableButtonWhileBusy" value=">" onClick="addEmailableContacts();"/>
								<input type="button" class="btn DisableButtonWhileBusy" value="<" onClick="removeEmailableContacts();"/>
								</apex:outputpanel>
							</apex:pageblocksectionitem>
							
							<apex:pageblocksectionitem >
							
							<apex:outputPanel layout="block" styleClass="contact-table">
							<apex:outputPanel layout="block">
							<h1 class="contacts-title">{!$Label.kimbleone__contactstoemail}</h1>
							<apex:pageblocktable value="{!TheContactsToEmail}" var="contact" headerClass="contacts-header">
								<apex:column ><apex:facet name="header"><apex:outputlabel value="{!$Label.kimbleone__selectlabel}"/></apex:facet><input type="checkbox" class="remove-contact-cb" data-id="{!contact.id}"/></apex:column>
								<apex:column value="{!contact.name}"/>
							</apex:pageblocktable>
							</apex:outputPanel>
							</apex:outputPanel>
							</apex:pageblocksectionitem>
							
							<apex:pageblocksectionitem />
							
						</apex:pageBlockSection>
						
					</apex:pageBlock>
			</apex:outputPanel>
			</div>
			
			<apex:actionFunction name="addContactsToEmail" action="{!addContactsToEmail}" rerender="sendEmailPanel">
				<apex:param name="contactIds" value="" />
			</apex:actionFunction>
			
			<apex:actionFunction name="removeContactsToEmail" action="{!removeContactsToEmail}" rerender="sendEmailPanel">
				<apex:param name="contactIds" value="" />
			</apex:actionFunction>
		
		</apex:pageBlock>
		
		</apex:form>
			
	</apex:outputPanel>

		<apex:pageblock >
			
			<apex:repeat value="{!TheSupplierRequisitionVersions}" var="version">
			
			<apex:pageblockSection collapsible="false" columns="1" title="{!$ObjectType.KimbleOne__SupplierRequisitionVersion__c.Label} {!ROUND(version.KimbleOne__VersionNumber__c, 0)}">

				<apex:pageBlockTable value="{!TheSupplierRequisitionLinesMap[version.Id]}" var="SupplierReqLine" id="srl">
					<apex:column value="{!SupplierReqLine.LineNumber__c}" />
					<apex:repeat value="{!$ObjectType.KimbleOne__SupplierRequisitionLine__c.FieldSets.KimbleOne__SupplierRequisitionLineDetails}" var="f">
						<apex:column rendered="{!!CONTAINS(f.FieldPath,'.')}" headerValue="{!f.Label}">
							<apex:outputField value="{!SupplierReqLine[f]}"/>
						</apex:column>
					</apex:repeat>
					<apex:column value="{!SupplierReqLine.Name}" />
					<apex:column headervalue="{!$ObjectType.KimbleOne__SupplierRequisitionLine__c.Fields.KimbleOne__ActivityExpenseCategory__c.Label}" value="{!SupplierReqLine.ActivityExpenseCategory__r.Name}" />
					<apex:column headervalue="{!$ObjectType.KimbleOne__ActivityExpenseCategory__c.Fields.KimbleOne__RebillingRule__c.Label}" value="{!SupplierReqLine.ActivityExpenseCategory__r.RebillingRule__r.Name}" />
					<apex:column value="{!SupplierReqLine.RequisitionedUnits__c}" />
					<apex:column value="{!SupplierReqLine.UnitAmount__c}" />
					<apex:column value="{!SupplierReqLine.NetAmount__c}" />
					<apex:column value="{!SupplierReqLine.ReceivedUnits__c}" />
					<apex:column value="{!SupplierReqLine.InvoicedNetAmount__c}" />
					<apex:column headervalue="{!$ObjectType.KimbleOne__SupplierInvoice__c.LabelPlural}">
						<apex:outputPanel rendered="{!SupplierReqLine.InvoicedNetAmount__c>0}">
							<table class="list" border="0" cellpadding="0" cellspacing="0">
	   				         	<thead>
									<tr class="headerRow">
										<th class="headerRow" width="20%"><h2>{!$ObjectType.SupplierInvoice__c.Fields.Name.Label}</h2></th>
										<th class="headerRow" width="20%"><h2>{!$ObjectType.SupplierInvoice__c.Fields.InvoiceDate__c.Label}</h2></th>
										<th class="headerRow" width="10%"><h2>{!$ObjectType.SupplierInvoiceAllocation__c.Fields.AllocatedAmount__c.Label}</h2></th>
									</tr>
								</thead>
								<tbody>
									<apex:repeat value="{!SupplierReqLine.SupplierInvoiceLineAllocations__r}" var="alloc">							
										<tr class="dataRow">
											<td class="dataCell"><apex:outputField value="{!alloc.SupplierInvoice__c}"/></td>
											<td class="dataCell"><apex:outputField value="{!alloc.SupplierInvoice__r.InvoiceDate__c}"/></td>
											<td class="dataCell"><apex:outputField value="{!alloc.AllocatedAmount__c}"/></td>
										</tr>
									</apex:repeat>
								</tbody>
	            			</table>
						</apex:outputPanel>
					</apex:column>
				</apex:pageBlockTable>
              				
			</apex:pageblockSection>
			
			</apex:repeat>
			
		</apex:pageblock>

   	  	<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
		<apex:relatedList subject="{!KimbleOne__SupplierRequisition__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
		
		<apex:outputPanel layout="none" id="ApprovalHistoryPanel">
		
			<apex:relatedList list="ProcessSteps" ></apex:relatedList>
			
			<script>
				$(document).ready(function()
				{
    				$('input[name="piSubmit"]').remove();
    				$('input[name="piRemove"]').remove();
   				});
   				
				var addEmailableContacts = function() {
					var idString = '';
					jQuery('.add-contact-cb:checked').each(function(i, el) {
						idString += ',' + $(el).attr('data-id');
					});
					addContactsToEmail(idString);
				}
				
				var removeEmailableContacts = function() {
					var idString = '';
					jQuery('.remove-contact-cb:checked').each(function(i, el) {
						idString += ',' + $(el).attr('data-id');
					});
					removeContactsToEmail(idString);
				}
			</script>
			
		</apex:outputPanel>
	<script>
		jQuery(document).ready(function() {
			if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
		});
	</script>	
</apex:define>

</apex:composition>

</apex:page>