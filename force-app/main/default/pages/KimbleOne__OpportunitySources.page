<apex:page controller="KimbleOne.OpportunitySourcesController">

<apex:composition template="KimbleOne__SiteMaster">
 
<apex:define name="Menu"> 


	<c:Menu />	

</apex:define>
    
<apex:define name="Content">
    
	<apex:pageMessages escape="false"/>

	<apex:outputPanel id="OpportunitySourcesPanel" >

       	<apex:form >              	
			<apex:pageBlock id="OpportunitySourcesDetailPanel" title="{!$ObjectType.KimbleOne__OpportunitySource__c.LabelPlural}">

           		<apex:pageBlockButtons location="top">
					<input type="button" class="btn" value="{!$Label.New} {!$ObjectType.OpportunitySource__c.Label}" 
					onclick="initialiseModalBoxy('#OpportunitySourcesEditPopup', '{!JSENCODE($Label.New)} {!$ObjectType.OpportunitySource__c.Label}');newOpportunitySource();" 
					/>
				</apex:pageBlockButtons>
					 
				<apex:pageBlockTable value="{!OpportunitySourcesList}" var="anOpSo">
           			<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
	           			<apex:outputLink value="#" onclick="initialiseModalBoxy('#OpportunitySourcesEditPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__OpportunitySource__c.label}');editOpportunitySource('{!JSINHTMLENCODE(anOpSo.id)}')">{!$Label.kimbleone__edit}</apex:outputLink>
&nbsp; | &nbsp;
						<apex:commandLink onclick="var d = confirmDelete();if(!d) return;" rendered="{!CONTAINS(builtInIdsList,anOpSo.Id)==false}" action="{!deleteOpportunitySource}" reRender="OpportunitySourcesPanel" >{!$Label.kimbleone__delete}
							<apex:param name="osId" value="{!anOpSo.Id}" />
						</apex:commandLink>
					</apex:column>
					<apex:column headerValue="{!$ObjectType.KimbleOne__OpportunitySource__c.Fields.Name.Label}" value="{!anOpSo.Name}"/>
 					<apex:column headerValue="{!$ObjectType.KimbleOne__OpportunitySource__c.Fields.KimbleOne__Enum__c.Label}" value="{!anOpSo.KimbleOne__Enum__c}"/>
				</apex:pageBlockTable>				
			           			
			</apex:pageBlock>


			<apex:actionFunction action="{!deleteOpportunitySource}" name="deleteOpportunitySource" rerender="OpportunitySourcesPanel" oncomplete="showModalBoxy();">
			  		<apex:param name="osId" value="" />
			</apex:actionFunction>
			
			<apex:actionFunction action="{!newOpportunitySource}" name="newOpportunitySource" rerender="UpsertOpportunityPanel" oncomplete="showModalBoxy();">
			  		<apex:param name="osId" value="" />
			</apex:actionFunction>

			<apex:actionFunction action="{!editOpportunitySource}" name="editOpportunitySource" rerender="UpsertOpportunityPanel" oncomplete="showModalBoxy();">
			  		<apex:param name="osId" value="" />
			</apex:actionFunction>

		</apex:form>
	</apex:outputPanel>



	<div id="OpportunitySourcesEditPopup" style="display:none"> 
  
		<apex:outputPanel id="UpsertOpportunityPanel">
     	  <apex:form >
           		<apex:pageBlock >
           		 
           			<div id="UpsertOpportunityErrors">
           				<apex:pageMessages escape="false"/>
           			</div> 
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!upsertOpportunitySource}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#UpsertOpportunityErrors')" reRender="OpportunitySourcesPanel, UpsertOpportunityPanel"/>
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
             		<apex:pageblockSection collapsible="false" showheader="false" columns="1">
               
               			<apex:inputfield value="{!anOpportunitySource.Name}" required="true" /> 
               			<apex:inputfield value="{!anOpportunitySource.KimbleOne__Enum__c}" rendered="{!CONTAINS(builtInIdsList,anOpportunitySource.Id)==false || ISBLANK(anOpportunitySource.Id)}" />
               			<apex:outputfield value="{!anOpportunitySource.KimbleOne__Enum__c}" rendered="{!CONTAINS(builtInIdsList,anOpportunitySource.Id) && ISBLANK(anOpportunitySource.Id)==false}" />

 
 		            </apex:pageBlockSection>
            
        		</apex:pageBlock>
	
         	</apex:form>

        </apex:outputPanel> 
  
	</div>	

	

</apex:define>

</apex:composition>


</apex:page>