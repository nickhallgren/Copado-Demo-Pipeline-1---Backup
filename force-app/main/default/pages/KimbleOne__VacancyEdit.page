<apex:page standardController="KimbleOne__Vacancy__c" extensions="KimbleOne.VacancyEditController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="Vacancy" MenuContextId="{!KimbleOne__Vacancy__c.Id}" MenuContextName="{!KimbleOne__Vacancy__c.Name}"/>

</apex:define>  
   
<apex:define name="Content">
	   
	<apex:pagemessages escape="false"/>

    <apex:form >
		
		<apex:outputPanel id="VacancyDetailsPanel" >
		    
		    <apex:pageBlock id="VacancyDetailsBlock" title="{!$ObjectType.KimbleOne__Vacancy__c.Label}">
		    	
		    	<apex:pageBlockButtons location="top">
    				<apex:commandButton action="{!Save}" value="{!$Label.kimbleone__save}" />
    			</apex:pageBlockButtons> 
		    	  
		    	<div id="VacancyDetailsErrors">
           			<apex:pageMessages escape="false"/>
           		</div>
		    	   
				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">
             		 
               		<apex:inputfield value="{!KimbleOne__Vacancy__c.Name}" />  
					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__VacancyType__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__VacancyType__c}" size="1">
							<apex:selectOptions value="{!VacancyTypes}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>
               		
               		<apex:inputfield value="{!KimbleOne__Vacancy__c.KimbleOne__HireDate__c}" styleClass="kimbleDatePicker" />
					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__Status__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__Status__c}" size="1">
							<apex:selectOptions value="{!VacancyStatuses}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>

				</apex:pageblockSection>
				
				<apex:pageblockSection collapsible="false" showheader="false"  columns="1">

               		<apex:inputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Summary__c}" style="width:500px;"/>  
               		<apex:inputfield value="{!KimbleOne__Vacancy__c.KimbleOne__Description__c}" style="width:500px;"/>  
             	               			
				</apex:pageblockSection>
				
				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">

					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__BusinessUnit__c}" size="1">
							<apex:selectOptions value="{!PrimaryBusinessUnits}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__BusinessUnitSecondary__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__BusinessUnitSecondary__c}" size="1">
							<apex:selectOptions value="{!SecondaryBusinessUnits}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>

					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__Grade__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__Grade__c}" size="1">
							<apex:selectOptions value="{!Grades}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__ActivityRole__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__ActivityRole__c}" size="1">
							<apex:selectOptions value="{!ActivityRoles}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>

					<apex:pageBlockSectionItem >
						<apex:outputText value="{!$ObjectType.KimbleOne__Vacancy__c.Fields.KimbleOne__Location__c.Label}"/>				
						<apex:selectList value="{!KimbleOne__Vacancy__c.KimbleOne__Location__c}" size="1">
							<apex:selectOptions value="{!Locations}" />
						</apex:selectList>
					</apex:pageBlockSectionItem>
               			
				</apex:pageBlockSection>					

				<apex:pageblockSection collapsible="false" showheader="false"  columns="2">

					<apex:repeat value="{!$ObjectType.KimbleOne__Vacancy__c.FieldSets.KimbleOne__VacancyDetails}" var="r">
    	 				<apex:inputField value="{!KimbleOne__Vacancy__c[r]}" rendered="{!!CONTAINS(r.FieldPath,'.')}"  styleClass="{!IF(AND($ObjectType.KimbleOne__Vacancy__c.Fields[r].type == 'date',$ObjectType.KimbleOne__Vacancy__c.Fields[r].updateable),'kimbleDatePicker','')}"/>
						<apex:outputField value="{!KimbleOne__Vacancy__c[r]}" rendered="{!CONTAINS(r.FieldPath,'.')}"/>
					</apex:repeat>

	            </apex:pageBlockSection>						

	    	</apex:pageBlock>
		</apex:outputPanel>
		    
    </apex:form>

	<script>

		jQuery(window).load(function(){
			initialiseItems();
		});
		function initialiseItems()
		{
		    SetupDatePicker();
  		}
		function SetupDatePicker()
		{
			//dateFormat: 'yy-mm-dd',
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true,
					changeMonth: true,
					changeYear: true});
		}

	</script>
    
</apex:define>

</apex:composition> 

</apex:page>