<apex:page standardController="KimbleOne__Resource__c"	extensions="KimbleOne.ResourceSelfExperienceController,KimbleOne.FilesAndAttachmentsController" sidebar="false" tabStyle="MyExperience__tab" >
 
	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="ResourceExperienceHistory.html" MenuContextName="{!$Label.kimbleone__myexperience}" BreadCrumbLink="{!IF(ShowRCaEBreadcrumb, $Page.KimbleOne__ResourceCapabilitiesAndExperience, '')}" BreadCrumbName="{!IF(ShowRCaEBreadcrumb, $Label.kimbleone__myskillsandexperience, '')}" />
		</apex:define>
		
		<apex:define name="Content">
 
 			<!--  Assignment Experience -->
		 	<apex:outputPanel id="ActivityAssignmentsList">  
				<apex:form >
					<apex:pageBlock id="ActivityAssignmentsBlock" title="{!$Label.kimbleone__resourceexperienceassignmentexperience}">
				        <apex:pageBlockTable value="{!ActAssignExpHistList}" var="assignment">
							<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
								<apex:outputLink rendered="{!assignment.ExperienceHistory__r.size==0}" 
								styleClass="actionLink" value="#" onclick="initialiseModalBoxy('#ActivityExperienceHistoryPopup', '{!JSENCODE($Label.kimbleone__new)} {!$ObjectType.KimbleOne__ExperienceHistory__c.label}'); newActivityExperienceHistory('{!JSINHTMLENCODE(assignment.Id)}','{!JSINHTMLENCODE(assignment.ResourcedActivity__r.KimbleOne__FullName__c)}');">{!$Label.kimbleone__new}</apex:outputLink>
								<apex:outputLink rendered="{!assignment.ExperienceHistory__r.size>0}" 
								styleClass="actionLink" value="#" onclick="initialiseModalBoxy('#ActivityExperienceHistoryPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ExperienceHistory__c.label}'); editActivityExperienceHistory('{!JSINHTMLENCODE(assignment.ExperienceHistory__r[0].Id)}','{!JSINHTMLENCODE(assignment.ResourcedActivity__r.Name)}','{!JSINHTMLENCODE(assignment.ResourcedActivity__r.DeliveryElement__r.DeliveryGroup__r.Account__r.Name)}');">{!$Label.kimbleone__edit}</apex:outputLink>
							</apex:column>

							<apex:column value="{!assignment.ResourcedActivity__r.KimbleOne__FullName__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ResourcedActivity__c.Label}"></apex:column>			    

							<apex:column value="{!assignment.KimbleOne__StartDate__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}"></apex:column>
							<apex:column value="{!assignment.KimbleOne__ForecastP3EndDate__c}" headerValue="{!$Label.kimbleone__enddatelabel}"></apex:column>
							<apex:column >
								<apex:facet name="header">{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__ResponsibilitiesDescription__c.Label}</apex:facet>
								<apex:outputPanel rendered="{!assignment.ExperienceHistory__r.size>0}">
									<apex:outputField value="{!assignment.ExperienceHistory__r[0].ResponsibilitiesDescription__c}" />
								</apex:outputPanel>
								<apex:outputPanel rendered="{!assignment.ExperienceHistory__r.size==0}">
									&nbsp;
								</apex:outputPanel>
							</apex:column>
											
						</apex:pageBlockTable>			    		

						<apex:actionFunction action="{!newActivityExperienceHistory}"
							name="newActivityExperienceHistory" rerender="ActivityExperiencePanel"
							oncomplete="showModalBoxy(); initialiseItems();">
							<apex:param name="activityassignmentId" value="" />
							<apex:param name="resourceActivityName" value="" />
							<apex:param name="accountName" value="" />
						</apex:actionFunction>
			    		
						<apex:actionFunction action="{!editActivityExperienceHistory}"
							name="editActivityExperienceHistory" rerender="ActivityExperiencePanel"
							oncomplete="showModalBoxy(); initialiseItems();">
							<apex:param name="experiencehistoryId" value="" />
							<apex:param name="resourceActivityName" value="" />
							<apex:param name="accountName" value="" />
						</apex:actionFunction>


			    	</apex:pageBlock>    		
		    	</apex:form>
		    </apex:outputPanel>
 
			<!--  Other Experience -->
			<apex:outputPanel id="OtherAssignmentsList">
				<apex:form >
					<apex:pageBlock id="OtherAssignmentsBlock" title="{!$Label.kimbleone__resourceexperienceotherexperience}">
 
						<apex:pageBlockButtons location="top">
							<input type="button" class="btn" value="{!$Label.kimbleone__new} {!$Label.kimbleone__resourceexperienceotherexperience}"
								onclick="initialiseModalBoxy('#ExperienceHistoryPopup', '{!JSENCODE($Label.New)} {!$ObjectType.ExperienceHistory__c.label}');newExperienceHistory();"></input>
						</apex:pageBlockButtons>
						
						
						<apex:pageBlockTable value="{!ResourceSelfExperienceHistorys}" var="history" >
							<apex:column headerValue="{!$Label.kimbleone__actionlinksheader}">
								<apex:outputLink value="#"
									onclick="initialiseModalBoxy('#ExperienceHistoryPopup', '{!JSENCODE($Label.kimbleone__edit)} {!$ObjectType.KimbleOne__ExperienceHistory__c.label}');getExperienceHistory('{!JSENCODE(history.Id)}')">{!$Label.kimbleone__edit}</apex:outputLink>&nbsp;|&nbsp;
     			<apex:commandLink onclick="var d = confirmDelete();if(!d) return;"
									action="{!deleteExperienceHistory}"
									reRender="OtherAssignmentsList">{!$Label.kimbleone__delete}
					<apex:param name="historyId" value="{!history.Id}" />
								</apex:commandLink>
							</apex:column>

							<apex:column value="{!history.Name}"  headerValue="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.Name.Label}"/>
							<apex:column value="{!history.KimbleOne__Account__c}"   headerValue="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__Account__c.Label}"/>
							<apex:column value="{!history.KimbleOne__StartDate__c}"   headerValue="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__StartDate__c.Label}"/>
							<apex:column value="{!history.KimbleOne__EndDate__c}"   headerValue="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__EndDate__c.Label}"/>
							

						</apex:pageBlockTable>

						<apex:actionFunction action="{!newExperienceHistory}"
							name="newExperienceHistory" rerender="OtherExperiencePanel"
							oncomplete="showModalBoxy(); initialiseItems();">
						</apex:actionFunction>

						<apex:actionFunction action="{!getResourceSelfExperienceHistory}"
							name="getExperienceHistory" rerender="OtherExperiencePanel"
							oncomplete="showModalBoxy()">
							<apex:param name="historyId" value="" />
						</apex:actionFunction>

					</apex:pageBlock>
					
				</apex:form>
				
				<!--  Notes & Attachments -->
		   	  	<apex:relatedList subject="{!Resource}" list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
				<apex:relatedList subject="{!Resource}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
					
			</apex:outputPanel>


	<!--  POPUPS -->
	<div id="ActivityExperienceHistoryPopup" style="display: none">
		<apex:outputPanel id="ActivityExperiencePanel" > 
     	  <apex:form >
           		<apex:pageBlock > 

           			<div id="ActivityExperienceHistoryPopupErrors">
           				<apex:pageMessages escape="false"/>
           			</div>  
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton action="{!upsertActivityExperienceHistory}"  
								oncomplete="hideModalBoxyWithErrorCheck('#ActivityExperienceHistoryPopupErrors'); initialiseItems();"
								reRender="ActivityExperiencePanel, ActivityAssignmentsList" value="{!$Label.kimbleone__save}"  />
						<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
					
					<apex:pageblockSection collapsible="false" showheader="false"
							columns="1">
					
						<apex:pageblockSectionItem labelstyle="text-align:left" >
							<apex:outputLabel value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ResourcedActivity__c.Label}" />
							<apex:outputText value="{!resourceActivityName}" />
						</apex:pageblockSectionItem>
						
					</apex:pageblockSection>
					<apex:pageblockSection collapsible="false" showheader="false"
							columns="2" rendered="{!ExperienceHistory_AssignmentExperience.Id==null}">
						<apex:inputField value="{!ExperienceHistory_AssignmentExperience.KimbleOne__StartDate__c}" styleClass="ExpeDates kimbleDatePicker" />
						<apex:inputField value="{!ExperienceHistory_AssignmentExperience.KimbleOne__EndDate__c}" styleClass="ExpeDates kimbleDatePicker" />
					</apex:pageblockSection>
					<apex:pageblockSection collapsible="false" showheader="false"
							columns="2" rendered="{!ExperienceHistory_AssignmentExperience.Id!=null}">
								<apex:pageBlockSectionItem labelStyle="text-align:left">
									<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__StartDate__c.Label}"/>
									<apex:outputField value="{!ExperienceHistory_AssignmentExperience.KimbleOne__StartDate__c}"/>
								</apex:pageBlockSectionItem>
								<apex:pageBlockSectionItem labelStyle="text-align:left">
									<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__EndDate__c.Label}"/>
									<apex:outputField value="{!ExperienceHistory_AssignmentExperience.KimbleOne__EndDate__c}"/>
								</apex:pageBlockSectionItem>
							</apex:pageblockSection>
             		<apex:pageblockSection collapsible="false" showheader="false" columns="1">
						<apex:pageBlockSectionItem labelStyle="text-align:left">
							<apex:outputLabel value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__ActivityDescription__c.Label}"/>
							<apex:outputText value="" />
						</apex:pageBlockSectionItem>             		
			            <apex:pageblockSectionItem labelStyle="text-align:left">
							<apex:inputTextarea cols="60" rows="6" value="{!ExperienceHistory_AssignmentExperience.KimbleOne__ActivityDescription__c}" styleClass="ExpeDesc" />
							<apex:outputText value="" />		            
               			</apex:pageblockSectionItem>               			

						<apex:pageBlockSectionItem labelStyle="text-align:left">
							<apex:outputLabel value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__ResponsibilitiesDescription__c.Label}"/>
							<apex:outputText value="" />
						</apex:pageBlockSectionItem>             		
			            <apex:pageblockSectionItem labelStyle="text-align:left">
							<apex:inputTextarea cols="60" rows="6" value="{!ExperienceHistory_AssignmentExperience.KimbleOne__ResponsibilitiesDescription__c}" /> 
							<apex:outputText value="" />		            
               			</apex:pageblockSectionItem>
		            </apex:pageBlockSection>
                    		            
	        	</apex:pageBlock>
	
         	</apex:form>

        </apex:outputPanel> 
	</div>

 


			<div id="ExperienceHistoryPopup" style="display: none"><apex:outputPanel id="OtherExperiencePanel">

				<apex:form >

					<apex:pageBlock >

						<div id="ExperienceHistoryPopupErrors"><apex:pageMessages escape="false"/></div>

						<apex:pageBlockButtons location="bottom">

							<apex:commandButton action="{!saveExperienceHistory}"
								value=" {!$Label.kimbleone__save}"
								oncomplete="hideModalBoxyWithErrorCheck('#ExperienceHistoryPopupErrors'); initialiseItems();"
								reRender="OtherAssignmentsList, OtherExperiencePanel" />
							<input class="btn" type="button" onclick="hideModalBoxy();"
								value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>



						<apex:pageblockSection collapsible="false" showheader="false"
							columns="1">

							<apex:pageBlockSectionItem labelStyle="text-align:left">
								<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.Name.Label}" />
								<apex:outputPanel layout="none">
								<div class="requiredInput">
									<div class="requiredBlock"></div>
								<apex:inputField value="{!ExperienceHistory_OtherExperience.Name}"/>
									 </div>
									 </apex:outputPanel>
							</apex:pageBlockSectionItem>
							<!-- <apex:pageBlockSectionItem labelStyle="text-align:left">
								<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__Account__c.Label}" />
								<apex:inputField value="{!ExperienceHistory_OtherExperience.Account__c}" />
							</apex:pageBlockSectionItem>
							 -->
						</apex:pageblockSection>
						<apex:pageblockSection collapsible="false" showheader="false"
							columns="2" rendered="{!ExperienceHistory_OtherExperience.Id==null}">
								<apex:inputField value="{!ExperienceHistory_OtherExperience.KimbleOne__StartDate__c}" styleClass="kimbleDatePicker"/>
								<apex:inputField value="{!ExperienceHistory_OtherExperience.KimbleOne__EndDate__c}" styleClass="kimbleDatePicker"/>
						</apex:pageblockSection>
						<apex:pageblockSection collapsible="false" showheader="false"
							columns="2" rendered="{!ExperienceHistory_OtherExperience.Id!=null}">
								<apex:pageBlockSectionItem labelStyle="text-align:left">
									<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__StartDate__c.Label}"/>
									<apex:outputField value="{!ExperienceHistory_OtherExperience.KimbleOne__StartDate__c}"/>
								</apex:pageBlockSectionItem>
								<apex:pageBlockSectionItem labelStyle="text-align:left">
									<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__EndDate__c.Label}"/>
									<apex:outputField value="{!ExperienceHistory_OtherExperience.KimbleOne__EndDate__c}"/>
								</apex:pageBlockSectionItem>
							</apex:pageblockSection>
						<apex:pageblockSection collapsible="false" showheader="false"
							columns="1">
							<apex:pageBlockSectionItem labelStyle="text-align:left">
								<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__ActivityDescription__c.Label}" />
								<apex:outputText value="" />
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem >
								<apex:inputTextarea value="{!ExperienceHistory_OtherExperience.KimbleOne__ActivityDescription__c}" cols="60"
									rows="6" />
								<apex:outputText value="" />
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem labelStyle="text-align:left">
								<apex:outputText value="{!$ObjectType.KimbleOne__ExperienceHistory__c.Fields.KimbleOne__ResponsibilitiesDescription__c.Label}" />
								<apex:outputText value="" />
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem >
								<apex:inputTextarea value="{!ExperienceHistory_OtherExperience.KimbleOne__ResponsibilitiesDescription__c}"
									cols="60" rows="6" />
								<apex:outputText value="" />

							</apex:pageBlockSectionItem>


						</apex:pageblockSection>
					</apex:pageBlock>

				</apex:form>

			</apex:outputPanel></div>
			
			<script>
				jQuery(document).ready(function() {
					if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
				});

				jQuery(window).load(function(){
					initialiseItems();
				});
				function initialiseItems()
				{
					SetupDatePicker();
				}
				function SetupDatePicker()
				{
					//dateFormat: 'yy-mm-dd',
					jQuery('.kimbleDatePicker').datepicker({
							dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
							showOtherMonths: true,
							selectOtherMonths: true,
							changeMonth: true,
							changeYear: true});
				}
			</script>
		</apex:define>

	</apex:composition>
		
		
		
		
		
</apex:page>