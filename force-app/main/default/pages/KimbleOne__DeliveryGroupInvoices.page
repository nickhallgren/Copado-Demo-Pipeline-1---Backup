			    resetSelectAll();
			        	
	        	function resetSelectAll()
				{
					jQuery("input.select-all").each(function(){jQuery(this).prop('checked', false);});
				}
				
				function selectAllCheckboxes()
		  		{
		  			if(jQuery("input.select-all:visible")[0].checked)
		  			{
		            	jQuery("input.row-selector:visible").each(function(){jQuery(this).prop('checked', true);});
		           	}
		           	else
		           	{
		           		jQuery("input.row-selector:visible").each(function(){jQuery(this).prop('checked', false);});
					}
		        }
		        
		        var billingContacts = [];
		        
		        function populateBillingContacts()
		        {
			        if(jQuery('.billing-contacts-container:visible').length)
			        {
			        	billingContacts = jQuery.parseJSON($('.TheBillingContacts').val());
			        	drawBillingContacts();
		        	}
	        	}
				
				function drawBillingContacts()
				{
					var html = '';
					
					html += '<table class="billing-contacts-table list" border="0" cellpadding="0" cellspacing="0">';
					html += '<tr class="header-row headerRow">';
					html += '<th class="actions-col"></th>';
					html += '<th class="billing-contact-name-title">' + l['contactname'] + '</th>';
					html += '<th class="primary-cell">' + l['primaryind'] + '</th>';
					html += '</tr>';
					
					// existing rows
					for(var billingContactCounter = 0; billingContactCounter < billingContacts.length; billingContactCounter++)
					{
						var billingContact = billingContacts[billingContactCounter];
						
						html += '<tr class="billing-contact-row" contactId="' + billingContact.ContactId + '">';
						
						html += '<td class="remove-billing-contact action-btn" title="' + l['delete'] + '"><i class="fa fa-trash"></i></td>';
						html += '<td class="billing-contact-name">' + billingContact.ContactName + '</td>';
						html += '<td class="primary-cell">';
						html += '<input type="radio" name="primary-billing-contacts" ' + (billingContact.IsPrimary ? ' checked="checked"' : '') + '/>';
						html += '</td>';
			
						html += '</tr>';			
					}
					
					// new row
					html += '<tr class="billing-contact-row new-billing-contact">';
					
					html += '<td class="add-billing-contact action-btn"></td>';
					html += '<td class="billing-contact-name">';
					html += '<input type="text" class="find-billing-contact"/>';
					html += '</td>';
					html += '<td class="primary-cell">';
					html += '</td>';
		
					html += '</tr>';
					
					jQuery('#billing-contacts').html(html);
		
					initialiseBillingContactFind();
				}
				
				function initialiseBillingContactFind()
				{
					jQuery('.find-billing-contact').select2({
						//minimumInputLength: 2,
						multiple: false,
						placeholder: '<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>',
						query: function (params) {
							var find = function() {findBillingContacts(params);};        		
							find();
						},
						initSelection : function (element, callback) {
						var data = {id: element.val(), text: element.attr('data-name')};
						callback(data);
						}
					});
					
					jQuery('.find-billing-contact').on("select2-selecting", function(e) {
						var asPrimary = jQuery('input:visible[name="primary-billing-contacts"]').length == 0;
						var newContact = {ContactId: e.object.id, ContactName: e.object.text, IsPrimary: asPrimary};
						billingContacts.push(newContact);
						billingContacts.sort(sortByBillingContactName);
						BillingContactChanges = true;
						drawBillingContacts();
					});
					
					jQuery(document).off('click', '.remove-billing-contact').on('click', '.remove-billing-contact', removeBillingContact);
					jQuery(document).off('click', 'input[name="primary-billing-contacts"]').on('click', 'input[name="primary-billing-contacts"]', setPrimaryContact);
				}
				
				function setPrimaryContact()
				{
					var contactId = jQuery(this).closest('.billing-contact-row').attr('contactId');
					
					for(var billingContactCounter = 0; billingContactCounter < billingContacts.length; billingContactCounter++)
					{
						var billingContact = billingContacts[billingContactCounter];
						billingContact.IsPrimary = (billingContact.ContactId == contactId);
					}
				}
				
				function removeBillingContact()
				{
					var contactId = jQuery(this).closest('.billing-contact-row').attr('contactId');
					
					jQuery(this).closest('.billing-contact-row').remove();
					
					for(var billingContactCounter = 0; billingContactCounter < billingContacts.length; billingContactCounter++)
					{
						var billingContact = billingContacts[billingContactCounter];
						
						if(billingContact.ContactId == contactId)
						{
							billingContacts.splice(billingContactCounter, 1);
							break;
						}
					}
					
					drawBillingContacts();
				}		  
				      
				function processBillingContacts()
				{
					if(jQuery('.billing-contacts-container:visible').length == 0) return;
					
					var theContacts = [];
					
					jQuery('.billing-contacts-container:visible .billing-contact-row:not(.new-billing-contact)').each(function() {
						var theContact = {ContactId: jQuery(this).attr('contactId'), ContactName: jQuery(this).find('.billing-contact-name').text(), IsPrimary: jQuery(this).find('input:visible[name="primary-billing-contacts"]:checked').length == 1};
						theContacts.push(theContact);
					});
					
					jQuery('.TheBillingContacts').val(JSON.stringify(theContacts));
				}				
				</script>
				
