							<apex:outputPanel id="groupBillingAccount">
								<apex:selectList value="{!TheDeliveryGroup.KimbleOne__BillingAccount__c}" id="billingAccount" size="1" rendered="{!!(BillingAccountValidationSetting == 'None')}">
									<apex:actionSupport event="onchange" action="{!RefreshGroupBillingContacts}" rerender="groupBillingContactSelect,groupBillingContactSelectEnhanced,groupBillingAccountsData" oncomplete="populateGroupBillingContacts();"/>
									<apex:selectOptions value="{!BillingAccounts}" />
								</apex:selectList>
								<apex:inputField id="billingAccountLookup" value="{!TheDeliveryGroup.KimbleOne__BillingAccount__c}" rendered="{!(BillingAccountValidationSetting == 'None')}">
									<apex:outputText id="groupBillingAccountId" styleClass="billing-account-lookup hidden-item" value="{!TheDeliveryGroup.KimbleOne__BillingAccount__c}"/>
									<apex:actionSupport event="onchange" action="{!RefreshGroupBillingContacts}" rerender="groupBillingContactSelect,groupBillingContactSelectEnhanced,groupBillingAccountsData,groupBillingAccountId" oncomplete="populateGroupBillingContacts();"/>
								</apex:inputField>
							</apex:outputPanel>
						</apex:pageBlockSectionItem>
		 				<apex:pageBlockSectionItem rendered="{!!ShowMultipleContacts}">
		 					<apex:outputLabel value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.KimbleOne__BillingContact__c.Label}"/>
							<apex:outputPanel >
								<apex:selectList id="groupBillingContactSelect" value="{!TheDeliveryGroup.KimbleOne__BillingContact__c}" size="1" rendered="{!!EnhancedContactLookupEnabled}">
									<apex:selectOptions value="{!GroupBillingContacts}" />
								</apex:selectList>
								<apex:inputField rendered="{!EnhancedContactLookupEnabled}" id="groupBillingContactSelectEnhanced" styleclass="kimbleSearch" value="{!TheDeliveryGroup.KimbleOne__BillingContact__c}" html-data-typename="BillingContact" html-data-filter="{!'AccountId:' + IF(!ISBLANK(TheDeliveryGroup.KimbleOne__BillingAccount__c),(TheDeliveryGroup.KimbleOne__BillingAccount__c),(TheDeliveryGroup.KimbleOne__Account__c)) + ';BillingAccount:null;SelectedContact:null'}"/>
							</apex:outputPanel>
		 				</apex:pageBlockSectionItem>
		 				<apex:pageBlockSectionItem rendered="{!ShowMultipleContacts}">
		 				</apex:pageBlockSectionItem>
					</apex:pageBlockSection>

					<apex:pageBlockSection collapsible="false" columns="1" rendered="{!ShowMultipleContacts}">
	 					<apex:outputLabel styleClass="billing-contacts-label" value="{!$ObjectType.KimbleOne__BillingContact__c.LabelPlural}"/>
		 				<apex:pageBlockSectionItem >
		 					<apex:outputPanel layout="none" id="groupBillingContactSelect">
								<div class="group-billing-contacts-container">
									<div id="group-billing-contacts">
									</div>
								</div>			 					
		 					</apex:outputPanel>
		 				</apex:pageBlockSectionItem>
					</apex:pageBlockSection>
					</div>
				</apex:pageBlock>
				</apex:form>
				
				<script>	        
		        var groupBillingContacts = [];
		        
		        function populateGroupBillingContacts()
		        {
			        if(jQuery('.group-billing-contacts-container:visible').length)
			        {
			        	groupBillingContacts = jQuery.parseJSON($('.TheGroupBillingContacts').val());
			        	drawGroupBillingContacts();
		        	}
	        	}
				
				function drawGroupBillingContacts()
				{
					var html = '';
					
					html += '<table class="billing-contacts-table list" border="0" cellpadding="0" cellspacing="0">';
					html += '<tr class="header-row headerRow">';
					html += '<th class="actions-col"></th>';
					html += '<th class="billing-contact-name-title">' + l['contactname'] + '</th>';
					html += '<th class="primary-cell">' + l['primaryind'] + '</th>';
					html += '</tr>';
					
					// existing rows
					for(var billingContactCounter = 0; billingContactCounter < groupBillingContacts.length; billingContactCounter++)
					{
						var billingContact = groupBillingContacts[billingContactCounter];
						
						html += '<tr class="billing-contact-row" contactId="' + billingContact.ContactId + '">';
						
						html += '<td class="remove-billing-contact action-btn" title="' + l['delete'] + '"><i class="fa fa-trash"></i></td>';
						html += '<td class="billing-contact-name">' + billingContact.ContactName + '</td>';
						html += '<td class="primary-cell">';
						html += '<input type="radio" name="primary-billing-contacts" ' + (billingContact.IsPrimary ? ' checked="checked"' : '') + '/>';
						html += '</td>';
			
						html += '</tr>';			
					}
					
					// new row
					html += '<tr class="billing-contact-row new-billing-contact">';
					
					html += '<td class="add-billing-contact action-btn"></td>';
					html += '<td class="billing-contact-name">';
					html += '<input type="text" class="find-billing-contact"/>';
					html += '</td>';
					html += '<td class="primary-cell">';
					html += '</td>';
		
					html += '</tr>';
					
					jQuery('#group-billing-contacts').html(html);
		
					initialiseGroupBillingContactFind();
				}
				
				function initialiseGroupBillingContactFind()
				{
					jQuery('.find-billing-contact').select2({
						//minimumInputLength: 2,
						multiple: false,
						placeholder: '<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>',
						query: function (params) {
							var find = function() {findBillingContacts(params);};        		
							find();
						},
						initSelection : function (element, callback) {
						var data = {id: element.val(), text: element.attr('data-name')};
						callback(data);
						}
					});
					
					jQuery('.find-billing-contact').on("select2-selecting", function(e) {
						var asPrimary = jQuery('input:visible[name="primary-billing-contacts"]').length == 0;
						var newContact = {ContactId: e.object.id, ContactName: e.object.text, IsPrimary: asPrimary};
						groupBillingContacts.push(newContact);
						groupBillingContacts.sort(sortByBillingContactName);
						BillingContactChanges = true;
						drawGroupBillingContacts();
					});
					
					jQuery(document).off('click', '.remove-billing-contact').on('click', '.remove-billing-contact', removeGroupBillingContact);
					jQuery(document).off('click', 'input[name="primary-billing-contacts"]').on('click', 'input[name="primary-billing-contacts"]', setGroupPrimaryContact);
				}

				function setGroupPrimaryContact()
				{
					var contactId = jQuery(this).closest('.billing-contact-row').attr('contactId');
					
					for(var billingContactCounter = 0; billingContactCounter < groupBillingContacts.length; billingContactCounter++)
					{
						var billingContact = groupBillingContacts[billingContactCounter];
						billingContact.IsPrimary = (billingContact.ContactId == contactId);
					}
				}
				
				function removeGroupBillingContact()
				{
					var contactId = jQuery(this).closest('.billing-contact-row').attr('contactId');
					
					jQuery(this).closest('.billing-contact-row').remove();
					
					for(var billingContactCounter = 0; billingContactCounter < groupBillingContacts.length; billingContactCounter++)
					{
						var billingContact = groupBillingContacts[billingContactCounter];
						
						if(billingContact.ContactId == contactId)
						{
							groupBillingContacts.splice(billingContactCounter, 1);
							break;
						}
					}
					
					drawGroupBillingContacts();
				}		  
				      
				function processGroupBillingContacts()
				{
					if(jQuery('.group-billing-contacts-container:visible').length == 0) return;
					
					var theContacts = [];
					
					jQuery('.group-billing-contacts-container:visible .billing-contact-row:not(.new-billing-contact)').each(function() {
						var theContact = {ContactId: jQuery(this).attr('contactId'), ContactName: jQuery(this).find('.billing-contact-name').text(), IsPrimary: jQuery(this).find('input:visible[name="primary-billing-contacts"]:checked').length == 1};
						theContacts.push(theContact);
					});
					
					jQuery('.TheGroupBillingContacts').val(JSON.stringify(theContacts));
				}				
				</script>
				
			</apex:outputPanel>
		</div>
		</apex:outputPanel>
	</apex:define>

</apex:composition>

</apex:page>