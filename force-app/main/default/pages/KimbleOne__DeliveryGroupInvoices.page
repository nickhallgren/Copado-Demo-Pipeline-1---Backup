<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupInvoicesController,KimbleOne.TooltipsController,KimbleOne.SecurityController" showHeader="true" sidebar="false">
<apex:composition template="KimbleOne__SiteMaster">

	<apex:define name="Menu">
		<c:Menu DefaultHelpPage="ManagingInvoices.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}"/>
	</apex:define>
	     
	<apex:define name="Content">
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>
	
    	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
    	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

		<!-- Kimble Guidance -->
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
		<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
		<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/DeliveryGroupInvoicesNarratives/' + UserNarrativeLanguageCode + '.js')}" />

			<apex:outputPanel layout="none" rendered="{!DeliveryGroupInvoicesTipOverrideEnabled}">
				<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
			</apex:outputPanel>
		</apex:outputPanel>
		
		<style>
			.right-align
			{
				text-align: right;
				padding-right: 5px !important;
			}
			.indent {display: inline-block;width: 8px;height: 8px;margin-right: 2px;}
			.has-children .indent {cursor:pointer;background-image: url({!URLFOR($Resource.TaskGanttIcons, 'arrows.gif')});background-position: -4px, 0px;}
			.has-children.expanded .indent {cursor:pointer;background-image: url({!URLFOR($Resource.TaskGanttIcons, 'arrows.gif')});background-position: -22px, 0px;}
			.child {display:none;}
			.child .indent {margin-left: 4px;}
			/* restrict the height of the edit popup as with all fields the page block buttons are off the page */
			.popup-body-container {
			    max-height: 380px;
			    overflow: auto;
			}
			.popup-body-container .pbSubheader {
			    margin-top: 6px;
			}
			.popup-body-container label {
			    white-space: nowrap;
			}
			div[id$="groupBillingDetails"] tr {
			    background-color: white;
			}
			div[id$="groupBillingDetails"] th,
			div[id$="groupBillingDetails"] td {
			    border-bottom: 1px solid #ededed !important;
			    border-top: 1px solid #ededed !important;
			    background-color: white;
			}
			div[id$="groupBillingDetails"] td:first-child{
			    width: 80px !important;
			    border-left : 1px solid #ededed;
			}
			div[id$="groupBillingDetails"] td:last-child {
			    border-right : 1px solid #ededed !important;
			}
			/* Billing contacts */
			div.select2-container.find-billing-contact a.select2-choice {
				height: 18px !important;
				line-height: 18px !important;
				background-image: none !important;
				border-radius: 0px !important;
				color: black !important;
				padding-left: 4px !important;
			}
			div.select2-container.find-billing-contact .select2-choice div {
				border-left: none !important;
			}
			td.action-btn {
			    font-size: 16px;
			    text-align: center;
			    cursor: pointer;
			    width: 18px;
			}
			th.primary-cell {
			    width: 100px;
			}
			td.primary-cell {
			    text-align: center;
			}
			.select2-container.find-billing-contact {
			    width: 100% !important;
			    padding-right: 2px;
			}
			label.billing-contacts-label {
			    font-size: 91%;
			    font-weight: bold;
			    color: #4a4a56;
			    padding-left: 1px;
			}
			.action-btn {
				color: #BBB;
				cursor: pointer;
			}
		</style>

		<div id="delivery-group-invoices-title">
			<apex:outputPanel id="deliveryGroupCard" layout="none">
			<div class="title-card-container">
			<div class="title-card">
				<div class="title-card-heading" ></div>	
				<div class="title-card-body">
		  			<div id="embeddedCharmsContainer" pageSource="DeliveryGroupInvoicesCharmsCard"><i class="charm-loading fa fa-circle-o-notch fa-spin fa-3x fa-fw"/></div>
				</div>
			</div>
			</div>
 			</apex:outputPanel>
	  	</div>			
		<apex:form id="TheForm">
		<apex:pageMessages escape="false"/>
		<apex:pageBlock >
			<apex:pageBlockSection id="groupBillingDetails" collapsible="false" columns="3" title="{!$Label.kimbleone__deliverygroupbillingdetails}" rendered="{!ShowGroupLevelInvoicingDetails}">
				<apex:outputLink styleClass="actionLink edit-dg-billling" value="#" onclick="initialiseModalBoxy('#DeliveryGroupPopup', '{!JSENCODE($Label.kimbleone__deliverygroupbillingdetails)}');editDeliveryGroup();" rendered="{!$ObjectType.KimbleOne__DeliveryGroup__c.updateable}">{!$Label.kimbleone__edit}</apex:outputLink>
				<apex:outputField value="{!TheDeliveryGroup.KimbleOne__BillingAccount__c}" rendered="{!!ISBLANK(TheDeliveryGroup.KimbleOne__BillingAccount__c)}">
					<a class="action-btn" onclick="javascript:safeNavigateToSForceURL('{!$Page.AccountEdit}?id={!JSENCODE(TheDeliveryGroup.BillingAccount__c)}&rId={!JSENCODE(TheDeliveryGroup.Id)}');"
					   title="{!$Label.kimbleone__edit} {!$ObjectType.Account.label}"><iclass="fa fa-pencil-square-o"></i></a>
				</apex:outputField>
				<apex:pageBlockSectionItem rendered="{!ISBLANK(TheDeliveryGroup.KimbleOne__BillingAccount__c)}">
 					<apex:outputLabel value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.KimbleOne__BillingAccount__c.Label}"/>
 					<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>
 				</apex:pageBlockSectionItem>

				<apex:outputField value="{!TheDeliveryGroup.KimbleOne__BillingContact__c}" rendered="{!!ISBLANK(TheDeliveryGroup.KimbleOne__BillingContact__c)}"/>
				<apex:pageBlockSectionItem rendered="{!ISBLANK(TheDeliveryGroup.KimbleOne__BillingContact__c)}">
 					<apex:outputLabel value="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.KimbleOne__BillingContact__c.Label}"/>
 					<apex:outputText value="{!$Label.kimbleone__defaultnonedropdownentry}"/>
 				</apex:pageBlockSectionItem>
			</apex:pageBlockSection>
		
			<apex:pageBlockSection id="elementBillingDetails" collapsible="false" columns="1" title="{!$ObjectType.KimbleOne__PeriodReceivable__c.LabelPlural}"></apex:pageBlockSection>
			<table class="list" border="0" cellpadding="0" cellspacing="0">
				<thead>
				<tr class="headerRow">
					<th class="headerRow"><h2>{!$Label.kimbleone__actionlinksheader}</h2></th>
					<th class="headerRow"><h2>{!$ObjectType.DeliveryElement__c.Fields.Name.Label}</h2></th>
					<th class="headerRow"></th>
					<th id="RuleColumn" class="headerRow"><h2>{!$Label.RuleHeading}</h2></th>
					<th id="BillingAccountColumn1" class="headerRow"><h2>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BillingAccount__c.Label}</h2></th>
					<th id="TaxCodeColumn" class="headerRow"><h2>{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__TaxCode__c.Label}</h2></th>
					<th id="InvoiceableAmountColumn" class="headerRow"><h2>{!$Label.InvoiceableAmountLabel}</h2></th>
				</tr>
				</thead>
				<tbody>
				<apex:repeat value="{!InvoiceableDeliveryElements}" var="ele">							
				<tr node-id="{!JSENCODE(ele.Id)}" class="dataRow {!IF(!ISBLANK(ele.DeliveryElementsInvoicedWith__r) && ele.DeliveryElementsInvoicedWith__r.size > 0, 'has-children','')}">
					<td class="dataCell"><apex:outputLink styleClass="actionLink" value="#" onclick="initialiseModalBoxy('#DeliveryElementPopup', '{!JSENCODE($Label.kimbleone__edit)}');editDeliveryElement('{!JSENCODE(ele.Id)}')" rendered="{!$ObjectType.KimbleOne__DeliveryElement__c.updateable}">{!$Label.kimbleone__edit}</apex:outputLink></td>
					<td class="dataCell" style="white-space: nowrap;"><span class="indent"></span><apex:outputText value="{!ele.Name}"/></td>
					<td class="dataCell"><apex:outputText value="{!$Label.kimbleone__serviceslabel}"/></td>
					<td class="dataCell" style="white-space: pre-wrap;white-space: -moz-pre-wrap;white-space: -pre-wrap;white-space: -o-pre-wrap;word-wrap: break-word;"><apex:outputText value="{!ServicesNarrative[ele.id]}"/></td>
					<td class="dataCell"><apex:outputField value="{!ele.KimbleOne__BillingAccount__c}"/></td>
					<td class="dataCell"><apex:outputField value="{!ele.KimbleOne__TaxCode__c}"/></td>
					<td class="dataCell right-align">
						<apex:outputPanel layout="none" rendered="{!!ISBLANK(ele.KimbleOne__InvoicingCcyServicesInvoiceableAmount__c)}">
							<apex:outputText value="{!ele.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
							<apex:outputField value="{!ele.KimbleOne__InvoicingCcyServicesInvoiceableAmount__c}" />
						</apex:outputPanel>
					</td>
				</tr>
				<apex:outputPanel layout="none" rendered="{!ele.Product__r.ProductDomain__r.RevenueGenerationModel__r.KimbleOne__IsExpenseGenerated__c && ele.Product__r.ProductDomain__r.KimbleOne__IsResourced__c}">
					<tr class="dataRow">
						<td class="dataCell"></td>
						<td class="dataCell"></td>
						<td class="dataCell"><apex:outputText value="{!$Label.kimbleone__expenseslabel}" /></td>
						<td class="dataCell"><apex:outputText value="{!$Label.kimbleone__invoicegenerationruleforexpenseslabel}" /></td>
						<td class="dataCell"></td>
						<td class="dataCell"></td>
						<td class="dataCell right-align">
							<apex:outputPanel layout="none" rendered="{!!ISBLANK(ele.KimbleOne__InvoicingCcyExpensesInvoiceableAmount__c)}">
								<apex:outputText value="{!ele.KimbleOne__InvoicingCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
								<apex:outputField value="{!ele.KimbleOne__InvoicingCcyExpensesInvoiceableAmount__c}" />
							</apex:outputPanel>
						</td>
					</tr>
				</apex:outputPanel>
				
				<apex:repeat value="{!ele.DeliveryElementsInvoicedWith__r}" var="child">
					<tr class="dataRow child" parent-id="{!JSENCODE(ele.Id)}">
						<td class="dataCell"><apex:outputLink styleClass="actionLink" value="#" onclick="initialiseModalBoxy('#DeliveryElementPopup', '{!JSENCODE($Label.kimbleone__edit)}');editDeliveryElement('{!JSENCODE(child.Id)}')" rendered="{!$ObjectType.KimbleOne__DeliveryElement__c.updateable}">{!$Label.kimbleone__edit}</apex:outputLink></td>
						<td class="dataCell" colspan="6" style="white-space: nowrap;"><span class="indent"></span><apex:outputText value="{!child.Name}"/></td>
					</tr>
				</apex:repeat>
				
				</apex:repeat>
				</tbody>
			</table>
		</apex:pageBlock>
		<apex:pageBlock title="{!$ObjectType.KimbleOne__Invoice__c.LabelPlural}">
			<apex:pageBlockButtons location="top">
    			<apex:commandButton action="{!NewInvoice}" value="{!$Label.kimbleone__new}" rerender="TheForm" styleclass="DisableButtonWhileBusy" rendered="{!$ObjectType.KimbleOne__Invoice__c.createable && TheDeliveryGroup.DeliveryStage__r.KimbleOne__AllowNewInvoices__c}"/>
    		</apex:pageBlockButtons>

			<apex:outputPanel id="TheInvoicesPanel">
				<apex:pageBlockTable value="{!ThePagedInvoices.TheRecords}" var="invoice" rendered="{!ThePagedInvoices.TheRecords.size > 0}">
					<apex:column width="5%" headerValue="{!$Label.kimbleone__actionlinksheader}">
						<apex:outputLink styleClass="actionLink" value="#" onclick="deleteInvoice('{!JSINHTMLENCODE(invoice.Id)}')" rendered="{!invoice.Status__r.KimbleOne__Enum__c = 'Draft' && $ObjectType.KimbleOne__Invoice__c.deletable}">{!$Label.kimbleone__delete}</apex:outputLink>
					</apex:column>
					<apex:column id="ReferenceColumn1" width="10%"  headerValue="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Reference__c.Label}">
						<apex:outputLink value="/{!invoice.Id}"><apex:outputText value="{!invoice.KimbleOne__Reference__c}"/></apex:outputLink>
					</apex:column>
					<apex:column id="BillingAccountColumn2" width="25%" headerValue="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BillingAccount__c.Label}" value="{!invoice.KimbleOne__Account__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__InvoiceDate__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__NetAmount__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__TaxAmount__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__GrossAmount__c}"/>
					<apex:column id="StatusColumn1" width="10%" headerValue="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Status__c.Label}" value="{!invoice.Status__r.Name}"/>
				</apex:pageBlockTable>
				<div style="margin: 5px 0px 0px 1px;">
					<div style="text-align:left; width:50%; display:inline-block;">
						<apex:outputText value="{!ThePagedInvoices.CurrentPageDescription}"/>
					</div>
					<div style="text-align:right; width:50%; display:inline-block;float: right;">
						<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoPrevious}" rerender="TheInvoicesPanel" rendered="{!ThePagedInvoices.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
						<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedInvoices.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
						&nbsp;|&nbsp;
						<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoNext}" rerender="TheInvoicesPanel" rendered="{!ThePagedInvoices.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
						<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedInvoices.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
					</div>
				</div>
			</apex:outputPanel>
		</apex:pageBlock>
		
		<apex:pageBlock id="CreditNotesPageBlock" title="{!$ObjectType.KimbleOne__CreditNote__c.LabelPlural}">
			<apex:pageBlockButtons location="top">
    			<apex:commandButton action="{!NewNegativeInvoice}" value="{!$Label.kimbleone__new}" rerender="TheForm" styleclass="DisableButtonWhileBusy" rendered="{!$ObjectType.KimbleOne__Invoice__c.createable && $ObjectType.KimbleOne__CreditNote__c.createable && TheDeliveryGroup.DeliveryStage__r.KimbleOne__AllowNewInvoices__c && HasPermission['EditAllNegativeInvoice'] && AllowAdhocCreditNotes}"/>
    		</apex:pageBlockButtons>

			<apex:pageBlockTable value="{!TheCreditNotes}" var="creditNote" rendered="{!TheCreditNotes.size > 0}">
				<apex:column width="5%"  headerValue="{!$Label.kimbleone__actionlinksheader}">
					<apex:outputLink styleClass="actionLink" value="#" onclick="deleteCreditNote('{!JSINHTMLENCODE(creditNote.Id)}')" rendered="{!creditNote.Status__r.KimbleOne__Enum__c = 'Draft' && $ObjectType.KimbleOne__CreditNote__c.deletable}">{!$Label.kimbleone__delete}</apex:outputLink>
				</apex:column>
				<apex:column id="ReferenceColumn2" width="10%"  headerValue="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__Reference__c.Label}">
					<apex:outputLink value="/{!creditNote.Id}"><apex:outputText value="{!creditNote.KimbleOne__Reference__c}"/></apex:outputLink>
				</apex:column>
				<apex:column id="InvoiceColumn" width="10%"  headerValue="{!$ObjectType.KimbleOne__Invoice__c.Label}">
					<apex:outputLink value="/{!creditNote.KimbleOne__Invoice__c}"><apex:outputText value="{!creditNote.Invoice__r.KimbleOne__Reference__c}"/></apex:outputLink>
				</apex:column>
				<apex:column id="BillingAccountColumn3" width="15%"  headerValue="{!$ObjectType.KimbleOne__DeliveryElement__c.Fields.KimbleOne__BillingAccount__c.Label}" value="{!creditNote.KimbleOne__Account__c}"/>
				<apex:column width="10%"  value="{!creditNote.KimbleOne__CreditNoteDate__c}"/>
				<apex:column width="10%"  value="{!creditNote.KimbleOne__NetAmount__c}"/>
				<apex:column width="10%"  value="{!creditNote.KimbleOne__TaxAmount__c}"/>
				<apex:column width="10%"  value="{!creditNote.KimbleOne__GrossAmount__c}"/>
				<apex:column id="StatusColumn2" width="10%"  headerValue="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__Status__c.Label}" value="{!creditNote.Status__r.Name}"/>
			</apex:pageBlockTable>
		
		</apex:pageBlock>
		
		<apex:pageBlock title="{!$ObjectType.KimbleOne__Invoice__c.LabelPlural} ({!$Label.kimbleone__intercompany})" rendered="{!IsIntercompanyInvoicingEnabled && TheInternalInvoices.size > 0}">
			<apex:outputPanel id="TheInternalInvoicesPanel">
				<apex:pageBlockTable value="{!ThePagedInternalInvoices.TheRecords}" var="invoice">
				<apex:column id="ReferenceColumn3" width="10%"  headerValue="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Reference__c.Label}">
						<apex:outputLink value="/{!invoice.Id}"><apex:outputText value="{!invoice.KimbleOne__Reference__c}"/></apex:outputLink>
					</apex:column>
					<apex:column id="BusinessUnitColumn" width="25%" headerValue="{!$ObjectType.KimbleOne__BusinessUnit__c.Label}" value="{!invoice.KimbleOne__BusinessUnitTradingEntity__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__InvoiceDate__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__NetAmount__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__TaxAmount__c}"/>
					<apex:column width="10%" value="{!invoice.KimbleOne__GrossAmount__c}"/>
					<apex:column id="StatusColumn3" width="10%" headerValue="{!$ObjectType.KimbleOne__Invoice__c.Fields.KimbleOne__Status__c.Label}" value="{!invoice.Status__r.Name}"/>
				</apex:pageBlockTable>
				<div style="margin: 5px 0px 0px 1px;">
					<div style="text-align:left; width:50%; display:inline-block;">
						<apex:outputText value="{!ThePagedInternalInvoices.CurrentPageDescription}"/>
					</div>
					<div style="text-align:right; width:50%; display:inline-block;float: right;">
						<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoPrevious}" rerender="TheInternalInvoicesPanel" rendered="{!ThePagedInternalInvoices.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}">
							<apex:param name="internal" value="true"/>
						</apex:commandLink>
						<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedInternalInvoices.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
						&nbsp;|&nbsp;
						<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoNext}" rerender="TheInternalInvoicesPanel" rendered="{!ThePagedInternalInvoices.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}">
							<apex:param name="internal" value="true"/>
						</apex:commandLink>
						<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedInternalInvoices.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
					</div>
				</div>
			</apex:outputPanel>
		</apex:pageBlock>

		<apex:actionFunction action="{!EditDeliveryElement}" name="editDeliveryElement" reRender="DeliveryElementDetails" oncomplete="populateBillingContacts();showModalBoxy()">
			<apex:param name="deliveryElementId" value=""/>
		</apex:actionFunction>

		<apex:actionFunction action="{!EditDeliveryGroup}" name="editDeliveryGroup" reRender="DeliveryGroupDetails" oncomplete="populateGroupBillingContacts();showModalBoxy()">
		</apex:actionFunction>
		
		<apex:actionFunction action="{!DeleteInvoice}" name="deleteInvoice" reRender="TheForm">
			<apex:param name="invoiceId" value=""/>
		</apex:actionFunction>
		
		<apex:actionFunction action="{!DeleteCreditNote}" name="deleteCreditNote" reRender="TheForm">
			<apex:param name="creditNoteId" value=""/>
		</apex:actionFunction>
		
		<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
		<div style="display:none;" kimble-tip="null"></div>
		
	</apex:form>	
	
	<script>
        var defaultAccountId = '<apex:outputText value="{!TheDeliveryGroup.KimbleOne__Account__c}"/>';
		        
		var l = {};
		l['contactname'] = '<apex:outputText value="{!$ObjectType.KimbleOne__BillingContact__c.Fields.Name.Label}"/>';
		l['primaryind'] = '<apex:outputText value="{!$Label.kimbleone__primarybillingcontact}"/>';
		l['delete'] = '<apex:outputText value="{!$Label.kimbleone__deletebutton}"/>';
			
		jQuery(window).load(function()
		{
			jQuery(document).off('click', '.has-children .indent');
			jQuery(document).on('click', '.has-children .indent', function (){
				var j = jQuery(this).closest('tr');
				
				j.toggleClass('expanded');
				
				jQuery.each(jQuery('tr.child[parent-id="' + j.attr('node-id') + '"]'), function (i, obj) {
					
					if (j.hasClass('expanded'))
						jQuery(obj).show();
					else
						jQuery(obj).hide();
				});
				
				
			});

			var contextId = '<apex:outputText value="{!TheDeliveryGroup.Id}"/>';
			
			jQuery('div[pageSource]').each(function() {
	   		var theComponent = jQuery( this );
	   		var pageSourceName = theComponent.attr('pageSource');
	   		
	   		// kick off the population of the page with an ajax call
			jQuery.ajax({ url: kimble.pages[pageSourceName] + contextId})
				.done(function(html) {
					theComponent.empty();
					jQuery(html).appendTo("#" + theComponent.attr('id'));
					if(!jQuery('#miniCardBody').length) jQuery('#delivery-group-invoices-title').slideUp();
				})
				.fail(function(xhr, status, error) {
					if(error !=null && error !="") alert(error);								
				})				
			});
			
			initialisePageTips();
		});
				
		function sortByBillingContactName(a,b)
	   	{
	   		return (a.ContactName < b.ContactName) ? -1 : (a.ContactName > b.ContactName) ? 1 : 0; 
	   	}

		function findBillingContacts(params)
		{				
			var existingBillingContactIds = [];
			jQuery('.billing-contact-row:not(.deleted)').each(function() {existingBillingContactIds.push(jQuery(this).attr('contactId'));});
			
			var targetAccountId = (jQuery('select[id$="billingAccount"]:visible').val() != '' ? jQuery('select[id$="billingAccount"]:visible').val() : defaultAccountId);
			
			if(jQuery('[id$="billingAccountLookup"]:visible').length > 0)
			{
			    var theAccount = jQuery('[id$="billingAccountLookup"]:visible').parent().parent().find('.billing-account-lookup');
			    targetAccountId = (theAccount.text() != '' && theAccount.text() != undefined ? theAccount.text() : defaultAccountId); 
			}
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupInvoicesController.GetApplicableBillingContacts}',
		      		targetAccountId, existingBillingContactIds, params.term,
		     			function(result, event){          
