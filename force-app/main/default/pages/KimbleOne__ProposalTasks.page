<apex:page standardcontroller="KimbleOne__Proposal__c" sidebar="false" extensions="KimbleOne.FilesAndAttachmentsController">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="MaintainActivitiesforOpportuniti.html" MenuContextType="Proposal" MenuContextId="{!KimbleOne__Proposal__c.Id}" MenuContextName="{!KimbleOne__Proposal__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
 
	  
	<apex:messages />
 
	<apex:pageBlock title="{!$Label.kimbleone__reviewactionsheader}">

		<apex:pageBlockSection title="{!$Label.kimbleone__confirmtasksheader}" collapsible="false">
      
			<apex:relatedList list="ActivityHistories" />

			<apex:relatedList list="OpenActivities" />
    
		</apex:pageBlockSection>

	</apex:pageBlock>
      
	<apex:pageBlock title="{!$Label.kimbleone__reviewdocumentsheader}">

		<apex:pageBlockSection collapsible="false">
  
   	  		<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
			<apex:relatedList subject="{!KimbleOne__Proposal__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
			
		</apex:pageBlockSection> 

	</apex:pageBlock>
	<script>
		jQuery(document).ready(function() {
			if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
		});
	</script>
</apex:define>

</apex:composition>

</apex:page>