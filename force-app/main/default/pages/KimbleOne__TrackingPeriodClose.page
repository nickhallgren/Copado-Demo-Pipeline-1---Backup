<apex:page controller="KimbleOne.TrackingPeriodCloseController" action="{!RedirectOnLoad}" extensions="KimbleOne.SecurityController,KimbleOne.TooltipsController" sidebar="false" tabstyle="PeriodManagement__tab">

	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">

			<c:Menu DefaultHelpPage="CloseTrackingPeriod.html" MenuContextType="Organisation" MenuContextName="Period Management" ChildName="{!timePeriod.Name} - ({!timePeriod.KimbleOne__StartDate__c} {!$Label.kimbleone__to} {!timePeriod.KimbleOne__EndDate__c})"/>

		</apex:define>

		<apex:define name="Content">
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__jQueryBarGraph, 'jqBarGraph.1.1.min.js')}"/>
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
