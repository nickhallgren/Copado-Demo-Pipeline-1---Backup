												<apex:selectList value="{!TheSelectedResourceTypeId}" size="1" onChange="handleTypeFilterChange();">
													<apex:selectOptions value="{!TheResourceTypes}"/>
												</apex:selectList>
											</apex:pageBlockSectionItem>

										</apex:pageBlockSection>

										<div style="max-height:300px;overflow-y:auto">
											<apex:outputPanel id="resourceTablePanelMobile" layout="none">
												<apex:pageBlockTable value="{!TheResourcesToEmailFiltered}" var="resource">
													<apex:column >
														<apex:facet name="header">
																<input type="checkbox" class="AllResources" onchange="selectOrUnselectAllResource(this)" checked="checked"/>
														</apex:facet>
														<apex:inputField value="{!TheTimesheetReminderEmailsToSend[resource.Id].InputCheckbox__c}" styleClass="Resources" onChange="deselectResourceHeader(this)" />
													</apex:column>
													<apex:column value="{!resource.Name}"/>
												</apex:pageBlockTable>
											</apex:outputPanel>
										</div>

									</apex:pageBlock>
									<div style="width:350px;">
										<apex:pageMessage summary="{!$Label.kimbleone__configurationsetting4}" severity="info" strength="3"/>
									</div>
								</apex:outputPanel>
							</div>
						</apex:outputPanel>
					</apex:facet>
				</apex:actionStatus>

				<apex:pageBlock rendered="{!CanClosePeriod || (CanReopenPeriod)}" >
					<apex:commandButton rendered="{!CanClosePeriod && HasPermission['CloseTrackingPeriod']}" id="closeTrackingPeriodBtn" onclick="var d = confirmDelete();if(!d) return false;" action="{!closePeriod}" value="{!$Label.kimbleone__close}" oncomplete="SetFilterOptions();"/>
					<apex:commandButton rendered="{!CanReopenPeriod && HasPermission['RevertClosedTrackingPeriod']}" id="reOpenTrackingPeriodBtn" onclick="var d = confirmDelete();if(!d) return false;" action="{!reOpenPeriod}" value="{!$Label.kimbleone__reopenbutton}"/>
				</apex:pageBlock>

				<apex:actionFunction action="{!ChangeView}" name="changeView" rerender="ViewLoadingStatus" Status="ViewLoadingStatus" oncomplete="initialisePageTips();">
					<apex:param name="viewName" value="" />
					<apex:param name="businessUnitId" value=""/>
				</apex:actionFunction>
				<apex:actionFunction action="{!RemoveAllForecastUsageInPages}" name="deleteAllRecords"/>
				<apex:actionFunction action="{!GoPreviousPeriod}" name="GoPreviousPeriod" />
				<apex:actionFunction action="{!GoNextPeriod}" name="GoNextPeriod" />
				<apex:actionFunction action="{!ShowEmailPopup}" name="refreshEmailList" reRender="sendEmailPanel, sendMobileNotificationPanel" oncomplete="showModalBoxy(); handleTypeFilterChange();"/>
				<apex:actionFunction action="{!ShowNotificationPopup}" name="refreshMobileNotificationList" reRender="sendEmailPanel, sendMobileNotificationPanel" oncomplete="showModalBoxy();"/>
				<apex:actionFunction action="{!SetFilterOptions}" name="SetFilterOptions"/>
				<apex:actionFunction action="{!ApplyResourceTypeFilter}" name="applyTypeFilter" reRender="resourceTablePanel,resourceTableNoResultsPanel,resourceTablePanelMobile" onComplete="selectOrUnselectAllResource(jQuery('.AllResources'))"/>

			</apex:form>

		</apex:define>

	</apex:composition>

