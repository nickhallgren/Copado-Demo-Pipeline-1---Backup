	 	function deleteAllAssignmentUsage()
	 	{
	 		var periodId = '{!JSENCODE(timePeriod.Id)}';

	 		deleteAssignmentUsage($('.deleteAssignment:first'), periodId, $('.deleteAssignment:first').attr('assignmentId'), true);

	 	}

	 	function deleteAssignmentUsage(obj, periodId, assignmentId, removeAll)
	 	{
	 		var context = $(obj);
	 		context.data('removeAll', removeAll);
	 		context.hide();
	 		context.next().show();

	 		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPeriodCloseController.DeleteForecastUsage}',
            periodId, assignmentId,
            function(result, event){

                if (event.status)
                {
                	var assignmentId = event.result;
                	var context = $('[assignmentId=' + assignmentId + ']');

                	context.removeClass('deleteAssignment');
                	context.closest('tr').hide();

                	if (context.data('removeAll'))
                		deleteAllAssignmentUsage();
            	}
            	else if (event.type === 'exception')
            	{
                	var assignmentId = event.data[1];
                	var context = $('[assignmentId=' + assignmentId + ']');
                	context.removeClass('deleteAssignment');
                	context.addClass('assignmentError');
                	context.next().hide();
                	context.next().next().attr('title',event.message);
                	context.next().next().show();
                	if (context.data('removeAll'))
                		deleteAllAssignmentUsage();
            	}
            	else
            	{
                	alert(event.message);
            	}
            },
            {escape: true, timeout: 60000}
        );
	 	}

