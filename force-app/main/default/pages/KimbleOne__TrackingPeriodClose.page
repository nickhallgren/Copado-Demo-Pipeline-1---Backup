											<apex:outputLink value="{!$Page.KimbleOne__BidTeamAssignments}?id={!itm.TheActivity.Id}" rendered="{!!ISBLANK(itm.TheActivity.KimbleOne__Proposal__c)}"><apex:outputText value="{!itm.TheActivity.KimbleOne__FullName__c}"/></apex:outputLink>
