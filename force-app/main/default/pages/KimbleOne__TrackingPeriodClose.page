				}
		</style>

			<apex:outputPanel layout="none" id="ErrorMessagesSection">
				<apex:pageMessages escape="false"/>
			</apex:outputPanel>

			<apex:form id="JobForDeleteAssignmentForm">
				<div id="JobForDeleteAssignmentPopup" style="display:none; height:300px;">
					<apex:outputPanel id="JobForDeleteAssignmentPopupPanel">
						<div id="jobsPanel" style="height:250px; width:550px;"></div>
					</apex:outputPanel>
				</div>
			</apex:form>

			<apex:pageMessage summary="{!$Label.kimbleone__errors}" severity="error" strength="2" rendered="{!!ISBLANK(errorsList) && errorsList.size>0}">
				<ul style=" margin:0px ;padding:0">
					<apex:repeat value="{!errorsList}" var="msg">
						<li id="" >
							<apex:outputText value="{!msg.Message}"/>
							<apex:outputPanel rendered="{!msg.SubMessageLinks.Size>0}">
								<ul style=" margin:0px ;padding:0">
									<li>
										<apex:repeat value="{!msg.SubMessageLinks}" var="msglink">
											<apex:outputLink target="expenseview"  value="{!$Page.KimbleOne__ExpenseClaimApprove}?Id={!msglink.link}">
												<apex:outputText value="{!msglink.SubMessageText}"/>
											</apex:outputLink>&nbsp; &nbsp;
										</apex:repeat>
									</li>
								</ul>
							</apex:outputPanel>
						</li>
					</apex:repeat>
				</ul>
			</apex:pageMessage>

			<apex:form id="TheForm">
				<div style="position:relative">
					<div>

						<div id="FilterPopup" style="display:none;">

							<div id="Filters">
								<div class="filter-header">{!$Label.kimbleone__filter}<i onclick="jQuery('#FilterPopup').hide();" class="filter-collapse-btn fa fa-angle-double-up" title="{!$Label.kimbleone__close}"></i></div>

								<apex:repeat value="{!TheFilterCriteriaOptions}" var="criterion">

									<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'REFERENCE'}">
										<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!criterion.Name}</div>
										<input class="criteria-filter lookup-filter" data-key="{!criterion.Key}" data-lookup-object-type="{!criterion.LookupObjectType}" data-object-type="{!criterion.ObjectType}" data-data-source="{!criterion.DataSource}" data-field-name="{!criterion.FieldName}" data-display-type="{!criterion.DisplayType}" type="hidden" id="criterion-{!JSINHTMLENCODE(criterion.Name)}" style="width:100%"/>
									</apex:outputPanel>

									<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'PICKLIST' || criterion.DisplayType == 'MULTIPICKLIST'}">
										<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!criterion.Name}</div>
										<input class="criteria-filter picklist-filter" data-key="{!criterion.Key}" data-display-type="{!criterion.DisplayType}" type="hidden" id="criterion-{!JSINHTMLENCODE(criterion.Name)}" style="width:100%"/>
									</apex:outputPanel>

									<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'BOOLEAN'}">
										<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!JSINHTMLENCODE(criterion.Name)}<input data-key="{!criterion.Key}" data-object-type="{!criterion.ObjectType}" data-field-name="{!criterion.FieldName}" data-display-type="{!criterion.DisplayType}" style="margin-bottom: 0px; vertical-align: bottom;" type="checkbox"  id="criterion-{!criterion.Name}" class="criteria-filter boolean-filter"/></div>
									</apex:outputPanel>

									<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'NUMERIC' || criterion.DisplayType == 'DATE'}" >
										<div style="margin-top:8px;margin-left:8px;font-size: 1em;font-weight: bold;color: #4a4a56;margin-bottom: 3px;">{!JSINHTMLENCODE(criterion.Name)}</div>
										<table border="0" cellpadding="0" cellspacing="0" style="font-size: 11px;color: #4a4a56;" data-key="{!criterion.Key}" data-display-type="{!criterion.DisplayType}" class="criteria-filter {!criterion.DisplayType}-filter"  id="{!JSINHTMLENCODE(criterion.Name)}">
											<tr>
												<td><span style="margin-left: 4px;">{!$Label.LessThanLabel}</span></td>
												<td><span style="margin-left: 4px;">{!$Label.EqualToLabel}</span></td>
												<td><span style="margin-left: 4px;">{!$Label.GreaterThanLabel}</span></td>
											</tr>
											<tr>
												<td style="padding-right: 2px;">
													<div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;">
														<input id="{!JSINHTMLENCODE(criterion.Name)}-lt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;" data-key="{!criterion.Key}" data-display-type="{!criterion.DisplayType}" />
													</div>
												</td>
												<td style="padding-right: 2px;">
													<div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;">
														<input id="{!JSINHTMLENCODE(criterion.Name)}-eq-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;" data-key="{!criterion.Key}" data-display-type="{!criterion.DisplayType}"/>
													</div>
												</td>
												<td style="padding-right: 2px;">
													<div style="border: 2px solid #E0E0E0;height: 25px;width: 57px;padding-left: 4px;vertical-align: middle;display: table-cell;">
														<input id="{!JSINHTMLENCODE(criterion.Name)}-gt-filter" type="text" style="width: 57px;font-size: 11px;border: 0;outline: 0;" data-key="{!criterion.Key}" data-display-type="{!criterion.DisplayType}"/>
													</div>
												</td>

											</tr>
										</table>
									</apex:outputPanel>

								</apex:repeat>

								<input class="btn" id="applyFilterButton" onclick="applyFilter();" type="Button" value="{!$Label.GoButton}"/>

								<input class="btn" id="clearFilterButton" onclick="clearFilter();" type="Button" value="{!$Label.ClearAllLabel}"/>

								<span>
                			<label>Save this as my default</label>
                			<input type="checkbox" id="saveAsDefault"/>
           				</span>

							</div>

							<apex:actionFunction action="{!saveFilter}" name="SaveFilterParam" reRender="TheForm">
								<apex:param name="filterParam" value="" />
								<apex:param name="urlDetail" value="" />
							</apex:actionFunction>

							<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
							<div style="display:none;" kimble-tip="null"></div>

							<script>

                var filterApplied = false;
                var basePageUrl;

                function initialiseFilter(pageUrl)
                {
                    basePageUrl = pageUrl;
                    <apex:repeat value="{!TheFilterCriteriaOptions}" var="criterion">

                        <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'REFERENCE'}">
                            jQuery('[id="criterion-{!criterion.Name}"]').select2({
                                    minimumInputLength: 1,
                                    multiple: true,
                                    query: function (query) {
                                        var $t = this;
                                        var find = function() {lookupCriterion($t.element.data(), query);};
                                        find();
                                    }
                                });
                                //needs to be json format {id: "a2K1t0000009X04EAE", text: "Director"}
                            jQuery('[id="criterion-{!criterion.Name}"]').select2('data', lookupObjectNames('{!criterion.LookupObjectType}', '{!criterion.DefaultValue}'));

                        </apex:outputPanel>

                        <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'BOOLEAN'}">

                            if ('{!criterion.DefaultValue}'){
                                jQuery('[id="criterion-{!criterion.Name}"]').prop('checked', true);
                                filterApplied = true;
                            }

                        </apex:outputPanel>

                        <apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'NUMERIC' || criterion.DisplayType == 'DATE'}">
							if('{!criterion.DefaultValue}')
							{
							     var defaultValues = '{!criterion.DefaultValue}'.split(':');

            					defaultValues.forEach(function(item){
            					    if(item.includes('lessThan')){jQuery('[id="{!criterion.Name}-lt-filter"]').val(item.replace('lessThan',''));}
									if(item.includes('equalTo')){jQuery('[id="{!criterion.Name}-eq-filter"]').val(item.replace('equalTo',''));}
									if(item.includes('greaterThan')){jQuery('[id="{!criterion.Name}-gt-filter"]').val(item.replace('greaterThan',''));}
                 				});
                 				filterApplied = true;
       						}

       						if('{!criterion.DisplayType}' == 'DATE')
       						{
       						    jQuery('[id="{!criterion.Name}"] :input').each(function(){jQuery(this).addClass('kimbleDatePicker');});
             				}

                     	</apex:outputPanel>

                     	<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'PICKLIST' || criterion.DisplayType == 'MULTIPICKLIST'}">

                     		var optionData = [];
                     		<apex:repeat value="{!criterion.TheOptions}" var="opt">
                     			var optItem = {id:'{!opt.Value}',text:'{!opt.Label}'};
                     			optionData.push(optItem);
                     		</apex:repeat>

                            jQuery('[id="criterion-{!criterion.Name}"]').select2({
                                    minimumInputLength: 1,
                                    multiple: true,
									data: optionData
                                });

                            jQuery('[id="criterion-{!criterion.Name}"]').select2('val','{!criterion.DefaultValue}'.split(','));
                            if('{!criterion.DefaultValue}'){filterApplied = true;}

                     	</apex:outputPanel>
                    </apex:repeat>

                    if (filterApplied)
                    {
                        jQuery('.filter-button').addClass('toolbar-button-selected');
                    }

                }

				function clearFilter()
				{
					var url = basePageUrl;

					jQuery.each(jQuery('.criteria-filter:not(div)'), function(i, obj) {
						var $obj = jQuery(obj);
                        url += '&' + $obj.data().key + '=';
						$obj.select2("val", "");

					jQuery('[id="' + $obj.attr('id') + '"] :input').each(function(){
					    	jQuery(this).val('');
     					});
					});

					jQuery.each(jQuery(".boolean-filter"), function(i,obj) {
					    var $obj = jQuery(obj);
					    $obj.prop("checked", false);
					});

					jQuery("#saveAsDefault").prop('checked', false);
				}

				function applyFilter()
				{
					jQuery('#FilterPopup').hide();

					var url = basePageUrl;
					var jsonVal = '{ \"Tracking\": {';
					var data = jQuery('.criteria-filter:not(div)');

					jQuery.each(jQuery('.criteria-filter:not(div)'), function(i, obj) {

						var isLastElement = i == data.length -1;
						var $obj = jQuery(obj);

						if($obj.data().displayType == 'REFERENCE' || $obj.data().displayType == 'PICKLIST' || $obj.data().displayType == 'MULTIPICKLIST'){
							url += '&' + $obj.data().key + '=' + $obj.val();
      					}
      					else if($obj.data().displayType == 'BOOLEAN'){
      						if($obj.prop('checked')){url += '&' + $obj.data().key + '=' + true;}
           				}
           				else if($obj.data().displayType == 'NUMERIC' || $obj.data().displayType == 'DATE'){

           				    	var critString = '&' + $obj.data().key + '=';

								var assembledValues = assembleNumericFilters($obj);

								if(assembledValues.hasValues)
								{
									critString += assembledValues.stringValue;
									url += critString;
        						}
               			}

                        if ($('#saveAsDefault').is(":checked"))
						{

						    if($obj.data().displayType == 'REFERENCE' || $obj.data().displayType == 'PICKLIST' || $obj.data().displayType == 'MULTIPICKLIST'){
						        jsonVal += '\"'+$obj.data().key+'\" :';
								jsonVal += '\"'+$obj.val()+'\"';
          					}
          					else if($obj.data().displayType == 'BOOLEAN'){
          						jsonVal += '\"'+$obj.data().key+'\" :';

									if($obj.prop('checked')){
										jsonVal += '\"'+$obj.prop('checked')+'\"';
									}else{
										jsonVal += '\"'+'\"';
									}
               				}
               				else if($obj.data().displayType == 'NUMERIC' || $obj.data().displayType == 'DATE'){
								jsonVal += '\"'+$obj.data().key+'\" :';

								var assembledDefaultValues = assembleNumericFilters($obj);

								if(assembledValues.hasValues)
								{
								    jsonVal += '\"'+assembledValues.stringValue+'\"';
        						}else{
        						    jsonVal += '\"'+'\"';
              					}
                  			}

							if (!isLastElement) {
								jsonVal += ',';
							}
						}
					});

					if ($('#saveAsDefault').is(":checked"))
					{
						jsonVal += '}}';
						SaveFilterParam(jsonVal, url);

					}
					else
						safeNavigateToSForceURL(url);
				}

				function assembleNumericFilters($obj){

					var returnString = '';
					var hasCriteria = false;
					var isFirst = true;

						jQuery('[id="' + $obj.attr('id') + '"] :input').each(function(){

							var item = jQuery(this);

							var itemValue = '';

							if(item.val()){itemValue = getFormattedValue(item,$obj.data().displayType)};

							if(itemValue.length > 0){
								if(!isFirst){returnString += ':';}
								returnString += getOperator(item) + itemValue;
								hasCriteria = true;
								isFirst = false;
							}
						})

						var returnItem = {stringValue: returnString, hasValues : hasCriteria};
						return returnItem;
				}

				function getFormattedValue(item,displayType){

					var returnValue = '';

					if(displayType == 'DATE'){returnValue = item.val();}
					if(displayType == 'NUMERIC'){returnValue = item.val().replace(/\s/g,'').replace(/\D/g,'');}

					return returnValue;

				}

				function getOperator(obj){

				    var operatorString;
				    var id = obj.attr('id');

				    if(id.endsWith('-lt-filter')){operatorString = 'lessThan';}
				    if(id.endsWith('-eq-filter')){operatorString = 'equalTo';}
				    if(id.endsWith('-gt-filter')){operatorString = 'greaterThan';}

				    return operatorString;
    			}

				function lookupCriterion(d, query)
                {
                    Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TrackingPeriodCloseController.FindLookupValues}',
                        d.lookupObjectType, d.dataSource, d.fieldName, query.term,
                            function(result, event){
                                 if (event.status)
                                 {
                                    var data = {};

                                    data.results = result;
                                    query.callback(data);
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                        },
                        {escape: false, timeout: 60000}
                    );
                }

                function lookupObjectNames(objectType, values)
                {
                    //build sforce.connection.query to lookup values
                    if (values == '') return values;

                    var param = values.split(',').join('\',\'');

                    var result = sforce.connection.query("SELECT Id, Name FROM " + objectType + " WHERE Id IN ('" + param + "')");

                    var records = [];

                    if (!jQuery.isArray(result.records))
                        records.push(result.records);
                    else
                        records = result.records;

                    var data = [];

                    for (var i=0;i<records.length;i++)
                    {
                        data.push({id:records[i].Id, text:records[i].Name});
                    }

                    filterApplied = true;

                    return data;
                }

                function selectOrUnselectAllResource(theControl){
                    var control = jQuery(theControl);
                    if(control.is(':checked')){
                        jQuery('.Resources').prop('checked', true);
                    }
					else{
					    jQuery('.Resources').prop('checked', false);
					}
                }

				function deselectResourceHeader(theControl){
					var control = jQuery(theControl);
                    if(!control.is(':checked')){
                        jQuery('.AllResources').prop('checked', false);
                    }
                }

				function defaultResourceCheckBoxes(){
					jQuery('.AllResources').prop('checked', true); jQuery('.Resources').prop('checked', true);
				}

				function handleTypeFilterChange()
				{
				    jQuery('.Resources').prop('checked',false);
				    applyTypeFilter();
				    selectOrUnselectAllResource(jQuery('.AllResources'));
    			}
    	</script>
