													<apex:selectOptions value="{!TheEmailTemplates}" />
												</apex:selectList>
											</apex:pageBlockSectionItem>

											<apex:pageBlockSectionItem rendered="{!TheResourceTypes.size > 1}">
												<apex:outputLabel value="{!$ObjectType.KimbleOne__ResourceType__c.LabelPlural}"/>
												<apex:selectList value="{!TheSelectedResourceTypeId}" size="1" onChange="handleTypeFilterChange();">
													<apex:selectOptions value="{!TheResourceTypes}"/>
												</apex:selectList>
											</apex:pageBlockSectionItem>

										</apex:pageBlockSection>
