			</apex:outputPanel>

			<apex:relatedList list="ActivityHistories" id="InvoiceActivities"></apex:relatedList>

			<div id="newCreditNotePopup" style="display: none">
				<apex:outputPanel id="newCreditNotePanel">
					<apex:form >
						<apex:pageBlock >
							<div id="creditNoteErrors"><apex:pageMessages escape="false"/></div>
							<apex:pageBlockButtons location="bottom">
								<apex:commandButton value="{!$Label.kimbleone__save}" 	styleclass="DisableButtonWhileBusy" action="{!CreateCreditNote}" oncomplete="hideModalBoxyWithErrorCheck('#creditNoteErrors')" rerender="TheForm" />
								<input class="btn" type="button" onclick="hideModalBoxy();"
									   value="{!$Label.Cancel}" />
							</apex:pageBlockButtons>
							<apex:pageBlockSection columns="1">
								<apex:inputField id="creditNoteDate" required="true"
												 value="{!newCreditNote.KimbleOne__CreditNoteDate__c}" />
								<apex:pageBlockSectionItem >
									<apex:outputLabel for="reasonCode" value="{!$ObjectType.KimbleOne__CreditNote__c.Fields.KimbleOne__ReasonCode__c.Label}" />
									<apex:selectList id="reasonCode" value="{!newCreditNote.KimbleOne__ReasonCode__c}" size="1">
										<apex:selectOptions value="{!TheCreditNoteReasonCodes}"/>
									</apex:selectList>
								</apex:pageBlockSectionItem>
								<apex:inputField id="reasonDescription" required="true"
												 value="{!newCreditNote.KimbleOne__ReasonDescription__c}" />
							</apex:pageBlockSection>
						</apex:pageBlock>
					</apex:form>
				</apex:outputPanel>
			</div>

			<div id="selectDownloadTypePopup" style="display: none">
				<apex:outputPanel id="selectDownloadTypePanel">
					<apex:form >
						<apex:pageBlock >
							<div id="selectDownloadTypeErrors"><apex:pageMessages escape="false"/></div>
							<apex:pageBlockButtons location="bottom">
								<apex:commandButton value="{!$Label.kimbleone__ok}" styleclass="DisableButtonWhileBusy" onclick="downloadFile();" oncomplete="hideModalBoxyWithErrorCheck('#dowloadErrors')" rerender="selectDownloadTypePanel"/>
								<input class="btn" type="button" onclick="hideModalBoxy();"	value="{!$Label.Cancel}" />
							</apex:pageBlockButtons>
							<apex:pageBlockSection columns="1">
								<apex:outputPanel id="expenseDownloadTypesId">
									<apex:pageBlockSectionItem >
										<apex:outputLabel for="downloadTypes" value="{!$Label.kimbleone__downloadtypelabel}" />
										<apex:selectList styleClass="expenseDownloadTypeSelector" size="1">
											<apex:selectOptions value="{!TheExpenseItemDownloadTypes}"/>
										</apex:selectList>
									</apex:pageBlockSectionItem>
								</apex:outputPanel>
								<apex:outputPanel id="timeEntryDownloadTypesId">
									<apex:pageBlockSectionItem >
										<apex:outputLabel for="downloadTypes" value="{!$Label.kimbleone__downloadtypelabel}" />
										<apex:selectList styleClass="timeDownloadTypeSelector" size="1">
											<apex:selectOptions value="{!TheTimeEntryDownloadTypes}"/>
										</apex:selectList>
									</apex:pageBlockSectionItem>
