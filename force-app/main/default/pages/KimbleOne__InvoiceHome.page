				function hideSalesForceApprovalProcessButtons()
				{
						$('input[name="piSubmit"]').remove();
						$('input[name="piRemove"]').remove();
				}

				function performDownloads(){
					var selectedDocsStr = '';

					$('.document-cb:checked').each(function(i, el) {
						selectedDocsStr = selectedDocsStr + $(el).attr('data-id')+',';
    					window.open('/servlet/servlet.FileDownload?file='+$(el).attr('data-id'));
    				});


    				$('.SelectedDocuments').val(selectedDocsStr);
				}
