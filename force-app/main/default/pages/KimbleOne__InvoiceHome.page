				</apex:outputPanel>
			</div>

			<apex:include pageName="{!$Page.ExpenseExport}"/>

			<script>

				var logoData = '{!JSENCODE(LogoData)}';
				var logoContentType = '{!JSENCODE(LogoContentType)}';
				var maxSizeLabel = '{!JSENCODE($Label.EmailAttachmentsExceedLimit)}';
				function initialiseEmailComplete()
				{
					if ({!AttachmentConversionEnabled})
					{
					    currentBoxy.hide();

					    var ongenerateComplete = function() {
					        //Validate pdf to email size - thePdfToDownload.output().length / 1024 / 1024 - 26214400 (25 MB)
					        if (thePdfToDownload.output().length > 26214400) {
					            alert(maxSizeLabel.format('25MB'));
					            return;
                            }

					        jQuery('#loadingIndicatorOuterContainer').show();

					        var attachment = new sforce.SObject("Attachment");
					        attachment.Name = 'tmp.pdf';
                			attachment.ContentType = 'application/pdf';
                			attachment.Body = btoa(thePdfToDownload.output())
                			attachment.ParentId = '{!JSENCODE(CombinedAttachmentsParentId)}';

							sforce.connection.create([attachment],
							{
								 onSuccess : function(result, source)
								 {
									 if(result[0].getBoolean("success")) {

										 console.log('file added successfully:' + result[0].id);
										 jQuery('[id$="CombinedAttachmentsId"').val(result[0].id);

									     jQuery('#loadingIndicatorOuterContainer').hide();

									     currentBoxy.show();
					        			 showModalBoxy();
									 }
								 },
								 onFailure : function(error, source)
								 {
								 	    console.log(error);
								 	    alert(error);
								 	    jQuery('#loadingIndicatorOuterContainer').hide();
         						 }

                     		});
					    }

					    generateAttachments('{!JSENCODE(Invoice__c.Id)}', '{!JSENCODE(Invoice__c.Reference__c)}',{showLogo:<apex:outputText value="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowLogo__c}"/>, showFooter:<apex:outputText value="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowFooter__c}"/>, showPageNumbers:<apex:outputText value="{!KimbleOne__Invoice__c.InvoiceTemplate__r.KimbleOne__ShowPageNumbers__c}"/>, footerText:'<apex:outputText value="{!JSENCODE(KimbleOne__Invoice__c.BusinessUnitTradingEntity__r.KimbleOne__InvoiceFooter__c)}"/>', logoWidth:{!JSENCODE($Label.INVOICEPRINTT1ImageWidth)}, logoHeight:{!JSENCODE($Label.INVOICEPRINTT1ImageHeight)}, logoData:logoData, logoContentType:logoContentType} , ongenerateComplete)
     				}
     				else
     				{
     					showModalBoxy();
         			}
    			}

				function downloadFile()
				{
					var docName = document.getElementsByClassName("documentName")[0].value;
					var docIsCustom = document.getElementsByClassName("documentIsCustom")[0].value;
					var docObjectType = document.getElementsByClassName("documentObjectType")[0].value;
					var e;

					if (docObjectType.includes('TimeEntry__c') && docIsCustom)
						e = document.getElementsByClassName("timeDownloadTypeSelector")[0];
					else
						e = document.getElementsByClassName("expenseDownloadTypeSelector")[0];

					var intTypeId = e.options[e.selectedIndex].value;
					safeNavigateToSForceURL('{!$Page.InterfaceTypeGenerateOutput}?id={!TheInvoice.Id}&intType=' + intTypeId + '&fileName=' + docName);
				}

				function updateHiddenDocumentFields(fileName, isCustom, objectType)
				{
					var docName = document.getElementsByClassName("documentName")[0];
					docName.value = fileName;
					var docIsCustom = document.getElementsByClassName("documentIsCustom")[0];
					docIsCustom.value = isCustom;
					var docObjectType = document.getElementsByClassName("documentObjectType")[0];
					docObjectType.value = objectType;

					if (objectType.includes('TimeEntry__c') && isCustom)
					{
						jQuery('[id$="timeEntryDownloadTypesId"]').show();
						jQuery('[id$="expenseDownloadTypesId"]').hide();
					}
					else
					{
						jQuery('[id$="expenseDownloadTypesId"]').show();
						jQuery('[id$="timeEntryDownloadTypesId"]').hide();
					}
				}

                /* Tooltips */
                var enableTips = <apex:outputText value="{!TooltipsEnabled}"/>;
                var BaseHelpURL = '<apex:outputText value="{!URLFOR($Resource.KimbleOne__KimbleHelp, '')}"/>';
                var DetailedHelpLabel = '<apex:outputText value="{!$Label.kimbleone__detailedhelp}"/>';
                var MoreLabel = '<apex:outputText value="{!$Label.kimbleone__more}"/>';
				var TipsEnabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsenabled}"/>';
				var TipsDisabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsdisabled}"/>';

                function initialisePageTips()
                {
                    ApplyTipAttributes();
                    initialiseTips();
                }

                // add tip attributes to elements

                function ApplyTipAttributes()
                {
                    if(enableTips)
                    {
                        // Invoice Details
                        jQuery('[id$="invoiceAccount"]').attr('kimble-tip','Account');
                        jQuery('[id$="invoiceContact"]').attr('kimble-tip','Contact');
                        jQuery('[id$="invoiceStatus"]').attr('kimble-tip','Status');
                        jQuery('[id$="invoiceDate"]').attr('kimble-tip','InvoiceDate');
                        jQuery('[id$="invoiceNetAmount"]').attr('kimble-tip','NetAmount');
                        jQuery('[id$="invoiceGrossAmount"]').attr('kimble-tip','GrossAmount');
                        jQuery('[id$="invoiceTaxCode"]').attr('kimble-tip','TaxCode');
                        jQuery('[id$="invoiceTaxAmount"]').attr('kimble-tip','TaxAmount');
                        jQuery('[id$="purchaseOrderReference"]').attr('kimble-tip','PurchaseOrder');
                        jQuery('[id$="invoiceRecBankAccount"]').attr('kimble-tip','ReceivableBankAccount');
                        jQuery('[id$="invoiceNotes"]').attr('kimble-tip','Notes');
                        jQuery('[id$="invoice-reference"]').attr('kimble-tip','Reference');
                        jQuery('[id$="theDispatchedInvoiceFilename"]').attr('kimble-tip','TheDispatchedInvoice');

			            // Element Fields
                        jQuery('[id$="invoiceLineNarrativeheader"]').attr('kimble-tip','Narrative');
                        jQuery('[id$="invoiceLineNumberheader"]').attr('kimble-tip','LineNumber').attr('kimble-tip-extended-text','LineNumberExtendedText');
                        jQuery('[id$="invoiceLineNetAmountheader"]').attr('kimble-tip','NetAmountLine');
                        jQuery('[id$="invoiceLineTaxAmountheader"]').attr('kimble-tip','TaxAmountLine');

                        // buttons
                        jQuery('[id$="downloadBtn"]').attr('kimble-tip','Download');
                        jQuery('[id$="deleteInvoiceBtn"]').attr('kimble-tip','Delete');
                        jQuery('[id$="raiseCreditNoteBtn"]').attr('kimble-tip','RaiseCreditNote').attr('kimble-tip-extended-text','RaiseCreditNoteExtendedText');
                        jQuery('[id$="dispatchAndSendEmailBtn"]').attr('kimble-tip','DispatchAndEmail').attr('kimble-tip-extended-text','DispatchAndEmailExtendedText');
                        jQuery('[id$="revertToDraftBtn"]').attr('kimble-tip','RevertToDraft').attr('kimble-tip-extended-text','RevertToDraftExtendedText');
                        jQuery('[id$="sendInvoiceForApprovalBtn"]').attr('kimble-tip','SendForApproval');
                        jQuery('[id$="sendEmailBtn"]').attr('kimble-tip','SendEmail');
                        jQuery('[id$="dispatchInvoiceBtn"]').attr('kimble-tip','Dispatch').attr('kimble-tip-extended-text','DispatchExtendedText');

                        // other
                        jQuery('[id$="InvoiceApprovalHistory"]').attr('kimble-tip','ApprovalHistory');
                        jQuery('[id$="expenseDownloadsSection"]').attr('kimble-tip','DownloadsFile');
                }
            }

            function updateTipsConfigSetting(newTipSetting)
            {
                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
                    newTipSetting,
                        function(result, event){
                            if (event.status)
                            {
                                var data = {};
                                data.results = result;
                                loadGuidance();
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {escape: false, timeout: 60000}
                );
            }

			</script>

		</apex:define>
	</apex:composition>

</apex:page>