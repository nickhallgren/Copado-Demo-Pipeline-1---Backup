<apex:page standardController="KimbleOne__ExpenseClaim__c" recordSetVar="ExpenseClaims" extensions="KimbleOne.ExpenseClaimPaymentController" showHeader="true" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">
	 
<apex:define name="Content">
<apex:form id="TheForm">
			<apex:outputPanel id="pageErrors">
    		<apex:pageMessages escape="False" />
    		
		</apex:outputPanel>
		
		<apex:pageBlock title="{!$ObjectType.KimbleOne__ResourcePayment__c.Label}" mode="edit">
			<apex:pageBlockSection collapsible="false" showheader="false" columns="2">
				
				<apex:pageBlockSectionItem >
	           		<apex:outputLabel value="{!$ObjectType.KimbleOne__Resource__c.Label}"/>
	           		<apex:actionRegion >
	           		<apex:inputField value="{!resourcePayment.KimbleOne__Resource__c}" required="true" rendered="{!(hasError)}">
	           			<apex:actionSupport event="onchange" action="{!referesh}" rerender="ExpenseClaimsPanel"   />
	           		</apex:inputField>
	           		<apex:outputField value="{!resourcePayment.KimbleOne__Resource__c}" rendered="{!(!hasError)}"/>
	           		</apex:actionRegion>
	           </apex:pageBlockSectionItem>
				
				<apex:inputField value="{!resourcePayment.Name}" required="true"/>
				<apex:inputField value="{!resourcePayment.KimbleOne__PaymentDate__c}" styleClass="kimbleDatePicker" required="true"/>
				
				<apex:pageBlockSectionItem >
					<apex:outputText value="{!$ObjectType.KimbleOne__ResourcePayment__c.Fields.KimbleOne__PaymentAmount__c.Label} {!resource.KimbleOne__ExpenseReimbursementCurrencyIsoCode__c}" />
					<apex:inputField value="{!resourcePayment.KimbleOne__PaymentAmount__c}" required="true"/>
				</apex:pageBlockSectionItem>
				
			</apex:pageBlockSection>
			
			<apex:pageBlockButtons location="bottom">
				<apex:commandButton action="{!SaveResourcePayment}" onComplete="initialiseItems();" rendered="{!(!hasError)}"
							value="{!$Label.kimbleone__save}" rerender="TheForm" styleclass="DisableButtonWhileBusy" />
				<apex:commandButton action="{!CancelPage}" rerender="TheForm"
							value="{!$Label.kimbleone__cancel}" styleclass="DisableButtonWhileBusy" immediate="true"/>			
			</apex:pageBlockButtons>
        
		</apex:pageBlock>

        <apex:pageBlock title="{!$ObjectType.KimbleOne__ExpenseClaim__c.LabelPlural}">
        
            <apex:pageBlockTable value="{!Selected}" var="claim">

	 			<apex:column value="{!claim.KimbleOne__Reference__c}" headerValue="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__Reference__c.Label}" style="width:20%" />
				<apex:column value="{!claim.KimbleOne__ResourcedActivity__c}" headerValue="{!$Label.kimbleone__activity}" style="width:30%" />
				<apex:column headerValue="{!$ObjectType.KimbleOne__ExpenseClaim__c.Fields.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c.Label}" style="width:30%" >
	               	<apex:outputText value="{!claim.KimbleOne__ReimbursementCurrencyIsoCode__c}" styleclass="kimbleCurrencyCode" />
	               	<apex:outputField value="{!claim.KimbleOne__ReimbursementCcyTotalReimbursementAmount__c}" />
	           	</apex:column>
				<apex:column value="{!claim.KimbleOne__Resource__c}" rendered="false" />
				<apex:column value="{!claim.KimbleOne__Status__c}" rendered="false" />

	        </apex:pageBlockTable> 

	    </apex:pageBlock>
        
	</apex:form>
<script>

	jQuery(window).load(function(){
		initialiseItems();
	});
	function initialiseItems()
	{
		SetupDatePicker();
	}
	function SetupDatePicker()
	{
		//dateFormat: 'yy-mm-dd',
		jQuery('.kimbleDatePicker').datepicker({
				dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
				showOtherMonths: true,
				selectOtherMonths: true,
				changeMonth: true,
				changeYear: true});
	}

</script>
</apex:define>

</apex:composition>

</apex:page>