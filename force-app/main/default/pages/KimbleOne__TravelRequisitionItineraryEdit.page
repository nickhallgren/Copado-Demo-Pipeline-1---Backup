<apex:page standardController="KimbleOne__TravelRequisition__c" sidebar="false" extensions="KimbleOne.TravelRequisitionItineraryEditController" action="{!CheckStatus}">

<apex:composition template="KimbleOne__SiteMaster">
	 
<apex:define name="Menu"><c:Menu MenuContextName="{!KimbleOne__TravelRequisition__c.Name}"/></apex:define>
	
<apex:define name="Content">
    	<div id="left" style="float:left;width:75%" >
			<apex:form id="TheForm">
			<apex:outputPanel id="ThePage">
			<apex:pageMessages escape="False" />
				
			<apex:outputPanel layout="none" rendered="{!ISBLANK(TheRequisitionVersion)}">
			<apex:pageBlock title="{!$Label.kimbleone__travelrequestheading}" >
			<apex:pageBlockButtons location="top">
           		
           		<apex:commandButton action="{!Cancel}" value="{!$Label.kimbleone__cancel}"/>
           		<apex:commandButton action="{!Save}" styleclass="DisableButtonWhileBusy" value="{!$Label.kimbleone__save}" reRender="TheForm"/>
           		       		
            </apex:pageBlockButtons>
            
			<apex:pageblockSection collapsible="false" showheader="false" columns="2" >
           	
           	<apex:outputField value="{!KimbleOne__TravelRequisition__c.KimbleOne__Resource__c}" />
           	
           	<apex:pageBlockSectionItem >
           		<apex:outputLabel value="{!$ObjectType.KimbleOne__TravelRequisition__c.Fields.KimbleOne__TravelFromDate__c.Label}"/>
           		<apex:outputPanel >
           			<apex:outputField value="{!KimbleOne__TravelRequisition__c.KimbleOne__TravelFromDate__c}"/>
           			<apex:outputPanel layout="none" rendered="{!!ISBLANK(KimbleOne__TravelRequisition__c.KimbleOne__TravelToDate__c)}">
           				<apex:outputField value="{!KimbleOne__TravelRequisition__c.KimbleOne__TravelToDate__c}"/>
           			</apex:outputPanel>
           		</apex:outputPanel>
           	</apex:pageBlockSectionItem>
           	
           	<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.KimbleOne__TravelRequisition__c.Fields.KimbleOne__Status__c.Label}"/>
					<apex:outputText value="{!KimbleOne__TravelRequisition__c.Status__r.Name}"/>
			</apex:pageBlockSectionItem>

			</apex:pageblockSection>
           
			<apex:pageBlockSection >
				<apex:repeat value="{!$ObjectType.KimbleOne__TravelRequisition__c.FieldSets.KimbleOne__TravelRequisitionDetails}" var="f" >
					<apex:outputField value="{!KimbleOne__TravelRequisition__c[f]}" />
	   			</apex:repeat>
			</apex:pageBlockSection>
        
        <apex:outputPanel >
        	
			<apex:outputPanel layout="none" rendered="{!TheRequisitionItemsSize['Flight'] != 0}">
        	<div class="travelCategoryHeading flight"><h2 style="margin-left: 32px;font-size: 1.2em;">{!$Label.kimbleone__flightsheading}</h2></div>
			<div class="travelCategoryContent">
        	
        		<apex:variable value="{!0}" var="rowNum"/> 
      			<apex:pageBlockTable value="{!TheRequisitionItems['Flight']}" var="itm">
      				<apex:column headervalue="{!$Label.kimbleone__detailsheading}">
      					<apex:outputPanel rendered="{!itm.ActionRequest__c != ActionRequestMap['None']}" style="color:red;">
      						(<apex:outputText value="{!itm.ActionRequest__r.Name}"/>)<br/>
      					</apex:outputPanel>
      					<apex:outputText escape="false" value="{!itm.Description__c}"/>
      				</apex:column>
       				<apex:column headervalue="{!$ObjectType.KimbleOne__TravelRequisitionItem__c.Fields.KimbleOne__RequisitionNotes__c.Label}" >
      					<apex:outputField value="{!itm.RequisitionNotes__c}" />
      				</apex:column>
      				<apex:column headervalue="{!$Label.kimbleone__itineraryoptionsandcostsheading}">
      					<table class="travelBasis" border="0" cellpadding="0" cellspacing="2">
      						<apex:variable value="{!0}" var="rowNum"/>
      						<apex:repeat value="{!TheItineraryItems[itm.Id]}" var="itinerary">
      							<tr>
      								<apex:outputPanel layout="none" rendered="{!itinerary.id != itm.SelectedTravelItineraryItem__c || ISBLANK(itm.SelectedTravelItineraryItem__c) || ISBLANK(itinerary.id)}">
      									<td rowspan="4">
      										<apex:outputLink style="color: #015BA7;text-decoration: none;" value="javascript:void(0)" onclick="removeItinerary( '{!JSINHTMLENCODE(itm.Id)}', {!ROUND(rowNum,0)})">{!$Label.kimbleone__remove}</apex:outputLink>
      									</td>
      								</apex:outputPanel>
      								<apex:outputPanel layout="none" rendered="{!itinerary.id = itm.SelectedTravelItineraryItem__c && !ISBLANK(itm.SelectedTravelItineraryItem__c)}">
      									<td rowspan="4" class="selectedOption">
      										&nbsp;
      									</td>
      								</apex:outputPanel>
      								
      								<td rowspan="4">
      									<apex:inputTextArea value="{!itinerary.ItineraryNotes__c}" cols="48" rows="8"/>
      									      									
      								</td>
      								<td style="width:60px">
      									<apex:selectList value="{!itinerary.CurrencyISOCode}" size="1">
											<apex:selectOptions value="{!TheCurrencies}" />
										</apex:selectList>
      								</td>
      								<td>
      									<apex:inputField value="{!itinerary.NetAmount__c}" style="width:70px;"/>      									
      								</td>
      							</tr>
      							<tr>
      								<td class="label">{!$ObjectType.KimbleOne__TravelItineraryItem__c.Fields.KimbleOne__FlightDepartureAirline__c.Label}</td>
      								<td><apex:inputField value="{!itinerary.FlightDepartureAirline__c}"/></td>
      							</tr>
      							<tr>
      								<td class="label">{!$ObjectType.KimbleOne__TravelItineraryItem__c.Fields.KimbleOne__FlightReturnAirline__c.Label}</td>
      								<td><apex:inputField value="{!itinerary.FlightReturnAirline__c}"/></td>
      							</tr>
      							<tr>
      								<td class="label">{!$ObjectType.KimbleOne__TravelItineraryItem__c.Fields.KimbleOne__RequiresApproval__c.Label}</td>
      								<td><apex:inputField value="{!itinerary.RequiresApproval__c}"/></td>
      							</tr>
      							<apex:variable value="{!rowNum+1}" var="rowNum"/>
      						</apex:repeat>
      						<apex:outputPanel layout="none" rendered="{!itm.ActionRequest__c != ActionRequestMap['CancelRequest']}">
