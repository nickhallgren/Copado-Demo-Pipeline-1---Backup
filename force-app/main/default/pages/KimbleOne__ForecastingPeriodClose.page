										<apex:column value="{!itm.TheActivity.KimbleOne__BusinessUnit__c}"/>
										<apex:column value="{!itm.TheActivity.OwnerId}"/>
										<apex:column headerValue="{!$Label.kimbleone__remainingusageheading}">
											<apex:pageBlockTable value="{!itm.ActivityPeriodAssignments}" var="apa">
												<apex:column value="{!apa.TrackingPeriodAssignment.KimbleOne__Resource__c}" style="width:115px"/>
												<apex:column headerValue="{!$ObjectType.KimbleOne__TimePeriod__c.Fields.KimbleOne__TrackingTimePeriod__c.Label}">
													<apex:outputLink value="{!$Page.KimbleOne__TrackingPeriodClose}?filterid={!apa.TrackingPeriodAssignment.TimePeriod__r.TrackingTimePeriod__r.Id}"><apex:outputText value="{!apa.TrackingPeriodAssignment.TimePeriod__r.TrackingTimePeriod__r.Name}"/></apex:outputLink>
												</apex:column>
												<apex:column value="{!apa.TrackingPeriodAssignment.ActivityAssignment__r.KimbleOne__ActivityRole__c}" style="width:115px"/>
												<apex:column headerValue="{!$Label.kimbleone__remaininghoursheading}" value="{!apa.RemainingUsageInHours.KimbleOne__InputDecimal__c}" style="width:25px"/>
											</apex:pageBlockTable>
										</apex:column>
									</apex:pageBlockTable>

									<div style="margin: 5px 0px 0px 1px;">
										<div style="text-align:left; width:50%; display:inline-block;">
											<apex:outputText value="{!ThePagedOtherBUGroupForecastUsage.CurrentPageDescription}"/>
										</div>
										<div style="text-align:right; width:50%; display:inline-block;">
											<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoPrevious}" rerender="TheViews" rendered="{!ThePagedOtherBUGroupForecastUsage.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
											<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedOtherBUGroupForecastUsage.CanGoPrevious}" value="{!$Label.kimbleone__previouspagelink}"/>
											&nbsp;|&nbsp;
											<apex:commandLink style="color: #015BA7;text-decoration: none;" action="{!GoNext}" rerender="TheViews" rendered="{!ThePagedOtherBUGroupForecastUsage.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
											<apex:outputText styleclass="greyedLink" rendered="{!!ThePagedOtherBUGroupForecastUsage.CanGoNext}" value="{!$Label.kimbleone__nextpagelink}"/>
										</div>
									</div>

								</apex:outputPanel>

							</apex:pageBlock>

						</apex:facet>
					</apex:actionStatus>

					<apex:pageBlock >
						<apex:commandButton rendered="{!CanClosePeriod && HasPermission['CloseForecastingPeriod']}" id="closeForecastingPeriodBtn" onclick="var d = confirmDelete();if(!d) return false;" action="{!closePeriod}" value="{!$Label.kimbleone__close}" oncomplete="SetFilterOptions();"/>
						<apex:commandButton rendered="{!CanReOpenPeriod && HasPermission['RevertClosedForecastingPeriod']}" id="reOpenForecastingPeriodBtn" onclick="var d = confirmDelete();if(!d) return false;" action="{!reOpenPeriod}" value="{!$Label.kimbleone__reopenbutton}"/>

					</apex:pageBlock>
					<apex:actionFunction action="{!ChangeView}" name="changeView" rerender="ViewLoadingStatus" Status="ViewLoadingStatus">
						<apex:param name="viewName" value="" />
					</apex:actionFunction>
					<apex:actionFunction action="{!GoPreviousPeriod}" name="GoPreviousPeriod" />
					<apex:actionFunction action="{!GoNextPeriod}" name="GoNextPeriod" />
					<apex:actionFunction action="{!SetFilterOptions}" name="SetFilterOptions" />

					<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
					<div style="display:none;" kimble-tip="null"></div>
				</apex:form>

			</div>
		</apex:define>

	</apex:composition>

</apex:page>