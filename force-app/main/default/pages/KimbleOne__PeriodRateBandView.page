<apex:page standardController="KimbleOne__PeriodRateBand__c" extensions="KimbleOne.PeriodRateBandViewController" sidebar="false">

	<apex:composition template="KimbleOne__SiteMaster">
	
		<apex:define name="Menu">
			<c:Menu MenuContextType="PeriodRateBand" MenuContextId="{!KimbleOne__PeriodRateBand__c.Id}" MenuContextName="{!KimbleOne__PeriodRateBand__c.Name}"/>
		</apex:define>
		 
		<apex:define name="Content">
		<apex:form >
			<apex:pageBlock id="PeriodRateBandViewBlock">
			
				<apex:pageblockSection collapsible="false" title="{!$Label.kimbleone__periodratebanddetailsheading}" columns="2">
				
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.Name}" />
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.KimbleOne__PeriodType__c}" />
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.KimbleOne__Priority__c}" />
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.KimbleOne__IsDefault__c}" />
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.KimbleOne__DefaultRevenueFactor__c}" />
					<apex:outputField value="{!KimbleOne__PeriodRateBand__c.KimbleOne__DefaultCostFactor__c}" />
					
				</apex:pageblockSection>

				<apex:pageBlockButtons location="bottom">
					<apex:commandButton action="{!EditPeriodRateBand}" value="{!$Label.kimbleone__edit}"/>
				</apex:pageBlockButtons>
			</apex:pageBlock>

		<script>
		</script>
		</apex:form>
		</apex:define>
	 
	</apex:composition>

</apex:page>