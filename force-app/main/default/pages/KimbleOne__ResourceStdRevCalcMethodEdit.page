<apex:page standardcontroller="KimbleOne__ResourceStandardRevenueCalcMethod__c" extensions="KimbleOne.ResourceStdRevCalcMethodEditController,KimbleOne.SecurityController,KimbleOne.TooltipsController" sidebar="false">
    <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
    <apex:composition template="KimbleOne__SiteMaster">
        <apex:define name="Menu">
            <c:Menu MenuContextId="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Id}" MenuContextName="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Name}" BreadCrumbLink="/{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.KeyPrefix}" BreadCrumbName="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.LabelPlural}"/>

        </apex:define>
        <apex:define name="Content">
            <apex:outputPanel id="MethodContainer" styleclass="method-container cardContainer" rendered="{!!ISBLANK(KimbleOne__ResourceStandardRevenueCalcMethod__c.Id)}" style="margin-bottom: 100px;">
                <div class="behaviour-rule card" style="margin-bottom: 30px;">
                    <div class="cardHeadingContainer">
                        <div style="display:table-row">
                            <div class="cardHeadingCell">
                                <div class="card-heading-icon fa fa-square" ></div>
                                <div class="card-title-container">
                                    <h3 class="cardTitle"><apex:outputText value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Name}"/></h3>
                                </div>
                            </div>
                            <div class="cardMenu cardHeadingCell cardHeadingCellFixed">
                                <div data-floating-dropdown="#{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Id}-menu-data" class="fa fa-bars behaviour-rule-menu burger-menu"></div>
                                <div class="deleting Loading" style="display:none"></div>
                                <div id="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
                                    <ul class="floating-dropdown-menu">
                                        <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.updateable}">
                                            <li><a href="javascript:editMethodClick();"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Label}</a></li>
                                        </apex:outputPanel>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="cardBody">
                        <div class="details-header">
                            <table cellpadding="4" cellspacing="0" border="0">
                                <tr>
                                    <td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Fields.KimbleOne__RevenueType__c.Label}"/></td>
                                    <td><span class="property-value"><apex:outputField value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.RevenueType__r.Name}"/></span></td>

                                    <td class="property-label"><apex:outputText value="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Fields.KimbleOne__IsActive__c.Label}"/></td>
                                    <td><span class="property-value"><apex:outputField value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.KimbleOne__IsActive__c}"/></span></td>
                                </tr>

                            </table>

                        </div>
                        <div class="inner-cards-container">

                            <div id="MethodCardErrors">
                                <apex:pageMessages escape="false"/>
                            </div>

                            <apex:outputPanel layout="none" rendered="{!IsRateCard}">
                                <div class="inner-card-container">
                                    <div class="inner-card">
                                        <div class="inner-card-header">
                                            <div class="inner-card-header-icon" ></div>
                                            <div class="inner-card-title">
                                                <span><apex:outputText styleclass="card-field-label" value="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Fields.KimbleOne__RateCardCombinationDefinition__c.Label}"/><apex:outputField styleclass="card-field-value" value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.KimbleOne__RateCardCombinationDefinition__c}"/></span>
                                            </div>
                                            <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.updateable}">
                                                <div data-floating-dropdown="#behaviour-rule-menu-data" class="fa fa-bars burger-menu"></div>
                                                <div class="deleting Loading" style="display:none"></div>
                                                <div id="behaviour-rule-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
                                                    <ul class="floating-dropdown-menu">
                                                        <li><a href="javascript:newRateCardClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!$ObjectType.ResourceStdRevenueCalcMethodRateCard__c.Name}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.New} {!$ObjectType.RateCard__c.Label}</a></li>
                                                    </ul>
                                                </div>
                                            </apex:outputPanel>
                                        </div>

                                        <div class="inner-card-body">
                                            <table cellpadding="0" cellspacing="0" border="0" class="inner-card-table"><!-- Fixed Width -->
                                                <colgroup>
                                                    <col width="26px;"/><!-- menu  -->
                                                    <col width="350px;"/><!-- Name  -->
                                                    <col width="120px;"/><!-- Items  -->
                                                    <col width="120px;"/><!-- effective date-->
                                                    <col width="80px;"/><!-- status -->
                                                </colgroup>
                                                <thead>
                                                <tr class="headerRow">
                                                    <th></th>
                                                    <th></th>
                                                    <th><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></th>
                                                    <th><apex:outputText value="{!$ObjectType.KimbleOne__ResourceStdRevenueCalcMethodRateCard__c.Fields.KimbleOne__EffectiveDate__c.Label}"/></th>
                                                    <th><apex:outputText value="{!$ObjectType.KimbleOne__ResourceStdRevenueCalcMethodRateCard__c.Fields.KimbleOne__Status__c.Label}"/></th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <apex:repeat value="{!RateCards}" var="rateCard">
                                                    <tr>
                                                        <td>
                                                            <div data-floating-dropdown="#ratecard-{!rateCard.Id}" class="fa fa-bars burger-menu" style="float:none;"></div>
                                                            <div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
                                                            <div id="ratecard-{!rateCard.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-left" style="margin-top:1px">
                                                                <ul class="floating-dropdown-menu">
                                                                    <apex:outputPanel layout="none" rendered="{!rateCard.Status__r.KimbleOne__Enum__c != 'Active'}">
                                                                        <li><a href="javascript:editRateCardClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit}</a></li>
                                                                        <apex:outputPanel layout="none" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems = 0 && RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems > 0 && HasPermission['ActivateRateCard']}">
                                                                            <li><a href="javascript:activateRateCardClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-check-square dropdown-icon"></i>{!$Label.ActivateLink}</a></li>
                                                                        </apex:outputPanel>
                                                                    </apex:outputPanel>

                                                                    <apex:outputPanel layout="none" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems < 751}">
                                                                        <li><a href="javascript:editRateCardItemsClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.Edit} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
                                                                    </apex:outputPanel>

                                                                    <li><a href="javascript:addRateCardItemsClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}')"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.Add} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>

                                                                    <li><a href="javascript:uploadItemsClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}', true)"><i class="fa fa-upload dropdown-icon"></i>{!$Label.UploadAndAppend}</a></li>
                                                                    <li><a href="javascript:uploadItemsClick('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.Id)}', '{!JSENCODE(rateCard.Id)}', '{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}', false)"><i class="fa fa-upload dropdown-icon"></i>{!$Label.UploadAndReplace}</a></li>

                                                                    <li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(rateCard.RateCard__c)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
                                                                    <apex:outputPanel rendered="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.KimbleOne__RateCardCombinationDefinition__c != null}">
                                                                        <li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(ResourceStandardRevenueCalcMethod__c.RateCardCombinationDefinition__c)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
                                                                    </apex:outputPanel>
                                                                </ul>
                                                            </div>

                                                        </td>
                                                        <td><apex:outputText value="{!rateCard.Name}"/></td>
                                                        <td class="center-value"><apex:outputText value="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].TotalItems}"/><apex:outputPanel title="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems} {!$Label.kimbleone__unmatcheditems}" styleclass="fa fa-exclamation-circle unmatched-items" rendered="{!RateCardItemsSummaryMap[rateCard.KimbleOne__RateCard__c].UnmatchedItems > 0}"/></td>
                                                        <td class="center-value"><apex:outputField value="{!rateCard.KimbleOne__EffectiveDate__c}"/></td>
                                                        <td class="center-value"><apex:outputField value="{!rateCard.Status__r.Name}"/></td>
                                                    </tr>
                                                </apex:repeat>
                                                </tbody>
                                            </table>

                                        </div>

                                        <div class="inner-card-footer"></div>
                                    </div>
                                </div>
                            </apex:outputPanel>

                        </div>

                        <div class="card-footer">
                            <span class="card-footer-body"></span>
                        </div>

                    </div>
                </div>
            </apex:outputPanel>

            <script>
				
				jQuery(window).load(function(){
					
					<apex:outputPanel layout="none" rendered="{!ISBLANK(KimbleOne__ResourceStandardRevenueCalcMethod__c.Id)}">
						editMethodClick();
					</apex:outputPanel>					
					
				});
			
				function editMethodClick()
				{
					initialiseModalBoxy('#MethodPopup', '{!$ObjectType.ResourceStandardRevenueCalcMethod__c.label}', jQuery('form[id$=\'MethodForm\']'));
					showModalBoxy();					
				}
				
				
				
			</script>

            <apex:form id="MethodForm">
                <apex:actionRegion >

                    <div id="MethodPopup" style="display:none">
                        <apex:outputPanel id="MethodEdit" >
                            <div id="MethodEditErrors">
                                <apex:pageMessages escape="false"/>
                            </div>
                            <apex:pageBlock title="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Label}">
                                <apex:pageBlockButtons location="bottom">
                                    <apex:commandButton id="saveResourceTypeBtn" styleClass="DisableButtonWhileBusy" action="{!SaveMethod}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#MethodEditErrors');initialiseTooltips();" reRender="MethodEdit"/>
                                    <input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>

                                </apex:pageBlockButtons>

                                <apex:pageBlockSection title="{!$Label.kimbleone__information}" columns="1" collapsible="false">

                                    <apex:inputField value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.Name}" required="true" />


                                    <apex:pageBlockSectionItem rendered="{!CanEditDefinition}">
                                        <apex:outputText value="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Fields.KimbleOne__RevenueType__c.Label}" />
                                        <apex:selectList value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.KimbleOne__RevenueType__c}" size="1" style="width:140px">
                                            <apex:actionSupport event="onchange" rerender="MethodEdit" />
                                            <apex:selectOptions value="{!TheRevenueTypes}" />
                                        </apex:selectList>

                                    </apex:pageBlockSectionItem>

                                    <apex:inputField value="{!KimbleOne__ResourceStandardRevenueCalcMethod__c.KimbleOne__IsActive__c}"  />

                                </apex:pageBlockSection>

                                <apex:pageBlockSection rendered="{!IsRateCard}" title="{!$ObjectType.KimbleOne__ResourceStandardRevenueCalcMethod__c.Fields.KimbleOne__RateCardCombinationDefinition__c.Label}" columns="2" collapsible="false">
                                    <apex:outputText id="combinationObjectType" value="{!TheCombinationDefinition.KimbleOne__ObjectType__c}"/>
                                    <apex:pageBlockSectionItem >
                                        <!-- No suffix -->
                                    </apex:pageBlockSectionItem>
                                    <apex:inputField value="{!TheCombinationDefinition.KimbleOne__KeyDefinition__c}"  style="width:258px;" rendered="{!CanEditDefinition}"/>
                                    <apex:outputField value="{!TheCombinationDefinition.KimbleOne__KeyDefinition__c}" rendered="{!!CanEditDefinition}"/>

                                    <apex:inputField value="{!TheCombinationDefinition.KimbleOne__KeyFactorField__c}" rendered="{!CanEditDefinition}"/>
                                    <apex:outputField value="{!TheCombinationDefinition.KimbleOne__KeyFactorField__c}" rendered="{!!CanEditDefinition}"/>

                                    <apex:inputField value="{!TheCombinationDefinition.KimbleOne__Delimiter__c}" rendered="{!CanEditDefinition}"/>
                                    <apex:outputField value="{!TheCombinationDefinition.KimbleOne__Delimiter__c}" rendered="{!!CanEditDefinition}"/>

                                    <apex:pageBlockSectionItem >
                                        <apex:outputText value="{!$ObjectType.KimbleOne__RateCardCombinationDefinition__c.Fields.KimbleOne__UnitType__c.Label}" />
                                        <apex:selectList value="{!TheCombinationDefinition.KimbleOne__UnitType__c}" size="1" style="width:140px">
                                            <apex:selectOptions value="{!TheUnitTypes}" />
                                        </apex:selectList>
                                    </apex:pageBlockSectionItem>

                                </apex:pageBlockSection>

                            </apex:pageBlock>
                        </apex:outputPanel>
                    </div>
                </apex:actionRegion>

            </apex:form>

            <apex:include pageName="{!$Page.RateCardAndItemsEdit}"/>

            <style>
    			.inner-card-container
    			{
    				display:block;
    			}
			    .cardHeadingContainer
			    {
			    	display: table;
					width: 100%;
					background-color: #FFF;
					border-color: #DDD;
					color: #333;
					background-color: #FFF;
					border-color: #DDD;
					border-bottom: 1px solid #DDD;
					border-top-right-radius: 3px;
					border-top-left-radius: 3px;
					font-size: 18px;
			    }
			    .cardHeadingCell
			    {
			    	display: table-cell;
				   vertical-align: middle;
				   padding: 4px 15px;
				   border-right: 1px solid #DDD;
			    }
			    .cardHeadingCellFixed
			    {
			    	width:1px;
			    	white-space:nowrap;
			    }
			    .burger-menu
			    {
			    	margin-left:0px;
			    }
			    .cardProperties {
					  font-size: 14px;
					}
				.property-label
				{
					font-weight:bold;
					text-align:right;
				}
				.property-value
				{
					padding-right: 60px;
				}
				.description
				{
					margin-top:15px;
					font-style:italic;
				}
				.details-header
				{
					margin-left: 10px;
					margin-right: 10px;
					margin-bottom: 3px;
					margin-top: 10px;
				}
				.title-card-body-field
				{
					margin:0px;
					padding-right:4px;
					padding-left:0px;
					padding-top:0px;
					padding-bottom:0px;
					vertical-align: middle;
				}
				.title-card-body-charm
				{
					cursor:pointer;
					font-size:26px;
					width: 35px;
				}
	
				.tool-tip-content {
					display: none;
				}
				
				.tool-tip-content-container {
					font-size: 12px;
				}
				
				.tool-tip-form-buttons {
					margin-top: 3px;
					margin-bottom: 3px;
					text-align: right;
				}
				.tool-tip-content table td:first-child {
				    padding: 8px;
				    text-align:right;
				}
				.labelCol
				{
					white-space:nowrap !important;
				}
				.deleting {
				    	margin-left: 10px;
						vertical-align: top;
						float: right;
						width: 18px;
						height: 18px;
					}
				.Loading 
					{
						background-image: url('{!URLFOR($Resource.KimbleOne__JobImages, 'running16.gif')}') !important;
						background-repeat:no-repeat !important;
						background-position: 50%, 50%;
					}
				.unmatched-items
				{
					color: #B42E34;
				    font-size: 16px;
				    margin-left: 6px;
				}
    </style>
        </apex:define>
    </apex:composition>
</apex:page>