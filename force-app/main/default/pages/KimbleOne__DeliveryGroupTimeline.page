<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.DeliveryGroupTimelineController,KimbleOne.SecurityController"  showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__DeliveryGroup__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
     	
     	<c:Menu DefaultHelpPage="Milestones.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}" />
     	 
    </apex:define>
    
    <apex:define name="Content">
    
    <!-- Important Owl stylesheet -->
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__OwlCarousel, 'assets/owl.carousel.css')}"/>
	
	<!-- Include js plugin -->
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__OwlCarousel, 'owl.carousel.js')}"/>			
	<div id="select-snapshot-mode" class="timeline-view-toggle">
    		 <span class="clickable selected left"><a class="toggleLink" id="revenue-cost-mode" href="javascript:changeSnapshotMode('#revenue-cost-mode', 'RevenueCost');"><span class="linkText"><i class="fa fa-money toggle-icon"></i>{!$Label.Revenue} / {!$Label.Cost}</span></a></span><span class="clickable middle"><a class="toggleLink" id="margin-mode" href="javascript:changeSnapshotMode('#margin-mode', 'Margin');"><span class="linkText"><i class="fa fa-line-chart toggle-icon"></i>{!$Label.MarginLabel}</span></a></span><span class="clickable right"><a class="toggleLink" id="usage-mode" href="javascript:changeSnapshotMode('#usage-mode', 'Usage');"><span class="linkText"><i class="fa fa-clock-o toggle-icon"></i>{!$Label.UsageLabel}</span></a></span></div>
    		
	<div id="container" class="zoom-day">
		<div id="vertical-axis-container">
			<div id="y-axis-units"></div>
			<div id="vertical-100" style="top:-5px" class="vertical-marker"><div class="horizontal-marker"></div><span></span></div>
			<div id="vertical-75" style="top:45px" class="vertical-marker"><div class="horizontal-marker"></div><span></span></div>
			<div id="vertical-50" style="top:95px" class="vertical-marker"><div class="horizontal-marker"></div><span></span></div>
			<div id="vertical-25" style="top:145px" class="vertical-marker"><div class="horizontal-marker"></div><span></span></div>
			<div id="vertical-0" style="top:195px" class="vertical-marker">0</div>
			<div id="scroll-left">
				<img src="{!URLFOR($Resource.AssignmentImages, 'PreviousButtonSquare.png')}" alt="{!$Label.PreviousPeriod}" />
			</div>
		</div>
			
		<div id="zoom-container">
			<a class="zoom-in fa fa-plus-circle" onclick="zoomIn()" ></a>
			<div id="zoom-level"></div>
			<a class="zoom-out fa fa-minus-circle" onclick="zoomOut()" ></a>
			<div id="scroll-right">
				<img src="{!URLFOR($Resource.AssignmentImages, 'NextButtonSquare.png')}" alt="{!$Label.NextPeriod}" />
			</div>
			<apex:outputPanel layout="none" rendered="{!TheManualEventClasses.size > 0}">
				<div id="new-event-button" onclick="addNewEvent();" title="{!$Label.kimbleone__neweventlabel}">
					<apex:image url="{!URLFOR($Resource.KimbleOne__TimesheetIcons, 'Blank_BtnSqShdw.png')}" />
					<i class="fa fa-map-marker new-event-icon"></i>
				</div>
			</apex:outputPanel>
			<div id="new-snapshot-button" onclick="createSnapshot();" title="{!$Label.kimbleone__newsnapshotlabel}">
				<apex:image url="{!URLFOR($Resource.KimbleOne__TimesheetIcons, 'Blank_BtnSqShdw.png')}" />
				<i class="fa fa-camera snapshot-icon"></i>
			</div>
		</div>
		<div id="timeline-container">
				
			<div id="horizontal-axis-container">
				<div id="canvas-container">
					<!-- DO NOT REMOVE HEIGHT ATTRIBUTE - CANVAS ONLY SUPPORTS HEIGHT AND WIDTH NOT STYLED USING CSS -->
					<canvas id="graph-canvas" height="200px"></canvas>
				</div>
				<div id="period-segments-container">
				
				</div>
			</div>
			<div id="timeline-legend"></div>
			<div id="events-container" class="owl-carousel"></div>
			<div class="owl-pointer"><i class="fa fa-play fa-rotate-270"/></div>
		</div>
		
	</div>
	
	<apex:form id="EventEditForm">
	<div id="EventEditPopup" style="display:none">
  
		<apex:outputPanel id="EventEdit">
				
       			<div id="EventEditErrors">
           			<apex:pageMessages id="EventEditMessages" escape="false" />
           		</div>
           		           		
           		<apex:pageBlock >
           		 
            		<apex:pageBlockButtons location="bottom">
						<apex:commandButton id="saveEvent" styleclass="DisableButtonWhileBusy" action="{!SaveEvent}" value="{!$Label.kimbleone__save}" oncomplete="hideModalBoxyWithErrorCheck('#EventEditErrors');loadTheTimeline();" rerender="EventEdit" rendered="{!ISBLANK(TheEvent.Id) || !TheEvent.KimbleOne__IsComplete__c}"/>
						<apex:commandButton id="deleteEvent" styleclass="DisableButtonWhileBusy" action="{!DeleteEvent}" value="{!$Label.kimbleone__delete}" oncomplete="hideModalBoxyWithErrorCheck('#EventEditErrors');loadTheTimeline();"  rerender="EventEdit" rendered="{!!TheEvent.KimbleOne__IsComplete__c && !ISBLANK(TheEvent.Id)}"/>
						<apex:commandButton id="revertEvent" styleclass="DisableButtonWhileBusy" action="{!RevertEvent}" value="{!$Label.kimbleone__reverttodraft}" oncomplete="hideModalBoxyWithErrorCheck('#EventEditErrors');loadTheTimeline();"  rerender="EventEdit" rendered="{!CanRevertEvent && HasPermission['RevertCompletedMilestone']}"/>
						
						<input id="cancelGroup" class="btn"  type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}"/>
					</apex:pageBlockButtons>
             		
             		<!-- NEW EVENT OR INCOMPLETE MANUAL EVENT -->
             		<apex:pageblockSection collapsible="false" showheader="false"  columns="1" rendered="{!ISBLANK(TheEvent.Id) || (IsManualEvent && !TheEvent.KimbleOne__IsComplete__c)}">
              			<apex:pageBlockSectionItem >
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__EventClass__c.Label}"/>
							<apex:selectList value="{!TheEvent.KimbleOne__EventClass__c}" size="1" required="true">
								<apex:selectOptions value="{!TheManualEventClasses}" />
								<apex:actionSupport event="onchange" action="{!EventClassChange}" oncomplete="SetupDatePicker();" rerender="EventEdit" />
							</apex:selectList>
						</apex:pageBlockSectionItem>
						
						<apex:inputField value="{!TheEvent.Name}"/>
						
						<apex:pageBlockSectionItem >
							<apex:outputLabel value="{!$ObjectType.KimbleOne__Event__c.Fields.KimbleOne__EventNarrative__c.Label}"/>
							<apex:inputTextArea style="width:200px" rows="7" value="{!TheEvent.KimbleOne__EventNarrative__c}"/> 
						</apex:pageBlockSectionItem>
						
						<apex:inputField styleclass="kimbleDatePicker" value="{!TheEvent.KimbleOne__EventDate__c}" />
						
						<apex:inputfield value="{!TheEvent.KimbleOne__IsComplete__c}" rendered="{!!TheEvent.KimbleOne__IsComplete__c}"/>
               			<apex:outputfield value="{!TheEvent.KimbleOne__IsComplete__c}" rendered="{!TheEvent.KimbleOne__IsComplete__c}"/>
						
						<!-- TODO Can only complete an event which has milestones if all elements for all milestones are P1 -->
              		</apex:pageblockSection>
              		
              		<!-- SYSTEM EVENT OR COMPLETE MANUAL EVENT -->
              		<apex:pageblockSection collapsible="false" showheader="false"  columns="1" rendered="{!!IsManualEvent || (TheEvent.KimbleOne__IsComplete__c && !ISBLANK(TheEvent.Id))}">
	              		
              			<apex:outputfield value="{!TheEvent.EventClass__r.Name}"/>
              			<apex:outputfield value="{!TheEvent.Name}"/>
              			<apex:outputfield value="{!TheEvent.KimbleOne__EventNarrative__c}"/>   
              			<apex:outputField value="{!TheEvent.KimbleOne__BaselineDate__c}" rendered="{!!ISBLANK(TheEvent.KimbleOne__BaselineDate__c)}"/>
               			<apex:outputField styleclass="kimbleDatePicker" value="{!TheEvent.KimbleOne__EventDate__c}" />
               			<apex:inputfield value="{!TheEvent.KimbleOne__IsComplete__c}" rendered="{!!TheEvent.KimbleOne__IsComplete__c && TheEvent.EventClass__r.CompletionMode__r.KimbleOne__Enum__c = 'Manual'}"/>
               			<apex:outputfield value="{!TheEvent.KimbleOne__IsComplete__c}" rendered="{!TheEvent.KimbleOne__IsComplete__c || TheEvent.EventClass__r.CompletionMode__r.KimbleOne__Enum__c != 'Manual'}"/>
               		</apex:pageblockSection>
               		
               		<div class="milestone-contatainer">
               		<apex:pageBlockTable var="milestone" value="{!TheEvent.Milestones__r}" rendered="{!!ISBLANK(TheEvent.Milestones__r) && TheEvent.Milestones__r.size > 0}">
							<apex:column value="{!milestone.DeliveryElement__r.Name}"/>
							<apex:column value="{!milestone.Name}"/>
							<apex:column headervalue="{!$ObjectType.KimbleOne__Milestone__c.Fields.KimbleOne__MilestoneType__c.Label}" value="{!milestone.MilestoneType__r.Name}"/>
							<apex:column headervalue="{!$Label.kimbleone__valuelabel}">
								<apex:outputField value="{!milestone.KimbleOne__MilestoneValue__c}" rendered="{!milestone.MilestoneType__r.KimbleOne__Enum__c = 'Cost'}"/>
								<apex:outputField value="{!milestone.KimbleOne__InvoicingCurrencyIsoCode__c}" rendered="{!milestone.MilestoneType__r.KimbleOne__Enum__c = 'Revenue'}"/>
								<apex:outputField value="{!milestone.KimbleOne__InvoicingCurrencyMilestoneValue__c}" rendered="{!milestone.MilestoneType__r.KimbleOne__Enum__c = 'Revenue'}"/>
							</apex:column>
							
					</apex:pageBlockTable>
					</div>
               			  
        		</apex:pageBlock>				
         
        </apex:outputPanel> <!-- end newEvent -->
  		
  	</div>	
	</apex:form>
	
	<apex:form >
		<apex:actionFunction action="{!NewEvent}" name="newEvent" rerender="EventEdit" oncomplete="SetupDatePicker();showModalBoxy()">
   		</apex:actionFunction>
   		
		<apex:actionFunction action="{!ReadEvent}" name="readEvent" rerender="EventEdit" oncomplete="SetupDatePicker();showModalBoxy()">
       		<apex:param name="eventId" value="" />
       	</apex:actionFunction>
 
	</apex:form>
	
	<script>
		Math.log10 = Math.log10 || function(x) {
  			return Math.log(x) / Math.LN10;
		};
		
		var timelineData = {};
				
		var timeline = {};
				
		var zoomMode;
		
		var snapshotMode = 'RevenueCost';
		var snapshotModeFields = {"RevenueCost":{Units:"{!JSENCODE(DeliveryGroup__c.CurrencyISOCode)}", 
												 Format:'#,###', 
												 Fields:[{Field:"ContractRevenue", Label:"{!JSENCODE($Label.ProjectedRevenue)}",Color: "#729BC7;",Icon:"fa fa-circle circle-graph-point"}
												 		 <apex:outputPanel layout="none" rendered="{!ShowCosts}">,{Field:"ContractCost", Label:"{!JSENCODE($Label.kimbleone__projectedcost)}", Color: "#729BC7",Icon:"fa fa-square diamond-graph-point"}</apex:outputPanel> 
												 		 ,{Field:"BaselineContractRevenue", Label:"{!JSENCODE($Label.kimbleone__baselinerevenue)}",Color: "#bbbbbb;",Icon:"fa fa-circle circle-graph-point"}
												 		 <apex:outputPanel layout="none" rendered="{!ShowCosts}">,{Field:"BaselineContractCost", Label:"{!JSENCODE($Label.kimbleone__baselinecost)}",Color: "#bbbbbb;",Icon:"fa fa-square diamond-graph-point"}</apex:outputPanel> 
												 		 ]},
								   		"Margin":{Units:"%",
								   				  Format:'#,###', 
								   				  Fields:[{Field:"Margin", Label:"{!JSENCODE($Label.MarginLabel)}",Color: "#729BC7;",Icon:"fa fa-circle circle-graph-point"}, 
								   				  	{Field:"BaselineMargin", Label:"{!JSENCODE($Label.BaselineLabel)}", Color: "#bbbbbb",Icon:"fa fa-circle circle-graph-point"}]}, 
								   		 "Usage":{Units:"{!JSENCODE(UsageUnits)}",
								   		 		  Format:'#,###.##', 
								   		 		  Fields:[{Field:"BaselineUsage", Label:"{!JSENCODE($Label.BaselineLabel)}",Color: "#bbbbbb;",Icon:"fa fa-circle circle-graph-point"}, 
								   		 		  		  {Field:"ActualUsage", Label:"{!JSENCODE($Label.ActualLabel)}", Color: "#008752",Icon:"fa fa-circle circle-graph-point"}, 
								   		 		  		  {Field:"ForecastUsage", Label:"{!JSENCODE($Label.ProjectedLabel)}", Color: "#729BC7",Icon:"fa fa-circle circle-graph-point"}]}};
		
		var showEvent = '{!JSENCODE($CurrentPage.parameters.EventId)}';
		
		var earliest;
		var latest;
		var months;
		
		var owl;
		
		var firstDayOfWeekPos = 1; //Monday
		
		var zoomModeWidths = {"day":16, "week":6, "month":2};
		
		function createSnapshot()
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupTimelineController.CreateSnapshot}',
	       		'{!JSINHTMLENCODE(DeliveryGroup__c.Id)}',
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	timelineData = result;
			             	initialiseContainer(zoomMode);
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         }, 
	         {escape: true, timeout: 60000});
		}
		
		function deleteSnapshot(snapshotId)
		{
			jQuery('#delete-snapshot-btn').prop('disabled',true).removeClass('btn').addClass('btnDisabled');
	   
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupTimelineController.DeleteSnapshot}',
	       		'{!JSINHTMLENCODE(DeliveryGroup__c.Id)}', snapshotId,
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	timelineData = result;
			             	initialiseContainer(zoomMode);
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         }, 
	         {escape: true, timeout: 60000});
		}
		
		function loadTheTimeline()
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.DeliveryGroupTimelineController.GetTheTimeline}',
	       		'{!JSINHTMLENCODE(DeliveryGroup__c.Id)}',
	      			function(result, event){          
	             		if (event.status) 
			            {
			             	timelineData = result;
			             	initialiseContainer(zoomMode);
			         	} 
			         	else if (event.type === 'exception') 
			         	{
			             	alert(event.message);
			         	} 
			         	else 
			         	{
			             	alert(event.message);
			         	}
	         }, 
	         {escape: true, timeout: 60000});
		}
		
		function addNewEvent()
		{
			initialiseModalBoxy('#EventEditPopup', '{!JSENCODE($Label.New)}  {!$ObjectType.Event__c.label}', jQuery('form[id$=\'EventEditForm\']'));
			newEvent();
		}
		
		function viewEventDetail(eventId)
		{
			initialiseModalBoxy('#EventEditPopup', '{!JSENCODE($Label.Edit)}  {!$ObjectType.Event__c.label}', jQuery('form[id$=\'EventEditForm\']'));
			readEvent(eventId);
		}
		
		function zoomOut()
		{
			if (zoomMode == 'month') return;
			
			if (zoomMode == 'day') 
				initialiseContainer('week');
			else
				initialiseContainer('month');
		}
		
		function zoomIn()
		{
			if (zoomMode == 'day') return;
			
			if (zoomMode == 'month')
				initialiseContainer('week');
			else
				initialiseContainer('day');
		}
	
		function changeSnapshotMode(obj, newMode)
		{
			jQuery('#select-snapshot-mode span').removeClass('selected');
			
			jQuery(obj).parent('span').addClass('selected');
			
			snapshotMode = newMode;
			
			drawSnapshots();
		}
		
		function sortEvents()
		{
			return function(a, b) {
				var x = a.toDate().valueOf();
				var y = b.toDate().valueOf();
				
				if (x < y) //sort string ascending
		  			return -1;
		 		if (x > y)
		  			return 1;
		 		return 0; //default return value (no sorting)
			}
		}
		var totalWidth = 0;
		
		function initialiseZoomMode()
		{
			timeline = {};
			months = new Array();
			
			jQuery('#container').removeClass().addClass('zoom-' + zoomMode);
			var showMonthSeparator = true;
			
			jQuery.each(Object.keys(timelineData).sort(sortEvents()), function (i, dte) { 
			
				var theDate = dte.toDate();
				var startDate;
				var key;
				var name;
				var shortName;
				
				if (zoomMode == 'day')
				{
					startDate = theDate;
					key = dte;
					name = kimble.regional.monthNamesShort[theDate.getMonth()] + ' ' + theDate.getDate()
					shortName = theDate.getDate();
				}
				else if (zoomMode == 'week') //week starting to ending i.e. M-F //snapshot uses last in week
				{
					//combine all events in the week
					var startDate = kimbleGetStartOfWeek(theDate);
					var theDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate() + 6 , 0, 0, 0, 0);
					key = theDate.toKimbleUTC();
					name = generateWeekName(startDate);
					shortName = generateShortWeekName(startDate);
		
				}
				else //month // all events in a month - snapshot uses last in month
				{
					var startDate = new Date(theDate.getFullYear(), theDate.getMonth(), 1, 0, 0, 0, 0);
					var theDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0); //end-of-month
					var key = theDate.toKimbleUTC();
					name = kimble.regional.monthNamesShort[theDate.getMonth()] + ' ' + theDate.getFullYear();
					shortName = kimble.regional.monthNamesShort[theDate.getMonth()] + ' ' + theDate.getFullYear().toString().substr(2,2);
					showMonthSeparator = false;
				}
				
				if(timeline[key] == null) timeline[key] = {shortname:shortName, name:name, startDate:startDate, endDate:theDate, events:[], isComplete:true, snapshots:[]};
					
				jQuery.each(timelineData[dte].Events, function (j, e) {
					timeline[key].events.push(e);
					if (!e.IsComplete) timeline[key].isComplete = false;
				});
				
				jQuery.each(timelineData[dte].Snapshots, function (j, e) {
					timeline[key].snapshots.push(e);
				});
				
				if (earliest == null || earliest > theDate) earliest = theDate;
				
				if(latest == null || latest < theDate) latest = theDate;
			});
			
			if (earliest == null) earliest = new Date();
			
			earliest = new Date(earliest.getFullYear(), earliest.getMonth(),1, 0, 0, 0, 0);
			
			var startDate = new Date(earliest.getFullYear(), earliest.getMonth(),1, 0, 0, 0, 0);
			
			//build array of months
			while (earliest <= latest)
			{
				months.push(new Date(earliest.getFullYear(), earliest.getMonth(), 1, 0, 0, 0, 0));
				earliest.setMonth(earliest.getMonth() + 1);
			}
			
			earliest = startDate;
			
			//iterate through the months // adding div to timeline - month width depends on number of days - 12 px per day?
			var timelineHtml = '';
			
			
			
			jQuery.each(months, function (i, dte) {
				
				var width = (new Date(dte.getFullYear(), dte.getMonth()+1, 0, 0, 0, 0)).getDate() * zoomModeWidths[zoomMode];
				totalWidth += width;
				var monthName = (showMonthSeparator ? kimble.regional.monthNames[dte.getMonth()] + ' ' + dte.getFullYear() : '');
				
				timelineHtml += '<div id="month-' + dte.valueOf() + '" style="width:' + width + 'px;" class="timeline-month"><div class="timeline-month-line">' + (timelineHtml == ''?'':'<div class="month-break"></div>') + '</div><div class="timeline-month-header">' + monthName + '</div></div>';
			
			});
			
			jQuery('.horizontal-marker').width(totalWidth);
			var canvas = document.getElementById('graph-canvas');
			canvas.width = totalWidth;
			
			var timelineContainer = jQuery('#period-segments-container');
			timelineContainer.empty();
			jQuery(timelineHtml).appendTo(timelineContainer);
		}
		
		function generateWeekName(dte)
    	{
    		var weekStart = kimbleGetStartOfWeek(dte);
    		var weekEnd = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 6 , 0, 0, 0, 0);
  			return weekStart.getDate() + ' ' + kimble.regional.monthNamesShort[weekStart.getMonth()] + ' - ' + weekEnd.getDate() + ' ' + kimble.regional.monthNamesShort[weekEnd.getMonth()];
   		}	
		
		function generateShortWeekName(dte)
    	{
	    	var weekStart = kimbleGetStartOfWeek(dte);
	    	var weekEnd = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 6 , 0, 0, 0, 0);
	  		return weekStart.getDate() + '-' + weekEnd.getDate();
	   	}	
	   	
	   	function initialiseContainer(zoom)
	   	{
	   		zoomMode = zoom;
	   		
	   		initialiseZoomMode();
			
			if (owl != null) owl.trigger('destroy');
			jQuery('#events-container').empty();
			
			var eventHtml = '';
			
			//draw event dates on line and in events container
			var eventIndex = 0;
			jQuery.each(Object.keys(timeline).sort(sortEvents()), function (i, dte) { 
				
				var timelinePoint = timeline[dte];
				
				var theDate = timelinePoint.startDate;
				
				var key = '#month-' + (new Date(timelinePoint.endDate.getFullYear(), timelinePoint.endDate.getMonth(), 1)).valueOf();
				
				var left = Math.max(0, daysBetween(theDate, earliest) * zoomModeWidths[zoomMode]);
				
				var snapshotStatus = 'none';
				if(timelinePoint.snapshots.length > 0) {
					// determine if there are any active snaphots today, these should supercede any draft today
					snapshotStatus = 'draft';
					
					for (var i = 0; i < timelinePoint.snapshots.length; i++)
					{
					    if(timelinePoint.snapshots[i].Status == 'actual')
					    {
					    	snapshotStatus = 'actual';
					    }
					}
				}
				
				// rules for the icon on the timeline in order or precedence:
				// 1) if there are any events on this day then an event marker is placed which is either:
				// 1.a) complete
				// 1.b) incomplete
				// 2) if there are no events then there will be a snapshot which is either:
				// 2.a) a draft snaphot (a placeholder snapshot created to show the current position TODAY)
				// 2.b) a real snapshot
				var icon = (timelinePoint.events.length > 0 ? (timelinePoint.isComplete?'fa-map-marker complete-event':'fa-map-marker incomplete-event') : (snapshotStatus == 'actual' ? 'fa-camera timeline-snapshot-marker-icon':'fa-play fa-rotate-270 timeline-draft-snapshot-marker-icon'));
				
				var dateHtml = '<div id="dte-' + dte + '" ' + (timelinePoint.events.length > 0 ? 'event-index="' + eventIndex + '"' : '') +  ' style="left:' + left + 'px;" class="timeline-date ' + (timelinePoint.events.length > 0 ? 'event-date ' : '') + (timelinePoint.snapshots.length > 0 ? 'snapshot-date ' : '') +  '"><div class="timeline-date-marker"><i class="fa ' + icon + '"/></div><div class="timeline-date-header">' + timelinePoint.shortname + '</div></div>';
				
				jQuery(dateHtml).appendTo(jQuery(key));
				
				if (timelinePoint.events.length > 0) 
				{
					eventIndex++;
					eventHtml += '<div class="event-date-card"><div class="event-date-card-header"><a class="event-date-card-header-text">' + timeline[dte].name + '</a></div><div class="event-date-card-body"><table width="100%" cellpadding="0" cellspacing="0" border="0">'; 
				
					//event body
					jQuery.each(timelinePoint.events, function (i, e){
						eventHtml += '<tr><td>' + (e.HasMilestones?'<i style="color:gold;" class="fa fa-square fa-rotate-45"></i>':'') + '</td><td><div class="event-detail"><a href="javascript:viewEventDetail(\'' + e.Id + '\')" class="undecorated-link" >' + e.Name + '</a></div></td><td style="font-size: 14px;"><i class="fa ' + (e.IsComplete?'fa-check-square-o':'fa-square-o') + '"></i></td></tr>';
					});
					
					eventHtml += '</table></div></div>';
				}
			});
			
			jQuery(eventHtml).appendTo('#events-container');
		
