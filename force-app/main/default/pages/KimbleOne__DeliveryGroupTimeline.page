		function drawSnapshots()
		{
			var canvas = document.getElementById('graph-canvas');
			var canvasContainer = jQuery('#canvas-container');
			
			var context = canvas.getContext('2d');
			
			//reset the canvas
			context.clearRect(0, 0, canvas.width, canvas.height);
     		jQuery('#canvas-container div').remove();
     		
			context.globalCompositeOperation='destination-over';
			
			jQuery('#timeline-legend').empty();
			
			var legendHtml = '';
			
			jQuery.each(snapshotModeFields[snapshotMode].Fields, function (j, field) {
				legendHtml += '<div class="x-axis-legend"><i class="' + field.Icon + '" style="color:' + field.Color + '"></i>' + field.Label + '</div>';	
			});
			
			// add icons for events and snapshots
			legendHtml += '<div class="x-axis-legend"><i class="fa fa-map-marker incomplete-event"></i>{!$Label.EventLabel}</div>';
			legendHtml += '<div class="x-axis-legend"><i class="fa fa-camera" style="color:#565656"></i>{!$Label.SnapshotButton}</div>';
			legendHtml += '<div class="x-axis-legend"><i class="fa fa-play fa-rotate-270" style="color:#00CFFF"></i>{!$Label.CurrentPositionLabel}</div>';	
			
			jQuery(legendHtml).appendTo(jQuery('#timeline-legend'));
			
			//Calculate bounds 
			var maxVal = 0;
			var minVal = 0;
			
			jQuery.each(Object.keys(timeline).sort(sortEvents()), function (i, dte) { 
				
				var timelinePoint = timeline[dte];
				
				jQuery.each(timelinePoint.snapshots, function (s, snapshot) {
				
					jQuery.each(snapshotModeFields[snapshotMode].Fields, function (j, field) {
						if (snapshot[field.Field] != null)
						{
							if (snapshot[field.Field] < minVal) minVal = snapshot[field.Field];
							if (snapshot[field.Field] > maxVal) maxVal = snapshot[field.Field];
						}
					});
				
				});
			
			});
			
			/* vertical axis range */
			maxVal++;
			jQuery('#y-axis-units').text(snapshotModeFields[snapshotMode].Units);
			
			var range = maxVal - minVal;
			var tickRange = range / 4;
			var a = Math.ceil(Math.log10(tickRange)-1);
			var pow10x = Math.pow(10,a);
			var b = Math.ceil(tickRange / pow10x) * pow10x;
			var format = snapshotModeFields[snapshotMode].Format;
			
			jQuery('#vertical-0>span').text(kimble.formatNumber(minVal, format));
			jQuery('#vertical-25>span').text(kimble.formatNumber(minVal + b, format));
			jQuery('#vertical-50>span').text(kimble.formatNumber(minVal + b * 2, format));
			jQuery('#vertical-75>span').text(kimble.formatNumber(minVal + b * 3, format));
			jQuery('#vertical-100>span').text(kimble.formatNumber(minVal + b * 4, format));
			
			
			jQuery.each(snapshotModeFields[snapshotMode].Fields, function (i, field) {
				var prevY;
				context.beginPath();
				
				jQuery.each(Object.keys(timeline).sort(sortEvents()), function (j, dte) { 
				
					var timelinePoint = timeline[dte];
				
					jQuery.each(timelinePoint.snapshots, function (s, snapshot) {
					
						var dteObj = jQuery('#dte-' + dte);
						var x = (dteObj.position().left + (dteObj.width() / 2));
						var y = (snapshot[field.Field] == null ? prevY : 200 - (snapshot[field.Field] / b * 50));
						
						prevY = y;
						
						if (j==0) 
							context.moveTo(x, y);
						else
							context.lineTo(x, y);
					});
				});
				
				context.lineWidth = 2;
				context.strokeStyle = field.Color;
				context.stroke();
				
				
				jQuery.each(Object.keys(timeline).sort(sortEvents()), function (i, dte) { 
					
					var timelinePoint = timeline[dte];
				
					jQuery.each(timelinePoint.snapshots, function (s, snapshot) {
					
						var dteObj = jQuery('#dte-' + dte);
						var x = (dteObj.position().left + (dteObj.width() / 2));
						var y = (snapshot[field.Field] == null ? prevY : 200 - (snapshot[field.Field] / b * 50));
						
						prevY = y;
						
						if(snapshot[field.Field] != null) {
							// draw a div for each graphpoint
							jQuery('<div ' + (snapshot.Id != null ? ('snapshot-id="' + snapshot.Id + '"') : '') + 'data-dte="' + dte + '" class="graph-point ' + field.Icon + '" style="left:' + (x - 5) + 'px;top:' + (y - 5) + 'px;color:' + field.Color +'"></div>').appendTo(jQuery('#canvas-container'))
						}											
					});
				});
				
			});
			
			jQuery('.graph-point').qtip('destroy', true);
			
			jQuery('.graph-point').qtip({content:{text: function(event, api) {							           
							            return generateGraphPointTipHtml(jQuery(this).attr('snapshot-id'), jQuery(this).attr('data-dte'));
							        }},
									show: {event: 'click'},
									hide: {event: 'unfocus'},
									position: {my: 'bottom center', at: 'top center'},
									style: {classes: 'qtip-light qtip-shadow qtip-rounded'}});
		}
		
		function generateGraphPointTipHtml(snapshotId, dte)
		{
			var timelinePoint = timeline[dte];
				
			var html = '<table class="data-point-tooltip" cellspacing="0" cellpadding="0" border="0">';
			
			if (snapshotId != null)
				html += '<thead><th colspan="2" style="text-align: center;padding-bottom: 5px;"><input id="delete-snapshot-btn" class="btn" type="button" value="{!$Label.DeleteButton}" onclick="deleteSnapshot(\'' + snapshotId + '\')"/></th></thead>';
			
			jQuery.each(timelinePoint.snapshots, function (s, snapshot) {
			
				if (snapshot.Id != snapshotId) return true;
				
				jQuery.each(snapshotModeFields[snapshotMode].Fields, function(i, field) {
					html += '<tr><td>' + field.Label + ' (' + snapshotModeFields[snapshotMode].Units  + ')</td><td>' + kimble.formatNumber(snapshot[field.Field], snapshotModeFields[snapshotMode].Format) + '</td></tr>';
				});
			
			});
			
			html += '</table>';
			
			return html;
		
		}
		
		function jumpToSlide(index)
		{
			owl.trigger('to.owl.carousel', [index,300,true]);
		}	
		
		function SetupDatePicker()
		{
			jQuery('.kimbleDatePicker').datepicker({
					dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
					showOtherMonths: true,
					selectOtherMonths: true});
		}
	</script>
	
	<script>
	(function ($) {

    $.fn.isOnScreen = function(x, y){

        if(x == null || typeof x == 'undefined') x = 1;
        if(y == null || typeof y == 'undefined') y = 1;

        var win = this.scrollParent();

        var viewport = {
            top : win.scrollTop(),
            left : win.scrollLeft()
        };
        viewport.right = viewport.left + win.width();
        viewport.bottom = viewport.top + win.height();

        var height = this.outerHeight();
        var width = this.outerWidth();

        if(!width || !height){
            return false;
        }

        var bounds = this.position();
        bounds.right = bounds.left + width;
        bounds.bottom = bounds.top + height;

        var visible = (!(viewport.right < bounds.left || viewport.left > bounds.right || viewport.bottom < bounds.top || viewport.top > bounds.bottom));

        if(!visible){
            return false;
        }

        var deltas = {
            top : Math.min( 1, ( bounds.bottom - viewport.top ) / height),
            bottom : Math.min(1, ( viewport.bottom - bounds.top ) / height),
            left : Math.min(1, ( bounds.right - viewport.left ) / width),
            right : Math.min(1, ( viewport.right - bounds.left ) / width)
        };

        return (deltas.left * deltas.right) >= x && (deltas.top * deltas.bottom) >= y;

    };

})(jQuery);
	</script>
	
