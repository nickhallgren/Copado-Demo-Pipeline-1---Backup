<apex:page standardController="KimbleOne__AllowanceScheme__c" extensions="KimbleOne.AllowanceSchemeHomeController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="WhatcanIdoinKimble.html" MenuContextType="Allowance" MenuContextId="{!KimbleOne__AllowanceScheme__c.Id}" MenuContextName="{!KimbleOne__AllowanceScheme__c.Name}"/> 

</apex:define>
    
<apex:define name="Content">
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>
 
 	<style>
 		#rate-card-list {
 			display: block;
 		}
 		.inner-card-header {
 			position: relative;
 		}
 		.rate-card-menu {
 			position: absolute;
	    	right: 0;
    		top: 0;
 		}
 		.card.vertical {
		    width: 32%;
	        min-height: 420px;
    		margin-bottom: 10px;
 		}
 		.cardBody {
 			padding: 0px 9px 11px 9px;
 		}
 		div#rate-card-header {
		    width: 100%;
		}
		.right-align-cell {
		    text-align: right;
		}
		.rate-cards-header.card {
		    width: 98%;
		}
		
		span.rate-card-label {
		    font-weight: bold;
		    margin-right: 7px;
		    margin-left: 2px;
		    font-style: italic;
		}
		td.rate-card-label {
		    font-weight: bold;
		    padding-left: 3px;
	        width: 115px;
		}				
		.resource-rate-cards-header.cardHeading {
		    background-color: #F5F5F5;
		    border-color: #DDD;
		}
		.cardHeading.inverted {
		    vertical-align: middle;
		    height: 31px;
		    padding: 7px;		
		}
 		.detail-mode-toggle-container {
		    float: right;
		    vertical-align: middle;
		    font-size: 13px;
		    cursor: pointer;
		    margin-bottom: 8px;
		}
 		.allowance-rate-cards-ind {
			color: #333;
		}
 		.adjustment-rate-cards-ind {
 			color: #333;
 		}
		.scale-rate-cards-ind {
			color: #333;
		}
		.inner-card {
			min-width: initial;
		}
		.inner-card-body {
			position: relative;
		}
		.rate-card-summary-table {
			margin-top: 10px;
		    width: 100%;
    		border-top: 1px solid #bdbdbd;		    
		}
		table.rate-card-summary-table tr {
		    height: 22px;
		}
		.rate-card-progress-line {
		    height: 2px;
		    border-radius: 5px;
		    position: absolute;
		    border: 1px solid;
		    bottom: -4px;
		}
		.rate-card-progress-line.not-started {
			width: 0%;
			border-color: #428BCA;
			background-color: #428BCA
		}	
		.rate-card-progress-line.in-progress {
			border-color: #E58E1A;
			background-color: #E58E1A
		}
		.rate-card-progress-line.complete {
			width: 100%;
			border-color: #008852;
			background-color: #008852
		}
		.rate-card-target-ready {
    		background-color: #DFEEE6;
		}
		.rate-card-target-hover {
    		background-color: #90EE90;
   		    border: 1px dashed #008852 !important;
		}
		.ui-datepicker-trigger {
		    cursor: pointer;
		}
		.full-width {
			display: block;
		}
		.card.min-horizontal-padding {
		  	margin-bottom: 10px;
		}
		.rate-card-header-title {
		    position: absolute;
    		margin-left: 10px;
		}
		.rate-card-list-table {
		  display: table;
		  border-collapse: separate;
		  border-spacing: 5px;
		  min-height: 300px;
	      width: 100%;
		}
		.missing-rate-card {
		    background-color: #ddd;
		}
		.missing-rate-card-title {
		    position: absolute;
		    right: 0;
		    top: -4px;
	        margin-right: initial !important;
		}
		.rate-card-list-row { 
			display:table-row;
		}
		
		.rate-card-list-cell {
			display: table-cell;
		}
		.allowance-scheme-menu {
		    margin-right: 8px;
		    margin-top: 8px;
		}
		
		.card-heading-icon {
		    margin-right: 5px;
		    margin-top: 1px;
		}
		td.rate-card-value.right-align-cell {
		    width: 67px;
		}
		span.card-action-icon.fa.fa-plus-square {
		    margin-top: 2px;
			color: #333 !important;
		}
		span.card-action-icon.fa.fa-plus-square:hover {
		    color: #015BA7;
		}	
		.inner-card-title {
		    margin-right: 15px;
	    }
		/*edit panel*/
		.rate-card-name {
		    width: 380px;
		}		
		label.nowrap-label {
		    white-space: nowrap;
		}
		.allowance-type-select {
			width: 150px;
		}
		.item-value {
		    text-align: right;
		}
		div#AllowanceSchemeRateCardPopup label {
		    white-space: nowrap !important;
		}
		tr.no-rate-card-items td {
		    color: #f00;
		}
		tr.no-rate-card-items td a {
		    color: #f00 !important;
		    text-decoration: none;
		}
		.rate-card-item-count a, .inner-card-title a {
		    text-decoration: none;
		}
 	</style>

		<apex:pageMessages escape="false" id="rateCardListErrors"/>

	<apex:form id="TheForm">  

         	<div id="rate-card-list-layout" class="rate-card-list-layout">
				<div style="position:relative" class="card full-width min-horizontal-padding">
					<div class="cardHeading inverted">
						<h3 class="cardTitle rate-card-header-title"><apex:outputText value="{!KimbleOne__AllowanceScheme__c.Name}"/></h3>
						
						<div data-floating-dropdown="#{!JSENCODE(AllowanceScheme__c.Id)}-menu-data" class="fa fa-bars allowance-scheme-menu burger-menu"></div>
						<div id="{!JSENCODE(AllowanceScheme__c.Id)}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
							<ul class="floating-dropdown-menu">
								<li><apex:commandLink action="{!EditAllowanceScheme}"><i class="fa fa-pencil-square-o dropdown-icon"></i><apex:outputText value="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__AllowanceScheme__c.label}"/></apex:commandLink></li>
								<li><apex:outputLink value="{!$Page.KimbleOne__TranslationManagement}?domain=allowance" styleClass="undecorated-link"><i class="fa fa-globe dropdown-icon"></i><apex:outputText value="{!$Label.kimbleone__edit} {!$ObjectType.KimbleOne__Translation__c.labelPlural}"/></apex:outputLink></li>
							</ul>
						</div>
					</div>
				</div>
				<div class="rate-card-list-table">
				    <div class="rate-card-list-row">
						<apex:outputPanel layout="none" rendered="{!RequiresAllowanceRateCard}">
				        <div class="rate-card-list-cell card vertical">
							<div class="cardHeading">
								<div class="card-heading-icon allowance-rate-cards-ind fa fa-money" title="{!$Label.LatestAllowanceRateCards}"></div>
								<h3 class="cardTitle">{!$Label.LatestAllowanceRateCards}</h3>
							</div>
							<div class="cardBody">
								<apex:repeat value="{!CurrentAllowanceRateCards}" var="arc">
								<div class="inner-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title">
												<a href="javascript:editAllowanceSchemeRateCard('{!JSENCODE(arc.Id)}')"><apex:outputText value="{!arc.Name}"/></a>
												<div data-floating-dropdown="#ratecard-{!arc.Id}" class="rate-card-menu fa fa-bars burger-menu" style="float:none;"></div>
													<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
													<div id="ratecard-{!arc.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
											   			 <ul class="floating-dropdown-menu">
												        	<li><a href="javascript:viewRateCardItemsClick('{!JSENCODE(arc.Id)}', '{!JSENCODE(arc.Id)}', '{!JSENCODE(arc.RateCardCombinationDefinitionId)}')"><i class="fa fa-folder-open dropdown-icon"></i>{!$Label.View} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															<li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(arc.RateCardId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															 <li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(arc.RateCardCombinationDefinitionId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
														 </ul>
												</div>
											</div>
										</div>
										
										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!arc.AllowanceTypeName}"/></span>
										
										<table class="rate-card-summary-table">
										<tr>
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!arc.EffectiveFromDateUTC}"/></td>
										<apex:outputPanel layout="none" rendered="{!!ISBLANK(arc.EffectiveToDateUTC)}">
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveToDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!arc.EffectiveToDateUTC}"/></td>
										</apex:outputPanel>
										<apex:outputPanel layout="none" rendered="{!ISBLANK(arc.EffectiveToDateUTC)}">
											<td class="rate-card-label">&nbsp;</td>
											<td class="rate-card-value">&nbsp;</td>
										</apex:outputPanel>
										</tr>
										<tr>
											<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></td>
											<td class="rate-card-value right-align-cell rate-card-item-count"><a href="javascript:viewRateCardItemsClick('{!JSENCODE(arc.Id)}', '{!JSENCODE(arc.Id)}', '{!JSENCODE(arc.RateCardCombinationDefinitionId)}')"><apex:outputText value="{!arc.NumRateCardItems}"/></a></td>
											<td class="rate-card-value right-align-cell" colspan="2"><apex:outputText value="{!arc.RateCardCombinationDefinitionName}"/></td>
										</tr>
										</table>
									</div>
								</div>								
								</apex:repeat>
								
								<apex:repeat value="{!MissingAllowanceRateCardsMap}" var="marcKey">
								<apex:variable value="{!MissingAllowanceRateCardsMap[marcKey]}" var="marc"/>
								<div class="inner-card missing-rate-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title missing-rate-card-title">
											</div>
										</div>

										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!marc.AllowanceTypeName}"/></span>
									</div>
								</div>								
								</apex:repeat>
								
							</div>
						</div>
						</apex:outputPanel>
						<apex:outputPanel layout="none" rendered="{!RequiresScaleRateCard}">						
				        <div class="rate-card-list-cell card vertical">
							<div class="cardHeading">
								<div class="card-heading-icon scale-rate-cards-ind fa fa-balance-scale" title="{!$Label.LatestScaleRateCards}"></div>
								<h3 class="cardTitle">{!$Label.LatestScaleRateCards}</h3>
							</div>
							<div class="cardBody">
								<apex:repeat value="{!CurrentScaleRateCards}" var="src">
								<div class="inner-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title">
												<a href="javascript:editAllowanceSchemeRateCard('{!JSENCODE(src.Id)}')"><apex:outputText value="{!src.Name}"/></a>
												<div data-floating-dropdown="#ratecard-{!src.Id}" class="rate-card-menu fa fa-bars burger-menu" style="float:none;"></div>
													<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
													<div id="ratecard-{!src.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
											   			 <ul class="floating-dropdown-menu">
												        	<li><a href="javascript:viewRateCardItemsClick('{!JSENCODE(src.Id)}', '{!JSENCODE(src.Id)}', '{!JSENCODE(src.RateCardCombinationDefinitionId)}')"><i class="fa fa-folder-open dropdown-icon"></i>{!$Label.View} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															<li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(src.RateCardId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															 <li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(src.RateCardCombinationDefinitionId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
														 </ul>
												</div>
											</div>
										</div>
										
										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!src.AllowanceTypeName}"/></span>

										<table class="rate-card-summary-table">
										<tr>
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!src.EffectiveFromDateUTC}"/></td>
										<apex:outputPanel layout="none" rendered="{!!ISBLANK(src.EffectiveToDateUTC)}">
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveToDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!src.EffectiveToDateUTC}"/></td>
										</apex:outputPanel>
										<apex:outputPanel layout="none" rendered="{!ISBLANK(src.EffectiveToDateUTC)}">
											<td class="rate-card-label">&nbsp;</td>
											<td class="rate-card-value">&nbsp;</td>
										</apex:outputPanel>
										</tr>
										<tr>
											<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></td>
											<td class="rate-card-value right-align-cell rate-card-item-count"><a href="javascript:viewRateCardItemsClick('{!JSENCODE(src.Id)}', '{!JSENCODE(src.Id)}', '{!JSENCODE(src.RateCardCombinationDefinitionId)}')"><apex:outputText value="{!src.NumRateCardItems}"/></a></td>											
											<td class="rate-card-value right-align-cell" colspan="2"><apex:outputText value="{!src.RateCardCombinationDefinitionName}"/></td>
										</tr>
										</table>
									</div>
								</div>								
								</apex:repeat>

								<apex:repeat value="{!MissingScaleRateCardsMap}" var="msrcKey">
								<apex:variable value="{!MissingScaleRateCardsMap[msrcKey]}" var="msrc"/>
								<div class="inner-card missing-rate-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title missing-rate-card-title">
											</div>
										</div>

										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!msrc.AllowanceTypeName}"/></span>
									</div>
								</div>								
								</apex:repeat>
							</div>
						</div>
						</apex:outputPanel>						
						<apex:outputPanel layout="none" rendered="{!RequiresAdjustmentRateCard}">						
				        <div class="rate-card-list-cell card vertical">
							<div class="cardHeading">
								<div class="card-heading-icon adjustment-rate-cards-ind fa fa-adjust" title="{!$Label.LatestAdjustmentRateCards}"></div>
								<h3 class="cardTitle">{!$Label.LatestAdjustmentRateCards}</h3>
							</div>
							<div class="cardBody">
								<apex:repeat value="{!CurrentAdjustmentRateCards}" var="adrc">
								<div class="inner-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title">
												<a href="javascript:editAllowanceSchemeRateCard('{!JSENCODE(adrc.Id)}')"><apex:outputText value="{!adrc.Name}"/></a>
												<div data-floating-dropdown="#ratecard-{!adrc.Id}" class="rate-card-menu fa fa-bars burger-menu" style="float:none;"></div>
													<div class="deleting Loading" style="display:none;margin-left: 0px;float: none;"></div>
													<div id="ratecard-{!adrc.Id}" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
											   			 <ul class="floating-dropdown-menu">
												        	<li><a href="javascript:viewRateCardItemsClick('{!JSENCODE(adrc.Id)}', '{!JSENCODE(adrc.Id)}', '{!JSENCODE(adrc.RateCardCombinationDefinitionId)}')"><i class="fa fa-folder-open dropdown-icon"></i>{!$Label.View} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															<li><a href="javascript:void(0)" onclick="downloadRateCardItemsToCsv('{!JSENCODE(adrc.RateCardId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.DownloadProjectPlanButton} {!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}</a></li>
															 <li><a href="javascript:void(0)" onclick="downloadAllPossibleRateCardItemsToCsv('{!JSENCODE(adrc.RateCardCombinationDefinitionId)}');"><i class="fa fa-download dropdown-icon"></i>{!$Label.ConfigurationSetting9}</a></li>
														 </ul>
												</div>
											</div>
										</div>

										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!adrc.AllowanceTypeName}"/></span>

										<table class="rate-card-summary-table">
										<tr>
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!adrc.EffectiveFromDateUTC}"/></td>
										<apex:outputPanel layout="none" rendered="{!!ISBLANK(adrc.EffectiveToDateUTC)}">
										<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__EffectiveToDate__c.label}"/></td>
										<td class="rate-card-value right-align-cell kimble-format-date"><apex:outputText value="{!adrc.EffectiveToDateUTC}"/></td>
										</apex:outputPanel>
										<apex:outputPanel layout="none" rendered="{!ISBLANK(adrc.EffectiveToDateUTC)}">
											<td class="rate-card-label">&nbsp;</td>
											<td class="rate-card-value">&nbsp;</td>
										</apex:outputPanel>
										</tr>
										<tr>
											<td class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__RateCardItem__c.LabelPlural}"/></td>
											<td class="rate-card-value right-align-cell rate-card-item-count"><a href="javascript:viewRateCardItemsClick('{!JSENCODE(adrc.Id)}', '{!JSENCODE(adrc.Id)}', '{!JSENCODE(adrc.RateCardCombinationDefinitionId)}')"><apex:outputText value="{!adrc.NumRateCardItems}"/></a></td>											
											<td class="rate-card-value right-align-cell" colspan="2"><apex:outputText value="{!adrc.RateCardCombinationDefinitionName}"/></td>
										</tr>
										</table>
									</div>
								</div>								
								</apex:repeat>
								
								<apex:repeat value="{!MissingAdjustmentRateCardsMap}" var="madrcKey">
								<apex:variable value="{!MissingAdjustmentRateCardsMap[madrcKey]}" var="madrc"/>
								<div class="inner-card missing-rate-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title missing-rate-card-title">
											</div>
										</div>

										<span class="rate-card-label"><apex:outputText value="{!$ObjectType.KimbleOne__AllowanceSchemeRateCard__c.Fields.KimbleOne__AllowanceType__c.label}"/></span>
										<span class="rate-card-value"><apex:outputText value="{!madrc.AllowanceTypeName}"/></span>
									</div>
								</div>								
								</apex:repeat>

							</div>
						</div>
						</apex:outputPanel>
				    </div>
				</div>
				<apex:outputPanel layout="none" rendered="{!AllowanceRateCards.size > 0 || AdjustmentRateCards.size > 0 || ScaleRateCards.size > 0}">
				<div class="rate-card-list-table">
				    <div class="rate-card-list-row">
				    	<apex:outputPanel layout="none" rendered="{!RequiresAllowanceRateCard}">
				        <div class="rate-card-list-cell card vertical">
							<div class="cardHeading">
								<div class="card-heading-icon allowance-rate-cards-ind fa fa-money" title="{!$Label.PreviousAllowanceRateCards}"></div>
								<h3 class="cardTitle">{!$Label.PreviousAllowanceRateCards}</h3>
							</div>
							<div class="cardBody">
								<apex:repeat value="{!AllowanceRateCards}" var="arc">
								<div class="inner-card">								
									<div class="inner-card-body">
										<div class="inner-card-header">
											<div class="inner-card-title">
												<a href="javascript:editAllowanceSchemeRateCard('{!JSENCODE(arc.Id)}')"><apex:outputText value="{!arc.Name}"/></a>
