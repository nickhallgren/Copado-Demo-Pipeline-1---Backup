<apex:page standardcontroller="KimbleOne__CandidateResource__c" sidebar="false" extensions="KimbleOne.FilesAndAttachmentsController">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="Resourcing.html" MenuContextType="CandidateResource" MenuContextId="{!KimbleOne__CandidateResource__c.Id}" MenuContextName="{!KimbleOne__CandidateResource__c.Name}"/>

</apex:define>
    
<apex:define name="Content">
 
	<apex:pageMessages escape="false"/>
 
	<apex:pageBlock >

		<apex:pageBlockSection title="{!$Label.kimbleone__candidateresourcetasks}" collapsible="false">
      
			<apex:relatedList list="ActivityHistories" />

			<apex:relatedList list="OpenActivities" />
    
		</apex:pageBlockSection>

	</apex:pageBlock>
	
	<apex:pageBlock >
	
		<apex:pageBlockSection collapsible="false" title="{!$Label.kimbleone__candidateresourceeditnotesandattachments}">
	  
	   	  	<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
			<apex:relatedList subject="{!KimbleOne__CandidateResource__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
	
		</apex:pageBlockSection> 
	
	</apex:pageBlock>

  	<script>
		jQuery(document).ready(function() {
			if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
		});
	</script>
</apex:define>

</apex:composition>

</apex:page>