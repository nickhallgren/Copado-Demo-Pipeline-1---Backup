	<script>
		var labelMap = {};
		labelMap['this'] = '{!JSENCODE($Label.ThisLabel)}';
		labelMap['last'] = '{!JSENCODE($Label.LastLabel)}';
		labelMap['change'] = '{!JSENCODE($Label.ChangeLabel)}';
		labelMap['impact-pct'] = '{!JSENCODE($Label.ImpactLabel)}';
		labelMap['expand'] = '{!JSENCODE($Label.Expand)}';
		labelMap['trend-impact'] = '{!JSENCODE($Label.TrendImpactLabel)}';
		labelMap['all'] = '{!JSENCODE($Label.All)}';
		labelMap['history-chart-title'] = '{!JSENCODE($Label.TrendValuesByPeriodLabel)}';

		var allNarrativeParts = '{!JSENCODE($Label.TrendNarrativeParts)}';
		var narrativeParts = allNarrativeParts.split('|');
		
		var narrativeLabels = {}
		narrativeLabels['has'] = narrativeParts[0];
		narrativeLabels['fallen'] = narrativeParts[1];
		narrativeLabels['risen'] = narrativeParts[2];
		narrativeLabels['rise'] = narrativeParts[3];
		narrativeLabels['fall'] = narrativeParts[4];
		narrativeLabels['of'] = narrativeParts[5];
		narrativeLabels['thisPeriod'] = narrativeParts[6];
		narrativeLabels['primaryReason'] = narrativeParts[7];
		
		var timePeriodId = '{!JSENCODE(CurrentTimePeriod.Id)}';
		var timePeriodName = '{!JSENCODE(CurrentTimePeriod.Name)}';
		
		var targetForecastStatus = '{!JSENCODE(ForecastStatus)}';
		var targetAnalysisDimensionId = '{!JSENCODE(AnalysisDimensionId)}';
		var targetRootAnalysisFactName = '{!JSENCODE(RootAnalysisFactName)}';
		
		var parentId = 'ROOT';
		var forecastLevel = (targetForecastStatus != '' ? targetForecastStatus : 'P1');
		var chartFactLevel;
		
		var chartMinumumFactLevel = 2;
		
		var analysisDimensionId = (targetAnalysisDimensionId != '' ? targetAnalysisDimensionId : '');

		var theAnalysis;
		var theDisplaySequences;
		
		var barChartData = {};
		var theTrendAnalysisDatasets = [];
		var theTrendAnalysisDatasetDataItems = [];
		
		var nullDisplaySequenceVal = 1000000;
		
		var factColors = {};
		factColors['MarginAmount'] = '#008752';

		factColors['Revenue'] = '#E68F1A';
		factColors['Cost'] = '#729bc7';

		factColors['NumberOfBusinessDays'] = '#bbb';
		factColors['DeliveryResourceCount'] = '#008752';
		factColors['DeliveryUtilisationPct'] = '#72c6c8';
		factColors['AverageRevenueRate'] = '#729bc7';
		factColors['AverageCostRate'] = '#729bc7';

		factColors['SalesUtilisationPct'] = '#B42D34';
		factColors['OtherUtilisationPct'] = '#BBBBBB';
		
		var factDisplayTextMap = kimble.parseJSON("{!JSENCODE(FactDisplayTextJson)}");
		
		jQuery(window).load(function()
		{
			initialise();
			getBusinessUnitTrendAnalysis();
		});
		
		function initialise()
		{
			jQuery(document).off('click', '.fact-card.parent:not(.expanded)').on('click', '.fact-card.parent:not(.expanded)', drillDown);
			jQuery(document).off('change', '#forecastStatus').on('change', '#forecastStatus', changeForecastStatus);
			jQuery(document).off('change', '#analysisDimension').on('change', '#analysisDimension', changeAnalysisDimension);
			jQuery(document).off('change', '#rootAnalysisFact').on('change', '#rootAnalysisFact', changeRootAnalysisFact);
			
			jQuery(document).off('mouseover', '.history-ind').on('mouseover', '.history-ind', showHistoryChart);
			jQuery(document).off('click', '.trend-history-close').on('click', '.trend-history-close', closeHistoryPopup);
			
			jQuery('.datepicker').datepicker({
				dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
				showOtherMonths: true,
				selectOtherMonths: true,
				buttonText: '{!JSENCODE($Label.OpenTimePeriodDropdownToolTip)}',
				buttonImageOnly: true,
				buttonImage: '{!URLFOR($Resource.AssignmentImages, 'CalendarButtonSquare.png')}',
				showOn: "button",
			});
		}
		
		function getHistoryChartContainerHtml()
		{
			var html = '';
			
			html += '<div id="trend-analysis-history-chart-container">';
			html += '<canvas id="the-trend-history-chart"></canvas>';
			html += '<div id="the-trend-history-loading"><i class="fa fa-circle-o-notch fa-spin"></i></div>';
			html += '</div>';
			
			return html;
		}
		
		var displayedHistoryFact = '';
		
		function showHistoryChart()
		{
			var factEnum = jQuery(this).closest('.fact-card').attr('fact-enum');
			
			if(displayedHistoryFact != factEnum)
			{
				displayedHistoryFact = factEnum;
				
				var factLevel = jQuery(this).closest('.fact-card').attr('fact-level');
				var parentFactEnum  = jQuery(this).closest('.fact-card').attr('parent-fact-enum');
				var gradeId = (jQuery(this).attr('grade-id') != undefined ? jQuery(this).attr('grade-id') : '');
				var resourceTypeId = (jQuery(this).attr('resource-type-id') != undefined ? jQuery(this).attr('resource-type-id') : '');
				getFactHistory(jQuery(this), factEnum, (parentFactEnum != '' && parentFactEnum != 'undefined' ? parentFactEnum : null), factLevel, gradeId, resourceTypeId);
				
				jQuery(document).on('click', 'body', closeHistoryPopup);
			}
		}
		
		function closeHistoryPopup()
		{
			displayedHistoryFact = '';
			jQuery('#trend-analysis-history-chart-container').hide();

			jQuery(document).off('click', 'body');
		}

		var factHierarchyMap;
		var factHierarchySet;;
		var factDataMap = {};
		var factNarrativeMap = {};
		
		function parseTrendAnalysis()
		{
			factHierarchyMap = {};
			factHierarchySet = new Set();
			factDataMap = {};
			var displaySequencesByParent = {};
			
			for(var counter = 0; counter < theAnalysis.length; counter++)
			{
				var theAnalysisItem = theAnalysis[counter];
								
				factDataMap[theAnalysisItem.Id] = theAnalysisItem;
				
				var parentKey = (theAnalysisItem.ParentId != null ? theAnalysisItem.ParentId : 'ROOT');
				var parentFactEnum = (theAnalysisItem.ParentFactEnum != null ? theAnalysisItem.ParentFactEnum : 'ROOT');
				
				var analysisFactMemberName = (parentFactEnum!= 'ROOT' ? parentFactEnum + ':' : '') + theAnalysisItem.FactEnum;
				var displaySequence = theDisplaySequences.filter(function(x){return x.Name == analysisFactMemberName})[0].ThisDisplaySequence;
				if(displaySequence == undefined) displaySequence = nullDisplaySequenceVal;
				
				if(!(parentKey in displaySequencesByParent)) displaySequencesByParent[parentKey] = []
				displaySequencesByParent[parentKey].push({id: theAnalysisItem.Id, displaySequence: displaySequence});
				
				if(!factHierarchySet.has(parentFactEnum + ':' + theAnalysisItem.FactEnum)) factHierarchySet.add(parentFactEnum + ':' + theAnalysisItem.FactEnum);
			}
			
			sortFactCards(displaySequencesByParent);
			buildFactDropdown();
			buildAllNarratives();
		}
		
		function sortFactCards(displaySequencesByParent) {
			for(var parent in displaySequencesByParent)
			{
				factHierarchyMap[parent] = []
				if(displaySequencesByParent[parent].length > 1) {
					displaySequencesByParent[parent].sort(function(a,b) {return a.displaySequence - b.displaySequence;});
					
					//put facts with undefined display sequences into gaps in sequencing
					var freeIndex = 0;
					for(var k = 0; k <displaySequencesByParent[parent].length; k++) 
					{ 
						if(displaySequencesByParent[parent][k].displaySequence == nullDisplaySequenceVal) displaySequencesByParent[parent][k].displaySequence = freeIndex++;
						else if (displaySequencesByParent[parent][k].displaySequence == freeIndex) freeIndex++;
					}
					displaySequencesByParent[parent].sort(function(a,b) {return a.displaySequence - b.displaySequence;});
					
					for(var j = 0; j < displaySequencesByParent[parent].length; j++) factHierarchyMap[parent].push(displaySequencesByParent[parent][j].id);
				}
				else factHierarchyMap[parent].push(displaySequencesByParent[parent][0].id);
			}
		}
		
		function buildFactDropdown()
		{
			jQuery('#rootAnalysisFact').find('option').remove();
			
			jQuery('#rootAnalysisFact').append($("<option></option>")
					.attr("value", '')
					.text(labelMap['all']));
			
			// first find if we have duplicate facts (if we do we need to make sure the user visible version is unique)
			var factCountMap = {};
			for (let factEnum of factHierarchySet)
			{
				var factParts = factEnum.split(':');
				var thisFactEnum = factParts[1];
				
				if(!(thisFactEnum in factCountMap))
				{
					factCountMap[thisFactEnum] = 1;
				}
				else
				{
					factCountMap[thisFactEnum] = factCountMap[thisFactEnum] + 1;
				}
			}
			
			for (let factEnum of factHierarchySet)
			{			
				var factParts = factEnum.split(':');
				var parentFactEnum = factParts[0];
				var thisFactEnum = factParts[1];
				jQuery('#rootAnalysisFact').append($("<option></option>")
					.attr("value", factEnum)
					.text(factDisplayTextMap[thisFactEnum] + (parentFactEnum != undefined && parentFactEnum != '' && parentFactEnum != 'ROOT' && factCountMap[thisFactEnum] > 1 ? ' (' + factDisplayTextMap[parentFactEnum] + ')' : '')));
			}
			
			jQuery('#rootAnalysisFact').val(targetRootAnalysisFactName);
		}
		
		function buildAllNarratives()
		{
			factNarrativeMap = {};
			
			for(var counter = 0; counter < theAnalysis.length; counter++)
			{
				var theAnalysisItem = theAnalysis[counter];
				buildNarrativeForFactId(theAnalysisItem.Id);
			}
		}
		
		function getBusinessUnitTrendAnalysis()
		{
			jQuery('#the-trend-data-loading').toggle();
			jQuery('#trend-analysis-levels-container').toggle();
			
			if(analysisDimensionId == '') analysisDimensionId = jQuery('select#analysisDimension').val();
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.BusinessUnitTrendAnalysisController.GetBusinessUnitTrendAnalysis}',
				'{!BusinessUnit__c.Id}', timePeriodId, analysisDimensionId, 
				function(result, event)
				{
					if (event.status) 
					{
						theAnalysis = result.theAnalyses;
						theDisplaySequences = result.theDisplaySequences;

						drawTrendAnalysis();
						jQuery('#the-trend-data-loading').toggle();
						jQuery('#trend-analysis-levels-container').toggle();
					} 
					else if (event.type === 'exception') 
					{
						jQuery('#the-trend-data-loading').toggle();
						jQuery('#trend-analysis-levels-container').toggle();
						alert(event.message);
					} 
					else 
					{
						jQuery('#the-trend-data-loading').toggle();
						jQuery('#trend-analysis-levels-container').toggle();
						alert(event.message);
					}
				}, 
				{escape: true, timeout: 60000});
		}
		
		var factHistory;
		
		function getFactHistory(triggerElement, factEnum, parentFactEnum, level, gradeId, resourceTypeId)
		{
			jQuery('#trend-analysis-history-chart-container').hide();
			
			jQuery('#trend-analysis-history-chart-container').css('left', jQuery(triggerElement).offset().left + 16);
			jQuery('#trend-analysis-history-chart-container').css('top', jQuery(triggerElement).offset().top - 225);
			
			jQuery('#trend-analysis-history-chart-container').show('slow');
			jQuery('#the-trend-history-chart').hide();
