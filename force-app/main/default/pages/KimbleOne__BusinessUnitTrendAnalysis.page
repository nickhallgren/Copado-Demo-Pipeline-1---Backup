		function removeChildren(theParentId)
		{
			jQuery('div[fact-parent-id="' + theParentId + '"]').closest('.trend-level-container').remove();
			
			if(itemHasChildren(theParentId))
			{
				var currentFactChildren = factHierarchyMap[theParentId];
				
				for(var counter = 0; counter < currentFactChildren.length; counter++)
				{
					removeChildren(currentFactChildren[counter]);
				}
			}
		}
				
		function buildNarrativeForFactId(factId)
		{
			// currently only building narrative if there are child facts as the current
			// narrative logic is only of use to summarise the impact of the children
			if(!(factId in factHierarchyMap)) return;

			var narrativeParts = [];
			
			// get the fact
			var factData = factDataMap[factId];
			
			var factValues;
		
			if(forecastLevel == 'P1')
			{
				factValues = factData.P1;
			}
			else if(forecastLevel == 'P2')
			{
				factValues = factData.P2;
			}
			else if(forecastLevel == 'P3')
			{
				factValues = factData.P3;
			}
		
			var thisValue = '';
			var lastValue = '';
			var changeValue = '';	
		
			if(factData.IsCurrency)
			{
				thisValue = factValues.ThisCurrencyValue;
				lastValue = factValues.LastCurrencyValue;
				changeValue = factValues.CurrencyAmount;
			}
			else
			{
				thisValue = kimble.formatNumber(factValues.ThisValue);
				lastValue = kimble.formatNumber(factValues.LastValue);
				changeValue = kimble.formatNumber(factValues.Amount);
			}
			
			if(changeValue != 0)
			{
				var narrativePart = [];
				
				narrativePart.push(factDisplayTextMap[factData.FactEnum]);
				narrativePart.push(narrativeLabels['has']);
	
				narrativePart.push((changeValue < 0 ? narrativeLabels['fallen'] : narrativeLabels['risen']));
				narrativePart.push(narrativeLabels['thisPeriod']);
				
				narrativeParts.push(narrativePart);
			}

			// iterate the children		
			if(factId in factHierarchyMap)
			{
				var factChildren = factHierarchyMap[factId];
				var primaryFactEnum = '';
				var primaryImpactPct = 0;
				var primaryImpactAmt = 0;
				var primaryImpactAmtAbs = 0;

				for(var childCounter = 0; childCounter < factChildren.length; childCounter++)
				{
					var childFactData = factDataMap[factChildren[childCounter]];
					
					var childFactValues;
		
					if(forecastLevel == 'P1')
					{
						childFactValues = childFactData.P1;
					}
					else if(forecastLevel == 'P2')
					{
						childFactValues = childFactData.P2;
					}
					else if(forecastLevel == 'P3')
					{
						childFactValues = childFactData.P3;
					}
					
					var childThisValue = '';
					var childLastValue = '';
					var childChangeValue = '';	
				
					if(childFactData.IsCurrency)
					{
						childThisValue = childFactValues.ThisCurrencyValue;
						childLastValue = childFactValues.LastCurrencyValue;
						childChangeValue = childFactValues.CurrencyAmount;
					}
					else
					{
						childThisValue = kimble.formatNumber(childFactValues.ThisValue);
						childLastValue = kimble.formatNumber(childFactValues.LastValue);
						childChangeValue = kimble.formatNumber(childFactValues.Amount);
					}
					
					if((changeValue < 0 && childFactValues.ImpactPercentage < primaryImpactPct) || (changeValue > 0 && childFactValues.ImpactPercentage > primaryImpactPct))
					{
						primaryImpactPct = childFactValues.ImpactPercentage;
						primaryFactEnum = childFactData.FactEnum;
						primaryImpactAmt = childChangeValue;
						primaryImpactAmtAbs =  Math.abs(childChangeValue);
					}
				}
				
				if(primaryFactEnum != '')
				{
					var narrativePart = [];

					narrativePart.push(narrativeLabels['primaryReason']);
					narrativePart.push((primaryImpactAmt < 0 ? narrativeLabels['fall'] : narrativeLabels['rise']));
					narrativePart.push(factDisplayTextMap[primaryFactEnum]);
					narrativePart.push(narrativeLabels['of']);
					narrativePart.push(primaryImpactAmtAbs);
					
					narrativeParts.push(narrativePart);
				}
			}
			
			factNarrativeMap[factId] = buildNarrative(narrativeParts);
		}
		
		function buildNarrative(parts)
		{
			var partParts = [];

			for(var sentenceCounter = 0; sentenceCounter < parts.length; sentenceCounter++)
			{
				partParts.push(parts[sentenceCounter].join(' '));
			}
							
			return partParts.join('. ');
		}
		
