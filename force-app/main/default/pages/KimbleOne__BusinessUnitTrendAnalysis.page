		/* trendline calcs */		
		function TrendCalculator()
		{
		    this.count = 0;
		    this.sumX = 0;
		    this.sumX2 = 0;
		    this.sumXY = 0;
		    this.sumY = 0;
		}
		
		TrendCalculator.prototype = {
		    'add': function(x, y)
		    {
		        this.count++;
		        this.sumX += x;
		        this.sumX2 += x*x;
		        this.sumXY += x*y;
		        this.sumY += y;
		    },
		    'calcTrend': function(x)
		    {
		        var det = this.count * this.sumX2 - this.sumX * this.sumX;
		        var offset = (this.sumX2 * this.sumY - this.sumX * this.sumXY) / det;
		        var scale = (this.count * this.sumXY - this.sumX * this.sumY) / det;
		        return offset + x * scale;
		    }
		};
		
		function linearProject(data)
		{
		    var trendCalc = new TrendCalculator();
		    
		    var trendLineData = [];
		    
		    for (var i = 0; i < data.length; i++)
		    {
		        trendCalc.add(i, data[i]);
		    }
		    
			for (var i = 0; i < data.length; i++)
		    {
				trendLineData.push(roundDecimal(trendCalc.calcTrend(i), 2));
		    }
		    
		    return trendLineData;
		}

		function roundDecimal(value, decimals) {
		  return Number(Math.round(value+'e'+decimals)+'e-'+decimals);
		}
		
		/* trendline calcs */
		
		function populateHistoryChart(triggerElement)
		{
			if(factHistory != null && factHistory.length)
			{
				jQuery('#the-trend-history-chart').show();
				jQuery('#the-trend-history-loading').hide();

				var labels = [];
				var fact = {};
				fact.label = factDisplayTextMap[factHistory[0].FactEnum];
				fact.backgroundColor = factColors[factHistory[0].FactEnum];
				fact.data = [];
				
				for(counter = 0; counter < factHistory.length; counter++)
				{
					var factData = factHistory[counter];
					labels.push(factData.PeriodName);
					
					var factValues;

					if(forecastLevel == 'P1')
					{
						factValues = factData.P1;
					}
					else if(forecastLevel == 'P2')
					{
						factValues = factData.P2;
					}
					else if(forecastLevel == 'P3')
					{
						factValues = factData.P3;
					}
					
					var factValue = (factData.IsCurrency ? factValues.ThisCurrencyValue : factValues.ThisValue); 
					
					fact.data.push(factValue);
				}
				
				var trendFact = {};
				trendFact.label = 'Trend';
				trendFact.backgroundColor = 'yellow';
				trendFact.data = linearProject(fact.data);
				trendFact.type = 'line';
				trendFact.fill = false;

				var facts = [];
				facts.push(fact);
				facts.push(trendFact);
				
				var ctx = document.getElementById("the-trend-history-chart").getContext("2d");
				
				var historyChartData = {
					labels: labels,
					datasets: facts
				}
				
				if(window.myHistoryBar != undefined) window.myHistoryBar.destroy();
				
				window.myHistoryBar = new Chart(ctx, {
					type: 'bar',
					data: historyChartData,
					events: ['click'],
					options: {
						title:{
							display: true,
							text: labelMap['history-chart-title']
						},
						tooltips: {
							mode: 'index',
							intersect: false
						},
						responsive: true,
						scales: {
							xAxes: [{
								stacked: false
							}],
							yAxes: [{
								stacked: false,
								gridLines : {
									zeroLineWidth: 2
								},
								ticks: {
				                    beginAtZero: true
				                }
							}]
						},
						legend: {
							position: 'right'
						},
						maintainAspectRatio: false
					}
				});
			}
		}
		
