		function drawTrendAnalysis(ignoreParse)
		{
			if(theAnalysis.length)
			{
				if(!ignoreParse) parseTrendAnalysis();
				
				jQuery('#trend-analysis-levels-container').html(getTrendAnalysisHtml(parentId, (targetRootAnalysisFactName != '')));
				
				populateCharts();

				if(targetRootAnalysisFactName != '')
				{
					jQuery('.fact-card[fact-filter != "' + targetRootAnalysisFactName + '"]').addClass('minimised').removeClass('not-minimised');
					jQuery('.fact-card[fact-filter = "' + targetRootAnalysisFactName + '"]').removeClass('minimised').addClass('not-minimised');
				}
				else
				{
					jQuery('.fact-card').removeClass('minimised');
				}
				
				kimble.formatCurrencies();
			}
