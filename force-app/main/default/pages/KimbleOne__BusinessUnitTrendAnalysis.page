		function getTrendAnalysisHtml(theParentId, recurse)
		{
			var html = '';

			theTrendAnalysisDatasets = [];
			theTrendAnalysisDatasetDataItems = [];
			
			html += drawTrendAnalysisChildren(theParentId, recurse);
			
			if(!recurse)
			{
				if(theTrendAnalysisDatasets.length)
				{
					html += '<div class="trend-level-chart">';
					
					html += getTrendChartContainerHtml();
					
					barChartData = {
						labels: [timePeriodName],
						datasets: theTrendAnalysisDatasets
					}
	
					html += '</div>';
				}
				
				html += '</div>';
			}

			return html;
		}
		
		function drawTrendAnalysisChildren(theParentId, recurse)
		{
			var html = '';
			
			var currentFactChildren = factHierarchyMap[theParentId];
			
			html += '<div class="trend-level-container">';
			for(var counter = 0; counter < currentFactChildren.length; counter++)
			{
				var itemId = currentFactChildren[counter];
				html += getTrendAnalysisHtmlForItem(itemId);
				
				if(recurse && itemHasChildren(itemId)) html += drawTrendAnalysisChildren(itemId, recurse);
			}
			html += '</div>';
			
			return html;
		}
		
		function getTrendAnalysisHtmlForItem(theItemId)
		{
			var html = ''
			
			var factData = factDataMap[theItemId];
			
			var thisValue = '';
			var lastValue = '';
			var changeValue = '';
			var positivityClass = ' positive-change';
			
			var narrative = '';
			
			var factValues;

			if(forecastLevel == 'P1')
			{
				factValues = factData.P1;
			}
			else if(forecastLevel == 'P2')
			{
				factValues = factData.P2;
			}
			else if(forecastLevel == 'P3')
			{
				factValues = factData.P3;
			}
			
			if(factNarrativeMap[theItemId] != undefined && factNarrativeMap[theItemId] != null) narrative = factNarrativeMap[theItemId];
			
			var valueWrapperHtml = '';
			if(factData.IsCurrency)
			{
				thisValue = factValues.ThisCurrencyValue;
				lastValue = factValues.LastCurrencyValue;
				changeValue = factValues.CurrencyAmount;
				
				valueWrapperHtml = '<span class="kimble-format-currency" data-currency="' + factData.CurrencyIsoCode + '">';
			}
			else
			{
				thisValue = kimble.formatNumber(factValues.ThisValue);
				lastValue = kimble.formatNumber(factValues.LastValue);
				changeValue = kimble.formatNumber(factValues.Amount);
				
				valueWrapperHtml = '<span class="kimble-format-number">';
			}
			
			if(changeValue == 0)
			{
				positivityClass = ' neutral-change';
			}
			else if((factData.ContributionFactor < 0 && changeValue > 0) || (factData.ContributionFactor > 0 && changeValue < 0))
			{
				positivityClass = ' negative-change';
			}
			
			var hasChildren = itemHasChildren(factData.Id);
			
			html += '<div class="trend-level-item">';

			html += '<div class="fact-container">';	
			var factFilter = (factData.ParentFactEnum != undefined && factData.ParentFactEnum != null && factData.ParentFactEnum != '' ? factData.ParentFactEnum : 'ROOT') + ':' + factData.FactEnum;
			html += '<div class="fact-card' + (hasChildren ? ' parent' : '') + positivityClass + '" fact-level="' + factData.Level + '" fact-filter="' + factFilter + '" fact-enum="' + factData.FactEnum + '" parent-fact-enum="' + factData.ParentFactEnum + '" fact-id="' + factData.Id + '" fact-parent-id="' + factData.ParentId + '">';

			var factContextHtml = (factData.HasGrade ? '<div class="fact-context">' + factData.GradeName + '</div>' : (factData.HasResourceType ? '<div class="fact-context">' + factData.ResourceTypeName + '</div>' : ''));
			var cardIconClass = 'fa ' + (changeValue == undefined || changeValue == 0 || changeValue == 0.00 ? 'fa-minus-circle' : 'fa-arrow-circle-' + (changeValue > 0 ? 'up' : 'down'));
			html += '<i class="change-ind ' + cardIconClass + '"></i>';
			html += '<div class="fact-title">' + factDisplayTextMap[factData.FactEnum] + factContextHtml + '</div>';

			var changeHtml = '<div class="fact-change">' + '(' + labelMap['change'] + ': ' + valueWrapperHtml + changeValue + '</span>)</div>';
					
			html += '<div class="fact-this">' + labelMap['this'] + ': ' + valueWrapperHtml + thisValue + '</span>' + changeHtml + '</div>';
			html += '<div class="fact-last">' + labelMap['last'] + ': ' + valueWrapperHtml + lastValue + '</span></div>';
			
			var gradeHistoryHtml = (factData.HasGrade ? ' grade-id="' + factData.GradeId + '"' : '');
			var resourceTypeHistoryHtml = (factData.HasResourceType ? ' resource-type-id="' + factData.ResourceTypeId + '"' : '');
			
			html += '<i class="history-ind fa fa-bar-chart"' + gradeHistoryHtml + resourceTypeHistoryHtml + '></i>';
			if(factData.ParentId != undefined) html += '<div class="fact-impact-pct">' + labelMap['impact-pct'] + ': ' + factValues.ImpactPercentage + '%</div>';
			
			if(narrative != '')
			{
				html += '<div class="fact-narrative"><i class="narrative-ind fa fa-info-circle"></i>' + narrative + '</div>';
			}
			
			if(hasChildren)
			{
				html += '<i class="fa fa-expand parent-expander" title="' + labelMap['expand'] + '"></i>';
			}
			html += '</div>';
			html += '</div>';
			html += '</div>';
			
			if(factData.Level >= chartMinumumFactLevel)
			{
				chartFactLevel = factData.Level; 
				var dataItems = [factValues.ImpactPercentage];
				theTrendAnalysisDatasetDataItems[theTrendAnalysisDatasetDataItems.length] = factData.FactEnum;			
				theTrendAnalysisDatasets.push({label: factDisplayTextMap[factData.FactEnum], backgroundColor: factColors[factData.FactEnum], data: dataItems});
			}
			
			return html;
		}
		
