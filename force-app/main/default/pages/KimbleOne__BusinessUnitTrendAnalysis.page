					'{!BusinessUnit__c.Id}', factEnum, parentFactEnum, parseInt(level), timePeriodId, analysisDimensionId, gradeId, resourceTypeId,  
				function(result, event)
				{
					if (event.status) 
					{
						factHistory = result;
						populateHistoryChart(triggerElement);
					} 
					else if (event.type === 'exception') 
					{
						alert(event.message);
					} 
					else 
