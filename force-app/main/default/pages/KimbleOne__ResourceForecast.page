<apex:page standardcontroller="KimbleOne__Resource__c" extensions="KimbleOne.ResourceForecastController"  sidebar="false" >
 
<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

</apex:define>
    
<apex:define name="Content">

	<apex:pageBlock id="assignment" title="Assignments">
		<apex:pageBlockTable value="{!assignments}" var="a" >
			<apex:column value="{!a.Id}"/>
			<apex:column value="{!a.ResourcedActivity__r.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__Proposal__c.Fields.Name.Label}"/>
			<apex:column value="{!a.ResourcedActivity__r.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__DeliveryGroup__c.Fields.Name.Label}"/>
			<apex:column value="{!a.ResourcedActivity__r.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__ResourcedActivity__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
			<apex:column value="{!a.KimbleOne__ResourcedActivity__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ResourcedActivity__c.Label}"/>
			<apex:column value="{!a.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column value="{!a.KimbleOne__ActivityAssignmentType__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ActivityAssignmentType__c.Label}"/>
	  		<apex:column value="{!a.KimbleOne__StartDate__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}"/>
	  		<apex:column value="{!a.KimbleOne__ForecastP1EndDate__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ForecastP1EndDate__c.Label}"/>
	  		<apex:column value="{!a.KimbleOne__ForecastP2EndDate__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ForecastP2EndDate__c.Label}"/>
	  		<apex:column value="{!a.KimbleOne__ForecastP3EndDate__c}" headerValue="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ForecastP3EndDate__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>

	<apex:pageBlock id="usage" title="Usage Forecast">
		<apex:pageBlockTable id="usageAnalysesTable" value="{!usageAnalyses}" var="ua" >
			<apex:column id="usageForecastId" value="{!ua.Id}"/>
			<apex:column id="timePeriod" value="{!ua.KimbleOne__TimePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
			<apex:column id="businessUnit" value="{!ua.KimbleOne__BusinessUnit__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>
			<apex:column id="account" value="{!ua.KimbleOne__Account__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Account__c.Label}"/>
			<apex:column id="salesOpp" value="{!ua.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Proposal__c.Label}"/>
			<apex:column id="deliveryGroup" value="{!ua.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryGroup__c.Label}"/>
			<apex:column id="deliveryElement" value="{!ua.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
	  		<apex:column id="resourcedActivity" value="{!ua.KimbleOne__ResourcedActivity__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ResourcedActivity__c.Label}"/>
	  		<apex:column id="resource" value="{!ua.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column id="resourcePeriod" value="{!ua.KimbleOne__ResourcePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ResourcePeriod__c.Label}"/>
	  		<apex:column id="actualAmt" value="{!ua.KimbleOne__ActualAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ActualAmount__c.Label}"/>
	  		<apex:column id="p1ForecastAmt" value="{!ua.KimbleOne__P1ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P1ForecastAmount__c.Label}"/>
	  		<apex:column id="p2ForecastAmt" value="{!ua.KimbleOne__P2ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P2ForecastAmount__c.Label}"/>
	  		<apex:column id="p3ForecastAmt" value="{!ua.KimbleOne__P3ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P3ForecastAmount__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>

	<apex:pageBlock id="factoredUsage" title="Factored Usage Forecast">
		<apex:pageBlockTable value="{!factoredUsageAnalyses}" var="fua" >
			<apex:column value="{!fua.Id}"/>
			<apex:column value="{!fua.KimbleOne__TimePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
			<apex:column value="{!fua.KimbleOne__BusinessUnit__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>
			<apex:column value="{!fua.KimbleOne__Account__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Account__c.Label}"/>
			<apex:column value="{!fua.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Proposal__c.Label}"/>
			<apex:column value="{!fua.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryGroup__c.Label}"/>
			<apex:column value="{!fua.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__ResourcedActivity__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ResourcedActivity__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__ResourcePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ResourcePeriod__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__ActualAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__ActualAmount__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__P1ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P1ForecastAmount__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__P2ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P2ForecastAmount__c.Label}"/>
	  		<apex:column value="{!fua.KimbleOne__P3ForecastAmount__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P3ForecastAmount__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>

	<apex:pageBlock id="revenue" title="Revenue Forecast">
		<apex:pageBlockTable value="{!revenueAnalyses}" var="ra" >
			<apex:column value="{!ra.Id}"/>
			<apex:column value="{!ra.KimbleOne__TimePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__DomainClass__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DomainClass__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__BusinessUnit__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__Account__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Account__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Proposal__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryGroup__c.Label}"/>
			<apex:column value="{!ra.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
	  		<apex:column value="{!ra.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column value="{!ra.KimbleOne__Actual__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Actual__c.Label}"/>
	  		<apex:column value="{!ra.KimbleOne__P1Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P1Forecast__c.Label}"/>
	  		<apex:column value="{!ra.KimbleOne__P2Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P2Forecast__c.Label}"/>
	  		<apex:column value="{!ra.KimbleOne__P3Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P3Forecast__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>
 	
 	<apex:pageBlock id="activityCost" title="Activity Cost Forecast">
		<apex:pageBlockTable value="{!activityCostAnalyses}" var="aca" >
			<apex:column value="{!aca.Id}"/>
			<apex:column value="{!aca.KimbleOne__TimePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__DomainClass__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DomainClass__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__BusinessUnit__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__Account__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Account__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Proposal__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryGroup__c.Label}"/>
			<apex:column value="{!aca.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
	  		<apex:column value="{!aca.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column value="{!aca.KimbleOne__Actual__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Actual__c.Label}"/>
	  		<apex:column value="{!aca.KimbleOne__P1Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P1Forecast__c.Label}"/>
	  		<apex:column value="{!aca.KimbleOne__P2Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P2Forecast__c.Label}"/>
	  		<apex:column value="{!aca.KimbleOne__P3Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P3Forecast__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>

 	<apex:pageBlock id="businessUnitCost" title="Business Unit Cost Forecast">
		<apex:pageBlockTable value="{!businessUnitCostAnalyses}" var="buca" >
			<apex:column value="{!buca.Id}"/>
			<apex:column value="{!buca.KimbleOne__TimePeriod__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__TimePeriod__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__DomainClass__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DomainClass__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__BusinessUnit__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__BusinessUnit__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__Account__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Account__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__Proposal__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Proposal__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__DeliveryGroup__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryGroup__c.Label}"/>
			<apex:column value="{!buca.KimbleOne__DeliveryElement__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__DeliveryElement__c.Label}"/>
	  		<apex:column value="{!buca.KimbleOne__Resource__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Resource__c.Label}"/>
	  		<apex:column value="{!buca.KimbleOne__Actual__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__Actual__c.Label}"/>
	  		<apex:column value="{!buca.KimbleOne__P1Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P1Forecast__c.Label}"/>
	  		<apex:column value="{!buca.KimbleOne__P2Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P2Forecast__c.Label}"/>
	  		<apex:column value="{!buca.KimbleOne__P3Forecast__c}" headerValue="{!$ObjectType.KimbleOne__PerformanceAnalysis__c.Fields.KimbleOne__P3Forecast__c.Label}"/>
		</apex:pageBlockTable>
 	</apex:pageBlock>

 	
 	<script>document.write('<div id="assignmentsJson" class="automationHelper">' + JSON.stringify(kimble.parseJSON("{!JSENCODE(TheAssignmentForecastJson)}"))) + '</div>';</script>
 	<script>document.write('<div id="usageAnalysesJson" class="automationHelper">' + JSON.stringify(kimble.parseJSON("{!JSENCODE(TheUsageAnalysesJson)}"))) + '</div>';</script>
 	
</apex:define>

</apex:composition>

<style>

.automationHelper {
	display: none;
}
	
</style>
</apex:page>