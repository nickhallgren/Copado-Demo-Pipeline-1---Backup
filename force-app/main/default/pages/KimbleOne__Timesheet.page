							<div class="TimeEntryContainer" >
								<div onclick="initialiseModalBoxy('#ExpenseItemPopup', '{!$ObjectType.KimbleOne__ExpenseItem__c.label}');getExpenseItem('{!JSINHTMLENCODE(item.Id)}');" layout="block"
									class="time-entry-item TimeEntry {!IF (OR(ISBLANK(item.ExpenseClaim__r.ApprovalStatus__c), item.ExpenseClaim__r.ApprovalStatus__c = 'Unapproved'),'Draft',JSINHTMLENCODE(item.ExpenseClaim__r.ApprovalStatus__c))}"
									title="{!JSINHTMLENCODE(item.ActivityExpenseCategory__r.Name)} {!JSINHTMLENCODE(item.ExpenseClaim__r.ApprovalStatus__c)}">

									<div class="expense-entry-details">
										<apex:image styleClass="entry-icon" value="{!URLFOR($Resource.KimbleOne__TimesheetIcons, 'Expense_' + IF (OR(ISBLANK(item.ExpenseClaim__r.ApprovalStatus__c), item.ExpenseClaim__r.ApprovalStatus__c = 'Unapproved'),'Draft',JSINHTMLENCODE(item.ExpenseClaim__r.ApprovalStatus__c)) + '.png')}"/>
										<apex:outputText styleClass="activity-name" value="{!item.ActivityExpenseCategory__r.ResourcedActivity__r.Name}"/>
										<apex:outputText styleClass="category-name" value="{!item.ActivityExpenseCategory__r.Name}" />
										<div class="expense-entry-units">
											<apex:outputText value="{!item.ReimbursementCurrencyISOCode__c}" styleclass="kimbleCurrencyCode"/>
