											</div>
											</apex:outputPanel>
											<apex:outputPanel rendered="{!entry.Approved && entry.ActivityAssignment.ResourcedActivity__r.CanSelfForecast__c && entry.ActivityAssignment.ResourcedActivity__r.SelfForecastApprovalRequired__c && !ISBLANK(entry.ForecastTimeEntryId)}">
											<div class="delete-forecast-time-ind">
												<label class="fa fa-trash-o action-item delete-item" onclick="if(confirmDelete()){jQuery(this).removeClass('fa-trash-o').addClass('fa-circle-o-notch').addClass('fa-spin');deleteForecastTimeEntry('{!entry.ForecastTimeEntryId}')};"></label>
