											<span style="position:relative;left: -23px;top: -10px;">
												<apex:image url="{!URLFOR($Resource.KimbleOne__AttcIcon)}" rendered="{!item.IsReceipted__c && item.Attachments.size>0}"
													title="{!$Label.kimbleone__receiptattachmentsheading}" width="20" height="20" />
