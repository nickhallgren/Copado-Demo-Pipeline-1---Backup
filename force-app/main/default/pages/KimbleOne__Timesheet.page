			<script> 	
			var valuesLV = Array();
				
			var autoDecrementRemainingEffort = <apex:outputText value="{!AutoDecrementRemainingEffort}"/>;;
			var oldFieldValues = {};

				function validateEndDate(containerId)
				{
				   containerId = '#' + containerId;

				    var startDate = kimble.parseDate(jQuery(containerId).find('[id$="entryStartDate"]').val(), true);
				    var endDate = kimble.parseDate(jQuery(containerId).find('[id$="entryEndDate"]').val(), true);

				    if (endDate < startDate) jQuery(containerId).find('[id$="entryEndDate"]').val(kimble.formatDate(startDate.toKimbleUTC()));
    			}

                function closeActiveDatePicker()
                {
                    DatePicker.getDatePicker().skipReopen = false;
                }

				function disableTimeFields(containerId)
				{
					oldFieldValues = {};
					containerId = '#' + containerId;

					jQuery(containerId).find('input, select').attr('disabled', 'disabled');
					jQuery('.TimeFieldsLoadingPanel').show();

					jQuery.each(jQuery(containerId + ' .persist-time-field:visible'), function(i, obj){

						var $o = jQuery(obj);

						oldFieldValues[obj.id] = $o.val();
     				});

				}

				function enableTimeFields(containerId)
				{
					containerId = '#' + containerId;

					jQuery.each(jQuery(containerId + ' .persist-time-field:visible'), function(i, obj){

						var $o = jQuery(obj);

						$o.val(oldFieldValues[obj.id]);
     				});

					oldFieldValues = {};

					initialiseDynamicElements();
				}
				
				function updateHeader() {
					$('.datepicker').datepicker({
							dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
							showOtherMonths: true,
							selectOtherMonths: true,
							buttonText: '{!JSENCODE($Label.OpenTimePeriodDropdownToolTip)}',
							buttonImageOnly: true,
							buttonImage: '{!URLFOR($Resource.AssignmentImages, 'CalendarButtonSquare.png')}',
							showOn: "button"
							});
							
					updateTotals();
					enableSelectAndSubmit();

					findNumbersToFormat();
				}

				function findNumbersToFormat() {
					jQuery('.kimble-format-number').each(function (i, o) {
						let $o = jQuery(o);
						if  ($o.attr('kimble-raw-val') == null) {
						    $o.attr('kimble-raw-val', $o.text());
							$o.text(kimble.formatNumber($o.text(), $o.attr('kimble-number-format'))).show();
						}
     				});
    			}

				function quickInputClick(obj)
				{
				    var $o = jQuery(obj);

				    jQuery('.boxy-content:visible .entry-units').val(kimble.formatNumber($o.attr('quick-inp-val'), '.##')).change();
				}
				
				var origPTA = null;
				var origEntryUnits = null;
				function cacheTaskValues()
				{
					origPTA = jQuery('.edit-time-pta:visible').val();
					origEntryUnits = kimble.parseNumber(jQuery('.boxy-content:visible .entry-units').val());
				}
				
				function selectedTaskChanged()
				{
					if(autoDecrementRemainingEffort)
					{
						var origValueReset = (jQuery('.edit-time-pta:visible').val() != origPTA ? 0 : origEntryUnits);
						jQuery('.boxy-content:visible .entry-units').attr('orig-value', origValueReset);
					}
				}
				
				function refreshDraftRemainingEffort()
				{
					if(autoDecrementRemainingEffort) jQuery('.boxy-content:visible .entry-units').change();
				}

				function initialiseAsynAssignments()
				{
					jQuery('[id $= "asyncActivitySelect"]').select2({
	            		minimumInputLength: 2,
	            		multiple: false,
	            		query: function (params) {
	            			var find = function() {findMatchingAssignments(params);};        		
	        				find();
	            		},
	            		initSelection : function (element, callback) {
					        var data = {id: element.val(), text: element.attr('data-name')};
					        callback(data);
					    }
        			})
        			.on("change", function(e) {  });
				
					if({!ShowTimesheetTooltips} && {!EnhancedView})
					{
						jQuery('.ResourceActivityName').attr('t-tip-right','TEPopUpActivityName');
						initialiseTTips();	
					}		
        		}
        		
        		function stopTimerWorking()
        		{
        			jQuery('.stop-timer-btn i.fa-circle-o-notch').addClass('fa-stop-circle').removeClass('fa-circle-o-notch').removeClass('fa-spin');
        			
					jQuery('.stop-timer-btn').parent().toggleClass('hidden-item', jQuery('.stop-timer').length == 0);
					jQuery('.start-timer-btn').parent().toggleClass('hidden-item', jQuery('.stop-timer').length > 0);
        		}
        		
        		function initialiseDynamicElements()
        		{
        			jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i', 'show2400': 'true'});
        			
        			if(jQuery('.kimbleTimePicker').length > 0)
        			{
	        			jQuery(document).on('change', '.kimbleTimePicker, .EntryUnitsText', function ()
						{
							timeChange(this);
						});
					}

					jQuery('.kimbleDatePicker').datepicker({
						dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true,
						changeMonth: true,
						changeYear: true});

					if(autoDecrementRemainingEffort)
					{
						jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').attr('orig-value', kimble.parseDate(jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').val()));
						jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').attr('orig-value', kimble.parseDate(jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').val()));

						jQuery(document).off('change', '.boxy-content:visible .remaining-effort');
						jQuery(document).on('change', '.boxy-content:visible .remaining-effort', function() {
							var j = jQuery(this);
							j.attr('orig-value', kimble.parseNumber(j.val()));
						});
						
						jQuery(document).off('change', '.boxy-content:visible .entry-units');
						jQuery(document).on('change', '.boxy-content:visible .entry-units', function() {
							var origValue = jQuery(this).attr('orig-value');
	
							var newTotal = kimble.parseNumber(jQuery(this).val());
							jQuery(this).attr('orig-value', newTotal);
							
							// config switch for auto-decrementing remaining effort
							if(autoDecrementRemainingEffort && jQuery('.boxy-content:visible .remaining-effort').length > 0)
							{
								var currentRemaining = jQuery('.boxy-content:visible .remaining-effort').attr('orig-value');
								
								var delta = newTotal - (origValue != undefined ? origValue : 0);
								
								// the calendar allows you to create an entry for each day in a range so determine the number of days
								var entryDays = 1;
								if(jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').length > 0)
								{
									var entryStartDate = kimble.parseDate(jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').val()).toDate();
									var entryEndDate = kimble.parseDate(jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').val()).toDate();
									entryDays = dateDiffInDays(entryStartDate, entryEndDate) + 1;
								}
								
								var newRemaining = currentRemaining - (delta * entryDays);
								jQuery('.boxy-content:visible .remaining-effort').attr('orig-value', newRemaining);
								
								var realRemaining = Math.max(0, newRemaining);
								jQuery('.boxy-content:visible .remaining-effort').val(kimble.formatNumber(realRemaining, '0.####')).change();
							}
						});
						
						jQuery(document).off('change', '.entry-date:visible');
						jQuery(document).on('change', '.entry-date:visible', function() {
							if(autoDecrementRemainingEffort && jQuery('.boxy-content:visible .remaining-effort').length > 0)
							{
								// if units are set we must add those back onto the draft remaining total
								// before firing the change event which will then remove the new total based on the new dates
								if(jQuery('.boxy-content:visible .entry-units').val() != undefined && jQuery('.boxy-content:visible .entry-units').val() != '' && jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').length > 0)
								{
									var currentRemaining = kimble.parseNumber(jQuery('.boxy-content:visible .remaining-effort').val());
									var currentUnits = kimble.parseNumber(jQuery('.boxy-content:visible .entry-units').val());
									
									var entryStartDate = jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').attr('orig-value').toDate();
									var entryEndDate = jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').attr('orig-value').toDate();
									var entryDays = dateDiffInDays(entryStartDate, entryEndDate) + 1;
																	
									// add them back into the remaining
									var newRemaining = currentRemaining + (currentUnits * entryDays);
									jQuery('.boxy-content:visible .remaining-effort').attr('orig-value', newRemaining);
									jQuery('.boxy-content:visible .remaining-effort').val(kimble.formatNumber(newRemaining, '0.####')).change();
									
									// force a change event to re-react to this value			
									jQuery('.boxy-content:visible .entry-units').attr('orig-value', 0);
									jQuery('.boxy-content:visible .entry-units').change();
								}
							}

							var currentValue = kimble.parseDate(jQuery(this).val());
							jQuery(this).attr('orig-value', currentValue);
							//jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').attr('orig-value', kimble.parseDate(jQuery('input.datePickerPopup[id$="entryStartDate"]:visible').val()));
							//jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').attr('orig-value', kimble.parseDate(jQuery('input.datePickerPopup[id$="entryEndDate"]:visible').val()));						
						});
					}

					findNumbersToFormat();

					jQuery('.hours-and-mins').remove();

					jQuery(document).off('change','[display-hours-mins=true]').on('change', '[display-hours-mins=true]', function(e) {
							if (jQuery(this).next().hasClass('hours-and-mins'))
								jQuery(this).next().val(hoursAndMinsHelper.formatHours(kimble.parseNumber(jQuery(this).val())));
						});

						jQuery(document).off('blur','.hours-and-mins').on('blur', '.hours-and-mins', function(e) {
							var hrs = hoursAndMinsHelper.parseHours(this.value);
							jQuery(this).qtip('destroy', true);

							if (hrs == null) {
								var h = jQuery('<div style="white-space: pre-wrap;">' + hoursAndMinsHelper.helpMessage + '</div>');
								jQuery('.hours-and-mins').qtip({
															content: h,
															position: {my: 'bottom center', at: 'top center',viewport: $(window)},
															style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
															show: {ready:true, solo: true }
															});
							} else {
								jQuery(this).prev().val(kimble.formatNumber(hrs, '#,##0.####')).change();
							}
						})

					jQuery('[display-hours-mins=true]').each(function(i, obj){
						let $o = jQuery(obj);

						if ($o.is('input')) {
							$o.hide().after('<input type="text" class="hours-and-mins"/>');
							$o.change();
						}
						else {
							$o.text(hoursAndMinsHelper.formatHours(kimble.parseNumber($o.text())));
						}
					});

					if({!ShowTimesheetTooltips} && {!EnhancedView})
					{
						destroyTTips();	
						// jquery for pop up elements tips
						jQuery('.ResourceActivityName').attr('t-tip-right','TEPopUpActivityName');
						jQuery('.start-entry-date').attr('t-tip-right','TEPopUpStartDateInput');
						jQuery('.end-entry-date').attr('t-tip-right','TEPopUpEndDateInput');
						jQuery('.EntryUnitsText').attr('t-tip-right','TEPopUpEntryUnits');
						jQuery('.NoteText').attr('t-tip-right','TEPopUpNotes');
						jQuery('.EndTimeText').attr('t-tip-right','TEPopUpEndTime');
						jQuery('.StartTimeText').attr('t-tip-right','TEPopUpStartTime');
						jQuery('.NewTimeEntryRates').attr('t-tip-right','TEPopUpTimeType');
						jQuery('.PeriodRateBandSelect').attr('t-tip-right','TEPopUpTimeType');
						jQuery('.CurrentRemainingUsageOutput').attr('t-tip-right','TEPopUpCurrentRemainingUsage');
						initialiseTTips();	
					}
					
					if({!EnhancedView}) initialiseTimers();
        		}
        		
				var millisecondsPerDay = 1000 * 60 * 60 * 24;
				function dateDiffInDays(date1, date2) {
				  // Discard the time and time-zone information.
				  var date1UTC = Date.UTC(date1.getFullYear(), date1.getMonth(), date1.getDate());
				  var date2UTC = Date.UTC(date2.getFullYear(), date2.getMonth(), date2.getDate());
				
				  return Math.floor((date2UTC - date1UTC) / millisecondsPerDay);
				}
				
				function timeChange(theField)
				{
					if (jQuery('.kimbleTimePicker.StartTimeText:visible').length == 0) return;

					var currentStartTime = jQuery('.kimbleTimePicker.StartTimeText:visible').val();
					var currentEndTime = jQuery('.kimbleTimePicker.EndTimeText:visible').val();

					var $e = jQuery(theField).closest('table').find('.EntryUnitsText');

					var currentEntryUnits = kimble.parseNumber($e.val());
				
					// given a end time and a start time work out the usage
					if (jQuery(theField).hasClass('StartTimeText') && currentEndTime != '') {
						$e.val(kimble.formatNumber(timeDiff(currentStartTime, currentEndTime), '0.###'));
						$e.change();
					} else if (jQuery(theField).hasClass('EndTimeText') && currentStartTime != '') {
						$e.val(kimble.formatNumber(timeDiff(currentStartTime, currentEndTime).toFixed(3), '0.###'));
						$e.change();
					} else if (jQuery(theField).hasClass('EntryUnitsText') && currentStartTime != '') {
						// we only update the end time if the value is blank or the calculated value is greater
						// meaning that you can update the usage to less than the difference
						var newEndTime = timeAddHours(currentStartTime, currentEntryUnits);
						if(currentEndTime == '' || currentEndTime < newEndTime)
						{
							jQuery('.kimbleTimePicker.EndTimeText:visible').val(newEndTime);
						}
					}
				}
				
				function timeDiff(startTime, endTime)
				{
					// date is unimportant, using Date construct to do time maths
					return (new Date(2000, 0, 1, parseTime(endTime).hh, parseTime(endTime).mm) - new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm)) / 1000 / 60 / 60;
				}
				
				function timeAddHours(startTime, hours)
				{
					var newDateTime = addHours(new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm), hours);
				
					var min = newDateTime.getMinutes();
					
					if (min < 10) {
						min = "0" + min;
					}
			
					var hour = newDateTime.getHours();
					if (hour < 10) {
						hour = "0" + hour;
					}
			
					var newTime = hour + ':' + min;
					
					// special case - if the result is 00:00 and we are adding >0 hours then this must be 24:00
					newTime = (newTime == "00:00" && hours > 0 ? "24:00" : newTime);
					
					return newTime;
				}
				
				function addHours(theDate, hours)
				{
					theDate.setTime(theDate.getTime() + (hours * 60 * 60 * 1000));
					return theDate;
				}
				
				function parseTime(s)
				{
					var part = s.match(/(\d+):(\d+)(?: )?(am|pm)?/i);
					var hh = parseInt(part[1], 10);
					var mm = parseInt(part[2], 10);
					var ap = part[3] ? part[3].toUpperCase() : null;
					if (ap === "AM") {
						if (hh == 12) {
							hh = 0;
						}
					}
					if (ap === "PM") {
						if (hh != 12) {
							hh += 12;
						}
					}
					return {
						hh : hh,
						mm : mm
					};
