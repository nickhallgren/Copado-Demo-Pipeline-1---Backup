					else
					{
						jQuery('.submission-errors-ind').hide();
						jQuery('.time-has-errors').removeClass('time-has-errors');
					}
				}

				function initialiseTTipsToggle()
				{
					
					var ShowTTips = <apex:outputText value="{!ShowTimesheetTooltips}"/>; 
				
					if(ShowTTips)
					{
						jQuery(".show-tips-tgl").removeClass('fa-toggle-off');
						jQuery(".show-tips-tgl").addClass('fa-toggle-on');
					}
					else
					{
						jQuery(".show-tips-tgl").addClass('fa-toggle-off');
						jQuery(".show-tips-tgl").removeClass('fa-toggle-on');
					}
				}
				
				function toggleTTips()
				{
					var ShowTTipsOld = <apex:outputText value="{!ShowTimesheetTooltips}"/>; 
					var ShowTTipsNew = false;
					if(ShowTTipsOld == ShowTTipsNew) ShowTTipsNew = true;
				
					Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetController.UpdateToolTipSetting}',
			       		ShowTTipsNew,
			      			function(result, event){          
			             		if (event.status) 
					            {
					             	var data = {};
					             	data.results = result;
					             	location.reload();
					         	} 
					         	else if (event.type === 'exception') 
					         	{
					             	alert(event.message);
					         	} 
					         	else 
					         	{
					             	alert(event.message);
					         	}
			         	}, 
			         	{escape: false, timeout: 60000}
			     	);
				}
