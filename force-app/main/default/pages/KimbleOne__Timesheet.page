						<div class="TimeEntryPeriodFooter">
							<apex:outputText value="{!$Label.kimbleone__totaltime}  : "/>
							<apex:outputField value="{!TimeEntryTotalByDayMap[period.KimbleOne__StartDate__c].InputDecimal__c}"/>
							<apex:outputText value=" {!period.PeriodType__r.UsageUnitType__r.KimbleOne__Suffix__c}"/>
							<br />
							<apex:outputText value="{!$Label.kimbleone__totalexpense}  : "/>
							<apex:outputText value="{!ExpenseItemTotalByDayMap[period.KimbleOne__StartDate__c].CurrencyISOCode}" styleclass="kimbleCurrencyCode"/>
							<apex:outputField value="{!ExpenseItemTotalByDayMap[period.KimbleOne__StartDate__c].InputDecimal__c}" />
							
							<apex:outputPanel layout="none" rendered="{!dayCounter == TheResourceCalendarTrackingPeriod.TimePeriodsTracking__r.Size}">
								<div id="TotalForTrackingPeriodInHours" style="font-weight:bold;position:absolute;top: 45px;width:132px;left:0px;font-size: 11px;">{!$Label.TotalTimeHeading}  :&nbsp;<apex:outputField value="{!FormattedTotalForTrackingPeriod.KimbleOne__InputDecimal__c}"/></div>
							</apex:outputPanel>
						</div>
					</apex:outputPanel>
					<apex:outputPanel layout="none" rendered="{!IsMonthView && isLastDayOfWeek}">
						<div class="week-wrapper"></div>
