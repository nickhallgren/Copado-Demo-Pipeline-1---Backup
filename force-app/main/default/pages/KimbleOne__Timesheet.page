        		// Called by select2 to dynamically populate selects with large lists 
				function findMatchingAssignments(params)
				{
					var trackingPeriodStartDateUTC = '{!YEAR(TheResourceTrackingPeriod.StartDate__c)}-{!MONTH(TheResourceTrackingPeriod.StartDate__c)}-{!DAY(TheResourceTrackingPeriod.StartDate__c)}';
					
					// take the start date from the onscreen entryStartDate if visible, otherwise read the default from the select2 control
					var defaultEntryDateUTC = (params.element != undefined && params.element != null && params.element.attr('data-startdate') != '' ? params.element.attr('data-startdate') : trackingPeriodStartDateUTC);
					var entryStartDateUTC = (kimble.parseDate(jQuery('[id$="entryStartDate"]:visible').val(), false) != null ? kimble.parseDate(jQuery('[id$="entryStartDate"]:visible').val(), false) : defaultEntryDateUTC);
					
					Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetController.FindMatchingAssignments}',
			       		'{!TheResource.Id}', entryStartDateUTC, trackingPeriodStartDateUTC, params.term,
			      			function(result, event){          
			             		if (event.status) 
					            {
					             	var data = {};
					             	data.results = result;
					             	params.callback(data);
					         	} 
					         	else if (event.type === 'exception') 
					         	{
					             	alert(event.message);
					         	} 
					         	else 
					         	{
					             	alert(event.message);
					         	}
			         	}, 
			         	{escape: false, timeout: 60000}
			     	);
				}
								
				var periodSummary = {};
				var currentPeriodId = '{!JSENCODE(TheResourceTrackingPeriod.Id)}';
				var timesheetPageUrl = '{!$Page.Timesheet}?periodId=';

	            var summaryLabel = [];
				summaryLabel['active-timer'] = '<apex:outputText value="{!$Label.kimbleone__timermessage02}"/>';
								
				var resourceParam = ((getQueryVariable('id') != '') ? '&id={!TheResource.id}' : '');

				function jumpToTimesheetPage(periodId)
            	{
                	safeNavigateToSForceURL(timesheetPageUrl + periodId + resourceParam);
            	}

				function getPeriodSummary(relativeToDate)
				{
					jQuery('.period-summary-working-ind').show();
					jQuery('.period-summary-ind').addClass('working');
					var trackingPeriodStartDateUTC = '{!YEAR(TheResourceTrackingPeriod.StartDate__c)}-{!MONTH(TheResourceTrackingPeriod.StartDate__c)}-{!DAY(TheResourceTrackingPeriod.StartDate__c)}';
					
					Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetController.GetTimeEntrySummary}',
			       		(relativeToDate == null ? trackingPeriodStartDateUTC : relativeToDate), true, '{!TheResource.Id}',
			      			function(result, event){          
			             		if (event.status) 
					            {
					             	periodSummary = result;
					             	
					             	if(periodSummary.ForecastingPeriodIds.length 
					             		&& periodSummary.ForecastingPeriodMap[periodSummary.ForecastingPeriodIds[0]].TrackingPeriodIds.length)
					             	{	
					             		var $container;
					             		if (jQuery('#fixed-header').css("visibility") === "visible")
					             			$container = jQuery('#fixed-header .period-summary-container');
					             		else
					             			$container = jQuery('#fixed-header-container .period-summary-container');
					             		refreshPeriodSummary($container);
					             		showPeriodSummary();
				             		}
					         	} 
					         	else 
					         	{
					             	alert(event.message);
					         	}

				             	jQuery('.period-summary-working-ind').hide();
				             	jQuery('.period-summary-ind').removeClass('working');
			         	}, 
			         	{escape: false, timeout: 60000}
			     	);				
				}
				
				function redirectToExpenseClaimEdit(expenseId)
				{
					var expenseURL = '<apex:outputText value="{!$Page.KimbleOne__ExpenseClaimEdit}?Id=EXPENSE_ID_PLACEHOLDER&ts={!ExpenseClaimRedirectKey}&src=t" />';
					var newURL = expenseURL.replace('EXPENSE_ID_PLACEHOLDER',expenseId);
			        safeNavigateToSForceURL(newURL);
				}
				
