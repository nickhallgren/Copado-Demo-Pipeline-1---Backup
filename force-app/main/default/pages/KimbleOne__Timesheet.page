									<div class="time-entry-details">
										<apex:image styleClass="entry-icon" value="{!URLFOR($Resource.KimbleOne__TimesheetIcons, If(entry.Approved,'Forecast','Forecast_ReadyForApproval') + '.png')}"/>
										<apex:outputText styleClass="activity-name" value="{!entry.ActivityAssignment.ResourcedActivity__r.FullName__c}"/>
										<apex:outputText styleClass="role-name" value="{!entry.RoleName}" rendered="{!!ISBLANK(entry.RoleName)}"/>

										<div class="time-entry-units">
											<apex:outputText styleClass="formatted-units" value="{!entry.FormattedUnits}"/><apex:outputText styleClass="unit-type" value="{!period.PeriodType__r.UsageUnitType__r.KimbleOne__Suffix__c}"/>
