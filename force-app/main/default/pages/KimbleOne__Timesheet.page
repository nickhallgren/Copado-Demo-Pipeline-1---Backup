				function showSubmissionErrors()
				{
					if(jQuery('.time-entry-errors-ind').length)
					{
						var dayContainer = jQuery('.time-entry-errors-ind').closest('.time-entry-period-body')
						
						jQuery('#header-container .time-entry-period-header[period-id="' + dayContainer.attr('period-id') + '"]').find('.submission-errors-ind').show();
						
						jQuery('.time-entry-errors-ind').closest('.time-entry-card').addClass('time-has-errors');
