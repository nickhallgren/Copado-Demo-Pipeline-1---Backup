			</apex:outputPanel>
			<script>
				var showSuggestions = true;
				var hoursAndMinsHelper;

				var l = {};
				l['activeTimers'] = '<apex:outputText value="{!$Label.kimbleone__timermessage01}"/>';

				jQuery(document).ready(function(){
					jQuery.each($('.entryHeight'), function (i, obj) {var h = $(obj).height();var nh = 20 * $(obj).attr('data-hours');if(nh > h) $(obj).height(nh+'px');})
					
					jQuery("div.time-entry-footer").click(function(e) {
					   // prevent click on the actualise time checkbox bubbling up to the click handler for the forecast time entry
					   e.stopPropagation();
					});
					
					jQuery(document).off('click', 'div.ActualisableForecast').on('click', 'div.ActualisableForecast', createNewTimeEntryFromForecast);
					jQuery(document).off('click', 'div.EditForecast').on('click', 'div.EditForecast', getForecastEntryForEdit);
					jQuery(document).off('click', 'div.time-entry-card.openable').on('click', 'div.time-entry-card.openable', openTimeEntry);
					jQuery(document).off('click', 'div.expense-entry-card.openable').on('click', 'div.expense-entry-card.openable', openExpenseItem);
					
					jQuery(document).off('click', 'li#select-all:not(.disabled)').on('click', 'li#select-all:not(.disabled)', selectAll);
					jQuery(document).off('click', 'li#select-draft:not(.disabled)').on('click', 'li#select-draft:not(.disabled)', selectAllDraft);
					jQuery(document).off('click', 'li#select-items:not(.disabled)').on('click', 'li#select-items:not(.disabled)', selectModeOn);
					jQuery(document).off('click', '.cancel-select-btn').on('click', '.cancel-select-btn', selectModeOff);
					jQuery(document).off('click', '.actualise-btn').on('click', '.actualise-btn', convertSelectedToActual);
					jQuery(document).off('click', 'li#submit-all:not(.disabled)').on('click', 'li#submit-all:not(.disabled)', submitAllTime);
					jQuery(document).off('click', 'li#submit-items:not(.disabled)').on('click', 'li#submit-items:not(.disabled)', submitSelectedTime);
					jQuery(document).off('click', '.adjust-time-btn').on('click', '.adjust-time-btn', AdjustPeriod);
					
					jQuery(document).off('change', '.actualise-time, .select-time').on('change', '.actualise-time, .select-time', checkboxChange);
					
					// stop the createNewTimeEntryFromForecast firing when checking the actualise checkbox
					jQuery('.entry-card-actions .actualise-time, .entry-card-actions .select-time, .entry-card-actions .delete-forecast-time-ind, .entry-card-actions .delete-time-ind').on('click', function(e){
						e.stopPropagation();
					});

					if({!EnhancedView})
					{
						jQuery(document).off('click', '.te-timer .stop-timer').on('click', '.te-timer .stop-timer', stopTimer);
						jQuery(document).off('click', '.te-timer-copy .stop-timer').on('click', '.te-timer-copy .stop-timer', stopPopupTimer);

						jQuery('.stop-timer-btn').parent().toggleClass('hidden-item', jQuery('.stop-timer').length == 0);
						jQuery('.start-timer-btn').parent().toggleClass('hidden-item', jQuery('.stop-timer').length > 0);

						//fixed-header-container
						jQuery('#fixed-header').html(jQuery('#fixed-header-container').html());
						jQuery(window).unbind('scroll');
	            		jQuery(window).scroll(scrollFixed);

						destroyTTips();	
						initialiseTTipsToggle();
						
						if({!ShowTimesheetTooltips}) jQuery('.TTipsShowTipsToggle').attr('t-tip-default','ShowTipsToggleOn');
						else jQuery('.TTipsShowTipsToggle').attr('t-tip-default','ShowTipsToggleOff');

						jQuery.fn.timer = function() {
							this.each(function(){
								var t = jQuery(this);
								var intervalId = setInterval(function() {
									var eTime = t.attr('timer-elapsed-time-s');
									
									// add a second
									var totalSeconds = parseInt(eTime) + 1;
									var seconds = totalSeconds + 1;
									var minutes = Math.floor(seconds/60);
									var hours = Math.floor(minutes/60);
									var days = Math.floor(hours/24);
									
									minutes = minutes-(hours*60);
									seconds = (seconds-(hours*60*60)-(minutes*60)).toFixed(0);
	
									t.attr('timer-elapsed-time-s', totalSeconds);
									var formattedTimer = padPart(hours) + ':' + padPart(minutes) + ':' + padPart(seconds);
									t.text(formattedTimer);
									// if there is an open time entry popup for this time entry we also update the timer
									// (more accurate than attempting to run another timer in parallel)
									var theEntryId = t.attr('entry-id');
									jQuery('.ticker-copy[entry-id="' + theEntryId + '"]').text(formattedTimer);
							    }, 1000);
							    t.data('int-id', intervalId);
							    t.addClass('ticking');
							});
						}
	
						jQuery.fn.stopTimer = function() {
							this.each(function(){
								var t = jQuery(this);
								clearInterval(t.data('int-id'));
								t.removeClass('ticking');
							});
						}						
						
						initialiseTTips();
						
						initialiseTimers();

						hoursAndMinsHelper = initialiseHoursAndMinsHelper('{!JSENCODE($Label.HoursPart)}','{!JSENCODE($Label.MinutesPart)}', '{!JSENCODE($Label.HoursAndMinsEntryHelp)}');
					}
				});			

			    var padPart = function(n) { return ('' + n).length < 2? padPart('0' + n) : n;};
				
				function initialiseTimers()
				{
				    
				    jQuery('.ticker').each(function() {
				    	var t = jQuery(this);
						// time the timer was started
						var sDateTime = t.attr('timer-start-time');
						var sTime = sDateTime.getTimeFromDateTime(true);
						var sTimeParts = sTime.split(':');
						var sDate = sDateTime.toDateDiscardTime();
						sDate.setHours(sTimeParts[0], sTimeParts[1], sTimeParts[2]);
						
						// current time
						var cDate = new Date();

						// difference between start time and current time stored as counted time
						// adjust for timezone
						var tzAdj = new Date(new Date() - new Date()).getTimezoneOffset() * 60 * 1000

						// work out the difference in seconds and add one
						var diff = cDate.getTime() - sDate.getTime();
						var totalSeconds = diff / 1000;
						var seconds = totalSeconds;
						var minutes = Math.floor(seconds/60);
						var hours = Math.floor(minutes/60);
						var days = Math.floor(hours/24);
						
						minutes = minutes-(hours*60);
						seconds = (seconds-(hours*60*60)-(minutes*60)).toFixed(0);						

						t.attr('timer-elapsed-time-s', totalSeconds);
	
						var formattedTimer = padPart(hours) + ':' + padPart(minutes) + ':' + padPart(seconds);
						t.text(formattedTimer);
				    });
					                
					jQuery('.ticker:not(.ticking)').timer();
				}
				
				function stopPopupTimer(e)
				{
					jQuery(this).removeClass('fa-stop-circle').addClass('fa-circle-o-notch').addClass('fa-spin');
					var timerEntryId = jQuery(this).closest('.te-timer-copy').find('.ticker-copy').attr('entry-id');
					
					jQuery('.ticker[entry-id="' + timerEntryId + '"]').stopTimer();
					saveTimeEntryStopTimer('stop', new Date().toKimbleUTC(), jQuery('.ticker[entry-id="' + timerEntryId + '"]').attr('timer-elapsed-time-s'), 'reload');
				}

				function hideWorking()
				{
					jQuery('#loadingIndicatorOuterContainer').hide();
				}
				
				function showWorking()
				{
					jQuery('#loadingIndicatorOuterContainer').show();
				}
				
				function submitAllTime()
				{
					if(checkActiveTimers())
					{
						showWorking();
						enhancedSubmitAll();
					}
				}
				
				function submitSelectedTime()
				{
					if(checkActiveTimers(true))
					{
						showWorking();
						enhancedSubmitSelected();
					}
				}
				
				function convertSelectedToActual()
				{
					showWorking();
					enhancedActualise();
				}
				
				function checkActiveTimers(selectedOnly)
				{
					var timerCount = (selectedOnly ? jQuery('.time-entry-card.selected .te-timer.active').length : jQuery('.te-timer.active').length);
					
					if(timerCount > 0) alert(l['activeTimers']);
					
					return timerCount == 0;
				}
				
				function updateTotals()
				{
					jQuery('.total-units').text(jQuery('.hidden-period-total span').text());
					jQuery('.hidden-day-total span').each(function() {
						var thisTotal = jQuery(this);jQuery('div.time-entry-period-header[period-id="' + thisTotal.closest('div.time-entry-period-body').attr('period-id') + '"] div.unit-amt span').text(thisTotal.text());
					});
				}

				function checkboxChange()
				{
					var clickedItem = jQuery(this);
					selectItem(clickedItem.closest('.entry-card'), clickedItem.find('input').is(':checked'));
				}
				
				function selectModeOn()
				{
					jQuery('div.entry-card.selectable').addClass('selecting');
					jQuery('.entry-card:not(.selectable)').addClass('not-selecting');
					jQuery('.select-btn').addClass('hidden-item');
					jQuery('.cancel-select-btn').removeClass('hidden-item');
				}

				function selectAll()
				{
					selectModeOn();
					jQuery('div.entry-card.selectable').addClass('selected');
					enableSelectAndSubmit();
					jQuery('.entry-card-actions input[type="checkbox"]').prop('checked', true);
				}
				
				function enableSelectAndSubmit()
				{
					jQuery('li#select-all').toggleClass('disabled', jQuery('.selectable').length == 0);
					jQuery('li#select-draft').toggleClass('disabled', jQuery('.select-time').length == 0);
					jQuery('li#select-items').toggleClass('disabled', jQuery('.selectable').length == 0);

					jQuery('li#submit-items').toggleClass('disabled', jQuery('.selected').length == 0);
					jQuery('li#submit-all').toggleClass('disabled', jQuery('.select-time').length == 0);
				}
				
				function selectAllDraft()
				{
					selectModeOn();
					jQuery('.select-time').closest('.entry-card.selectable').addClass('selected');
					enableSelectAndSubmit();
					jQuery('.select-time input[type="checkbox"]').prop('checked', true);
				}
				
				function selectItem(clickedItem, forceState)
				{
					if(forceState != undefined)
					{
						clickedItem.toggleClass('selected', forceState);
					}
					else
					{
						clickedItem.toggleClass('selected');
						clickedItem.find('input[type="checkbox"]').prop('checked', clickedItem.hasClass('selected'));
					}

					enableSelectAndSubmit();
					jQuery('.actualise-btn').toggleClass('hidden-item', jQuery('.actualise-time input[type="checkbox"]:checked').length == 0);
				}
				
				function selectModeOff()
				{
					jQuery('div.selecting').removeClass('selecting').removeClass('selected');
					jQuery('.not-selecting').removeClass('not-selecting');
					jQuery('.select-btn').removeClass('hidden-item');
					jQuery('.cancel-select-btn, .actualise-btn').addClass('hidden-item');
					enableSelectAndSubmit();
					jQuery('.entry-card-actions input[type="checkbox"]').prop('checked', false);
				}
				
				function stopActiveTimer()
				{
					// find and stop the active timer
					jQuery('.stop-timer-btn i').removeClass('fa-stop-circle').addClass('fa-circle-o-notch').addClass('fa-spin');
					jQuery('.te-timer .stop-timer').click();
				}
				
				function stopTimer(e)
				{
					jQuery(this).removeClass('fa-stop-circle').addClass('fa-circle-o-notch').addClass('fa-spin');
					jQuery(this).closest('.te-timer').find('.ticker').stopTimer();
					inlineStopTimer(jQuery(this).closest('.time-entry-card').attr('data-entry-id'), 'stop', new Date().toKimbleUTC(), jQuery(this).closest('.te-timer').find('.ticker').attr('timer-elapsed-time-s'));
					
					e.stopPropagation();
				}
				
				function getLocalTime()
				{
					// EDGE has a bug which returns the "right-to-left" character within a locale based string so this needs to be parsed out
					// secondly EDGE will default to AM/PM format not 24h so we force the 2-digit format
					return new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit', hour12: false}).replace(/\u200E/g,"");
				}
				
				function defaultFieldsAndStartNewTimerFromForecast()
				{
					// if mandatory fields are applicable but null they'll prevent the save of the entry
					// default them based on the logic that would apply if the entry was from scratch
					
					// Default Start/End Time to now and Units to 0 - the timer will populate these when stopped
					var currentTime = getLocalTime().slice(0,5);
					
					var remainingUnitsField = jQuery('.boxy-content:visible .remaining-effort');
					var startTimeField = jQuery('.kimbleTimePicker.StartTimeText:visible');
					var endTimeField = jQuery('.kimbleTimePicker.EndTimeText:visible');
					var entryUnitsField = jQuery('.EntryUnitsText:visible');
					
					remainingUnitsField.attr('disabled', 'disabled');
					entryUnitsField.attr('disabled', 'disabled');
					startTimeField.attr('disabled', 'disabled');
					endTimeField.attr('disabled', 'disabled');
					
					if(startTimeField.val() == "") startTimeField.val(currentTime);
					if(endTimeField.val() == "") endTimeField.val(currentTime).change();
					
					startNewTimerFromForecast('start', new Date().toKimbleUTC(), getLocalTime());
				}
				
				function scrollFixed()
				{
					if(jQuery($thePeriodSummaryContainer).hasClass('floating')) hidePeriodSummary();

				    var $orginal = jQuery('#fixed-header-container');
				    var originalTop = $orginal.offset().top;
					var winScroll = jQuery(window).scrollTop();

					var $f = jQuery('#fixed-header');

					if (winScroll > originalTop - 2)
					{
						$f.css({visibility:'visible'});
						$f.width($orginal.width());
					}
					else
					{
						$f.css({visibility:'hidden'});
					}
    			}

				function createNewTimeEntryFromForecast()
				{
					var clickedItem = jQuery(this);

					if(clickedItem.hasClass('selecting'))
					{
						selectItem(clickedItem);
					}
					else
					{
						var theActualisableKey = clickedItem.attr('data-actualisable-key');

						initialiseModalBoxy('#NewTimeEntryFromForecastPopup', '{!$ObjectType.TimeEntry__c.label}');
						newTimeEntryFromForecast(theActualisableKey);
					}
				}
				
				function toggleSuggestions()
				{
					var clickedItem = jQuery(this);
				}

				function getForecastEntryForEdit()
				{
				    var clickedItem = jQuery(this);
					var theEntryKey = clickedItem.attr('data-actualisable-key');

					initialiseModalBoxy('#EditForecastEntryPopup', '{!$ObjectType.ForecastTimeEntry__c.label}');
					getForecastEntry(theEntryKey);
    			}
    			
    			function openTimeEntry()
    			{
				    var clickedItem = jQuery(this);

					if(clickedItem.hasClass('selecting'))
					{
						selectItem(clickedItem);
					}
					else
					{
						var theEntryId = clickedItem.attr('data-entry-id');

						initialiseModalBoxy('#EditTimeEntryPopup', '{!$ObjectType.TimeEntry__c.label}');
						editTimeEntry(theEntryId);
					}
    			}
    			
    			function openExpenseItem()
    			{
				    var clickedItem = jQuery(this);
					var theItemId = clickedItem.attr('data-item-id');

					initialiseModalBoxy('#ExpenseItemPopup', '{!$ObjectType.KimbleOne__ExpenseItem__c.label}');
					getExpenseItem(theItemId);
    			}
				
				function destroyTTips()
				{
					jQuery('[t-tip]').qtip('destroy', true);
					jQuery('[t-tip-right]').qtip('destroy', true);
					jQuery('[t-tip-grid-row]').qtip('destroy', true);
				}
				
				function initialiseTTips()
				{
					var enableTTips = <apex:outputText value="{!ShowTimesheetTooltips}"/>; 
					
					// set up default TTips 
					jQuery('[t-tip-default]').qtip('destroy', true).each(function()
					{
					   jQuery(this).qtip({
							content: ttipLabels[jQuery(this).attr('t-tip-default')],
							position: {my: 'bottom center', at: 'top center',viewport: $(window)},
							style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
							show: { solo: true }
					   });
					});
					
					// set up tips if setting enabled
					if(enableTTips)
					{
						jQuery('[t-tip]').qtip('destroy', true).each(function()
						{
						   jQuery(this).qtip({
								content: ttipLabels[jQuery(this).attr('t-tip')],
								position: {my: 'bottom center', at: 'top center',viewport: $(window)},
								style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
								show: { solo: true }
						   });
						});
						
						jQuery('[t-tip-right]').qtip('destroy', true).each(function()
						{
							jQuery(this).qtip({
								content: ttipLabels[jQuery(this).attr('t-tip-right')],
								position: {my: 'left center', at: 'right center', viewport: $(window)},
								style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
								show: { solo: true }
						    });
						});
						
						jQuery('[t-tip-grid-row]').qtip('destroy', true).each(function()
						{
							jQuery(this).qtip({
								content: ttipLabels[jQuery(this).attr('t-tip-grid-row')],
								position: {my: 'top right', at: 'bottom center', viewport: $(window)},
								style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
								show: { solo: true }
							});
						});
					}
				}	

			</script>

