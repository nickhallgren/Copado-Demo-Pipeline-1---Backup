							<!-- Show each forecast time period  --> 
							<apex:repeat value="{!ForecastTimeEntriesByDayMap[period.KimbleOne__StartDate__c]}" var="entry">
							<div class="TimeEntryContainer" id="TimeEntryContainer" >
