				      	   			<apex:outputText value="{!TimeEntry.Timesheet__r.Name}"/>
				      			</apex:outputLink>
							</apex:pageBlockSectionItem>
							
			       		</apex:pageblockSection>
		        	</apex:outputPanel>				       			
					</apex:pageBlock>
					
						
						<apex:outputPanel id="TimeButtonPanel">
						
						<apex:pageBlock >
						<apex:pageBlockButtons styleclass="ButtonPanelAddTimeEntry" id="ButtonPanelAddTimeEntry" location="bottom">
							<apex:outputPanel layout="none" rendered="{!canEdit && $ObjectType.KimbleOne__TimeEntry__c.updateable}">
								<input id="saveTimeEntryBtn" class="btn DisableButtonWhileBusy TimeSaveButton" type="button" onclick="saveTimeEntry(); destroyTTips();"
									value="{!$Label.SaveTimeEntry}" />
							</apex:outputPanel>
							<apex:outputPanel layout="none" rendered="{!canEdit && $ObjectType.KimbleOne__TimeEntry__c.deletable}">
								<input id="deleteTimeEntryBtn" class="btn DisableButtonWhileBusy"  type="button" onclick="deleteTimeEntry()" value="{!$Label.DeleteButton}"  />
							</apex:outputPanel>
							<input class="btn" type="button" onclick="hideModalBoxy();"	value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
						</apex:pageBlock>
						</apex:outputPanel>
						
				</apex:form>

			</apex:outputPanel></div>

			<div id="NewTimeEntryFromForecastPopup" style="display: none">

			<apex:outputPanel id="NewTimeEntryFromForecastDetails" style="min-width:550px;min-height:300px;display:block">

				<apex:form >
					<apex:actionFunction action="{!SaveTimeEntry}" name="saveNewTimeEntryFromForecast" oncomplete="if (checkOperationSuccess(jQuery('[id$=\'saveNewTimeEntryFromForecastBtn\']'))) {hideModalBoxyWithErrorCheck('#newFromForecastErrors'); updateHeader();initialiseDynamicElements();}" rerender="TimeForm, NewTimeEntryFromForecastDetails"></apex:actionFunction>
					<apex:actionFunction action="{!SaveTimeEntry}" rendered="{!EntryPeriod.Id == TodayPeriodId}" name="startNewTimerFromForecast" oncomplete="if (checkOperationSuccess(jQuery('[id$=\'startNewTimerFromForecastBtn\']'))) {hideModalBoxyWithErrorCheck('#newFromForecastErrors'); updateHeader();initialiseDynamicElements();}" rerender="TimeForm, NewTimeEntryFromForecastDetails">
						<apex:param name="tmrAction" value="start" />
						<apex:param name="tmrStartDteUTC" value="" />
						<apex:param name="tmrStartTime" value="" />
					</apex:actionFunction>
						
					<apex:outputPanel id="TimeMessagePanel">
						<div id="newFromForecastErrors"><apex:pageMessages escape="false" id="errormessages" /></div>
					</apex:outputPanel>
					
					<apex:variable var="SuffixTranslationKey" value="{!$ObjectType.KimbleOne__UnitType__c.Name}:{!$ObjectType.KimbleOne__UnitType__c.Fields.KimbleOne__Suffix__c.Name}:{!TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__UsageUnitType__c}" />
					<apex:variable var="SuffixTrans" value="{!TranslationsMap[SuffixTranslationKey]}" />
					<apex:variable var="Suffix" value="{!TheSelectedAssignment.ResourcedActivityOperatedWith__r.UsageUnitType__r.KimbleOne__Suffix__c}" />
					<apex:variable var="EntryTranslationKey" value="{!$ObjectType.KimbleOne__TimeEntry__c.Name}:{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EntryUnits__c.Name}:{!TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__UsageUnitType__c}" />
					<apex:variable var="EntryLabelTrans" value="{!TranslationsMap[EntryTranslationKey]}" />
						
					<apex:pageBlock mode="edit" rendered="{!!ISBLANK(TimeEntry)}">
						<apex:outputPanel id="NewTimeEntryFromForecastDetailsSubPanel">
						
						<apex:pageblockSection collapsible="false" showheader="false" columns="1">
							
							<apex:pageBlockSectionItem labelStyle="width:30%">
								<apex:outputText value="{!$Label.kimbleone__resourceactivityalternativelabel}" />
								<apex:outputPanel >
									<apex:outputText value="{!TheSelectedAssignment.Case__r.CaseNumber} " rendered="{!!ISBLANK(TheSelectedAssignment.KimbleOne__Case__c)}"/>
									<apex:outputText value="{!TheSelectedAssignment.ResourcedActivity__r.Name}" />
									<apex:outputText value=" ({!TheSelectedAssignment.ActivityRole__r.Name})" rendered="{!!ISBLANK(TheSelectedAssignment.ActivityRole__r.Name)}" />
								</apex:outputPanel>		
							</apex:pageBlockSectionItem>
						
							<apex:pageBlockSectionItem >
								<apex:outputText value="{!$Label.kimbleone__day}" />
								<apex:outputText value="{!EntryPeriod.Name}" />
							</apex:pageBlockSectionItem>
						
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$Label.kimbleone__periodratebandalternatenamelabel}" />
								<apex:outputPanel layout="none">
									<apex:outputPanel layout="block" styleClass="requiredInput">
										<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
											<apex:actionRegion >
												<apex:selectList value="{!TimeEntry.KimbleOne__ActivityAssignmentRate__c}" styleclass="" multiselect="false" size="1" required="true">
													<apex:actionSupport event="onchange" action="{!SelectActivityAssignmentRateEdit}" rerender="NewTimeEntryFromForecastDetailsSubPanel, TimeButtonPanel" onsubmit="disableTimeFields('NewTimeEntryFromForecastPopup')" oncomplete="enableTimeFields('NewTimeEntryFromForecastPopup')" />
													<apex:selectOptions value="{!TheActivityPeriodRateBandOptionsEdit}" />
												</apex:selectList>
												<apex:outputPanel styleclass="TimeFieldsLoadingPanel" style="display:none">	
													<img src="{!URLFOR($Resource.LoadingImage)}" />
												</apex:outputPanel>
											</apex:actionRegion>
									</apex:outputPanel>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && ShowCurrentRemainingUsageInTimeEntry}">
								<apex:outputLabel value="{!$Label.kimbleone__currentremainingusagelabel}"/>
								<apex:outputPanel layout="none">
									<span class="kimble-format-number" kimble-number-format="0.####" display-hours-mins="{!!ISBLANK(TheSelectedAssignment) && TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__ShowUsageAsHoursAndMins__c}">
										<apex:outputText value="{!AssignmentCurrentRemainingUsage}" />
									</span>
								<apex:outputText styleClass="CurrentRemainingUsageOutput" value=" {!SuffixTrans}"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'Task' || TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'CategoryAndTask'}">
									<apex:outputText value="{!$ObjectType.KimbleOne__Task__c.Fields.Name.Label}" />
									<apex:outputPanel layout="none">
										<apex:outputPanel layout="block" styleClass="requiredInput">
											<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
												<apex:actionRegion >
													<apex:selectList value="{!TimeEntry.KimbleOne__PlanTaskAssignment__c}" styleclass="" multiselect="false" size="1" required="true">
														<apex:selectOptions value="{!ThePlanTaskOptions}" />
														<apex:actionSupport event="onchange" action="{!SelectPlanTaskAssignmentEdit}" rerender="NewTimeEntryFromForecastDetailsSubPanel, TimeButtonPanel" onsubmit="disableTimeFields('NewTimeEntryFromForecastPopup')" oncomplete="enableTimeFields('NewTimeEntryFromForecastPopup');refreshDraftRemainingEffort();" />
													</apex:selectList>
												</apex:actionRegion>
										</apex:outputPanel>
									</apex:outputPanel>		 	 
							</apex:pageBlockSectionItem>
													
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(ThePlanTaskAssignment.Id) && !ThePlanTaskAssignment.PlanTask__r.Task__r.KimbleOne__IsFixedEffort__c}">
									<apex:outputText value="{!$ObjectType.KimbleOne__PlanTaskAssignment__c.Fields.KimbleOne__DraftRemainingEffort__c.Label}" />
									<apex:outputPanel layout="none">
										<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
										<apex:inputField required="true" html-display-hours-mins="{!!ISBLANK(TheSelectedAssignment) && TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__ShowUsageAsHoursAndMins__c}" value="{!ThePlanTaskAssignment.KimbleOne__DraftRemainingEffort__c}" html-orig-value="{!ThePlanTaskAssignment.KimbleOne__DraftRemainingEffort__c}" styleclass=" remaining-effort" />
									</apex:outputPanel>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!StartEndTimeRequired && !ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__StartTime__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:inputField id="entryStartTime" styleclass=" kimbleTimePicker StartTimeText persist-time-field" value="{!TimeEntry.KimbleOne__StartTime__c}" required="true"/>
								</apex:outputPanel>								
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!StartEndTimeRequired && !ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EndTime__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:inputField id="entryEndTime" styleclass=" kimbleTimePicker EndTimeText persist-time-field" value="{!TimeEntry.KimbleOne__EndTime__c}" required="true"/>
								</apex:outputPanel>							
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputText >
									<div><apex:outputText value="{!EntryLabelTrans}"/></div>
								</apex:outputText>
								<apex:outputPanel layout="none">
									<apex:inputField required="true" html-display-hours-mins="{!!ISBLANK(TheSelectedAssignment) && TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__ShowUsageAsHoursAndMins__c}" value="{!TimeEntry.KimbleOne__EntryUnits__c}" html-orig-value="0" styleclass=" EntryUnitsText entry-units persist-time-field "/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							 
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && TheSelectedAssignmentRate.ActivityPeriodRateBand__r.RevenueUnitsCalculationMethod__r.KimbleOne__Enum__c = 'Manual'}">
								<apex:outputText >
									<div><apex:outputText value="{!$Label.kimbleone__revenuelabel} {!SuffixTrans}"/></div>
								</apex:outputText>
								<apex:outputPanel layout="none">
									<apex:inputField required="true" value="{!TimeEntry.KimbleOne__RevenueUnits__c}" styleclass="persist-time-field"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>

							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && TheSelectedAssignment.ResourcedActivityOperatedWith__r.KimbleOne__HasCases__c}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Case__c.Label}"/>
								<apex:inputField id="caseInput" value="{!TimeEntry.KimbleOne__Case__c}"  styleclass="persist-time-field kimbleSearch" html-data-typename="LookupObjectCase" html-data-filter="TimesheetCaseFilter;{!TheSelectedAssignment.KimbleOne__ResourcedActivity__c}:{!TheSelectedAssignment.KimbleOne__DeliveryGroup__c}" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate)}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Notes__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:outputPanel layout="block" styleClass="requiredInput">
										<apex:outputPanel layout="block" styleClass="requiredBlock" rendered="{!TimeEntryNotesMandatory}"></apex:outputPanel>
										<apex:inputTextarea id="FromForecastNotes" rows="4" cols="45" value="{!TimeEntry.KimbleOne__Notes__c}" styleclass="NoteText  persist-time-field" required="{!TimeEntryNotesMandatory}"/>
									</apex:outputPanel>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'Reference'}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Reference__c.Label}"/>
								<apex:outputPanel layout="none">
									<apex:inputText id="FromForecastReference" value="{!TimeEntry.KimbleOne__Reference__c}"  styleclass=" persist-time-field"/>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>
							

							<apex:repeat value="{!NumberOfTimeCategories}" var="num" rendered="{!!ISBLANK(TheSelectedAssignmentRate) && (TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c = 'Category'  || TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'CategoryAndTask')}">
								<apex:pageBlockSectionItem rendered="{!!ISBLANK(TheSelectedAssignmentRate) && (TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c = 'Category' || TheSelectedAssignmentRate.ActivityPeriodRateBand__r.UsageAllocationType__r.KimbleOne__Enum__c == 'CategoryAndTask') && TheActivityTimeCategories[num].Show}">
								
								<apex:outputLabel value="{!TheActivityTimeCategories[num].TheCategory.Name}" />
								<apex:outputPanel layout="none">
									<apex:inputField styleclass="persist-time-field" value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" required="{!TheActivityTimeCategories[num].TheCategory.IsMandatory__c}" rendered="{!TheActivityTimeCategories[num].TheCategory.DisplayType__r.Enum__c = 'Text'}"/>
								
									<apex:outputPanel layout="block" styleClass="requiredInput" rendered="{!(TheActivityTimeCategories[num].TheCategory.DisplayType__r.Enum__c = 'Dropdown') && TheActivityTimeCategories[num].TheCategory.IsMandatory__c}">
											<apex:outputPanel layout="block" styleClass="requiredBlock"></apex:outputPanel>
											<apex:selectList value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" multiselect="false" size="1" required="true" styleclass=" persist-time-field" >
												<apex:selectOptions value="{!TheActivityTimeCategories[num].TheOptions}" />
											</apex:selectList>
									</apex:outputPanel>
									<apex:selectList value="{!TimeEntry['Category' & TEXT(TheActivityTimeCategories[num].TheCategory.DisplaySequence__c) & '__c']}" styleclass=" persist-time-field" multiselect="false" size="1" rendered="{!(TheActivityTimeCategories[num].TheCategory.DisplayType__r.Enum__c = 'Dropdown') && !TheActivityTimeCategories[num].TheCategory.IsMandatory__c}">
										<apex:selectOptions value="{!TheActivityTimeCategories[num].TheOptions}" />
									</apex:selectList>
								</apex:outputPanel>
								
								</apex:pageBlockSectionItem>
							</apex:repeat>					
							
						</apex:pageblockSection>
						
		        	</apex:outputPanel>				       			
					</apex:pageBlock>
					
						
						<apex:outputPanel id="TimeButtonPanel">
						
						<apex:pageBlock >
						<apex:pageBlockButtons styleclass="ButtonPanelAddTimeEntry" id="ButtonPanelAddTimeEntry" location="bottom">
							<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__TimeEntry__c.updateable}">
								<input id="saveNewTimeEntryFromForecastBtn" class="btn DisableButtonWhileBusy TimeSaveButton" type="button" onclick="saveNewTimeEntryFromForecast();"
									value="{!$Label.ForecastTimeSaveAsDraftBtn}" />
									
								<apex:outputPanel layout="none" rendered="{!EntryPeriod.Id == TodayPeriodId && !HasActiveTimer}">
								<input id="startNewTimerFromForecastBtn" class="btn DisableButtonWhileBusy TimeSaveButton" type="button" onclick="defaultFieldsAndStartNewTimerFromForecast();"
									value="{!$Label.kimbleone__starttimerlabel}" />
								</apex:outputPanel>
							</apex:outputPanel>
							<input class="btn" type="button" onclick="hideModalBoxy();"	value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
						</apex:pageBlock>
						</apex:outputPanel>
						
				</apex:form>

			</apex:outputPanel></div>
						
			<div id="ExpenseItemPopup" style="display: none"><apex:outputPanel id="ExpenseItemDetails">
				<apex:outputPanel id="ExpenseItemDetailsPopup" >
					<apex:pageBlock title="{!$ObjectType.KimbleOne__ExpenseItem__c.label}">
						<apex:pageBlockButtons location="bottom" >
							<input class="btn" type="button" onclick="hideModalBoxy();" value="{!$Label.Cancel}" />
						</apex:pageBlockButtons>
						<apex:pageblockSection collapsible="false" showheader="false" columns="1" >
							
							<apex:outputField value="{!expenseItem.KimbleOne__ExpenseClaim__c}" rendered="{!expenseItem.ExpenseClaim__r.Status__r.KimbleOne__Enum__c != 'Draft'}"/>
							
							<apex:pageBlockSectionItem rendered="{!expenseItem.ExpenseClaim__r.Status__r.KimbleOne__Enum__c = 'Draft'}">
								<apex:outputLabel value="{!$ObjectType.KimbleOne__ExpenseClaim__c.label}" />
								<apex:outputPanel >
									<a class="expense-claim-link" onclick="redirectToExpenseClaimEdit('{!JSENCODE(expenseItem.ExpenseClaim__c)}');" >
										<apex:outputText value="{!expenseItem.ExpenseClaim__r.Name}" />
									</a>
								</apex:outputPanel>
							</apex:pageBlockSectionItem>						
							
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$Label.kimbleone__resourceactivityalternativelabel}" />
								<apex:outputField value="{!expenseItem.ActivityExpenseCategory__r.ResourcedActivity__r.Name}" />
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$Label.kimbleone__expensecategory}" />
								<apex:outputField value="{!expenseItem.ActivityExpenseCategory__r.Name}" />
							</apex:pageBlockSectionItem>
							<apex:pageBlockSectionItem >
									<apex:outputText value="{!$Label.kimbleone__day}" />
									<apex:outputText value="{!expenseItem.TimePeriod__r.Name}" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!expenseItem.ActivityExpenseCategory__r.ExpenseCategory__r.ExpenseType__r.KimbleOne__Enum__c = 'PerUnit'}">
								<apex:outputLabel value="{!expenseItem.ActivityExpenseCategory__r.ExpenseCategory__r.UnitType__r.KimbleOne__Suffix__c}"/>
								<apex:outputField value="{!expenseItem.KimbleOne__ExpenseUnits__c}" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem rendered="{!expenseItem.KimbleOne__IncurredCurrencyIsoCode__c!=null  && expenseItem.KimbleOne__IncurredCurrencyIsoCode__c!=expenseItem.CurrencyIsoCode}">
									<apex:outputLabel value="{!$Label.kimbleone__incurredamount}" />
									<apex:outputText value="{!expenseItem.KimbleOne__IncurredCurrencyIsoCode__c} {!expenseItem.KimbleOne__IncurredCurrencyGrossAmount__c}" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem >
								<apex:outputpanel >
									<apex:outputText value="{!$Label.kimbleone__amount}" />
								</apex:outputpanel>
								<apex:outputField value="{!expenseItem.KimbleOne__ExpenseGrossAmount__c}" />
							</apex:pageBlockSectionItem>
							
							<apex:pageBlockSectionItem >
								<apex:outputLabel value="{!$ObjectType.KimbleOne__ExpenseItem__c.Fields.KimbleOne__IsReceipted__c.Label}?"  />
								<apex:outputField value="{!expenseItem.KimbleOne__IsReceipted__c}" />
							</apex:pageBlockSectionItem>
							<apex:outputField value="{!expenseItem.KimbleOne__Notes__c}" />
						</apex:pageblockSection>
					</apex:pageBlock>

				</apex:outputPanel>
			</apex:outputPanel></div>
			
			</div>


		</apex:define>
		
	</apex:composition>
	
</apex:page>