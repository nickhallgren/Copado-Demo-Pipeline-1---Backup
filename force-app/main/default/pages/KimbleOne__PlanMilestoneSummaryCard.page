<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.PlanMilestoneSummaryCardController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__DeliveryGroup__c">    
    <apex:outputPanel layout="none" rendered="{!HasTrackingPlanMilestones}">
	<div class="card inverted variable-width min-horizontal-padding">
		<div class="cardHeading inverted">
				<h3 class="cardTitle"><apex:outputText value="{!$ObjectType.KimbleOne__PlanMilestone__c.LabelPlural}"/></h3>
			</div>
		
			<div class="cardBody">
				<table class="list cardBodyTable" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr class="headerRow">
							<th class="headerRow">{!$ObjectType.Milestone__c.Fields.DeliveryElement__c.Label}</th>
							<th class="headerRow">{!$ObjectType.Milestone__c.Fields.Name.Label}</th>
							<th class="headerRow"><h2>{!$ObjectType.Milestone__c.Fields.MilestoneType__c.Label}</h2></th>
							<th class="headerRow"><h2>{!$ObjectType.Milestone__c.Fields.MilestoneStatus__c.Label}</h2></th>
							<th class="headerRow"><h2>{!$ObjectType.PlanMilestone__c.Fields.BaselineDate__c.Label}</h2></th>
							<th class="headerRow"><h2>{!$ObjectType.PlanMilestone__c.Fields.EstimatedDate__c.Label}</h2></th>
							<th class="headerRow"><h2>{!$ObjectType.PlanMilestone__c.Fields.CompletionDate__c.Label}</h2></th>
						</tr>
					</thead>
					<tbody>
					<apex:repeat value="{!TrackingPlanMilestones}" var="planMilestone">	
			    		<tr>  			 
							<td>
								<apex:outputText value="{!planMilestone.ElementDisplayName}"/>
							</td>
							<td>
								<apex:outputText value="{!planMilestone.Name}"/>
							</td>
							<td>
								<apex:outputText value="{!planMilestone.Type}"/>
							</td>
							<td>
								<apex:outputText value="{!planMilestone.Status}"/>
							</td>
							<td>
								<apex:outputField value="{!planMilestone.BaselineDate.KimbleOne__InputDate__c}"/>
							</td>
							<td>
								<apex:outputField value="{!planMilestone.EstimatedDate.KimbleOne__InputDate__c}"/>
							</td>
							<td>
								<apex:outputField value="{!planMilestone.CompletionDate.KimbleOne__InputDate__c}"/>
							</td>
						</tr>
					</apex:repeat>	
					</tbody>
				</table>
			</div>
		</div>
	</apex:outputPanel>
</apex:page>