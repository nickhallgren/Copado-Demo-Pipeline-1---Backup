<apex:page standardcontroller="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.TooltipsController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">

	<c:Menu DefaultHelpPage="EngagementScope.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroup__c.Id}" MenuContextName="{!KimbleOne__DeliveryGroup__c.Name}"/>

</apex:define>
  
<apex:define name="Content">

	<!-- Kimble Guidance -->
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'ToolTips.css')}"/>
	<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
		<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/DeliveryGroupRevenuesAndCostsNarratives/' + UserNarrativeLanguageCode + '.js')}" />

		<apex:outputPanel layout="none" rendered="{!DeliveryGroupRevenuesAndCostsTipOverrideEnabled}">
			<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
		</apex:outputPanel>
	</apex:outputPanel>
	
 	<style>
		.boxy-content {display:none;}
	</style>
	
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
	
   	<apex:pageMessages escape="false"/>
        	
    <c:DeliveryGroupStructure DeliveryGroup="{!KimbleOne__DeliveryGroup__c}"/>
        	
	<apex:form >
		<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>
		<div style="display:none;" kimble-tip="null"></div>
	</apex:form>
	
    <style>    	
    	.primary-element-container {
		    display: inline-block;
		    vertical-align: top;
		    margin-right:8px;
		}
    </style>
        
	<script>
		jQuery(document).ready(function()
		{
			initialisePageTips();
		});
		
		/* Tooltips */
		var enableTips = <apex:outputText value="{!TooltipsEnabled}"/>;
		var BaseHelpURL = '<apex:outputText value="{!URLFOR($Resource.KimbleOne__KimbleHelp, '')}"/>';
		var DetailedHelpLabel = '<apex:outputText value="{!$Label.kimbleone__detailedhelp}"/>';
		var MoreLabel = '<apex:outputText value="{!$Label.kimbleone__more}"/>';
		var TipsEnabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsenabled}"/>';
		var TipsDisabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsdisabled}"/>';
	
		function initialisePageTips()
		{
			ApplyTipAttributes();
			initialiseTips();
		}
		
		// add tip attributes to elements
		function ApplyTipAttributes()
		{
			if(enableTips)
			{
				jQuery('.listViewButton').attr('kimble-tip','ListView').attr('kimble-tip-extended-text','ListViewExtendedText').attr('kimble-tip-help-link','MaintainProposalDetailsHelpLink');
				jQuery('.cardViewButton').attr('kimble-tip','CardView').attr('kimble-tip-help-link','MaintainProposalDetailsHelpLink');
				jQuery('.element-cost').attr('kimble-tip','ContractCost').addClass('tip-right');
				jQuery('.element-revenue').attr('kimble-tip','ContractRevenue').addClass('tip-right');
				jQuery('.delivery-element-menu').attr('kimble-tip','ElementBurgerMenu');
				jQuery('.delivery-element-card').attr('kimble-tip','ElementName');
				jQuery('.inline-name-pencil').attr('kimble-tip','ElementNamePencil');
				jQuery('.delivery-group-menu.burger-menu').attr('kimble-tip','EngagementBurgerMenu');
				jQuery('.activation-switch').attr('kimble-tip','ActivationSwitch').attr('kimble-tip-extended-text','ActivationSwitchExtendedText').attr('kimble-tip-help-link','ActivationSwitchHelpLink');
				jQuery('.delivery-group-container').attr('kimble-tip','EngagementName');
				jQuery('.contract-revenue').attr('kimble-tip','OverallRevenue').attr('kimble-tip-help-link','SwitchForecastLevelHelpLink');
				jQuery('.element-product-value').attr('kimble-tip','Product').attr('kimble-tip-extended-text','ProductExtendedText').attr('kimble-tip-help-link','ProductsServicesHelpLink');
			}
		}
		
		function updateTipsConfigSetting(newTipSetting)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
				newTipSetting,
					function(result, event){
						if (event.status)
						{
							var data = {};
							data.results = result;
							loadGuidance();
						}
						else
						{
							alert(event.message);
						}
				},
				{escape: false, timeout: 60000}
			);
		}
	</script>
</apex:define>

</apex:composition>

</apex:page>