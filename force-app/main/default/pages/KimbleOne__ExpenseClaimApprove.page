			<script>

						var receipt = null;
  						var iframesize = {width:406, height:450};
						var enhancedExpenseViewerEnabled = {!EnhancedExpenseViewer};

  						function showReceipt()
  						{
  							if (receipt == null)
  								receipt = new Boxy($('#divClaimAttachmentsPopup'), {title: '{!JSENCODE($Label.SelectedReceiptLabel)}', draggable:true, closeable:true});
  							else
  								receipt.show();
  							
  							if(!enhancedExpenseViewerEnabled)	jQuery('#attachmentsIFrame').width(iframesize.width).height(iframesize.height);
  							
  							jQuery('#resizable').resizable({
								resize: function(event, ui){
									jQuery('#attachmentsIFrame').width(ui.size.width).height(ui.size.height)},
								start: function(event, ui) {
							        jQuery('#attachmentsIFrame').hide();
							         },
							    stop: function(event, ui) {
							        jQuery('#attachmentsIFrame').show();
							        iframesize.width = jQuery('#attachmentsIFrame').width();
							        iframesize.height = jQuery('#attachmentsIFrame').height();
							      }
								})
								
							if(enhancedExpenseViewerEnabled)
							{	
								resetReceiptFit();
								setTimeout(function(){ resetReceiptFit(); }, 500);
							} 
  						}
  						function hideReceipt()
  						{
  							if(receipt!=null)
  								receipt.hide();
  						}
						$(document).ready(function(){
    							
    							
    							$('input[name="piSubmit"]').remove();
    							$('input[name="piRemove"]').remove();
    							
    							$('.ReceiptLinks').each(function()
    							{
    								//.attr('width','500px').attr('height','500px')
    								var imagePane=$('<div>').append($('<img>').attr('src','{!JSINHTMLENCODE(baseUrl)}'+$(this).attr('href').replace('..','')));
									$(this).qtip({
									   content: imagePane.html() ,
									    adjust: {target:$(this), mouse: false, screen: true },
									   position: {
									       corner: {
									          target: 'leftBottom',
									          tooltip: 'bottomRight'
									       }},
										   style: { 
										      width: 600,
										      padding: 0,
										      background: '#FFFFFF',
										      color: 'black',
										      textAlign: 'left',
										      border: {
										         width: 1,
										         radius: 5,
										         color: '#FF00FF'
									      	},
									      tip: true,
									      name: 'dark' // Inherit the rest of the attributes from the preset dark style
									   }
									});
    								
    							});
    					});
    					
    			
    		function showFileUploadPopup(pos)
			{
				initialiseModalBoxy('#fileUploadPopupDiv', '{!JSENCODE($Label.UploadReceiptHeading)}');
				$('#expenseItemAttachment').val(pos);
				showModalBoxy();
				document.getElementById('fileUploadIFrame').src = document.getElementById('fileUploadIFrame').src;
			}
    		function cancelAttachment()
			{
				hideModalBoxy();
			}
			function addAttachment(id)
			{
				if($('#expenseItemAttachment').val() == '')
					addClaimAttachment(id);
				else
					addItemAttachment(id, $('#expenseItemAttachment').val());
			}
			
			var myImgScale;
			
			function resetReceiptFit()
			{
				var myImg = document.getElementsByClassName('receiptImage')[0];
				var boxHeight = jQuery('#receipt-scroller').height();
				var boxWidth = jQuery('#receipt-scroller').width();
				
				if(myImg != null)
				{
					if(myImg.height > myImg.width) 
					{
						myImg.style.height = 'inherit';
						myImg.style.width = '';
					}
					else 
					{
						myImg.style.width = 'inherit';
						myImg.style.height = '';
					}
					
					myImgScale = 1;
					myImg.style.transform = 'scale(' + myImgScale + ')';
				
					$("#receipt-scroller").toggle().toggle();
					
					initialiseScroll();
				}
			}
			
			function receiptFullSize()
			{
				var myImg = document.getElementsByClassName('receiptImage')[0];
				
				if(myImg != null)
				{
					myImg.style.height = 'unset';
					myImg.style.width = 'unset';
					myImg.style.maxWidth = 'unset';
					myImg.style.maxHeight = 'unset';
					myImg.style.transform = '';
					
				    var imgHeight = myImg.height;
					myImg.style.maxHeight = jQuery('#receipt-scroller').height() + 'px';
				    myImgScale = imgHeight / jQuery('#receipt-scroller').height();
				    if(myImgScale < 1) myImgScale = 1;
					myImg.style.transform = 'scale(' + myImgScale + ')';
				
					$("#receipt-scroller").toggle().toggle();
					
					initialiseScroll();
				}
			}
			
			function receiptScaleUp()
			{
				var myImg = document.getElementsByClassName('receiptImage')[0];
				
				myImgScale = myImgScale + 0.2;
				
				myImg.style.transform = 'scale(' + myImgScale + ')';
				
				$("#receipt-scroller").toggle().toggle();
			}
			
			function receiptScaleDown()
			{
				var myImg = document.getElementsByClassName('receiptImage')[0];
				
				if(myImgScale > 0.25) myImgScale = myImgScale - 0.2;
				
				myImg.style.transform = 'scale(' + myImgScale + ')';
				
				$("#receipt-scroller").toggle().toggle();
			}
			
			function showNextAttachment()
			{
				var links = document.getElementsByClassName('ReceiptAttachmentLink');
				var selectedlink = document.getElementsByClassName('ui-state-highlight')[0];
				var selectedimg = selectedlink.getElementsByTagName('img');
				
				var index;
				var indexOfNext;
				
				for (index = 0; index < links.length; index++) 
				{
					if(links[index].getAttribute('onclick') == selectedimg[0].getAttribute('onclick')) indexOfNext = index + 1;
				}
				
				if(links[indexOfNext] != null) links[indexOfNext].click();
				else links[0].click();
			}
			
			function showPreviousAttachment()
			{
				var links = document.getElementsByClassName('ReceiptAttachmentLink');
				var selectedlink = document.getElementsByClassName('ui-state-highlight')[0];
				var selectedimg = selectedlink.getElementsByTagName('img');
				
				var index;
				var indexOfPrev;
				
				for (index = 0; index < links.length; index++) 
				{
					if(links[index].getAttribute('onclick') == selectedimg[0].getAttribute('onclick')) indexOfPrev = index - 1;
				}
				
				if(links[indexOfPrev] != null) links[indexOfPrev].click();
				else links[links.length - 1].click();
			}

			function initialiseScroll() 
			{
		        var scroller = document.querySelector('#receipt-scroller');
				var isDown = false;
				var startX;
				var startY;
				
				scroller.addEventListener('mousedown', (e) => {
				    e.preventDefault();
					scroller.style.cursor = 'grabbing';
					isDown = true;
					scroller.classList.add('active');
					startX = e.pageX - scroller.offsetLeft;
					startY = e.pageY - scroller.offsetTop;
					scrollLeft = scroller.scrollLeft;
					scrollTop = scroller.scrollTop;
				});
				scroller.addEventListener('mouseleave', () => {
					isDown = false;
					scroller.classList.remove('active');
				});
				scroller.addEventListener('mouseup', () => {
					scroller.style.cursor = 'grab';
					isDown = false;
					scroller.classList.remove('active');
				});
				scroller.addEventListener('mousemove', (e) => {
					if(!isDown) return;
					e.preventDefault();
					const x = e.pageX - scroller.offsetLeft;
					const y = e.pageY - scroller.offsetTop;
					const walk = (x - startX);
					const walkY = (y - startY);
					scroller.scrollLeft = scrollLeft - walk;
					scroller.scrollTop = scrollTop - walkY;
				}); 
			}

			function initialiseItems()
			{
				SetupDatePicker();
   			}

			function SetupDatePicker()
            {
                //dateFormat: 'yy-mm-dd',
                jQuery('.kimbleDatePicker').datepicker({
                        dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
                        showOtherMonths: true,
                        selectOtherMonths: true,
                        changeMonth: true,
                        changeYear: true});
            }
			</script>
