<apex:page controller="KimbleOne.Portal_ResourceAvailabilityController">
	<apex:composition template="KimbleOne__Portal_SiteMaster">
		<apex:define name="Content">
			<apex:form >
			    <apex:pageMessages escape="false"/>
			    <apex:pageBlock title="{!$Label.kimbleone__portalresourceavailabilityheader}">
			 
			      <apex:pageBlockButtons location="bottom">
			        <apex:commandButton action="{!save}" value="{!$Label.kimbleone__save}"/>
			      </apex:pageBlockButtons>
			 
			      <apex:pageBlockSection showHeader="false" columns="1" id="block1">
			 
			        <apex:pageBlockSectionItem >
			          <apex:outputLabel value="{!$Label.kimbleone__portalresourceavailablefromdate}" />
			          <apex:inputField required="true" value="{!theResource.KimbleOne__StartDate__c}"/>
			        </apex:pageBlockSectionItem>
			 
			        <apex:pageBlockSectionItem >
			          <apex:outputLabel value="{!$Label.kimbleone__portalresourceavailabletodate}" />
			          <apex:inputField value="{!theResource.KimbleOne__EndDate__c}"/>
			        </apex:pageBlockSectionItem>

			 
			      </apex:pageBlockSection>
			 
			    </apex:pageBlock>
		</apex:form>
		</apex:define>
	</apex:composition>
</apex:page>