<apex:page standardcontroller="KimbleOne__DeliveryGroupStage__c" extensions="KimbleOne.DeliveryGroupStageCloseController" sidebar="false" >

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu">
	<c:Menu DefaultHelpPage="CloseEngagement.html" MenuContextType="DeliveryGroup" MenuContextId="{!KimbleOne__DeliveryGroupStage__c.KimbleOne__DeliveryGroup__c}"  MenuContextName="{!KimbleOne__DeliveryGroupStage__c.DeliveryGroup__r.Name}" />
</apex:define>

<apex:define name="Content">
	<apex:form >
		<apex:outputpanel id="DeliveryStage">
			<apex:pageMessages escape="false"/>

			<apex:pageBlock title="{!$Label.kimbleone__deliverygroupstagedetailsheader}">
				<apex:pageBlockSection title="{!$Label.kimbleone__closedeliverystagenarrative}" collapsible="false">
					<apex:outputText id="deliveryStage" value="{!KimbleOne__DeliveryGroupStage__c.DeliveryStage__r.Name}" label="{!$Label.kimbleone__currentstage}"/>
					<apex:outputText id="deliveryStatus" value="{!KimbleOne__DeliveryGroupStage__c.DeliveryGroup__r.ForecastStatus__r.Name}" label="{!$ObjectType.KimbleOne__DeliveryGroup__c.fields.KimbleOne__ForecastStatus__c.label}"/>
					<apex:outputField id="nextDeliveryStage" value="{!NextDeliveryStage.Name}" label="{!$Label.kimbleone__nextstage}" rendered="{!NextDeliveryStage != null}"/>
				</apex:pageBlockSection>
			</apex:pageBlock>

			<apex:pageBlock rendered="{!KimbleOne__DeliveryGroupStage__c.KimbleOne__ApprovalStatus__c != StatusReadyForApproval}">
				<apex:commandButton styleClass="btn DisableButtonWhileBusy" action="{!MoveToPreviousStage}" value="{!$Label.kimbleone__previous}" disabled="{!firstStage=true || !CanOpenPreviousStage}" rerender="DeliveryStage" />
				<apex:commandButton styleClass="btn DisableButtonWhileBusy" action="{!MoveToNextStage}" value="{!$Label.kimbleone__next}" disabled="{!lastStage = true || HasStageValidationErrors || !CanCloseCurrentStage}" rerender="DeliveryStage" />
			</apex:pageBlock>
		</apex:outputpanel>
	</apex:form>
</apex:define>
</apex:composition>
</apex:page>