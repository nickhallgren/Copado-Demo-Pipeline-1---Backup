						function(result, event){		  
							if (event.status) 
							{
								deliveryGroupMarginInsight = result;
								initialiseDeliveryGroupMarginInsightActions();
							} 
							else if (event.type === 'exception') 
							{
								alert(event.message);
							} 
							else 
							{
								alert(event.message);
							}
					}, 
