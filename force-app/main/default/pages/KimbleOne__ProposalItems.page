		function refreshPageSources(){
			var ProposalId = '<apex:outputText value="{!KimbleOne__Proposal__c.Id}"/>';
			
			jQuery('div[pageSource]').each(function() {
	   		var theComponent = jQuery( this );
	   		var pageSourceName = theComponent.attr('pageSource');
	   		var parentContextParam = (theComponent.attr('parentContext') != undefined && theComponent.attr('parentContext') != null ? '&parentContext=' + theComponent.attr('parentContext') : '');
	   		
	   		// kick off the population of the page with an ajax call
			jQuery.ajax({ url: kimble.pages[pageSourceName] + ProposalId + parentContextParam})
				.done(function(html) {
					jQuery(html).appendTo("#" + theComponent.attr('id'));
				})
				.fail(function(xhr, status, error) {
					if(error !=null && error !="") alert(error);								
				})				
			});
		}
		
