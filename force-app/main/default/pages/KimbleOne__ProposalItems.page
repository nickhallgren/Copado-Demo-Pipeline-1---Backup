<apex:page standardcontroller="KimbleOne__Proposal__c" extensions="KimbleOne.ProposalItemsController,KimbleOne.DeliveryStageController,KimbleOne.TooltipsController" tabStyle="KimbleOne__ReferenceData__c" sidebar="false" >

	<apex:composition template="KimbleOne__SiteMaster">

		<apex:define name="Menu">
			<c:Menu DefaultHelpPage="MaintainProposalDetails.html" MenuContextType="{!IF(KimbleOne__Proposal__c.AcceptanceType__r.KimbleOne__Enum__c = 'Approval', 'ChangeOrder', 'Proposal')}"  MenuContextId="{!IF(KimbleOne__Proposal__c.AcceptanceType__r.KimbleOne__Enum__c = 'Approval', TheChangeOrder.Id, TheProposal.Id)}" MenuContextName="{!TheProposal.Name}" />
		</apex:define>

		<apex:define name="Content">
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CardStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'CharmStyle.css')}"/>
			<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__KimbleStyles, 'InsightStyle.css')}"/>
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleJS, 'Charm.js')}"/>

			<!-- Kimble Guidance -->
			<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/KimbleGuidance.js')}" />
			<apex:outputPanel id="kimbleTooltipsResource" rendered="{!TooltipsEnabled}">
				<apex:includeScript value="{!URLFOR($Resource.KimbleOne__KimbleGuidance, 'KimbleGuidance/ProposalItemsNarratives/' + UserNarrativeLanguageCode + '.js')}" />

				<apex:outputPanel layout="none" rendered="{!ProposalItemsTipOverrideEnabled}">
					<apex:includeScript value="{!JSENCODE(TooltipsOverrideResourcePath)}" />
				</apex:outputPanel>
			</apex:outputPanel>

			<style>
		.boxy-content {display:none;}
		
		/* Insight */
		.dg-margin-insight-tooltip-content {
		    width: 200px;
		    padding: 10px;
		}
		.qtip-titlebar {
		    text-align: center;
		}
		.dg-margin-narrative {
		    font-size: 12px;
		    white-space: normal;
		    line-height: 14px;
		    text-align: center;
		}
		.dg-margin {
		    text-align: center;
		    padding-top: 10px;
		    font-size: 32px;
		    padding-bottom: 20px;
		}
		.dg-margin-insight-tooltip {
			margin-top: 6px;
		}
		.ele-tip-info {
			color: #428BCA;
		}

		.ele-tip-inline-icon {
			font-size: 15px;
			display: inline-block;
		    vertical-align: bottom;
		    margin-left: 3px;
		}
		.extended-text {
		 	display: none;
		}
		.tip-link-see-more {
			color:rgb(0, 95, 178) !important;
			cursor: pointer;
			text-decoration: none;
		}
		.tip-link-kimble-help {
			color:rgb(0, 95, 178) !important;
			float:right;
			text-decoration: none;
		}
		.hide-tip {
		    display: none;
		}
		.show-tip {
		    display: inline;
		}
		.qtip-content>ul , .extended-text>ul  {    
			padding-inline-start: 0px;A
			margin-block-start: 0px;
			display: inline-block;
			margin-block-end: 0px;
		}

		/* alt proposals */
		#proposal-title {
			position: relative;
  		}
  		#proposal-alternatives
  		{
			position: absolute;
			right: 26px;
			top: 60px;
			width: 280px;
			text-align: center;
			background: lemonchiffon;
			padding: 10px;
			border: 2px dashed #bbbbbb;
			display: table-row;
			color: #4b4d4b !important;
			cursor: pointer;
		}
    	i.alt-prop-ind {
			font-size: 20px;
			padding: 6px;
			display: table-cell;
			vertical-align: middle;
		}
		span.alt-prop-msg {
			display: table-cell;
			text-align: left;
			padding-left: 5px;
			vertical-align: middle;
		}
	</style>

			<apex:outputPanel id="ProposalItems" layout="block">

				<div id="proposal-container" style="display:none">

					<apex:outputPanel layout="none" rendered="{!ShowDeliveryGroupMarginInsight}">
						<div class="insight-container dg-average-margin insight-collapsed insight-hidden" display-currency="{!TheProposal.CurrencyISOCode}">
							<div class="docked-insight-container">
								<div class="docked-insight"></div>
							</div>
							<div class="insight-item">
								<span class="miniCardIcon cardIconInfo fa fa-lightbulb-o"></span>
							</div>
						</div>
					</apex:outputPanel>

					<div id="proposal-title" kimble-tip="ProposalName" kimble-tip-help-link="ProposalNameLink">
						<apex:outputPanel id="ProposalCard" layout="none">
							<div id="ProposalItemsErrors">
								<apex:pageMessages escape="false"/>
							</div>
							<div class="title-card-container">
								<div class="title-card">
									<div class="title-card-heading" >
										<div class="title-card-heading-icon">
											<div class="fa fa-square kimble-probability {!JSINHTMLENCODE(TheProposal.ForecastStatus__r.StyleClass__c)}" title="{!JSINHTMLENCODE(TheProposal.ForecastStatus__r.Name)}"></div>
										</div>
										<div class="title-card-heading-text">
											<apex:outputText value="{!TheProposal.KimbleOne__ShortName__c}" title="{!TheProposal.KimbleOne__ShortName__c}"/>
										</div>
									</div>

									<div class="title-card-body">
										<apex:outputPanel layout="none" rendered="{!IsProposalInProgress && ISBLANK(TheChangeOrder)}">
											<div class="title-card-body-field tip-bottom" kimble-tip="ForecastLevelToggle" kimble-tip-help-link="ForecastLevelToggleLink" kimble-tip-extended-text="ForecastLevelToggleExtendedText">

												<apex:outputPanel layout="block" styleclass="toggle-forecast-level fixed-toggle fa fa-toggle-on fa-2 suppress-on fa-rotate-90" rendered="{!TheProposal.KimbleOne__ForecastAtDetailedLevel__c}" title="{!$Label.kimbleone__detailedlevelforecastheadinglabel}"></apex:outputPanel>
												<span class="forecast-level-switch-container">
			  				<apex:outputPanel layout="block" styleclass="toggle-forecast-level fa fa-toggle-on fa-2 suppress-on fa-rotate-270" rendered="{!!TheProposal.KimbleOne__ForecastAtDetailedLevel__c && $ObjectType.KimbleOne__Proposal__c.updateable}" title="{!$Label.kimbleone__detailedlevelforecastswitchheadinglabel}"></apex:outputPanel>

			  				<apex:outputPanel styleClass="tool-tip-content" >

								<apex:outputPanel styleClass="tool-tip-content-container" title="{!$Label.kimbleone__detailedlevelforecastswitchheadinglabel}" rendered="{!!TheProposal.KimbleOne__ForecastAtDetailedLevel__c}">
									<apex:outputText styleClass="message-text" value="{!$Label.kimbleone__detailedlevelforecastswitchmessage}" />
									
									<apex:outputPanel rendered="{!ISBLANK(IncompleteElementsMessage)}">
										<div>
											<span class="tool-tip-inline-icon tool-tip-warn fa fa-exclamation-triangle" style="vertical-align: top;"></span>
											<apex:outputText styleClass="message-text additional-details-text" value="{!$Label.kimbleone__detailedlevelforecastswitchwarningmessage}" />
										</div>
										
										<div class="tool-tip-form-buttons">
											<input id="switchToLowLevel" class="btn"  type="button" onclick="jQuery('.toggle-forecast-level').parent().parent().addClass('Loading').children().hide();jQuery('.forecast-level-switch-container').qtip('hide');toggleForecastLevel();" value="{!$Label.DetailedLevelForecastSwitchButtonLabel}"/>
											<input id="cancelSwitchToLowLevel" class="btn"  type="button" onclick="cancelForecastLevelPopup();" value="{!$Label.kimbleone__cancel}"/>
										</div>
									</apex:outputPanel>
									
									<apex:outputPanel rendered="{!!ISBLANK(IncompleteElementsMessage)}">
										<div>
											<span class="tool-tip-inline-icon tool-tip-warn fa fa-exclamation-triangle" style="vertical-align: top;"></span>
											<apex:outputText styleClass="message-text additional-details-text" value="{!IncompleteElementsMessage}" />
										</div>
										
										<div class="tool-tip-form-buttons">
											<input id="cancelSwitchToLowLevel" class="btn"  type="button" onclick="cancelForecastLevelPopup();" value="{!$Label.kimbleone__ok}"/>
										</div>
									</apex:outputPanel>
									
								</apex:outputPanel>

							</apex:outputPanel>
		  				</span>
											</div>
										</apex:outputPanel>

										<div class="title-card-body-field tip-bottom" kimble-tip="ForecastStatus" kimble-tip-help-link="ForecastStatusHelpLink">
											<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ForecastStatus__c.Label}" />
											<span ><apex:outputField styleClass="center-aligned-block" value="{!TheProposal.ForecastStatus__r.Name}"/></span>
										</div>
										<div class="title-card-body-field tip-bottom" kimble-tip="AcceptanceDate" kimble-tip-extended-text="AcceptanceDateExtendedText">
											<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__AcceptanceDate__c.Label}" />
											<span ><apex:outputField styleClass="center-aligned-block" value="{!TheProposal.KimbleOne__AcceptanceDate__c}"/></span>
										</div>
										<div class="title-card-body-field tip-bottom" kimble-tip="ContractRevenue" kimble-tip-help-link="ContractRevenueHelpLink">
											<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractRevenue__c.Label}" />
											<span ><apex:outputField id="proposal-contract-revenue" styleClass="center-aligned-block" value="{!TheProposal.KimbleOne__ContractRevenue__c}"/></span>
										</div>
										<div class="title-card-body-field tip-bottom" kimble-tip="ContractCost" kimble-tip-help-link="ContractCostHelpLink">
											<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractCost__c.Label}" />
											<span ><apex:outputField styleClass="center-aligned-block" value="{!TheProposal.KimbleOne__ContractCost__c}"/></span>
										</div>
										<div class="title-card-body-field tip-bottom" kimble-tip="MarginPct" kimble-tip-help-link="MarginPctLink">
											<apex:outputLabel styleClass="center-aligned-block label-heading" value="{!$ObjectType.KimbleOne__Proposal__c.Fields.KimbleOne__ContractMargin__c.Label}" />
											<span ><apex:outputField styleClass="center-aligned-block" value="{!TheProposal.KimbleOne__ContractMargin__c}"/></span>
										</div>

										<div id="embeddedCharmsContainer" pageSource="ProposalCharmsCard" parentContext="{!$Page.ProposalItems}"></div>
									</div>

									<div class="title-card-menu tip-bottom" kimble-tip="ProposalBurgerMenu" kimble-tip-help-link="ProposalBurgerMenuLink" kimble-tip-extended-text="ProposalBurgerMenuExtendedText">
										<apex:outputPanel layout="none" rendered="{!IsProposalInProgress}">
											<div id="proposal-menu" data-floating-dropdown="#{!TheProposal.Id}-menu-data" class="title-card-menu fa fa-bars burger-menu"></div>
										</apex:outputPanel>
									</div>

									<div id="{!TheProposal.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
										<ul class="floating-dropdown-menu">
											<apex:outputPanel layout="none" rendered="{!ISBLANK(TheChangeOrder) && $ObjectType.KimbleOne__DeliveryGroup__c.createable}">
												<li><a href="javascript:addGroupWizard('NEW');"><i class="fa fa-plus-square dropdown-icon"></i>{!$Label.AddDeliveryEngagementLink}</a></li>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!ISBLANK(TheChangeOrder) && $ObjectType.KimbleOne__DeliveryGroup__c.updateable}">
												<li><a href="javascript:addGroupWizard('EXISTING');"><i class="fa fa-plus-square-o dropdown-icon"></i>{!$Label.AddExistingGroupWizardLink}</a></li>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!ISBLANK(TheChangeOrder) && allowAlternatives && $ObjectType.KimbleOne__Proposal__c.createable}">
												<li><a href="javascript:newProposalAlternativeClick();"><i class="fa fa-files-o dropdown-icon"></i>{!$Label.CreateAlternativeProposal}</a></li>
											</apex:outputPanel>
											<apex:outputPanel layout="none" rendered="{!ISBLANK(TheChangeOrder) && allowAlternatives && isAlternative && $ObjectType.KimbleOne__Proposal__c.createable}">
												<li><a href="javascript:makeAltPreferred('{!TheProposal.Id}');"><i class="fa fa-star-o dropdown-icon"></i>{!$Label.ProposalAlternativeNarrative01}</a></li>
											</apex:outputPanel>
										</ul>
									</div>

								</div>
							</div>
							<apex:outputPanel layout="none" rendered="{!ISBLANK(TheChangeOrder) && allowAlternatives && (isAlternative || hasAlternatives)}">
								<div id="proposal-alternatives" onclick="safeNavigateToSForceURL('{!$Page.ProposalAlternatives}?id={!IF(!ISBLANK(TheProposal.Proposal__c), TheProposal.Proposal__c, TheProposal.Id)}');" >
								<apex:outputPanel layout="none" rendered="{!!isAlternative}">
								<i class="fa fa-star alt-prop-ind is-pref-prop"></i>
								</apex:outputPanel>
								<apex:outputPanel layout="none" rendered="{!isAlternative}">
								<i class="fa fa-files-o alt-prop-ind not-pref-prop"></i>
								</apex:outputPanel>
								<apex:outputText styleClass="alt-prop-msg" value="{!alternativeProposalNarrative}" />
								</div>
							</apex:outputPanel>
						</apex:outputPanel>
					</div>


					<apex:outputPanel id="ProposalGroups">

						<apex:outputPanel layout="none" rendered="{!ISBLANK(TheDeliveryGroupAndElementsWizard)}">
							<div id="proposal-items" style="display:inline-block;vertical-align:top; min-height: 100px;">
								<apex:actionStatus id="ProposalGroupsLoadingStatus">
									<apex:facet name="start">
										<div id="loadingIndicatorOuterContainerGroups" class="loadingIndicator">
											<div id="loadingIndicatorInnerContainerGroups">
												<img src="{!URLFOR($Resource.LoadingImageK)}" />{!$Label.kimbleone__loading}
											</div>
										</div>
									</apex:facet>
								</apex:actionStatus>
								<div id="delivery-groups-container">

									<apex:repeat value="{!TheProposalGroupStructure.TheGroups}" var="group">
										<apex:variable var="IsWAR" value="{!group.IsWar}"/>
										<div id="{!group.Id}" class="delivery-group-container cardContainer" kimble-tip="EngagementName" kimble-tip-help-link="EngagementNameLink">

											<div class="delivery-group card">
												<div class="delivery-group-header cardHeading" probability-code="{!JSINHTMLENCODE(group.ProbabilityCode)}">
													<div class="card-heading-icon kimble-probability {!if(ISBLANK(group.ForecastStyle), JSINHTMLENCODE(group.ProbabilityCode), JSINHTMLENCODE(group.ForecastStyle))} fa fa-square" title="{!JSINHTMLENCODE(group.ForecastStatus)}"></div>
													<div class="card-title-container">
														<h3 class="cardTitle"><a class="undecorated-link" href="/{!group.Id}"><apex:outputText value="{!group.Name}"/></a></h3>
													</div>
													<apex:outputPanel layout="none" rendered="{!IsProposalInProgress && group.IsInProgress}">
														<div data-floating-dropdown="#{!group.Id}-menu-data" class="fa fa-bars delivery-group-menu burger-menu tip-right" kimble-tip="EngagementBurgermenu" kimble-tip-help-link="EngagementBurgermenuLink"></div>
														<div class="deleting Loading" style="display:none"></div>
														<div id="{!group.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
															<ul class="floating-dropdown-menu">
																<apex:outputPanel layout="none" rendered="{!IsProposalInProgress}">
																	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DeliveryElement__c.createable && IsActionAllowed[group.Id]['AllowNewElements']}">
																		<li><a href="javascript:addNewElement('{!JSINHTMLENCODE(group.Id)}');"><i class="fa fa-plus-square dropdown-icon"></i>{!$Label.AddElementLink}</a></li>
																	</apex:outputPanel>
                                                                    <apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DeliveryElement__c.createable && IsActionAllowed[group.Id]['AllowNewElements'] && CloneEnabled}">
                                                                        <li><a href="javascript:addNewElementFromExisting('{!JSINHTMLENCODE(group.Id)}', null);"><i class="fa fa-clone dropdown-icon"></i>{!$Label.CloneElementFromEngagement}</a></li>
                                                                    </apex:outputPanel>
																	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DeliveryGroup__c.updateable}">
																		<li><a href="javascript:editGroup('{!JSINHTMLENCODE(group.Id)}');"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.EngagementEditLink}</a></li>
																	</apex:outputPanel>
																	<apex:outputPanel layout="none" rendered="{!!TheProposal.KimbleOne__ForecastAtDetailedLevel__c && $ObjectType.KimbleOne__ProposalItem__c.updateable}">
																		<li><a href="javascript:editGroupForecast('{!JSINHTMLENCODE(group.Id)}');" ><i class="fa fa-toggle-on suppress-on fa-rotate-270 dropdown-icon"></i>{!$Label.kimbleone__highlevelforecastlabel}</a></li>
																	</apex:outputPanel>
																	<apex:outputPanel layout="none" rendered="{!TheProposalGroupStructure.NumberOfInProgressItems > 1 && $ObjectType.KimbleOne__ProposalItem__c.updateable}">
																		<li><a href="javascript:loseGroup('{!JSINHTMLENCODE(group.Id)}');"><i class="fa fa-times dropdown-icon"></i>{!$Label.Lost}</a></li>
																	</apex:outputPanel>

																	<apex:outputPanel layout="none" rendered="{!group.CanDelete && $ObjectType.KimbleOne__DeliveryGroup__c.deletable}">
																		<li><a href="javascript:deleteGroup('{!JSINHTMLENCODE(group.Id)}');"><i class="fa fa-trash dropdown-icon"></i>{!$Label.DeleteEngagementLink}</a></li>
																	</apex:outputPanel>

																</apex:outputPanel>

															</ul>
														</div>
													</apex:outputPanel>
												</div><!-- delivery-group-header -->

												<div class="primary-elements-container">
													<div class="card-body-header">
										<span class="group-dates" kimble-tip="EngagementDates">
										<apex:outputPanel layout="inline" styleclass="fa fa-exclamation-triangle group-start-date-warning" rendered="{!group.HighLevelStartDateOffset != 0}" title="{!$Label.kimbleone__highlevelstartdateoffset}">
											<apex:outputPanel styleClass="tool-tip-content" >
												<apex:outputPanel styleClass="tool-tip-content-container" title="{!$Label.kimbleone__highlevelstartdateoffset}" rendered="{!group.HighLevelStartDateOffset != 0}">
													<span class="tool-tip-inline-icon tool-tip-warn fa fa-exclamation-triangle"></span><apex:outputText styleClass="message-text" value="{!$Label.kimbleone__highlevelstartdateoffsetwarning}" />
													<div>
														<span class="card-field-label"><apex:outputText value="{!$ObjectType.KimbleOne__ProposalItem__c.Fields.KimbleOne__DetailedLevelStartDate__c.Label}"/></span>
														<span class="card-field-value"><apex:outputText styleclass="kimble-format-date" value="{!group.DetailedLevelStartDate}" /></span>
													</div>
													<div>
														<a href="{!$Page.KimbleOne__DeliveryDatesBulkEdit}?Id={!JSENCODE(KimbleOne__Proposal__c.Id)}">{!$Label.kimbleone__bulkupdateassignmentslink}</a>
													</div>
												</apex:outputPanel>
											</apex:outputPanel>
										</apex:outputPanel>

										<apex:outputText styleclass="kimble-format-date" value="{!group.StartDate}" />&nbsp;-&nbsp;<apex:outputText styleclass="kimble-format-date" value="{!group.EndDate}"/></span>
														<span style="float:right" class="{!IF(TheProposal.ForecastAtDetailedLevel__c, 'elementLevelForecast', '')} tip-right" kimble-tip="EngagementRevenue"><apex:outputText rendered="{!$ObjectType.KimbleOne__DeliveryGroup__c.fields.KimbleOne__ContractRevenue__c.accessible}" styleclass="kimble-format-currency" html-data-currency="{!group.CurrencyISOCode}"  value="{!group.Revenue}"/></span>
													</div>

													<div class="inner-cards-container" kimble-tip="ElementName" kimble-tip-help-link="ElementNameLink">
														<apex:repeat value="{!group.TheElements}" var="element">
															<apex:outputPanel title="{!IF(!element.IsPartOfProposal,$Label.kimbleone__notpartofthisproposalmessage,'')}" layout="block" styleclass="{!IF(!element.IsPartOfProposal,'element-not-in-proposal','element-in-proposal')}">

																<div id="{!element.Id}" class="inner-card">
																	<div class="inner-card-header">
																		<!-- if this is a WAR element then show a WAR icon, otherwise the normal probability square -->
																		<div class="inner-card-header-icon kimble-probability fa {!IF(element.IsWAR,'fa-exclamation-triangle ' + IF(element.IsWARAlert,'war-icon-alert','war-icon-warn'),'fa-square ' + if(ISBLANK(element.ForecastStyle), JSENCODE(element.ProbabilityCode), JSENCODE(element.ForecastStyle)))}" title="{!JSENCODE(element.ForecastStatus)}{!IF(element.IsWAR,' (' + $Label.WorkingAtRiskHeading + ')','')}"></div>
																		<div class="inner-card-title"><apex:outputText value="{!element.Name}"/></div>

																		<apex:outputPanel layout="none" rendered="{!element.IsPartOfProposal && IsProposalInProgress && $ObjectType.KimbleOne__ProposalItem__c.updateable && IsActionAllowed[group.Id]['AllowNewElements']}">
																			<div data-floating-dropdown="#{!element.Id}-menu-data" class="fa fa-bars delivery-element-menu burger-menu tip-right" kimble-tip="ElementBurgerMenu" kimble-tip-help-link="ElementBurgerMenuLink"></div>
																			<div class="burger-menu updating" style="display:none"><i class="fa fa-circle-o-notch fa-spin"></i></div>
																			<div id="{!element.Id}-menu-data" class="floating-dropdown floating-dropdown-relative floating-dropdown-anchor-right" style="margin-top:1px">
																				<ul class="floating-dropdown-menu">
																					<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__DeliveryElement__c.fields.KimbleOne__ServicesContractCost__c.Accessible}" >
																						<li><a href="javascript:editProposalElement('{!JSINHTMLENCODE(element.Id)}')"><i class="fa fa-pencil-square-o dropdown-icon"></i>{!$Label.ConfigureElementLink}</a></li>
																					</apex:outputPanel>
																					<apex:outputPanel layout="none" rendered="{!CloneEnabled && $ObjectType.KimbleOne__DeliveryElement__c.createable && IsActionAllowed[group.Id]['AllowNewElements']}">
																						<li><a href="javascript:addNewElementFromExisting('{!JSINHTMLENCODE(group.Id)}', '{!JSINHTMLENCODE(element.Id)}');"><i class="fa fa-clone dropdown-icon"></i>{!$Label.CloneElementLink}</a></li>
																					</apex:outputPanel>																					
																					<apex:outputPanel layout="none" rendered="{!ShowAlternatives}">
																						<li class="load-alternatives" element-id="{!JSINHTMLENCODE(element.Id)}">
																							<label><i class="fa fa-circle-o-notch fa-spin dropdown-icon"></i><apex:outputText value="{!$Label.kimbleone__loading}"/></label></li>
																					</apex:outputPanel>
																				</ul>
																			</div>
																		</apex:outputPanel>

																		<apex:outputPanel layout="none" rendered="{!!element.IsPartOfProposal && IsProposalInProgress && element.RaisedAgainstElements.size == 0 && $ObjectType.KimbleOne__ProposalItem__c.updateable && IsActionAllowed[group.Id]['AllowNewElements']}">
