			});
			
			groupToDelete = groupId;
			
			deleteAllGroupElements();
		}
		
		function deleteAllGroupElements()
		{
			if (elementsToDelete.length > 0)
			{
				var elementId = elementsToDelete.shift();
				deleteElement(elementId, false, deleteAllGroupElements);
