		jQuery('.element-service-contract-revenue').attr('kimble-tip','ServicesContractRevenue').addClass('tip-right');
		jQuery('.element-service-contract-revenue').attr('kimble-tip-extended-text','ServicesContractRevenueExtendedText');
		jQuery('.element-service-contract-cost').attr('kimble-tip','ServicesContractCost').addClass('tip-right');
		jQuery('.element-service-contract-cost').attr('kimble-tip-extended-text','ServicesContractCostExtendedText');
		jQuery('.element-expense-contract-revenue').attr('kimble-tip','ExpensesContractRevenue').addClass('tip-right');
		jQuery('.element-expense-contract-cost').attr('kimble-tip','ExpensesContractCost').addClass('tip-right');
        
		function updateTipsConfigSetting(newTipSetting)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TooltipsController.UpdateToolTipSetting}',
				newTipSetting,
					function(result, event){
						if (event.status)
						{
							var data = {};
							data.results = result;
							loadGuidance();
						}
						else
						{
							alert(event.message);
						}
				},
				{escape: false, timeout: 60000}
			);
		}

		function createAltProposal(pId)
		{
			var d = confirmDelete();
			if(!d) return;

			jQuery('#loadingIndicatorOuterContainerGroups').parent().show();

			createAlternativeProposal(pId);
		}

		function makeAltPreferred(pId)
		{
		    var d = confirmDelete();
		    if(!d) return;

		    jQuery('#loadingIndicatorOuterContainerGroups').parent().show();

		    makeAlternativePreferred(pId);
  		}

	</script>
