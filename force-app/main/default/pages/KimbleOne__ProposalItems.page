			// queue elements to delete then delete group
			
			jQuery('#' + groupId + ' .burger-menu').hide();
			jQuery('#' + groupId + ' .Loading').show();
			
			jQuery.each(jQuery('#' + groupId + '.delivery-group-container .inner-card'), function (i, ele) {
