	            });

	            function reloadPage(jobsProcessed)
	            {
	            	jQuery('#ProposalJobs').hide();

	            	if (jobsProcessed)
	            	{
	            		window.location.href = window.location.href.replace(/firstLoad=1/g,'firstLoad=0');
            		}
	            	else
	            	{
	            		jQuery('#proposal-container').show();
	            		adjustLayout();
						initialiseKTips();

	            		setTimeout(function(){ loadAlternativeProductMenus(); }, 1000);

	            		// if this is the first load of the page and
	            		// 1) we have a group
						// 2) there are placeholder elements
						// 3) there are no default elements
						// then do a speculative reload in order to attempt
						// to catch jobs which were pending before the refresh started (ticket #6264)
						if(window.location.href.indexOf('firstLoad=1') > -1
							&& jQuery('.fa-bars.delivery-element-menu').length == 0
							&& jQuery('.fa-plus-square.delivery-element-menu').length > 0
							&& jQuery('.fa-bars.delivery-group-menu').length > 0)
						{
							// turn on-screen burger menus into spinners to signify the page is reloading
							jQuery('.fa-bars.title-card-menu').removeClass('fa-bars').addClass('fa-circle-o-notch fa-spin').attr('data-floating-dropdown','');
							jQuery('.fa-bars.delivery-group-menu').removeClass('fa-bars').addClass('fa-circle-o-notch fa-spin').attr('data-floating-dropdown','');
							jQuery('.fa-plus-square.delivery-element-menu').removeClass('fa-plus-square').addClass('fa-circle-o-notch fa-spin').attr('onclick','');
							// is two seconds enough?
							var delay = 2000;
							setTimeout(function(){ window.location.href = window.location.href.replace(/firstLoad=1/g,'firstLoad=0'); }, delay);
						}
            		}
	            }

	        </script>

