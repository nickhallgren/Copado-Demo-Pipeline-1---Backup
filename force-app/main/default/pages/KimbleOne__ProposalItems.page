		function generateDeliveryGroupMarginInsightTipHtml()
		{
			var tipHtml = '<div class="dg-margin-insight-tooltip-content">';

			tipHtml += '<div class="dg-margin">' + deliveryGroupMarginInsight + '%</div>';
			tipHtml += '<div class="dg-margin-narrative">' + dgMarginInsightNarrativeLabel + '</div>';

