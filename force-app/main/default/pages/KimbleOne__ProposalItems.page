		function changeProduct(elementId, newProductId, oncomplete, revChange, costChange)
		{

			if (!confirmProductChange || (!revChange && !costChange))
			{
				if (!confirmDelete()) return;
			}
			else //rev change or cost change
			{
				var message = '';

				if (revChange)
					message += ('{!JSENCODE($Label.ProductChangeDifferentRevenueModel)}' + '\r\n');

				if (costChange)
					message += ('{!JSENCODE($Label.ProductChangeDifferentCostModel)}' + '\r\n');

				message += '{!JSENCODE($Label.AreYouSure)}';

				if (!confirm(message)) return;
			}


			jQuery('#' + elementId + ' .burger-menu').hide();
			jQuery('#' + elementId + ' .updating').show();

			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ProposalItemsController.ChangeProduct}',
	       		elementId, '{!JSENCODE(Proposal__c.Id)}', newProductId,
	      			function(result, event){
	             		if (event.status)
			            {
			             	oncomplete();
			         	}
			         	else if (event.type === 'exception')
			         	{
			             	alert(event.message);
			             	jQuery('#' + elementId + ' .burger-menu').show();
							jQuery('#' + elementId + ' .updating').hide();
			         	}
			         	else
			         	{
			             	alert(event.message);
			             	jQuery('#' + elementId + ' .burger-menu').show();
							jQuery('#' + elementId + ' .updating').hide();
			         	}
	         },
	         {escape: true, timeout: 60000});
		}

