		function adjustLayout()
		{
			// when parent and child elements are displayed the divs can end up different sizes (as the parent
			// is made wide enough to contain a normal sized change order element)
			// iterate the parent elements and set them to the max width of those present
			var maxDivWidth = Math.max.apply(Math, jQuery(".delivery-element-card").not(".level2").map(function(){ return jQuery(this).width(); }).get());
			
