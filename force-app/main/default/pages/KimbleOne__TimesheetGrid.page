				function toggleTTips()
				{
					var ShowTTipsOld = <apex:outputText value="{!ShowTimesheetTooltips}"/>; 
					var ShowTTipsNew = false;
					if(ShowTTipsOld == ShowTTipsNew) ShowTTipsNew = true;
				
					Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetGridController.UpdateToolTipSetting}',
			       		ShowTTipsNew,
			      			function(result, event){          
			             		if (event.status) 
					            {
					             	var data = {};
					             	data.results = result;
					             	location.reload();
					         	} 
					         	else if (event.type === 'exception') 
					         	{
					             	alert(event.message);
					         	} 
