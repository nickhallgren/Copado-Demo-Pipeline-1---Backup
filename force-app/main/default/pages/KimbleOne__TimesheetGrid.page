function getActivityHtml(activity)
{
	var hasChildrenClass = getActivityClass(activity);
	
	var activityRowHtmlPart1 = '<tr id="' + activity.Id + '" class="activity-row ' + hasChildrenClass + '" t-tip-grid-row="TEGridActivityRow">';
	
	//Add + Name
	activityRowHtmlPart1 += '<td class="activity-heading">';
	
	var activityRowHtmlPart2 = '';
	<apex:outputPanel layout="none" rendered="{!CanAddEditTimeAndExpenseEntries && $ObjectType.KimbleOne__TimeEntry__c.updateable}">
	if ((adjustMode == 'false' && activity.AllowNewTimeEntries) || (adjustMode == 'true' && activity.AllowNewTimeAdjustments)) activityRowHtmlPart2 = '<span class="add-activity-button inline-button fa fa-plus-square" id="' + activity.Id + '"></span>';
	</apex:outputPanel>
	
	var activityRowHtmlPart3 = '<span class="activity-name">' + activity.Name + '</span>';
	
	activityRowHtmlPart3 += '</td>';
	
	//Days totals
	jQuery.each(theGrid.TheDays, function(i, day){
		activityRowHtmlPart3 += '<td class="activity-day-total row-day"><span id="' + day.Id + '" class="activity-day-total-value">' + kimble.formatNumber(replaceNull(activity.Total[day.Id], 0), '0.###') + '</span></td>';
	});
	
	activityRowHtmlPart3 += '<td class="activity-total"><div class="activity-total-value">' + kimble.formatNumber(activity.ActivityTotal, '0.###') + '</div><span class="row-units">' + activity.Assignments[0].EntryUnitTypeSuffix + '</span></td>';

	activityRowHtmlPart3 += '<td class="timesheet-status"></td>';
	
	activityRowHtmlPart3 += '</tr>';
	
	//TODO:TimeAdjustment - should we sort the rows?
	jQuery.each(Object.keys(activity.Rows), function(i, key){
		activityRowHtmlPart3 += getTimesheetRowHtml(activity, activity.Rows[key]);
		
		// if an adjustment is being approved we don't want the user to be able to add another row
		if((periodStatus == 'Closed' && adjustMode == 'true' && activity.Rows[key].Status == 'ReadyForApproval') 
			|| (activity.Rows[key].HasPendingAdjustments && !activity.Rows[key].CanAdjust))
		{
			activityRowHtmlPart2 = '';
		}
	});
	
	return activityRowHtmlPart1 + activityRowHtmlPart2 + activityRowHtmlPart3;
}

function getActivityClass(activity)
{
	var numberOfChildRows = 0;
	
	jQuery.each(Object.keys(activity.Rows), function(i, key){
		 if (!activity.Rows[key].IsDeleted)
		 {
		 	numberOfChildRows++;
		 }
	});
	
	if (numberOfChildRows == 0)
		return 'children-0';
	else if (numberOfChildRows == 1)
		return 'children-1';
	
	return 'children-m';
}

function replaceNull(val, def)
{
	return (val == null ? def : val);
}

function getHeaderHtml()
{
	var html = '<tr class="period-header"><td rowspan="2">';
	
	html += '</td>';
	
	jQuery.each(theGrid.TheDays, function(i, day){
