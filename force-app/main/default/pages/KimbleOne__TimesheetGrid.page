				}
				
				function saveTimesheet(andSubmit, submitSelected)
				{
					 showWorking();
					 
					 Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetGridController.SaveTimesheet}', 
 						'{!JSENCODE(TheResource.Id)}','{!JSENCODE(CalendarId)}','{!JSENCODE(TheResourceTrackingPeriod.TrackingTimePeriod__c)}',
