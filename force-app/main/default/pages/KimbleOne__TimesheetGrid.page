{
	var enableTTips = <apex:outputText value="{!ShowTimesheetTooltips}"/>; 
	
	// set up default TTips 
	jQuery('[t-tip-default]').qtip('destroy', true).each(function()
	{
	   jQuery(this).qtip({
			content: ttipLabels[jQuery(this).attr('t-tip-default')],
			position: {my: 'bottom center', at: 'top center',viewport: $(window)},
			style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
			show: { solo: true }
	   });
	});
	
	// set up tips if setting enabled
	if(enableTTips)
	{
		jQuery('[t-tip]').qtip('destroy', true).each(function()
		{
		   jQuery(this).qtip({
				content: ttipLabels[jQuery(this).attr('t-tip')],
				position: {my: 'bottom center', at: 'top center',viewport: $(window)},
				style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
				show: { solo: true }
		   });
		});
		
		jQuery('[t-tip-right]').qtip('destroy', true).each(function()
		{
			jQuery(this).qtip({
				content: ttipLabels[jQuery(this).attr('t-tip-right')],
				position: {my: 'left center', at: 'right center', viewport: $(window)},
				style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
				show: { solo: true }
		    });
		});
		
		jQuery('[t-tip-grid-row]').qtip('destroy', true).each(function()
		{
			jQuery(this).qtip({
				content: ttipLabels[jQuery(this).attr('t-tip-grid-row')],
				position: {my: 'top right', at: 'bottom center', viewport: $(window)},
				style: {classes: 'qtip-light qtip-shadow qtip-rounded t-tip-qtip'},
				show: { solo: true }
			});
		});
	}
}	
