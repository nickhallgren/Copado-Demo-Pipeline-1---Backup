				this.each(function(){
					var t = jQuery(this);
					var intervalId = setInterval(function() {
						var eTime = t.attr('timer-elapsed-time-s');
						
						// add a second
						var totalSeconds = parseInt(eTime) + 1;
						var seconds = totalSeconds + 1;
						var minutes = Math.floor(seconds/60);
						var hours = Math.floor(minutes/60);
						var days = Math.floor(hours/24);
						
						minutes = minutes-(hours*60);
						seconds = (seconds-(hours*60*60)-(minutes*60)).toFixed(0);
	
						t.attr('timer-elapsed-time-s', totalSeconds);
						var formattedTimer = padPart(hours) + ':' + padPart(minutes) + ':' + padPart(seconds);
						t.text(formattedTimer);
				    }, 1000);
				    t.data('int-id', intervalId);
				    t.addClass('ticking');
				});
			}
	
			jQuery.fn.stopTimer = function() {
				this.each(function(){
					var t = jQuery(this);
					clearInterval(t.data('int-id'));
					t.removeClass('ticking');
				});
			}
			
			initialiseTimers();
		}
	}
    
    if (!theGrid.HasSaveProblem)
    	jQuery(window).off('.has-changes');
}

var padPart = function(n) { return ('' + n).length < 2? padPart('0' + n) : n;};
				
function initialiseTimers()
{
    
    jQuery('.ticker').each(function() {
    	var t = jQuery(this);
		// time the timer was started
		var sDateTime = t.attr('timer-start-time');
		var sTime = sDateTime.getTimeFromDateTime(true);
		var sTimeParts = sTime.split(':');
		var sDate = sDateTime.toDateDiscardTime();
		sDate.setHours(sTimeParts[0], sTimeParts[1], sTimeParts[2]);
		
		// current time
		var cDate = new Date();

		// difference between start time and current time stored as counted time
		// adjust for timezone
		var tzAdj = new Date(new Date() - new Date()).getTimezoneOffset() * 60 * 1000

		// work out the difference in seconds and add one
		var diff = cDate.getTime() - sDate.getTime();
		var totalSeconds = diff / 1000;
		var seconds = totalSeconds;
		var minutes = Math.floor(seconds/60);
		var hours = Math.floor(minutes/60);
		var days = Math.floor(hours/24);
		
		minutes = minutes-(hours*60);
		seconds = (seconds-(hours*60*60)-(minutes*60)).toFixed(0);						

		t.attr('timer-elapsed-time-s', totalSeconds);
		
		var formattedTimer = padPart(hours) + ':' + padPart(minutes) + ':' + padPart(seconds);
		t.text(formattedTimer);
    });
	                
	jQuery('.ticker:not(.ticking)').timer();
}

function buildDateFromDateTimeUTC(dtUTC)
{
	var datetimeparts = dtUTC.split('T');
	var dateparts = datetimeparts[0].split('-');
	var timeparts = datetimeparts[1].split(':');

	if (dateparts.length != 3 || timeparts.length != 3) return null;
	
	return new Date(dateparts[0], dateparts[1] - 1, dateparts[2], timeparts[0].padToTwoDigits(), timeparts[1].padToTwoDigits(), timeparts[2].replace('Z', '').padToTwoDigits());
}

function addSecondsToDate(dt, seconds)
{
	return new Date(dt.setSeconds(dt.getSeconds() + seconds));
}

function getSimpleTimeFromDate(dt, includeSeconds)
{
	var min = dt.getMinutes();
	
	if (min < 10) {
		min = "0" + min;
	}

	var hour = dt.getHours();
	if (hour < 10) {
		hour = "0" + hour;
	}

	var sec = dt.getSeconds();
	if (sec < 10) {
		sec = "0" + sec;
	}

	var newTime = hour + ':' + min + (includeSeconds ? ':' + sec : '');

	return newTime;
}

function stopTimer(e)
{
	jQuery(this).removeClass('fa-stop-circle').addClass('fa-circle-o-notch').addClass('fa-spin');
	
	var theTicker = jQuery(this).closest('.te-timer').find('.ticker');
	
	theTicker.stopTimer();
	
	var timerStart = theTicker.attr('timer-start-time');
	var timerElapsedSeconds = parseInt(theTicker.attr('timer-elapsed-time-s'));
	var endDateTime = new Date();
	
	// work out the entry this relates to
	// get the max usage in seconds
	var activity = theGrid.findActivity(theTicker.closest('tr').attr('activity-id'));
	var row = theGrid.findTimesheetRow(activity, theTicker.closest('tr').prop('id'));
	var assignment = row.getAssignment();
	var conversionFactor = assignment.UsageToHoursFactor;
	var rateBand = row.getRateBand();
	var maxUsageHrs = rateBand.MaxUsage * conversionFactor;
	var usageFormat = rateBand.UsageEntryFormat;

	var dayId = theTicker.attr('day-id');
	var entry = row.Entries[dayId];
	
	entry.HasActiveTimer = false;
	var activeTimer = getActiveTimer(entry.Timers)
	activeTimer.EndDateUTC = endDateTime.toKimbleUTC();
	activeTimer.EndTime = getSimpleTimeFromDate(endDateTime, true);
	activeTimer.IsActive = false;
	
	if(assignment.DateAndTimeRequired)
	{
		entry.StartTime = timerStart.getTimeFromDateTime(false);
		entry.EndTime = getSimpleTimeFromDate(endDateTime, false);
	}
	
	// entry units derived from the timers
	// rounded to closest units based on usage format
	var hoursElapsed = timerElapsedSeconds / (60 * 60);
	var multiples = Math.round((hoursElapsed * conversionFactor) / usageFormat);
	// note we cap the usage at the max number of hours for the assignment - TODO129 - rounding and capping are not currently not surfaced to the user
	entry.Units = Math.min((multiples * usageFormat), maxUsageHrs);

	theTicker.closest('td.row-day').find('.row-day-entry').val(kimble.formatNumber(entry.Units)).change();
	// show the entry input box instead of timer	
	theTicker.closest('td.row-day').removeClass('timer-active');
}
				
