function timesheetChanged(row)
{
	if (row != null) row.HasChanges = true;

	jQuery(window).off('.has-changes').on('beforeunload.has-changes', function(){
        return kimble.labels['UnsavedChangesHeading'] + "\n\n" + kimble.labels['UnsavedChangesMessage']; 
    });

	jQuery('.save-btn').removeClass('disabled');

	enableSelectAndSubmit();
	//if (!jQuery('#saveButton').is(':animated')) jQuery('#saveButton').effect('highlight', {color: '#ff7819'}, 3000);
}

// Called by select2 to dynamically populate selects with large lists 
function findMatchingAssignments(params)
{
	var activityIds = [];
	
	for(i=0;i<theGrid.Activities.length;i++)
	{	
		var activity = theGrid.Activities[i];
		
		for (j=0;j<activity.Assignments.length;j++)
		{
			activityIds.push(activity.Assignments[j].ActivityId);
		}
	}
	
	Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetGridController.FindMatchingAssignments}',
      		'{!JSENCODE(TheResource.Id)}', activityIds, '{!JSENCODE(TheResourceTrackingPeriod.Id)}', params.term,
     			function(result, event){          
            		if (event.status) 
	            {
	             	var data = {};
	             	data.results = result;
	             	params.callback(data);
	         	} 
	         	else if (event.type === 'exception') 
	         	{
	             	alert(event.message);
	         	} 
	         	else 
	         	{
	             	alert(event.message);
	         	}
        	}, 
        	{escape: false, timeout: 60000}
    	);
}

var oldRowsCount;

function getActivitiesBookedLastPeriod()
{
    if(!jQuery('.save-btn').hasClass('disabled'))
	{
		alert(kimble.labels['UnsavedChangesPlan']);
	}
	else
	{
    	oldRowsCount = 0;

    	for(i=0;i<theGrid.Activities.length;i++)
	    {
		    var activity = theGrid.Activities[i];

		    if (activity.Rows != null) oldRowsCount += Object.keys(activity.Rows).length;
    	}

    	getTimesheet(true, function(){
    	    var newRowsCount = 0;

    	    for(i=0;i<theGrid.Activities.length;i++)
            {
                var activity = theGrid.Activities[i];

                if (activity.Rows != null) newRowsCount += Object.keys(activity.Rows).length;
            }

    	    if (newRowsCount > oldRowsCount)
    	        timesheetChanged();
    	    else
    	        alert('{!JSENCODE($Label.NoTimeEntriesToCopy)}');
        });
	}
}

function addActivity(Id)
{
	if (theGrid.findActivity(Id) != null) return;
	
	Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TimesheetGridController.GetActivity}',
      		Id, '{!JSENCODE(TheResource.Id)}', '{!JSENCODE(TheResourceTrackingPeriod.Id)}', 
     			function(result, event){          
            		if (event.status) 
		            {
		             	//console.log(result);
		             	var activity = result;
		             	theGrid.Activities.push(result);
		             	
		             	for (var i=0;i<activity.Assignments.length;i++)
						{
							var ass = activity.Assignments[i];
							theGrid.AssignmentCurrentRemainingUsage[ass.ActivityAssignmentId] = ass.CurrentRemainingUsage;
							
							if(!theGrid.HasUsageAllocationInfo && ass.RateBands != undefined && ass.RateBands != null)
							{
								for (var rb=0;rb<ass.RateBands.length;rb++)
								{
									var rate = ass.RateBands[rb];
									if (rate.AllocationModeEnum != undefined && rate.AllocationModeEnum != null && rate.AllocationModeEnum != 'Activity')
									{
										theGrid.HasUsageAllocationInfo = true;
										break;
									}
								}
							}
						}
		             			             	
		             	var activityHtml = getActivityHtml(activity);
		          		
		          		var newRow = jQuery(activityHtml);
		          		
		          		var beforeRow;
		          		
		          		if(jQuery('#Other').length == 0)
		          			beforeRow = jQuery('#activity-lookup');
		          		else
		          			beforeRow = jQuery('#Other');
		          		
		             	beforeRow.before(newRow);
		             	
		             	newRow.find('.add-activity-button').click();
		             	
		             	newRow.effect('highlight', {color: '#FFAA6F'}, 2000);
		         	} 
		         	else if (event.type === 'exception') 
		         	{
		             	alert(event.message);
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		         	}
	        	}, 
	        	{escape: false, timeout: 60000}
	    	);
}

function getUniqueId()
{
	  // Math.random should be unique because of its seeding algorithm.
	  // Convert it to base 36 (numbers + letters), and grab the first 9 characters
	  // after the decimal.
	  return '__' + Math.random().toString(36).substr(2, 9);
}

function jDecode(str) {
    return jQuery("<div/>").html(str).text();
}

