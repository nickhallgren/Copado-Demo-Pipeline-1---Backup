	jQuery(document).off('change', '.start-time.inline-time-picker, .end-time.inline-time-picker');
	jQuery(document).on('change', '.start-time.inline-time-picker, .end-time.inline-time-picker', function() {
		var j = jQuery(this);
		
		var activity = theGrid.findActivity(j.attr('activity-id'));
		
		var row = theGrid.findTimesheetRow(activity, j.attr('row-key'));
		
		var dayId = j.attr('day-id');
		var theDate = j.attr('entry-date');
		
		var entry = row.Entries[dayId];
		var newEntry = false;
		if (entry == null)
		{
			entry = {Id:dayId, TheDate:theDate, Units:0, RevenueUnits:0, Notes:null};
			newEntry = true;
		}
		
		var container = j.parent().parent();
		container.find('.validation').remove();

		var theQtip = j.closest('.qtip');
		var currentStartTime = theQtip.find('.start-time.inline-time-picker[day-id="' + dayId + '"]').val();
		var currentEndTime = theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val();
		var theUsageUnits = jQuery('input.row-day-entry[aria-describedby=' + theQtip.attr('id') + ']');
		
		if(j.hasClass('start-time'))
		{
			if (currentEndTime != '' && currentEndTime < j.val())
			{
				var invalidTimeMsg = '{!JSENCODE($Label.StartTimeAfterEndTimeMessage)}';
				
				j.prev().before(jQuery('<div class="validation error-message">' + invalidTimeMsg + '</div>'));
			}
			else
			{
				entry.StartTime = j.val();
				
				if(currentEndTime == '')
				{
					entry.EndTime = timeAddHours(j.val(), kimble.parseNumber(theUsageUnits.val()));
					theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val(entry.EndTime);
				}
				
				timeChange(this);
			}
		}
		else if(j.hasClass('end-time'))
		{
			if (currentStartTime != '' && currentStartTime > j.val())
			{
				var invalidTimeMsg = '{!JSENCODE($Label.EndTimeBeforeStartTimeMessage)}';
				
				j.prev().before(jQuery('<div class="validation error-message">' + invalidTimeMsg + '</div>'));
			}
			else
			{
				entry.EndTime = j.val();
				timeChange(this);
			}
		}
		
		if(newEntry)
			row.Entries[dayId] = entry;
		
		timesheetChanged(activity);
	});
	
