function validateUsageUnitsChange(field)
{
	var j = jQuery(field);
	
	var activity = theGrid.findActivity(j.closest('tr').attr('activity-id'));
	
	var row = theGrid.findTimesheetRow(activity, j.closest('tr').prop('id'));

	var ass = row.getAssignment();

	var dayId = j.attr('day-id');
	var theDate = j.attr('entry-date');
	
	var entry = row.Entries[dayId];
	
	if (entry == null) entry = {Id:dayId, TheDate:theDate, Units:0, RevenueUnits:0, Notes:null};

	//validate entry
	var container = j.parent();

	container.find('.validation').remove();
	//remove validation messages from this

	if (ass != null && ass.ShowUsageAsHoursAndMins) {
		entry.Units = hoursAndMinsHelper.parseHours(j.val());

		if (entry.Units == null) {
			j.before(jQuery('<div title="' + hoursAndMinsHelper.helpMessage + '" class="validation error"/>'));
  		}
  		else {
  			j.val(hoursAndMinsHelper.formatHours(entry.Units));
    	}

 	} else {

		//if any letter entered then mark as invalid number
 		if (/[a-zA-Z]/.test(j.val())) {
 			j.before(jQuery('<div title="Invalid number" class="validation error"/>'));
 		 	entry.Units = 0;
 		} else {
 		    entry.Units = kimble.parseNumber(j.val());
   		}
  	}

	var rateBand = row.getRateBand();

	if (entry.Units > rateBand.MaxUsage  || entry.Units < 0)
		{
			var maxUsageProblem = '{!JSENCODE($Label.CannotBeGreaterThan)}'.replace('{0}', rateBand.UnitType).replace('{1}',kimble.formatNumber(rateBand.MaxUsage));

			j.before(jQuery('<div title="' + maxUsageProblem + '" class="validation error"/>'));
		}

	if (row.RowType == 'Forecast')
	{
	    var valDec = (entry.Units / rateBand.UsageEntryFormat).toFixed(3);

		if (valDec > parseInt(valDec))
		{
			var usageFormatProblem = '{!JSENCODE($Label.InvalidMultipleOfValue)}'.replace('{0}', rateBand.UnitType).replace('{1}',kimble.formatNumber(rateBand.ForecastEntryFormat));
			j.before(jQuery('<div title="' + usageFormatProblem + '" class="validation error"/>'));
		}
 	}
 	else
 	{
		if (!hoursAndMinsHelper.isFactor(entry.Units, rateBand.UsageEntryFormat))
		{
			var usageFormatProblem;

			if (ass != null && ass.ShowUsageAsHoursAndMins) {
		    	usageFormatProblem = '{!JSENCODE($Label.InvalidMultipleOfValue)}'.replace('{0}', rateBand.UnitType).replace('{1}',hoursAndMinsHelper.formatHours(rateBand.UsageEntryFormat));
			} else {
				usageFormatProblem = '{!JSENCODE($Label.InvalidMultipleOfValue)}'.replace('{0}', rateBand.UnitType).replace('{1}',kimble.formatNumber(rateBand.UsageEntryFormat));
			}

			j.before(jQuery('<div title="' + usageFormatProblem + '" class="validation error"/>'));
		}
	}

	row.Entries[dayId] = entry;
	
	theGrid.calculateTotals();
}

function usageUnitsChange(theField)
{
	var j = jQuery(theField);

	// update the underlying time entry - note we don't fire the change event in the previous statement as that would result in an infinite loop
	var activity = theGrid.findActivity(j.closest('tr').attr('activity-id'));
	var row = theGrid.findTimesheetRow(activity, j.closest('tr').prop('id'));
	var dayId = j.attr('day-id');
	var entry = row.Entries[dayId];

	// we need to find the right start and end times relative to the cell being changed
	var theQtip = jQuery('div#' + j.attr('aria-describedby'));
	var currentStartTime = theQtip.find('.start-time.inline-time-picker[day-id="' + dayId + '"]').val();
	var currentEndTime = theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val();
	var currentEntryUnits = j.val();

	if(currentEntryUnits == '')
	{
		theQtip.find('.start-time.inline-time-picker[day-id="' + dayId + '"]').val('');
		theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val('');
		entry.StartTime = '';
		entry.EndTime = '';		
	}
	else if (currentStartTime != undefined && currentStartTime != '')
	{
		// we only update the end time if the value is blank or the calculated value is greater
		// meaning that you can update the usage to less than the difference
		var newEndTime = timeAddHours(currentStartTime, kimble.parseNumber(currentEntryUnits));
		if(currentEndTime == undefined || currentEndTime == '' || currentEndTime < newEndTime)
		{
			theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val(newEndTime);
			entry.Units = kimble.parseNumber(currentEntryUnits)
			entry.EndTime = timeAddHours(currentStartTime, kimble.parseNumber(currentEntryUnits));
			theGrid.calculateTotals();
		}	
	}
}

function timeChange(theField)
{
	var j = jQuery(theField);
	var activity = theGrid.findActivity(j.attr('activity-id'));
	var row = theGrid.findTimesheetRow(activity, j.attr('row-key'));
	var dayId = j.attr('day-id');
	var theDate = j.attr('entry-date');
	var entry = row.Entries[dayId];
	
	if (entry == null) entry = {Id:dayId, TheDate:theDate, Units:0, RevenueUnits:0, Notes:null};

	var theQtip = j.closest('.qtip');
	var theUsageUnits = jQuery('input.row-day-entry[aria-describedby=' + theQtip.attr('id') + ']');
	var currentStartTime = theQtip.find('.start-time.inline-time-picker[day-id="' + dayId + '"]').val();
	var currentEndTime = theQtip.find('.end-time.inline-time-picker[day-id="' + dayId + '"]').val();

	var ass = row.getAssignment();

	// given a end time and a start time work out the usage
	// also update the underlying time entry - note we don't fire the change event in the previous statement as that would result in an infinite loop
	if ((jQuery(theField).hasClass('start-time') && currentStartTime != '' && currentEndTime != '') || (jQuery(theField).hasClass('end-time') && currentStartTime != '' && currentEndTime != '')) {
		var t = timeDiff(currentStartTime, currentEndTime).toFixed(3);
		entry.Units = t;

		if (ass != null && ass.ShowUsageAsHoursAndMins) {
		    theUsageUnits.val(hoursAndMinsHelper.formatHours(t));
  		} else {
  			theUsageUnits.val(kimble.formatNumber(t, '0.###'));
    	}

		validateUsageUnitsChange(theUsageUnits);
	}
}

function timeDiff(startTime, endTime)
{
	// date is unimportant, using Date construct to do time maths
	return (new Date(2000, 0, 1, parseTime(endTime).hh, parseTime(endTime).mm) - new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm)) / 1000 / 60 / 60;
}

function timeAddHours(startTime, hours)
{
	var newDateTime = addHours(new Date(2000, 0, 1, parseTime(startTime).hh, parseTime(startTime).mm), hours);

	var min = newDateTime.getMinutes();
	if (min < 10) {
		min = "0" + min;
	}

	var hour = newDateTime.getHours();
	if (hour < 10) {
		hour = "0" + hour;
	}

	var newTime = hour + ':' + min;
	
	// special case - if the result is 00:00 and we are adding >0 hours then this must be 24:00
	newTime = (newTime == "00:00" && hours > 0 ? "24:00" : newTime);
	
	return newTime;
}

function addHours(theDate, hours)
{
	theDate.setTime(theDate.getTime() + (hours * 60 * 60 * 1000));
	return theDate;
}

function parseTime(s)
{
	var part = s.match(/(\d+):(\d+)(?: )?(am|pm)?/i);
	var hh = parseInt(part[1], 10);
	var mm = parseInt(part[2], 10);
	var ap = part[3] ? part[3].toUpperCase() : null;
	if (ap === "AM") {
		if (hh == 12) {
			hh = 0;
		}
	}
	if (ap === "PM") {
		if (hh != 12) {
			hh += 12;
		}
	}
	return {
		hh : hh,
		mm : mm
	};
}

