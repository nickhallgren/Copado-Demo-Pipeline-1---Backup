	theGrid.calculateTotals = function()
	{
		var actualPerDayInHours = {};
		var actualPerAssignment = {};

		this.Total = 0;
		this.DayTotals = {};
		
		for (var i=0;i<this.TheDays.length;i++)
		{
			this.DayTotals[this.TheDays[i].Id] = 0;
		}
		
		var dayTotals = this.DayTotals;
		
		for (var i=0;i<this.Activities.length;i++)
		{
			var act = this.Activities[i];
			act.ActivityTotal = 0;
			act.Total = {};
			
			jQuery.each(Object.keys(act.Rows), function(j, rowKey){
				var row = act.Rows[rowKey];
				
				if (!row.IsDeleted)
				{
					row.Total = 0;
					var assignment = row.getAssignment();

					jQuery.each(Object.keys(row.Entries), function(k, entryKey){
						var entry = row.Entries[entryKey];
						
						var entryVal = (entry.HasPendingAdjustment ? 0 : entry.Units);
						
						row.Total += entryVal;
						
						if (act.Total[entry.Id] == null)
							act.Total[entry.Id] = 0;
						
						if (row.RowType != 'Forecast')
						{
							dayTotals[entry.Id] += (assignment.UnitTypeConversionFactor * entryVal);
							act.Total[entry.Id] += entryVal;

							if (actualPerDayInHours[entry.Id] == null) actualPerDayInHours[entry.Id] = 0;

							actualPerDayInHours[entry.Id] += (row.Entries[entry.Id].Units * assignment.UsageToHoursFactor);

							if (row.Entries[entry.Id].Units > 0)
							{
								if (actualPerAssignment[assignment.ActivityAssignmentId] == null) actualPerAssignment[assignment.ActivityAssignmentId] = {};

								actualPerAssignment[assignment.ActivityAssignmentId][entry.Id] = true;
							}
						}
					});
				
					jQuery.each(jQuery('tr[activity-id="' + act.Id + '"]'), function (r, obj) {
						
						if (jQuery(obj).prop('id') == row.Key)
						{
							var ass = row.getAssignment();

							var origValue;

							if (ass != null && ass.ShowUsageAsHoursAndMins) {
							    origValue = hoursAndMinsHelper.parseHours(jQuery(obj).find('.row-total-value').val());
       						} else {
       							origValue = kimble.parseNumber(jQuery(obj).find('.row-total-value').val());
             				}

							var newTotal = kimble.formatNumber(row.Total, '0.###');


							if (ass != null && ass.ShowUsageAsHoursAndMins) {
							    jQuery(obj).find('.row-total-value').val(hoursAndMinsHelper.formatHours(row.Total));
       						} else {
       							jQuery(obj).find('.row-total-value').val(newTotal);
             				}

							// config switch for auto-decrementing remaining effort
							if(autoDecrementRemainingEffort && jQuery(obj).find('.remaining-effort').length && row.CanUpdate)
							{
								var task = row.getTask();

								var currentRemaining = jQuery(obj).find('.remaining-effort').attr('orig-value');
							    // store the original remaining effort as any change of task on the draft line
							    // will need to revert back to this value as the basis
							    // if the remaining value not currently in the tracker it's because this row has just been added into the grid
							    if(task != null && !(Object.keys(autoDecDRETracker).includes(row.Key + task.Id))) autoDecDRETracker[row.Key + task.Id] = kimble.parseNumber(currentRemaining);

								var newRemaining = autoDecDRETracker[row.Key + task.Id] - row.Total;

								// floor the remaining at 0
								var realRemaining = Math.max(0, newRemaining);

								if (ass != null && ass.ShowUsageAsHoursAndMins) {
									jQuery(obj).find('.remaining-effort').val(hoursAndMinsHelper.formatHours(realRemaining));
								} else {
								    jQuery(obj).find('.remaining-effort').val(kimble.formatNumber(realRemaining, '0.###'));
        						}

								if (task != null) task.RemainingEffort = realRemaining;
							}
						}
					});
					
					if (row.RowType != 'Forecast') act.ActivityTotal += row.Total;
				}
			});
			
			jQuery('tr#' + act.Id + ' .activity-total-value').text(kimble.formatNumber(act.ActivityTotal, '0.###'));
			
			jQuery.each(jQuery('tr#' + act.Id + ' .activity-day-total-value'), function (l, obj) {
				var val = replaceNull(act.Total[jQuery(obj).prop('id')], 0);
				
				jQuery(obj).text(kimble.formatNumber(val, '0.###'));
			});
		}
		
		this.DayTotals = dayTotals;
		
		for(i=0;i<this.TheDays.length;i++)
		{
			var day = this.TheDays[i];
		
			var dayTot = this.DayTotals[day.Id];
			jQuery('.day-total#' + day.Id).val(kimble.formatNumber(dayTot, '0.##'));

			this.Total += dayTot;
		}

		jQuery('.grid-total').val(kimble.formatNumber(this.Total, '0.##'));

		//update other forecast
		for (var i=0;i<theGrid.Activities.length;i++)
		{
			var activity = theGrid.Activities[i];
			jQuery.each(Object.keys(activity.Rows), function(i, key) {
				var r = activity.Rows[key];

				if (r.RowType == 'Forecast' && r.CanActualise == true)
				{
					var assignment = r.getAssignment();
					r.Total = 0;

					jQuery.each(Object.keys(r.Entries), function(j, id) {

						r.Entries[id].Units = r.Entries[id].ForecastUnits;

						if (actualPerAssignment[assignment.ActivityAssignmentId] != null && actualPerAssignment[assignment.ActivityAssignmentId][id] != null)
						{
							r.Entries[id].Units = 0;
						}
						else if (!r.Entries[id].IsScheduled && reduceSuggestedTimeOnceActualExists)
						{
							//erode forecast if more than HoursPerDay!
							//convert forecast units into hours
							var forecastInHours = r.Entries[id].ForecastUnits * assignment.UsageToHoursFactor;

							if (actualPerDayInHours[id] == null) actualPerDayInHours[id] = 0;

							if (actualPerDayInHours[id] + forecastInHours > assignment.HoursPerDay)
							{
								var hoursToRemove = actualPerDayInHours[id] + forecastInHours - assignment.HoursPerDay;
								r.Entries[id].Units = Math.max(0, (forecastInHours - hoursToRemove) / assignment.UsageToHoursFactor);
							}
						}

						r.Total += r.Entries[id].Units;
					});

					jQuery('#' + r.Key).replaceWith(getTimesheetRowHtml(activity,r));
				}
			});
		}
	}
	
