			parentRow.find('input.row-total-value').parent().find('span.remove-entry').hide();
			parentRow.find('input.row-total-value').parent().find('span.undo-entry-adjustment').show();
		}
		
		var activity = theGrid.findActivity(j.closest('tr').attr('activity-id'));
		
		var row = theGrid.findTimesheetRow(activity, j.closest('tr').prop('id'));
		
		var editRow;
		
		var matchingRows = row.findMatchingDraftRows();
		
		for (var i=0;i<=matchingRows.length-1;i++)
		{
			editRow = matchingRows[i];		
		}
		
		var dayId = j.attr('day-id');
		var theDate = j.attr('entry-date');
		
		var entry = row.Entries[dayId];
		entry.HasPendingAdjustment = true;
		row.HasPendingAdjustments = true;
		
		if (jQuery(this).hasClass('edit-entry'))
		{
			if (editRow == null)
			{
				var newRow = jQuery.extend(true, {}, row);
				newRow.Key = getUniqueId();
				newRow.MatchKey = row.Key;
				newRow.DraftTimeEntries = null;
				newRow.Entries = {};
				newRow.CanDelete = true;
				newRow.CanUpdate = true;
				newRow.Status = 'Draft';
				newRow.DisplayStatus = 'Draft';
				newRow.StatusLabel = '{!UPPER($Label.TEStatusDraft)}';
				newRow.IsDeleted = false;
				newRow.IsUpdated = true;
				newRow.Problems = {};
			
				newRow.Entries[dayId] = {Id:dayId, TheDate:theDate, Units:entry.Units, RevenueUnits:entry.RevenueUnits, Notes:null, StartTime:entry.StartTime, EndTime:entry.EndTime};
			
				activity.Rows[newRow.Key] = newRow;
			
				var newRowHtml = getTimesheetRowHtml(activity, newRow);
			
				parentRow.after(jQuery(newRowHtml));
			}
			else
			{
				editRow.Entries[dayId] = {Id:dayId, TheDate:theDate, Units:entry.Units, RevenueUnits:entry.RevenueUnits, Notes:null, StartTime:entry.StartTime, EndTime:entry.EndTime};
			
				var newRowHtml = getTimesheetRowHtml(activity, editRow);

				jQuery('#' + editRow.Key).replaceWith(newRowHtml);
			}
		}
		
		theGrid.calculateTotals();
		
		timesheetChanged(activity);
	
	});
	
