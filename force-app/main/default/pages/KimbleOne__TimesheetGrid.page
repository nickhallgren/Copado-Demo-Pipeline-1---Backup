    width:100%;
}

.edit-entry {
    top: -5px;
    left: -3px;
}

.remove-entry {
    bottom: -6px;
    right: -5px;
}

.undo-entry-adjustment {
    top: -6px;
    left: -4px;
    display: none;
}

.edit-entry, .remove-entry, .undo-entry-adjustment {
    position: absolute;
    color: #4A4A56;
    cursor: pointer;
    font-size: 16px !important;
    background-color: #ededed;
    z-index: 99;
	border-radius: 8px;
    width: 16px;
}

.remove-entry:hover, .edit-entry:hover, .undo-entry-adjustment:hover {
	background-color: #9FD7FF;
}

.strikethrough {
    position: relative;
}

.strikethrough:before {
    position: absolute;
    content: "";
    left: 2px;
    top: 47%;
    right: 2px;
    border-top: 1px solid;
    border-color: inherit;
    -webkit-transform: rotate(-21deg);
    -moz-transform: rotate(-21deg);
    -ms-transform: rotate(-21deg);
    -o-transform: rotate(-21deg);
    transform: rotate(-21deg);
    z-index: 10;
    color: #f00;
}

.adjustment {
	display: none;
}
