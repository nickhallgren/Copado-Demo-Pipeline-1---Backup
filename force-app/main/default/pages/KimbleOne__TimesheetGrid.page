	jQuery(document).off('click', '.undo-entry-adjustment');
	jQuery(document).on('click', '.undo-entry-adjustment', function (event) {
		
		//removes the value from the adjustment row from day - if all days are 0 then remove the row
		var j = jQuery(this).parent().find('input');
		
		jQuery(this).parent().find('.remove-entry, .edit-entry').show();
		jQuery(this).parent().find('.undo-entry-adjustment').hide();
		
		var parentRow = j.closest('tr');
		
		// if this is a row-total cell do the click for all cells
		if (jQuery(this).parent().parent().hasClass('row-total'))
		{
			parentRow.find('.undo-entry-adjustment:not(:hidden)').click();
			
			jQuery(this).parent().removeClass('strikethrough');
			return;
		}
		
		jQuery(this).parent().removeClass('strikethrough');
		
		// if the all adjustable cells on the row have been adjusted, mark the parent
		if(parentRow.find('input.day-cell[value!=""]').length > parentRow.find('td.row-day div.day-cell-container.strikethrough').length)
		{
			parentRow.find('input.row-total-value').parent().removeClass('strikethrough');
			parentRow.find('input.row-total-value').parent().find('span.edit-entry').show();
			parentRow.find('input.row-total-value').parent().find('span.remove-entry').show();
			parentRow.find('input.row-total-value').parent().find('span.undo-entry-adjustment').hide();			
		}
		
		var activity = theGrid.findActivity(j.closest('tr').attr('activity-id'));
		
		var row = theGrid.findTimesheetRow(activity, j.closest('tr').prop('id'));
		var dayId = j.attr('day-id');
		
		row.Entries[dayId].HasPendingAdjustment = false;
		
		var adjustmentRows = row.findMatchingDraftRows();
				
		if (adjustmentRows.length == 1) 
		{
			// Adjustment edit row
			var adjustmentRow = adjustmentRows[0];
			
			delete adjustmentRow.Entries[dayId];
			
			if (Object.keys(adjustmentRow.Entries).length == 0)
			{
				//remove the row
				delete activity.Rows[adjustmentRow.Key];
				
				jQuery('#' + adjustmentRow.Key).remove();
			}
			else
			{
				var newRowHtml = getTimesheetRowHtml(activity, adjustmentRow);
				
				jQuery('#' + adjustmentRow.Key).replaceWith(newRowHtml);
			}
		}
		
		theGrid.calculateTotals();
		
		timesheetChanged(activity);
	});
	
