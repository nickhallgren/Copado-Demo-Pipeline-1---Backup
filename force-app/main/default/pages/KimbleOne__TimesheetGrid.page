		var ActiveTimerStartDateTimeUTC = (dayHasActiveTimer ? getActiveTimer(rowObject.Entries[day.Id].Timers).TimerStartDateTimeUTC : '');

		var formattedVal;

		if (ass != null && ass.ShowUsageAsHoursAndMins) {
		    formattedVal = hoursAndMinsHelper.formatHours(val);
  		} else {
  			formattedVal = kimble.formatNumber(val, '#.###')
    	}

		cellContent += '<input ' + readonly + ' title="<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__EntryUnits__c.Label}"/>" type="text" day-id="' + day.Id + '" entry-date="' + day.TheDate + '" class="day-cell row-day-entry" value="' + formattedVal + '"/>';
		
		if(dayHasActiveTimer) cellContent += '<span class="te-timer" t-tip-grid-row="TETimerActive"><span class="ticker" timer-start-time="' + ActiveTimerStartDateTimeUTC + '" day-id="' + day.Id + '" entry-date="' + day.TheDate + '"></span><i class="fa fa-stop-circle timer-item stop-timer" title="' + stopTimerLabel + '"></i></span>';
		
		if (rowObject.RowType != 'Forecast' && rate != null && rate.PeriodTypeEnum != day.PeriodTypeEnum)
		{
			cellContent = '';
			cellClass = 'no-entry-day';
		}		
		
		var divClass = 'day-cell-container';
		
		if (hasAdjustment)
			divClass += ' strikethrough';
		
		html += '<td class="' + cellClass + '"><div class="' + divClass + '">';
		
		html += cellContent;
		
		if (rate != null && rate.ShowRevenueUnits && rate.PeriodTypeEnum == day.PeriodTypeEnum)
		{
			var revVal = 0;
			if (rowObject.Entries != null && rowObject.Entries[day.Id] != null)
				revVal = rowObject.Entries[day.Id].RevenueUnits;
			
			html += '<div><input ' + readonly + ' title="<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__RevenueUnits__c.Label}"/>" type="text" day-id="' + day.Id + '" entry-date="' + day.TheDate + '" class="day-cell row-day-revenue-entry ' + problemType + '" value="' + kimble.formatNumber(revVal, '#.###') + '"/></div>';
		}
		
		html += '</div></td>';
	}); 
	
	html += '</td>';
	
	//Total + task remaining effort
	var adjustRowHtml = '';
	
	if (periodStatus == 'Closed' && adjustMode == 'true' && rowObject.Status == 'Approved' && rowObject.Total > 0 && rowObject.CanAdjust) 
	{
		adjustRowHtml += '<span class="edit-entry fa fa-pencil" title="{!$Label.EditRowLabel}" ></span>';
		adjustRowHtml += '<span class="remove-entry fa fa-times-circle" title="{!$Label.RemoveRowLabel}"></span>';
		adjustRowHtml += '<span class="undo-entry-adjustment fa fa-undo" title="{!$Label.UndoRowAdjustmentLabel}"></span>';
	}

	var rowTotalFormatted;

	if (ass != null && ass.ShowUsageAsHoursAndMins) {
	    rowTotalFormatted = hoursAndMinsHelper.formatHours(rowObject.Total);
 	} else {
 	    rowTotalFormatted = kimble.formatNumber(rowObject.Total, '0.###');
  	}


	html += '<td class="row-total"><div class="day-cell-container">' + adjustRowHtml + '<input readonly type="text" class="row-total-value" value="' + rowTotalFormatted + '"/></div><span class="row-units">' + (ass == null || ass.ShowUsageAsHoursAndMins ? '' : ass.EntryUnitTypeSuffix) + '</span>';
	
	var task = rowObject.getTask();
	
	if (task != null && task.CanEditRemainingEffort)
	{
		var readonly = '';
		
		if (!rowObject.CanUpdate)
			readonly = 'readonly';	
		
		html += '<div class="total-container">';
		
		var remainingEffort = ((task.RemainingEffort != null) ? task.RemainingEffort : '');

		var remainingEffortFormatted;
		if (ass != null && ass.ShowUsageAsHoursAndMins) {
			remainingEffortFormatted = hoursAndMinsHelper.formatHours(remainingEffort);
		} else {
			remainingEffortFormatted = kimble.formatNumber(remainingEffort, '0.###')
		}

		html += '<input task-id="' + task.Id + '" ' + readonly + ' type="text" class="remaining-effort" value="' + remainingEffortFormatted + '" orig-value="' + remainingEffort + '"/>';

		html += '<span class="row-units"><apex:outputText value="{!$ObjectType.KimbleOne__PlanTaskAssignment__c.Fields.KimbleOne__DraftRemainingEffort__c.Label}"/></span>';
		html += '</div>';
	}
	
	html += '</td>';

	var statusIcon = '';

	if (rowObject.DisplayStatus == 'RequestApproved')
		statusIcon = '<i class="te-icon fa fa-calendar-check-o RequestApproved"></i>'
	if (rowObject.DisplayStatus == 'RequiresApproval')
		statusIcon = '<i class="te-icon fa fa-calendar-plus-o RequiresApproval"></i>'
	if (rowObject.DisplayStatus == 'Suggested')
		statusIcon = '<i class="te-icon fa fa-lightbulb-o Suggested"></i>';

	var secondaryStatus = (rowObject.SecondaryStatusLabel != undefined ? '<span class="status-pill secondary-status-pill ' + rowObject.SecondaryDisplayStatus + '" t-tip-grid-row="' + rowObject.SecondaryDisplayTTipNarrative + '"> ' + rowObject.SecondaryStatusLabel + '</span>' : '');
	html += '<td class="timesheet-status ' + rowObject.DisplayStatus + '"><div>' + statusIcon + '<span class="status-pill ' + rowObject.DisplayStatus + '"> ' + rowObject.StatusLabel + '</span>' + secondaryStatus + '</div></td>';
	html += '</tr>';
	
	return html;
}

function getActiveTimer(timers)
{
	var activeTimer;
	
	jQuery.each(timers, function (i, timer) {
		if(timer.IsActive) activeTimer = timer;
	});
	
	return activeTimer;
}

function getUsageAllocationInfoHtml(ass, rate, rowObject)
{
	if (ass == null || rate == null || !theGrid.HasUsageAllocationInfo || rowObject.RowType == 'Forecast') return '<span/>';
	
	var usageAllocationClass = '';
	if(rate.AllocationModeEnum == 'CategoryAndTask')
	{
		usageAllocationClass = ' with-task-and-category';
	}
	
	var html = '<div class="usage-allocation-info' + usageAllocationClass + '">';

	if (ass.TimeCategories.length > 0 && rate.AllocationModeEnum == 'Category' || rate.AllocationModeEnum == 'CategoryAndTask')
	{
		var categoryCombination = '';
		
		for(i=1;i<=6;i++)
		{
			var catVal = rowObject['Cat' + i];
			if (catVal != null && catVal != '')
			{
				categoryCombination += (catVal + ',');
			}
		}
		
		if (categoryCombination != '') categoryCombination = categoryCombination.substring(0, categoryCombination.length - 1);

		var mandCat = false;
		jQuery.each(ass.TimeCategories, function (i, cat){
		    if(cat.IsMandatory != undefined && cat.IsMandatory) mandCat = true;
		});

		var categoryClass = "category-entry";
		if (!rowObject.CanUpdate)
			categoryClass += ' category-readonly';

 		if(mandCat) html += '<span class="required-container"><span class="cat-required"/></span>';
		html += '<input type="text" class="' + categoryClass + '" readonly placeholder="--<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__CategoryCombination__c.Label}"/>--" value="' + categoryCombination + '"/>';
	}

	if (ass.HasCases) {
        var caseClass = '';
		if(rate.AllocationModeEnum == 'Category')
		{
			caseClass = ' with-category';
		}

        var caseInpClass = "case-entry";
		if (!rowObject.CanUpdate) caseInpClass += ' case-readonly';

        if (rowObject.CanUpdate){
            html += '<div class="' + caseClass + '"><input id="case_'+ getUniqueId() + '" ' + (rowObject.CanUpdate?'onclick="setLastMousePosition(event);kimbleOpenCaseLookup(this, \'' + ass.ActivityId + '\',\'' + ass.DeliveryGroupId + '\');"':'') + ' type="text" class="' + caseInpClass + '" readonly placeholder="--<apex:outputText value="{!$ObjectType.Case.Fields.CaseNumber.Label}"/>--" value="' + (rowObject.CaseReference == null ? '' : rowObject.CaseReference) + '"/>' + (rowObject.CaseReference == null ? '' : '<i class="fa fa-times clear-case-id"></i>') + '</div>';
		}
		else {
		    html += '<div>' + rowObject.CaseReference + '</div>';
        }
 	}

	if (rate.AllocationModeEnum == 'Task' || rate.AllocationModeEnum == 'CategoryAndTask')
	{
		//build task select html
		var taskClass = '';
		if(rate.AllocationModeEnum == 'CategoryAndTask')
		{
			taskClass = ' with-category';
		}
		
		if (rowObject.getTask() == null)
		{
			if (ass.Tasks.length == 1)
			{
				rowObject.TaskId = ass.Tasks[0].Id;
				timesheetChanged(theGrid.findActivity(ass.ActivityId));
			}
			else
				rowObject.TaskId = null;
		}
		
		if (ass.Tasks.length == 1 || !rowObject.CanUpdate)
		{
			var taskName = rowObject.getTask() != null ? rowObject.getTask().Name : '';
			html += '<span class="selected-task' + taskClass + '">' + taskName + ' </span>';
		}
		else
		{
			html += '<select class="task-select' + taskClass + '">';
			
			// sort the tasks by Name using a custom object sorter (maps used to populate so more straightforward to sort in UI)
			ass.Tasks.sort(taskNameSort);
			
			if (rowObject.TaskId == null) html += '<option></option>';
			
			for (var i=0;i<ass.Tasks.length;i++)
			{
				html += '<option value="' + ass.Tasks[i].Id + '" ' + (ass.Tasks[i].Id == rowObject.TaskId ? ' selected ' : '') + '>' + ass.Tasks[i].Name + '</option>';
			}
			
			html += '</select>';
			html += '<span class="quick-entry-button inline-button fa fa-tasks" title="{!$Label.TimesheetCreateDraftEntryForTask}"></span>';
		}
	}
				
	if (rate.AllocationModeEnum == 'Reference')
	{
		var disabledHtml = rowObject.CanUpdate ? '' : ' disabled ';
		html += '<input type="text"' + disabledHtml + 'class="reference-entry" placeholder="--<apex:outputText value="{!$ObjectType.KimbleOne__TimeEntry__c.Fields.KimbleOne__Reference__c.Label}"/>--" value="' + (rowObject.Reference == null ? '' : rowObject.Reference) + '"/>';
	}
	
	html += '</div>';
	
	return html;
}

var kimblePopup;

function kimbleOpenCaseLookup(obj, activityId, groupId)
{
	var inp = jQuery(obj);

	kimblePopup = window.open(KimbleLookupPage + '?lknm=' + inp.attr('id') + '&lktp=500&lksrch=' + escape(inp.val()) + '&filter=TimesheetCaseFilter;' + activityId + ':' + groupId + '&typename=LookupObjectCase&lksrch=' + escape(inp.val()), "lookup", "width=670,height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", false);
}

function closeKimblePopup()
{
	if (kimblePopup != null) kimblePopup.close();
}

//Generic response
function kimblePickValue(objId, resultId, resultName)
{
	closeKimblePopup();

	var obj = jQuery('#' + objId);
	obj.attr('data-id', resultId).val(resultName);
	obj.change();
}

function taskNameSort(a,b)
{
	if (a.Name < b.Name)
		return -1;
	
	if (a.Name > b.Name)
		return 1;
  
	return 0;
}

function getAssignmentRateHtml(rowObject)
{
	var html = '';
	
	var ass = rowObject.getAssignment();
	
	if (ass == null || rowObject.RowType == 'Forecast') return html;
	
	if (ass.RateBands.length == 1  || !rowObject.CanUpdate)
	{
		// work through the rate bands and find a match
		jQuery.each(ass.RateBands, function (i, rate) {			
			if(rate.ActivityRateBandId == rowObject.ActivityRateBandId)
			{
				html += '<span class="selected-rate-band">' + rate.Name + '</span>';
				return false;
			}
		});
	}
	else
	{
		html += '<select class="rate-select">';
	
		jQuery.each(ass.RateBands, function (i, rate) {
		    const len = Object.keys(rowObject.Entries).length;
			if((len == 0 && rate.IsActive) || (len > 0 && (rate.IsActive || rate.ActivityRateBandId == rowObject.ActivityRateBandId)))
			html += '<option value="' + rate.ActivityRateBandId + '" ' + (rate.ActivityRateBandId == rowObject.ActivityRateBandId ? ' selected ' : '') + '>' + rate.Name + '</option>';
		});
	
	
		html += '</select>';
	}
	
	return html;
}

function getBodyHtml()
{
	var html = '';
	
	var otherActivity = null;
	
	jQuery.each(theGrid.Activities, function (i, act) {
		html += getActivityHtml(act);
	});
	
	if (theGrid.HasNonForecastActivities)
	{
		//lookup to find and add non-forecast activities
