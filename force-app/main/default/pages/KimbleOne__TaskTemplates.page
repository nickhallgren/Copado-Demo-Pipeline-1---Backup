	function indent(item)
	{
		//with-in scope
		var siblings = item.prevAll('[parent-node-id="' + item.attr('parent-node-id') + '"]');
		
		if (siblings.length == 0) return null;
		
		var parentItem = jQuery(siblings[0]);
		
		//if parent is detailed item then return
		if (parentItem.hasClass('detail')) return;
		
		item.attr('parent-node-id',parentItem.attr('node-id'));
		
		setLevel(item, new Number(item.attr('level')) + 1);
		
		if(!parentItem.hasClass('Iteration'))
		{
			parentItem.addClass('branch').addClass('expanded');
			
			updateItemDates(parentItem);
		}
		planChanged();
	}
	
