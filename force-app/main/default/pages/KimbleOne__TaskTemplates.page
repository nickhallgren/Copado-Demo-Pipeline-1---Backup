			if ((jQuery(thePlanItemRow).data('planItem') != undefined 
					&& jQuery(thePlanItemRow).data('planItem').CanDelete != undefined 
					&& !jQuery(thePlanItemRow).data('planItem').CanDelete)) return;
			
			deleteTask(jQuery(thePlanItemRow));
		});
	
		deletingNodeIds = {};
		
		planChanged();
		toggleWorking('#deleteTaskButton');
	}
	
	function deleteTask(item)
	{
		var taskId = item.attr('node-id');
		
		if (!item.hasClass('new'))
			deletedItems[taskId] = taskId;
		
		jQuery.each(jQuery('.tree-node[parent-node-id="' + taskId + '"]'), function (i, child) {
			if ((jQuery(child).data('planItem') != undefined 
					&& jQuery(child).data('planItem').CanDelete != undefined 
					&& !jQuery(child).data('planItem').CanDelete))
			{
				// we can't delete this item but the parent is being deleted so we must disconnect
				jQuery(child).attr('parent-node-id','');
				jQuery(child).attr('level', parseInt(jQuery(child).attr('level')) - 1);
				jQuery(child).find('indent').remove();
			}
			else
			{
				deleteTask(jQuery(child));	
			}
		});
		
		var parentItem = jQuery('[node-id="' + item.attr('parent-node-id') + '"]');
		
		item.remove();
		
		if (parentItem.length != 0)
		{
			if (jQuery('[parent-node-id="' + parentItem.attr('node-id') + '"]').length == 0)
				parentItem.removeClass('branch');
			
			updateItemDates(parentItem);
		}
		
		// if this task has dependencies then we need to get them to recalc their dates
		var theTaskDependencies = planSuccessors[taskId];
		delete planSuccessors[taskId];
	
		if(theTaskDependencies != undefined)
		{
			// first remove it from the planDependencies
			jQuery.each(theTaskDependencies, function(i, planItem) {
				delete planPredecessors[i][taskId];
			});
		}
		jQuery('[gantt-id="' + item.attr('node-id') + '"]').remove();
		
		// finally remove the planItem
		delete planItems[taskId];
	}
	
