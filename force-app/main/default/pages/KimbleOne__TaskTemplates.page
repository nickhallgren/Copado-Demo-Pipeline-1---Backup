	function itemRowClick(e)
	{
		if(viewMode == 'planner') return;
		
		var row = jQuery(this);
		
		if(!cntrlOn && !shiftOn)
		{
			row.siblings().removeClass("selected");
		}
		
		row.toggleClass('selected');
		
		if(shiftOn)
		{
			var rowsBetweenSelected = jQuery('[node-id].selected:first').closest('tr').nextUntil('[node-id].selected:last');
			
			jQuery.each(rowsBetweenSelected, function(i, thePlanItemRow) {
				jQuery(thePlanItemRow).addClass('selected');
			});
		}
		
		// disable the link/unlink options if any summary tasks are selected
		if(jQuery('.branch.selected').length > 0)
		{
			jQuery('.prevent-for-summary').addClass('disabled');
		}
		else
		{
			jQuery('.prevent-for-summary').removeClass('disabled');
		}
	
		var revenueMilestoneSelected = false;
		var lockedItemSelected = false;
		
		jQuery.each(jQuery('tr.selected'), function(i, thePlanItemRow) {
			if(jQuery(thePlanItemRow).data('planItem') == undefined)
			{
				lockedItemSelected = true;
			}
			else
			{
				if(jQuery(thePlanItemRow).data('planItem').MilestoneType == 'Revenue')
				{
					revenueMilestoneSelected = true;
					lockedItemSelected = true;
				}
				if(jQuery(thePlanItemRow).data('planItem').CanDelete == false) lockedItemSelected = true;
				
				if(jQuery(thePlanItemRow).data('planItem').WorkItems != undefined && jQuery(thePlanItemRow).data('planItem').WorkItems.length) lockedItemSelected = true;
			}
		});	
		
		if(revenueMilestoneSelected)
		{
			jQuery('.prevent-for-milestone').addClass('disabled');
		}
		else
		{
			jQuery('.prevent-for-milestone').removeClass('disabled');
		}
		
		if(lockedItemSelected)
		{
			jQuery('#deleteTaskButton').addClass('disabled');
		}
		else
		{
			jQuery('#deleteTaskButton').removeClass('disabled');
		}
	}
	
