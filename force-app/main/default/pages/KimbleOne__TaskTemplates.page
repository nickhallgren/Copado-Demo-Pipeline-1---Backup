		{
			var planItemConstraintEnum = planItemConstraintIdToEnumMap[advancedPanel.find('#edit-milestone-constraint-type').val()];
			
			// if either the start or end date have changed that means we are forcing into either the :
			//	- Start No Earlier Than or 
			//	- Finish No Earlier Than constraint type. 		
			// i.e. it's a shortcut for entering the constraint date and changing the type - this is inline with MSProject
			// track this change before we process the mode
			// note we only do this if not manuallyscheduling
			if(planItemConstraintEnum != 'ManuallyScheduled' && planItemConstraintEnum != undefined && planItemConstraintEnum != '')
			{
				// new start date becomes the constraint date and mode switches
				planItemConstraintEnum = 'StartNoEarlierThan';
				advancedPanel.find('#edit-milestone-constraint-type').val(planItemConstraintEnumToIdMap[planItemConstraintEnum]);
			}
		});
					
		jQuery('#MilestoneOkButton').off('click');
		
