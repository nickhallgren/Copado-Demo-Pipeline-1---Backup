		jQuery('tr.selected').removeClass('selected');
	
		// filter out any MS project day/day?/days/days? attributes on the duration column values
		var theFilteredText = theText.replace(/ {0,1}days{0,1}\?{0,1}/g, '');
		var newTaskLines = theFilteredText.split(/[\r\n]+/);
	
		var levelParentIds = {};
		
		jQuery.each(newTaskLines, function(i){
			var newTaskParts = newTaskLines[i].split("\t");
			
			// defined format for MSP paste is
			//OutlineLevel<tab>Summary<tab>Task Name<tab>Duration
			
			// TODO125: validate the structure
			
			if(newTaskParts.length > 1)
			{
				if(newTaskParts[2] != '')
				{
					// if the duration = 0 then create as a planning milestone, otherwise a task
					if(newTaskParts[3] == "0")
					{
						addMilestoneClick(null);
					}
					else
					{
						addTaskClick(null, newTaskParts[1]=='Yes');
					}
	
					jQuery('.itemName input:last').closest('tr').attr('level', kimble.replaceNull(kimble.parseNumber(newTaskParts[0],0),1)-1);
					
					if(newTaskParts[1]=='Yes')
					{
						levelParentIds[kimble.replaceNull(kimble.parseNumber(newTaskParts[0],0),1)-1] = jQuery('.itemName input:last').closest('tr').attr('node-id');
						jQuery('.itemName input:last').closest('tr').addClass('branch expanded');
						jQuery('.itemName input:last').closest('tr').data('planItem').IsSummary = true;
					}
					
					if(kimble.parseNumber(newTaskParts[0], 0) > 0)
					{
						// this isn't a root task so find the correct parent for this level
						jQuery('.itemName input:last').closest('tr').attr('parent-node-id', levelParentIds[kimble.replaceNull(kimble.parseNumber(newTaskParts[0],0),1)-2]);
					}
	
					jQuery('.itemName input:last').val(newTaskParts[2]);
					jQuery('.itemName input:last').closest('tr').data('planItem').Name = newTaskParts[2];
					if(newTaskParts[1]!='Yes') jQuery('.duration input:last').val(newTaskParts[3]).change();
	
					jQuery('.itemName input:last').closest('tr').removeClass('selected');
				}
			}
		});
	}

