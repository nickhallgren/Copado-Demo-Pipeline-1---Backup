   	function getGridPlanItemObject(itemRow)
	{
		var row = jQuery(itemRow);
		
		var planItem;
		
		if(row.hasClass('backlog-row') || row.hasClass('backlog'))
		{
			planItem = {Id:row.attr('node-id'), Name:getItemName(row), IsSummary:false, IsIteration:false, IsNew:false};
			planItem.WorkItems = planWorkItems;
		}
		else
		{
			planItem = {Id:row.attr('node-id'), TypeEnum:row.attr('type-enum'), Position:row.index()+1, Name:getItemName(row), ParentId:row.attr('parent-node-id'), IsSummary:row.hasClass('branch'), IsIteration:row.hasClass('Iteration'), Level:row.attr('level'), IsNew:row.hasClass('new'), StartDateOffset:null, EndDateOffset:null};
			
			if (planItem.TypeEnum == 'Task')
			{
				var task = row.data('planItem');
				planItem.IsFixedEffort = (planItem.IsIteration ? false : row.find('.fixedEffort input').prop('checked'));
				planItem.Effort = kimble.parseNumber(kimble.replaceValue(row.find('.taskEffort input').val(), ''));
				planItem.TaskCategoryId = row.attr('categoryid');
				planItem.CalendarShowAsId = row.attr('calendar-show-as');
				planItem.StartTime = row.attr('start-time');
				planItem.EndTime = row.attr('end-time');
				planItem.Notes = task.Notes;
				planItem.Assignments = row.data('assignments');
				planItem.WorkItems = task.WorkItems; 
				if (planItem.TaskCategoryId == '') planItem.TaskCategoryId = null;
				if (planItem.CalendarShowAsId == '') planItem.CalendarShowAsId = null;
			}
			else
			{
				var milestone = row.data('planItem');
				planItem.MilestoneType = milestone.MilestoneType;
				planItem.Notes = milestone.Notes;
				planItem.IsComplete = milestone.IsComplete;
				planItem.IsCompletedByPredecessorTasks = milestone.IsCompletedByPredecessorTasks;
				
				// trim out any display suffix information
				if(milestone.NameSuffix != undefined && milestone.NameSuffix != null && milestone.NameSuffix != '')
				{
					planItem.Name = planItem.Name.replace(milestone.NameSuffix, '');
					planItem.NameSuffix = milestone.NameSuffix;
				}
			}

			if(planItem.TypeEnum == 'Task' || planItem.MilestoneType == 'Planning') planItem.VisibilityLevelId = row.attr('visibilityLevelId');
	
			planItem.ConstraintTypeId = row.attr('constrainttypeid');
			planItem.IncludeNonBusinessDays = row.find('.ignore-non-bus-days input').prop('checked');
	
			planItem.StartOffset = kimble.parseNumber(row.find('.duration').attr('start-offset'), '0.##');
			planItem.EndOffset = kimble.parseNumber(row.find('.duration').attr('end-offset'), '0.##');
			
			
			planItem.StartDateOffset = kimble.parseNumber(kimble.replaceValue(row.find('.startDateOffset input').val(), ''));
			planItem.EndDateOffset = kimble.parseNumber(kimble.replaceValue(row.find('.endDateOffset input').val(), ''));
		}
		
		return planItem;
	}
	
	function initialiseEditTaskPopup(taskId, tab)
	{
		var taskRow = jQuery('[node-id="' + taskId + '"]');
		
		var task = getGridPlanItemObject(taskRow);

		var isBacklogRow = taskRow.hasClass('backlog-row');
		var showDetails = !isBacklogRow;
		var showWorkItems = enableWorkItems || task.IsIteration;
		var showAssignments = !isBacklogRow;
		var showDependencies = !isBacklogRow;
		var showAdvanced = !isBacklogRow;
				
		if(task.IsSummary) return;
		
		initialiseModalBoxy('#EditTaskContainer','Task - ' + task.Name);
		
		//details panel
		if(showDetails)
		{
			jQuery('li[data-target="task-details"]').show();

			var detailsPanel = jQuery('#edit-task');
			detailsPanel.find('#edit-name').val(task.Name);
			detailsPanel.find('#edit-start-date-offset').val(safeFormatNumber(task.StartDateOffset));
			detailsPanel.find('#edit-end-date-offset').val(safeFormatNumber(task.EndDateOffset));
			detailsPanel.find('#edit-effort').val(safeFormatNumber(task.Effort));
			detailsPanel.find('#edit-fixed').prop('checked', task.IsFixedEffort);
			detailsPanel.find('#edit-calendar-show-as').val(task.CalendarShowAsId);
			detailsPanel.find('#edit-catgeory').val(task.TaskCategoryId);
			detailsPanel.find('#edit-start-time').val(task.StartTime);
			detailsPanel.find('#edit-end-time').val(task.EndTime);
		}
		else
		{
			jQuery('li[data-target="task-details"]').hide();
		}
		
		// Work Items
		if(showWorkItems)
		{
			jQuery('li[data-target="task-work-items"]').show();
			
			var workItemsPanel = jQuery('#task-work-items-container');
			workItemsPanel.empty();
			workItemsPanel.attr('task-id', taskId);
			workItemsPanel.append(getTaskWorkItemsHtml(task));
			jQuery(document).off('click', '.add-task-work-item').on('click', '.add-task-work-item', addTaskWorkItemClick);
			jQuery(document).off('click', '.edit-work-item').on('click', '.edit-work-item', editWorkItemClick);
			jQuery(document).off('click', '.del-work-item').on('click', '.del-work-item', deleteTaskWorkItemClick);
			jQuery(document).off('keydown', '.work-item-name').on('keydown', '.work-item-name', workItemChange);
			jQuery(document).off('keydown', '.work-item-units').on('keydown', '.work-item-units', workItemChange);
			jQuery(document).off('change', '.work-item-units').on('change', '.work-item-units', taskWorkItemUnitsChange);

			if(enableOwners) {
				jQuery(document).off('mouseover', 'i.owner-ind[owner-detail="on"]').on('mouseover', 'i.owner-ind[owner-detail="on"]', showOwner);
				jQuery(document).off('click', 'i.owner-ind[owner-detail="on"]').on('click', 'i.owner-ind[owner-detail="on"]', editWorkItemClick);
				jQuery(document).off('mouseleave', 'li.owner-on[node-id]').on('mouseleave', 'li.owner-on[node-id]', hideOwner);
			}
		
			initialisePlannerDragAndDrop();
			initialiseResourceSelector();
		}
		else
		{
			jQuery('li[data-target="task-work-items"]').hide();
		}
		
		//Assignments
		if(showAssignments)
		{
			jQuery('li[data-target="task-resources"]').show();

			var assignmentsBody = jQuery('#resource-assignments-body tbody').empty();
			var taskAssignments = taskRow.data('assignments');
			var added = {};
			if (taskAssignments == null) taskAssignments = {};
			
			jQuery.each(Object.keys(taskAssignments), function (i, key) {
				var arow = getTaskAssignmentRow(taskId, theActivityAssignments[key] ,taskAssignments[key]);
				arow.appendTo(assignmentsBody);
				added[key] = true;
			});
								
			jQuery.each(Object.keys(theActivityAssignments), function (i, key) {
				if (added[key] == true) return true;
				var arow = getTaskAssignmentRow(taskId, theActivityAssignments[key] ,null);
				arow.appendTo(assignmentsBody);
			});
		}
		else
		{
			jQuery('li[data-target="task-resources"]').hide();
		}
				
		//Predecessors
		if(showDependencies)
		{
			jQuery('li[data-target="task-predecessors"]').show();
			
			var predecessors = planPredecessors[taskId];
			var predecessorsBody = jQuery('#EditTaskContainer #predecessors-body tbody').empty();										
			if (predecessors != null)
			{
				jQuery.each(Object.keys(predecessors), function (i, key) {
					var arow = getPredecessorsHtml(taskId, predecessors[key]);
					arow.appendTo(predecessorsBody);
					arow.find('#predecessor-select').val(key);
					arow.find('#predecessor-type-select').val(predecessors[key].Type);								
				});
			}
			jQuery('#EditTaskContainer #predecessors-head').find('#addPredecessorButton').off('click');
			jQuery('#EditTaskContainer #predecessors-head').find('#addPredecessorButton').on('click', function(){
				var arow = getPredecessorsHtml(taskId, {});
				arow.appendTo(predecessorsBody);
				arow.find('#predecessor-select').val(null);
			});
		}
		else
		{
			jQuery('li[data-target="task-predecessors"]').hide();
		}
		
		//Advanced
		if(showAdvanced)
		{
			jQuery('li[data-target="task-advanced-details"]').show();

			var advancedPanel = jQuery('#edit-task-advanced');
			advancedPanel.find('#edit-constraint-type').val(task.ConstraintTypeId);
			advancedPanel.find('#edit-task-ignore-non-bus-days').prop('checked', task.IncludeNonBusinessDays);
			advancedPanel.find('#edit-task-visibility').val(task.VisibilityLevelId);
		}
		else
		{
			jQuery('li[data-target="task-advanced-details"]').hide();
		}		

		if(jQuery('li[data-target="task-details"]:visible').length && jQuery('li[data-target="task-advanced-details"]:visible').length)
		{
			var detailsPanel = jQuery('#edit-task');
			var advancedPanel = jQuery('#edit-task-advanced');
			
			detailsPanel.find('#edit-start-date-offset').off('change');
			detailsPanel.find('#edit-start-date-offset').on('change', function(event)
			{
				var planItemConstraintEnum = planItemConstraintIdToEnumMap[advancedPanel.find('#edit-constraint-type').val()];
				
				// if either the start or end date have changed that means we are forcing into either the :
				//	- Start No Earlier Than or 
				//	- Finish No Earlier Than constraint type. 		
				// i.e. it's a shortcut for entering the constraint date and changing the type - this is inline with MSProject
				// track this change before we process the mode
				// note we only do this if not manuallyscheduling
				if(planItemConstraintEnum != 'ManuallyScheduled' && planItemConstraintEnum != undefined && planItemConstraintEnum != '')
				{
					// new start date becomes the constraint date and mode switches
					planItemConstraintEnum = 'StartNoEarlierThan';
					advancedPanel.find('#edit-constraint-type').val(planItemConstraintEnumToIdMap[planItemConstraintEnum]);
				}
			});
		}

		jQuery.ionTabs.setTab("edit-tasks-group", tab);
		
		jQuery('#TaskOkButton').off('click');
		
		jQuery('#TaskOkButton').on('click' , function() {
			
			//Details
			if(jQuery('li[data-target="task-details"]:visible').length)
			{
				task.Name = detailsPanel.find('#edit-name').val();
				task.StartDateOffset = kimble.parseNumber(detailsPanel.find('#edit-start-date-offset').val(), '0.##');
				task.EndDateOffset = kimble.parseNumber(detailsPanel.find('#edit-end-date-offset').val(), '0.##');
				task.Effort = kimble.parseNumber(detailsPanel.find('#edit-effort').val(), '0.##');
				task.IsFixedEffort = detailsPanel.find('#edit-fixed').prop('checked');
				task.CalendarShowAsId = detailsPanel.find('#edit-calendar-show-as').val();
				task.TaskCategoryId = detailsPanel.find('#edit-catgeory').val();
				task.StartTime = detailsPanel.find('#edit-start-time').val();
				task.EndTime = detailsPanel.find('#edit-end-time').val();
			}

			// work items
			if(jQuery('li[data-target="task-work-items"]:visible').length)
			{
				var workItemContainer = jQuery('#task-work-items-container');
				task.WorkItems = getTaskWorkItems(workItemContainer);
			}			

			//Assignments
			if(jQuery('li[data-target="task-resources"]:visible').length)
			{
				task.Assignments = {};
				
				jQuery.each(jQuery('#resource-assignments-body tbody tr td input:checked'), function (i, inp) {
					
					var assignmentRow = jQuery(inp).closest('tr');
					var taskAssignment = {ActivityAssignmentId:assignmentRow.prop('id'), BaselineEffort:0};
					taskAssignment.BaselineEffort = (kimble.parseNumber(assignmentRow.find('#baselineEffort').val(), '0.##') != null ? kimble.parseNumber(assignmentRow.find('#baselineEffort').val(), '0.##') : '0.00' );
					task.Assignments[assignmentRow.prop('id')] = taskAssignment;
				});
			}

			//Predecessors
			if(jQuery('li[data-target="task-predecessors"]:visible').length)
			{
				planPredecessors[taskId] = {};
				
				jQuery.each(jQuery('#EditTaskContainer #predecessors-body tbody tr'), function (i, row) {
					var r = jQuery(row);
					var taskPredecessor = {PlanItemId:r.find('#predecessor-select').val(), Type:r.find('#predecessor-type-select').val()};
					if (taskPredecessor.PlanItemId == null) return true;					
					taskPredecessor.TaskId = taskPredecessor.PlanItemId;
					taskPredecessor.Lag = (r.find('#predecessor-lag-input').val() == 'undefined' ? null : kimble.parseNumber(r.find('#predecessor-lag-input').val(), '0.##')); 
					planPredecessors[taskId][taskPredecessor.PlanItemId] = taskPredecessor;
					
					// we must also add the parent to the taskSuccessor array
					var taskSuccessor = {PlanItemId:r.find('#predecessor-select').val(), Type:r.find('#predecessor-type-select').val(), Lag:(r.find('#predecessor-lag-input').val() == 'undefined' ? 0 : kimble.parseNumber(r.find('#predecessor-lag-input').val(), '0.##'))};
					if (taskSuccessor.PlanItemId == null) return true;
					taskSuccessor.TaskId = taskId;
					if(planSuccessors[taskSuccessor.PlanItemId] == undefined) planSuccessors[taskSuccessor.PlanItemId] = {};
					planSuccessors[taskSuccessor.PlanItemId][taskId] = taskSuccessor;
				});
				
				// remove any deleted predecessors from the planSuccessors collection
				jQuery.each(jQuery('#EditTaskContainer #predecessors-body tbody tr.deleted-predecessor'), function (i, row) {
					var r = jQuery(row);
					// we must also add the parent to the taskSuccessor array
					var taskSuccessor = {PlanItemId:r.find('#predecessor-select').val(), Type:r.find('#predecessor-type-select').val()};
					if (taskSuccessor.PlanItemId == null) return true;
					
					taskSuccessor.TaskId = taskId;
					if(planSuccessors[taskSuccessor.PlanItemId] != undefined)
					{
						delete planSuccessors[taskSuccessor.PlanItemId][taskId];
					}
				});
			}
			
			//Advanced
			if(jQuery('li[data-target="task-advanced-details"]:visible').length)
			{
				task.ConstraintTypeId = advancedPanel.find('#edit-constraint-type').val();
				
				//asap and alap should override the offset
				if(planItemConstraintIdToEnumMap[task.ConstraintTypeId] == 'AsSoonAsPossible'
					|| planItemConstraintIdToEnumMap[task.ConstraintTypeId] == 'AsLateAsPossible')
				{
					// TODO125: we shouldn't be using this as a general offset, instead introduce constraint offset?
					task.StartDateOffset = null;
				}
				
				task.IncludeNonBusinessDays = advancedPanel.find('#edit-task-ignore-non-bus-days').prop('checked');
				
				task.VisibilityLevelId = advancedPanel.find('#edit-task-visibility').val();
			}
							
			taskRow.replaceWith(getPlanItemHtml(task));
			
			if (taskRow.attr('parent-node-id') != '')
			{
				updateItemDates(jQuery('[node-id="' + taskRow.attr('parent-node-id') + '"]'));
				updateTaskEffort(jQuery('[node-id="' + taskRow.attr('parent-node-id') + '"]'));
			}
			
			planChanged();
			
			refreshDependencies();
			
			hideModalBoxy();
		
		});
		
		jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i' });
		
		showModalBoxy();
	}
	
	function updateTaskEffort(task)
	{
		var baselineEffort = 0;
		
		jQuery.each(jQuery('[parent-node-id="' + task.attr('node-id') + '"]'), function (i, child) {
			baselineEffort += jQuery(child).find('.baselineEffort').parseNumber({format:"0.##", locale:kimble.locale}).valueOf();
		});
		
		task.find('.baselineEffort').text(jQuery.formatNumber(baselineEffort, {format: "0.##", locale:kimble.locale, isFullLocale:false}));
		
		if (task.attr('parent-node-id') != null)
			updateTaskEffort(jQuery('[node-id="' + task.attr('parent-node-id') + '"]'));
	}
	
	function getTaskAssignmentRow(taskId, assignment, task)
	{
		var tr = '<tr style="height: 34px;" task-id="' + taskId + '" id="' + assignment.Id + '">';
		tr += '<td><input class="checkbox" type="checkbox" ' + (task != null ? 'checked' : '' ) + ' ' + (task != null && (task.BaselineEffort > 0 || task.ExpendedEffort > 0) ? 'disabled' : '' ) + '/></td>';
		
		tr += '<td>' + assignment.ResourceName + '<br/> ' + kimble.replaceNull(assignment.RoleName, '') + '</td>';
		
		tr += '<td style="text-align: center;"><input id="baselineEffort" type="text" class="input-effort" style="display:' + (task == null ? 'none' : '' ) + '" value="' + (task != null && task.BaselineEffort != null ? jQuery.formatNumber(task.BaselineEffort, {format: "0.##", locale:kimble.locale, isFullLocale:false}) : '') + '"/></td>';	
		
		tr += '</tr>';
		
		var row = jQuery(tr);
		
		row.find('.checkbox').change(function(e){
			//add / remove task assignment from task data
			
			var inp = jQuery(this);
			var task = inp.closest('tr');
			
			if (inp.prop('checked'))
			{
				task.find('.input-effort').show();
			}
			else
			{
				task.find('.input-effort').hide().val('');
			}
			
		});
		
		return row;
	}
	
	function refreshPlanItemRowFormatting(planItemRow)
	{
		traceAction('Refreshing Plan Item Row Format: ' + planItemRow.attr('node-id'));
		
		// refresh the constraint indicator on the row
		var planItem = getGridPlanItemObject(planItemRow);
		jQuery(planItemRow).find('.constraint-ind').replaceWith(getConstraintHtml(planItemRow.attr('constrainttypeid'), planItem.IncludeNonBusinessDays));
		
		if (!planItem.IsSummary)
		{
			if(planItem.TypeEnum == 'Task')
			{
				jQuery(planItemRow).find('.constraint-ind').click(function () {
					initialiseEditTaskPopup(planItem.Id, 'task-advanced-details');
				});
			}
			else if(planItem.TypeEnum == 'Milestone')
			{
				jQuery(planItemRow).find('.constraint-ind').click(function () {
					initialiseEditMilestonePopup(planItem.Id, 'milestone-advanced-details');
				});			
			}
		}
	}
			
	function getPredecessors(predecessors)
	{
		var a = [];
		
		jQuery.each(Object.keys(predecessors), function (i, key) {
			var typeSummary = '';
			
			switch (predecessors[key].Type)
			{
				case 'FinishStart':
					// default so we don't highlight
				break;
				case 'StartStart':
					typeSummary = 'SS';
				break;
				case 'FinishFinish':
					typeSummary = 'FF';
				break;
				case 'StartFinish':
					typeSummary = 'SF';
				break;
			}			
			a.push((jQuery('[node-id="' + key + '"]').index() + 1) + typeSummary);
		});
		
		return a.join('; ');
	}
	
	function getPredecessorsHtml(planItemId, predecessor)
	{
		var tr = '<tr><td><a class="toolbar-button" href="#" id="deletePredecessorButton" style="padding: 3px 7px 3px 7px;" ><i class="fa fa-trash-o"></i></a></td>';
		
		tr += '<td><select style="width:175px;white-space:nowrap;" id="predecessor-select">';
		
		jQuery.each(jQuery('.tree-node:not(".branch"):not([node-id="' + planItemId + '"])'), function (i, n) {
			var node = jQuery(n);
			// don't allow a task to be selected if if would create a cyclic dependency
			if(!createsCircularDependency(node.attr('node-id'), [planItemId]))
			{
				tr += '<option value="' + node.attr('node-id') + '">' + (node.index() + 1) +  ' : ' + getItemName(node) + '</option>';
			}
		});
		
		tr += '</select></td>';
		
		tr += '<td><select id="predecessor-type-select">';
		tr += '<option value="FinishStart">{!$Label.Finish} -&gt; {!$Label.Start}</option>';
		tr += '<option value="StartStart">{!$Label.Start} -&gt; {!$Label.Start}</option>';
		tr += '<option value="FinishFinish">{!$Label.Finish} -&gt; {!$Label.Finish}</option>';
		tr += '<option value="StartFinish">{!$Label.Start} -&gt; {!$Label.Finish}</option>';
		tr += '</td>';

		tr += '<td><input style="width: 50px;" id="predecessor-lag-input" value="' + (predecessor.Lag == undefined ? '' : safeFormatNumber(kimble.replaceNull(predecessor.Lag,''))) + '">';
		tr += '</td>';
		
		tr += '</tr>';
		
		var row = jQuery(tr)
		
		row.find('#deletePredecessorButton').click(function () {
			jQuery(this).closest('tr').remove();
		});
		
		return row;
	}
	
	function initialiseEditMilestonePopup(milestoneId, tab)
	{
