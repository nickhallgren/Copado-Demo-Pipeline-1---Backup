			if(e.keyCode == 38)
			{
				// up arrow - add a day
				var theValue = kimble.parseNumber(jQuery(this).val(), '0.##');
				jQuery(this).val(theValue + 1).change();
			}
			if(e.keyCode == 40) 
			{
				// down arrow - remove a day
				var theValue = kimble.parseNumber(jQuery(this).val(), '0.##');
				jQuery(this).val(theValue - 1).change();
			}
		});
		
		row.find('.itemName input').keydown(function(e){
			// enter in the task name should create a new task if we are entering a new task
			if(jQuery(this).closest('tr').hasClass('new') && jQuery(this).closest('tr').hasClass('Task') && e.keyCode == 13)
			{
				e.preventDefault();
				e.stopPropagation();
				
				if(jQuery(this).closest('tr').hasClass('Iteration'))
				{
					addIterationClick(jQuery(this).closest('tr'));
				}
				else
				{
					addTaskClick(jQuery(this).closest('tr'));
				}
			}
		});
		
		row.find('.duration input.task-inline-input').keydown(function(e){
			// tab out of the end date should create a new task if we are entering a new task
			if(jQuery(this).closest('tr').hasClass('new') && jQuery(this).closest('tr').hasClass('Task') && e.keyCode == 9)
			{
				e.preventDefault();
				e.stopPropagation();
				addTaskClick(jQuery(this).closest('tr'));
			}
		});
		
		row.find('.dateOffset input.task-inline-input').keyup(function(e){
			if(e.keyCode == 38)
			{
				// up arrow - add a day
				var entryDate = kimble.parseDate(jQuery(this).val(), false);
				var ignoreNBD = jQuery(this).closest('tr').find('.ignore-non-bus-days input').prop('checked');
				
				jQuery(this).val(kimble.formatDate(calculateNextDate(ignoreNBD, entryDate))).change();
			}
			if(e.keyCode == 40) 
			{
				// down arrow - remove a day
				// up arrow - add a day
				var entryDate = kimble.parseDate(jQuery(this).val(), false);
				var ignoreNBD = jQuery(this).closest('tr').find('.ignore-non-bus-days input').prop('checked');
				
				jQuery(this).val(kimble.formatDate(calculatePreviousDate(ignoreNBD, entryDate))).change();
			}
		});
	
		row.find('.task-inline-input').change(function(event)
		{		
			// get a handle on the changed row
			var planItemRow = jQuery(this).closest('tr');
			var planItem = getGridPlanItemObject(planItemRow);
	
			var planItemConstraintEnum = planItemConstraintIdToEnumMap[planItemRow.attr('constrainttypeid')];
				
			if(planItemConstraintEnum != 'ManuallyScheduled')
			{
				if(jQuery(event.target).parent().hasClass('dateOffset'))
				{
					planItemConstraintEnum = 'StartNoEarlierThan';
					planItemRow.attr('constrainttypeid', planItemConstraintEnumToIdMap[planItemConstraintEnum]);
					
				}
			}

			refreshPlanItemRowFormatting(planItemRow);
		});

		if (!planItem.IsSummary && planItem.TypeEnum == 'Task')
		{
			row.find('.constraint-ind').click(function () {
				initialiseEditTaskPopup(planItem.Id, 'task-advanced-details');
			});
			
			row.find('.position-num, .category').click(function () {
				initialiseEditTaskPopup(planItem.Id, 'task-details');
			});
			
			row.find('.itemName input').dblclick(function() {
				initialiseEditTaskPopup(planItem.Id, 'task-details');
			});
			
			row.find('.assignedResources').click(function () {
				initialiseEditTaskPopup(planItem.Id, 'task-resources');
			});
			
			row.find('.predecessors').click(function () {
				initialiseEditTaskPopup(planItem.Id, 'task-predecessors');
			});
		}
		
		if(planItem.TypeEnum == 'Milestone')
		{
			row.find('.constraint-ind').click(function () {
				initialiseEditMilestonePopup(planItem.Id, 'milestone-advanced-details');
			});
			
			row.find('.itemName').dblclick(function() {
				initialiseEditMilestonePopup(planItem.Id, 'milestone-details');
			});
			
			row.find('.position-num').click(function () {
				initialiseEditMilestonePopup(planItem.Id, 'milestone-details');
			});
			
			row.find('.predecessors').click(function () {
				initialiseEditMilestonePopup(planItem.Id, 'milestone-predecessors');
			});
		}
		
		return row;		
	}	

	function getConstraintHtml(constraintType, ignoreNBD)
	{		
		var constraintHtml = '';
		var titleText = planItemConstraintIdToNameMap[constraintType];
		var constraintIndClass = 'constraint-ind';
	
		var calendarIcon = (ignoreNBD ? 'fa-calendar-o' : 'fa-calendar');
		
		if(planItemConstraintIdToEnumMap[constraintType] == 'AsSoonAsPossible'
			|| planItemConstraintIdToEnumMap[constraintType] == 'AsLateAsPossible')
		{
			constraintIndClass += ' ' + calendarIcon;
		}
		else if(planItemConstraintIdToEnumMap[constraintType] == 'ManuallyScheduled'
			|| constraintType == undefined)
		{
			constraintIndClass += ' fa-thumb-tack fixed-constraint';
		}
		else if(planItemConstraintIdToEnumMap[constraintType] == 'MustStartOn' 
			|| planItemConstraintIdToEnumMap[constraintType] == 'StartNoEarlierThan'
			|| planItemConstraintIdToEnumMap[constraintType] == 'StartNoLaterThan'
			|| planItemConstraintIdToEnumMap[constraintType] == 'MustFinishOn'
			|| planItemConstraintIdToEnumMap[constraintType] == 'FinishNoEarlierThan'
			|| planItemConstraintIdToEnumMap[constraintType] == 'FinishNoLaterThan')
		{
			constraintIndClass += ' ' + calendarIcon + ' fixed-constraint';
		}
		
		if(ignoreNBD) titleText += ' (' + kimble.labels['ignore-nbd'] + ')';
		
		constraintHtml += '<span class="fa ' + constraintIndClass + '" title="' + titleText + ' "/>';
		
		return constraintHtml;
	}

	function initialiseGridDragAndDrop()
	{
		jQuery('.ui-draggable').draggable('destroy');
		
		jQuery('.draggable').draggable({
					revert:'invalid', 
					helper: function( event ) {
						return jQuery('<div class="task-dragging">' + jQuery(this).text() + ' : ' + getItemName(jQuery(this).closest('tr')) + '</div>');
		  			},
					scroll:true,
					appendTo:'#draggable-container'});
		
		jQuery('.ui-droppable').droppable('destroy');
	
		jQuery('#template-tasks>tbody>tr:not(.backlog-row)').droppable({
					hoverClass: 'tree-node-drop', 
					accept: function(draggable) {
						  	var draggableRow = draggable.closest('tr');
							var thisRow = jQuery(this);
							
							if(!draggableRow.hasClass('tree-node')) return false;
							
							if (draggableRow.attr('node-id') == thisRow.attr('node-id')) return false;
							
							if (draggableRow.next().attr('node-id') == thisRow.attr('node-id')) return false;
							
							return true;
						  },
					drop: function(event, ui) {
						
						var rowToMove = ui.draggable.closest('tr');
						
						var previousParentId = rowToMove.attr('parent-node-id');
						
						moveItemBefore(rowToMove, jQuery(this));
						
						var previousRow = rowToMove.prevAll(':visible:first');
						
						if (previousRow.length == 0) 
						{
							rowToMove.attr('parent-node-id','');
							setLevel(rowToMove, 0);						
						}
						else
						{
							rowToMove.attr('parent-node-id', previousRow.attr('parent-node-id'));
							
							if (previousRow.hasClass('branch') && previousRow.hasClass('expanded')) //make me a child
							{
								rowToMove.attr('parent-node-id', previousRow.attr('node-id'));
								setLevel(rowToMove, (new Number (previousRow.attr('level')) + 1).valueOf());
							}
							else // make me a sibling
							{
								rowToMove.attr('parent-node-id', previousRow.attr('parent-node-id'));
								if (rowToMove.attr('level') !=  previousRow.attr('level')) setLevel(rowToMove, previousRow.attr('level'));
							}
							
							//refresh previous parent (may no longer be a parent)
							if (previousParentId != '' && jQuery('[parent-node-id="' + previousParentId + '"]').length == 0)
								jQuery('[node-id="' + previousParentId + '"]').removeClass('branch');						
						}
						
						updateSequences();
						
						planChanged();
						
						jQuery('.tree-node-drop').removeClass('tree-node-drop');
					}
				});
	}	

