			var theWorkItem = jQuery(this);

			var workItemName = (theWorkItem.find('.work-item-name').val() != undefined && theWorkItem.find('.work-item-name').val() != '' ? theWorkItem.find('.work-item-name').val() : l['NewWorkItemUnnamed']);
			if(theWorkItemUnitType != '') var workItemRemainingUnits = (theWorkItem.find('.work-item-units').val() != undefined && theWorkItem.find('.work-item-units').val() != '' ? kimble.parseNumber(theWorkItem.find('.work-item-units').val()) : 0);

			var theWorkItemObject = {Name: workItemName, Status: theWorkItem.attr('item-status'), ProductId: productId};
			
			if(theWorkItemUnitType != '') theWorkItemObject.RemainingUnits = workItemRemainingUnits;
			if(enableOwners && theWorkItem.find('.owner-selector-input').find('span').text() != l['None']) {theWorkItemObject.ActivityAssignmentTemplateId = planResources.filter(function(x){return x.text == theWorkItem.find('.owner-selector-input').find('span').text()})[0].id;}
			
			theWorkItemObject.TaskTemplateId = theWorkItem.attr('parent-node-id');
			if(!theWorkItem.hasClass('new')) theWorkItemObject.WorkItemTemplateId = theWorkItem.attr('node-id');
			theWorkItemObject.IsNew = theWorkItem.hasClass('new');
			theWorkItemObject.Position = index + 1; 
			
			theWorkItems.push(theWorkItemObject);
		});
		
		return theWorkItems;
	}
		
	function getPlanItemWorkItems(planItem)
	{
		var theWorkItems = [];
		
		jQuery(planItem).find('.work-items li:not(.deleted)').each(function(index) {
			var theWorkItem = jQuery(this);

			var workItemName = (theWorkItem.find('.work-item-name').val() != undefined && theWorkItem.find('.work-item-name').val() != '' ? theWorkItem.find('.work-item-name').val() :l['NewWorkItemUnnamed']);
			if(theWorkItemUnitType != '') var workItemRemainingUnits = (theWorkItem.find('.work-item-units').val() != undefined && theWorkItem.find('.work-item-units').val() != '' ? kimble.parseNumber(theWorkItem.find('.work-item-units').val()) : 0);
			
			var theWorkItemObject = {Name: workItemName, Status: theWorkItem.attr('item-status'), ProductId: productId};
			
			if(theWorkItemUnitType != '') theWorkItemObject.RemainingUnits = workItemRemainingUnits;
			if(enableOwners && theWorkItem.find('.owner-selector-input').find('span').text() != l['None']) {theWorkItemObject.ActivityAssignmentTemplateId = planResources.filter(function(x){return x.text == theWorkItem.find('.owner-selector-input').find('span').text()})[0].id;}
			
			if(!theWorkItem.closest('.iteration-container').hasClass('backlog')) theWorkItemObject.TaskTemplateId = theWorkItem.attr('parent-node-id');
			if(!theWorkItem.hasClass('new')) theWorkItemObject.WorkItemTemplateId = theWorkItem.attr('node-id');
			theWorkItemObject.IsNew = theWorkItem.hasClass('new');
			theWorkItemObject.Position = index + 1; 
			
			theWorkItems.push(theWorkItemObject);
		});
		
		return theWorkItems;
	}
	
	function workItemChange(e)
	{
		// enter to create a new work item
		if(jQuery(this).parent('.work-item').hasClass('new') && e.keyCode == 13)
		{
			e.preventDefault();
			e.stopPropagation();
			jQuery('.last-added').removeClass('last-added');
			
			//TDOD127 consolidate
			if(jQuery(this).closest('.work-items').hasClass('task-work-items'))
			{
				addTaskWorkItemClick(e, jQuery(this).closest('.work-item'));
			}
			else
			{
				addWorkItemClick(e, jQuery(this).closest('.work-item'));
			}
		}
		if(!jQuery(this).parent('.work-item').hasClass('new') && e.keyCode == 13)
		{
			e.preventDefault();
			e.stopPropagation();
		}
		else if(jQuery(this).hasClass('work-item-name'))
		{
			jQuery(this).height(1);
			var totalHeight = jQuery(this).prop('scrollHeight') - parseInt(jQuery(this).css('padding-top')) - parseInt(jQuery(this).css('padding-bottom'));
			jQuery(this).height(totalHeight);
		}
	}
	
	function showOwner()
	{
		var theNode = jQuery(this).closest('li[node-id]');
		if(!jQuery('.task-list-container').hasClass('drag-active') && !theNode.find('.wi-add-details').hasClass('detail-edit-mode'))
		{	
			theNode.addClass('owner-on');
			theNode.find('.ti-owner-details').slideDown();
		}
	}
	
	function hideOwner()
	{
		var theNode = jQuery(this).closest('li[node-id]');
		theNode.removeClass('owner-on');
		theNode.find('.ti-owner-details').slideUp();
	}
	
	function iterationNameChange()
	{
		jQuery(this).closest('.iteration-container').data('planItem').Name = jQuery(this).val();
		planChanged();
	}

	function workItemUnitsChange(e)
	{
		calculateIterationUnitsTotal(jQuery(this).closest('.iteration-container'));
		planChanged();
	}
	
	function taskWorkItemUnitsChange(e)
	{
		calculateTaskUnitsTotal(jQuery('#task-work-items-container'));
		planChanged();
	}

	function itemNameChange(e)
	{
		var planItem = jQuery(this).closest('tr');
		
		var newName = planItem.find('.itemName input').val();

		planItem.find('.itemName').prop('title', newName);

		var obj = planItem.data('planItem');

		if (newName != obj.Name) planChanged();
	}

	function startDateOffsetChange(e)
	{
		var planItem = jQuery(this).closest('tr');
		
		var newVal = planItem.find('.startDateOffset input').val();

		var obj = planItem.data('planItem');

		if (newVal != obj.StartDateOffset) planChanged();
	}
	
	function endDateOffsetChange(e)
	{
		var planItem = jQuery(this).closest('tr');
		
		var newVal = planItem.find('.endDateOffset input').val();
		var obj = planItem.data('planItem');
		
		if (newVal != obj.EndDateOffset) planChanged();
	}
	
	function planChanged()
	{
		jQuery(window).off('.has-changes').on('beforeunload.has-changes', function(){
			return "{!$Label.UnsavedChangesHeading}" + "\n\n" + "{!$Label.UnsavedChangesMessage}";
		});

		jQuery('.effort-units-col').toggleClass('hidden-item', jQuery('.template-effort-insight-ind:not(.hidden-item)').length == 0);

		jQuery('#saveButton').addClass('has-changes');
	}
	
	function toggleTreeNode(e)
	{
		var row = jQuery(this).closest('tr');
		
		if (!(row.hasClass('branch') || row.hasClass('Iteration'))) return;
		
		if (row.hasClass('expanded'))
		{
			//remove class expanded and hide all my children and grandchildren
			row.removeClass('expanded');
			hideNode(row);
		}
		else
		{
			row.addClass('expanded');
			showNode(row);
		}
		
	}
	
	function refreshDependencies()
	{
		jQuery.each(Object.keys(planPredecessors), function (i, successor) {
		    
		    var lagText = '';
		    
		    if(Object.keys(planPredecessors[successor]).length)
		    {
				lagText = planPredecessors[successor][Object.keys(planPredecessors[successor])[Object.keys(planPredecessors[successor]).length - 1]].Lag;
				var daysLabel = '<apex:outputText value="{!$Label.kimbleone__daysheading}"/>';	
						
				if(lagText != undefined && lagText != 0)
				{
					if(lagText > 0) lagText = ' +' + safeFormatNumber(kimble.replaceNull(lagText,'')) + ' ' + daysLabel;
					else if(lagText < 0) lagText = ' ' + safeFormatNumber(kimble.replaceNull(lagText,'')) + ' ' + daysLabel;
				}
				else if (lagText == 0 || lagText == null || lagText == undefined)
				{
					lagText = '';
				}
      		}
        	
		    jQuery('[node-id="' + successor + '"]').find('.predecessors').text(getPredecessors(planPredecessors[successor]) + lagText);
		});
	}
	
	function showNode(node)
	{
		jQuery.each(jQuery('[parent-node-id="' + node.attr('node-id') + '"]'), function (i, child) {
			var childNode = jQuery(child);
			childNode.show();
			if (childNode.hasClass('expanded'))
				showNode(childNode);
		});
		
		jQuery(window).resize();
	}
	
	function hideNode(node)
	{
		jQuery.each(jQuery('[parent-node-id="' + node.attr('node-id') + '"]'), function (i, child) {
			var childNode = jQuery(child);
			childNode.hide();
			hideNode(childNode);
		});
		
		jQuery(window).resize();
	}

	function getOffsetValue(offsetAttrVal)
	{
		return parseFloat(offsetAttrVal);
	}	

	function getItemName(item)
	{
		if (item.find('.itemName input').length == 1)
			return item.find('.itemName input').val();
		else
			return item.find('.itemName').text();
	}
	
   	function getInitials(taskAssignments)
	{
		var initials = '';
		jQuery.each(Object.keys(taskAssignments), function (i, key) {
			if (i > 0) initials += ', ';
			
			jQuery.each(theActivityAssignments[key].ResourceName.split(' '), function (j, s) {
				initials += s.substring(0,1);
			});
			
		});
		return initials;
	}

	function getUniqueId()
	{
		  // Math.random should be unique because of its seeding algorithm.
		  // Convert it to base 36 (numbers + letters), and grab the first 9 characters
		  // after the decimal.
		  return '__' + Math.random().toString(36).substr(2, 9);
	}

	function safeFormatNumber(originalValue)
	{
		var returnVal = originalValue;
		
		if(originalValue != null && originalValue != undefined && originalValue != '')
			returnVal = jQuery.formatNumber(originalValue, {format: "0.##", locale:kimble.locale, isFullLocale:false});
		
		return returnVal;
	}
	
	function formatNumberNat2DP(theVal)
	{
		var formattedVal = '0';
		if(theVal != undefined && theVal != '') formattedVal = theVal;
		formattedVal = kimble.formatNumber(formattedVal, "#.##");
		
		return (formattedVal != undefined && formattedVal != '' ? formattedVal : '0'); 
	}
	
   	function sortPlanItems(source)
	{
		return function(a, b) {
			var posA = source[a]['Position'];
			if (posA == null) return 1;
			
			var posB = source[b]['Position'];
			if (posB == null) return -1;
			
			return posA - posB;
		}
	}
	
	function getPlan()
	{
		togglePageWorking(true);

		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TaskTemplatesController.GetTemplatePlan}',
				productId,
				function(result, event)
				{
					if (event.status) 
					{
						planItems = result.ThePlanItems;
						planWorkItems = result.ThePlanWorkItems;
						planPredecessors = result.ThePlanPredecessors;
						planSuccessors = result.ThePlanSuccessors;

						deletedItems = {};

						jQuery(window).off('.has-changes');

						refreshPlan();
					} 
					else if (event.type === 'exception') 
					{
						alert(event.message);
					} 
					else 
					{
						alert(event.message);
					}
					togglePageWorking(false);
			}, 
			{escape: true, timeout: 60000}
		);
	}

	function savePlan()
	{	   
		togglePageWorking(true);

		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TaskTemplatesController.SaveTemplatePlan}',
				productId, planWorkItems, planItems, planPredecessors, deletedItems,
				function(result, event){		  
					if (event.status) 
					{
						planItems = result.ThePlanItems;
						planWorkItems = result.ThePlanWorkItems;
						planPredecessors = result.ThePlanPredecessors;
						planSuccessors = result.ThePlanSuccessors;

						deletedItems = {};

						jQuery(window).off('.has-changes');
						jQuery('#saveButton').removeClass('has-changes');

						refreshPlan();														  
					} 
					else if (event.type === 'exception') 
					{
						alert(event.message);
					} 
					else 
					{
						alert(event.message);
					}
					togglePageWorking(false);
			}, 
			{escape: true, timeout: 60000}
		);
	}
	
	function toggleWorking(selector)
	{
		jQuery(selector).find('i').toggleClass('fa-link').toggleClass('fa-circle-o-notch fa-spin');
	}

	function togglePageWorking(working)
	{
		jQuery('#data-loading').toggle(working);
		jQuery('#toolbar-buttons>a').toggleClass('disabled', working);
	}
	
	var inlineTaskTemplateEffortInsightLabel = '<apex:outputText value="{!$Label.kimbleone__tasktemplateeffortinsightnarrative}"/>';

	var templateInsights = {};

	function initialiseInsights()
	{
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TaskTemplatesController.GetTaskTemplateInsights}',
				'<apex:outputText value="{!KimbleOne__Product__c}"/>',
				function(result, event){
					if (event.status)
					{
						templateInsights = result;

						overlayInsights();
					}
					else if (event.type === 'exception')
					{
						alert(event.message);
					}
					else
					{
						alert(event.message);
					}
			},
			{escape: true, timeout: 60000}
		);
	}

	function overlayInsights()
	{
		if(Object.keys(templateInsights).length > 0)
		{
			jQuery('.template-effort-insight-ind').each(function () {
				refreshTemplateEffortInsight(jQuery(this));
			});

			jQuery('.effort-units-col').toggleClass('hidden-item', jQuery('.template-effort-insight-ind:not(.hidden-item)').length == 0);
		}
	}

	function formatNumericValue(theValue, dispFormat)
	{
		theValue = (theValue == undefined || theValue == null || theValue == '' ? '0' : theValue);

		return kimble.formatNumber(theValue, (dispFormat == undefined ? '#,##0' : dispFormat));
	}

	function refreshTemplateEffortInsight(obj)
	{
		var templateId = obj.attr('tsk-t-id');
		var theInsightInd = jQuery('.template-effort-insight-ind[tsk-t-id="' + templateId + '"');
		var theAvgUnitsDisp = jQuery('.template-avg-effort[tsk-t-id="' + templateId + '"');

		if(templateInsights != undefined && templateInsights[templateId] != undefined)
		{
			var theInsight = templateInsights[templateId];
			var instanceCountDisplay = formatNumericValue(theInsight.InstanceCount);
			var avgEffort = formatNumericValue(theInsight.AvgEffort, '#,##0.00');
			var minEffort = formatNumericValue(theInsight.MinEffort, '#,##0.##');
			var maxEffort = formatNumericValue(theInsight.MaxEffort, '#,##0.##');

			var theTooltip = inlineTaskTemplateEffortInsightLabel.format(instanceCountDisplay, avgEffort, minEffort, maxEffort);
			theInsightInd.attr('title', theTooltip);
			theInsightInd.qtip('destroy', true);
			theInsightInd.qtip({
				position: {
					adjust: { method: 'flip flip'},
					viewport: $(window)
				},
				style: {
					classes: 'template-effort-insight-qtip qtip-light qtip-shadow qtip-rounded'
				}
			});
			theInsightInd.removeClass('hidden-item');
			theInsightInd.fadeOut(500).fadeIn(500);
			theAvgUnitsDisp.text(avgEffort).removeClass('hidden-item');
		}
		else
		{
			theInsightInd.addClass('hidden-item');
			theAvgUnitsDisp.removeClass('hidden-item').text('-');
		}
	}

</script>


