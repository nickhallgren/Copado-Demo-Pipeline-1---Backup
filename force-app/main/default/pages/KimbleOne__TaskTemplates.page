		jQuery.each(selectedItem, function (i, thePlanItemRow)
		{
			outdent(jQuery(thePlanItemRow));
		});
		
		refreshDependencies();
	
		toggleWorking('#outdentButton');
	}
	
	function outdent(item)
	{
		//decrement my level and make my parent my grandparent
		var parentItem = jQuery('[node-id="' + item.attr('parent-node-id') + '"]');
		
		if (parentItem.length == 0) return;
		
		item.attr('parent-node-id', parentItem.attr('parent-node-id'));
		
		if(!parentItem.hasClass('Iteration'))
		{
			if (jQuery('[parent-node-id="' + parentItem.attr('node-id') + '"]').length == 0)
				parentItem.removeClass('branch');
			else
				parentItem.addClass('branch').addClass('expanded');
			
			updateItemDates(parentItem);
		}
		
		setLevel(item, new Number(item.attr('level')) - 1);
		
		//move all other siblings (and their children) above me
		var siblings = jQuery('[parent-node-id="' + parentItem.attr('node-id') + '"]');
		
		jQuery.each(siblings, function (i, sibling)
		{
			//move me and my children
			moveItemBefore(jQuery(sibling), item);
		});
		
		updateSequences();
		
		planChanged();
	}
	
	function moveItemBefore(taskToMove, beforeTask)
	{
		taskToMove.insertBefore(beforeTask);
		
		jQuery.each(jQuery('[parent-node-id="' + taskToMove.attr('node-id') + '"]'), function (i, child)
		{
			moveItemBefore(jQuery(child), beforeTask);
		});
	}
	
	function getSelectedItem()
	{
		return jQuery('tr.selected');
	}
	
	function setLevel(item, level)
	{
		item.attr('level',level);
		
		jQuery.each(jQuery('[parent-node-id="' + item.attr('node-id') + '"]'), function (i, child) {
			setLevel(jQuery(child), new Number(level).valueOf() + 1);
		});
	}
	
	function updateSequences()
	{
		jQuery.each(jQuery('span.position-num'), function (i, pos) {
			var p = jQuery(pos);
			p.text(p.parent().parent().index() + 1);
		});
	}			

