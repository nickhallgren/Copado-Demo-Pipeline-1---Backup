<apex:page standardController="KimbleOne__Product__c" extensions="KimbleOne.TaskTemplatesController" sidebar="false">

<apex:composition template="KimbleOne__SiteMaster">

<apex:define name="Menu"> 
	<c:Menu MenuContextType="ProductDefinition" MenuContextId="{!KimbleOne__Product__c.Id}" MenuContextName="{!KimbleOne__Product__c.Name}"/>
</apex:define>

<apex:define name="Content">
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.min.js')}"/>
	<apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQueryTimePicker, 'jquery.timepicker.css')}"/>	
	<apex:includeScript value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'js/jquery.select2.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.KimbleOne__JQuerySelect2, 'css/jquery.select2.css')}"/>

<div class="work-item-templates-container">
	<div id="data-loading"><i class="fa fa-circle-o-notch fa-spin"></i></div>

	<div class="toolbar-container">
		<div class="toolbar">
			<div id="toolbar-buttons">
				<a class="toolbar-button grid-view-btn button-left addTaskButton" title="{!$Label.Add} {!$ObjectType.Task__c.Label}" href="#"><i class="fa fa-plus"></i></a><a data-floating-dropdown="#add-button-floating-dropdown" class="toolbar-button grid-view-btn button-right addButton" title="{!$Label.Add}" href="#"><i class="fa fa-caret-down"></i></a>
				<a id="deleteTaskButton" title="{!$Label.Delete}" class="grid-view-btn toolbar-button prevent-for-milestone" href="#"><i class="fa fa-trash-o"></i></a>
				<a id="outdentButton" title="{!$Label.Outdent}" class="grid-view-btn toolbar-button button-left prevent-for-milestone" href="#" ><i class="fa fa-outdent"></i></a><a id="indentButton" title="{!$Label.Indent}" class="toolbar-button grid-view-btn prevent-for-milestone button-right" href="#"><i class="fa fa-indent"></i></a>
				<a id="linkItemsButton" title="{!$Label.LinkItemsMessage}" class="grid-view-btn toolbar-button button-left" href="#"><i class="fa fa-link"></i></a><a id="unlinkItemsButton" title="{!$Label.UnLinkItems}" class="toolbar-button grid-view-btn button-right" href="#"><i class="fa fa-chain-broken"></i></a>
				<a id="saveButton" title="{!$Label.Save}" class="toolbar-button" href="#"><i class="fa fa-save"></i></a>
				<apex:outputPanel layout="none" rendered="{!ShowPlanner}">
				<a id="plannerButton" title="Planner View" class="toolbar-button button-right" href="#"><i class="fa fa-columns"></i></a><a id="listButton" title="List View" class="toolbar-button button-left" href="#"><i class="fa fa-list-ul"></i></a>
				</apex:outputPanel>
			</div>
   		</div>
   		
		<div id="add-button-floating-dropdown" class="floating-dropdown floating-dropdown-relative" style="margin-top:1px">
			<ul class="floating-dropdown-menu">
				<li><a href="#" class="addTaskButton">{!$ObjectType.Task__c.Label}</a></li>
				<li><a href="#" class="addMilestoneButton">{!$ObjectType.Milestone__c.Label}</a></li>
				<apex:outputPanel layout="none" rendered="{!EnableIterations}">
				<li class="dropdown-separator"></li>
				<li><a href="#" class="addPlanWorkItemButton">{!$ObjectType.KimbleOne__WorkItem__c.Label}</a></li>
				<li><a href="#" class="addIterationButton">{!$Label.Iteration}</a></li>
				<li><a href="#" id="addIterationsButton">{!$Label.kimbleone__additerations}</a></li>
				</apex:outputPanel>				 
				<li class="dropdown-separator"></li>
				<li><a href="#" id="addTasksFromExternal"><apex:outputText value="{!$Label.kimbleone__addtasksfrommsplabel}"/></a></li>
			</ul>
		</div>   		
	</div>

	<div class="work-items-container planner-view-item">
		<div class="backlog-container">
		</div>
		<div class="all-iterations-container" style="position:relative;">
			<div class="dragging-scroll scroll-left" style="left: 0px; bottom: 0px;top: 0px;width: 30px;"></div>
			<div class="dragging-scroll scroll-right" style="right: 0px;bottom: 0px;top: 0px;width: 30px;"></div>
			<div class="iterations-container">
			</div>
		</div>
	</div>
	
	<apex:pageBlock id="trackingPlanTemplatePB">
	<div id="grid-header-container" class="grid-view-item">
		<table id="template-tasks" class="tasks-grid-table list" border="0" cellpadding="0" cellspacing="0">
			<colgroup>
				<col style="width:50px;"/><!-- # -->
				<col style="width:315px;"/><!-- Name -->
				<col style="width:100px;"/><!-- Start -->
				<col style="width:100px;"/><!-- End  -->
				<col class="ignore-non-bus-days" style="width:80px;"/><!-- Include Non Business Days indicator -->
				<col style="width:90px;"/><!-- Assigned Resources -->
				<col style="width:90px;"/><!-- Effort -->
				<col style="width:90px;" class="effort-units-col hidden-item"/><!-- Average Effort Insight -->
				<col style="width:90px;"/><!-- Fixed Effort -->
				<col style="width:90px;"/><!-- Predecessors -->
				<col style="width:100px;"/><!-- Task Category -->
				
			</colgroup>
			<thead>
			<tr class="headerRow">
				<th rowspan="2" class="position">#</th>
				<th class="headerRow"><h2>{!$ObjectType.TaskTemplate__c.Label}</h2></th>
				<th rowspan="2" style="text-align:center">{!$ObjectType.TaskTemplate__c.Fields.StartDateOffset__c.Label}</th>	
				<th rowspan="2" style="text-align:center">{!$ObjectType.TaskTemplate__c.Fields.EndDateOffset__c.Label}</th>
				<th class="ignore-non-bus-days" rowspan="2" style="text-align:center">{!$ObjectType.PlanTask__c.Fields.IncludeNonBusinessDays__c.Label}</th>	
				<th rowspan="2" style="text-align:center">{!$ObjectType.Resource__c.LabelPlural}</th>
				<th rowspan="2" style="text-align:center">{!$Label.TotalEffort} (<apex:outputText value="{!ResourcedActivityTemplate.UsageUnitType__r.KimbleOne__Suffix__c}"/>)</th>
				<th rowspan="2" style="text-align:center" class="effort-units-col hidden-item">{!$Label.AverageTotal}</th>
				<th class="fixedEffort" rowspan="2" style="text-align:center">{!$ObjectType.TaskTemplate__c.Fields.IsFixedEffort__c.Label}</th>
				<th class="taskEffort" rowspan="2" style="text-align:center">{!$ObjectType.TaskTemplate__c.Fields.Effort__c.Label}</th>
				<th rowspan="2" style="text-align:center">{!$Label.Predecessors}</th>
				<th rowspan="2">{!$ObjectType.TaskTemplate__c.Fields.TaskCategory__c.Label}</th>												
			</tr>
			<tr class="headerRow">
				<th style="background-color:white;"><input id="task-search" type="text" size="1"  autocomplete="off"/></th>
			</tr>
			</thead>
			<tbody></tbody>
		</table>  
	</div>
	
	<div class="grid-view-item">
		<div id="EditTaskContainer" style="display:none">
			<div class="ionTabs" id="edit-task-tabs" data-name="edit-tasks-group" >
				<ul class="ionTabs__head task">
					<li class="ionTabs__tab" data-target="task-details">{!$Label.DetailsLabel}</li>
					<li class="ionTabs__tab" data-target="task-work-items">{!$ObjectType.KimbleOne__WorkItem__c.LabelPlural}</li>
					<li class="ionTabs__tab" data-target="task-resources">{!$ObjectType.Resource__c.LabelPlural}</li>
					<li class="ionTabs__tab" data-target="task-predecessors">{!$Label.Predecessors}</li>
					<li class="ionTabs__tab" data-target="task-advanced-details">{!$Label.AdvancedHeading}</li>
				</ul>
				<div class="ionTabs__body" style="width:640px; height:300px;">
					<div class="ionTabs__item" data-name="task-details">
						<table cellpadding="0" cellspacing="0" border="0" id="edit-task" class="tasks-grid-table">
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Label}</td>
								<td colspan="3"><input type="text" id="edit-name" style="width:305px"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.StartDateOffset__c.Label}</td>
								<td><input type="text" id="edit-start-date-offset"  style="width:90px"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.EndDateOffset__c.Label}</td>
								<td><input type="text" id="edit-end-date-offset"  style="width:90px"/></td>
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.Effort__c.Label}</td>
								<td><input type="text" id="edit-effort"  style="width:90px"/></td>
							</tr>
							<apex:outputPanel layout="none" rendered="{!EnableTaskStartEndTime}">
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.StartTime__c.Label}</td>
								<td><input type="text" id="edit-start-time" class="kimbleTimePicker"  style="width:90px"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.EndTime__c.Label}</td>
								<td><input type="text" id="edit-end-time" class="kimbleTimePicker"  style="width:90px"/></td>
							</tr>
							</apex:outputPanel>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.IsFixedEffort__c.Label}</td>
								<td><input type="checkbox" id="edit-fixed"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.CalendarShowAs__c.Label}</td>
								<td>
									<select id="edit-calendar-show-as">
										<option value=""></option>
										<apex:repeat value="{!CalendarOptions}" var="cal">
											<option value="{!cal.Id}"><apex:outputText value="{!cal.Name}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.TaskCategory__c.Label}</td>
								<td>
									<select id="edit-catgeory">
										<option value=""></option>
										<apex:repeat value="{!TaskCategories}" var="cat">
											<option value="{!cat.Id}"><apex:outputText value="{!cat.Name}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>
				   
						</table>
					</div>
					<div class="ionTabs__item" data-name="task-work-items">
						<div id="task-work-items-container" style="height: 258px;overflow-y: auto;background-color: #FFF;margin-bottom: 5px;">
						</div>
					</div>
					<div class="ionTabs__item" data-name="task-resources">
						<table id="resource-assignments-head" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
						<colgroup>
							<col style="width:30px;"/>
							<col style="width:250px;"/>
							<col style="width:100px;"/>
							
						</colgroup>
						<thead>
						<tr class="headerRow" style="height:31px;">
							<th></th>
							<th class="headerRow"><h2>{!$ObjectType.ActivityAssignment__c.Fields.Resource__c.Label}</h2></th>
							<th style="text-align: center;">{!$Label.TotalEffort} (<apex:outputText value="{!ResourcedActivityTemplate.UsageUnitType__r.KimbleOne__Suffix__c}"/>)</th>	
							<th></th>
						</tr>							
						</thead>
						</table>
						
						<div style="height: 258px;overflow-y: auto;background-color: #FFF;margin-bottom: 5px;">
							<table id="resource-assignments-body" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
							<colgroup>
								<col style="width:30px;"/>
								<col style="width:250px;"/>
								<col style="width:100px;"/>
							</colgroup>
							<tbody>
														
							</tbody>
							</table>
						</div>
					</div>
					<div class="ionTabs__item" data-name="task-predecessors">
						<table id="predecessors-head" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
						<colgroup>
							<col style="width:40px;"/><!-- Delete -->
							<col style="width:280px;"/><!-- Task Name -->
							<col style="width:140px;"/><!-- Type -->
							<col style="width:50px;"/><!-- Lag -->
						</colgroup>
						<thead>
						<tr class="headerRow"  style="height:31px;">
							<th><a class="toolbar-button" style="padding: 3px 7px 3px 7px;" href="#" id="addPredecessorButton" title="{!$Label.Add} {!$ObjectType.PlanItemDependency__c.Fields.PlanItemPredecessor__c.Label}"><i class="fa fa-plus"></i></a></th>
							<th class="headerRow"><h2>{!$ObjectType.PlanItemDependency__c.Fields.PlanItemPredecessor__c.Label}</h2></th>
							<th>{!$ObjectType.PlanItemDependency__c.Fields.DependencyType__c.Label}</th>
							<th>{!$ObjectType.PlanItemDependency__c.Fields.Lag__c.Label}</th>
						</tr>							
						</thead>
						</table>
						
						<div style="height: 200px;overflow-y: auto;background-color: #FFF;margin-bottom: 5px;">
							<table id="predecessors-body" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
							<colgroup>
								<col style="width:40px;"/><!-- Delete -->
								<col style="width:280px;"/><!-- Task Name -->
								<col style="width:140px;"/><!-- Type -->
								<col style="width:50px;"/><!-- Lag -->
							</colgroup>
							<tbody>
												
							</tbody>
							</table>
						</div>
					</div>
					<div class="ionTabs__item" data-name="task-advanced-details">
						<table cellpadding="0" cellspacing="0" border="0" id="edit-task-advanced" class="tasks-grid-table">
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.PlanTask__c.Fields.PlanItemConstraintType__c.Label}</td>
								<td>
									<select id="edit-constraint-type" class="task-edit-input">
										<apex:repeat value="{!PlanItemConstraintTypes}" var="constraintType">
											<option value="{!constraintType.Id}"><apex:outputText value="{!constraintType.Name}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.PlanTask__c.Fields.IncludeNonBusinessDays__c.Label}</td>
								<td><input type="checkbox" id="edit-task-ignore-non-bus-days" class="task-edit-input" style="width:90px"/></td>
							</tr>
							<tr style="height: 30px;" class="edit-milestone-visibility-row">
								<td class="edit-label">{!$ObjectType.TaskTemplate__c.Fields.VisibilityLevel__c.Label}</td>
								<td>
									<select id="edit-task-visibility">
										<apex:repeat value="{!TaskVisibilityLevels}" var="visibilityLevel">
											<option value="{!visibilityLevel.Value}"><apex:outputText value="{!visibilityLevel.label}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>						
						</table>
					</div>
					<div class="ionTabs__preloader"></div>
				</div>
			</div>
			<div style="text-align:center;">
				<input id="TaskOkButton" class="btn" type="button" value="{!$Label.Ok}" />
				<input class="btn" type="button" value="{!$Label.Cancel}" onclick="hideModalBoxy();"/>
			</div>
		</div>
			
		<div id="EditMilestoneContainer" style="display:none">
			<div class="ionTabs" id="edit-milestone-tabs" data-name="edit-milestones-group">
				<ul class="ionTabs__head milestone">
					<li class="ionTabs__tab" data-target="milestone-details">{!$Label.DetailsLabel}</li>
					<li class="ionTabs__tab" data-target="milestone-predecessors">{!$Label.Predecessors}</li>
					<li class="ionTabs__tab" data-target="milestone-advanced-details">{!$Label.AdvancedHeading}</li>
				</ul>
				<div class="ionTabs__body" style="width:529px; height:260px;">
					<div class="ionTabs__item" data-name="milestone-details">
						<table cellpadding="0" cellspacing="0" border="0" id="edit-milestone">						
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.MilestoneTemplate__c.Label}</td>
								<td><input type="text" id="edit-name" style="width:242px"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.MilestoneTemplate__c.Fields.MilestoneDateOffset__c.Label}</td>
								<td><input type="text" id="edit-milestone-date-offset"  style="width:90px"/></td>
							</tr>
															
						</table>
					</div>
					<div class="ionTabs__item" data-name="milestone-predecessors">
						<table id="predecessors-head" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
						<colgroup>
							<col style="width:40px;"/><!-- Delete -->
							<col style="width:200px;"/><!-- Task Name -->
							<col style="width:100px;"/><!-- Type -->
							<col style="width:44px;"/><!-- Lag -->
						</colgroup>
						<thead>
						<tr class="headerRow"  style="height:31px;">
							<th><a class="toolbar-button" style="padding: 3px 7px 3px 7px;" href="#" id="addPredecessorButton" title="{!$Label.Add} {!$ObjectType.PlanItemDependency__c.Fields.PlanItemPredecessor__c.Label}"><i class="fa fa-plus"></i></a></th>
							<th class="headerRow"><h2>{!$ObjectType.PlanItemDependency__c.Fields.PlanItemPredecessor__c.Label}</h2></th>
							<th>{!$ObjectType.PlanItemDependency__c.Fields.DependencyType__c.Label}</th>
							<th>{!$ObjectType.PlanItemDependency__c.Fields.Lag__c.Label}</th>
						</tr>							
						</thead>
						</table>
						
						<div style="height: 200px;overflow-y: auto;background-color: #FFF;margin-bottom: 5px;">
							<table id="predecessors-body" border="0" cellpadding="0" cellspacing="0" class="tasks-grid-table list">
							<colgroup>
								<col style="width:40px;"/><!-- Delete -->
								<col style="width:200px;"/><!-- Task Name -->
								<col style="width:100px;"/><!-- Type -->
								<col style="width:44px;"/><!-- Lag -->
							</colgroup>
							<tbody>
												
							</tbody>
							</table>
						</div>
					</div>
					<div class="ionTabs__item" data-name="milestone-advanced-details">
						<table cellpadding="0" cellspacing="0" border="0" id="edit-milestone-advanced">
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.PlanMilestone__c.Fields.PlanItemConstraintType__c.Label}</td>
								<td>
									<select id="edit-milestone-constraint-type" class="milestone-edit-input">
										<apex:repeat value="{!PlanItemConstraintTypes}" var="constraintType">
											<option value="{!constraintType.Id}"><apex:outputText value="{!constraintType.Name}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.PlanMilestone__c.Fields.IncludeNonBusinessDays__c.Label}</td>
								<td><input type="checkbox" id="edit-milestone-ignore-non-bus-days" class="task-edit-input" style="width:90px"/></td>
							</tr>
							<tr style="height: 30px;">
								<td class="edit-label">{!$ObjectType.PlanMilestone__c.Fields.IsCompletedByPredecessorTasks__c.Label}</td>
								<td><input type="checkbox" id="edit-milestone-completed-by-tasks" class="task-edit-input" style="width:90px"/></td>
							</tr>
							<tr style="height: 30px;" class="edit-milestone-visibility-row">
								<td class="edit-label">{!$ObjectType.MilestoneTemplate__c.Fields.VisibilityLevel__c.Label}</td>
								<td>
									<select id="edit-milestone-visibility">
										<apex:repeat value="{!PlanningMilestoneVisibilityLevels}" var="visibilityLevel">
											<option value="{!visibilityLevel.Value}"><apex:outputText value="{!visibilityLevel.label}"/></option>
										</apex:repeat>
									</select>
								</td>
							</tr>							
						</table>
					</div>
					<div class="ionTabs__preloader"></div>
				</div>
			</div>
			<div style="text-align:center;">
				<input id="MilestoneOkButton" class="btn" type="button" value="{!$Label.Ok}" />
				<input class="btn" type="button" value="{!$Label.Cancel}" onclick="hideModalBoxy();"/>
			</div>
		</div>
			
		<div id="AddTasksFromExternalContainer" style="display:none">
			<table cellpadding="0" cellspacing="0" border="0" id="add-tasks-from-external">
				<tr>
					<td class="overview-label">Paste Task Data below:</td>
				</tr>
				<tr style="height: 30px;">
					<td><textarea id="externalTaskPasteArea" rows="20" cols="80"></textarea></td>
				</tr>
			</table>
			<div style="text-align:center;">
				<input id="AddExternalTasksOkButton" class="btn" type="button" value="{!$Label.Ok}" />
				<input class="btn" type="button" value="{!$Label.Cancel}" onclick="hideModalBoxy();"/>
			</div>
		</div>
		
		<div id="AddIterationsContainer" style="display:none">
			<table cellpadding="0" cellspacing="0" border="0" id="add-iterations">
				<tr style="height: 30px;">
					<td class="edit-label"><apex:outputText value="{!$Label.kimbleone__iterationname}"/></td>
					<td><input id="addIterationsName" value="{!$Label.kimbleone__iteration}"/></td>
				</tr>
				<tr style="height: 30px;">
					<td class="edit-label"><apex:outputText value="{!$Label.kimbleone__iterationduration}"/></td>
					<td><input id="addIterationsDuration" value="10"/></td>
				</tr>
				<tr style="height: 30px;">
					<td class="edit-label"><apex:outputText value="{!$Label.kimbleone__numberofiterations}"/></td>
					<td><input id="addIterationsQuantity" value="1"/></td>
				</tr>
			</table>
			<div style="text-align:center;">
				<input id="AddIterationsOkButton" class="btn" type="button" value="{!$Label.Ok}" />
				<input class="btn" type="button" value="{!$Label.Cancel}" onclick="hideModalBoxy();"/>
			</div>
		</div>
	</div>
	</apex:pageBlock>
</div>

<style>
	#data-loading {
		text-align: center;
		font-size: 200px;
		padding: 50px;
		color: #d3d3d3;
		position: absolute;
		width: 91%;
		filter: progid:DXImageTransform.Microsoft.Alpha(opacity=50);
		-moz-opacity: 0.7;
		-khtml-opacity: 0.7;
		opacity: 0.7;
		z-index: 1000;
		background-color: #fff;
		height: calc(100% - 100px);
	}
	a.toolbar-button {
		display: inline-block;
		padding: 6px 10px 6px 10px;
		background-color: white;
		margin-right: 4px;
		border: 1px solid #ccc;
		border-radius: 2px;
	}
	a.toolbar-button.active-toolbar-button {
		color: white;
		background-color: #888;
	}
	.toolbar-container {
		position: relative;
		background-color: #f8f8f8;
		padding: 6px;
