	function linkItemsClick()
	{
		if (jQuery(this).hasClass('disabled')) return;
		toggleWorking('#linkItemsButton');
	
		// take each selected row and create a Finish->Start dep for each
		var firstPlanItemRow;
		var previousPlanItemRow;
		
		jQuery.each(jQuery('[node-id].selected:not(.branch)'), function (i, thePlanItemRow){
			
			if(firstPlanItemRow == null)
			{
				firstPlanItemRow = thePlanItemRow;
			}
			else
			{
				// if the parent is a planning milestone then we create a Start->Start dependency, otherwise Finish->Start
				var dependencyType = 'FinishStart';
				
				var taskPredecessor = {PlanItemId:jQuery(previousPlanItemRow).attr('node-id'), Type:dependencyType};
				// don't connect tasks which would result in a circular dependency
				if(!createsCircularDependency(taskPredecessor.PlanItemId, [jQuery(thePlanItemRow).attr('node-id')]))
				{
					taskPredecessor.TaskId = taskPredecessor.PlanItemId;
					if(planPredecessors[jQuery(thePlanItemRow).attr('node-id')] == undefined) planPredecessors[jQuery(thePlanItemRow).attr('node-id')] = {};
					planPredecessors[jQuery(thePlanItemRow).attr('node-id')][taskPredecessor.PlanItemId] = taskPredecessor;
	
					// we must also add the parent to the taskSuccessor array
					var taskSuccessor = {PlanItemId:jQuery(previousPlanItemRow).attr('node-id'), Type:dependencyType};
					taskSuccessor.TaskId = jQuery(thePlanItemRow).attr('node-id');
					if(planSuccessors[taskSuccessor.PlanItemId] == undefined) planSuccessors[taskSuccessor.PlanItemId] = {};
					planSuccessors[taskSuccessor.PlanItemId][jQuery(thePlanItemRow).attr('node-id')] = taskSuccessor;
					
					jQuery(thePlanItemRow).find('.predecessors').text(getPredecessors(planPredecessors[jQuery(thePlanItemRow).attr('node-id')]));
				}
			}
				
			previousPlanItemRow = thePlanItemRow;
		});
		
		toggleWorking('#linkItemsButton');
	}

