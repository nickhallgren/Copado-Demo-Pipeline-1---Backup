				var r = jQuery(row);
				var taskPredecessor = {PlanItemId:r.find('#predecessor-select').val(), Type:r.find('#predecessor-type-select').val()};
				if (taskPredecessor.PlanItemId == null) return true;
				taskPredecessor.MilestoneId = taskPredecessor.PlanItemId;
				taskPredecessor.Lag = (r.find('#predecessor-lag-input').val() == 'undefined' ? null : kimble.parseNumber(r.find('#predecessor-lag-input').val(), '0.##')); 
				planPredecessors[milestoneId][taskPredecessor.PlanItemId] = taskPredecessor;
			});
			
			//Advanced
			milestone.ConstraintTypeId = advancedPanel.find('#edit-milestone-constraint-type').val();
			milestone.VisibilityLevelId = advancedPanel.find('#edit-milestone-visibility').val();
			
			//asap and alap should override the offset
			if(planItemConstraintIdToEnumMap[milestone.ConstraintTypeId] == 'AsSoonAsPossible'
				|| planItemConstraintIdToEnumMap[milestone.ConstraintTypeId] == 'AsLateAsPossible')
			{
				// TODO125: we shouldn't be using this as a general offset, instead introduce constraint offset?
				milestone.StartDateOffset = null;
			}
			
			milestone.IncludeNonBusinessDays = advancedPanel.find('#edit-milestone-ignore-non-bus-days').prop('checked');
			milestone.IsCompletedByPredecessorTasks = advancedPanel.find('#edit-milestone-completed-by-tasks').prop('checked');
			
			milestoneRow.replaceWith(getPlanItemHtml(milestone));
			planChanged();
			refreshDependencies();
			hideModalBoxy();
