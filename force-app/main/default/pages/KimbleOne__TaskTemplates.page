			var scroller;
			
			if (jQuery(this).hasClass('scroll-left'))
				scroller = setInterval( scrollLeft, 30 );
			if (jQuery(this).hasClass('scroll-right'))
				scroller = setInterval( scrollRight, 30 );
			
			$(this).data('scroller', scroller);
			},
			function(){
				var scroller = $(this).data('scroller');
				clearInterval( scroller );
			}
		);
		
		if(jQuery('.work-items').data('ui-sortable')) jQuery('.work-items').sortable('destroy');
		
		jQuery.widget("ui.fixedSortable", jQuery.ui.sortable, {
				_init: function () {
					this.element.data("sortable", this.element.data("fixedSortable"));
					return jQuery.ui.sortable.prototype._init.apply(this, arguments);
				},
				_create:function() {
					var result = jQuery.ui.sortable.prototype._create.apply(this, arguments);
					this.containerCache.sortable = this;
					return result;
				},
				_intersectsWithPointer: function (item) {
					if(this.positionAbs.left <= 318 && !item.instance.element.parent().hasClass("backlog")) return false;
					return jQuery.ui.sortable.prototype._intersectsWithPointer.apply(this, arguments);
				},
				_intersectsWith: function(containerCache) {
					if(this.positionAbs.left <= 318 && !containerCache.sortable.element.parent().hasClass("backlog")) return false;
					return jQuery.ui.sortable.prototype._intersectsWith.apply(this, arguments);
				}
		});


