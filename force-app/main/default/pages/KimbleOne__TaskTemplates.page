	function createsCircularDependency(nodeId, taskParams)
	{
		var circularDependencyFound = false;
		
		var currentItemId = taskParams[0];
		
		var optionTaskPredecessors = planPredecessors[nodeId];
		
		if (optionTaskPredecessors != null)
		{
			for(var counter = 0; counter < Object.keys(optionTaskPredecessors).length; counter++)
			{
				var key = Object.keys(optionTaskPredecessors)[counter];
				var theOptionTaskPredecessor = optionTaskPredecessors[key];
				
				if(theOptionTaskPredecessor != null)
				{
					if(key != null && key == currentItemId)
					{
						circularDependencyFound = true;
						break;
					}
					else
					{
						// this isn't a circular task, recurse to ensure that none of it's own parents create a loop too
						if(createsCircularDependency(key, [currentItemId]))
						{
							circularDependencyFound = true;
							break;
						}
					}
				}
				else
				{
					// the direct predecessor isn't a circular dependency but we must check the predecessor of this predecessor
					if(createsCircularDependency(key, [currentItemId]))
					{
						circularDependencyFound = true;
						break;
					}
				}
				
			}
		}

		return circularDependencyFound;
	}
