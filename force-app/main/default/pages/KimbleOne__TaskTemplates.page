			milestone.Name = detailsPanel.find('#edit-name').val() + (detailsPanel.find('#edit-name').attr('data-suffix') != undefined && detailsPanel.find('#edit-name').attr('data-suffix') != '' ? detailsPanel.find('#edit-name').attr('data-suffix') : '');
						
			milestone.StartDateOffset = kimble.parseNumber(detailsPanel.find('#edit-milestone-date-offset').val(), '0.##');
			milestone.EndDateOffset = 0;
			
			//Predecessors
			planPredecessors[milestoneId] = {};
			
