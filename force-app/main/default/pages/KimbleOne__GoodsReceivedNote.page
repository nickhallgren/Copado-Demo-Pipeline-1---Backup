<apex:page standardController="KimbleOne__GoodsReceivedNote__c" extensions="KimbleOne.GoodsReceivedNoteController,KimbleOne.FilesAndAttachmentsController" showHeader="true" sidebar="false" standardStylesheets="true" tabStyle="KimbleOne__GoodsReceivedNote__c">
<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu"></apex:define> 
    
    <apex:define name="Content">
    	<apex:pageBlock title="{!$Label.kimbleone__goodsreceivednoteheading}">
			<apex:pageBlockButtons location="bottom">
           		<input class="btn" type="button" value="{!$Label.Back}" onclick="safeNavigateToSForceURL('/' + '{!$ObjectType.GoodsReceivedNote__c.KeyPrefix}');"/>
           	</apex:pageBlockButtons>
			
			<apex:pageBlockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__goodsreceivednotedetailsheading}"  columns="2">
		    	
		    	<apex:outputField value="{!KimbleOne__GoodsReceivedNote__c.KimbleOne__SupplierAccount__c}" />
		    	
		    	<apex:outputField value="{!KimbleOne__GoodsReceivedNote__c.Name}" />
		    	
		    	<apex:outputField value="{!KimbleOne__GoodsReceivedNote__c.KimbleOne__ReceiptDate__c}" />
		    	
		    	<apex:outputField value="{!KimbleOne__GoodsReceivedNote__c.KimbleOne__ReceiptNotes__c}" />
		    	
		    </apex:pageBlockSection>
		    
		    <apex:pageblockSection collapsible="false" showheader="true" title="{!$Label.kimbleone__requisitionlineallocationslabel}"  columns="1">
		    	<apex:pageBlockTable value="{!TheGoodsReceiptAllocation}" var="line">
					<apex:column value="{!line.SupplierRequisitionLine__r.KimbleOne__SupplierRequisition__c}" />
					<apex:column value="{!line.SupplierRequisitionLine__r.SupplierRequisition__r.KimbleOne__SupplierPurchaseOrder__c}" />
					<apex:column value="{!line.SupplierRequisitionLine__r.KimbleOne__LineNumber__c}" />
					<apex:column value="{!line.SupplierRequisitionLine__r.Name}" width="340px"/>
					<apex:column value="{!line.SupplierRequisitionLine__r.KimbleOne__UnitAmount__c}" />
					<apex:column value="{!line.SupplierRequisitionLine__r.KimbleOne__RequisitionedUnits__c}" />
					<apex:column value="{!line.SupplierRequisitionLine__r.KimbleOne__NetAmount__c}" />
					<apex:column value="{!line.KimbleOne__ReceivedUnits__c}" />
				</apex:pageBlockTable>
		    </apex:pageblockSection>
  		  
		</apex:pageBlock>
   	  	<apex:relatedList list="CombinedAttachments" rendered="{!AttachmentsEnabled}"/>
		<apex:relatedList subject="{!KimbleOne__GoodsReceivedNote__c}" list="AttachedContentDocuments" rendered="{!FilesEnabled}"/>
		<style>
		.mainTitle {white-space:nowrap;}
		</style>
		<script>
			jQuery(document).ready(function() {
				if(isSFLightning()) jQuery('input[name="newNote"],input[name="attachFile"]').hide();
			});
		</script>
	</apex:define>
</apex:composition>

</apex:page>