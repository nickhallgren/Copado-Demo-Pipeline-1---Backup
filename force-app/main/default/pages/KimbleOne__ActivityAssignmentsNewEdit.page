		if (assignmentToEdit.EndDate == null) {alert(kimble.labels['RequiredValue'].format(endDateLabel)); return;}
		if (assignmentToEdit.Utilisation == null) {alert(kimble.labels['RequiredValue'].format(utilisationLabel)); return;}
		
