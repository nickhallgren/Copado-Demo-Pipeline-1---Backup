		assignmentToEdit.RevenueRateSummary = '[{"D":"' + assignmentToEdit.StartDate + '","R":' + (assignmentToEdit.InvoicingCurrencyForecastRevenueRate) + '}]';
	});
	
	jQuery(document).off('focus', '.kimbleDatePicker');
	jQuery(document).on('focus', '.kimbleDatePicker', function () {
		
		if (jQuery(this).prop('readonly')) return;
		
		jQuery(this).datepicker({
			dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
			showOtherMonths: true,
			selectOtherMonths: true,
			beforeShowDay: resourceAvailabilityOverlay
		});		
	});
	
	jQuery(document).off('click', '.delete-assignment');
	jQuery(document).on('click', '.delete-assignment', function () {
		var assignment = getAssignmentForEvent(this);
		
		delete scopingActivities[assignment.TheScopingActivityId].TheAssignments[assignment.Id];
		
		jQuery('#' + assignment.Id).remove();
		
		if (assignment.Id.substr(0,1) != '_')
			assignmentsToDelete.push(assignment.Id);
		
		jQuery.publish('kimble.assignmentDeleted', assignment);
	});
	
	jQuery(document).off('click', '.balance-assignment');
	jQuery(document).on('click', '.balance-assignment', function () {
		
		var popup = jQuery('.assignment-popup-content');
		
		var assignment = findAssignment(popup.attr('assignment-id'));
		
		var oldAssignment = jQuery.extend(true, {}, assignment);
		
		balanceAssignment(assignment, jQuery(this).attr('start-date'),jQuery(this).attr('end-date'));
		
		//redraw popup
		jQuery('.assignment-popup-content').replaceWith(jQuery(getAssignmentPopupHtml(assignment.Id, jQuery(this).attr('start-date').toDate(), jQuery(this).attr('end-date').toDate(),oldAssignment)));
		
		//Flash what has changed
		if (oldAssignment.StartDate != assignment.StartDate)
			jQuery('.popup-start-date').effect('highlight',2000);
		
		if (oldAssignment.EndDate != assignment.EndDate)
			jQuery('.popup-end-date').effect('highlight',2000);
		
		if (oldAssignment.RemainingUsage != assignment.RemainingUsage)
			jQuery('.popup-usage').effect('highlight',2000);
		
	});
	
	jQuery.unsubscribe('kimble.planChanged');
	jQuery.subscribe('kimble.planChanged', function(event, data) {
		//traceAction('PlanChanged Caught');
		var refreshWarnings = false;
		theTaskAssignments = {};
		
		if (data.taskAssignments != null)
		{
			data.taskAssignments.forEach(function(ta){
				if (theTaskAssignments[ta.ActivityAssignmentId] == null)
					theTaskAssignments[ta.ActivityAssignmentId] = {};
				
				theTaskAssignments[ta.ActivityAssignmentId][ta.TaskId] = ta;
			});
		}
		
		Object.keys(theTaskAssignments).forEach(function(assId){
			refreshWarnings = true;
			var assignment = findAssignment(assId);
			assignment.CanDelete = false;
			
			var entrySpecification = findUsageBehaviourRule(scopingActivities[assignment.TheScopingActivityId], assignment.UsageBehaviourRuleId).EntrySpecification;
			
			if (entrySpecification == "TaskUsage") {
				//traceAction('Recalculating Assignment for TaskUsage');
				recalculateUsage(assignment, true, true);
			}
		});
		
		if(refreshWarnings)
		{
			calculateAssignmentWarnings();
		}
	});
	
	jQuery.publish('kimble.assignmentGridRefreshComplete');
}

function showAssignmentEditPopup(assignment)
{
	jQuery('#assignment-edit-details').empty();
	
	initialiseModalBoxy('#EditAssignmentContainer','Edit Assignment');
	
	jQuery('#assignment-edit-details').append(jQuery(getAssignmentEditHtml(assignment)));
	
	showModalBoxy();
}

function addAssignment(scopingActivityId)
{
	activityToEdit = scopingActivities[scopingActivityId];
	
	assignmentToEdit = {Id:getUniqueId(), ActualUsage:0, RemainingUsage:0, TheScopingActivityId:scopingActivityId, CanChangeResource:true, HasChanges:true, StartDate:new Date().toKimbleUTC(), UsageBehaviourRuleId: activityToEdit.TheUsageBehaviourRules[0].Id};
	
	showAssignmentEditPopup(assignmentToEdit);
}

function balanceAssignment(assignment, newStartDate, newEndDate)
{
	var assignmentUsage = new ActivityAssignmentUsagePattern(assignment.HoursPerDay, assignment.StartDate.toDate(), assignment.UsagePattern, assignment.Utilisation, assignment.Utilisation);
	
	var earliestFirmDate = assignmentUsage.earliestFirmDate;
	var latestFirmDate = assignmentUsage.latestFirmDate
	
	if (earliestFirmDate != undefined && newStartDate.toDate() > earliestFirmDate) newStartDate = earliestFirmDate.toKimbleUTC();
	
	if (latestFirmDate != undefined && newEndDate.toDate() < latestFirmDate) newEndDate = latestFirmDate.toKimbleUTC();
	
	if (assignment.LatestStartDate != null && newStartDate.toDate() > assignment.LatestStartDate.toDate()) newStartDate = assignment.LatestStartDate;
	
	if (assignment.EarliestEndDate != null && newEndDate.toDate() < assignment.EarliestEndDate.toDate()) newEndDate = assignment.EarliestEndDate;
	
	assignment.StartDate = newStartDate;
	
	assignment.EndDate = newEndDate;
	
	recalculateUsage(assignment, true);
}

function findAssignment(id)
{
	var assignmentRow = jQuery('#assignments-edit-grid #' + id);
	var assignmentId = assignmentRow.attr('id');
	var activityId = assignmentRow.closest('tr').attr('activity-id');
	var activity = scopingActivities[activityId];
	
	return activity.TheAssignments[assignmentId];
}

function getAssignmentForEvent(obj)
{
	var assignmentRow = jQuery(obj).closest('tr');
	var assignmentId = assignmentRow.attr('id');
	var activityId = assignmentRow.closest('tr').attr('activity-id');
	var activity = scopingActivities[activityId];
	
	return activity.TheAssignments[assignmentId];
}

function parseCostSummaryJson (j)
{
	return kimble.parseJSON(j.replace(/"CostRate"/g, '"R"').replace(/"FromDate"/g, '"D"'));
}

