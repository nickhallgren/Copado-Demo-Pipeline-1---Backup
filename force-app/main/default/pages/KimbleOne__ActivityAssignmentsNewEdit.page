		assignmentToEdit.ForecastCostRate = costRate / assignmentToEdit.ForecastToInvoiceConversionFactor;
		assignmentToEdit.CostRateSummary = '[{"D":"' + assignmentToEdit.StartDate + '","R":' + (assignmentToEdit.ForecastCostRate) + '}]';
	    
	    jQuery(this).closest('td').find('.future-cost-change').remove();
	});
	
	jQuery(document).off('change', '.revenue-rate-input');
	jQuery(document).on('change', '.revenue-rate-input', function () {
