<apex:page Controller="KimbleOne.ActivityAssignmentsNewEditController" extensions="KimbleOne.ActivityAssignmentRemoteActions" showHeader="false" sidebar="false">
<apex:includeScript value="{!URLFOR($Resource.KimbleOne__ActivityAssignmentUsagePattern)}" />
<div id="assignments-container">
	<div id="assignments-edit-grid">
		<table class="list" border="0" cellpadding="0" cellspacing="0" id="assignments-table">
			<!--a comment -->
		</table>
		
		<div id="EditAssignmentContainer" style="display:none">
			<div id="assignment-edit-details">
							
			</div>
			<div style="text-align:center;">
				<input id="AssignmentOkButton" class="btn" type="button" value="{!$Label.Ok}" />
				<input class="btn" type="button" value="{!$Label.Cancel}" onclick="hideModalBoxy();"/>
			</div>
		</div>
	</div>
</div>
<script>
	var assignmentToEdit;
	var activityToEdit;
	
	var useResourceEnhancedLookup = {!IF(UseResourceEnhancedLookup, 'true','false')};
	var useLocationEnhancedLookup = {!IF(UseLocationEnhancedLookup, 'true','false')};
	
	var enableTrackingPlanUsageWarnings = <apex:outputText value="{!EnableTrackingPlanUsageWarnings}"/>;
	
	var resourceKeyPrefix = '<apex:outputText value="{!$ObjectType.KimbleOne__Resource__c.KeyPrefix}"/>';
	var locationKeyPrefix = '<apex:outputText value="{!$ObjectType.KimbleOne__Location__c.KeyPrefix}"/>';
	
	var classificationStyleMap = kimble.parseJSON("{!JSENCODE(TheJsonClassificationsMap)}");
	
	var assignmentsToDelete;
	
	var locationOptions;
	
	var usageLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__PlanTask__c.Fields.KimbleOne__Effort__c.Label}"/>';
	
	var costRateLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__CostRate__c.Label}"/>';
	var revenueRateLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__RevenueRate__c.Label}"/>';
	var resourceLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__Resource__c.Label}"/>';
	var startDateLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__StartDate__c.Label}"/>';
	var endDateLabel = '<apex:outputText value="{!$Label.kimbleone__enddatelabel}"/>';
	var usageBehaviourRuleLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UsageBehaviourRule__c.Label}"/>';
	var utilisationLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UtilisationPercentage__c.Label}"/>';
	var resourceInitialsLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__ResourceInitials__c.Label}"/>';
	var unforecastUsageLabel = '<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__UnforecastUsage__c.Label}"/>';
	var totalCostLabel = 'Total Cost';
	var totalRevenueLabel = 'Total Revenue';
	
	var showCosts = false;
	
	<apex:outputPanel layout="none" rendered="{!$ObjectType.KimbleOne__ActivityAssignment__c.Fields.KimbleOne__TemporalForecastCostRate__c.Accessible}">
		showCosts = true;
	</apex:outputPanel>
	
	<apex:outputPanel layout="none" rendered="{!!ISBLANK(TheLocationOptionsJson)}">
	
		locationOptions = kimble.parseJSON("{!JSENCODE(TheLocationOptionsJson)}");
	
	</apex:outputPanel>
	
	var scopingActivities = {};
	var theTaskAssignments;
	
	function clearAll()
	{
		jQuery('#assignments-edit-grid>table>tbody').empty();
	}
	
	function initialiseForActivity(resourcedActivityId, taskAssignments)
	{
		theTaskAssignments = taskAssignments;
		//build grid based on operating activity
		getAssignmentsToEdit(resourcedActivityId);
	}
	
	function getAssignmentsToEdit (activityId)
	{	
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.GetActivityAssignmentsToEdit}',
			activityId,
			function(result, event){          
				if (event.status) {
					// initialise grid
					scopingActivities[result.Id] = result;
					assignmentsToDelete = new Array();
					
					refreshAssignmentEditGrid();
				} 
				else if (event.type === 'exception') 
				{
					alert(event.message);
				} 
				else 
				{
					alert(event.message);
				}
			}, 
			{escape: false, timeout: 60000});
	}
	
	function verifyResource(activity, assignment, context)
	{				
		if (assignment.ResourceId == null) return;
		
		if (activity.IsRoleMandatory && (assignment.ActivityRoleId == null || assignment.ActivityRoleId == '')) return;
		
		if (activity.IsLocationMandatory && (assignment.LocationId == null || assignment.LocationId == '')) return;
		
		if (assignment.StartDate == null) return;
		
		if(assignment.UpdateCostOnResourceChange && context == 'resource')
			assignment.ForecastCostRate = null;

		if(assignment.UpdateCostOnRoleChange && context == 'role')
			assignment.ForecastCostRate = null;
			
		if(assignment.UpdateCostOnLocationChange && context == 'location')
			assignment.ForecastCostRate = null;
			
		if(assignment.UpdateRevenueOnResourceChange && context == 'resource')
			assignment.InvoicingCurrencyForecastRevenueRate = null;
			
		if(assignment.UpdateRevenueOnRoleChange && context == 'role')
			assignment.InvoicingCurrencyForecastRevenueRate = null;
			
		if(assignment.UpdateRevenueOnLocationChange && context == 'location')
			assignment.InvoicingCurrencyForecastRevenueRate = null;
		
		var oldId;
		if (assignment.Id.substr(0,1) == '_')
		{
			oldId = assignment.Id;
			assignment.Id = null;
		}
		
		jQuery('#loadingIndicatorOuterContainer').show();
		
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.GetAssignmentDefaults}',
       		assignment,
      			function(result, event){
             		 if (event.status) 
		             {
		            	assignmentToEdit = result.TheActivityAssignment;
		            	
		            	if (oldId != null) assignmentToEdit.Id = oldId;
		            	
		            	if (activity.TheResources[assignmentToEdit.ResourceId] == null) activity.TheResources[assignmentToEdit.ResourceId] = result.TheSelectedResource;
		            			            	
		            	var assignmentTrHtml = getAssignmentEditHtml(assignmentToEdit);
	
						jQuery('#assignment-edit-details').empty().append(jQuery(assignmentTrHtml));
		         	} 
		         	else if (event.type === 'exception') 
		         	{
		             	alert(event.message);
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		         	}
		         	
		         	jQuery('#loadingIndicatorOuterContainer').hide();
         }, 
         {escape: false, timeout: 60000}
     );
	}
	
	function deleteAssignments(onError)
	{
		if (assignmentsToDelete.length > 0)
		{
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.DeleteActivityAssignments}',
				assignmentsToDelete,
				function(result, event){          
					if (event.status) {
						assignmentsToDelete = new Array();
					} 
					else if (event.type === 'exception') 
					{
						if (onError != null)
							onError(event.message);
						else
							alert(event.message);					
					} 
					else 
					{
						if (onError != null)
							onError(event.message);
						else
							alert(event.message);
					}
					hideWorking();						
				}, 
				{escape: false, timeout: 60000});
		}
		else
			hideWorking();
	}
	
	function saveAllAssignments(onError)	
	{
		var theAssignmentsToSave = new Array();
		
		jQuery.each(Object.keys(scopingActivities), function (i, key) {
			
			var activity = scopingActivities[key];
			
			jQuery.each(Object.keys(activity.TheAssignments), function (j, assignmentId) {
			
			var assignment = activity.TheAssignments[assignmentId];
			
			if (assignment.HasChanges)
			{
				delete assignment.HasChanges
				
				var clone = jQuery.extend(true, {}, assignment);
				
				if (clone.Id.substr(0,1) == '_')
				{
					clone.LocalId = clone.Id;
					clone.Id = null;
				}
				
				theAssignmentsToSave.push(clone);	
			}
			});
		});
		
		if (theAssignmentsToSave.length > 0)
		{
			//jQuery('#assignment-error').hide();
			
			Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.SaveActivityAssignments}',
				theAssignmentsToSave,
				function(result, event){          
					if (event.status) {
						
						jQuery.each(Object.keys(result), function (i, localId) {
							jQuery.each(Object.keys(scopingActivities), function (i, key) {
			
								var activity = scopingActivities[key];
							
								jQuery.each(Object.keys(activity.TheAssignments), function (j, assignmentId) {
									if(assignmentId == localId)
									{
										var matchingAssignment = activity.TheAssignments[assignmentId];
										
										delete activity.TheAssignments[assignmentId];
										
										matchingAssignment.Id = result[localId];
										
										activity.TheAssignments[matchingAssignment.Id] = matchingAssignment;
										
										result[localId] = matchingAssignment;
									}
								});
							});
						});
						
						//TODO - Should this call getAssignmentsToEdit
						refreshAssignmentEditGrid();
						
						jQuery.publish('kimble.saveAssignmentsComplete', result);
					} 
					else if (event.type === 'exception') 
					{
						if (onError != null)
							onError(event.message);
						else
							alert(event.message);					
					} 
					else 
					{
						if (onError != null)
							onError(event.message);
						else
							alert(event.message);
					}							
				}, 
				{escape: false, timeout: 60000});
		}
		else
		{
			jQuery.publish('kimble.saveAssignmentsComplete', {});
		}
	}

	function verifyLookup(obj, typ)
	{				
		jQuery('#loadingIndicatorOuterContainer').show();
		
		Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentsNewEditController.VerifyLookup}',
       		obj.val(), typ,
      			function(result, event){
             		 if (event.status) 
		             {
		            	if (result == null)
		            		kimbleOpenLookup(obj.next(), typ);
		            	else
		            		kimblePickValue(obj.attr('id'), result.id, result.text);
		         	} 
		         	else if (event.type === 'exception') 
		         	{
		             	alert(event.message);
		         	} 
		         	else 
		         	{
		             	alert(event.message);
		         	}
		         	
		         	jQuery('#loadingIndicatorOuterContainer').hide();
         }, 
         {escape: false, timeout: 60000}
     );
	}
	
	var showRevenue = false;

function calculateActivityRollups(activityId)
{
	var activity = scopingActivities[activityId];
	
	var expendedUsage = 0;
	var totalUsage = 0;
	var baselineUsage = 0;
	var remainingUsage = 0;
	var taskUsage = 0;
	
	var startDate = null;
	var endDate = null;
	
	var theScopingId;
	
	jQuery.each(Object.keys(activity.TheAssignments), function(i, assId) {
		var assignment = activity.TheAssignments[assId];
		
		expendedUsage += assignment.ActualUsage;
		remainingUsage += assignment.RemainingUsage;
		baselineUsage += assignment.BaselineUsage;
		
		if (theTaskAssignments[assId] != null)
		{
			jQuery.each(Object.keys(theTaskAssignments[assId]), function (j, taskId){
				taskUsage += theTaskAssignments[assId][taskId].RemainingEffort * assignment.UsageToHourConversionFactor / assignment.ForecastToHourConversionFactor;
			});
		}
		
		if (startDate == null || assignment.StartDate.toDate() < startDate) startDate = assignment.StartDate.toDate();
		
		if (endDate == null || assignment.EndDate.toDate() > endDate) endDate = assignment.EndDate.toDate();
		
		theScopingId = assignment.TheScopingElementId;
	});
	
	var activityRow = jQuery('[activity-id="' + activityId + '"].activity-row');
	activityRow.find('.total-expended').text(kimble.formatNumber(expendedUsage, '0.##'));
	activityRow.find('.total-remaining').text(kimble.formatNumber(remainingUsage, '0.##'));
	activityRow.find('.total-planned').removeClass('task-tolerance-warning').removeClass('task-tolerance-error').text(kimble.formatNumber(taskUsage, '0.##'));
	activityRow.find('.total-total').text(kimble.formatNumber(expendedUsage + remainingUsage, '0.##'));
	activityRow.find('.total-baseline').text(kimble.formatNumber(baselineUsage, '0.##'));
	
	var taskTolerance = 1.05;
	
	if (taskUsage * taskTolerance < remainingUsage)
		activityRow.find('.total-planned').addClass('task-tolerance-warning');
	
	if (taskUsage > remainingUsage * taskTolerance)
		activityRow.find('.ttotal-planned').addClass('task-tolerance-error');
				
	
	
	//if different
	var oldStart = kimble.parseDate(activityRow.find('.min-start-date').val());
	var oldEnd = kimble.parseDate(activityRow.find('.max-end-date').val());
	
	if (startDate != null) activityRow.find('.min-start-date').val(kimble.formatDate(startDate.toKimbleUTC()));
	if (endDate != null) activityRow.find('.max-end-date').val(kimble.formatDate(endDate.toKimbleUTC()));
	
	if (endDate != null && oldEnd != endDate.toKimbleUTC())
		jQuery.publish('kimble.latestEndDateChanged', {dte:endDate.toKimbleUTC(), scopingId:theScopingId});
	
	if (startDate != null && oldStart != startDate.toKimbleUTC())
		jQuery.publish('kimble.earliestStartDateChanged', {dte:startDate.toKimbleUTC(), scopingId:theScopingId});
}

var kimblePopup;
var startDateChange;
var endDateChange;
var baseCurrency;
var invoicingCurrency;
var invoicingUnits;
var usageHeaderLabel;

var defaultIncludeInAggregate = false;
var assignmentUsagePatternMap = {};

function refreshAssignmentEditGrid()
{
	//TODO: What about simple drop down?
	useResourceEnhancedLookup = true;
	
	//clear all
	jQuery('#assignments-edit-grid>table').empty();
	
	//setup column headers - is revenue rate col applicable
	jQuery.each(Object.keys(scopingActivities), function (i, key) {
		
		usageHeaderLabel = usageLabel + ' (' + scopingActivities[key].ForecastingUnits + ')';
		
		baseCurrency = scopingActivities[key].BaseCurrency;
		invoicingCurrency = scopingActivities[key].InvoicingCurrency;
		invoicingUnits = scopingActivities[key].InvoicingUnits;
		revenueUnits = scopingActivities[key].RevenueEntryUnits;

		if (scopingActivities[key].HasRevenue)
			showRevenue = true;
		
		jQuery.each(Object.keys(scopingActivities[key].TheResources), function (j, resourceId) {
			var resource = scopingActivities[key].TheResources[resourceId].Resource;
			
			jQuery.each(Object.keys(resource.AggregatePattern), function (k, key) {
				var usage = resource.AggregatePattern[key];
				usage.agg = 0;
				
				jQuery.each(Object.keys(usage.p), function(l, p){
					if (classificationStyleMap[p] != undefined && classificationStyleMap[p].IsUtilPct) usage.agg += usage.p[p];
				});
			});
			
		});
		
		jQuery.each(Object.keys(scopingActivities[key].TheAssignments), function (j, assignmentId) {
			
			var assignment = scopingActivities[key].TheAssignments[assignmentId];
			
			if (assignment.IncludeInAggUtilisation == true) defaultIncludeInAggregate = true;
			
			var resource = scopingActivities[key].TheResources[assignment.ResourceId].Resource;
			
			var assignmentUsage = new ActivityAssignmentUsagePattern(assignment.HoursPerDay, assignment.StartDate.toDate(), assignment.UsagePattern, assignment.Utilisation, assignment.Utilisation);
			
			assignmentUsagePatternMap[assignment.Id] = assignmentUsage;
			
			var counter = 0;
			
			jQuery.each(assignment.UsagePattern.split(USAGEDAYDELIMITER), function (x, s){
				if (s == '') return false;
			
				var dte = new Date(assignment.StartDate.toDate().getFullYear(), assignment.StartDate.toDate().getMonth(), assignment.StartDate.toDate().getDate() + counter, 0, 0, 0, 0);
				counter++;
				
				if (resource.AggregatePattern[dte.toKimbleUTC()] != null && resource.AggregatePattern[dte.toKimbleUTC()].agg != null && assignment.IncludeInAggUtilisation)
				{
					resource.AggregatePattern[dte.toKimbleUTC()].agg -= (assignmentUsage.getForecastUsage(s, false, assignment.HoursPerDay) / assignment.HoursPerDay) * 100;
				}
			});
		});	
		
	});
	
	//Build table headers
	var tableHeaderHtml = '<thead><tr class="headerRow">';
	
	tableHeaderHtml += '<th></th>';
	tableHeaderHtml += '<th></th>';
	tableHeaderHtml += '<th id="usage-header" colspan="5" style="text-align:center">' + usageHeaderLabel + '</th>';
	tableHeaderHtml += '<th></th>';
	tableHeaderHtml += '<th></th>';
	tableHeaderHtml += '<th></th>';
	
	if (showCosts) tableHeaderHtml += '<th></th>';
	
	if (showRevenue) tableHeaderHtml += '<th></th>';
	
	//if (showCosts) tableHeaderHtml += '<th></th>';
	
	//if (showRevenue) tableHeaderHtml += '<th></th>';
	
	tableHeaderHtml += '</tr>';
	
	tableHeaderHtml += '<tr class="headerRow">';
	
	tableHeaderHtml += '<th id="action-header" class="headerRow"></th>';
	
	tableHeaderHtml += '<th id="resource-header" class="headerRow">' + resourceLabel + '</th>';
	tableHeaderHtml += '<th id="expended-header" style="text-align:center" class="headerRow">{!$Label.ExpendedEffort}</th>';
	tableHeaderHtml += '<th id="remaining-header" style="text-align:center" class="headerRow">{!$Label.RemainingEffort}</th>';
	tableHeaderHtml += '<th id="planned-remaining-header" style="text-align:center" class="headerRow">{!$Label.PlannedResourceAssignmentUsage}</th>';
	tableHeaderHtml += '<th id="total-effort-header" style="text-align:center" class="headerRow">{!$Label.TotalEffort}</th>';
	tableHeaderHtml += '<th id="baseline-effort-header" style="text-align:center" class="headerRow">{!$Label.BaselineLabel}</th>';
	tableHeaderHtml += '<th id="start-date-header" class="headerRow">' + startDateLabel + '</th>';
	tableHeaderHtml += '<th id="end-date-header" class="headerRow">' + endDateLabel + '</th>';
	tableHeaderHtml += '<th id="utilisation-percentage-header" class="headerRow">' + utilisationLabel + '</th>';
	
	if (showCosts) tableHeaderHtml += '<th id="cost-rate-header" class="headerRow">' + '<span>' + costRateLabel + '<br/>(' + baseCurrency + ' ' + invoicingUnits + ')</span></th>';
	if (showRevenue) tableHeaderHtml += '<th id="revenue-rate-header" class="headerRow">' + '<span>' + revenueRateLabel + '<br/>(' + invoicingCurrency + ' ' + revenueUnits + ')</span></th>';
	
	//if (showCosts) tableHeaderHtml += '<th id="total-cost-header" class="headerRow">' + '<span>' + totalCostLabel + ' (' + baseCurrency + ')</span></th>';
	//if (showRevenue) tableHeaderHtml += '<th id="total-cost-header" class="headerRow">' + '<span>' + totalRevenueLabel + ' (' + baseCurrency + ')</span></th>';
	
	tableHeaderHtml += '</tr></thead><tbody></tbody>';
	
	jQuery('#assignments-edit-grid>table').append(jQuery(tableHeaderHtml));
	
	if (showRevenue)
	{
		jQuery('#revenue-rate-header').show();
		jQuery('#total-revenue-header').show();
	}
	
	var numScopingActivities = (scopingActivities != undefined ? Object.keys(scopingActivities).length : 0);
	
	jQuery.each(Object.keys(scopingActivities), function (i, key) {
		//draw scoping activity line
		var activity = scopingActivities[key];
		
		var scopingTrHtml = '<tr activity-id="' + key + '" class="activity-row summary-cell summary-row dataRow">';
		
		scopingTrHtml += '<td colspan="2"><span class="fa fa-plus-square" style="color: #888; font-size: 15px;"></span><a href="javascript:void(0);" class="add-link-assignment undecorated-link" style="padding-left: 4px;">{!$Label.AddAssigmentLabel}' + (numScopingActivities > 1 ? ' - ' + activity.Name : '') + '</a></td>';
		
		scopingTrHtml += '<td class="total-expended"></td>';
		scopingTrHtml += '<td class="total-remaining"></td>';
		scopingTrHtml += '<td class="total-planned"></td>';
		scopingTrHtml += '<td class="total-total"></td>';
		scopingTrHtml += '<td class="total-baseline"></td>';
		
		scopingTrHtml += '<td activity-id="' + key + '" id="minStartDateCell"><input id="minStartDate" type="text" class="min-start-date kimbleDatePicker input-date" style="width:65px" /></td>';
		scopingTrHtml += '<td activity-id="' + key + '" id="maxEndDateCell"><input id="maxEndDate" type="text" class="max-end-date kimbleDatePicker input-date" style="width:65px" /></td>';
		
		scopingTrHtml += '<td></td>';
		
		if (showCosts) scopingTrHtml += '<td></td>';
		
		if (showRevenue) scopingTrHtml += '<td></td>';
		
		//if (showCosts) scopingTrHtml += '<td>TOT COST</td>';
		
		//if (showRevenue) scopingTrHtml += '<td>TOT REV</td>';
		
		scopingTrHtml += '</tr>';
		
		jQuery('#assignments-edit-grid>table>tbody').append(jQuery(scopingTrHtml));
		
		jQuery.each(Object.keys(activity.TheAssignments), function (j, assignmentId) {
			
			var assignment = activity.TheAssignments[assignmentId];
			
			if (assignment.EarliestTimeEntryDate != null) 
			{
				jQuery('[activity-id="' + assignment.TheScopingActivityId + '"] .min-start-date').prop('readonly', true);
				jQuery('[activity-id="' + assignment.TheScopingActivityId + '"] .max-end-date').prop('readonly', true);
			}
			
			var assignmentTrHtml = getAssignmentHtml(assignment);
			
			jQuery('#assignments-edit-grid>table>tbody').append(jQuery(assignmentTrHtml));
			
		});
		
		calculateActivityRollups(activity.Id);
	});
	
	calculateAssignmentWarnings();
	
	//Behaviour
	jQuery(document).off('change', '.min-start-date');
	jQuery(document).on('change', '.min-start-date', function() {
		//push change down to all assignments
		var activityId = jQuery(this).closest('tr').attr('activity-id');
		var activity = scopingActivities[activityId];
		startDateChange = true;
		
		var newDate = kimble.parseDate(jQuery(this).val());
		
		jQuery.each(Object.keys(activity.TheAssignments), function(i, key) {
			
			var assignment = activity.TheAssignments[key];
			
			assignment.StartDate = newDate;
			
			recalculateUsage(assignment, true);
		});
		
		startDateChange = false;
	});
	
	jQuery(document).off('click', '.add-link-assignment');
	jQuery(document).on('click', '.add-link-assignment', function () {
		
		var activityId = jQuery(this).closest('tr').attr('activity-id');
		addAssignment(activityId);
	});
	
	jQuery(document).off('click', '.resource-cell');
	jQuery(document).on('click', '.resource-cell', function () {
		assignmentToEdit = getAssignmentForEvent(this);
		activityToEdit = scopingActivities[jQuery(this).closest('tr').attr('activity-id')];
		
		showAssignmentEditPopup(assignmentToEdit);
	});
	
	jQuery(document).off('change', '.resource-input');
	jQuery(document).on('change', '.resource-input', function () {
		
		var text = jQuery(this).val();
		
		if (text == '' || text == null) return;
		
		//verify lookup
		verifyLookup(jQuery(this), resourceKeyPrefix);
	});
	
	jQuery(document).off('change', '.resource-select');
	jQuery(document).on('change', '.resource-select', function () {
		
		var resourceVal = jQuery(this).val();
		if (resourceVal != '')
			assignmentToEdit.ResourceId = resourceVal;
		else
			assignmentToEdit.ResourceId = null;
		
		verifyResource(activityToEdit, assignmentToEdit, 'resource');
	});
	
	jQuery(document).off('change', '.role-select');
	jQuery(document).on('change', '.role-select', function () {
		var roleVal = jQuery(this).val();
		if (roleVal != '')
			assignmentToEdit.ActivityRoleId = roleVal;
		else
			assignmentToEdit.ActivityRoleId = null;
		
		if (activityToEdit.IsRoleMandatory)
			verifyResource(activityToEdit, assignmentToEdit, 'role');
	});
	
	jQuery(document).off('change', '.location-select');
	jQuery(document).on('change', '.location-select', function () {
		var locVal = jQuery(this).val();
		if (locVal != '')
			assignmentToEdit.LocationId = locVal;
		
		if (activityToEdit.IsLocationMandatory)
			verifyResource(activityToEdit, assignmentToEdit, 'location');
	});
	
	jQuery(document).off('change', '.usage-input');
	jQuery(document).on('change', '.usage-input', function () {
		var assignment = getAssignmentForEvent(this);
		
		assignment.RemainingUsage = kimble.parseNumber(jQuery(this).val());
		
		recalculateUsage(assignment, true);
	});
	
	jQuery(document).off('change', '.start-date-input');
	jQuery(document).on('change', '.start-date-input', function () {
		var assignment = getAssignmentForEvent(this);
		
		assignment.StartDate = kimble.parseDate(jQuery(this).val());
		
		recalculateUsage(assignment, true);
	});
	
	jQuery(document).off('change', '.end-date-input');
