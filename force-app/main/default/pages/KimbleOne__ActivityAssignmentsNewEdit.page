	if (assignment.ActualUsage == null) assignment.ActualUsage = 0;
	
	tr += '<td class="actual-usage-cell">' + kimble.formatNumber(assignment.ActualUsage, '0.##') + '</td>';
	
	var usageReadOnly = '';
	
	if (usageBehaviourRule != undefined && (usageBehaviourRule.EntrySpecification == 'DerivedUsage' || usageBehaviourRule.EntrySpecification == 'TaskUsage' || (usageBehaviourRule.FixedUsage && assignment.Id.substr(0,1) != '_'))) usageReadOnly = ' readonly ';
	var usageVal = '';
	if (assignment.RemainingUsage != null) usageVal = kimble.formatNumber(assignment.RemainingUsage, '#.##');
	
	tr += '<td class="usage-cell"><input ' + usageReadOnly + 'type="text" class="usage-input" value="' + usageVal + '"></input></td>';
	
	var taskUsage = 0;
	
	if (theTaskAssignments != null && theTaskAssignments[assignment.Id] != null)
	{
		jQuery.each(Object.keys(theTaskAssignments[assignment.Id]), function (i, key) {
			taskUsage += theTaskAssignments[assignment.Id][key].RemainingEffort * assignment.UsageToHourConversionFactor / assignment.ForecastToHourConversionFactor;
		});
	}
	
	var taskTolerance = 1.05;
	
	var taskToleranceClass = '';
	var taskTitle = '';
	if (taskUsage * taskTolerance < assignment.RemainingUsage)
	{
		taskToleranceClass = 'task-tolerance-warning';
		taskTitle = '{!JSENCODE($Label.UsageExceedsPlannedEffortLabel)}';
	}
	
	if (taskUsage > assignment.RemainingUsage * taskTolerance)
	{
		taskToleranceClass = 'task-tolerance-error';
		taskTitle = '{!JSENCODE($Label.PlannedEffortExceedsUsageLabel)}';
	}
		
	tr += '<td class="task-usage-cell ' + taskToleranceClass + '" title="' + taskTitle + '">' + kimble.formatNumber(taskUsage, '0.##') + '</td>';
	
	tr += '<td class="total-usage-cell">' + kimble.formatNumber(assignment.ActualUsage + assignment.RemainingUsage, '0.##') + '</td>';
	
	tr += '<td class="baseline-usage-cell">' + (assignment.BaselineUsage != null ? kimble.formatNumber(assignment.BaselineUsage, '0.##') : '') + '</td>';
	
	
	//++START DATE
	tr += '<td class="start-date-cell"><input ' + (usageBehaviourRule != undefined && usageBehaviourRule.EntrySpecification == 'TaskUsage'?'disabled':'') + ' start-date="true" activity-id="' + assignment.TheScopingActivityId + '" assignment-id="' + assignment.Id + '" type="text" class="start-date-input kimbleDatePicker input-date" value="' + kimble.formatDate(assignment.StartDate) + '"></input></td>';
	
	var endDateDisabled = '';
	
	//++END DATE
	if (usageBehaviourRule != undefined && (usageBehaviourRule.EntrySpecification == 'DerivedEndDate' || usageBehaviourRule.EntrySpecification == 'TaskUsage')) 
		endDateDisabled = 'disabled';
	
	tr += '<td class="end-date-cell"><input ' + endDateDisabled + ' end-date="true" activity-id="' + assignment.TheScopingActivityId + '" assignment-id="' + assignment.Id + '"  type="text" class="end-date-input kimbleDatePicker input-date" value="' + kimble.formatDate(assignment.EndDate) + '"></input></td>';
	
	//++UTILISATION
	var utilisationReadOnly = '';
	var utilisationVal = '';
	if (assignment.Utilisation != null) utilisationVal = kimble.formatNumber(assignment.Utilisation, '#');
	if (usageBehaviourRule != undefined && (usageBehaviourRule.EntrySpecification == 'DerivedUtilisation' || usageBehaviourRule.EntrySpecification == 'TaskUsage')) utilisationReadOnly = ' readonly ';
	tr += '<td class="utilisation-cell"><input ' + utilisationReadOnly + '  type="text" class="utilisation-input" value="' + utilisationVal + '"></input></td>';
	
	//++COST RATE SUMMARY
	if (jQuery('#cost-rate-header').length > 0) //show costs
	{
		var costRateReadOnly = '';
		
		if (!activity.CanEditCostRate) costRateReadOnly = ' readonly ';
		
		var costRateValue = '';
		var costRateInfo = '';
		
		if (assignment.CostRateSummary != null)
		{
			var costRateSummary = parseCostSummaryJson(assignment.CostRateSummary);
			if (costRateSummary.length > 0)
			{
				var costRate = costRateSummary[0].R * assignment.ForecastToInvoiceConversionFactor;
				costRateValue = jQuery.formatNumber(costRate, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false});
				
				if (costRateSummary.length > 1)
				{
					costRateInfo = '<span class="fa fa-info-circle future-cost-change"/>';
				}
			}
		}
		
		tr += '<td class="cost-rate-cell">' + costRateValue + ' ' + costRateInfo + '</td>'
	}
	
	//++REVENUE RATE SUMMARY
	if (showRevenue)
	{
		tr += '<td class="revenue-rate-cell">';
		
		if (activity.HasRevenue)
		{
			var revRateValue = '';
					
			if (assignment.InvoicingCurrencyForecastRevenueRate != null)
			{
				revRateValue = jQuery.formatNumber(assignment.InvoicingCurrencyForecastRevenueRate * assignment.ForecastToRevenueConversionFactor, {format: "#,##0.00", locale:kimble.locale, isFullLocale:false});
			}
			
			tr += revRateValue;

		}
		
		tr += '</td>';
	}
	
	//Total cost
	//tr += '<td>33</td>';
	
	
	//Total revenue
	//tr += '<td>99</td>';
	
	tr += '</tr>';
	
	return tr;
}

function findUsageBehaviourRule(activity, id)
{
	var match;
	jQuery.each(activity.TheUsageBehaviourRules, function(i, rule) {
	
		if (rule.Id == id) match = rule;
	
	});
	
	return match;
}

function findLocation(id)
{
	var match;
	jQuery.each(locationOptions, function(i, location) {
	
		if (location.id == id) match = location.text;
	
	});
	
	return match;
}

function recalculateUsage(assignment, andSave, supressRecalculateWarnings)
{
	if (assignment.ResourceId == null) return;
	
	var resource = scopingActivities[assignment.TheScopingActivityId].TheResources[assignment.ResourceId];
	
	var availability = new ResourceAvailabilityUsagePattern(resource.AvailabilityPattern);
	
	var assignmentUsage;
	
	if (assignmentUsagePatternMap[assignment.Id] == null)
	{
		assignmentUsage = new ActivityAssignmentUsagePattern(assignment.HoursPerDay, assignment.StartDate.toDate(), assignment.UsagePattern, assignment.Utilisation, assignment.Utilisation);
	}
	else
	{
		assignmentUsage = assignmentUsagePatternMap[assignment.Id];
	} 
	
	var entrySpecification = findUsageBehaviourRule(scopingActivities[assignment.TheScopingActivityId], assignment.UsageBehaviourRuleId).EntrySpecification;
	
	try
	{
		if (entrySpecification == "DerivedUsage" || assignment.IsUsageProfiled)
		{
			if (assignment.Utilisation == null) return;

			if (assignment.EndDate == null) return;

			assignmentUsage = assignmentUsage.createForDerivedUsage(assignment.StartDate.toDate(), assignment.EndDate.toDate(), assignment.Utilisation ,availability, assignment.IsUsageProfiled ? findUsageBehaviourRule(scopingActivities[assignment.TheScopingActivityId], assignment.UsageBehaviourRuleId).StartDateRule : null, assignment.HoursPerDay);

			var newUsageInHours = assignmentUsage.totalForecastUsageInHours;
			var newUsageInForecastUnits = newUsageInHours / assignment.ForecastToHourConversionFactor;

			assignment.RemainingUsage = newUsageInForecastUnits;
			assignment.UnforecastUsage = 0;
		}
		else if (entrySpecification == "DerivedEndDate")
		{
			if (assignment.RemainingUsage == null) return;
		
			if (assignment.Utilisation == null || assignment.Utilisation <= 0) return;
			
			var usageInHours = assignment.RemainingUsage * assignment.ForecastToHourConversionFactor;
			
			if (assignment.UnforecastUsage != null && assignment.UnforecastUsage != 0) usageInHours += assignment.UnforecastUsage * assignment.ForecastToHourConversionFactor;
				
			assignmentUsage = assignmentUsage.createForDerivedEndDate(assignment.StartDate.toDate(), usageInHours, assignment.Utilisation, availability, assignment.HoursPerDay);
			
			assignment.EndDate = assignmentUsage.endDate.toKimbleUTC();
			
			assignment.RemainingUsage = assignmentUsage.totalForecastUsageInHours / assignment.ForecastToHourConversionFactor;
				
			assignment.UnforecastUsage = 0;
			
		}
		else if (entrySpecification == "DerivedUtilisation")
		{
			if (assignment.RemainingUsage == null) return;
			
			if (assignment.EndDate == null) return;
			
			var remainingUsageInHours = assignment.RemainingUsage * assignment.ForecastToHourConversionFactor;
			
			if (assignment.UnforecastUsage != null && assignment.UnforecastUsage != 0) remainingUsageInHours += assignment.UnforecastUsage * assignment.ForecastToHourConversionFactor;
			
			assignmentUsage = assignmentUsage.createForDerivedUtilisation(assignment.StartDate.toDate(), assignment.EndDate.toDate(), remainingUsageInHours, availability, assignment.HoursPerDay);
			
			assignment.RemainingUsage = assignmentUsage.totalForecastUsageInHours / assignment.ForecastToHourConversionFactor;
			assignment.UnforecastUsage = (remainingUsageInHours - assignmentUsage.totalForecastUsageInHours) / assignment.ForecastToHourConversionFactor;
			assignment.Utilisation = assignmentUsage.targetUtilisation;
			
		}
		else if (entrySpecification == "TaskUsage")
		{
			//build task usage map based on theTaskAssignments;
			//theTaskAssignments
			var tasks = theTaskAssignments[assignment.Id];
			var taskUsage = [];
			
			var totalRemainingUsageInHours = 0;
			
			if(tasks != undefined)
			{
				Object.keys(tasks).forEach(function(taskId){
					var remainingInHours = tasks[taskId].RemainingEffort * assignment.UsageToHourConversionFactor;
					
					// dates on tasks are actually optional through config - defensive condition for this scenario
					if(tasks[taskId].StartDate != null && tasks[taskId].EndDate != null)
						taskUsage.push({StartDate:tasks[taskId].StartDate.toDate(),EndDate:tasks[taskId].EndDate.toDate(), RemainingUsageInHours:remainingInHours});
					
					totalRemainingUsageInHours += remainingInHours;
				});
			}
			
			assignmentUsage = assignmentUsage.createFromDateRangeForecast(assignment.EarliestTimeEntryDate == null?null:assignment.EarliestTimeEntryDate.toDate(), assignment.LatestTimeEntryDate == null?null:assignment.LatestTimeEntryDate.toDate(), taskUsage, availability, assignment.HoursPerDay);
				
			assignment.StartDate = assignmentUsage.startDate.toKimbleUTC();
			assignment.EndDate = assignmentUsage.endDate.toKimbleUTC();
			assignment.RemainingUsage = assignmentUsage.totalForecastUsageInHours / assignment.ForecastToHourConversionFactor;
			assignment.Utilisation = assignmentUsage.targetUtilisation; 
			
			assignment.UnforecastUsage = (roundTo2dp(totalRemainingUsageInHours) - roundTo2dp(assignmentUsage.totalForecastUsageInHours)) / assignment.ForecastToHourConversionFactor;			
		}
		
		if (assignmentUsage == null) return;
		
		assignment.UsagePattern = assignmentUsage.usagePattern;
		
		assignmentUsagePatternMap[assignment.Id] = assignmentUsage;
		
		if (!andSave) return;
		
		assignment.HasChanges = true;
		
		scopingActivities[assignment.TheScopingActivityId].TheAssignments[assignment.Id] = assignment;
		
		var assignmentTrHtml = getAssignmentHtml(assignment);
		
		if (jQuery('#' + assignment.Id).length == 1)
			jQuery('#' + assignment.Id).replaceWith(jQuery(assignmentTrHtml));
		else
			jQuery('#assignments-edit-grid>table>tbody').append(jQuery(assignmentTrHtml));
		
		if (!startDateChange && !endDateChange)
			calculateActivityRollups(assignment.TheScopingActivityId);

		jQuery.publish('kimble.assignmentChanged', {assignment:assignment, activity:scopingActivities[assignment.TheScopingActivityId]});
		
		if(!supressRecalculateWarnings) calculateAssignmentWarnings(assignment.Id);
		
		jQuery('#remote-action-error-text').text('');
		jQuery('#remote-action-error').hide();
	}
	catch(e)
	{
		//console.trace();
		
		if (kimble.labels[e] == null)
		{
			jQuery('#remote-action-error-text').text(e);
		}
		else
		{
			jQuery('#remote-action-error-text').text(kimble.labels[e]);
		}
		
		jQuery('#remote-action-error').show();
		
		//jQuery('#' + assignment.Id).find('.usage-cell').append(jQuery(errorHtml));     		
	}
}

var assignmentWarnings = {};

function calculateAssignmentWarnings(assignmentId)
{
	// assignment warnings off by default in upgrading orgs
	if(enableTrackingPlanUsageWarnings)
	{
		// if(assignmentId == null) traceAction('Calculate All Assignment Warnings');

		jQuery.each(Object.keys(scopingActivities), function(k, key) {
			
			var activity = scopingActivities[key];
			
			jQuery.each(Object.keys(scopingActivities[key].TheAssignments), function (j, assId) {
				
				if (assId == assignmentId || assignmentId == null)
				{
					//do calculation
					var assignment = scopingActivities[key].TheAssignments[assId];
					var resource = scopingActivities[key].TheResources[assignment.ResourceId].Resource;
					var availability = new ResourceAvailabilityUsagePattern(scopingActivities[key].TheResources[assignment.ResourceId].AvailabilityPattern);
					
					if (resource.MaximumUtilisation != null)
					{
						//if(assignmentId != null) traceAction('Calculate Assignment Warnings for assignment ' + assignmentId);
						
						assignmentWarnings[assId] = {resourceId: assignment.ResourceId,dates:{}, assignedBeforeStart:resource.StartDate != null && resource.StartDate.toDate() > assignment.StartDate.toDate(), assignedAfterEnd:resource.EndDate != null && resource.EndDate.toDate() < assignment.EndDate.toDate()};
					
						jQuery.each(assignment.UsagePattern.split(','), function (i, dayUsage) 
				  		{  			
				 			if (dayUsage == '') return true;
				 			
				 			var contextDay = new Date(assignment.StartDate.toDate().getFullYear(), assignment.StartDate.toDate().getMonth(), assignment.StartDate.toDate().getDate() + i, 0, 0, 0, 0);
				 			
				 			if (availability.isUnavailableDate(contextDay))
				 			{
				 				assignmentWarnings[assId].dates[contextDay.toKimbleUTC()] = {isUnavailable:true};
				 			}
				 			else
				 			{
					 			var usage = dayUsage.split(':')[0]; 
					 			var actual = dayUsage.split(':')[1];
					 				
					 			if (usage != undefined )
					 			{ 				
					      			var usageAsPercent = 0;
					      			
					      			if (usage == NONFORECASTDAY || usage == CLOSEDDAY)
					      			{
					      				usageAsPercent = 0;
					      			}
					      			else
					      			{
										var dayUsage = KeyToHoursUsagePatternMap[usage];
								
										if (dayUsage == null) // percentage usage
											usageAsPercent = new Number(usage);
										else
											usageAsPercent = new Number(dayUsage) / assignment.HoursPerDay * 100;
					      			}
					      			
					      			if (usageAsPercent > 0)
					      			{
					      				var isOverUtilisedOnAssignment = (usageAsPercent > resource.MaximumUtilisation);
					      				
					      				var isOverUtilisedAllAssignments = false;
					      				var hasImportantEvent = false;
					      				var requiredUsage = usageAsPercent * assignment.HoursPerDay / 100;
					      				
					      				if (resource != null)
					      				{
					      					var aggregate = resource.AggregatePattern[contextDay.toKimbleUTC()];
											
											if (aggregate != null)
											{
												var aggregateBeforeAdditionOfThisAssignment = aggregate.agg;
												var totalAggregate = aggregate.agg;
												
												if(assignment.IncludeInAggUtilisation == null)  assignment.IncludeInAggUtilisation = defaultIncludeInAggregate;
												
												if (assignment.IncludeInAggUtilisation) totalAggregate += usageAsPercent;
												
												if (aggregateBeforeAdditionOfThisAssignment > 0 && totalAggregate > resource.MaximumUtilisation)
													isOverUtilisedAllAssignments = true;
											}
											
											if (resource.UserId != null && activity.ResourceEvents[resource.UserId] && activity.ResourceEvents[resource.UserId][contextDay.toKimbleUTC()] != null)
												hasImportantEvent = true;
					      				}
					      				
					      				if (isOverUtilisedOnAssignment || isOverUtilisedAllAssignments || hasImportantEvent)
					      				{
					      					assignmentWarnings[assId].dates[contextDay.toKimbleUTC()] = {requiredUsage:requiredUsage, isOverUtilisedOnAssignment:isOverUtilisedOnAssignment,isOverUtilisedAllAssignments:isOverUtilisedAllAssignments,hasImportantEvent:hasImportantEvent};
					      				}
					      			}
					      		}
					      	}
						});
					}
					
					// we can exit the each as we've processed the assignment
					if(assignmentId != null && assId == assignmentId) return false;
				}
			});	
			
		});
		
		jQuery.publish('kimble.assignmentWarning', assignmentWarnings);
	}
}

function resourceAvailabilityOverlay(date) 
{
	var assignmentId = jQuery(this).attr('assignment-id');
	
	if (assignmentId == null) return [true, null];
	
	var activityId = jQuery(this).attr('activity-id');
	
	var activity = scopingActivities[activityId];
	var assignment = activity.TheAssignments[assignmentId];
	
	if (assignment == null) assignment = assignmentToEdit;
	
	var resource = activity.TheResources[assignment.ResourceId];
	
	var earliestOpenDate = activity.EarliestAssignableDate.toDate();
	
	var availabilityStartDate = resource.AvailabilityPattern.StartDate.toDate();
	
	var earliestOffsetInDays = Math.round((date.getTime() - earliestOpenDate.getTime()) / (1000*60*60*24));
	
	var availabilityOffsetInDays = Math.round((date.getTime() - availabilityStartDate.getTime()) / (1000*60*60*24));
	
	if (earliestOffsetInDays < 0)
		return [false,"closedperiod","Closed Period"];
		
	if (availabilityOffsetInDays < 0)
		return [true,"closedperiod","Closed Period"];
	
	//Start date cannot be after earliest time entry
	if (jQuery(this).attr('start-date') == 'true' && assignment.EarliestTimeEntryDate != null && date > assignment.EarliestTimeEntryDate.toDate())
		return [false, "closedperiod", "Time Entry Exists"];
	
	//End date cannot be before latest time entry
	if (jQuery(this).attr('end-date') == 'true' && assignment.LatestTimeEntryDate != null && date < assignment.LatestTimeEntryDate.toDate())
		return [false, "closedperiod", "Time Entry Exists"];
	
	var availabilityChar = resource.AvailabilityPattern.UsagePattern.substring(availabilityOffsetInDays,availabilityOffsetInDays + 1);
	
	if (availabilityChar == '|')
		return [false,"closedperiod","Closed Period"];
	
	if (availabilityChar == '!')
		return [false,"Unavailable","Unavailable"];
	
	if (availabilityChar == '-')
		return [false,"NonBusDay","Non business day"];
	
	var dayUsage = resource.Resource.AggregatePattern[date.toKimbleUTC()];
	
	if (dayUsage == null) return [true, null];
	
	var prob = dayUsage.p;
	
	if (prob == null) return [true, null];
	
	return [true, classificationStyleMap[Object.keys(prob)[0].Cls] + ' no-background'];
	
}

function kimbleOpenLookup(obj, typ)
{
	var inp = jQuery(obj).prev();
	//openLookup(KimbleLookupPage + '?lknm=' + inp.attr('id') + '&lktp=' + typ,670,'1','&lksrch=' + escape(inp.val()));
	kimblePopup = window.open(KimbleLookupPage + '?lknm=' + inp.attr('id') + '&lktp=' + typ + '&lksrch=' + escape(inp.val()), "lookup", "width=670,height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", false);
}

function closeKimblePopup()
{
	if (kimblePopup != null) kimblePopup.close();
}

//Generic response
function kimblePickValue(objId, resultId, resultName)
{
	closeKimblePopup();
	
	var obj = jQuery('#' + objId);
	obj.attr('data-id', resultId).val(resultName);
	
	if (jQuery('#' + objId).hasClass('resource-input'))
	{
		assignmentToEdit.ResourceId = resultId;
		verifyResource(activityToEdit, assignmentToEdit, 'resource');
	}
	else		
	{
		assignmentToEdit.LocationId = resultId;
		
		if(activityToEdit.IsLocationMandatory)
			verifyResource(activityToEdit, assignmentToEdit, 'location');
	}	
}

function getUniqueId()
{
	  // Math.random should be unique because of its seeding algorithm.
	  // Convert it to base 36 (numbers + letters), and grab the first 9 characters
	  // after the decimal.
	  return '__' + Math.random().toString(36).substr(2, 9);
}

	
	
