<apex:page standardcontroller="KimbleOne__Resource__c" extensions="KimbleOne.ResourceConsultantDemandPrefSmryCntrllr" lightningStyleSheets="true" tabStyle="KimbleOne__ReferenceData__c" sidebar="false" >
    <apex:composition template="KimbleOne__SiteMaster">

    <apex:define name="Content">

        <style>
            /* Custom LEX styling */
            li.slds-item:hover {
                cursor: pointer;
                color: rgba(0, 68, 135, 1);
                background-color: rgb(244, 246, 249);
            }
            span.slds-icon_container {
                font-size: 18px;
                padding: 4px;
            }
            /* page style */
            .nothing-here {
                padding: 20px;
                font-size: 14px;
                border: 2px dashed #bbbbbb;
                margin: 11px 2px;
                background-color: lemonchiffon;
                text-align: center;
            }
            span.slds-icon_container.open-demands {
                background-color: #1797c0 !important;
                color: white;
            }
            span.srch-list-stat {
                font-size: 20px;
                font-weight: bold;
                margin-left: 60px;
            }
            span.list-stat {
                font-size: 20px;
                font-weight: bold;
                position: absolute;
                right: 10px;
                top: 3px;
            }
            li.srch {
                position: relative;
            }
            .list-stats {
                position: absolute;
                top: 2px;
                right: 12px;
                text-align: right;
            }
            .itm-pref {
                display: inline-block;
                position: relative;
                margin-left: 12px;
            }
            .itm-pref .list-mini-stat {
                position: absolute;
                top: -6px;
                font-size: 12px;
                right: -12px;
                text-align: left;
                display: inline-block;
                width: 10px;
            }
            .itm-pref i.fa {
                font-size: 16px;
            }
            .itm-pref.IdealRole i.fa {
                color: gold;
            }
            .itm-pref.Consider i.fa {
                color: #008852;
            }
            .itm-pref.DoNotConsider i.fa {
                color: #ff4040;
            }
            li.slds-item {
                position: relative;
            }
            .slds-card__body.slds-card__body_inner.fixed-height-w-of {
                overflow: auto;
                height: 180px;
            }
        </style>

    <apex:slds />

    <div class="slds-scope">
        <article class="slds-card open-demand-searches">
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__figure">
                    <span class="slds-icon_container open-demands">
                      <i class="fa fa-search card-icon"></i>
                    </span>
                    </div>
                    <div class="slds-media__body">
                        <h2 class="slds-card__header-title">
                            <a href="javascript:void(0);" class="slds-card__header-link slds-truncate adl" title="{!$Label.kimbleone__mydemandsearches}">
                                <apex:outputText value="{!$Label.kimbleone__mydemandsearches}"></apex:outputText>
                            </a>
                        </h2>
                    </div>
                    <div class="slds-no-flex">
                        <button class="slds-button slds-button_neutral ns"><apex:outputText value="{!$Label.kimbleone__new}" title="{!$Label.kimbleone__expressinterestcreatesearch}"/></button>
                    </div>
                </header>
            </div>
            <div class="slds-card__body slds-card__body_inner fixed-height-w-of">
                <ul class="slds-has-dividers_around-space">
                    <apex:repeat value="{!DemandSearches.OpenSearches}" var="openSearch">
                        <li class="slds-item srch" srch-id="{!openSearch.Id}">
                            <apex:outputText value="{!openSearch.Name}"></apex:outputText>
                            <div class="list-stats">
                                <apex:outputPanel layout="none" rendered="{!openSearch.NumIdeal > 0}">
                                    <div class="itm-pref IdealRole" title="{!JSENCODE($Label.DemandSearchIdeal)}">
                                        <i class="fa fa-star"></i>
                                        <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumIdeal}"></apex:outputText>
                                    </div>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!openSearch.NumConsider > 0}">
                                    <div class="itm-pref Consider" title="{!JSENCODE($Label.DemandSearchConsider)}">
                                        <i class="fa fa-flip-horizontal fa-thumbs-o-up"></i>
                                        <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumConsider}"></apex:outputText>
                                    </div>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!openSearch.NumDoNotConsider > 0}">
                                    <div class="itm-pref DoNotConsider" title="{!JSENCODE($Label.DemandSearchDoNotConsider)}">
                                        <i class="fa fa-flip-horizontal fa-thumbs-o-down"></i>
                                        <apex:outputText styleClass="list-mini-stat" value="{!openSearch.NumDoNotConsider}"></apex:outputText>
                                    </div>
                                </apex:outputPanel>
                                <apex:outputText styleClass="srch-list-stat" value="{!openSearch.NumMatches}"></apex:outputText>
                            </div>
                        </li>
                    </apex:repeat>
                </ul>
                <apex:outputPanel layout="none" rendered="{!DemandSearches.OpenSearches.size == 0}">
                <div class="nothing-here"><apex:outputText value="{!$Label.kimbleone__expressinterestnosearches}"></apex:outputText></div>
                </apex:outputPanel>
            </div>
        </article>
    </div>
    <script>
        jQuery(window).load(function()
        {
            initialiseDemandSummary();
        });

        function initialiseDemandSummary()
        {
            initialiseActions();
        }

        function initialiseActions()
        {
            jQuery(document).off('click', '.adl').on('click', '.adl', openDemandList);
            jQuery(document).off('click', '.srch').on('click', '.srch', openSearch);
            jQuery(document).off('click', '.ns').on('click', '.ns', createNewSearch);
        }

        function openDemandList()
        {
            safeRedirectParentToSForceURL('/{!$ObjectType.KimbleOne__ActivityAssignmentDemandSearch__c.keyPrefix}');
        }

        function openSearch()
        {
            safeRedirectParentToSForceURL('/' + jQuery(this).attr('srch-id'));
        }

        function createNewSearch()
        {
            safeRedirectParentToSForceURL('{!$Page.KimbleOne__ActivityAssignmentDemandSearch}');
        }
    </script>
    </apex:define>
    </apex:composition>
</apex:page>