<apex:page standardController="KimbleOne__FlexibleTemplate__c" extensions="KimbleOne.FlexibleTemplateEditController" showHeader="true" sidebar="false" tabStyle="KimbleOne__FlexibleTemplate__c">

<apex:composition template="KimbleOne__SiteMaster">
    <apex:define name="Menu">
    </apex:define>
    
    <apex:define name="Content">
    	<apex:form id="theDetail">
    	<apex:detail subject="{!KimbleOne__FlexibleTemplate__c}" inlineEdit="true" relatedList="false"/>
		<apex:commandButton id="buildConfigurationData" action="{!BuildConfigurationData}" value="{!$Label.kimbleone__rebuildconfigurationdatalabel}" rerender="theDetail" rendered="{!ShowBuildConfigButton}"/>				
		</apex:form>
		
 			<apex:form id="theFlexibleItemTemplate" enctype="multipart/form-data">
    		
    			<apex:outputPanel id="pageErrors">
    				<apex:pageMessages escape="false" />
				</apex:outputPanel>
    			
    			<apex:pageBlock mode="edit">
    				<apex:pageBlockButtons location="top">
    					<apex:commandButton action="{!ImportFlexibleTemplateItemAll}" value="{!$Label.kimbleone__importlabel} {!$Label.kimbleone__all} {!$ObjectType.KimbleOne__FlexibleTemplateItem__c.LabelPlural}" />
    				</apex:pageBlockButtons>
    				
    				<apex:pageBlockSection columns="2">
    					<apex:pageBlockSectionItem >
    						<apex:outputText value="{!$Label.kimbleone__importfromfilelabel}" />
    						<apex:inputFile value="{!TheImport.body}" filename="{!TheImport.name}" contentType="{!TheImport.ContentType}" />
    					</apex:pageBlockSectionItem>
    					
    				</apex:pageBlockSection>
    				
    			</apex:pageBlock>
 			</apex:form>

 			<apex:form id="theFlexibleTemplate" enctype="multipart/form-data">
    		
    			<apex:outputPanel id="pageErrors">
    				<apex:pageMessages escape="false" />
				</apex:outputPanel>
    			
    			<apex:pageBlock mode="edit">
    				<apex:pageBlockButtons location="top">
    					<apex:commandButton action="{!ImportFlexibleTemplate}" value="{!$Label.kimbleone__importlabel} {!$ObjectType.KimbleOne__FlexibleTemplate__c.Label}" />
    				</apex:pageBlockButtons>
    				
    				<apex:pageBlockSection columns="2">
    					<apex:pageBlockSectionItem >
    						<apex:outputText value="{!$Label.kimbleone__importfromfilelabel}" />
    						<apex:inputFile value="{!TheImport.body}" filename="{!TheImport.name}" contentType="{!TheImport.ContentType}" />
    					</apex:pageBlockSectionItem>
    					
    				</apex:pageBlockSection>
    				
    			</apex:pageBlock>
 			</apex:form>

		<apex:form >
			<apex:commandlink >
				<a href="{!$Page.KimbleOne__FlexibleTemplateExport}?id={!JSINHTMLENCODE(KimbleOne__FlexibleTemplate__c.Id)}">{!$Label.kimbleone__exportlabel} {!$ObjectType.KimbleOne__FlexibleTemplate__c.Label}</a>
			</apex:commandlink>
		</apex:form>	
		
		<apex:form >
			<apex:commandlink >
				<a href="{!$Page.KimbleOne__FlexibleTemplateExport}?id=123">{!$Label.kimbleone__exportlabel} {!$Label.kimbleone__all} {!$ObjectType.KimbleOne__FlexibleTemplateItem__c.LabelPlural}</a>	
			</apex:commandlink>
		</apex:form> 			
 													
	</apex:define>		
</apex:composition>

</apex:page>