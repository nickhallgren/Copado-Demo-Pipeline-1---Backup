            Handlebars.registerHelper('renderText', function(type, values){

              if (type == null) return '';

              if (type.Type == 'ObjectReference')
              {
                  //name expected in pos 1, id in pos 2
                  if (values.length == 1) return '';

                  if (type.PageUrl != null)
                  {
                    return '<span class="custom-tooltip" data-tt-url="' + type.PageUrl + values[1] + '">' + values[0] + '</span>';
                  }

                  var uniqueId =  '__ObjRef__' + Math.random().toString(36).substr(2, 9);
                  var onblurMouseOutValue = "safeHideSFInlineHover('" + uniqueId + "');";
	              var onfocusMouseOverValue = "safeShowSFInlineHover('" + uniqueId + "', '" + values[1] + "');"

                    //want to support hovers - with page overrides
                  return '<a href="/' + values[1] + '" id="' + uniqueId + '" onblur="' + onblurMouseOutValue + '" onfocus="' + onfocusMouseOverValue + '" onmouseout="' + onblurMouseOutValue + '" onmouseover="' + onfocusMouseOverValue + '">' + values[0] + '</a>';
              }

              if (type.Type == 'Text')
              {
                  return values.join(' ');
              }

              if (type.Type == 'Numeric2dp')
              {
                var fValues = [];

                for (var valCount = 0; valCount < values.length; valCount++)
                fValues.push(kimble.formatNumber(values[valCount], '#,###.##'));

                return fValues.join(' ');
              }

              if(type.Type == 'Currency')
              {
                if (values.length != 2) return '';

                return values[1] + ' ' + kimble.formatNumber(values[0], '#,###');
              }

              return 'Unknown type ' + type.Type;
            });

