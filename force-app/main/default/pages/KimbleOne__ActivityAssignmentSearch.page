// ################ drag - drop assignments #############################################


            /*jQuery(document).on('mousedown','.ui-resizable-e', function(event){
                console.log('resizeable');
                extendingAssignment = true;
            });*/

            //extendingAssignment = false;

            jQuery(document).off('mousedown', '#container[mode="view"] .can-reassign');
            jQuery(document).on('mousedown', '#container[mode="view"] .can-reassign', function (event) {

                //if (extendingAssignment) return;

                if (jQuery(event.target).hasClass('ui-resizable-handle')) return;

                if (event.which != 1) return ;

                var $ganttNode = jQuery(this);
                var theAssignment = theAssignments[$ganttNode.attr('object-id')];

                var intRightHandler = null;
                var intLeftHandler = null;
                var intTopHandler = null;
                var intBottomHandler = null;
                var distance = 70;
                var timer = 100;
                var step = 30;
                var m;
                var dragContext;
                var mouseOffsetLeft;
                var mouseOffsetTop;
                var context = ActivityAssignmentNewEdit;

                var clearScrolling = function () {
                    clearInterval(intRightHandler);
                    clearInterval(intLeftHandler);
                    clearInterval(intTopHandler);
                    clearInterval(intBottomHandler);
                }

                var getDragDay = function (event) {
                    //if (extendingAssignment) return;

                    var d = jQuery('.drag-active-day').attr('dte');

                    if (d == '' || d == null) return null;

                    var $c = jQuery('.active-resource');

                    var resourceId;
                    var parentId;

                    if ($c.parent().hasClass('child')) {
                        resourceId = theAssignments[$c.closest('.child-container').attr('obj-id')].ResourceId;
                        parentId = $ganttNode.closest('.parent-container').attr('obj-id');
                    }
                    else {
                        resourceId = $c.closest('.parent-container').attr('obj-id');
                        parentId = resourceId;
                    }

                    if (matchingResources[resourceId].ResourceType.HasMembers) return null;

                    return {
                        StartDate:new Date(new Number(d)), ResourceId:resourceId, ParentId:parentId
                    };
                }

                var onstart = function (ele) {

                    mouseOffsetLeft = event.clientX - ele.offset().left - 2;
                    mouseOffsetTop = event.offsetY + 6;

                    ele.addClass('assignment-moving');
                    ele.append('<div class="moving-dates">' + kimble.regional.dayNames[theAssignment.StartDate.toDate().getDay()] + ' ' + kimble.formatDate(theAssignment.StartDate) + '</div>');
                    m = parseInt(ele.css('margin-left'));

                    onmove(event);
                };

                var onstop = function (ele) {

                    var oncancel = function () {
                        ele.removeClass('assignment-moving').find('.moving-dates').remove(); ;
                        ele[0].style.left = "0px";
                        ele[0].style.top = "0px";
                        jQuery('.drag-active-day').removeClass('drag-active-day');
                        jQuery('.active-resource').removeClass('active-resource');
                    }

                    clearScrolling();
                    var dropContext = getDragDay();

                    if (dropContext == null) {
                        oncancel();
                    }
                    else if (dropContext.StartDate.toKimbleUTC() == theAssignment.StartDate && dropContext.ResourceId == theAssignment.ResourceId) {
                        oncancel();
                    }
                    else {
                        ele.append('<i class="fa fa-circle-o-notch fa-spin"/>');

                        var onOk = function () {
                            jQuery('.drag-active-day').removeClass('drag-active-day');
                            jQuery('.active-resource').removeClass('active-resource');

                            //moves gantt back

                            oncancel();
                            // need to remove old row and create placeholder new row 1st most underneath parent with

                            ele.closest('.child-container').remove();

                            //insert underneath parent or after child - and add refreshing icon

                            //if resource based parent = dropContext.ResourceId
                            //else parent is assignment parent

                            var $p = jQuery('.parent-container[obj-id="' + dropContext.ParentId + '"]');
                            var $parent = $p.find('>.children');

                            // Need to replace entire-row with pure placeholder!
                            var $child = jQuery(handlebarsTemplates['child-row-placeholder-template'].call(this, {
                                Id:theAssignment.Id, ParentId:dropContext.ParentId, Name:'{!JSENCODE($Label.Label031)}'.format(matchingResources[dropContext.ResourceId].Name)
                            }));

                            $child.find('.gantt-cells').append(handlebarsTemplates['gantt-placeholder-template'].call(this, {
                                StartDate: dropContext.StartDate.toKimbleUTC(), EndDate:kimble.addDays(dropContext.StartDate, days_between(theAssignment.EndDate.toDate(), theAssignment.StartDate.toDate())).toKimbleUTC()
                            }));

                            $parent.prepend($child);

                            if (!$p.hasClass('expanded')) {
                                $p.find('.toggle-icon').click();
                            }

                            context.quickAssign($ganttNode.attr('object-id'), dropContext.ResourceId, dropContext.StartDate.toKimbleUTC(), function () {
                                refreshChild(theAssignment.Id);

                                //refresh this.
                                refreshResourceAggregateGantt(theAssignment.ResourceId);

                                if (dropContext.ResourceId != theAssignment.ResourceId) {
                                    refreshResourceAggregateGantt(dropContext.ResourceId);
                                }
                            }, function () {
                                //oncancel
                            }, function(message) {
                                //on error
                                $child.find('.fa').replaceWith('<i class="fa fa-exclamation-circle" style="color:red;" title="' + message + '"/>');

                            });

                        };

                        var q;

                        if (dropContext.ResourceId == theAssignment.ResourceId) {
                            q = '{!JSENCODE($Label.Label029)}'.format(kimble.formatDate(dropContext.StartDate.toKimbleUTC()));
                        }
                        else {
                            q = '{!JSENCODE($Label.Label030)}'.format(matchingResources[dropContext.ResourceId].Name, kimble.formatDate(dropContext.StartDate.toKimbleUTC()));
                        }
                        console.log('asking....')
                                    Boxy.ask(q, ['{!JSENCODE($Label.Ok)}', '{!JSENCODE($Label.Cancel)}'], function (val) {
                            if (val == '{!JSENCODE($Label.Ok)}') {
                                onOk();
                            }
                            else {
                                oncancel();
                            }
                        }, {
                            title: "{!$Label.ConfirmButton}"
                        });
                    }
                };

                var onmove = function (event) {

                    console.log('onmove');
                    var x = event.clientX - mouseOffsetLeft - m;
                    var y = event.clientY - mouseOffsetTop;

                    console.log(x);
                    console.log(y);
                    console.log($ganttNode);

                    var isMoving = false;

                    if (y >= jQuery(window).height() - distance) {
                        //scroll down
                        isMoving = true;
                        clearScrolling();
                        intBottomHandler = setInterval(function () {
                            jQuery(document).scrollTop(jQuery(document).scrollTop() + step)
                        }, timer);

                    }

                    if (y <= distance) {
                        //scroll up
                        isMoving = true;
                        clearScrolling();
                        intBottomHandler = setInterval(function () {
                            jQuery(document).scrollTop(jQuery(document).scrollTop() - step)
                        }, timer);
                    }

                    if (event.clientX >= jQuery(window).width() - distance) {
                        //scroll down
                        isMoving = true;
                        clearScrolling();
                        intRightHandler = setInterval(function () {
                            jQuery('.periods-container, #results').scrollLeft(jQuery('#results').scrollLeft() + step);
                        }, timer);

                    }

                    if (event.clientX - jQuery('#results').offset().left <= distance) {
                        //scroll left
                        isMoving = true;
                        clearScrolling();
                        intLeftHandler = setInterval(function () {
                            jQuery('.periods-container, #results').scrollLeft(jQuery('#results').scrollLeft() - step);
                        }, timer);

                    }

                    //No events
                    if (!isMoving) clearScrolling();

                    if (typeof x !== 'undefined') {
                        $ganttNode[0].style.left = x + "px";
                        $ganttNode[0].style.top = y + "px";
                    }

                    //do this async to smooth out the move
                    var setDragContext = function () {
                        jQuery('.drag-active-day').removeClass('drag-active-day');
                        jQuery('.active-resource').removeClass('active-resource');

                        var left = Math.ceil($ganttNode.offset().left);

                        var d = jQuery(document.elementFromPoint(left, Math.max(jQuery('#header').offset().top - jQuery(window).scrollTop(), 0) + 30));

                        //closest('.parent-container').find('.parent .grid-cell')
                        //Get from middle point
                        var $o = jQuery(document.elementFromPoint(25, $ganttNode.offset().top - jQuery(window).scrollTop() + ($ganttNode.height() / 2)));

                        $ganttNode.removeClass('invalid-drop');
                        $o = $o.closest('.grid-cell');

                        if (!$o.hasClass('quick-assign') || !d.hasClass('day-name')) {
                            $ganttNode.addClass('invalid-drop');
                            $ganttNode.find('.moving-dates').text('');
                            return null;
                        }

                        d.addClass('drag-active-day');

                        //does my parent have quick-assign
                        if ($o.closest('.parent-container').find('.parent .quick-assign').length == 1) {
                            $o.closest('.parent-container').find('.parent .quick-assign').addClass('active-resource');
                        }
                        else {
                            $o.addClass('active-resource');
                        }

                        var c = getDragDay();

                        if (c != null) {
                            //console.log(c);

                            //+ ':' + ui.helper.offset().left + ',' + ui.helper.offset().top
                            $ganttNode.find('.moving-dates').text(matchingResources[c.ResourceId].Name + ': ' + kimble.regional.dayNames[c.StartDate.getDay()] + ' ' + kimble.formatDate(c.StartDate.toKimbleUTC()));
                        } else {
                            $ganttNode.addClass('invalid-drop');
                        }
                    }

                    if (dragContext != null) window.clearTimeout(dragContext);

                    dragContext = window.setTimeout(setDragContext, 100);
                }
                onstart($ganttNode);

                console.log('adding mousemove listener');

                window.addEventListener('mousemove', onmove, false);

                // only register this if not extending
                jQuery(document).off('mouseup').on('mouseup', function () {

                    console.log('unfollowing.');
                    window.removeEventListener('mousemove', onmove, false);
                    jQuery(document).off('mouseup');
                    clearScrolling();
                    onstop($ganttNode);
                });

            });

// END ################ drag - drop assignments #############################################

