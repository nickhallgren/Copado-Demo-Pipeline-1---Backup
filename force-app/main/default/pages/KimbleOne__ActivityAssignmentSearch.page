           	function initialiseActivityAssignmentForSnip(assId)
			{
				var ass = theAssignments[assId];

				if(ass != undefined)
				{
					ass.SnipMode = true;
					redrawAssignmentGantt(assId);

                    jQuery('.action-icon[assignment-id="' + assId + '"]').qtip('destroy', true);
                    jQuery('.action-icon[assignment-id="' + assId + '"] i').hide();
                    closeAssignmentToolbar(assId, true);

					var snipCancelActionHtml = "cancelActivityAssignmentSnip('" + assId + "');";
					var snipHtml = '<div onclick="' + snipCancelActionHtml +'" class="cancel-snip" assignment-id="' + ass.Id +'" title="' + kimble.labels['CancelSnip'] + '"><i class="fa fa-cut fa-2x"></i><i class="fa fa-times overlay-icon"></i></div>';
					jQuery('.action-icon[assignment-id="' + assId + '"] i').after(snipHtml);

					return false;
