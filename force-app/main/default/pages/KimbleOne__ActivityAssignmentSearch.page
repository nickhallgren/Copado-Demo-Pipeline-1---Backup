    function getAssignmentGanttHtml(assignment, options)
    {
        var resource = matchingResources[assignment.ResourceId];
        var options = options || {};
		var canDragDrop = options.canDragDrop || false;
		var canSnip = options.canSnip || false;
		var firmOnly = options.firmOnly;
		var showAggInfo = options.showAggInfo == null ? true : options.showAggInfo;

        if (assignment.AssignmentType == 'ResourcedParent') canSnip = false;
	    if (assignment.AssignmentType == 'ResourcedParent') canDragDrop = false;

		var assignmentUsage = assignment.UsagePattern;

        var assignmentStartDate = new Date(assignment.StartDate.toDate());
      	var assignmentEndDate = new Date(assignment.EndDate.toDate());
        var assignmentUsage = assignment.UsagePattern;
 		var asscls = assignment.StyleClass;

        if (assignmentUsage == null) assignmentUsage = '';

        var assignmentHtml = '';

        jQuery.each(assignmentUsage.split(','), function (i, dayUsage)
  		{
 			//Do we create a day for this item
 			if (dayUsage == '') return true;

 			var contextDay = new Date(assignmentStartDate.getFullYear(), assignmentStartDate.getMonth(), assignmentStartDate.getDate() + i, 0, 0, 0, 0);

 			if(contextDay.valueOf() < assignmentStartDate.valueOf() || contextDay.valueOf() > assignmentEndDate.valueOf()) return true;

 			if(contextDay.valueOf() < ganttMinDate || contextDay.valueOf() > ganttMaxDate) return true;

 			//hide non-bus days
 			if (!showNonBusDays && isDateNonBusDay(contextDay)) return true;

            var usage = dayUsage.split(':')[0];

            assignmentHtml += '<div class="day-container ' + (usage == NONFORECASTDAY || usage == CLOSEDDAY?'non-forecast-day':'') + '">';

 			var actual = dayUsage.split(':')[1];
            var isScheduledDay = KeyToHoursUsagePatternMap[usage] != null;

            var usageAsPercent;
            var dayClasses = '';
            var usageHrsClass = '';

            // we should only allow snip from the end of the day before the current open tracking period
			// if this means a non-bus day and we aren't showing them then we need to track back to find the
			// next business day in order to render the snip - note that this is the last of the if conditions
			// as no point calculating this date if the other criteria are not satisfied
			if (canSnip && assignment.ParentId == null && contextDay.valueOf() < assignmentEndDate.valueOf() && (assignment.SnipMode == true || assignment.HasExpense == true && assignment.LatestTimeEntryDate == null || (assignment.LatestTimeEntryDate != null && contextDay.valueOf() >= assignment.LatestTimeEntryDate.toDate().valueOf())) && (assignment.EarliestOpenPeriodStartDate != null && contextDay.valueOf() >= getTrackingPeriodContextDate(assignment.EarliestOpenPeriodStartDate.toDate()).valueOf()))
 			{
 				assignmentHtml += '<div id="' + assignment.Id + '" class="assignment-snip" title="' + kimble.labels['SnipAssignment'] + '" onclick="snipAssignmentNew(\'' +  assignment.Id + '\', ' + contextDay.valueOf() + ');"></div>';
 			}
           var hasActual = false;
            if (actual != '0')
            {
                usageAsPercent = new Number(actual) / assignment.HoursPerDay * 100;
                dayClasses += ' actual ';
                usageHrsClass = ' assignment-time-entry ';
                hasActual = true;
            }
            else if (usage != undefined )
 			{
      			var usageAsPercent = 0;

      			if (usage == NONFORECASTDAY || usage == CLOSEDDAY)
      			{
      				usageAsPercent = 0;
      			}
      			else
      			{
					dayClasses += asscls;
					var scheduledUsage = KeyToHoursUsagePatternMap[usage];

					if (scheduledUsage == null) // percentage usage
					    usageAsPercent = new Number(usage);
					else
						usageAsPercent = new Number(scheduledUsage) / assignment.HoursPerDay * 100;
      			}
      		}

            var usageClasses = '';

            var timeSlotHtml = '';

            if (usageAsPercent > 0 && !hasActual)
            {
                var assignedBeforeStart = (i == 0 && resource != null && resource.StartDate != null && contextDay < resource.StartDate.toDate());
      			var assignedAfterEnd = (i == assignmentUsage.split(',').length - 2 && resource != null && resource.EndDate != null && resource.EndDate.toDate() < contextDay);
      			var isOverUtilisedOnAssignment = (resource != null && resource.MaximumUtilisation != null && usageAsPercent > resource.MaximumUtilisation);
                var isOverUtilisedAllAssignments = false;
      			var hasImportantEvent = false;

                if (resource != null && showAggInfo)
                {
                    var aggregate = resource.AggregatePattern[contextDay.toKimbleUTC()];

                    if (aggregate != null)
                    {
                        var tot = 0;

                        jQuery.each(Object.keys(aggregate.p), function(l, p){
                            if (classificationStyleMap[p] != undefined && classificationStyleMap[p].IsUtilPct)
                                tot += aggregate.p[p];
                        });

                        if (tot > resource.MaximumUtilisation && tot - usageAsPercent > 0)
                            isOverUtilisedAllAssignments = true;
                    }
                    //Can I get this from the Aggregate Pattern?
                    //if (resource.UserId != null && resourceEvents[resource.UserId] && resourceEvents[resource.UserId][contextDay.toKimbleUTC()] != null)
                    //    hasImportantEvent = true;
                }

