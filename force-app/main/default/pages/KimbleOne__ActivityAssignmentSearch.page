        function getOrderByClause(orderBy)
        {
            var s = '';
            for (var i=0;i<orderBy.length;i++)
            {
                s += orderBy[i].FieldName + ' ' + orderBy[i].Order + ',';
            }

            return s.slice(0, -1);
        }

        function getQueryProperties(config, offset)
        {
            var query = {Filters:[], OrderBy:getOrderByClause(config.OrderBy), Offset:offset, LimitBy:config.LimitBy};

            for (var i=0;i<Object.keys(config.Filters).length;i++)
            {
                var defn = config.Filters[Object.keys(config.Filters)[i]];

                if (defn.DefaultValue != null)
                {
                    if (defn.DisplayType == 'REFERENCE')
                    {
                        if (defn.RelatedObjectType != null)
                        {
                            query.Filters.push(defn.FieldName + " IN (SELECT " + defn.RelatedObjectField + ' FROM ' + defn.RelatedObjectType + ' WHERE ' + defn.RelatedObjectFilterField + ' IN (' + defn.DefaultValue + '))');
                        }
                        else
                        {
                            query.Filters.push(defn.FieldName + " IN (" + defn.DefaultValue + ")");
                        }
                    }
                    else if (defn.DisplayType == 'BOOLEAN')
                    {
                        query.Filters.push(defn.FieldName + '=' + defn.DefaultValue);
                    }
                    else if (defn.DisplayType == 'DATE')
                    {
                        query.Filters.push(defn.FieldName + defn.Operator + defn.DefaultValue);
                    }
                    else if (defn.DisplayType == 'NUMERIC')
                    {
                        query.Filters.push(defn.FieldName + defn.Operator + defn.DefaultValue);
                    }
                }
            }

            return query;
        }

        function newSearch()
        {
            jQuery('#results').empty();
            jQuery('#header .period-cell').empty();
            ganttViewStartDate = null;

            doSearch();
        }

        //Query Parents and Children, Query More Parents and Children, Query More Children
        function doSearch(offset, parentId, oncomplete)
        {
            jQuery('#loadingIndicatorOuterContainer').show();
            if (offset == null) offset = 0;

            var query = JSON.parse(JSON.stringify(config));

            if (parentId == null) //Query more parents
            {
                query.ParentConfig.QueryProperties = getQueryProperties(query.ParentConfig.QueryConfig, offset);
                query.ChildConfig.QueryProperties = getQueryProperties(query.ChildConfig.QueryConfig, 0);
            }
            else // Query more children
            {
                query.ChildConfig.QueryProperties = getQueryProperties(query.ChildConfig.QueryConfig, offset);
                query.ChildConfig.ParentId = parentId;
                delete query.ParentConfig;
            }

            executeQuery(query, renderSearchResults);

            if(oncomplete != null) oncomplete();
        }

        function refreshParent(parentIds, oncomplete) {
            var query = JSON.parse(JSON.stringify(config));

            query.ViewPortStartDate = ganttViewStartDate;
            query.ViewPortEndDate = ganttViewEndDate;

            query.ParentConfig.ParentIds = parentIds;
            query.ParentConfig.LeftJoin =  true;
            query.ChildConfig.QueryProperties = getQueryProperties(query.ChildConfig.QueryConfig, 0);

            //could return nothing so how to know what to remove
            var refreshParentResults = function(query, result, renderResultsComplete) {
                Object.assign(matchingResources, result.TheResources);
                Object.assign(theAssignments, result.TheAssignments);
                Object.assign(theEditableActivities, result.ActivityEditAccess);

                for (var i=0;i<Math.min(result.Parents.length, config.ParentConfig.QueryConfig.LimitBy);i++)
                {
                    var parent = result.Parents[i];
                    parent.Config = config.ParentConfig;

                    var parentNode = jQuery('.parent-container[obj-id="' + parent.Id + '"]');

                    var $parent = jQuery(handlebarsTemplates['parent-row-template'].call(this, parent));

                    if (config.ParentConfig.DisplayConfig.GanttType != null)
                    {
                        $parent.find('.gantt-cells').append(handlebarsTemplates[config.ParentConfig.DisplayConfig.GanttType.Type].call(this, parent));
                    }
                    //collapse children
                    parentNode.find('.toggle-icon').click();

                    parentNode.fadeOut(500, function() {
                        jQuery(this).html($parent.html());

                        // if only 1 parent then auto expand.
                        if (result.Parents.length == 1)
                        {
                            parentNode.find('.toggle-icon').click();
                        }

                        appendChildren(query, parent.Id, parent.Children, jQuery(this));

                        jQuery(this).fadeIn(1000);
                    });
                }
            }

            executeQuery(query, refreshParentResults, oncomplete);
        }

        function refreshChildren(assignmentIds, oncomplete)
        {
            var query = JSON.parse(JSON.stringify(config));

            var ids = {};
            for (var i = 0;i<assignmentIds.length;i++){
                var $a = jQuery('.child-container[obj-id="' + assignmentIds[i] + '"]');
                if ($a.length == 0) {

                    if (theAssignments[assignmentIds[i]].ParentId != null) {
                        ids[theAssignments[assignmentIds[i]].ParentId] = {};
                        query.ChildConfig.IncludeChildren = true;
                    }
                }
                else {
                    ids[assignmentIds[i]] = {};
                    $a.find('.action-col').hide();
                }
            }


            query.ChildConfig.ChildIds = Object.keys(ids);
            query.ChildConfig.QueryProperties = getQueryProperties(query.ChildConfig.QueryConfig, 0);
            delete query.ParentConfig;

            //could return nothing so how to know what to remove
            executeQuery(query, refreshChildResults, oncomplete);
        }

        function refreshChild(childId, includeChildAssignments)
        {
            if (jQuery('.child-container[obj-id="' + childId + '"]').length == 0) {

                if (theAssignments[childId] != undefined && theAssignments[childId].ParentId != null) {
                    childId = theAssignments[childId].ParentId;
                    includeChildAssignments = true;
                }
            }

            spinCog(childId);

            var theChild = jQuery('[assignment-id="' + childId + '"]');
            // if the child is the result of a demand search then we should refresh that child
            // otherwise we should execute the main assignment search criteria as normal process
            var isDemandSearch = theChild.parent().hasClass('demand-srch');

            if(!isDemandSearch)
            {
                var query = JSON.parse(JSON.stringify(config));
                query.ChildConfig.ChildId = childId;

                if (includeChildAssignments) query.ChildConfig.IncludeChildren = true;

                query.ChildConfig.QueryProperties = getQueryProperties(query.ChildConfig.QueryConfig, 0);
                delete query.ParentConfig;

                //could return nothing so how to know what to remove
                executeQuery(query, refreshChildResults);
            }
            else
            {
                // re-execute the demand search as it's the only way to ensure the new assignment changes are relevant
                // and presently the only way to refresh a demand child
                var $container = theChild.parent().closest('.parent-container');
                var resId = $container.attr('obj-id');
                setTimeout(function () {
                    findDemands(resId, $container);
                }, 1000);
            }
        }

        function refreshChildResults(query, result, oncomplete)
        {
            console.log(result);

            Object.assign(matchingResources, result.TheResources);
            Object.assign(theAssignments, result.TheAssignments);
            Object.assign(theEditableActivities, result.ActivityEditAccess);

            if(result.Children.length == 0)
            {
                //remove child
                jQuery('.child-container[obj-id="' + result.Config.ChildConfig.ChildId + '"]').fadeOut(1000, function() {
                    jQuery(this).remove();

                    if (oncomplete != null) oncomplete();

