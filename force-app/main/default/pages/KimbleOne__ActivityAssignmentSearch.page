            else
            {
              jQuery.each(jQuery(result.Children), function (c, child)
              {
                var $container = jQuery('.child-container[obj-id="' + child.Id + '"]');

                if ($container.length == 0)
                {
                    //create container
                    var $parent = jQuery('.parent-container[obj-id="' + result.Children[c].ParentId + '"]>.children');
                    $parent.append(jQuery('<div class="row-container child-container" obj-id="' + child.Id + '"></div>'));
                    $container = jQuery('.child-container[obj-id="' + child.Id + '"]');
                }

                var counter = result.Children.length;

                $container.fadeOut(500, function() {

                    counter --;

                    $container.find('.ui-draggable').draggable('destroy');
                    $container.find('.ui-resizable').resizable('destroy');

