            Handlebars.registerHelper('allDaysCount', function(){
              return allTheDays.length;
            });

            Handlebars.registerHelper('ganttDays', function(start, end){
              if (start == null || end == null) return 0;

              if (!showNonBusDays)
              {
                while(theGlobalNonBusinessDays[start] != null)
                {
                    start = start.toDate().kimbleAddDays(1).toKimbleUTC();
                }

                while(theGlobalNonBusinessDays[end] != null)
                {
                    end = end.toDate().kimbleAddDays(-1).toKimbleUTC();
                }
              }

              if (end.toDate() < ganttMinDate) return 0;

              return 1 + allTheDays.findIndex(d => d == Math.min(end.toDate(), ganttMaxDate)) - allTheDays.findIndex(d => d == Math.max(start.toDate(), ganttMinDate));
            });

            Handlebars.registerHelper('ganttStartOffset', function(start){
              if (start == null || start.toDate() < ganttMinDate) return 0;

              if (!showNonBusDays)
              {
                while(theGlobalNonBusinessDays[start] != null)
                {
                    start = start.toDate().kimbleAddDays(1).toKimbleUTC();
                }
              }

              var actualdaysbetween = (start.toDate() - ganttMinDate) / 1000 / 60 / 60 / 24;

              if (showNonBusDays) return actualdaysbetween;

              //Need to count days between and subtract non-bus days count between dates
              var nonBusDaysCount = 0;

              jQuery.each(Object.keys(theGlobalNonBusinessDays), function(i, dte){

                 if (dte.toDate() >= ganttMinDate && dte.toDate() <= start.toDate()) nonBusDaysCount++;
              });

              return  actualdaysbetween - nonBusDaysCount;

            });

