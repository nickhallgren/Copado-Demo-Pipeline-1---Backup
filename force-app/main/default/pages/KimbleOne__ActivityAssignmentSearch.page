			function spinCog(assignmentId)
			{
			    jQuery('[assignment-id="' + assignmentId + '"]').find('.fa-cog').replaceWith('<i class="fa fa-spin fa-circle-o-notch fa-2x"></i>');
            }

			function closeAssignmentToolbar(assId, andHide)
			{
                // force close the qtip that contains the icon bar
                var qtipId = jQuery('.action-icon[assignment-id="' + assId + '"]').attr('aria-describedby');
                if(andHide) jQuery('#' + qtipId).hide();
            }

			function cancelActivityAssignmentSnip(assId)
			{
				var ass = theAssignments[assId];

				if(ass != undefined)
				{
					ass.SnipMode = false;

					redrawAssignmentGantt(assId);

					jQuery('.action-icon[assignment-id="' + assId + '"] i').show();
