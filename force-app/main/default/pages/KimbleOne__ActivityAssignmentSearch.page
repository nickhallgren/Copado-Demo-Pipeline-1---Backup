					   	dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true
					}).on("change", function (e) {assignmentResourceSearchChanged()});

					if (d != null && d['Equals'] != null) jQuery('#{!JSENCODE(criterion.Id)}-eq-filter').datepicker("setDate", d['Equals'][0].text.toDate());

					jQuery('#{!JSENCODE(criterion.Id)}-gt-filter').datepicker({
					   	dateFormat: kimble.regional.dateFormat,firstDay: kimble.firstDayIndex,
						showOtherMonths: true,
						selectOtherMonths: true
					});

