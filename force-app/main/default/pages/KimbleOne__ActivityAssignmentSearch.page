                        if (j.data().styleclass) popupHtml += '<div class="status-ind ' + j.data().styleclass + '"></div>';
                            popupHtml += '<div class="sched-activity-name">' + j.data().name + '</div>';
                        popupHtml += '</div>';

                        popupHtml += '<div class="sched-time-entry-times">';
                            if (j.data().starttime != null) popupHtml += '<div class="sched-start-time">' + j.data().starttime + '</div>';
                            if (j.data().endtime != null) popupHtml += '<div class="sched-end-time">' + j.data().endtime + '</div>';
                            if (j.data().timezone != null && j.data().timezone != '') popupHtml += '<div class="sched-time-zone">' + j.data().timezone + '</div>';
                        popupHtml += '</div>';
                    popupHtml += '</div>';
                popupHtml += '</div>';

                return popupHtml;
            }

