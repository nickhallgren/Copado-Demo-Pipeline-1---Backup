<script>
    var inGanttActionCursorOffset = 0;

    function setContainerView(view, mode, zoom)
    {
        var $c = jQuery('#container');

        if (view != null)
            $c.attr('view', view);

        if (mode != null)
            $c.attr('mode', mode)

        if (zoom != null)
            $c.attr('zoom', zoom);

        initialiseContainerView();
    }

    function initialiseContainerView()
    {
        var $c = jQuery('#container');
        if ($c.attr('view') != 'gantt' && $c.attr('zoom') != 'daily')
        {
            var cls = 'gantt-' + $c.attr('zoom') + '-usage';
            var p = $c.attr('zoom') == 'weekly' ? '#header .week' : '#header .month';

            jQuery.each(jQuery('.assignment-gantt'), function(i, a) {
                var disableEdit = false;
                var $a = jQuery(a);

                var $c;
                // assignment can either be a child of a parent or a child of a child (e.g. a demand or a resource search)
                if($a.closest('.gantt-cells').length > 0)
                {
                    $c = $a.closest('.gantt-cells');
                }
                else if($a.closest('.assignment-gantt-cells').length > 0)
                {
                    $c = $a.closest('.assignment-gantt-cells');
                    // as this is a demand from a bench search we don't have a way of refreshing the parents - disable edit in 1.31
                    disableEdit = true;
                }

                if ($c != undefined && $c.find('.' + cls).length == 0)
                {
                    var ass = theAssignments[$a.attr('object-id')];
                    var res = matchingResources[ass.ResourceId];

                    if(res != undefined)
                    {
                        var usageHtml = getAssignmentEditPeriodUsageHtml(cls, p, ass, new ResourceAvailabilityUsagePattern(JSON.parse(res.AvailabilityPattern), false), disableEdit);

                        $c.append(jQuery(usageHtml));
                    }
                }

            });
		}

		if ($c.attr('view') == 'gantt' && $c.attr('zoom') == 'daily')
        {
            if(enableInGanttScheduling)
            {
                initialiseForSingleEdit({

                    scheduleClickOff: function(){
                        jQuery(document).off('click', '.scheduled-slot-container');
                    },
                    scheduleClickOn: function(){
                        jQuery(document).on('click', '.scheduled-slot-container', function (e){

                            var $j = jQuery(this).closest('.assignment-gantt');
                            var offset = e.offsetX + jQuery(e.target).offset().left;

                            jQuery('.day-to-schedule').remove();

                            var $d;
                            if (isInViewport(jQuery('#header')[0]))
                            {
                                $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                            }
                            else
                            {
                                $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#fixed-header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                            }

                            var pos = $d.closest('.periods-container').scrollLeft() + $d.offset().left - jQuery('#results').offset().left;

                            var $container = jQuery('<div class="day-to-schedule" style="left:' + pos + 'px"></div>');

                            $j.closest('.gantt-cells').append($container);

                            var dte = new Date(new Number($d.attr('dte')));

                            var fn = function(api){return getAssignmentScheduleEditPopupHtml(dte.toKimbleUTC(), $j.attr('object-id'), api)};

                            showScheduledDayPopup($container, jQuery('#results'), jQuery('#container'), fn);
                        });
                    }
                });
            }
        }

        if ($c.attr('view') == 'usage' || $c.attr('view') == 'model-usage')
        {
            // Model assignments are always in Number of FTEs
            jQuery('#container[view="model-usage"][zoom="daily"] div.assignment-gantt').prop('title', modellingUnitsToolTips[0]);
            jQuery('#container[view="model-usage"][zoom="weekly"] div.gantt-weekly-usage').prop('title', modellingUnitsToolTips[1]);
            jQuery('#container[view="model-usage"][zoom="monthly"] div.gantt-monthly-usage').prop('title', modellingUnitsToolTips[2]);

            // Daily Usage is always in Hours
            jQuery('#container[view="usage"][zoom="daily"] div.assignment-gantt').prop('title', editableUsageUnitsToolTips[0]);

            // Weekly and Monthly usage is in Forecasting Units
            jQuery('#container[view="usage"][zoom="weekly"] div.gantt-weekly-usage.hr').prop('title', editableUsageUnitsToolTips[1]);
            jQuery('#container[view="usage"][zoom="monthly"] div.gantt-monthly-usage.hr').prop('title', editableUsageUnitsToolTips[2]);
            jQuery('#container[view="usage"][zoom="weekly"] div.gantt-weekly-usage.dy').prop('title', editableUsageUnitsToolTips[3]);
            jQuery('#container[view="usage"][zoom="monthly"] div.gantt-monthly-usage.dy').prop('title', editableUsageUnitsToolTips[4]);
        }
        else if ($c.attr('view') == 'gantt')
        {
            // remove any title attributes that have been added by the usage views
            jQuery('#container[view="gantt"] div.assignment-gantt').removeAttr('title');
        }

        // modelling view should only be shown if there are modelling assignments
        jQuery('div[id="model-view-button"]').toggle(jQuery('div[show-modelling="true"]')[0] != undefined);
    }

    function cancelEditAssignmentScheduleClick()
    {
        cancelAssignmentsSchedule();
        enableGanttDragDrop();
        setContainerView('gantt', 'view', null);
        jQuery('#error-saving-assignments i').hide();
    }

    function saveAssignmentSchedulesClick()
    {
        jQuery('#loadingIndicatorOuterContainer').show();

        saveAssignmentSchedules(function(assignmentIds){
            jQuery('#error-saving-assignments i').hide();
            refreshChildren(assignmentIds);
            enableGanttDragDrop();
            setContainerView('gantt', 'view', null);0
            jQuery('#loadingIndicatorOuterContainer').hide();
        }, function(error){
            jQuery('#loadingIndicatorOuterContainer').hide();

            jQuery('#error-saving-assignments i').show().qtip('destroy').qtip({content: {
                    title: '{!$Label.ConfigurationSetting14}',
                    text: '<div class="multi-line-error">' + error + '</div>',
                },
                style: {classes: 'qtip-light qtip-shadow',width: 800}});
        });
    }

    function editAssignmentUsageClick()
    {
        var $c = jQuery('#container');
        $c.attr('mode', 'edit');

        if ($c.attr('zoom') == 'daily')
        {
            var cls = 'gantt-' + $c.attr('zoom') + '-usage';
            var p = '#header .day-name'

            jQuery.each(jQuery('.assignment-gantt'), function(i, a) {
                var disableEdit = false;
                var $a = jQuery(a);
                var $c;
                // assignment can either be a child of a parent or a child of a child (e.g. a demand or a resource search)
                if($a.closest('.gantt-cells').length > 0)
                {
                    $c = $a.closest('.gantt-cells');
                }
                else if($a.closest('.assignment-gantt-cells').length > 0)
                {
                    $c = $a.closest('.assignment-gantt-cells');
                    // as this is a demand from a bench search we don't have a way of refreshing the parents - disable edit in 1.31
                    disableEdit = true;
                }

                if ($c != undefined && $c.find('.' + cls).length == 0)
                {
                    var ass = theAssignments[$a.attr('object-id')];
                    var res = matchingResources[ass.ResourceId];

                    if(res != undefined)
                    {
                        var usageHtml = getAssignmentEditPeriodUsageHtml(cls, p, ass, new ResourceAvailabilityUsagePattern(JSON.parse(res.AvailabilityPattern), false), disableEdit);

                        $c.append(jQuery(usageHtml));
                    }
                }

            });
		}
    }

    function cancelEditAssignmentUsageClick()
    {
        jQuery.each(jQuery('.usage.has-changes'), function(i, o){
	        var $o = jQuery(o);
	        $o.val($o.attr('old-val')).removeClass('has-changes');
        });

        setContainerView(null, 'view', null);
        jQuery('#error-saving-assignments i').hide();
    }

    function saveEditAssignmentUsageClick()
    {
        jQuery('#loadingIndicatorOuterContainer').show();

        var oncomplete = function(){
              setContainerView(null, 'view', null);
              jQuery('#loadingIndicatorOuterContainer').hide();
              jQuery('#error-saving-assignments i').hide();
              initialiseContainerView();
        };

        saveProfiledAssignments(jQuery('.gantt-' + jQuery('#container').attr('zoom') + '-usage'),
                                matchingResources,
                                function($c){
                                    return theAssignments[$c.attr('assignment-id')];
                                },
                                jQuery('#container').attr('view'),
                                function(assignmentIds){

                                    if (assignmentIds.length > 0)
                                        refreshChildren(assignmentIds, oncomplete);
                                    else
                                        oncomplete();
                                },
                                function(error){
                                    jQuery('#loadingIndicatorOuterContainer').hide();

                                    jQuery('#error-saving-assignments i').show().qtip('destroy').qtip({content: {title: '{!$Label.ConfigurationSetting14}',text: '<div class="multi-line-error">' + error + '</div>'},style: {classes: 'qtip-light qtip-shadow',width: 800}});
                                });
    }

    function editScheduleUsageClick()
    {
        setContainerView(null, 'edit', null);

        // reparent the assignment search popup back to the original coded location if not already there
        if(jQuery('#resource-search-container #resource-search-criteria').length == 0) jQuery('#resource-search-criteria').appendTo('#resource-search-container');

        initialiseForScheduledAssignments(
            {
                mouseoutOff: function(){
                    jQuery(document).off('mouseout', '.quick-assign-gantt');
                },
                mouseoutOn: function(){
                    jQuery(document).on('mouseout', '.quick-assign-gantt', function (e){
                        jQuery('.day-head.selected').removeClass('selected');
                        jQuery('.schedule-cursor').removeClass('schedule-cursor');
                        jQuery('.no-action').removeClass('no-action');
                    });
                },
                mouseoverOff: function(){
                    jQuery(document).off('mousemove', '.quick-assign-gantt');
                },
                mouseoverOn: function(){
                    jQuery(document).on('mousemove', '.quick-assign-gantt', function (e){
                        jQuery('.day-name.highlighted').removeClass('highlighted');
                        jQuery('.schedule-cursor').removeClass('schedule-cursor');

                        var $j = jQuery(this).find('.assignment-gantt');
                        $j.closest('.quick-assign-gantt').removeClass('no-action');

                        if ($j.length == 0) return;

                        var offset = e.offsetX + jQuery(e.target).offset().left;
                        var $d;
                        if (isInViewport(jQuery('#header')[0]))
                        {
                            $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                        }
                        else
                        {
                            $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#fixed-header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                        }

                        if(!$d.hasClass('day-name')) return;

                        var dte = new Date(new Number($d.attr('dte')));
                        var ass = theAssignments[$j.attr('object-id')];

                        ass.ResourceAvailability = new ResourceAvailabilityUsagePattern(JSON.parse(matchingResources[ass.ResourceId].AvailabilityPattern), false);

                        if (dte < ass.EarliestOpenPeriodStartDate.toDate()
                            || ass.AssignmentType == 'Framework' || ass.AssignmentType == 'Model' || ass.AssignmentType == 'AppliedModel'
                            || (ass.UsageBehaviourRule != null && ass.UsageBehaviourRule.EntrySpecification == 'TaskUsage')
                            || (ass.UsageBehaviourRule != null && ass.UsageBehaviourRule.EntrySpecification == 'NoForecast')
                            || !canScheduleOnDate(ass, dte))
                        {
                            $j.closest('.quick-assign-gantt').addClass('no-action');
                            return;
                        }

                        $d.addClass('highlighted');
                        $j.closest('.quick-assign-gantt').addClass('schedule-cursor');
                    });
                },
                scheduleClickOff: function(){
                    jQuery(document).off('click', '.quick-assign-gantt');
                },
                scheduleClickOn: function(){
                    jQuery(document).on('click', '.quick-assign-gantt', function (e){

                        var $j = jQuery(this).find('.assignment-gantt');
                        var offset = e.offsetX + jQuery(e.target).offset().left;

                        jQuery('.day-to-schedule').remove();
                        jQuery('.day-name.schedule').removeClass('schedule');

                        var $d;
                        if (isInViewport(jQuery('#header')[0]))
                        {
                            $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                        }
                        else
                        {
                            $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#fixed-header .period-cell .days').offset().top) - jQuery(window).scrollTop()));
                        }

                        if (!$d.hasClass('highlighted')) return;

                        $d.addClass('schedule');

                        var pos = $d.closest('.periods-container').scrollLeft() + $d.offset().left - jQuery('#results').offset().left;

                        var $container = jQuery('<div class="day-to-schedule" style="left:' + pos + 'px"></div>');

                        $j.closest('.quick-assign-gantt').append($container);

                        var dte = new Date(new Number($d.attr('dte')));

                        var fn = function(api){return getAssignmentScheduleEditPopupHtml(dte.toKimbleUTC(), $j.attr('object-id'), api)};

                        showScheduledDayPopup($container, jQuery('#results'), jQuery('#container'), fn);
                    });
                },
                redrawAssignments: function(assignments){
                    for (var i=0; i<assignments.length;i++)
                    {
                        var assignment = assignments[i];

                        jQuery.each(jQuery('[obj-id="' + assignment.Id + '"]'), function(i, row) {
                            var $r = jQuery(row);

                            var c = config.ChildConfig.DisplayConfig;

                            if ($r.hasClass('child-assignment')) {
		                        c = config.ChildConfig.ChildAssignmentConfig.DisplayConfig;
                            }

                            var ganttHtml = handlebarsTemplates[c.GanttType.Type].call(this, assignment);
                            $r.find('.quick-assign-gantt .assignment-gantt').replaceWith(ganttHtml);
                        });
                    }
                }
            });

        disableGanttDragDrop();
    }

    function disableGanttDragDrop()
    {
        jQuery('.assignment-gantt.ui-resizable').resizable({ disabled: true });
        jQuery('.assignment-gantt.ui-draggable').draggable({ disabled: true });
    }

    function enableGanttDragDrop()
    {
        jQuery('.assignment-gantt.ui-resizable-disabled').resizable( "enable" );
        jQuery('.assignment-gantt.ui-draggable-disabled').draggable( "enable" );
    }


</script>

