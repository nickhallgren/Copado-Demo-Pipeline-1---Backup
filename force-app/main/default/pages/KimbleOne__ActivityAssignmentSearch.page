            function acceptCandidate(candidateId, fromCandReview, demandAssignmentId)
            {
                var $candidate = jQuery('a[assignment-id="' + candidateId + '"].action-icon');

                $candidate.hide().parent().addClass('Loading');

                var assignmentId = (demandAssignmentId != undefined && demandAssignmentId != '' ? demandAssignmentId : $candidate.closest('.child-container').attr('obj-id'));

                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.AcceptCandidate}',
                        candidateId,
                            function(result, event){
                                if (event.status)
                                {
                                    refreshChild(assignmentId);

                                    if(fromCandReview != undefined && fromCandReview)
                                    {
                                        hideModalBoxy();
                                        hideSaving_Demand();
                                    }
                                }
                                else
                                {
                                    if(fromCandReview != undefined && fromCandReview) hideSaving_Demand();
                                    alert(event.message);
                                }
                        },
                        {escape: false, timeout: 60000}
                    );
            }

            function rejectCandidate(obj)
            {
               var $o = jQuery(obj);

               var assignmentId = $o.parent().attr('assignment-id');

               if ({!TheCandidateRejectionReasons.size} > 1)
                {
                    //show modal popup to enter rejection reason
                    initialiseModalBoxy('#CandidateRejectionPopup', '{!JSENCODE($Label.RejectLabel)} {!$ObjectType.ActivityAssignment__c.label}');
                    var rejectReason = jQuery('#candidateRejectionReason');
                    rejectReason.attr('assignmentId', assignmentId);
                    rejectReason.val('');

                    showModalBoxy();
                }
                else
                {
                    saveRejectCandidate(assignmentId, '')
                }
            }

            function saveRejectCandidatePopup()
            {
                var rejectReason = jQuery('#candidateRejectionReason');
                if (rejectReason.val() == null || rejectReason.val() == '')
                {
                    alert(kimble.labels['RequiredValue'].format('<apex:outputText value="{!$ObjectType.KimbleOne__ActivityAssignment__c.fields.KimbleOne__CandidateRejectionReason__c.label}"/>'));
                    return;
                }

                hideModalBoxy();

                saveRejectCandidate(rejectReason.attr('assignmentId'), rejectReason.val());
            }

            function deleteCandidateAssignment(assignmentId)
            {
                var $obj = jQuery('a[assignment-id="' + assignmentId + '"].action-icon');

                 $obj.find('span').empty().addClass('Loading');

                 Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentSearchController.DeleteCandidateAssignment}',
                        assignmentId,
                            function(result, event){
                                if (event.status)
                                {
                                    var $row = $obj.closest('.candidate-container');
                                    var $parentAssignmentContainer = $row.closest('.child-container');

                                    var candidates = assignmentSearches[$parentAssignmentContainer.attr('obj-id')].candidates;

                                    var index;

                                    for (var i=0;i<candidates.length;i++)
                                    {
                                        if (candidates[i].Id == assignmentId)
                                        {
                                            index = i;
                                        }
                                    }

                                    if (index != null) candidates.splice(index,1);

                                    $row.fadeOut(1000, function() {
                                        $row.remove();
                                    });

                                    refreshResourceRows(result);

                                    // deleting the last candidate should refresh the parent demand so that the propose actions are reset
                                    var $demandRow = $obj.closest('.row-container.child-container');
                                    if(candidates.length == 0 && $demandRow != undefined && $demandRow.attr('obj-id') != undefined) refreshChild($demandRow.attr('obj-id'));
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                        },
                        {escape: false, timeout: 60000}
                    );
            }

            function saveRejectCandidate(assignmentId, reason, fromCandReview)
            {
                 var $obj = jQuery('a[assignment-id="' + assignmentId + '"].action-icon.candidate-pending');

                 $obj.find('span').empty().addClass('Loading');

                 Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentSearchController.RejectCandidate}',
                        assignmentId, reason,
                            function(result, event){
                                if (event.status)
                                {
                                    var $row = $obj.closest('.candidate-container');
                                    var $parentAssignmentContainer = $row.closest('.child-container');

                                    if(assignmentSearches[$parentAssignmentContainer.attr('obj-id')] != undefined)
                                    {
                                        var candidates = assignmentSearches[$parentAssignmentContainer.attr('obj-id')].candidates;

                                        for (var i=0;i<candidates.length;i++)
                                        {
                                            if (candidates[i].Id == result.Id)
                                            {
                                                candidates[i] = result;
                                            }
                                        }
                                    }
                                    $row.fadeOut(1000, function() {

                                        $child = createCandidateNode(result);

                                        jQuery(this).html($child.html());

                                        jQuery(this).fadeIn(1000);

                                        refreshResourceRows(result.TheResource);
                                    });

                                    if(fromCandReview != undefined && fromCandReview)
                                    {
                                        // refresh the popup to remove the rejected candidate
                                        jQuery.publish('kimble.candreviewrefresh');
                                    }
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                        },
                        {escape: false, timeout: 60000}
                    );
            }

