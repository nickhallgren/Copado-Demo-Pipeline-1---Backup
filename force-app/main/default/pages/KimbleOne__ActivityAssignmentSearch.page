            jQuery.subscribe('kimble.assignResourceCompleted', function(e, result){

                var candidate;
                if (asCandidate)
                {
                    candidate = {Id:result.result[1].AssignmentId, AssignmentDemandId:result.result[1].AssignmentDemandId, ResourceId:result.result[1].ResourceId, ResourceName: result.result[1].ResourceName, AssignmentId:result.result[1].AssignmentId , TheResource:result.result[1].ResourceGantt, Status:'Proposed', IsPreferred: result.result[1].IsPreferred};
                    if(assignmentSearches[result.result[0].AssignmentId] == undefined) assignmentSearches[result.result[0].AssignmentId] = {};
                    if(assignmentSearches[result.result[0].AssignmentId].candidates == null) assignmentSearches[result.result[0].AssignmentId].candidates = [];
                }
                // standard reaction to this event is to refresh the child and the candidates
                // however when the page is running in bench optimisation mode, the resource is a parent rather than a child
                if(parentIdToRefresh != null && parentIdToRefresh != '')
                {
                    refreshParent([parentIdToRefresh]);
                    parentIdToRefresh = null;

                    if (asCandidate)
                    {
                        // if this was a preferred candidate assignment then any existing preferred candidates for this demand need to be unset
                        if(candidate.IsPreferred && candidate.AssignmentDemandId != undefined && candidate.AssignmentDemandId != '')
                        {
                            jQuery('i.search-c-ind.pref-c[assignment-demand-id="' + candidate.AssignmentDemandId + '"]').removeClass('pref-c');
                        }

                        if(assignmentSearches[result.result[0].AssignmentId].candidates && candidate.IsPreferred)
                        {
                            for(var i = 0; i < assignmentSearches[result.result[0].AssignmentId].candidates.length; i++)
                            {
                                assignmentSearches[result.result[0].AssignmentId].candidates[i].IsPreferred = false;
                            }

                            if(typeof assignmentCandidates != 'undefined'
                                && assignmentCandidates != undefined
                                && assignmentCandidates != null
                                && result.result[0].AssignmentId in assignmentCandidates)
                            {
                                for(var j = 0; j < assignmentCandidates[result.result[0].AssignmentId].length; j++)
                                {
                                    assignmentCandidates[result.result[0].AssignmentId][j].IsPreferred = false;
                                }
                                assignmentCandidates[result.result[0].AssignmentId].push(candidate);
                            }
                        }
                        assignmentSearches[result.result[0].AssignmentId].candidates.push(candidate);

                    }
                }
                else
                {
                    console.log(result);

                    if (!asCandidate)
                    {
                        refreshChild(result.result[0].AssignmentId);
                    }
                    else
                    {
                        if(assignmentSearches[result.result[0].AssignmentId].candidates && candidate.IsPreferred)
                        {
                            for(var i = 0; i < assignmentSearches[result.result[0].AssignmentId].candidates.length; i++)
                            {
                                assignmentSearches[result.result[0].AssignmentId].candidates[i].IsPreferred = false;
                                jQuery('i.search-c-ind.pref-c[assignment-id="' + assignmentSearches[result.result[0].AssignmentId].candidates[i].AssignmentId + '"]').removeClass('pref-c');
                            }

                            if(typeof assignmentCandidates != 'undefined'
                                && assignmentCandidates != undefined
                                && assignmentCandidates != null
                                && result.result[0].AssignmentId in assignmentCandidates)
                            {
                                for(var j = 0; j < assignmentCandidates[result.result[0].AssignmentId].length; j++)
                                {
                                    assignmentCandidates[result.result[0].AssignmentId][j].IsPreferred = false;
                                }
                                assignmentCandidates[result.result[0].AssignmentId].push(candidate);
                            }
                        }
                        assignmentSearches[result.result[0].AssignmentId].candidates.push(candidate);

                        var $row = jQuery('.child-container[obj-id="' + result.result[0].AssignmentId + '"]').find('.resource-container[obj-id="' + result.result[1].ResourceId + '"]');

                        $row.fadeOut(1000, function() {

                            var $child = createCandidateNode(candidate);

                            jQuery(this).replaceWith($child);
                            $child.fadeIn(1000);

                            refreshResourceRows(result.result[1].ResourceGantt);
                        });
                    }
                }
		    });
		});

    function refreshResourceRows(resource)
    {
         //TODO: also refresh candidate gantts!
         jQuery.each(jQuery('.resource-container[obj-id="' + resource.Id + '"]'), function (i, obj) {

                var $row = jQuery(obj);

                //get assignment container node
                var $parentAssignmentContainer = $row.closest('.child-container');
                var assignmentId = $parentAssignmentContainer.attr('obj-id');

                scoreResourceAgainstAssignment(resource, assignmentId);

                $row.fadeOut(1000, function() {
                    var $child = createResourceNode(resource);
                    jQuery(this).html($child.html());
                    jQuery(this).fadeIn(1000);
                });
         });
    }

