	     	);
		}

        function kimbleGetEndOfWeek(d)
        {
            return new Date(d.getFullYear(), d.getMonth(), d.getDate() + 6 , 0, 0, 0, 0);
        }

        function kimbleGetWeekName(d)
        {
            var weekEnd = kimbleGetEndOfWeek(d);
  		    return d.getDate() + ' ' + kimble.regional.monthNamesShort[d.getMonth()] + ' - ' + weekEnd.getDate() + ' ' + kimble.regional.monthNamesShort[weekEnd.getMonth()];
        }

        function isDateNonBusDay(dte)
        {
            return theGlobalNonBusinessDays[dte.toKimbleUTC()] != undefined;
        }

        var gridRowHtml;

		function setupHeader()
		{
            var source   = document.getElementById("weeks-template").innerHTML;
            var template = Handlebars.compile(source);

            var periods = {weeks:[], months:[]};

            var contextDate = ganttViewStartDate.toDate();
            var endDate = ganttViewEndDate.toDate();
            allTheDays = new Array();

            var previousMonth = null;

            while (contextDate <= endDate)
            {
                if (showNonBusDays || !isDateNonBusDay(contextDate))
                {
                   var startOfWeek = kimbleGetStartOfWeek(contextDate);
                   var nextDay = contextDate.kimbleAddDays(1);

                   if (previousMonth == null || contextDate.getMonth() != previousMonth.startDate.getMonth())
                   {
                       var m = {name:kimble.regional.monthNames[contextDate.getMonth()] + ' ' + contextDate.getFullYear(), startDate:contextDate, endDate:contextDate, numDays:1};
                       periods.months.push(m);
                       previousMonth = m;
                   }
                   else
                   {
                       previousMonth.endDate = contextDate;
                       previousMonth.numDays++;
                   }

                   if(periods.weeks.length == 0 || contextDate.valueOf() == startOfWeek.valueOf())
                   {
                       periods.weeks.push({name:kimbleGetWeekName(startOfWeek), startDate:contextDate, endDate:kimbleGetEndOfWeek(startOfWeek), numDays:0, days:[]});
                   }

                   var currentWeek = periods.weeks[periods.weeks.length-1];

                   currentWeek.days.push({name:contextDate.getDate(), startDate:contextDate, date:contextDate.valueOf(), isNonBusDay:isDateNonBusDay(contextDate), isLastDayOfWeek:contextDate.valueOf() == currentWeek.endDate.valueOf()});
                   currentWeek.numDays++;

                   allTheDays.push(contextDate.valueOf());
                }

                contextDate = contextDate.kimbleAddDays(1);
            }

            jQuery('#header .period-cell').append(template(periods));

            //Create grid row html based on weeks object
            var gridTemplate = Handlebars.compile(document.getElementById("grid-template").innerHTML);
            gridRowHtml = gridTemplate(periods);

            jQuery('#fixed-header').html(jQuery('#header').html());
            jQuery('#fixed-header .first-cell').css({left:jQuery('#header .first-cell').offset().left - 10});
            jQuery('#header, #fixed-header, #results').css({marginLeft:gridColumnWidth});
            jQuery('.first-cell').css({minWidth:gridColumnWidth,maxWidth:gridColumnWidth});

            //Scroll Stuff!
            reinitialiseDragScroll();
        }

