                    {
                        $child.find('.gantt-cells').append(handlebarsTemplates[config.ChildConfig.DisplayConfig.GanttType.Type].call(this, child.TheAssignment));
                    }

                    var $parent = jQuery(this).html($child.html());

                    if (child.Children.length > 0)
                    {
                        jQuery.each(jQuery(child.Children), function (ca, childAssignment){
                            childAssignment.TheAssignment = theAssignments[childAssignment.Id];
                            childAssignment.Config = config.ChildConfig.ChildAssignmentConfig;

                            var $childAss = jQuery(handlebarsTemplates['child-assignment-template'].call(this, childAssignment));

                            if (childAssignment.Config.DisplayConfig.GanttType != null)
                            {
                                $childAss.find('.gantt-cells').append(handlebarsTemplates[childAssignment.Config.DisplayConfig.GanttType.Type].call(this, childAssignment.TheAssignment));
                            }

                            $parent.find('.child-assignments').append($childAss);
                        });

                        jQuery(this).find('.arrow-collapsed.assignment-children').click();
                    }

                    jQuery(this).fadeIn(1000);

                    var moveable = child.TheAssignment.StartDate.toDate() >= ganttViewStartDate.toDate() && child.TheAssignment.EndDate.toDate() <= ganttViewEndDate.toDate();
                    var extendable = child.TheAssignment.EndDate.toDate() <= ganttViewEndDate.toDate();

                    if (assignmentQuickReAssignEnabled) {
                        if(theEditableActivities[child.TheAssignment.ScopingActivityId]!= null) ActivityAssignmentNewEdit.applyInlineGanttEditBehaviour(jQuery(this).find('.assignment-gantt'), child.TheAssignment, highlightDay, getActiveDay, moveable, extendable);
                    }

                    refreshResourceRows(matchingResources[child.TheAssignment.ResourceId]);

                    if (counter == 0 && oncomplete != null) oncomplete();
                });

              });
            }

            jQuery('#loadingIndicatorOuterContainer').hide();
        }

