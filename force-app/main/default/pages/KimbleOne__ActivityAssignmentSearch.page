    function getAssignmentsActionHtml(ass, isDemandSearch = false)
    {
        var html = '';

        if (ass.AssignmentType == 'Candidate' || !ass.ActivityAllowsNewItems) return html;

        var isActivityEditable = theEditableActivities[ass.ScopingActivityId]!= null;

        if (!isActivityEditable) return html;

        // guard against editing the assignment before the demand jobs have been completed
        if (ass.AssignmentType == 'Demand' && ass.AssignmentDemandId == null)
        {
            html = '<i class="fa fa-hourglass-half job-pending-processing" title="{!$Label.AssignmentCreationInProgress}"></i>';
        }
        else
        {
            if (ass.AssignmentType != "Templated" && ass.AssignmentType != 'ResourcedChild') html+= '<a href="javascript:void(0);" onclick="editActivityAssignment(\'' + ass.Id + '\')" assignment-id="' + ass.Id + '" class="tool-item assignment-edit-button"  title="{!$Label.Edit}" ><i class="fa fa-pencil-square-o"></i></a>';

            if (ass.AssignmentType != "Framework" && ass.AssignmentType != 'Model' && ass.AssignmentType != 'AppliedModel' && ass.AssignmentType != 'ActivatedModel')
            {
     			// check whether or not snip is enabled on the page, then if this assignment doesn't support the standard snip (as it has Time or Expense) then show the force snip icon
				var enableSnipMode = (ass.AssignmentType != 'ResourcedParent' && enableSnipWithoutActuals && enableSnip && (ass.ParentId == null || ass.ParentId == undefined) && (ass.HasExpense != true && ass.LatestTimeEntryDate == null) && !ass.HasCandidateChildren);
				if (enableSnipMode) html += '<a id="forceSnipAssignment" class="tool-item" href="javascript:void(0);" onclick="initialiseActivityAssignmentForSnip(\'' + ass.Id + '\');" title="' + kimble.labels['SnipAssignment'] + '"><i class="fa fa-cut"></i></a>';

            	html += '<a href="javascript:void(0);" onclick="openAssignmentCalendar(\'' + ass.Id + '\')" class="tool-item assignment-calendar-button"  title="{!$Label.CalendarLabel}" ><i class="fa fa-calendar"></i></a>';
           	}

            if (ass.AssignmentType != 'Templated' && ass.AssignmentType != 'ResourcedChild' && ass.AssignmentType != "Framework")
            {
                //Delete
                var deleteTooltipText = (!ass.RecordLostReason?'{!$Label.Delete}':'{!$Label.Cancel}');
                var deleteIconBtnClass = (!ass.RecordLostReason?'fa-trash-o':'fa-times');

                if (isDeletable && !ass.HasExpense && ass.LatestTimeEntryDate == null) html += '<a onclick="' + (ass.RecordLostReason ? 'loseAssignmentClick(\'' + ass.Id + '\')': 'deleteActivityAssignmentClick(\'' + ass.Id + '\')') + '" href="javascript:void(0);" assignment-id="' + ass.Id + '" class="tool-item '+(!ass.RecordLostReason?'assignment-delete-button':'assignment-delete-narrative-button')+'" title="'+deleteTooltipText+'" class="actionLink"><i class="fa '+deleteIconBtnClass+'"></i></a>';

                if(ass.AssignmentType != 'AppliedModel' && ass.AssignmentType != 'ActivatedModel') html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" class="tool-item assignment-profile-button"  title="{!$Label.Profile}" ><i class="fa fa-user"></i></a>';

                if (ass.AssignmentDemandId != null && (ass.ParentId == null || (ass.ParentAssignmentType != 'Model' && ass.ParentAssignmentType != 'AppliedModel')))
                {
                    if(!isDemandSearch && ass.DemandStatus != "Fulfilled") html += '<a title="{!JSENCODE($Label.SearchLabel)}" href="javascript:void(0);" assignment-demand-id="' + ass.AssignmentDemandId + '" class="tool-item find-resources" ><i class="fa fa-search"></i></a>';
                    if(ass.DemandStatus != "Fulfilled" && ass.HasCandidateChildren) html += '<a href="javascript:void(0);" assignment-demand-id="' + ass.AssignmentDemandId + '" class="tool-item ad-cand-rev-btn"  title="{!JSENCODE($Label.ReviewCandidates)}" ><i class="fa fa-thumbs-o-up"></i><i class="fa fa-thumbs-o-down"></i></a>';
                    if (ass.DemandStatus == 'Open') html += '<a title="{!JSENCODE($Label.ProposeCandidates)}" href="javascript:void(0);" assignment-demand-id="' + ass.AssignmentDemandId + '" class="tool-item propose-candidates" ><i class="fa fa-rotate-180 fa-share-square-o"></i></a>';
                    if(enableAutoMatchResourcing && ass.DemandStatus != "Fulfilled" && ass.AssignmentDemandAutoMatchEnum != null) html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" assignment-demand-id="' + ass.AssignmentDemandId + '" class="tool-item demand-auto-match-button"  title="{!$Label.SubmitDemandForAutoMatching}" ><i class="fa fa-puzzle-piece"></i></a>';
    			    if(enableExpressInterest && ass.DemandStatus != "Fulfilled" && ass.AssignmentDemandAutoMatchStatusEnum != "Pending") html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" assignment-demand-id="' + ass.AssignmentDemandId + '" class="tool-item ' + (ass.AssignmentDemandPublished != true ? ' demand-publish-button' : ' demand-published') + '"  title="' + (ass.AssignmentDemandPublished != true ? '{!$Label.PublishDemandForExpressInterest}' : '{!$Label.PublishedDemandForExpressInterest}') + '" ><i class="fa fa-bullhorn"></i></a>';
                }

                if (isCreateable && ass.ActivityAllowsNewItems && ass.LatestTimeEntryDate == null) html += '<a href="javascript:void(0);" resource-initials="' + ass.Initials + '" assignment-id="' + ass.Id + '" class="tool-item assignment-clone-button"  title="{!$Label.CloneAssignmentLabel}" ><i class="fa fa-clone"></i></a>';

			    if (enableResourcingDetailsEdit && ((ass.HasCandidateChildren || ass.HasModelChildren) || ass.AssignmentDemandId != null)) html += '<a href="javascript:void(0);" assignment-demand-id="' + ass.AssignmentDemandId + '" onclick="editResourcingDetailsClick(\'' + ass.Id + '\')"  class="tool-item edit-resourcing-details"  title="{!JSENCODE($Label.GenericLabel03)}" ><i class="fa fa-users"></i></a>';
	
                //if(activity != undefined && activity.HasRevenueMilestones) html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" class="actionLink assignment-milestone-button"  title="' + (ass.MilestoneId==null?'{!$Label.LinkWithMilestoneLabel}': '{!$ObjectType.ActivityAssignment__c.Fields.Milestone__c.label}: ' + ass.MilestoneName) + '"><div class="gantt-marker Revenue' + (ass.MilestoneId==null?'':' WithAssignment') + '"></div></a>';

                html += '<a href="javascript:void(0);" onclick="editAssignmentNotesClick(\'' + ass.Id + '\')" assignment-id="' + ass.Id + '" class="tool-item assignment-notes-button"  title="{!$ObjectType.ActivityAssignment__c.Fields.LongNotes__c.label}: ' + (ass.Notes==null?'':kimble.encodeHTML(ass.Notes)) + '" ><i class="fa fa-comment"></i></a>';
            }

            if(ass.AssignmentType == 'Model' || ass.AssignmentType == 'AppliedModel')
            {
                // TODO 130 - add an refresh indicator if this is an Applied Model
                html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" class="tool-item model-apply-button' + (ass.AssignmentType=='AppliedModel' ? ' applied-model' : '') + '"  title="{!$Label.ApplyModelAssignment}"><i class="fa fa-plus-circle"></i>' + (ass.AssignmentType == 'AppliedModel' ? '<i class="fa fa-refresh overlay-ind"></i>' : '') + '</a>';
            }

            if(ass.AssignmentType == 'AppliedModel')
            {
                html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" class="tool-item model-revert-button applied-model"  title="{!$Label.RevertAppliedModelAssignment}"><i class="fa fa-minus-circle"></i></a>';
                html += '<a href="javascript:void(0);" assignment-id="' + ass.Id + '" class="tool-item model-activate-button applied-model"  title="{!$Label.ActivateModelAssignment}"><i class="fa fa-toggle-off"></i></a>';
            }
        }

        return html;
    }

