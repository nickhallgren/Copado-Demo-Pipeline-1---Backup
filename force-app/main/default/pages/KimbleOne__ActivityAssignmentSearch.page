                resIndHtml += (enableAutoMatchResourcing && ass.AssignmentType == 'Candidate' && ass.CandidateSource == 'AutoMatch' ? '<i assignment-id="' + ass.Id + '" assignment-demand-id="' + ass.AssignmentDemandId + '" class="fa fa-puzzle-piece' + reviewBtnCls + ' auto-match-c-ind" title="{!$Label.AutoMatchCandidateIndicator}"></i>' : '');
                resIndHtml += (ass.AssignmentType == 'Candidate' && ass.CandidateSource != 'AutoMatch' && ass.CandidateSource != 'ExpressInterest' ? '<i assignment-id="' + ass.Id + '" assignment-demand-id="' + ass.AssignmentDemandId + '" class="fa fa-search' + reviewBtnCls + ' search-c-ind' + (ass.IsPreferredCandidate ? ' pref-c' : '') + '" title="{!$Label.ManuallyAssignedCandidateIndicator}"></i>' : '');

