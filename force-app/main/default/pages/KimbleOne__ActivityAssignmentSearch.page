            function zoomIn()
            {
                if (zoomLevel == 1) return;
                zoomTo(zoomLevel-1);
            }

            function zoomTo(level)
            {
                jQuery('#container').removeClass('zoom-level-' + zoomLevel).addClass('zoom-level-' + level);

                zoomLevel = level;

                jQuery.publish('kimble.zoom');
            }

            function zoomOut()
            {
                if (zoomLevel == 4) return;
                zoomTo(zoomLevel+1);
            }

            function getTrackingPeriodContextDate(dte)
            {
                var contextDay = new Date();

                if(dte != null)
                {
                    // default to the day before the passed date unless this is a non-bus day and we aren't showing
                    // them, in which case track back to find the first business day by recursing
                    contextDay = new Date(dte.getFullYear(), dte.getMonth(), dte.getDate() - 1, 0, 0, 0, 0);

                    if (!showNonBusDays && isDateNonBusDay(contextDay))
                    {
                        // recurse
                        contextDay = getTrackingPeriodContextDate(contextDay);
                    }
                }

                return contextDay;
            }

            function  getTimePopupHtmlForAssignment(j)
            {
                var popupHtml = '';

                popupHtml += '<div class="sched-time-container">';
                    popupHtml += '<div class="sched-time-entry">';
