    function sortTasks(a, b)
    {
        var x = new Date(a.StartDate == null ? 0 : a.StartDate.toDate());
        var y = new Date(b.StartDate == null ? 0 : b.StartDate.toDate());

        if (x == y) return a.Name > b.Name;

        return x > y ? 1 : -1;
    }

    function sortResourcesMapByScore(source)
	{
		return function(a, b) {
			var x = source[a].Score;
            var y = source[b].Score;

            if (x == y) return (source[a].Name < source[b].Name) ? -1 : (source[a].Name > source[b].Name) ? 1 : 0;

            return new Number(source[b].Score) - new Number(source[a].Score);
		}
	}

    function getRequiredUsageForAvailabilitySearch(assignmentId)
    {
        var requiredUsageDetails = {};
        requiredUsageDetails.UnitType = 'Hour';

        var usageMap = {};
        var requiredScheduledDays = {};

        var theAssignment = theAssignments[assignmentId];

        var assignmentUsage = new ActivityAssignmentUsagePattern(theAssignment.HoursPerDay, theAssignment.StartDate.toDate(), theAssignment.UsagePattern, theAssignment.Utilisation, theAssignment.Utilisation);

        if (assignmentUsage != null)
        {
            for (var i=0;i<=days_between(theAssignment.StartDate.toDate(), theAssignment.EndDate.toDate());i++)
            {
                var contextDate = new Date(theAssignment.StartDate.toDate().getFullYear(), theAssignment.StartDate.toDate().getMonth(), theAssignment.StartDate.toDate().getDate() + i, 0, 0, 0, 0);

                var dayUsage = assignmentUsage.getUsagePatternOnDate(contextDate);
                var usageOnDay = 0;
                var dte = contextDate.toKimbleUTC();

                if (dayUsage != '')
                {
                    var forecast = dayUsage.split(':')[0];
                    if (forecast != undefined && forecast != NONFORECASTDAY && forecast != CLOSEDDAY)
                    {
                        var usageOnDay = KeyToHoursUsagePatternMap[forecast];

                        if (usageOnDay == null) // percentage usage
                        {
                            // this is a percentage forecast day as no match was made to scheduled letters
                            usageOnDay = (forecast / 100 * theAssignment.HoursPerDay);
                        }
                        else
                        {
                            // this is a scheduled day
                            requiredScheduledDays[dte] = true;
                        }
                    }
                    usageMap[dte] = usageOnDay;
                }
            }
        }

        requiredUsageDetails.UsageMap = usageMap;
        requiredUsageDetails.ScheduledDaysMap = requiredScheduledDays;
        assignmentSearches[assignmentId].RequiredUsage = requiredUsageDetails;
    }

    function includeClassInAvailabilityScore(priority)
   	{
   		var data = jQuery('#IncludeInAvailabilityScorePercentage-filter').data('select2').opts.data();

        if (data.length < priority - 1) return false;

        return jQuery('#IncludeInAvailabilityScorePercentage-filter').val().includes(data.results[priority-1].id);
    }

    function calculateAvailabilityScore(theResource, requiredUsage, minAvailScore)
    {
        var resourceScoringDetails = {resourceAvailabilityDailyScores:{}};

		var dailyMatchCounter = 0;
		var noUsageEveryDay = true;

		if(Object.keys(requiredUsage.UsageMap).length)
        {
	        for(var requiredUsageIndex in Object.keys(requiredUsage.UsageMap))
			{
				var dte = Object.keys(requiredUsage.UsageMap)[requiredUsageIndex];
				var dayScore = 100;

				var requiredUnits = requiredUsage.UsageMap[dte];
				var requiredUsageOnDay = (requiredUsage.UnitType == 'Hour' ? requiredUnits : (requiredUnits * theResource.HoursPerDay) / 100);

				if(requiredUsageOnDay)
				{
					var usageOnDay = 0;

					if(theResource.AggregatePattern[dte] != undefined)
					{
						// the p values are the sums based on priority of the assignment class
						// the u value is the sum of all classes marked include in aggregate utilisation percentage
						for(var priority in theResource.AggregatePattern[dte].p)
						{
							if(includeClassInAvailabilityScore(priority)) usageOnDay += (theResource.AggregatePattern[dte].p[priority] / 100) * theResource.HoursPerDay;
						}

						// daily score is a percentage based on whether the ((required + used) / hoursperday) * 100 > maximum utilisation percentage
						dayScore = (((((requiredUsageOnDay + (usageOnDay != undefined ? usageOnDay : 0)) / theResource.HoursPerDay ) * 100) > theResource.MaximumUtilisation) ? 0 : 100);

						if(theResource.AggregatePattern[dte].s != undefined && theResource.AggregatePattern[dte].s > 0) resourceScoringDetails.ResourceHasScheduledDays = true;
					}
					else
					{
							// if the date is outside the bounds of the resources tenure (Start/End Dates) then score 0
							var dteAsDate = dte.toDate();
							var outsideEmployment = ((theResource.StartDate != null && dteAsDate < theResource.StartDate.toDate()) || ( theResource.EndDate != null && dteAsDate > theResource.EndDate.toDate()));
							if(outsideEmployment)
							{
								dayScore = 0;
							}
							else
							{
								// if this is a non-working day for the resources calendar then it's absent from the usage pattern - we can check against the calendar non-working days if present score 0
								var calendarDay = theCalendarNonBusinessDays[dte];
								if(calendarDay != undefined && calendarDay[theResource.CalendarId] != undefined) dayScore = 0;
							}
					}

					// track where a resource can't work a scheduled day
					if(dayScore == 0 && requiredUsage.ScheduledDaysMap[dte]) resourceScoringDetails.CannotAchieveScheduledDays = true;

					if(usageOnDay > 0) resourceScoringDetails.HasOverlappingAssignments = true;

					resourceScoringDetails.resourceAvailabilityDailyScores[dte] = dayScore;

					if(dayScore == 100) dailyMatchCounter++;
				}

				// overall score is the percentage of the daily scores that are a 100% match
				// exception is when all days are completely available in which case we give a score of 101
				var theAvailabilityScore = Math.round((dailyMatchCounter / Object.keys(resourceScoringDetails.resourceAvailabilityDailyScores).length) * 100);

				if(theAvailabilityScore < 100 && resourceScoringDetails.HasOverlappingAssignments) resourceScoringDetails.HasOverlappingAssignments = false;
			}
		}
		else
		{
			// no requirement so 100 score
			theAvailabilityScore = 100;
		}

		// sum scores and divide by two if there is already a capability score
		resourceScoringDetails.Score = Math.round(((resourceScoringDetails.HasCapScore ? resourceScoringDetails.Score : 0) + theAvailabilityScore) / (resourceScoringDetails.HasCapScore ? 2 : 1));

		resourceScoringDetails.HasAvailScore = true;

		return resourceScoringDetails;
    }

    function appendAggregateRow(resource)
   	{
   		var id = resource.Id;

   		var theResource = resource;

   		var resourceAggregate = theResource.AggregatePattern;

      	var resourceStartDate = ganttViewStartDate.toDate();
      	var resourceEndDate = ganttViewEndDate.toDate();

      	var candidate = '';
      	if (typeof(candidateResources) != "undefined" && candidateResources[id] != null)
      		candidate = ' candidate ';

      	var canAssign = '';
      	if (theResource.Permissions != null && theResource.Permissions[kimble.permissions.AssignResource]) canAssign = ' can-assign ';

      	var canAssignAsCandidate = '';
      	if (theResource.Permissions != null && theResource.Permissions[kimble.permissions.AssignResourceAsCandidate]) canAssignAsCandidate = ' can-assign-as-candidate ';

      	var noAgg = '';
      	if (theResource.NoAggregate) noAgg = ' no-aggregate ';

      	var resourceHtml = '<div class="resource-gantt-row" id="' + id + '"><div class="agg-row ' + candidate + canAssign + canAssignAsCandidate + noAgg + '" id="' + id + '">';
      	var previousContentsHtml = '';
      	var colspan = 1;

      	while (resourceStartDate.valueOf() != resourceEndDate.valueOf())
  		{
 			var thisDate = resourceStartDate;
 			resourceStartDate = new Date(thisDate.getFullYear(), thisDate.getMonth(), thisDate.getDate() + 1, 0, 0, 0, 0);

 			var isGlobalNonBusDay = isDateNonBusDay(thisDate);

 			if (!showNonBusDays && isGlobalNonBusDay)
 				continue;

 			var dayClass = 'day-container ';
 			var outsideEmployment = ((theResource.StartDate != null && thisDate.valueOf() < theResource.StartDate.toDate().valueOf()) || ( theResource.EndDate != null && thisDate.valueOf() > theResource.EndDate.toDate().valueOf()));//NOT YET STARTED

 			if(outsideEmployment)
 				dayClass += 'outside-employment ';

 			var calendarDay = theCalendarNonBusinessDays[thisDate.toKimbleUTC()];

 			if (isGlobalNonBusDay || (calendarDay != undefined && calendarDay[theResource.CalendarId] != undefined))
 				dayClass += 'non-forecast-day ';

 			var dayContentsHtml='<div dte="' + thisDate.toKimbleUTC() + '" class="' + dayClass + '" style="" ';

 			var isOverUtilised = false;

 			if (!outsideEmployment)
 			{
 				//is there aggregate on this date?
 				var aggregate = resourceAggregate[thisDate.toKimbleUTC()];

 				if (aggregate != undefined)
	 			{
	 				if (aggregate.l != null && aggregate.l != '') dayContentsHtml += ' data-coords="' + aggregate.l + '" ';

					var titleText = (showAccountInSummary && aggregate.a != null && aggregate.a != '' ? aggregate.a + ' - ' : '') + aggregate.u + '%';

	 				dayContentsHtml += ' title="' + titleText + '">';

	 				isOverUtilised = aggregate.u > theResource.MaximumUtilisation;

	 				var hasEvent = (aggregate.e != null && aggregate.e.length > 0);
	 				var isScheduledDay = (aggregate.s != null && aggregate.s > 0);
	 				var hasTimes = (aggregate.t != null && aggregate.t.length > 0);

	 				var topPriority = Object.keys(aggregate.p).sort()[0];
	 				var tot = 0;

					//What classes to add
					var ganttClasses = '';

					if (isOverUtilised)
						ganttClasses = 'schedule-clash ';
					else if (isScheduledDay)
						ganttClasses += 'scheduled-day ';

					if (hasEvent) ganttClasses += 'important-event';

					jQuery.each(Object.keys(aggregate.p), function(l, p){

						if (classificationStyleMap[p] != undefined && classificationStyleMap[p].IsUtilPct)
							tot += aggregate.p[p];
					});

	 				dayContentsHtml += '<div class="usage-hrs ' + ganttClasses ;

	 				if (topPriority != null)
	 				{
	 					dayContentsHtml += '">' + kimble.formatNumber(tot * theResource.HoursPerDay / 100, '#.##');
	 				}
	 				else
	 					dayContentsHtml += '">';

	 				dayContentsHtml += '</div>'

	 				dayContentsHtml += '<div class="day-usage">';

	 				jQuery.each(Object.keys(aggregate.p).reverse(), function(i,f){
	 				    var fCls = (classificationStyleMap[f] != undefined ? classificationStyleMap[f].Cls : 'assignment-class-none');
	 					if (aggregate.p[f] > 0) dayContentsHtml += '<div class="agg-content priority-' + f + ' ' + fCls + '" style="height:' + Math.max((0.22 * aggregate.p[f]),2) + 'px"></div>';
	 				});

	 				dayContentsHtml += '</div><div class="utilisation">';

	 				if (isOverUtilised)
	 				{
	 					dayContentsHtml += '<span class="fa fa-exclamation-circle gantt-schedule-clash"></span>';
	 				}
	 				dayContentsHtml += '</div>';

	 				if (showAccountInSummary && aggregate.a != null && aggregate.a != '')
	 					dayContentsHtml += '<div class="account"><span class="account-code">' + aggregate.a + '</span></div>';

	 				if (aggregate.e != null && aggregate.e.length > 0)
	 				{
	 					dayContentsHtml += '<div class="utilisation"><span class="gantt-event" title="' + aggregate.e[0] + '"><i class="fa fa-calendar"></i></span></div>';
	 				}
	 				else if (!isOverUtilised && isScheduledDay)
	 				{
	 					var timeHtml = '';
	 					if (hasTimes)
	 					{
	 						var times = '';
	 						for (var x=0;x<aggregate.t.length;x++)
	 						{
	 							times += ('<div>' + aggregate.t[x] + '</div>');
	 						}
	 						timeHtml += "data-name='" + times + "'";
	 					}

	 					var multipleDaysHtml = '';
	 					var multiDaysClass = '';

	 					if (aggregate.s > 1) //multiple scheduled time on this day
	 					{
	 						multipleDaysHtml += '<i class="fa ' + (hasTimes ? 'fa-clock-o gantt-scheduled-time' : 'fa-thumb-tack') + ' ind-underlay"/>';
	 						multiDaysClass = ' day-clash ';
	 					}

	 					dayContentsHtml += '<div class="utilisation">' + multipleDaysHtml + '<i class="fa ' + (hasTimes ? 'fa-clock-o gantt-scheduled-time' : 'fa-thumb-tack') + ' gantt-scheduled-day ind-overlay' + multiDaysClass + '" ' + timeHtml + '></i></div>';
	 				}
	 			}
	 			else
	 			{
	 				dayContentsHtml += '><div class="usage-hrs"></div>';
	 			}
 			}
 			else
 			{
 				dayContentsHtml += '>';
 			}
 			dayContentsHtml += '</div>';

 			if (dayContentsHtml != previousContentsHtml)
 			{
 				if (previousContentsHtml != '')
 				{
 					if (colspan > 1)
 					{
 						var node = jQuery(previousContentsHtml).addClass('spacer-day').attr('data-day-span', colspan);
 						node.width(colspan * dayWidth + 'px');

 						if (showAccountInSummary && node.find('.account').length == 1)
						{
							var o = node.find('.account');
							var s = o.find('span');
							for (var j=1;j<colspan;j++)
							{
								o.append(s.clone());
							}
						}

						if (node.find('.over-utilised').length == 1)
						{
							var o = node.find('.utilisation');
							var s = o.find('span');
							for (var j=0;j<colspan;j++)
							{
								o.append(s.clone());
							}
						}

 						previousContentsHtml = node.wrap('<p>').parent().html();
 					}

 					resourceHtml += previousContentsHtml;
 				}
 				previousContentsHtml = dayContentsHtml;
 				colspan = 1;
 			}
 			else
 			{
 				colspan++;
 			}
  		}

  		if (colspan > 1)
 		{
 			var lastNode = jQuery(previousContentsHtml).addClass('spacer-day').attr('data-day-span', colspan);
 			lastNode.width(colspan * dayWidth + 'px');
 			dayContentsHtml = lastNode.wrap('<p>').parent().html();
 		}

 		resourceHtml += dayContentsHtml + '</div><div class="resource-assignments"/></div>';

  		return resourceHtml;
   	}

        var fixedMap = {};

        function scrollFixed()
        {
            var header = jQuery('#header').offset().top;
            var winScroll = jQuery(window).scrollTop();

            var f = jQuery('#fixed-header');
            var fixedOffset;

            if (winScroll > header)
            {
                f.css({visibility:'visible'});
                fixedOffset = f.outerHeight();
            }
            else
            {
                f.css({visibility:'hidden'});
                fixedOffset = 0;
            }

           jQuery('.layer-menu').hide();
           jQuery('.layersButton').removeClass('layer-select-on');

            jQuery.each(jQuery('.element-to-scroll-fix'), function(i, obj){

                var $eleToFix = jQuery(obj);

                var offsetTop = $eleToFix.offset().top;

                var $fixedEle = $eleToFix.find('.fixed-element');

                var childrenBottom = $eleToFix.next().offset().top + $eleToFix.next().outerHeight();

                if (winScroll > offsetTop - fixedOffset && winScroll < childrenBottom - fixedOffset)
                {
                    if ($fixedEle.length == 0)
                    {
                         $fixedEle = $eleToFix.clone();
                         $fixedEle.addClass('fixed-element').removeClass('element-to-scroll-fix');
                         $eleToFix.append($fixedEle);

                         var offsetLeft = $eleToFix.find('.grid-cell').offset().left;

                         $fixedEle.find('.grid-cell').css({left:offsetLeft}).css({'top':fixedOffset});
                         $fixedEle.css({'top':fixedOffset}).css({'left':offsetLeft});
                         $fixedEle.find('.gantt-cells').wrap('<div class="periods-container" style="width:' + jQuery('#results').width() + 'px"></div>');
                    }

                    if (winScroll + fixedOffset + $fixedEle.height() > childrenBottom)
                    {
                        //var o = childrenBottom - winScroll - fixedOffset;
                        var d = $fixedEle.height() - childrenBottom + winScroll + fixedOffset;

                        $fixedEle.css({'top':fixedOffset - d});
                        $fixedEle.find('.grid-cell').css({'top':fixedOffset - d});
                    }

                    $fixedEle.css({visibility:'visible'});
                    $fixedEle.find('.periods-container').scrollTo(jQuery('#results').scrollLeft()),
                    fixedOffset += $fixedEle.height();
                }
                /*else if (childrenBottom - fixedOffset - winScroll < $eleToFix.outerHeight()) //scroll out
                {
                    if ($fixedEle.length == 1) $fixedEle.css({top:$fixedEle.position().top - childrenBottom - fixedOffset - winScroll});
                }*/
                else
                {
                    if ($fixedEle.length == 1) $fixedEle.css({visibility:'hidden'});
                }

            });
        }

