            <script>

            //handlebars templates
            var handlebarsTemplates = {};

		jQuery(window).load(function() {

            jQuery(window).unbind('scroll');
            jQuery(window).scroll(scrollFixed);

            //initialiseFilters(theCriteria);

            //calc viewport widths
            var widthDiff = jQuery(window).width()-jQuery('#container').outerWidth() + gridColumnWidth + scrollBarWidth + 1;

            jQuery('.periods-container, #results').css({width:'calc(100vw - ' + widthDiff + 'px)'});

            jQuery(document).off('click', '.periodLeftButton');
	 	    jQuery(document).on('click', '.periodLeftButton', function (event) {
	 	        var left = Math.max(0, jQuery('#header .periods-container').scrollLeft() - scrollSize);
	 	        jQuery('.periods-container, #results').scrollLeft(left, scrollSpeed);
            });

            jQuery(document).off('click', '.periodRightButton');
	 	    jQuery(document).on('click', '.periodRightButton', function (event) {
                var left = jQuery('#header .periods-container').scrollLeft() + scrollSize;
	 	        jQuery('.periods-container, #results').scrollTo(left, scrollSpeed);
            });

            jQuery(document).off('click','.query-more');
            jQuery(document).on('click', '.query-more', function (event) {

                var r = jQuery(this);

                doSearch(parseInt(r.attr('offset'),10), r.attr('parent-id') || null, function(e){
                        r.closest('.more-container').remove();
                });
            });

            jQuery(document).off('click','.grid-row .toggle-icon');
            jQuery(document).on('click', '.grid-row .toggle-icon', function (event) {
                var $container = jQuery(this).closest('.row-container');
                $container.toggleClass('expanded');
                jQuery(this).toggleClass('expanded');
            });

            jQuery(document).off('click','#goBtn');
            jQuery(document).on('click', '#goBtn', function (event) {
                var closeAfterSearch = (!autoGo || event.hasOwnProperty('originalEvent'));

                var $a = jQuery(this);
                var $container = jQuery('.child-container[obj-id="' + jQuery('#resource-search-criteria').attr('assignment-id') + '"]');
                findResources($container, function(e){
                        if(closeAfterSearch) $a.closest('.qtip').qtip('api').hide();
                    }
                );
            });

            jQuery(document).off('click','#demandGoBtn');
            jQuery(document).on('click', '#demandGoBtn', function (event) {
                var closeAfterSearch = (!autoGo || event.hasOwnProperty('originalEvent'));

                var $a = jQuery(this);
                resId = $a.closest('div#demand-search-criteria').attr('resource-id');
                var $container = jQuery('.parent-container[obj-id="' + jQuery('#demand-search-criteria').attr('resource-id') + '"]');
                findDemands(resId, $container, function(e){
                        if(closeAfterSearch) $a.closest('.qtip').qtip('api').hide();
                    }
                );
            });

            jQuery(document).off('click','.demand-results');
            jQuery(document).on('click', '.demand-results', function (event) {
                jQuery('.find-demands').qtip("hide");
            });

            jQuery(document).off('click','.action-icon[assignment-id]').on('click', '.action-icon[assignment-id]', function() {
                var $t = jQuery(this);
                var assignmentId = $t.attr('assignment-id');

                // determine if this is a demand search, if so then we want to suppress the demand search action
                var isDemandSearch = $t.parent().hasClass('demand-srch');
                // relaunching the action toolbar will destroy any qtips that are attached to child items
                // reparent the assignment search popup back to the original coded location if not already there
                if(jQuery('#resource-search-container #resource-search-criteria').length == 0) jQuery('#resource-search-criteria').appendTo('#resource-search-container');

                $t.qtip('destroy', true);

                var content;

                if ($t.closest('.grid-row').hasClass('candidate'))
                {
                    content = handlebarsTemplates['candidate-row-actions'].call(this, {AssignmentId:assignmentId, IsPending:$t.hasClass('candidate-pending')});
                }
                else
                {
                    content = '<div class="tool-items' + (isDemandSearch ? ' dem-tools' : '') + '" assignment-id="' + assignmentId + '">' + getAssignmentsActionHtml(theAssignments[assignmentId], isDemandSearch) + '</div>';
                }

                $t.qtip({
                    content:{
                        text:  content,
                    },
                    position: {
                        adjust: {
                            method: 'flip flip'
                        },
                        my: 'center left',
                        at: 'center right',
                        viewport: $(window)
                    },
                    show: {
                        event: 'click',
                        solo: true,
                        ready:true
                    },
                    hide: 'unfocus',
                    style: {classes: 'qtip-light hide-qtip-border assignment-tools'}
                });
            });

