<apex:page standardController="KimbleOne__ActivityAssignmentSearch__c" extensions="KimbleOne.ActivityAssignmentSearchController,KimbleOne.ActivityAssignmentRemoteActions,KimbleOne.CapabilitySearchRemoteAction" showHeader="true" sidebar="false">

