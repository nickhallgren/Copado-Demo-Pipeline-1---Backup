    function scoreResourceAgainstAssignment(theResource, assignmentId)
    {
        theResource.SearchAssignmentId = assignmentId;

        var divisor = 0;
        var capScore = 0;
        var availScore = 0;

        if (assignmentSearches[assignmentId].criteria.RequiredCapabilities.length > 0)
        {
            divisor = 1;
            theResource.CapabilityScore = calculateResourceCapabilityScore(theResource, assignmentSearches[assignmentId].criteria.RequiredCapabilities);
            capScore = theResource.CapabilityScore.Score;
        }

        if (availabilityScoringEnabled)
        {
            divisor++;
            theResource.AvailabilityScore = calculateAvailabilityScore(theResource, assignmentSearches[assignmentId].RequiredUsage, jQuery('#min-avail-score').val());
            availScore = theResource.AvailabilityScore.Score;
        }

        if (divisor > 0) theResource.Score = Math.round((capScore + availScore) / divisor);
    }

    function scoreResourceAgainstDemandAssignment(theAssignment, theAssignmentCaps, theResource)
    {
        var divisor = 0;
        var capScore = 0;
        var availScore = 0;

        if (theAssignmentCaps.length > 0)
        {
            divisor = 1;
            theAssignment.CapabilityScore = calculateResourceCapabilityScore(theResource, theAssignmentCaps);
            capScore = theAssignment.CapabilityScore.Score;
        }

        //TODO 1.31 - need to decide if implementing availability scoring then gather the required inputs for availability score
        /*if (availabilityScoringEnabled)
        {
            divisor++;
            theAssignment.AvailabilityScore = calculateAvailabilityScore(theResource, theAssignment.RequiredUsage, jQuery('#min-avail-score').val());
            availScore = theAssignment.AvailabilityScore.Score;
        }
        */
        if (divisor > 0) theAssignment.Score = Math.round((capScore + availScore) / divisor);
    }

