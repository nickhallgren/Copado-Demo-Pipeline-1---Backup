            function createCandidateNode(candidate)
            {
                candidate.IsPending = candidate.Status == 'Proposed';
                candidate.IsRejected = candidate.Status == 'Declined';

                var $container = jQuery(handlebarsTemplates['candidate-row-template'].call(this, candidate));
                $container.find('.gantt-cells').append(appendAggregateRow(candidate.TheResource));

                return $container;
            }

            function createResourceNode(resource)
            {
                matchingResources[resource.Id] = resource;

                var $container = jQuery(handlebarsTemplates['resource-row-template'].call(this, resource));
                $container.find('.gantt-cells').append(appendAggregateRow(resource));
                return $container;
            }

            function expandResource($container, assignmentId, resourceId)
            {
                //refreshes resource and assignments
                $container.find('.resource-refresh').show();
                $container.find('.resource-collapsed').hide();

                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.GetResourceAndAssignments}',
                    resourceId, ganttViewStartDate, ganttViewEndDate,
                            function(result, event){

                                console.log(result);
                                if (event.status)
                                {
                                    //scoreResourceAgainstAssignment(resource, assignmentId);
                                    var resource = result;
                                    resource.AssignmentsLoaded = true;
                                    Object.assign(assignmentSearches[assignmentId].resources[resource.Id], resource);

                                    $container.fadeOut(1000, function() {
                                        var $child = createResourceNode(assignmentSearches[assignmentId].resources[resource.Id]);
                                        var $t = jQuery(this);
                                        $t.html($child.html());

                                        $t.find('.children').show();

                                        if (resource.Assignments != null)
                                        {
