            function proposeCandidates(demandId, assignmentId)
            {
                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.ProposeCandidates}',
                        demandId,
                            function(result, event){
                                if (event.status)
                                {
                                    refreshChild(assignmentId);
                                }
                                else if (event.type === 'exception')
                                {
                                    jQuery('[assignment-id="' + assignmentId + '"]').find('.fa-spin').replaceWith('<i class="fa fa-cog fa-2x"></i>');
                                    alert(event.message);
                                }
                                else
                                {
                                    jQuery('[assignment-id="' + assignmentId + '"]').find('.fa-spin').replaceWith('<i class="fa fa-cog fa-2x"></i>');
                                    alert(event.message);
                                }
