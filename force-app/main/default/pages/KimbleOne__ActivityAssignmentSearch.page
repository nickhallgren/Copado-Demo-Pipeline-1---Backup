function resetDraggable($container)
{
    $container.find('.ui-draggable').draggable("destroy");
    $container.find('.ui-resizable').resizable("destroy");
    $container.find('.assignment-gantt').removeClass('can-reassign');

    $container.find('.assignment-gantt').draggable({
                stop: function( event, ui ) {jQuery('.drag-active-day').removeClass('drag-active-day');},
                drag: highlightDay,
                revert:'invalid',
                helper: 'clone',
                scroll:true,
                appendTo:'#results',
                zIndex:100});

    $container.find('.ui-droppable').droppable("destroy");

    $container.find('.grid-row.resource .agg-row, .demand-srch-target.agg-row').droppable({
              hoverClass: 'drag-active-resource',
              accept: function(draggable) {
                return true;
              },
              drop: function(event, ui ) {
                 var dayCell = jQuery('.day-name.drag-active-day');

                 // if starting day cell not matched it's likely off page so default
                 // to assignment start date
                starting = (dayCell.length > 0 ? new Date(new Number(dayCell.attr('dte'))) : null);

                initialiseModalBoxy('#assignment-assign', '{!JSENCODE($Label.Assign)}');

                var obj = ui.draggable.clone();
                var theAssignment = theAssignments[ui.draggable.attr('object-id')];

                var existingCandidates = (typeof assignmentCandidates != 'undefined'
                                            && assignmentCandidates != undefined
                                            && assignmentCandidates != null
                                            && theAssignment.Id in assignmentCandidates ? assignmentCandidates[theAssignment.Id] : assignmentSearches[theAssignment.Id].candidates);

                // indicate to event listener that the parent should be refreshed after this action as this is in the context of a demand search assignment
                if(jQuery(this).hasClass('demand-srch-target')) parentIdToRefresh = jQuery(this).closest('.drop-container').attr('obj-id');

                // theAssignment may have been updated if this demand was fulfilled by another demand search in the current context
                // if this has happened, restore the resourceId back to the original one present when the dropped item was loaded
                // this will ensure that the assign logic then rejects the assignment as the assigned resource is out of date
                if(jQuery('.ui-draggable').closest('.grid-row.child.assignment') != undefined
                    && jQuery('.ui-draggable').closest('.grid-row.child.assignment').attr('res-id') != undefined
                    && theAssignment.ResourceId != jQuery('.ui-draggable').closest('.grid-row.child.assignment').attr('res-id'))
                {
                    theAssignment.ResourceId = jQuery('.ui-draggable').closest('.grid-row.child.assignment').attr('res-id');
                }

                assign(theAssignment, jQuery(this).closest('.drop-container').attr('obj-id'), starting, obj, (assignmentSearches[theAssignment.Id] != undefined && assignmentSearches[theAssignment.Id].original != undefined && assignmentSearches[theAssignment.Id].original.FulfilmentMode == 'Candidate') || theAssignment.IsProposing, true, existingCandidates);

                showModalBoxy();

              },
              over: function(event, ui) {
                jQuery(this).closest('.drop-container .grid-row.drop-target').find('.grid-cell').addClass('drag-active-resource');
              },
              out: function(event, ui) {
                jQuery(this).closest('.drop-container .grid-row.drop-target').find('.grid-cell').removeClass('drag-active-resource');
             }
        });

    }
