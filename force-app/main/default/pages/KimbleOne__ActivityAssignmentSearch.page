 		});

        if(assignment.IsUsageProfiled) assignmentHtml += '<div class="usage-profiled-ass-ind" style="display: none;" title="' + kimble.labels['IsUsageProfiled'] + '" onclick="setContainerView(\'usage\',\'view\',\'daily\');"><i class="fa fa-info-circle"></i></div>';

		return assignmentHtml;
