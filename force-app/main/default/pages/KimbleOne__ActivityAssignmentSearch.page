        function renderSearchResults(query, result)
        {
            console.log(result);

            //switch on result type Parents / Children
            // only do this the first time;
            if (ganttViewStartDate == null)
            {
                if (result.Config.ViewPortStartDate == null || result.Parents.length == 0)
                {
                    alert('{!JSENCODE($Label.NoRecordsFound)}');
                    return;
                }
                else
                {
                    ganttViewStartDate = result.Config.ViewPortStartDate;
                    ganttViewEndDate = result.Config.ViewPortEndDate;

                    theGlobalNonBusinessDays = result.GlobalNonBusDays || {};
                    theCalendarNonBusinessDays = result.CalendarNonBusDays || {};

                    if (!showNonBusDays)
                    {
                        while(theGlobalNonBusinessDays[ganttViewStartDate] != null)
                        {
                            ganttViewStartDate = ganttViewStartDate.toDate().kimbleAddDays(1).toKimbleUTC();
                        }

                        while(theGlobalNonBusinessDays[ganttViewEndDate] != null)
                        {
                            ganttViewEndDate = ganttViewEndDate.toDate().kimbleAddDays(-1).toKimbleUTC();
                        }
                    }

                    ganttMinDate = ganttViewStartDate.toDate().valueOf();
                    ganttMaxDate = ganttViewEndDate.toDate().valueOf();

                    setupHeader();
                }

            }
            //iterate parents
            var groupByIdentifier;

            var $lastGroupBy = jQuery('.group-container:last');

            parentNode = jQuery('#results');

            if ($lastGroupBy.length > 0) groupByIdentifier = $lastGroupBy.attr('obj-id');

            for (var i=0;i<Math.min(result.Parents.length, config.ParentConfig.QueryConfig.LimitBy);i++)
            {
                var parent = result.Parents[i];
                parent.Config = config.ParentConfig;

                var parentNode;

                if (config.ParentConfig.GroupBy != null && parent.GroupById != groupByIdentifier)
                {
                    //insert grouping row
                    groupByIdentifier = parent.GroupById;

                    jQuery('#results').append(jQuery(handlebarsTemplates['group-row-template'].call(this, {Config:config.ParentConfig, Id:parent.GroupById, Values:parent.GroupByValues})));

                    parentNode = jQuery('.group-container[obj-id="' + groupByIdentifier + '"]>div.children');
                }

                var $parent = jQuery(handlebarsTemplates['parent-row-template'].call(this, parent));

                if (config.ParentConfig.DisplayConfig.GanttType != null)
                {
                    if (parent.StartDate == null)
                    {
                        $parent.find('.gantt-cells').append(handlebarsTemplates[config.ParentConfig.DisplayConfig.GanttType.Type].call(this, parent));
                    }
                    else
                    {
                        //TODO: if parent type == ActivityAssignment then get assignment object from theAssignments
                        $parent.find('.gantt-cells').append(handlebarsTemplates[config.ParentConfig.DisplayConfig.GanttType.Type].call(this, parent));
                    }
                }

                parentNode.append($parent);

                // if only 1 parent then auto expand.
                if (result.Parents.length == 1)
                {
                    parentNode.find('.toggle-icon').click();
                }

                appendChildren(query, parent.Id, parent.Children, $parent);
            }

            if  (result.Parents.length > config.ParentConfig.QueryConfig.LimitBy)
            {
                jQuery('#results').append(jQuery(handlebarsTemplates['query-more-template'].call(this, {Type: 'Parent', offset:query.ParentConfig.QueryProperties.Offset + config.ParentConfig.QueryConfig.LimitBy})));
            }

            if (result.Children.length > 0)
            {
                appendChildren(query, query.ChildConfig.ParentId, result.Children, jQuery('.parent-container[obj-id="' + query.ChildConfig.ParentId + '"]'));
            }

            initialiseContainerView();
        }

        //silent
        function refreshResourceAggregateGantt(resourceId) {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentSearchController.GetResourceAggregateGant}',
                    resourceId,
                        function(result, event){
                            if (event.status)
                            {
                                //if aggregate gantt changed
                                if (JSON.stringify(matchingResources[resourceId].AggregatePattern) == JSON.stringify(result.AggregatePattern)) {
                                    //poll again in 4 seconds - still waiting on update.
                                    window.setTimeout(function(){refreshResourceAggregateGantt(resourceId)}, 4000);
                                }
                                else {
                                    //silent update of aggregate bit only
                                    matchingResources[resourceId].AggregatePattern = result.AggregatePattern;
                                    var $container = jQuery('.parent-container[obj-id="' + resourceId + '"] .parent .resource-gantt-row');
                                    $container.fadeOut(1000, function() {
                                        jQuery(this).empty();
                                        jQuery(this).replaceWith(appendAggregateRow(matchingResources[resourceId]));
                                    });

                                }
                           }
                           else {
                               console.log(event.message);
                               window.setTimeout(function(){refreshResourceAggregateGantt(resourceId)}, 4000);
                           }
                    },
                    {escape: false, timeout: 60000, buffer: false}
                );
        }

        function executeQuery(query, renderResults, renderResultsComplete)
        {
            console.log(query);

            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentSearchController.FindObjects}',
                    query,
                        function(result, event){

                            jQuery('#loadingIndicatorOuterContainer').hide();

                            if (event.status)
                            {
                               Object.assign(matchingResources, result.TheResources);
                               Object.assign(theAssignments, result.TheAssignments);
                               Object.assign(theEditableActivities, result.ActivityEditAccess);

                               if (renderResults != null) renderResults(query, result, renderResultsComplete);
                            }
                            else if (event.type === 'exception')
                            {
                                alert(event.message);
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {escape: false, timeout: 60000, buffer: false}
                );
        }

    function appendChildren(query, parentId, children, $parent)
    {
        for (var j=0;j<Math.min(children.length, query.ChildConfig.QueryConfig.LimitBy);j++)
        {
            var child = children[j];
            child.TheAssignment = theAssignments[child.Id];
            child.Config = query.ChildConfig;

            var $child = jQuery(handlebarsTemplates['child-row-template'].call(this, child));

            if (query.ChildConfig.DisplayConfig.GanttType != null)
            {
                $child.find('.gantt-cells').append(handlebarsTemplates[query.ChildConfig.DisplayConfig.GanttType.Type].call(this, child.TheAssignment));

                var moveable = child.TheAssignment.StartDate.toDate() >= ganttViewStartDate.toDate() && child.TheAssignment.EndDate.toDate() <= ganttViewEndDate.toDate();
                var extendable = child.TheAssignment.EndDate.toDate() <= ganttViewEndDate.toDate();

                if (assignmentQuickReAssignEnabled) {
                    if(theEditableActivities[child.TheAssignment.ScopingActivityId]!= null) ActivityAssignmentNewEdit.applyInlineGanttEditBehaviour($child.find('.assignment-gantt'), child.TheAssignment, highlightDay, getActiveDay, moveable, extendable);
                }
            }

            $parent.children('div.children').append($child);
        }

        if  (children.length > query.ChildConfig.QueryConfig.LimitBy)
        {
            $parent.children('.children').append(jQuery(handlebarsTemplates['query-more-template'].call(this, {ParentId: parentId, offset:query.ChildConfig.QueryProperties.Offset + query.ChildConfig.QueryConfig.LimitBy})));
        }
    }

