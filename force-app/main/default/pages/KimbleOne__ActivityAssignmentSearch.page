    {
        var html = '';

        html += '<a title="{!JSENCODE($Label.SearchLabel)}" href="javascript:void(0);" resource-id="' + res.Id + '" class="tool-item find-demands" ><i class="fa fa-search"></i></a>';

        return html;
    }

