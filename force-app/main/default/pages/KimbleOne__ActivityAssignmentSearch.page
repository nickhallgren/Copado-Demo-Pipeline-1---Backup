        			}).on("change", function (e) {assignmentResourceSearchChanged()});
        			jQuery('[id="{!JSENCODE(criterion.Id)}-filter"]').select2('data',  kimble.parseJSON("{!JSENCODE(criterion.ValuesJson)}")  );
        		</apex:outputPanel>

        		<apex:outputPanel layout="none" rendered="{!criterion.DisplayType == 'date'}">

