    function getTaskGanttHtml(task)
    {
        if (task.StartDate == null || task.EndDate == null || task.EndDate.toDate() < ganttMinDate) return ganttHtml + '<div class="no-date-task"/></div>';

        if (!showNonBusDays)
        {
            while(theGlobalNonBusinessDays[task.StartDate] != null)
            {
                task.StartDate = task.StartDate.toDate().kimbleAddDays(1).toKimbleUTC();
            }

            while(theGlobalNonBusinessDays[task.EndDate] != null)
            {
                task.EndDate = task.EndDate.toDate().kimbleAddDays(-1).toKimbleUTC();
            }
        }

        //calc number of days
        var days = 1 + allTheDays.findIndex(d => d == Math.min(task.EndDate.toDate(), ganttMaxDate)) - allTheDays.findIndex(d => d == Math.max(task.StartDate.toDate(), ganttMinDate));

        var offset;
        var actualdaysbetween = (task.StartDate.toDate() < ganttMinDate ? 0 : task.StartDate.toDate() - ganttMinDate) / 1000 / 60 / 60 / 24;

        if (showNonBusDays)
            offset = actualdaysbetween;
        else
        {
            //Need to count days between and subtract non-bus days count between dates
             var nonBusDaysCount = 0;

              jQuery.each(Object.keys(theGlobalNonBusinessDays), function(i, dte){

                 if (dte.toDate() >= ganttMinDate && dte.toDate() <= task.StartDate.toDate()) nonBusDaysCount++;
              });

             var offset = actualdaysbetween - nonBusDaysCount;
        }

        var ganttHtml = '<div class="assignment-gantt task-gantt" object-id="' + task.Id + '" style="--numdays:' + days + ';--startoffset:' + offset + '">';

        if (offset > 0) ganttHtml += '<div class="task-gantt-name">' + task.TaskName + '</div>';

        var additionalIndicatorHtml = '';

        if ((task.IsScheduled) || (task.StartTime != null && task.StartTime != '') || (task.EndTime != null && task.EndTime != ''))
        {
            for (i=1;i<=days;i++)
            {
                additionalIndicatorHtml += '<div class="task-info">';

                if ((task.StartTime != null && task.StartTime != '') || (task.EndTime != null && task.EndTime != ''))
                {
                    additionalIndicatorHtml += '<span class="fa fa-clock-o task-scheduled-time" data-name="' + (task.Name || '') + '" data-styleclass="" data-starttime="' + (task.StartTime || '') + '" data-endtime="' + (task.EndTime || '') + '"></span>';
                }
                else
                {
                    additionalIndicatorHtml += '<span class="fa fa-thumb-tack task-scheduled-day" data-name="' + (task.Name || '') + '"></span>';
                }

                additionalIndicatorHtml += '</div>';
            }
        }

        ganttHtml += additionalIndicatorHtml + '<div class="task-gantt-pct-complete" style="width:' + task.EffortPercentComplete + '%"></div>';

        ganttHtml +='</div>';

        return ganttHtml;
    }

