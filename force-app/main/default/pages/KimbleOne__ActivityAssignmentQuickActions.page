<apex:page controller="KimbleOne.ActivityAssignmentQuickActionsController" extensions="KimbleOne.ActivityAssignmentRemoteActions" showHeader="false" sidebar="false">
    <div id="quick-add-assignment-fields">
        <div>
        <apex:form id="CreateAndScheduleAssignmentForm">
            <div>
                <div id="quick-add-assignment-error" style="display:none"><span><div class="message errorM3"><table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;"><tbody><tr valign="top"><td><img alt="error" class="msgIcon" src="/s.gif" title="{!$Label.Error}"/></td><td class="messageCell"><div class="messageText" id="quick-add-assignment-error-text"><br/></div></td></tr><tr><td></td><td></td></tr></tbody></table></div></span></div>
                <table cellpadding="0" cellspacing="0" border="0">
                    <tr style="height: 30px;display:none;" id="save-and-schedule-activity-row">
                        <td class="edit-label">{!$ObjectType.ActivityAssignment__c.Fields.ResourcedActivity__c.Label}</td>
                        <td>
                            <select onchange="saveAndScheduleActivityChange(this)"></select>
                        </td>

                    </tr>
                    <tr style="height: 30px;" id="save-and-schedule-resource-row">
                        <td class="edit-label">{!$ObjectType.ActivityAssignment__c.Fields.Resource__c.Label}</td>
                        <td>
                            <div class="required-input"></div>
                            <apex:selectList value="{!DummyAssignment.KimbleOne__Resource__c}" size="1" rendered="{!!UseResourceEnhancedLookup}" onchange="getSchedulingDetails()">
                                <apex:selectOptions value="{!TheResourceOptions}" />
                            </apex:selectList>

                            <apex:actionRegion >
                                <apex:outputPanel id="resource-panel">
                                    <apex:inputField value="{!DummyAssignment.KimbleOne__Resource__c}" styleclass="kimbleSearch "  rendered="{!UseResourceEnhancedLookup}">
                                        <apex:actionSupport onsubmit="jQuery('#save-and-schedule-assignment-container .btn').prop('disabled', true);" event="onchange" action="{!ValidateResourceChange}" rerender="resource-panel, Error-panel" oncomplete="jQuery('#save-and-schedule-assignment-container .btn').prop('disabled', false);getSchedulingDetails();" />
                                    </apex:inputField>
                                </apex:outputPanel>
                            </apex:actionRegion>
                        </td>
                    </tr>
                    <tr style="height: 30px;" id="save-and-schedule-role-row">
                        <td class="edit-label">{!$ObjectType.ActivityAssignment__c.Fields.ActivityRole__c.Label}</td>
                        <td>
                            <div class="required-input"></div>
                            <select></select>
                        </td>
                    </tr>
                    <tr style="height: 30px;" id="save-and-schedule-location-row">
                        <td class="edit-label">{!$ObjectType.ActivityAssignment__c.Fields.Location__c.Label}</td>
                        <td>
                            <div class="required-input"></div>
                            <apex:selectList id="simple-input-location" value="{!DummyAssignment.KimbleOne__Location__c}" size="1" rendered="{!!UseLocationEnhancedLookup}" >
                                <apex:selectOptions value="{!TheLocationOptions}" />
                            </apex:selectList>

                            <apex:actionRegion >
                                <apex:outputPanel id="location-panel">
                                    <apex:inputField id="enhanced-input-location" styleclass="kimbleSearch " value="{!DummyAssignment.KimbleOne__Location__c}" rendered="{!UseLocationEnhancedLookup}">
                                        <apex:actionSupport event="onchange" action="{!ValidateResourceChange}" rerender="location-panel, Error-panel"/>
                                    </apex:inputField>
                                </apex:outputPanel>
                            </apex:actionRegion>
                        </td>
                    </tr>

                </table>
            </div>
        </apex:form>
        </div>
    </div>
    <apex:form >
    <div id="scheduled-day-fields">
        <div>
            <table cellpadding="0" cellspacing="0" border="0" id="edit-fte-additional">

                <apex:repeat value="{!$ObjectType.KimbleOne__ForecastTimeEntry__c.FieldSets.KimbleOne__ForecastTimeEntryDetails}" var="f" >
                    <apex:outputPanel layout="none" rendered="{!!CONTAINS(f.FieldPath,'.')}">
                        <tr style="height: 30px;">
                            <td class="edit-label"><apex:outputText value="{!f.Label}"/></td>
                            <td>
                                <apex:inputField onchange="assignmentScheduleChange(this);" value="{!DummyFTE[f]}" styleclass="fte-details-field" html-data-fld-type="{!f.Type}" html-data-fld-name="{!f.SObjectField}" html-data-field-path="{!f.FieldPath}"  html-data-reference="{!f.SObjectField}" required="{!OR(f.required, f.dbrequired)}"/>
                            </td>
                        </tr>
                    </apex:outputPanel>
                </apex:repeat>

            </table>
        </div>
    </div>
    </apex:form>

    <apex:includeScript value="{!URLFOR($Resource.KimbleOne__ActivityAssignmentQuickActions)}" />

    <script>

        var fteHtml = '';
        var addAndScheduleAssignmentHtml = '';
        var maxLabel = '{!JSENCODE($Label.MaxDaysLabel)}'; //Actually period type injected - i.e Max ({0});
		var minLabel = '{!JSENCODE($Label.MinDaysLabel)}'; //Actually period type injected - i.e Min ({0});

        var activityAssignmentQuickActions = {assignments:{}, original:{}, scheduledAssignmentsConfig:null, assignmentsToSaveCount:0, redrawAssignments:null};

        jQuery(window).load(function(){
            fteHtml = jQuery('#scheduled-day-fields').remove().html();
            addAndScheduleAssignmentHtml = jQuery('#quick-add-assignment-fields').remove().html();
        });

        function initialiseForSingleEdit(opts)
        {
            activityAssignmentQuickActions = {mode:'single', assignments:{}, original:{}, scheduledAssignmentsConfig:null, assignmentsToSaveCount:0, redrawAssignments:null};

            activityAssignmentQuickActions.scheduleClickOff = function() {
                jQuery(document).off('click', '.scheduled-slot-container');
            };

            activityAssignmentQuickActions.scheduleClickOn = function() {
                jQuery(document).on('click', '.scheduled-slot-container', function (e){
                    var offset = e.offsetX + jQuery(e.target).offset().left;

                    jQuery('.day-to-schedule').remove();

                    var $day = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));

                    var pos = $day.position().left + jQuery('#gantt-view').scrollLeft();

                    var $d = jQuery('<div class="day-to-schedule" style="left:' + pos + 'px"></div>');

                    var $j = jQuery(this).closest('.activity-assignment-gantt');
                    var $c = $j.closest('.gantt-container');
                    var assId = $j.attr('assignment-id');
                    var fn = function(api){return getAssignmentScheduleEditPopupHtml($day.closest('td').attr('dte'), assId, api)};

                    $c.append($d);

                     //Resource search needs #matching-gantt-lines, assignments.component needs #gantt-lines

                    showScheduledDayPopup($d, $c, jQuery('#qtip-gantt-viewport'), fn);
                });
            };

            activityAssignmentQuickActions.scheduleTimeChangeOn = function() {
                jQuery(document).on('change', '#scheduled-start-time.inline-time-picker', function ()
                {
                    if(jQuery(this).val() > jQuery('#scheduled-end-time.inline-time-picker').val() || jQuery('#scheduled-end-time.inline-time-picker').val() == '')
                    {
                        jQuery('#scheduled-end-time.inline-time-picker').val(jQuery(this).val());
                    }

                    scheduledTimeChange(this)
                });

                jQuery(document).on('change', '#scheduled-end-time.inline-time-picker', function ()
                {
                    if(jQuery(this).val() < jQuery('#scheduled-start-time.inline-time-picker').val() || jQuery('#scheduled-start-time.inline-time-picker').val() == '')
                    {
                        jQuery('#scheduled-start-time.inline-time-picker').val(jQuery(this).val());
                    }

                    scheduledTimeChange(this)
                });
            };

            activityAssignmentQuickActions.scheduleTimeChangeOff = function() {
                jQuery(document).off('change', '#scheduled-start-time.inline-time-picker');
                jQuery(document).off('change', '#scheduled-end-time.inline-time-picker');
            };

            if (typeof opts == 'object')
            {
                if (opts.scheduleClickOff != null) activityAssignmentQuickActions.scheduleClickOff = opts.scheduleClickOff;
                if (opts.scheduleClickOn != null) activityAssignmentQuickActions.scheduleClickOn = opts.scheduleClickOn;

                if (opts.scheduleTimeChangeOff != null) activityAssignmentQuickActions.scheduleTimeChangeOff = opts.scheduleTimeChangeOff;
                if (opts.scheduleTimeChangeOn != null) activityAssignmentQuickActions.scheduleTimeChangeOn = opts.scheduleTimeChangeOn;
            }

            getScheduledAssignmentConfiguration();
        }

        var quickAddAssignmentConfig;

        var inGanttActionCursorOffset = 0;

        function intialiseForQuickAdd(opts)
        {
            quickAddAssignmentConfig = {contexts:{}};

            jQuery(document).off('mouseout', '.gantt-timeline-node');
            jQuery(document).on('mouseout', '#container[mode="view"] .gantt-timeline-node', function (e){
                    jQuery('.day-head.selected').removeClass('selected');
                    jQuery('.quick-add-cursor').removeClass('quick-add-cursor');
                });

            jQuery(document).off('mousemove', '.gantt-timeline-node');
            jQuery(document).on('mousemove', '#container[mode="view"] .gantt-timeline-node', function (e){

                    jQuery('.day-head.selected').removeClass('selected');
                    jQuery('.quick-add-cursor').removeClass('quick-add-cursor');

                    var offset = e.offsetX + jQuery(e.target).offset().left;

                    var $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));

                    if(!$d.hasClass('day-head')) return;

                    var dte = $d.closest('td').attr('dte');

                    $d.addClass('selected');
                    jQuery(this).addClass('quick-add-cursor');
            });

            jQuery(document).off('click', '.gantt-timeline-node');
            jQuery(document).on('click', '#container[mode="view"] .gantt-timeline-node', function (e){

                    var offset = e.offsetX + jQuery(e.target).offset().left;

                    jQuery('.day-to-schedule').remove();
                    jQuery('.day-head.schedule').removeClass('schedule');

                    var $day = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));

                    if (!$day.hasClass('selected')) return;

                    $day.addClass('schedule');

                    var pos = $day.position().left + jQuery('#gantt-view').scrollLeft();

                    var $d = jQuery('<div class="day-to-schedule" style="left:' + pos + 'px"></div>');

                    //qTip stuff!

                    var $c = jQuery(this).closest('.gantt-timeline-container');
                    var contextId = $c.attr('node-id');
                    fn = function(api){return getQuickAddAssignmentPopupHtml($day.closest('td').attr('dte'), contextId, api)};

                    $c.append($d);
                    showScheduledDayPopup($d, $c, jQuery('#qtip-gantt-viewport'), fn);
                });
        }

        //initialises page for scheduling assignments - gets default configuration etc
        function initialiseForScheduledAssignments(opts)
        {
            activityAssignmentQuickActions.mode = 'bulk';

            activityAssignmentQuickActions.mouseoutOff = function() {
                jQuery(document).off('mouseout', '.gantt-container-middle');
            };

            activityAssignmentQuickActions.mouseoutOn = function() {
                jQuery(document).on('mouseout', '.gantt-container-middle', function (e){
                    jQuery('.day-head.selected').removeClass('selected');
                    jQuery('.schedule-cursor').removeClass('schedule-cursor');
                    jQuery('.no-action').removeClass('no-action');
                });
            };

            activityAssignmentQuickActions.mouseoverOff = function() {
                jQuery(document).off('mousemove', '.gantt-container-middle');
            };

            activityAssignmentQuickActions.mouseoverOn = function() {
                jQuery(document).on('mousemove', '.gantt-container-middle', function (e){

                    jQuery('.day-head.selected').removeClass('selected');
                    jQuery('.schedule-cursor').removeClass('schedule-cursor');
                    jQuery(this).removeClass('no-action');

                    var offset = e.offsetX + jQuery(e.target).offset().left;

                    var $d = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));

                    if(!$d.hasClass('day-head')) return;

                    var dte = $d.closest('td').attr('dte');

                    //if (dte.toDate() < new Date()) return;
                    var $j = jQuery(this).find('.activity-assignment-gantt');

                    if ($j.length > 0)
                    {
                        var $dte = $d.closest('td').attr('dte').toDate();
                        var $ass = findAssignmentById($j.attr('assignment-id'));

                        if ($ass != undefined && $dte != undefined)
                        {

                            if(($ass.EarliestOpenPeriodStartDate != undefined && $dte < $ass.EarliestOpenPeriodStartDate.toDate())
                                || $ass.AssignmentType == 'Framework' || $ass.AssignmentType == 'Model' || $ass.AssignmentType == 'AppliedModel'
                                || ($ass.UsageBehaviourRule != null && $ass.UsageBehaviourRule.EntrySpecification == 'TaskUsage')
                                || !canScheduleOnDate($ass, $dte))
                            {
                                jQuery(this).addClass('no-action');
                                return;
                            }
                        }
                    }

                    $d.addClass('selected');
                    jQuery(this).addClass('schedule-cursor');

                });
            };

            activityAssignmentQuickActions.scheduleClickOff = function() {
                jQuery(document).off('click', '.gantt-container-middle');
                jQuery(document).off('click', '.scheduled-slot-container');
            };

            activityAssignmentQuickActions.scheduleClickOn = function() {
                jQuery(document).on('click', '.gantt-container-middle', function (e){

                    var offset = e.offsetX + jQuery(e.target).offset().left;

                    jQuery('.day-to-schedule').remove();
                    jQuery('.day-head.schedule').removeClass('schedule');

                    var $day = jQuery(document.elementFromPoint(offset + inGanttActionCursorOffset, Math.ceil(jQuery('#days-header').offset().top) - jQuery(window).scrollTop()));

                    if (!$day.hasClass('selected')) return;

                    $day.addClass('schedule');

                    var pos = $day.position().left + jQuery('#gantt-view').scrollLeft();

                    var $d = jQuery('<div class="day-to-schedule" style="left:' + pos + 'px"></div>');

                    var $j = jQuery(this).find('.activity-assignment-gantt');
                    var $c;

                    var fn;

                    $c = $j.closest('.gantt-container');
                    var assId = $j.attr('assignment-id');
                    fn = function(api){return getAssignmentScheduleEditPopupHtml($day.closest('td').attr('dte'), assId, api)};

                    $c.append($d);
                    showScheduledDayPopup($d, $c, jQuery('#qtip-gantt-viewport'), fn);
                });
            };

            activityAssignmentQuickActions.scheduleTimeChangeOn = function() {
                jQuery(document).on('change', '#scheduled-start-time.inline-time-picker', function ()
                {
                    if(jQuery(this).val() > jQuery('#scheduled-end-time.inline-time-picker').val() || jQuery('#scheduled-end-time.inline-time-picker').val() == '')
                    {
                        jQuery('#scheduled-end-time.inline-time-picker').val(jQuery(this).val());
                    }

                    scheduledTimeChange(this)
                });

                jQuery(document).on('change', '#scheduled-end-time.inline-time-picker', function ()
                {
                    if(jQuery(this).val() < jQuery('#scheduled-start-time.inline-time-picker').val() || jQuery('#scheduled-start-time.inline-time-picker').val() == '')
                    {
                        jQuery('#scheduled-start-time.inline-time-picker').val(jQuery(this).val());
                    }

                    scheduledTimeChange(this)
                });
            };

            activityAssignmentQuickActions.scheduleTimeChangeOff = function() {
                jQuery(document).off('change', '#scheduled-start-time.inline-time-picker');
                jQuery(document).off('change', '#scheduled-end-time.inline-time-picker');
            };

            if (typeof opts === 'function')
            {
                activityAssignmentQuickActions.redrawAssignments = opts;
            }
            else if (typeof opts == 'object')
            {
                if (opts.redrawAssignments != null) activityAssignmentQuickActions.redrawAssignments = opts.redrawAssignments;

                if (opts.mouseoutOff != null) activityAssignmentQuickActions.mouseoutOff = opts.mouseoutOff;
                if (opts.mouseoutOn != null) activityAssignmentQuickActions.mouseoutOn = opts.mouseoutOn;

                if (opts.mouseoverOff != null) activityAssignmentQuickActions.mouseoverOff = opts.mouseoverOff;
                if (opts.mouseoverOn != null) activityAssignmentQuickActions.mouseoverOn = opts.mouseoverOn;

                if (opts.scheduleClickOff != null) activityAssignmentQuickActions.scheduleClickOff = opts.scheduleClickOff;
                if (opts.scheduleClickOn != null) activityAssignmentQuickActions.scheduleClickOn = opts.scheduleClickOn;

                if (opts.scheduleTimeChangeOff != null) activityAssignmentQuickActions.scheduleTimeChangeOff = opts.scheduleTimeChangeOff;
                if (opts.scheduleTimeChangeOn != null) activityAssignmentQuickActions.scheduleTimeChangeOn = opts.scheduleTimeChangeOn;
            }

            getScheduledAssignmentConfiguration();
        }

        function canScheduleOnDate(assignment, dte) {
            if (assignment.UsagePattern == null) return false;

            var usagePattern = new ActivityAssignmentUsagePattern(assignment.HoursPerDay, assignment.StartDate.toDate(), assignment.UsagePattern, assignment.Utilisation, assignment.BaselineUtilisation);
            var availability = assignment.ResourceAvailability;

            if (availability.isUnavailableDate(dte)) return false;

            return !usagePattern.hasActualOnDate(dte);
        }

        function getScheduledAssignmentConfiguration()
        {
            if (activityAssignmentQuickActions.scheduledAssignmentsConfig == null)
            {
                Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentQuickActionsController.GetScheduledAssignmentConfiguration}',
                    function(result, event){
                            if (event.status)
                            {
                                activityAssignmentQuickActions.scheduledAssignmentsConfig = result;

                                initialiseUIEvents();
                            }
                            else if (event.type === 'exception')
                            {
                                alert(event.message);
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {buffer: false, escape: true, timeout: 60000}
                );
            }
            else
            {
                initialiseUIEvents();
            }
        }

        function showScheduledDayPopup($ele, $container, $viewport, fnGetHtml)
        {
            jQuery('.qtip').qtip('destroy', true);

            $ele.qtip({
                overwrite: true,
                    show: {
                        solo:true,
                        event: 'click', // Use the same event type as above
                        ready: true, // Show immediately - important!
                        modal: {
                            on: false,
                        }
                    },
                    hide: {
                        event: false
                    },
                    style: {
                        classes: 'qtip-light qtip-shadow day-summary-qtip'
                    },
                    content: {
                        button: 'Close',
                        text: function(event, api) {
                            var h = fnGetHtml(api);
                            return h;
                        }
                    },
                    events: {
                        visible: function(event, api) {
                            //TODO:move into initiliasePopupControls function
                            jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i', 'show2400': 'true'});
                            jQuery('.scheduled-date-entry input').datepicker({
                                                                        dateFormat: kimble.regional.dateFormat,
                                                                        showOtherMonths: true,
                                                                        selectOtherMonths: true
                                                                    });
                        },
					    hide: function(event, api) {
                            closeSchedulePopup();
                        }
                    },
                    position: {
                        my: 'top center',
                        at: 'bottom center',
                        container: $container,
                        adjust: {method: 'flip flip'},
                        viewport: $viewport
                    }
                });
        }

        function initialiseUIEvents()
        {
            if (activityAssignmentQuickActions.mode != 'single')
            {
                jQuery('.assignment-snip').hide();

                activityAssignmentQuickActions.mouseoutOff();
                activityAssignmentQuickActions.mouseoutOn();

                activityAssignmentQuickActions.mouseoverOff();
                activityAssignmentQuickActions.mouseoverOn();
            }

            activityAssignmentQuickActions.scheduleClickOff();
            activityAssignmentQuickActions.scheduleClickOn();

            activityAssignmentQuickActions.scheduleTimeChangeOff();
            activityAssignmentQuickActions.scheduleTimeChangeOn();
        }

        function cancelAssignmentsSchedule()
        {
            //redraw assignments based on original data
            var assignments = [];

            jQuery.each(Object.keys(activityAssignmentQuickActions.original), function(i, key) {

                assignments.push(activityAssignmentQuickActions.original[key]);
            });

            jQuery('.day-to-schedule').remove();
            jQuery('.schedule').removeClass('schedule');
            jQuery('.highlight').removeClass('highlight');

            jQuery('.assignment-snip').show();

            if (activityAssignmentQuickActions != null) {
                activityAssignmentQuickActions.redrawAssignments(assignments);

                activityAssignmentQuickActions.assignments = {};
                activityAssignmentQuickActions.original = {};
                activityAssignmentQuickActions.assignmentsToSaveCount= 0;

                activityAssignmentQuickActions.mouseoutOff();
                activityAssignmentQuickActions.mouseoverOff();
                activityAssignmentQuickActions.scheduleClickOff();
                activityAssignmentQuickActions.scheduleTimeChangeOff();
            }
        }

        function clearAssignmentSchedule(assignmentId)
        {
            delete activityAssignmentQuickActions.assignments[assignmentId];
        }

        //Fetches assignment and all scheduled days with custom fields / start & end times etc.
        function getAssignmentSchedule(assignmentId, oncomplete)
        {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentQuickActionsController.GetAssignmentSchedule}',
                        assignmentId, function(result, event){
                                if (event.status)
                                {
                                    activityAssignmentQuickActions.assignments[assignmentId] = result;
                                    oncomplete(activityAssignmentQuickActions.assignments[assignmentId]);
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                        },
                        {buffer: false, escape: true, timeout: 60000}
                    );
        }

        function getGetQuickAddConfigForContextRemoteAction(contextId, oncomplete)
        {
             Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentQuickActionsController.GetQuickAddConfigForContext}',
                        contextId, function(result, event){
                                if (event.status)
                                {
                                    quickAddAssignmentConfig.contexts[contextId] = result;
                                    oncomplete(quickAddAssignmentConfig.contexts[contextId]);
                                }
                                else if (event.type === 'exception')
                                {
                                    alert(event.message);
                                }
                                else
                                {
                                    alert(event.message);
                                }
                        },
                        {buffer: false, escape: true, timeout: 60000}
                    );
        }

        //Gets the popup html for scheduling a day
        function getAssignmentScheduleEditPopupHtml(dte, assignmentId, api)
        {
            if (activityAssignmentQuickActions.assignments[assignmentId] != null)
            {
                return getAssignmentScheduleEditHtml(dte, activityAssignmentQuickActions.assignments[assignmentId]);
            }

            getAssignmentSchedule(assignmentId, function(assignment){

                var html = getAssignmentScheduleEditHtml(dte, assignment);

                api.set('content.text', html);
                jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i', 'show2400': 'true'});
                jQuery('.scheduled-date-entry input').datepicker({
                    dateFormat: kimble.regional.dateFormat,
                    showOtherMonths: true,
                    selectOtherMonths: true
                });
            });

            return '<span class="fa fa-circle-o-notch fa-spin load-summary-view"></span>';
        }

        function getQuickAddAssignmentHtml(dte, config)
        {
            // Show / Populate Scheduling details!
            var html = '<div id="save-and-schedule-assignment-container" scoping-activity-id="' + config.Activities[0].id + '" dte="' + dte + '" class="edit-assignment-schedule-container">';

            var t = '{!JSENCODE($Label.QuickAddAssignmentTitle)}';

            var canEditAssignment = {!$ObjectType.ActivityAssignment__c.updateable};

            html += '<div class="schedule-assignments-card"><div class="schedule-assignments-header">' + t.format(kimble.formatDate(dte)) + '</div>';

            html += addAndScheduleAssignmentHtml;

            html += '<div id="save-and-schedule-details"></div>';

            html += '<div class="schedule-save-buttons">';

            if (canEditAssignment) html += '<input class="btn" type="button" value="{!JSENCODE($Label.Save)}" onclick="saveAndScheduleNewAssignment();"/>';
            html += '<input class="btn" type="button" value="{!JSENCODE($Label.Close)}" onclick="closeSaveAndScheduleNewAssignment();"/>';

            html += '</div>';

            html += '</div>';

            var $h = jQuery('<div>' + html + '</div>');

            if (config.Activities.length > 1) {
                $h.find('#save-and-schedule-activity-row').show();

                config.Activities.forEach(function(act, i) {
                    $h.find('#save-and-schedule-activity-row select').append(jQuery('<option value="' + act.id + '">' + act.text + '</option>'));
                });

            }
            else {
                $h.find('#save-and-schedule-activity-row').hide();
            }

            $h.find('#save-and-schedule-role-row select').empty();

            if (config.IsRoleMandatory) {
                config.TheActivityRoles.forEach(function(r, i) {
                    $h.find('#save-and-schedule-role-row select').append(jQuery('<option value="' + r.id + '">' + r.text + '</option>'));
                });
            }
            else {
                $h.find('#save-and-schedule-role-row').remove();
            }

            if (!config.IsLocationMandatory) {
                $h.find('#save-and-schedule-location-row').remove();
            }

            return $h.html();
        }

        function saveAndScheduleActivityChange(obj) {
            jQuery('#save-and-schedule-assignment-container').attr('scoping-activity-id', jQuery(obj).val());
            getSchedulingDetails();
        }

        function getQuickAddAssignmentPopupHtml(dte, contextId, api)
        {
            //need to get activities list and config for contextId
            if (quickAddAssignmentConfig.contexts[contextId] != null)
            {
                return getQuickAddAssignmentHtml(dte, quickAddAssignmentConfig.contexts[contextId]);
            }

            getGetQuickAddConfigForContextRemoteAction(contextId, function(result){
                var html = getQuickAddAssignmentHtml(dte, result);

                api.set('content.text', html);

                jQuery('.kimbleTimePicker').timepicker({ 'timeFormat': 'H:i', 'show2400': 'true'});
                jQuery('.scheduled-date-entry input').datepicker({
                    dateFormat: kimble.regional.dateFormat,
                    showOtherMonths: true,
                    selectOtherMonths: true
                });
            });

            return '<span class="fa fa-circle-o-notch fa-spin load-summary-view"></span>';
        }

        function scheduledTimeChange()
        {
            jQuery('#time-toggle').prop('checked', true);

            assignmentScheduleChange(jQuery('#time-toggle'));
        }

        function assignmentScheduleChange(obj, override)
        {
            //if mode = bulk don't save else show save button and save assignment and re-draw!
            var $o = jQuery(obj);
            var $c = $o.closest('.edit-assignment-schedule-container');

            var assignmentId = $c.attr('assignment-id');

            if(assignmentId == null)
            {
                // no assignment could mean we are in the quick assign popup
                if(jQuery('#sheduled-units:visible').length > 0 && jQuery('#scheduled-start-time').val() != '' && jQuery('#scheduled-end-time').val() != '')
                {
                    jQuery('#quick-add-assignment-error-text').text('');
                    jQuery('#quick-add-assignment-error').hide();

                    var timeDifference = timeDiff(jQuery('#scheduled-start-time').val(), jQuery('#scheduled-end-time').val());
                    var dayUsageKey = HoursToKeyUsagePatternMap[timeDifference.toFixed(2)];

                    if(dayUsageKey == undefined || dayUsageKey == null)
                    {
                       var e = '{!JSENCODE($Label.InvalidTimeInterval)}';
                        $c.find('#quick-add-assignment-error-text').append('<span>' + e + '</span>');
                        $c.find('#quick-add-assignment-error').show();
                        return;
                    }

                    jQuery('#sheduled-units').text(kimble.formatNumber(timeDifference, '0.00 '));
                }
                return;
            }

            var dte = $c.attr('dte');

            var newDte = kimble.parseDate($c.find('.scheduled-date-entry input').val());

            var assignment = activityAssignmentQuickActions.assignments[assignmentId];
            var usagePattern = new ActivityAssignmentUsagePattern(assignment.TheAssignment.HoursPerDay, assignment.TheAssignment.StartDate.toDate(), assignment.TheAssignment.UsagePattern, assignment.TheAssignment.Utilisation, assignment.TheAssignment.BaselineUtilisation);
            var availability = new ResourceAvailabilityUsagePattern(assignment.ResourceAvailability, assignment.IsUnavailableAssignment);
            if (activityAssignmentQuickActions.original[assignmentId] == null) activityAssignmentQuickActions.original[assignmentId] = JSON.parse(JSON.stringify(assignment.TheAssignment));

            $c.find('.error-container').hide();
            $c.find('.error-message').empty();

            if (newDte != dte)
            {
                // is valid date change?
                if (assignment.EarliestOpenTrackingPeriod.toDate() > newDte.toDate())
                {
                    var e = '{!JSENCODE($Label.CannotScheduleDayBefore)}';
                    $c.find('.error-message').append('<span>' + e.format(kimble.formatDate(assignment.EarliestOpenTrackingPeriod)) + '</span>');
                    $c.find('.error-container').show();
                    return;
                }

                if (assignment.TheAssignment.LatestTimeEntryDate != undefined && assignment.TheAssignment.LatestTimeEntryDate != '' && assignment.TheAssignment.LatestTimeEntryDate.toDate() >= newDte.toDate())
                {
                    var e = '{!JSENCODE($Label.CannotScheduleDayBefore)}';
                    $c.find('.error-message').append('<span>' + e.format(kimble.formatDate(assignment.TheAssignment.LatestTimeEntryDate)) + '</span>');
                    $c.find('.error-container').show();
                    return;
                }

                if (availability.isUnavailableDate(newDte.toDate()))
                {
                    var e = '{!JSENCODE($Label.ResourceIsUnavailableOn)}';
                    $c.find('.error-message').append('<span>' + e.format(kimble.formatDate(dte)) + '</span>');
                    $c.find('.error-container').show();
                    return;
                }

                var newDay = assignment.TheScheduledDays[newDte];
                if (!override && newDay != null && newDay.RevertToUtilisation != true)
                {
                    var e = '{!JSENCODE($Label.OverrideExistingScheduledDay)}';
                    $c.find('.error-message').append('<span>' + e.format(kimble.formatDate(newDte)) + '</span><input class="btn" type="button" value="{!JSENCODE($Label.Replace)}" onclick="assignmentScheduleChange(this, true)"/>');
                    $c.find('.error-container').show();
                    return;
                }

                // need to update dte to @utilisation and update newDte
                var oldDay = assignment.TheScheduledDays[dte];
                oldDay.HasChanges = true;
                oldDay.RevertToUtilisation = true;
                oldDay.ScheduledValue = null;
                oldDay.StartTime = null;
                oldDay.EndTime =  null;
                usagePattern.addScheduledDay(dte.toDate(), dayUsageKey);

                if (assignment.TheAssignment.TheTimeSlots != null && assignment.TheAssignment.TheTimeSlots[dte] != null)
                    delete assignment.TheAssignment.TheTimeSlots[dte];

                assignment.TheAssignment.UsagePattern = usagePattern.usagePattern;

                if (activityAssignmentQuickActions.mode != 'single')
                {
                    usagePattern = recalculateAssignmentUsage(assignment.TheAssignment, availability , assignment.TheAssignment.HoursPerDay);

                    assignment.TheAssignment.EndDate = usagePattern.endDate.toKimbleUTC();
                    assignment.TheAssignment.Utilisation = usagePattern.actualUtilisation;
                    assignment.TheAssignment.UsagePattern = usagePattern.usagePattern;
                }

                assignment.HasChanges = true;

                dte = newDte;
                $c.attr('dte', newDte);
            }

            //create or remove scheduled day
            //scheduled day dto {ScheduledValue:0, RevertToUtilisation:false, ForecastEntryId:null, StartTime:null, EndTime:null, TimeZoneSidKey:null, CustomFields:{}};

            var day = assignment.TheScheduledDays[dte];

            if (day == null)
            {
                day = {ScheduledValue:null, HasChanges:false, RevertToUtilisation:true, ForecastEntryId:null, StartTime:null, EndTime:null, TimeZoneSidKey:null, CustomFields:{}};
                assignment.TheScheduledDays[dte] = day;
            }

            day.HasChanges = true;
            day.StartTime = null;
            day.EndTime = null;
            day.TimeZoneSidKey = null;

            if (assignment.TheAssignment.TheTimeSlots != null && assignment.TheAssignment.TheTimeSlots[dte] != null)
                delete assignment.TheAssignment.TheTimeSlots[dte];

            var dayUsageKey;

            jQuery('#edit-fte-additional input, #edit-fte-additional textarea, #edit-fte-additional select').prop('disabled', true);
            jQuery('#edit-fte-additional a').hide();

            jQuery('#scheduled-start-time, #scheduled-end-time').prop('disabled', true);

            if ($o.is('select'))
                jQuery('#specific-toggle').prop('checked', true);

            if (jQuery('#pct-toggle').prop('checked'))
            {
                day.RevertToUtilisation = true;
                day.ScheduledValue = null;
                day.StartTime = null;
                day.EndTime =  null;
                dayUsageKey = assignment.TheAssignment.BaselineUtilisation;
            }
            else if (jQuery('#specific-toggle').prop('checked'))
            {
                day.RevertToUtilisation = false;
                dayUsageKey = $c.find('select').val();

                day.ScheduledValue = KeyToHoursUsagePatternMap[dayUsageKey];

                day.CustomFields = getCustomFields();
            }
            else if (jQuery('#time-toggle').prop('checked'))
            {
                day.RevertToUtilisation = false;
                //enable time fields
                jQuery('#scheduled-start-time, #scheduled-end-time').prop('disabled', false);

                if (jQuery('#scheduled-start-time').val() == '' && jQuery('#scheduled-end-time').val() == '')
                {
                    jQuery('#scheduled-start-time').val('00:00');
                    jQuery('#scheduled-end-time').val('00:00');
                }

                if (jQuery('#scheduled-start-time').val() == '' && jQuery('#scheduled-end-time').val() != '')
                    jQuery('#scheduled-start-time').val(jQuery('#scheduled-end-time').val());

                if(jQuery('#scheduled-start-time').val() > jQuery('#scheduled-end-time').val() || jQuery('#scheduled-end-time').val() == '')
                    jQuery('#scheduled-end-time').val(jQuery('#scheduled-start-time').val());

                var timeDifference = timeDiff(jQuery('#scheduled-start-time').val(), jQuery('#scheduled-end-time').val());

                var dayUsageKey = HoursToKeyUsagePatternMap[timeDifference.toFixed(2)];

                if(dayUsageKey == undefined || dayUsageKey == null)
                {
                   var e = '{!JSENCODE($Label.InvalidTimeInterval)}';
                    $c.find('.error-message').append('<span>' + e + '</span>');
                    $c.find('.error-container').show();
                    return;
                }

                jQuery('#sheduled-units').text(kimble.formatNumber(timeDifference, '0.00 '));

                day.ScheduledValue = KeyToHoursUsagePatternMap[dayUsageKey];

                day.StartTime = jQuery('#scheduled-start-time').val();
                day.EndTime = jQuery('#scheduled-end-time').val();

                if (jQuery('#scheduled-time-zone').val() != '')
                    day.TimeZoneSidKey = jQuery('#scheduled-time-zone').val();

                if (assignment.TheAssignment.TheTimeSlots == null) assignment.TheAssignment.TheTimeSlots = {};
                if (assignment.TheAssignment.TheTimeSlots[dte] == null) assignment.TheAssignment.TheTimeSlots[dte] = [];
                assignment.TheAssignment.TheTimeSlots[dte] = [{StartTime:day.StartTime, EndTime:day.EndTime}];

                jQuery('#edit-fte-additional input, #edit-fte-additional textarea, #edit-fte-additional select').prop('disabled', false);
                jQuery('#edit-fte-additional a').show();

                day.CustomFields = getCustomFields();
            }
            else if (jQuery('#off-toggle').prop('checked'))
            {
                day.RevertToUtilisation = false;
                day.ScheduledValue = 0;
                dayUsageKey = 'a';
            }

            assignment.HasChanges = true;

            if (activityAssignmentQuickActions.mode != 'single')
            {
                if (dte.toDate() < assignment.TheAssignment.StartDate.toDate() || dte.toDate() > assignment.TheAssignment.EndDate.toDate())
                {
                    if (dte.toDate() < assignment.TheAssignment.StartDate.toDate())
                    {
                        assignment.TheAssignment.StartDate = dte;
                    }
                    else if (dte.toDate() > assignment.TheAssignment.EndDate.toDate())
                    {
                        assignment.TheAssignment.EndDate = dte;
                    }
                    usagePattern = usagePattern.createForDerivedUsage(assignment.TheAssignment.StartDate.toDate(), assignment.TheAssignment.EndDate.toDate(), assignment.TheAssignment.BaselineUtilisation, availability, null, assignment.TheAssignment.HoursPerDay);
                }

                usagePattern.addScheduledDay(dte.toDate(), dayUsageKey);
                assignment.TheAssignment.UsagePattern = usagePattern.usagePattern;

                usagePattern = recalculateAssignmentUsage(assignment.TheAssignment, availability , assignment.TheAssignment.HoursPerDay);

                assignment.TheAssignment.EndDate = usagePattern.endDate.toKimbleUTC();
                assignment.TheAssignment.Utilisation = usagePattern.actualUtilisation;
                assignment.TheAssignment.UsagePattern = usagePattern.usagePattern;

                // re-draw assigment since % usage may flatten on other days
                activityAssignmentQuickActions.redrawAssignments([assignment.TheAssignment]);
            }
        }

        function getCustomFields()
        {
            var customFields = {};

            jQuery.each(jQuery('.fte-details-field'), function(i, obj){
                   var fld = jQuery(obj);

                    var typ = fld.attr('data-fld-type').toUpperCase();
                    var fldName = fld.attr('data-fld-name');
                    var val = null;

                    if (typ == 'REFERENCE')
                    {
                        val = fld.closest('td').find('[id $= "lkid"]').val();
                    }
                    else if (typ == 'INTEGER' || typ == 'LONG')
                    {
                        val = kimble.parseNumber(fld.val(), '#,###');
                    }
                    else if (typ == 'DOUBLE' || typ == 'PERCENT')
                    {
                        val = kimble.parseNumber(fld.val(),'#,###.####');
                    }
                    else if (typ == 'DATE')
                    {
                        val = kimble.parseDate(fld.val());
                    }
                    else if (typ == 'BOOLEAN')
                    {
                        val = fld.prop('checked');
                    }
                    else
                    {
                        val = fld.val();
                    }

                   customFields[fldName] = {Name:fldName, DisplayType:typ, Value:val};
            });

            jQuery('#edit-fte-additional input, #edit-fte-additional textarea, #edit-fte-additional select').prop('disabled', false);
            jQuery('#edit-fte-additional a').show();

            return customFields;
        }

