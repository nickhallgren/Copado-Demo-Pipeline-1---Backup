                        {
                            fld.attr('value', kimble.formatNumber(val, '#,###.####'));
                        }
                        else if (typ == 'DATE')
                        {
                            fld.attr('value', kimble.formatDate((new Date(val)).toKimbleUTC()));
                        }
                        else if (typ == 'TEXTAREA')
                        {
                            fld.text(val);
                        }
