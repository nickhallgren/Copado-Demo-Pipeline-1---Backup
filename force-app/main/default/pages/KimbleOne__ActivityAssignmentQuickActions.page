                                    fld[0].options[i].setAttribute('selected','true');
                                }
                            }
                        }
                        else
                        {
                            fld.attr('value', val);
                        }
                    }
                    else
                    {
                        if (typ == 'BOOLEAN')
                        {
                            fld.removeAttr('checked');
                        }
                        else
                        {
                            fld.attr('value', '');
                        }
                    }
                });
                }
