        function saveAssignmentSchedules(oncomplete, onerror)
        {
            //save assignments that have changed.
            var assignmentsToSave = {};
            var assignmentsToSaveIds = [];

            //jQuery('.gantt-container').qtip('destroy', true);

            jQuery.each(Object.keys(activityAssignmentQuickActions.assignments), function(i, key) {

                var a = activityAssignmentQuickActions.assignments[key];

                var hasError = false;

                if (a.HasChanges)
                {
                    if (assignmentsToSave[a.TheAssignment.ScopingActivityId] == null) assignmentsToSave[a.TheAssignment.ScopingActivityId] = {};

                    assignmentsToSave[a.TheAssignment.ScopingActivityId][a.AssignmentId] = {AssignmentId:a.AssignmentId, CalendarId:a.TheAssignment.ResourceCalendarId, ResourceId:a.TheAssignment.ResourceId, ScheduleWithTime: a.ScheduleWithTime, HasForecastTimeEntry: a.HasForecastTimeEntry, TheScheduledDays:a.TheScheduledDays};

                    assignmentsToSaveIds.push(a.AssignmentId);
                }
            });

            if(Object.keys(assignmentsToSave).length == 0) {
                cancelAssignmentsSchedule();
                oncomplete();

                return;
            }
            //loop through scoping activities to save
            activityAssignmentQuickActions.assignmentsToSaveCount = 0;

            jQuery.each(Object.keys(assignmentsToSave), function(i, key){

                saveAssignmentSchedulesRemoteAction(key, assignmentsToSave[key], function(){
                activityAssignmentQuickActions.assignmentsToSaveCount--;

                if (activityAssignmentQuickActions.assignmentsToSaveCount == 0)
                {
                    activityAssignmentQuickActions.assignments = {};
                    activityAssignmentQuickActions.original = {};

                    if (activityAssignmentQuickActions.mode != 'single')
                    {
                        cancelAssignmentsSchedule();

                        jQuery('.action-col a').show();

                        jQuery('.assignment-snip').show();

                        //TODO_SGT - Handle save errors
                    }

                    oncomplete(assignmentsToSaveIds);
                }
            }, onerror);
                activityAssignmentQuickActions.assignmentsToSaveCount ++;
            });
        }

        function saveAssignmentSchedulesRemoteAction(activityId, assignmentsToSave, oncomplete, onerror)
        {

            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentQuickActionsController.ScheduleAssignments}',
                    activityId, assignmentsToSave,
                        function(result, event){
                            if (event.status)
                            {
                                oncomplete();
                            }
                            else if (event.type === 'exception')
                            {
                                if (onerror == null) {
                                    alert(event.message);
                                }
                                else {
                                    onerror(event.message);
                                }
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {buffer: false, escape: true, timeout: 60000}
                );
        }

        function saveProfiledAssignments($assignmentContainers, resources, findAssignment, mode, oncomplete, onerror)
        {
            //save assignments that have changed.
            var assignmentsToSave = {};
            var assignmentsToSaveIds = [];

            // Assignments to save //
            jQuery.each($assignmentContainers, function(i, obj) {

                var $o = jQuery(obj);

                var hasError = false;

                if ($o.find('.has-changes').length > 0)
                {
                    var ass = findAssignment($o)
                    var availability = new ResourceAvailabilityUsagePattern(JSON.parse(resources[ass.ResourceId].AvailabilityPattern), false);

                    var usagePattern = '';

                    var assignmentUsage = new ActivityAssignmentUsagePattern(ass.HoursPerDay, ass.StartDate.toDate(), ass.UsagePattern, ass.Utilisation, ass.Utilisation);

                    var oldPattern = ass.UsagePattern;
                    var oldStart = ass.StartDate;

                    //mode is either usage or model-usage
                    var inputs = $o.find('input.' + mode).filter(function () {return this.value.length > 0});

                    var earliest;
                    var latest;

                    if (inputs.length > 0)
                    {
                        if (jQuery(inputs[0]).prop('disabled'))
                        {
                            earliest = ass.StartDate.toDate();
                        }
                        else
                        {
                            earliest = jQuery(inputs[0]).closest('.day-content').attr('start-dte').toDate();

                            while(!availability.isForecastingDate(earliest))
                            {
                                earliest = kimble.addDays(earliest, 1);
                            }
                        }

                        latest = jQuery(inputs[inputs.length-1]).closest('.day-content').attr('end-dte').toDate();

                        while(!availability.isForecastingDate(latest))
                        {
                            latest = kimble.addDays(latest, -1);
                        }
                    }

                    var startDate = earliest;
                    if (assignmentUsage.earliestFirmDate != null && assignmentUsage.earliestFirmDate < startDate) startDate = assignmentUsage.earliestFirmDate;
                    if (ass.EarliestTimeEntryDate != null && ass.EarliestTimeEntryDate.toDate() < startDate) startDate = ass.EarliestTimeEntryDate.toDate();

                    var endDate = latest;
                    if (assignmentUsage.latestFirmDate != null && assignmentUsage.latestFirmDate > endDate) endDate = assignmentUsage.latestFirmDate;
                    if (ass.LatestTimeEntryDate != null && ass.LatestTimeEntryDate.toDate() > endDate) endDate = ass.LatestTimeEntryDate.toDate();

                    ass.StartDate = startDate.toKimbleUTC();

                    //loop through all dates
                    while (startDate.valueOf() <= endDate.valueOf())
                    {
                        var thisDate =  startDate;

                        startDate = new Date(thisDate.getFullYear(), thisDate.getMonth(), thisDate.getDate() + 1, 0, 0, 0, 0);

                        var $c = $o.find('.day-content').filter(function() {return jQuery(this).attr('start-dte').toDate() <= thisDate && jQuery(this).attr('end-dte').toDate() >= thisDate});

                        if (assignmentUsage.startDate <= thisDate && assignmentUsage.endDate >= thisDate && ($c.length == 0 || assignmentUsage.getActualInHoursOnDate(thisDate) > 0 || !assignmentUsage.isUtilisationDay(thisDate)) || !availability.isForecastingDate(thisDate))
                        {
                           var u = assignmentUsage.getUsagePatternOnDate(thisDate);

                           if (u == null || u == '') u = (NONFORECASTDAY + ':0');

                           usagePattern += (u + ',');
                        }
                        else
                        {

                          var val = kimble.parseNumber($c.find('input.' + mode).val());

                           var min = new Number($c.find('input.' + mode).prop('min'));

                           if (val == null) val = 0;

                           if (val < min)
                           {
                               hasError = true;
                           }

                           var valToForecast = val - min;

                           //need to divide val between number of utilisation days between start and end
                            var utilDays = $c.attr('util-days');

                            if (mode == 'model-usage')
                            {
                                usagePattern += ((valToForecast * ass.Utilisation).toFixed(6) + ':0,');
                            }
                            else
                            {
                                valToForecast = valToForecast / utilDays;

                                if (!$o.hasClass('gantt-daily-usage') && ass.ForecastUnitsEnum == 'Day') valToForecast = valToForecast * ass.HoursPerDay;
                                usagePattern += (((valToForecast / ass.HoursPerDay) * 100).toFixed(6) + ':0,');
                            }
                        }
                    }

                    if (!hasError && (oldPattern != usagePattern || oldStart != ass.StartDate))
                    {
                        if (assignmentsToSave[ass.ScopingActivityId] == null) assignmentsToSave[ass.ScopingActivityId] = {};

                        assignmentsToSave[ass.ScopingActivityId][ass.Id] = {StartDate:ass.StartDate, NewUsagePattern:usagePattern, OldUsagePattern:ass.UsagePattern};

                        assignmentsToSaveIds.push(ass.Id);
                    }
                }
            });

            if(Object.keys(assignmentsToSave).length == 0)
            {
                oncomplete([]);
                return;
            }
            //loop through scoping activities to save
            activityAssignmentQuickActions.assignmentsToSaveCount = 0;

            jQuery.each(Object.keys(assignmentsToSave), function(i, key){

                saveProfiledAssignmentsRemoteAction(assignmentsToSave[key], function(){
                    activityAssignmentQuickActions.assignmentsToSaveCount--;

                    if (activityAssignmentQuickActions.assignmentsToSaveCount == 0)
                    {
                        //TODO_SGT - Handle save errors

                        oncomplete(assignmentsToSaveIds);
                    }
                }, onerror);

                activityAssignmentQuickActions.assignmentsToSaveCount ++;
            });
        }

        function saveProfiledAssignmentsRemoteAction(assignmentsToSave, oncomplete, onerror)
        {
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentRemoteActions.ProfileAssignmentUsagePattern}',
                    assignmentsToSave,
                        function(result, event){
                            if (event.status)
                            {
                                oncomplete();
                            }
                            else if (event.type === 'exception')
                            {
                                if (onerror != null)
                                    onerror(event.message);
                                else
                                    alert(event.message);
                            }
                            else
                            {
                                alert(event.message);
                            }
                    },
                    {buffer: false, escape: true, timeout: 60000}
                );
        }

        function getSchedulingDetails()
        {
            jQuery('#save-and-schedule-assignment-container .btn').prop('disabled', true);

            var $c = jQuery('#save-and-schedule-assignment-container');
            var activityId = $c.attr('scoping-activity-id');
            var resourceId = kimble.parseId(jQuery('#save-and-schedule-resource-row:visible input:hidden[id$="lkid"], #save-and-schedule-resource-row:visible select').val());

