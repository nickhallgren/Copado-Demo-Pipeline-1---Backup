        }

        function saveAndScheduleNewAssignment()
        {
            var $c = jQuery('#save-and-schedule-assignment-container');
            var activityId = $c.attr('scoping-activity-id');
            var dte = $c.attr('dte');
            var resourceId = kimble.parseId(jQuery('#save-and-schedule-resource-row:visible input:hidden[id$="lkid"], #save-and-schedule-resource-row:visible select').val());
            if (resourceId == null || resourceId == '' || resourceId == '000000000000000')
            {
                var errorMessage = ('{!JSENCODE($label.RequiredValue)}').replace('{0}', '{!JSENCODE($ObjectType.ActivityAssignment__c.Fields.Resource__c.Label)}');
                alert(errorMessage);
                return;
            }

            var roleId = null;

            if (jQuery('#save-and-schedule-role-row').length != 0) {
               roleId = kimble.parseId(jQuery('#save-and-schedule-role-row:visible select').val());

                if (roleId == null || roleId == '' || roleId == '000000000000000')
                {
                    var errorMessage = ('{!JSENCODE($label.RequiredValue)}').replace('{0}', '{!JSENCODE($ObjectType.ActivityAssignment__c.Fields.ActivityRole__c.Label)}');
                    alert(errorMessage);
                    return;
                }
            }

            var locationId = null;

            if (jQuery('#save-and-schedule-location-row').length != 0) {
               locationId = kimble.parseId(jQuery('#save-and-schedule-location-row:visible select').val());

                if (locationId == null || locationId == '' || locationId == '000000000000000')
                {
                    var errorMessage = ('{!JSENCODE($label.RequiredValue)}').replace('{0}', '{!JSENCODE($ObjectType.ActivityAssignment__c.Fields.Location__c.Label)}');
                    alert(errorMessage);
                    return;
                }
            }

            jQuery('#loadingIndicatorOuterContainer').parent().show();
            jQuery('#save-and-schedule-assignment-container .btn').prop('disabled', true);

            var scheduledDay;
            var $c = jQuery('#save-and-schedule-details');

            if ($c.find('#pct-toggle').prop('checked'))
            {
                scheduledDay = null;
            }
            else if ($c.find('#specific-toggle').prop('checked'))
            {
                scheduledDay = {scheduledValue: $c.find('#specific-toggle').parent().find('select').val(), CustomFields : getCustomFields()};
            }
            else if ($c.find('#time-toggle').prop('checked'))
            {
                scheduledDay = {scheduledValue: 0, StartTime:null, EndTime:null, TimeZoneSidKey:null, CustomFields:{}};

                var timeDifference = timeDiff(jQuery('#scheduled-start-time').val(), jQuery('#scheduled-end-time').val());
                var dayUsageKey = HoursToKeyUsagePatternMap[timeDifference.toFixed(2)];

                if(dayUsageKey == undefined || dayUsageKey == null)
                {
                   var e = '{!JSENCODE($Label.InvalidTimeInterval)}';

                    $c.find('#quick-add-assignment-error-text').append('<span>' + e + '</span>');
                    $c.find('#quick-add-assignment-error').show();
                    return;
                }

                jQuery('#sheduled-units').text(kimble.formatNumber(timeDifference, '0.00 '));

                scheduledDay.ScheduledValue = KeyToHoursUsagePatternMap[dayUsageKey];

                scheduledDay.StartTime = jQuery('#scheduled-start-time').val();
                scheduledDay.EndTime = jQuery('#scheduled-end-time').val();

                if (jQuery('#scheduled-time-zone').val() != '') scheduledDay.TimeZoneSidKey = jQuery('#scheduled-time-zone').val();
            }
            else if ($c.find('#off-toggle').prop('checked'))
            {
                scheduledDay = {scheduledValue: 0};
            }

            createActivityAssignmentRemoteAction(activityId, resourceId, roleId, locationId, dte, scheduledDay, function(result){jQuery.publish('kimble.assignmentChanged', {assignmentId:result});});
        }

        function closeSaveAndScheduleNewAssignment()
        {
            jQuery('.day-to-schedule').remove();
        }

        function createActivityAssignmentRemoteAction(scopingActivityId, resourceId, roleId, locationId, startDate, scheduledDay, oncomplete)
        {
            jQuery('#quick-add-assignment-error-text').text('');
            jQuery('#quick-add-assignment-error').hide();

            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.ActivityAssignmentQuickActionsController.CreateActivityAssignment}',
                    scopingActivityId, resourceId, roleId, locationId, startDate, scheduledDay,
                        function(result, event){
                            if (event.status)
                            {
                                oncomplete(result);
                            }
                            else if (event.type === 'exception')
                            {
                                jQuery('#loadingIndicatorOuterContainer').parent().hide();
                                jQuery('#quick-add-assignment-error-text').text(event.message);
                                jQuery('#quick-add-assignment-error').show();
                            }
                            else
                            {
                                alert(event.message);
                            }

                            jQuery('#save-and-schedule-assignment-container .btn').prop('disabled', false);
                    },
                    {buffer: false, escape: true, timeout: 60000}
                );
        }

