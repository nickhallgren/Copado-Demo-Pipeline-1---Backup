	<apex:actionFunction name="loadGuidance" rerender="kimbleTooltipsResource" oncomplete="initialisePageTips();"/>

	<div style="display:none;" kimble-tip="null"></div>
		
	</apex:form>
	
	<script>
		jQuery(window).load(function()
		{					
			var resourceId = '<apex:outputText value="{!KimbleOne__Resource__c.Id}"/>';
			
			jQuery('div[pageSource]').each(function() {
	   		var theComponent = jQuery( this );
	   		var pageSourceName = theComponent.attr('pageSource');
	   		
	   		// kick off the population of the page with an ajax call
			jQuery.ajax({ url: kimble.pages[pageSourceName] + resourceId})
				.done(function(html) {
					jQuery(html).appendTo("#" + theComponent.attr('id'));
				})
				.fail(function(xhr, status, error) {
					if(error !=null && error !="") alert(error);								
				})				
			});
			
			initialiseRateSummaries();
			kimble.formatCurrencies();
			initialisePageTips();
		});
		
		var contextDate = '<apex:outputText value="{!ContextDate}"/>';
		var currencyCode = '<apex:outputText value="{!KimbleOne__Resource__c.CurrencyISOCode}"/>';
		
		var temporalValues;
		<apex:outputPanel layout="none" rendered="{!!ISBLANK(TemporalValuesJson)}">
			temporalValues = kimble.parseJSON("{!JSENCODE(TemporalValuesJson)}");
		</apex:outputPanel>

		var ratesLockedFromDate = '<apex:outputText value="{!RevenueAndCostsLockedFromDate}"/>';

		function parseRateJson (j)
		{
			return kimble.parseJSON(j.replace(/"Rate"/g, '"R"').replace(/"FromDate"/g, '"D"').replace(/"CurrencyCode"/g, '"C"'));
		}
		
		function initialiseRateSummaries()
		{
			jQuery.each(jQuery('.rate-summary'), function (i, summary) {
			
				var j = jQuery(summary);
				
				if (j.text() == '') return true;
				
				// Display today's value with an info value next to it to display a tooltip to show all history
				var summaryArray = parseRateJson(j.text());
				
				var temporalArray = new Array();
				
				for (var i=0; i<summaryArray.length; i++)
				{
					var isLocked = (ratesLockedFromDate != '' && summaryArray.length > 1 && ratesLockedFromDate.toDate() > summaryArray[i].D.toDate());

					temporalArray.push({locked:isLocked, FromDate:summaryArray[i].D, Value: summaryArray[i].C + ' ' + kimble.formatNumber(summaryArray[i].R, '#,##0.00')});
					
					if (contextDate.toDate() >= summaryArray[i].D.toDate())
						j.text(summaryArray[i].C + ' ' + kimble.formatNumber(summaryArray[i].R, '#,##0.00')).show();			
				}
				
				j.after(jQuery('<span class="fa fa-info-circle temporal-properties"/>').data('temporal-values', temporalArray));

			});
			
			jQuery.each(jQuery('.temporal-value'), function (i, summary) {
			
				var j = jQuery(summary);
				
				var temporalArray = temporalValues[j.attr('data-object-type')];
				
				if (temporalArray != null) j.after(jQuery('<span class="fa fa-info-circle temporal-properties"/>').data('temporal-values', temporalArray));								
			});
			
			jQuery(document).on('mouseover', '.temporal-properties', function (event) {
				var j = jQuery(this); 
								
				var temporalArray = j.data('temporal-values');
				
				var tipHtml = '<table class="list temporal-display">';
				tipHtml += '<tr><th></th><th>' + 'Effective Date' + '</th>';
				tipHtml += '<th>' + 'Value' + '</th></tr>';
								
				for(var i=0; i<temporalArray.length;i++)
				{
					tipHtml += '<tr><td>' + (temporalArray[i].locked ? '<i class="fa fa-lock"/>':'') + '</td>';
					tipHtml += '<td>' + kimble.formatDate(temporalArray[i].FromDate) + '</td>';
					tipHtml += '<td>' + temporalArray[i].Value + '</td></tr>';					
				}
				
				//tooltips
				j.qtip('destroy', true);
			 
				j.qtip({
					show: {
		                solo:true,
		                ready: true // Show immediately - important!
		            },
		            style: {
						classes: 'qtip-light qtip-shadow qtip-rounded'
			        },
					content: { 
						text: tipHtml,
						title: 'History'
					},
					position: { adjust: { method: 'flip flip'
						},
						viewport: $(window)
					}
				});
			   });		
		}
		
		/* Tooltips */
		var enableTips = <apex:outputText value="{!TooltipsEnabled}"/>;
		var BaseHelpURL = '<apex:outputText value="{!URLFOR($Resource.KimbleOne__KimbleHelp, '')}"/>';
		var DetailedHelpLabel = '<apex:outputText value="{!$Label.kimbleone__detailedhelp}"/>';
		var MoreLabel = '<apex:outputText value="{!$Label.kimbleone__more}"/>';
		var TipsEnabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsenabled}"/>';
		var TipsDisabledTip = '<apex:outputText value="{!$Label.kimbleone__tooltipsdisabled}"/>';
	
		function initialisePageTips()
		{
		    ApplyTipAttributes();
		    initialiseTips();
  		}
  		
		// add tip attributes to elements
		function ApplyTipAttributes()
		{
			if(enableTips)
			{
				jQuery('[id$="AllowanceSchemeOutput"]').attr('kimble-tip','AllowanceScheme').attr('kimble-tip-extended-text','AllowanceSchemeExtendedText').addClass('tip-right');
				jQuery('[id$="ActualCostOutput"]').attr('kimble-tip','ActualCost').attr('kimble-tip-extended-text','ActualCostExtendedText').addClass('tip-right');
				jQuery('[id$="ActualCostUnitTypeOutput"]').attr('kimble-tip','ActualCostUnitType').attr('kimble-tip-extended-text','ActualCostUnitTypeExtendedText');
				jQuery('[id$="AssignedUntilOutput"]').attr('kimble-tip','AssignedUntil').addClass('tip-right');
				jQuery('[id$="BusinessUnitSecondaryOutput"]').attr('kimble-tip','BusinessUnitSecondary').attr('kimble-tip-help-link','BusinessUnitSecondaryHelpLink').attr('kimble-tip-extended-text','BusinessUnitSecondaryExtendedText');
				jQuery('[id$="BusinessUnitOutput"]').attr('kimble-tip','BusinessUnit').attr('kimble-tip-help-link','BusinessUnitHelpLink').attr('kimble-tip-extended-text','BusinessUnitExtendedText').addClass('tip-right');
				jQuery('[id$="CalendarOutput"]').attr('kimble-tip','Calendar').attr('kimble-tip-extended-text','CalendarExtendedText').addClass('tip-right');
				jQuery('[id$="StartDateOutput"]').attr('kimble-tip','StartDate').addClass('tip-right');
				jQuery('[id$="EndDateOutput"]').attr('kimble-tip','EndDate').attr('kimble-tip-extended-text','EndDateExtendedText');
