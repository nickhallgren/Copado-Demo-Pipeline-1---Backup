<apex:page standardController="KimbleOne__DeliveryGroup__c" extensions="KimbleOne.IssueSummaryCardController" showHeader="false" sidebar="false" contentType="text/css" tabStyle="KimbleOne__DeliveryGroup__c">    

	<div class="card inverted variable-width min-horizontal-padding">
		<div class="cardHeading inverted">
			<h3 class="cardTitle"><a class="undecorated-link" href="{!$Page.KimbleOne__Issues}?id={!KimbleOne__DeliveryGroup__c.Id}"><apex:outputText value="{!$Label.kimbleone__deliverygroupissuessummary}"/></a></h3>
			<apex:outputPanel rendered="{!KimbleOne__DeliveryGroup__c.DeliveryStage__r.KimbleOne__AllowNewIssues__c}"><a href="{!$Page.IssueEdit}?parentId={!DeliveryGroup__c.Id}"><span class="card-action-icon fa fa-plus-square"></span></a></apex:outputPanel>
		</div>
	
	    <apex:outputPanel layout="none" rendered="{!HasIssues}">
			<div class="cardBody">
				<table class="list cardBodyTable" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr class="headerRow">
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.Name.Label}</h2></th>				
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.Summary__c.Label}</h2></th>				
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.RaisedByContact__c.Label}</h2></th>				
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.RaisedDate__c.Label}</h2></th>				
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.IssueImpact__c.Label}</h2></th>				
							<th class="headerRow"><h2>{!$ObjectType.Issue__c.Fields.Status__c.Label}</h2></th>				
						</tr>
					</thead>
					<tbody>
					<apex:repeat value="{!HighestIssues}" var="i" >	
						<tr class="dataRow">
	    					<td><apex:outputLink value="/{!i.Id}">{!i.Name}</apex:outputLink></td>
		    				<td style="max-width: 149px"><apex:outputField value="{!i.KimbleOne__Summary__c}"/></td>
		    				<td><apex:outputField value="{!i.KimbleOne__RaisedByContact__c}"/></td>
		    				<td><apex:outputField value="{!i.KimbleOne__RaisedDate__c}"/></td>
		    				<td><apex:outputField value="{!i.KimbleOne__IssueImpact__c}"/></td>
		    				<td><apex:outputField value="{!i.KimbleOne__Status__c}"/></td>
						</tr>
						</apex:repeat>
					</tbody>
				</table>
			</div>
		</apex:outputPanel>
	</div> 					
    <script>

    </script>
	
</apex:page>