<aura:component controller="atl_MainFilterApexController" implements="force:hasRecordId,forceCommunity:availableForAllPageTypes">
    
    <!-- Attributes -->
    <!-- Labels -->
    <aura:attribute name="commURL" type="String" default="{!$Label.c.atl_CommURL}" />
    <aura:attribute name="initialLoadMessage" type="String" default="{!$Label.c.atl_initialLoadMessage}" />
    <aura:attribute name="excelDownloadVerbiage" type="String" default="{!$Label.c.atl_excelDownloadVerbiage}" />
    <aura:attribute name="excelDownloadID" type="String" default="{!$Label.c.atl_excelDownloadID}" />
    <aura:attribute name="noResources" type="String" default="{!$Label.c.atl_noResources}" />
    <aura:attribute name="initialLoadMessageAdvisory" type="String" default="{!$Label.c.atl_initialLoadMessageAdvisory}" />
    <!-- Gate Labels -->
    <aura:attribute name="Gate0" type="String" default="{!$Label.c.atl_Gate0}" />
    <aura:attribute name="Gate1" type="String" default="{!$Label.c.atl_Gate1}" />
    <aura:attribute name="atl_Gate1_Advisory" type="String" default="{!$Label.c.atl_Gate1_Advisory}" />
    <aura:attribute name="Gate2" type="String" default="{!$Label.c.atl_Gate2}" />
    <aura:attribute name="atl_Gate2_Advisory" type="String" default="{!$Label.c.atl_Gate2_Advisory}" />
    <aura:attribute name="Gate3" type="String" default="{!$Label.c.atl_Gate3}" />
    <aura:attribute name="atl_Gate3_Advisory" type="String" default="{!$Label.c.atl_Gate3_Advisory}"/>
    <aura:attribute name="Gate4" type="String" default="{!$Label.c.atl_Gate4}" />
    <aura:attribute name="atl_Gate4_Advisory" type="String" default="{!$Label.c.atl_Gate4_Advisory}"/>
    <aura:attribute name="Gate5" type="String" default="{!$Label.c.atl_Gate5}" />
    <aura:attribute name="atl_Gate5_Advisory" type="String" default="{!$Label.c.atl_Gate5_Advisory}"/>
    <aura:attribute name="Stage0" type="String" default="{!$Label.c.atl_Stage0}" />
    <aura:attribute name="Stage1" type="String" default="{!$Label.c.atl_Stage1}" />
    <aura:attribute name="Stage2" type="String" default="{!$Label.c.atl_Stage2}" />
    <aura:attribute name="atl_Stage2_Advisory" type="String" default="{!$Label.c.atl_Stage2_Advisory}"/>
    <aura:attribute name="Stage3" type="String" default="{!$Label.c.atl_Stage3}" />
    <aura:attribute name="atl_Stage3_Advisory" type="String" default="{!$Label.c.atl_Stage3_Advisory}"/>
    <aura:attribute name="Stage4" type="String" default="{!$Label.c.atl_Stage4}" />
    <aura:attribute name="atl_Stage4_Advisory" type="String" default="{!$Label.c.atl_Stage4_Advisory}"/>
    <aura:attribute name="Stage5" type="String" default="{!$Label.c.atl_Stage5}" /> 
    <aura:attribute name="atl_Stage_5_Advisory" type="String" default="{!$Label.c.atl_Stage_5_Advisory}"/>
    <aura:attribute name="Stage6" type="String" default="{!$Label.c.atl_Stage6}" />
    <aura:attribute name="atl_Stage6_Advisory" type="String" default="{!$Label.c.atl_Stage6_Advisory}" />
    <aura:attribute name="Overlay1" type="String" default="{!$Label.c.atl_Overlay1}" />
    <aura:attribute name="Overlay2" type="String" default="{!$Label.c.atl_Overlay2}" />
    <aura:attribute name="Stage2_5_Cognizant" type="String" default="{!$Label.c.atl_Stage2_5_Cognizant}" />
    <aura:attribute name="Gate2_5_Cognizant" type="String" default="{!$Label.c.atl_Gate2_5_Cognizant}" />
    
    <!-- Data -->
    <aura:attribute name="allResources" type="atl_Resource__c[]" />
    <aura:attribute name="stages" type="List" />
    <aura:attribute name="roles" type="List" />
    <aura:attribute name="techs" type="List" />
    <aura:attribute name="activityId" type="String" />
    <aura:attribute name="templateGuideId" type="String" />
    <aura:attribute name="trainingId" type="String" />
    <aura:attribute name="stageLabel" type="String" />
    
    <!-- Utilities -->
    <aura:attribute name="downloadURL" type="String" default="sfc/servlet.shepherd/document/download/" access="private" />
    <aura:attribute name="advisoryOrDeliveryUrl" type="String" />
    <aura:attribute name="selectedStage" type="String" />
    <aura:attribute name="selectedRole" type="String" />
    <aura:attribute name="selectedTech" type="String" />
    <aura:attribute name="techOrOffering" type="String" />
    <aura:attribute name="shownResources" type="atl_Resource__c[]" />
    <aura:attribute name="filteredResources" type="atl_Resource__c[]" />
    <aura:attribute name="filteredResourcesShort" type="atl_Resource__c[]" />
    <aura:attribute name="hasActivities" type="Boolean" />
    <aura:attribute name="hasTemplates" type="Boolean" />
    <aura:attribute name="hasGuides" type="Boolean" />
    <aura:attribute name="hasTraining" type="Boolean" />
    <aura:attribute name="show20" type="Boolean" default="true"/>
    
    <!-- Methods -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Body -->
    <div class="mainFilterBody">
        <lightning:layout multipleRows="true" verticalAlign="start">
            
            <!-- Tech selection -->
            <lightning:layoutItem size="4" padding="around-small" class="center">
                <lightning:select name="techSelect" aura:id="techSelect" label="Technology" value="{!v.selectedTech}" required="true" onchange="{!c.filterResources}" variant="label-hidden">
                    <option text="{!v.techOrOffering}"></option>
                    <aura:iteration items="{!v.techs}" var="tech">
                        <option value="{! tech.value }" text="{! tech.label }"></option>
                    </aura:iteration>
                </lightning:select> <br />
            </lightning:layoutItem>
            
            <!-- Stage selection -->
            <lightning:layoutItem size="4" padding="around-small">
                <lightning:select name="stageSelect" aura:id="stageSelect" label="Stage" value="{!v.selectedStage}" onchange="{!c.filterResources}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.stages}" var="stage">
                        <option value="{! stage.value }" text="{! stage.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <!-- Role selection -->
            <lightning:layoutItem size="4" padding="around-small">
                <lightning:select name="roleSelect" aura:id="roleSelect" label="Role" value="{!v.selectedRole}" onchange="{!c.filterResources}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.roles}" var="role">
                        <option value="{! role.value }" text="{! role.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <aura:if isTrue="{! and(!v.selectedTech || v.selectedTech == v.techOrOffering) }">
                <lightning:layoutItem size="12" padding="around-small" class="atlSubtitle center">
                    <aura:if isTrue="{! v.advisoryOrDeliveryUrl == 'Delivery' }">
                        <img src="{!$Resource.atl_mainStartImage}"/> <br />
                        {!v.initialLoadMessage}
                        <aura:set attribute="else">
                            <img src="{!$Resource.atl_AdvisoryMainStartImage}"/> <br />
                            {!v.initialLoadMessageAdvisory}
                        </aura:set>
                    </aura:if>
                    
                </lightning:layoutItem>
                <aura:set attribute="else">
                    <!-- Stage Label -->
                    <aura:if isTrue="{! !(v.selectedStage == 'All') }">
                        <lightning:layoutItem size="12" padding="around-small">
                            {!v.stageLabel}
                        </lightning:layoutItem>       
                    </aura:if>
                </aura:set>
            </aura:if>
        </lightning:layout>
        <!-- <aura:if isTrue="{! !(!v.selectedTech || v.selectedTech == 'Select Technology' || !v.selectedStage || v.selectedStage == 'Select Stage' || !v.selectedRole || v.selectedRole == 'Select Role') }"> -->
        <aura:if isTrue="{! !(!v.selectedTech || v.selectedTech == v.techOrOffering) }">
            <aura:if isTrue="{! empty(v.filteredResources) }">
                <div class="atlSubtitle center">
                    <img src="{!$Resource.atl_NoResults}"/> <br />
                    {!v.noResources}
                </div>
                <aura:set attribute="else">
                    
                    <lightning:layout multipleRows="true" verticalAlign="stretch">
                        
                        <lightning:layoutItem size="3" padding="around-small">
                            <div class="atlSubtitle">Activities</div>
                        </lightning:layoutItem>
                        
                        <lightning:layoutItem size="3" padding="around-small">
                            <div class="atlSubtitle">Templates</div>
                        </lightning:layoutItem>
                        
                        <lightning:layoutItem size="3" padding="around-small">
                            <div class="atlSubtitle">Guides</div>
                        </lightning:layoutItem>
                        
                        <lightning:layoutItem size="3" padding="around-small">
                            <div class="atlSubtitle">Training</div>
                        </lightning:layoutItem>
                        
                        <lightning:layoutItem size="3" padding="around-small" class="atlasBox">
                            <lightning:layout multipleRows="true">
                                <aura:if isTrue="{! !v.hasActivities }">
                                    <lightning:layoutItem size="12" padding="around-small" class="center">
                                        <img src="{!$Resource.atl_NoResults}"/> <br />
                                        No activities available for current selection.
                                    </lightning:layoutItem>
                                </aura:if>
                                <aura:iteration items="{!v.shownResources}" var="res">
                                    <aura:if isTrue="{! res.atl_ResourceType__c == 'Activity' }">
                                        <lightning:layoutItem size="2" padding="around-small" class="center">
                                            <lightning:icon iconName="utility:task" alternativeText="Activity" title="Activity" size="x-small"/>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="10" padding="around-small">
                                            {! res.atl_DisplayName__c } <br />
                                        </lightning:layoutItem>
                                    </aura:if>
                                </aura:iteration>
                                <lightning:layoutItem size="12" padding="around-small" class="downloadLink">
                                    <a href="{! v.commURL + v.downloadURL + v.excelDownloadID }">{!v.excelDownloadVerbiage}</a>
                                </lightning:layoutItem>
                            </lightning:layout>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="3" padding="around-small" class="atlasBox">
                            <lightning:layout multipleRows="true">
                                <aura:if isTrue="{! !v.hasTemplates }">
                                    <lightning:layoutItem size="12" padding="around-small" class="center">
                                        <img src="{!$Resource.atl_NoResults}"/> <br />
                                        No templates available for current selection.
                                    </lightning:layoutItem>
                                </aura:if>
                                <aura:iteration items="{!v.shownResources}" var="res">
                                    <aura:if isTrue="{! res.atl_ResourceType__c == 'Template' }">
                                        <lightning:layoutItem size="2" padding="around-small" class="center">
                                            <lightning:icon iconName="utility:work_order_type" alternativeText="Template" title="Template" size="x-small"/>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="10" padding="around-small">
                                            <aura:if isTrue="{! empty(res.atl_Link__c) }">
                                                <a href="{! v.commURL + v.downloadURL + res.atl_SalesforceFileId__c }" target="_blank"> {! res.atl_DisplayName__c } </a>
                                                <aura:set attribute="else">
                                                    <a href="{! res.atl_Link__c }" target="_blank"> {! res.atl_DisplayName__c } </a>
                                                </aura:set>
                                            </aura:if>
                                        </lightning:layoutItem>
                                    </aura:if>
                                </aura:iteration>
                            </lightning:layout>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="3" padding="around-small" class="atlasBox">
                            <lightning:layout multipleRows="true">
                                <aura:if isTrue="{! !v.hasGuides }">
                                    <lightning:layoutItem size="12" padding="around-small" class="center">
                                        <img src="{!$Resource.atl_NoResults}"/> <br />
                                        No guides available for current selection.
                                    </lightning:layoutItem>
                                </aura:if>
                                <aura:iteration items="{!v.shownResources}" var="res">
                                    <aura:if isTrue="{! res.atl_ResourceType__c == 'Guide' }">
                                        <lightning:layoutItem size="2" padding="around-small" class="center">
                                            <lightning:icon iconName="utility:work_order_type" alternativeText="Guide" title="Guide" size="x-small"/>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="10" padding="around-small">
                                            <aura:if isTrue="{! empty(res.atl_Link__c) }">
                                                <a href="{! v.commURL + v.downloadURL + res.atl_SalesforceFileId__c }" target="_blank"> {! res.atl_DisplayName__c } </a>
                                                <aura:set attribute="else">
                                                    <a href="{! res.atl_Link__c }" target="_blank"> {! res.atl_DisplayName__c } </a>
                                                </aura:set>
                                            </aura:if>
                                        </lightning:layoutItem>
                                    </aura:if>
                                </aura:iteration>
                            </lightning:layout>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="3" padding="around-small" class="atlasBox">
                            <lightning:layout multipleRows="true">
                                <aura:if isTrue="{! !v.hasTraining }">
                                    <lightning:layoutItem size="12" padding="around-small" class="center">
                                        <img src="{!$Resource.atl_NoResults}"/> <br />
                                        No training available for current selection.
                                    </lightning:layoutItem>
                                </aura:if>
                                <aura:iteration items="{!v.shownResources}" var="res">
                                    <aura:if isTrue="{! res.atl_ResourceType__c == 'Training' }">
                                        <aura:if isTrue="{! res.atl_TrainingType__c == 'Trailhead' }">
                                            <lightning:layoutItem size="2" padding="around-small" class="center">
                                                <lightning:icon iconName="utility:trailhead" alternativeText="Guide" title="Guide" size="x-small"/>
                                            </lightning:layoutItem>
                                            <aura:set attribute="else">
                                                <lightning:layoutItem size="2" padding="around-small" class="center">
                                                    <lightning:icon iconName="utility:video" alternativeText="Guide" title="Guide" size="x-small"/>
                                                </lightning:layoutItem>
                                            </aura:set>
                                        </aura:if>
                                        
                                        <lightning:layoutItem size="10" padding="around-small">
                                            <a href="{! res.atl_Link__c }" target="_blank"> {! res.atl_DisplayName__c } </a>
                                        </lightning:layoutItem>
                                    </aura:if>
                                </aura:iteration>
                            </lightning:layout>
                        </lightning:layoutItem>
                        <aura:if isTrue="{! and(v.show20, !equals(v.filteredResources.length, v.filteredResourcesShort.length)) }">
                            <lightning:layoutItem size="12" class="showAllCell">
                                <lightning:button variant="brand" onclick="{!c.showAll}" title="Show All" label="Show All" />
                            </lightning:layoutItem>
                        </aura:if>
                    </lightning:layout>
                </aura:set>
            </aura:if>
        </aura:if>
        
    </div>
</aura:component>