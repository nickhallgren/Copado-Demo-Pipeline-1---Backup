<aura:component controller="atl_TemplatesAndGuidesApexController"  implements="force:hasRecordId,forceCommunity:availableForAllPageTypes">
    
    <!-- Attributes -->
    <!-- Labels -->
    <aura:attribute name="commURL" type="String" default="{!$Label.c.atl_CommURL}" />
    <aura:attribute name="noResources" type="String" default="{!$Label.c.atl_noResources}" />
    <aura:attribute name="downloadAllVerbiage" type="String" default="{!$Label.c.atl_DownloadAllTemplatesGuides}" />
    <aura:attribute name="initialLoadMessage" type="String" default="{!$Label.c.atl_initialLoadMessage}" />
    <aura:attribute name="initialLoadMessageAdvisory" type="String" default="{!$Label.c.atl_initialLoadMessageAdvisory}" />
    
    <!-- Data -->
    <aura:attribute name="allTGs" type="atl_Resource__c[]" />
    <aura:attribute name="stages" type="List" />
    <aura:attribute name="roles" type="List" />
    <aura:attribute name="techs" type="List" />
    <aura:attribute name="statuses" type="List" />
    <aura:attribute name="owners" type="List" />
    <aura:attribute name="downloadAllURL" type="String" />
    <aura:attribute name="isAdvisory" type="Boolean" />
    <aura:attribute name="isAtgDelivery" type="Boolean" />
    <aura:attribute name="isCognizantDelivery" type="Boolean" />
    
    <!-- Utilities -->
    <aura:attribute name="downloadURL" type="String" default="sfc/servlet.shepherd/document/download/" access="private" />
    <aura:attribute name="selectedStage" type="String" />
    <aura:attribute name="selectedRole" type="String" />
    <aura:attribute name="selectedTech" type="String" />
    <aura:attribute name="selectedStatus" type="String" />
    <aura:attribute name="selectedOwner" type="String" />
    <aura:attribute name="techOrOffering" type="String" />
    <aura:attribute name="filteredTGs" type="atl_Resource__c[]" />
    
    <!-- Methods -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Body -->
    <div class="mainFilterBody">
        <lightning:layout multipleRows="true" verticalAlign="start">
            
            <lightning:layoutItem size="1" padding="around-small">
                <!-- spacing -->
            </lightning:layoutItem>
            
            <!-- Tech selection -->
            <lightning:layoutItem size="2" padding="around-small" class="center">
                <lightning:select name="techSelect" aura:id="techSelect" label="Technology" value="{!v.selectedTech}" required="true" onchange="{!c.filterTGs}" variant="label-hidden">
                    <option text="{!v.techOrOffering}"></option>
                    <aura:iteration items="{!v.techs}" var="tech">
                        <option value="{! tech.value }" text="{! tech.label }"></option>
                    </aura:iteration>
                </lightning:select> <br />
            </lightning:layoutItem>
            
            <!-- Stage selection -->
            <lightning:layoutItem size="2" padding="around-small">
                <lightning:select name="stageSelect" aura:id="stageSelect" label="Stage" value="{!v.selectedStage}" onchange="{!c.filterTGs}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.stages}" var="stage">
                        <option value="{! stage.value }" text="{! stage.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <!-- Role selection -->
            <lightning:layoutItem size="2" padding="around-small">
                <lightning:select name="roleSelect" aura:id="roleSelect" label="Role" value="{!v.selectedRole}" onchange="{!c.filterTGs}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.roles}" var="role">
                        <option value="{! role.value }" text="{! role.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <!-- Status selection -->
            <lightning:layoutItem size="2" padding="around-small">
                <lightning:select name="statusSelect" aura:id="statusSelect" label="Status" value="{!v.selectedStatus}" onchange="{!c.filterTGs}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.statuses}" var="status">
                        <option value="{! status.value }" text="{! status.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <!-- Owner selection -->
            <lightning:layoutItem size="2" padding="around-small">
                <lightning:select name="ownerSelect" aura:id="ownerSelect" label="Owner" value="{!v.selectedOwner}" onchange="{!c.filterTGs}" required="true" variant="label-hidden">
                    <aura:iteration items="{!v.owners}" var="owner">
                        <option value="{! owner.value }" text="{! owner.label }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <lightning:layoutItem size="1" padding="around-small">
                <!-- spacing -->
            </lightning:layoutItem>
            
        </lightning:layout>
        <!-- <aura:if isTrue="{! !(!v.selectedTech || v.selectedTech == 'Select Technology' || !v.selectedStage || v.selectedStage == 'Select Stage' || !v.selectedRole || v.selectedRole == 'Select Role' || !v.selectedStatus || v.selectedStatus == 'Select Status' || !v.selectedOwner || v.selectedOwner == 'Select Owner') }"> -->
        <aura:if isTrue="{! !(!v.selectedTech || v.selectedTech == v.techOrOffering) }">
            <aura:if isTrue="{! empty(v.filteredTGs) }">
                <div class="atlSubtitle center">
                    <img src="{!$Resource.atl_NoResults}"/> <br />
                    {!v.noResources}
                </div>
                <aura:set attribute="else">
                    
                    <lightning:layout multipleRows="true" verticalAlign="start" class="atlasBox">
                        <lightning:layoutItem size="3" padding="around-small" class="atlSubtitle" >
                            Name
                        </lightning:layoutItem>
                        <lightning:layoutItem size="3" padding="around-small" class="atlSubtitle" >
                            Stage
                        </lightning:layoutItem>
                        <lightning:layoutItem size="2" padding="around-small" class="atlSubtitle" >
                            Role
                        </lightning:layoutItem>
                        <lightning:layoutItem size="2" padding="around-small" class="atlSubtitle" >
                            Status
                        </lightning:layoutItem>
                        <lightning:layoutItem size="2" padding="around-small" class="atlSubtitle" >
                            Owner
                        </lightning:layoutItem>
                        <aura:iteration items="{!v.filteredTGs}" var="tg">
                            <lightning:layoutItem size="3" padding="around-small">
                                <lightning:layout >
                                    <lightning:layoutItem size="2">
                                        <lightning:icon iconName="utility:work_order_type" alternativeText="Guide" title="Guide" size="x-small" class="atlIcon"/>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="10">
                                        <aura:if isTrue="{! empty(tg.atl_Link__c) }">
                                                <a href="{! v.commURL + v.downloadURL + tg.atl_SalesforceFileId__c }" target="_blank"> {! tg.atl_DisplayName__c } </a>
                                                <aura:set attribute="else">
                                                    <a href="{! tg.atl_Link__c }" target="_blank"> {! tg.atl_DisplayName__c } </a>
                                                </aura:set>
                                            </aura:if>
                                        <!--a href="{! v.commURL + v.downloadURL + tg.atl_SalesforceFileId__c }" target="_blank"> {! tg.atl_DisplayName__c } </a-->
                                    </lightning:layoutItem>
                                </lightning:layout>
                            </lightning:layoutItem>
                            <aura:if isTrue="{! v.isAdvisory }">
                                <lightning:layoutItem size="3" padding="around-small" >
                                    <lightning:formattedRichText value="{! tg.atl_StageAdvisoryDisplay__c }"/> 
                                   <!--  {! tg.atl_StageAdvisoryDisplay__c }-->
                                </lightning:layoutItem>
                                <lightning:layoutItem size="2" padding="around-small" >
                                    {! tg.atl_Advisory_Role__c }
                                </lightning:layoutItem>
                                <aura:set attribute="else">
                                    <aura:if isTrue="{! v.isAtgDelivery }">
                                        <lightning:layoutItem size="3" padding="around-small" >
                                            <lightning:formattedRichText value="{! tg.atl_StageDisplay__c }"/>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="2" padding="around-small" >
                                            {! tg.atl_Role__c }
                                        </lightning:layoutItem>
                                        <aura:set attribute="else">
                                            <lightning:layoutItem size="3" padding="around-small" >
                                                <lightning:formattedRichText value="{! tg.atl_StageDisplayCognizant__c }"/>
                                            </lightning:layoutItem>
                                            <lightning:layoutItem size="2" padding="around-small" >
                                                {! tg.atl_Cognizant_Role__c  }
                                            </lightning:layoutItem>
                                        </aura:set>
                                    </aura:if>
                                </aura:set>
                            </aura:if>
                            <lightning:layoutItem size="2" padding="around-small" >
                                {! tg.atl_Status__c }
                            </lightning:layoutItem>
                            <lightning:layoutItem size="2" padding="around-small" >
                                {! tg.atl_owner__c }
                            </lightning:layoutItem>
                        </aura:iteration>
                        <lightning:layoutItem size="12" padding="around-small" class="downloadLink">
                            <a href="{! v.downloadAllURL }">{!v.downloadAllVerbiage}</a>
                        </lightning:layoutItem>
                    </lightning:layout>
                </aura:set>
            </aura:if>
            <aura:set attribute="else">
                <lightning:layoutItem size="12" padding="around-small" class="atlSubtitle center">                    
                    <aura:if isTrue="{! v.isAdvisory }">
                        <img src="{!$Resource.atl_TGStart}"/> <br />
                        {!v.initialLoadMessageAdvisory}
                        <aura:set attribute="else">
                            <img src="{!$Resource.atl_TGStart}"/> <br />
                          {!v.initialLoadMessage} 
                        </aura:set>
                    </aura:if>
                </lightning:layoutItem>
            </aura:set>
        </aura:if>
        
    </div>
</aura:component>