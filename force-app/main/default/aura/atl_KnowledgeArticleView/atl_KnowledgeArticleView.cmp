<aura:component controller="atl_KnowledgeBaseApexController" implements="force:hasRecordId,forceCommunity:availableForAllPageTypes" >
    
    <!-- Attributes -->
    <!-- Data -->
    <aura:attribute name="KA" type="atl_KnowledgeArticle__c" />
    <aura:attribute name="techString" type="String" />
    <aura:attribute name="domainString" type="String" />
    <aura:attribute name="hasSalesforce" type="Boolean" />
    
    <!-- Utilities -->
    <aura:attribute name="downloadURL" type="String" default="sfc/servlet.shepherd/document/download/" access="private" />
    <aura:attribute name="recordId" type="String" />
    
    <!-- Methods -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Body -->
    <div class="atlasKAV slds-p-horizontal_large">
        <!-- <div class="atlTitle">
            {!v.KA.atl_Title__c} 
        </div>
        <aura:if isTrue="{! v.hasSalesforce }">
            <div class="atlSubtitle">
                {!v.techString} | {!v.domainString} <br /> 
                {!v.KA.atl_AuthorName__c}
            </div>
            <aura:set attribute="else">
                <div class="atlSubtitle">
                     {!v.techString}  <br /> 
                    {!v.KA.atl_AuthorName__c}
                </div>
            </aura:set>
        </aura:if> -->
        <aura:if isTrue="{! v.KA.atl_Legacy__c }">
            <lightning:fileCard fileId="{! v.KA.atl_SalesforceFileID__c }" description="{! v.KA.atl_Title__c + ' Preview' }" />
            <aura:set attribute="else">
                <lightning:formattedRichText value="{! v.KA.atl_Body__c }"/> 
            </aura:set>
        </aura:if>        
    </div>
</aura:component>