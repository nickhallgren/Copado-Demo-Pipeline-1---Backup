<aura:component controller="atl_KnowledgeBaseApexController" implements="force:hasRecordId,forceCommunity:availableForAllPageTypes">
    
    <!-- Attributes -->
    <!-- Generic Labels -->
    <aura:attribute name="commURL" type="String" default="{!$Label.c.atl_CommURL}" />
    <aura:attribute name="initialLoadMessage" type="String" default="{!$Label.c.atl_initialLoadMessage }" />
    <aura:attribute name="initialLoadMessageKBSF" type="String" default="{!$Label.c.atl_initialLoadMessageKBSF}" />
    <aura:attribute name="noResources" type="String" default="{!$Label.c.atl_noResources}" />
    
    <!-- Data -->
    <aura:attribute name="allKAs" type="atl_KnowledgeArticle__c[]" />
    <aura:attribute name="techs" type="List" />
    <aura:attribute name="domains" type="List" />
    
    <!-- Utilities -->
    <aura:attribute name="downloadURL" type="String" default="sfc/servlet.shepherd/document/download/" access="private" />
    <aura:attribute name="selectedTech" type="String" />
    <aura:attribute name="selectedDomain" type="String" default="All Domains"/>
    <aura:attribute name="filteredKAs" type="atl_KnowledgeArticle__c[]" />
    
    <!-- Methods -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Body -->
    <div class="mainFilterBody">
        <!-- To add the title back, delete this line and the line 3 below.
  <div class="atlTitle"> 	
            Knowledge Base
        </div>
  -->
        <lightning:layout multipleRows="true" verticalAlign="start">
            
            <!-- Search maybe
            <lightning:layoutItem size="4" padding="around-small" class="center">
            </lightning:layoutItem> -->
            
            <!-- Tech Selection -->
            <lightning:layoutItem size="4" padding="around-small">
                <lightning:select name="techSelect" aura:id="techSelect" label="Technology" 
                                  value="{!v.selectedTech}" required="true" onchange="{!c.filterKAs}" 
                                  variant="label-hidden">
                    <option text="Select Technology"></option>
                    <aura:iteration items="{!v.techs}" var="tech">
                        <option text="{! tech }"></option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
            
            <!-- Domain?? -->
            <lightning:layoutItem size="4" padding="around-small">
                <aura:if isTrue="{! v.selectedTech == 'Salesforce' }">
                    <lightning:select name="domainSelect" aura:id="domainSelect" label="Domain" 
                                      value="{!v.selectedDomain}" required="true" onchange="{!c.filterKAs}" 
                                      variant="label-hidden">
                        <option text="All Domains"></option>
                        <aura:iteration items="{!v.domains}" var="domain">
                            <option text="{! domain }"></option>
                        </aura:iteration>
                    </lightning:select>
                </aura:if> 
            </lightning:layoutItem>
            
            <!-- Submit KA Global Action -->
            <lightning:layoutItem size="4" padding="around-small">
                <!-- submit ka -->
            </lightning:layoutItem>
            
            <aura:if isTrue="{! !v.selectedTech || v.selectedTech == 'Select Technology' || !v.selectedDomain || v.selectedDomain == 'Select Domain'}">
                <lightning:layoutItem size="12" padding="around-small" class="atlSubtitle slds-align_center">
                    {!v.initialLoadMessage}
                </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{! !(!v.selectedTech || v.selectedTech == 'Select Technology' || !v.selectedDomain || v.selectedDomain == 'Select Domain') }">
                <aura:if isTrue="{! empty(v.filteredKAs) }">
                    <div class="atlSubtitle slds-align_center">
                        {!v.noResources}
                    </div>
                    <aura:set attribute="else">
                        
                        <lightning:layoutItem size="12" padding="around-small" class="atlasBox">
                            <lightning:layout multipleRows="true" verticalAlign="center">
                                <aura:iteration items="{!v.filteredKAs}" var="ka">
                                    <aura:if isTrue="{! ka.atl_Published__c }">
                                        <lightning:layoutItem size="12" padding="around-small">
                                            <!-- this one opens in a new tab	
                <a href="{! v.commURL + 's/article/' + ka.Id }" target="_blank"> {! ka.atl_Title__c } </a>
-->
                                            <lightning:icon iconName="utility:work_order_type" alternativeText="Guide" title="Guide" size="x-small" class="atlIcon"/>
                                            <a href="{! v.commURL + 's/article/' + ka.Id }"> {! ka.atl_Title__c } </a>
                                        </lightning:layoutItem>
                                    </aura:if>
                                    
                                </aura:iteration>
                            </lightning:layout>
                        </lightning:layoutItem>
                    </aura:set>
                </aura:if>
            </aura:if>
        </lightning:layout>
    </div>
</aura:component>