<?xml version="1.0" encoding="UTF-8"?>
<AutoResponseRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <autoResponseRule>
        <fullName>Case Auto Response Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>success@atginfo.com</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Account_Name__c</field>
                <operation>notEqual</operation>
                <value>ATG</value>
            </criteriaItems>
            <notifyCcRecipients>true</notifyCcRecipients>
            <replyToEmail>success@atginfo.com</replyToEmail>
            <senderEmail>ps_noreply@atginfo.com</senderEmail>
            <senderName>Application Support Team</senderName>
            <template>Service_Cloud_Email_Templates/Service_Cloud_Client_Auto_Response_PST</template>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>salesforcesupport@atginfo.com</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Account_Name__c</field>
                <operation>notEqual</operation>
                <value>ATG</value>
            </criteriaItems>
            <notifyCcRecipients>true</notifyCcRecipients>
            <replyToEmail>salesforcesupport@atginfo.com</replyToEmail>
            <senderEmail>ps_noreply@atginfo.com</senderEmail>
            <senderName>Expert Services</senderName>
            <template>Service_Cloud_Email_Templates/Service_Cloud_Client_Auto_Response_Expert_Services</template>
        </ruleEntry>
    </autoResponseRule>
</AutoResponseRules>
