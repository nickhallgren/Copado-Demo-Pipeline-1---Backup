<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>PeriodCostApproved</fullName>
        <description>Alert sent when Period Cost is Approved.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_PeriodCostApproved</template>
    </alerts>
    <alerts>
        <fullName>PeriodCostRejected</fullName>
        <description>Alert sent when Period Cost is Rejected.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_PeriodCostRejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>KimbleOne__PeriodCostApprovalStatusApproved</fullName>
        <description>Set PeriodCost ApprovalStatus to Approved.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Approved&quot;</formula>
        <name>PeriodCostApprovalStatusApproved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>KimbleOne__PeriodCostApprovalStatusRejected</fullName>
        <description>Set PeriodCost ApprovalStatus to Rejected.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Rejected&quot;</formula>
        <name>PeriodCostApprovalStatusRejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>KimbleOne__TemplatePeriodCostFieldUpdates</fullName>
        <actions>
            <name>KimbleOne__PeriodCostApprovalStatusApproved</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>KimbleOne__PeriodCostApprovalStatusRejected</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__PeriodCost__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>X</value>
        </criteriaItems>
        <description>Template workflow rule to deploy Field Updates.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>PeriodCostApproved</fullName>
        <actions>
            <name>PeriodCostApproved</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__PeriodCost__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Notify a user that the Period Cost has been Approved.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>PeriodCostRejected</fullName>
        <actions>
            <name>PeriodCostRejected</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__PeriodCost__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify a user that the Period Cost has been Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
