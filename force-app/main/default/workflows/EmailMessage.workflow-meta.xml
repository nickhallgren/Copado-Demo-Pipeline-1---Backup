<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Case_Status_Update</fullName>
        <description>Updating Case status to Awaiting Agent</description>
        <field>Status</field>
        <literalValue>Awaiting Agent</literalValue>
        <name>Case Status Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>ParentId</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Case_Status_Update_Closed_to_Reopened</fullName>
        <description>Updating Case status from Closed to Reopened</description>
        <field>Status</field>
        <literalValue>Reopened</literalValue>
        <name>Case Status Update - Closed to Reopened</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>ParentId</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Case_Status_Update_to_Awaiting_Customer</fullName>
        <description>Update Case status to awaiting customer</description>
        <field>Status</field>
        <literalValue>Awaiting Customer</literalValue>
        <name>Case Status Update to Awaiting Customer</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>ParentId</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Change_Case_Status_to_Closed</fullName>
        <field>Status</field>
        <literalValue>Case Closed - System</literalValue>
        <name>Change Case Status to Closed</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>ParentId</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Latest_Email_Message_Field_on_Cas</fullName>
        <description>Stamps the message date from an email to latest email message field on Case.</description>
        <field>Latest_Email_Message__c</field>
        <formula>MessageDate</formula>
        <name>Update Latest Email Message Field on Cas</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>ParentId</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>Service Cloud%3A New Email Message when Case Closed</fullName>
        <actions>
            <name>Case_Status_Update_Closed_to_Reopened</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>EmailMessage.Incoming</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Case Closed,Case Closed - System</value>
        </criteriaItems>
        <description>Updating status of Case closed to reopened when a new email message is received in this state.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Service Cloud%3A Updating Case status to Awaiting Agent</fullName>
        <actions>
            <name>Case_Status_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>EmailMessage.Incoming</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>On Hold,Escalated,Submitted for Approval,Case Closed - System,Case Closed</value>
        </criteriaItems>
        <description>Updating Case status to Awaiting Agent</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Service Cloud%3A Updating Case status to Awaiting Customer</fullName>
        <actions>
            <name>Case_Status_Update_to_Awaiting_Customer</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>EmailMessage.Incoming</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>On Hold,Escalated,Submitted for Approval,Case Closed - System,Case Closed</value>
        </criteriaItems>
        <criteriaItems>
            <field>EmailMessage.Status</field>
            <operation>equals</operation>
            <value>Read,Replied,Forwarded,Sent</value>
        </criteriaItems>
        <criteriaItems>
            <field>EmailMessage.FromAddress</field>
            <operation>notEqual</operation>
            <value>ps_noreply@atginfo.com</value>
        </criteriaItems>
        <description>Updating Case status to Awaiting Customer</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
