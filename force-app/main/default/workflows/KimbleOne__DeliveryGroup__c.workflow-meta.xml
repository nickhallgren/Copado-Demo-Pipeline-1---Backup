<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>DeliveryEngagementChangeOwner</fullName>
        <description>Alert sent when Delivery Engagement Owner changes</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_DeliveryGroupChangeOwner</template>
    </alerts>
    <rules>
        <fullName>DeliveryEngagementChangeOwner</fullName>
        <actions>
            <name>DeliveryEngagementChangeOwner</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <description>Notify a user that the Delivery Engagement Owner has changed.</description>
        <formula>ISCHANGED(OwnerId)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
