<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>DeliveryStageApproved</fullName>
        <description>Alert sent when Delivery Stage is Approved.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_DeliveryGroupStageApproved</template>
    </alerts>
    <alerts>
        <fullName>DeliveryStageRejected</fullName>
        <description>Alert sent when Delivery Stage is Rejected.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_DeliveryGroupStageRejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>KimbleOne__DeliveryGroupStageApprovalStatusApproved</fullName>
        <description>Set DeliveryGroupStage ApprovalStatus to Approved.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Approved&quot;</formula>
        <name>DeliveryGroupStageApprovalStatusApproved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>KimbleOne__DeliveryGroupStageApprovalStatusRejected</fullName>
        <description>Set DeliveryGroupStage ApprovalStatus to Rejected.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Rejected&quot;</formula>
        <name>DeliveryGroupStageApprovalStatusRejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>DeliveryStageApproved</fullName>
        <actions>
            <name>DeliveryStageApproved</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__DeliveryGroupStage__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Notify a user Delivery Stage has been Approved.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>DeliveryStageRejected</fullName>
        <actions>
            <name>DeliveryStageRejected</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__DeliveryGroupStage__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify a user Delivery Stage has been Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>KimbleOne__TemplateDeliveryGroupStageFieldUpdates</fullName>
        <actions>
            <name>KimbleOne__DeliveryGroupStageApprovalStatusApproved</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>KimbleOne__DeliveryGroupStageApprovalStatusRejected</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__DeliveryGroupStage__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>X</value>
        </criteriaItems>
        <description>Template workflow rule to deploy Field Updates.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
