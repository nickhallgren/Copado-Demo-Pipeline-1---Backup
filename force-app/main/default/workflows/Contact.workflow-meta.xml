    <rules>
        <fullName>ESM 30 Day Follow up Notification2</fullName>
        <active>true</active>
        <formula>Trigger_30_Day_Notice__c = TRUE</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>X30_Day_ESM_Notification</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Contact.Hire_Date__c</offsetFromField>
            <timeLength>30</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>ESM 50 Day Follow up Notification</fullName>
        <active>true</active>
        <description>Timed workflow for HR to follow up with new employees</description>
        <formula>Trigger_50_Day_Notice__c = TRUE</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>X50_Day_ESM_Notification</name>
                <type>Alert</type>
            </actions>
            <timeLength>50</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>GW_Volunteers__Volunteer Signup - Contact</fullName>
        <actions>
            <name>GW_Volunteers__Volunteer_Signup_Notification_Email_Alert_Contact</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>GW_Volunteers__Volunteer_Signup_Thank_You_Email_Alert_Contact</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>GW_Volunteers__Volunteer_Signup_Thank_You_Sent_Contact</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>When a contact is updated or created from VolunteersSignup(FS) or VolunteersJobListing(FS), thank them and notify the volunteer manager.  Note if you are not using VolunteersSignup(FS), you can de-activate this rule to avoid multiple emails being sent.</description>
        <formula>GW_Volunteers__Volunteer_Last_Web_Signup_Date__c =  TODAY()</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Referral Email</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Contact.Referred_By__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>Workflow will send an email to HR regarding a new contacts hire date. The rule will fire at 90 and 180 days after hire date to inform HR about referral bonuses.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>Contact.Hire_Date__c</offsetFromField>
            <timeLength>90</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
        <workflowTimeTriggers>
            <offsetFromField>Contact.Hire_Date__c</offsetFromField>
            <timeLength>180</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Referral Emails</fullName>
        <active>false</active>
        <description>Workflow will send an email to HR regarding a new contacts hire date. The rule will fire at 90 and 180 days after hire date to inform HR about referral bonuses.</description>
        <formula>Hire_Date__c  =  TODAY()  + 90</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>Contact.Hire_Date__c</offsetFromField>
            <timeLength>90</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Staff Contact 30 Day Notification</fullName>
        <actions>
            <name>Check_the_Trigger_30_Day_Checkbox</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.RecordTypeId</field>
            <operation>equals</operation>
            <value>Staff</value>
        </criteriaItems>
        <criteriaItems>
            <field>Contact.Employment_Type__c</field>
            <operation>notEqual</operation>
            <value>1099,Subcontractor,Cognizant Employee</value>
        </criteriaItems>
        <description>When a staff contact is created, checks the &quot;Trigger 30 Day Notification&quot; box to send emails to the ESM team.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
