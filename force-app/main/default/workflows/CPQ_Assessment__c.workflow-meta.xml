<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Alert_Assessment_Owner_of_Asessment_Completion</fullName>
        <description>Alert Assessment Owner of Assessment Completion</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderAddress>ps_noreply@atginfo.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>All_Email_templates/Assessment_Completed_Notiification</template>
    </alerts>
    <fieldUpdates>
        <fullName>CPQStatusChange</fullName>
        <description>Change the status of a CPQ assessment to &quot;customer completed&quot; when customer checks checkbox</description>
        <field>Status__c</field>
        <literalValue>Customer Completed</literalValue>
        <name>CPQStatusChange</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Status_to_Completed</fullName>
        <description>Update CPQ Status</description>
        <field>Status__c</field>
        <literalValue>Customer Completed</literalValue>
        <name>Set Status to Completed</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>CPQ Assessment Completed Notiification</fullName>
        <actions>
            <name>Alert_Assessment_Owner_of_Asessment_Completion</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>CPQStatusChange</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>CPQ_Assessment__c.Assessment_Completed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update CPQ Status</fullName>
        <actions>
            <name>Set_Status_to_Completed</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>CPQ_Assessment__c.Assessment_Completed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
