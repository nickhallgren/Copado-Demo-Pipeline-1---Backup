<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Volunteers_Personal_Site_Contact_Lookup</fullName>
        <description>Volunteers Personal Site Contact Lookup</description>
        <protected>false</protected>
        <recipients>
            <field>Customer_Contact_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>GW_Volunteers__Volunteers_Email_Templates/GW_Volunteers__Volunteers_Personal_Site_Contact_Lookup</template>
    </alerts>
    <rules>
        <fullName>Volunteers Personal Site Contact Lookup</fullName>
        <actions>
            <name>Volunteers_Personal_Site_Contact_Lookup</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Name</field>
            <operation>equals</operation>
            <value>ATG Philanthropy Volunteers</value>
        </criteriaItems>
        <description>Volunteers Personal Site Contact Lookup</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
