<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>PeriodRevenueApproved</fullName>
        <description>Alert sent when Period Revenue is Approved.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_PeriodRevenueApproved</template>
    </alerts>
    <alerts>
        <fullName>PeriodRevenueRejected</fullName>
        <description>Alert sent when Period Revenue is Rejected.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_PeriodRevenueRejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>KimbleOne__PeriodRevenueApprovalStatusApproved</fullName>
        <description>Set PeriodRevenue ApprovalStatus to Approved.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Approved&quot;</formula>
        <name>PeriodRevenueApprovalStatusApproved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>KimbleOne__PeriodRevenueApprovalStatusRejected</fullName>
        <description>Set PeriodRevenue ApprovalStatus to Rejected.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Rejected&quot;</formula>
        <name>PeriodRevenueApprovalStatusRejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>KimbleOne__TemplatePeriodRevenueFieldUpdates</fullName>
        <actions>
            <name>KimbleOne__PeriodRevenueApprovalStatusApproved</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>KimbleOne__PeriodRevenueApprovalStatusRejected</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__PeriodRevenue__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>X</value>
        </criteriaItems>
        <description>Template workflow to deploy Field Updates.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>PeriodRevenueApproved</fullName>
        <actions>
            <name>PeriodRevenueApproved</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__PeriodRevenue__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Notify a user that the Period Revenue has been Approved.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>PeriodRevenueRejected</fullName>
        <actions>
            <name>PeriodRevenueRejected</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__PeriodRevenue__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify a user that the Period Revenue has been Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
