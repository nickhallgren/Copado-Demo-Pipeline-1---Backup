<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>KimbleOne__TimesheetApproved</fullName>
        <description>Timesheet Approved</description>
        <protected>true</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_TimesheetApproved</template>
    </alerts>
    <alerts>
        <fullName>KimbleOne__TimesheetRejected</fullName>
        <description>Timesheet Rejected</description>
        <protected>true</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_TimesheetRejected</template>
    </alerts>
    <alerts>
        <fullName>TimesheetApproved</fullName>
        <description>Alert sent when Timesheet is Approved.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_TimesheetApproved</template>
    </alerts>
    <alerts>
        <fullName>TimesheetRejected</fullName>
        <description>Alert sent when Timesheet is Rejected.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_TimesheetRejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>KimbleOne__TimesheetApprovalStatusApproved</fullName>
        <description>Sets Timesheet ApprovalStatus to Approved.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Approved&quot;</formula>
        <name>TimesheetApprovalStatusApproved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>KimbleOne__TimesheetApprovalStatusRejected</fullName>
        <description>Set Timesheet ApprovalStatus to Rejected.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Rejected&quot;</formula>
        <name>TimesheetApprovalStatusRejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>KimbleOne__TemplateTimesheetFieldUpdates</fullName>
        <actions>
            <name>KimbleOne__TimesheetApprovalStatusApproved</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>KimbleOne__TimesheetApprovalStatusRejected</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__Timesheet__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>X</value>
        </criteriaItems>
        <description>Template workflow to deploy Field Updates.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>KimbleOne__TimesheetRejected</fullName>
        <actions>
            <name>KimbleOne__TimesheetRejected</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__Timesheet__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify user that Timesheet Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>TimesheetApproved</fullName>
        <actions>
            <name>TimesheetApproved</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__Timesheet__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Notify a user that the Timesheet has been Approved.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>TimesheetRejected</fullName>
        <actions>
            <name>TimesheetRejected</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__Timesheet__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify a user that the Timesheet has been Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
