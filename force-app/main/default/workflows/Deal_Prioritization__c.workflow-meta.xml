<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Update_Last_Verified_Date</fullName>
        <description>Capture a date when criteria fields (Strategy Fit, Delivery Fit, Strategy Fit Description) are edited.</description>
        <field>Last_Verified_Date__c</field>
        <formula>LastModifiedDate</formula>
        <name>Update Last Verified Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Last Verified Date Update</fullName>
        <actions>
            <name>Update_Last_Verified_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Capture the last verified date on the field &quot;Last Verified Date&quot; anytime an update is made to the fields &quot;Strategy Fit&quot;, &quot;Delivery Fit&quot;, or &quot;Strategy Fit Description&quot;</description>
        <formula>OR(
				 ISCHANGED(Strategy_Fit__c),
				 ISCHANGED(Delivery_Fit__c),
				 ISCHANGED(Strategy_Fit_Description__c)
				)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
