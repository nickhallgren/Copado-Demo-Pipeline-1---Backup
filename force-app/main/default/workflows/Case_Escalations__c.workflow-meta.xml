<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Service_Cloud_Internal_Escalation_Notice</fullName>
        <description>Service Cloud: Internal Escalation Notice</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderAddress>ps_noreply@atginfo.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Service_Cloud_Email_Templates/Service_Cloud_Case_Escalation</template>
    </alerts>
    <fieldUpdates>
        <fullName>Case_Escalated_Checkbox</fullName>
        <description>Checking Case escalated checkbox</description>
        <field>IsEscalated</field>
        <literalValue>1</literalValue>
        <name>Case Escalated Checkbox</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>CaseLookup__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Case_Escalated_Status</fullName>
        <description>Update Case Escalation Status</description>
        <field>Status</field>
        <literalValue>Escalated</literalValue>
        <name>Case Escalated Status</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>CaseLookup__c</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>Service Cloud%3A Case Escalation</fullName>
        <actions>
            <name>Service_Cloud_Internal_Escalation_Notice</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Case_Escalated_Checkbox</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Case_Escalated_Status</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Updating status to &quot;escalated&quot; and sending email to case owner.</description>
        <formula>True</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
