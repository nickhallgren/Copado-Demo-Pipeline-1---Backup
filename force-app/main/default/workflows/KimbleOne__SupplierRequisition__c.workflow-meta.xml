<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>SupplierRequisitionApproved</fullName>
        <description>Alert sent when Supplier Requisition is Approved.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_SuppRequisitionApproved</template>
    </alerts>
    <alerts>
        <fullName>SupplierRequisitionRejected</fullName>
        <description>Alert sent when Supplier Requisition is Rejected.</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>KimbleEmailTemplates/Kimble_SuppRequisitionRejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>KimbleOne__SupplierReqApprovalStatusApproved</fullName>
        <description>Set Supplier Requisition Approval Status to Approved.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Approved&quot;</formula>
        <name>SupplierReqApprovalStatusApproved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>KimbleOne__SupplierReqApprovalStatusRejected</fullName>
        <description>Set Supplier Requisiton Approval Status to Rejected.</description>
        <field>KimbleOne__ApprovalStatus__c</field>
        <formula>&quot;Rejected&quot;</formula>
        <name>SupplierReqApprovalStatusRejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>KimbleOne__TemplateSupplierReqFieldUpdates</fullName>
        <actions>
            <name>KimbleOne__SupplierReqApprovalStatusApproved</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>KimbleOne__SupplierReqApprovalStatusRejected</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__SupplierRequisition__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>X</value>
        </criteriaItems>
        <description>Template workflow to deploy Field Updates.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>SupplierRequisitionApproved</fullName>
        <actions>
            <name>SupplierRequisitionApproved</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>KimbleOne__SupplierRequisition__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Notify a user that the Supplier Requisition has been Approved.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>SupplierRequisitionRejected</fullName>
        <actions>
            <name>SupplierRequisitionRejected</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>KimbleOne__SupplierRequisition__c.KimbleOne__ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <description>Notify a user that the Supplier Requisition has been Rejected.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
