    <rules>
        <fullName>CC Reminder of Shift</fullName>
        <active>true</active>
        <description>workflow rule to remind volunteer of upcoming shift 48 hours in advance.</description>
        <formula>(ISPICKVAL(GW_Volunteers__Status__c, &quot;Confirmed&quot;) ||  ISPICKVAL(GW_Volunteers__Status__c, &quot;Completed&quot;)) &amp;&amp; NOT(ISBLANK(GW_Volunteers__Contact__r.Email)) &amp;&amp; NOT(GW_Volunteers__Contact__r.GW_Volunteers__Volunteer_Auto_Reminder_Email_Opt_Out__c) &amp;&amp; GW_Volunteers__Start_Date__c &gt;= TODAY()</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>GW_Volunteers__Volunteer_Shift_Reminder_Email_Alert</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>GW_Volunteers__Volunteer_Hours__c.GW_Volunteers__Planned_Start_Date_Time__c</offsetFromField>
            <timeLength>-48</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Confirm Volunteer Web Signups %28For account name%29</fullName>
        <actions>
            <name>Convert_sign_up_to_confirmed</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>GW_Volunteers__Volunteer_Hours__c.GW_Volunteers__Status__c</field>
            <operation>equals</operation>
            <value>Web Sign Up</value>
        </criteriaItems>
        <description>V4S auto creates a volunteer hours record with a status of web sign up</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
