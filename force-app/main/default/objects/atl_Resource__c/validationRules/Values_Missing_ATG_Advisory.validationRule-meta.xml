<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Values_Missing_ATG_Advisory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(INCLUDES(atl_Project_Type__c,&quot;Advisory&quot;),OR(ISBLANK(atl_Advisory_Role__c),ISBLANK(atl_Advisory_Offering__c),ISBLANK(atl_Advisory_Stage__c)))</errorConditionFormula>
    <errorMessage>Oops! Looks like you selected ATG Advisory as a Project Type but didn&apos;t complete Advisory Role, Advisory Stage, and Advisory Offering fields.</errorMessage>
</ValidationRule>
