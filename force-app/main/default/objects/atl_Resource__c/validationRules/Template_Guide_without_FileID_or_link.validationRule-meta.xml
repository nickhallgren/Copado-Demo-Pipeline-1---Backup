<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Template_Guide_without_FileID_or_link</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(TEXT(atl_ResourceType__c) = &quot;Template&quot;,TEXT(atl_ResourceType__c) = &quot;Guide&quot;),AND(atl_SalesforceFileId__c=&quot;&quot;,atl_Link__c=&quot;&quot;))</errorConditionFormula>
    <errorMessage>Oops! Looks like you&apos;re creating a Template or Guide but forgot the Salesforce File ID or Link.</errorMessage>
</ValidationRule>
