<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Values_Missing_ATG_Delivery</fullName>
    <active>true</active>
    <errorConditionFormula>AND(INCLUDES(atl_Project_Type__c,&quot;Delivery&quot;),OR(ISBLANK(atl_Role__c),ISBLANK(atl_Technology__c),ISBLANK(atl_Stage__c)))</errorConditionFormula>
