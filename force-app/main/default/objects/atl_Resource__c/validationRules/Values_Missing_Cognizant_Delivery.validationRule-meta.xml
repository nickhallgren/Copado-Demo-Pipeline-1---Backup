<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Values_Missing_Cognizant_Delivery</fullName>
    <active>true</active>
    <errorConditionFormula>AND(INCLUDES(atl_Project_Type__c,&quot;Cognizant&quot;),OR(ISBLANK(atl_Cognizant_Role__c),ISBLANK(atl_Cognizant_Technology__c),ISBLANK(atl_cognizant_stage__c)))</errorConditionFormula>
    <errorMessage>Oops! Looks like you selected Cognizant Delivery as a Project Type but didn&apos;t complete Cognizant Role, Cognizant Stage, and Cognizant Technology fields.</errorMessage>
</ValidationRule>
