<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Distance_KM__c</fullName>
    <description>Venkat: Created this field as part of NZC Phase 2 Implementation.
Purpose: To convert the distance in KM if entered in Miles.</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(DistanceUnit, &apos;Kilometers&apos;), Distance , (Distance*1.609344))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Distance (KM)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
