<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NZC_Intensity_Metric_val_required_for_DG</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( FuelType , &apos;Multitenant DG (CUSTOM)&apos;), ISNULL(Intensity_Metric_Value__c))</errorConditionFormula>
    <errorDisplayField>Intensity_Metric_Value__c</errorDisplayField>
    <errorMessage>Please Enter Intensity Metric Value for Fuel Type Multitenant DG.</errorMessage>
</ValidationRule>
