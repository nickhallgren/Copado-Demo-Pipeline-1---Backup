<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hours_Completed</fullName>
    <active>true</active>
    <description>Hours Completed cannot be less that 0</description>
    <errorConditionFormula>GW_Volunteers__Hours_Worked__c &lt; 0</errorConditionFormula>
    <errorDisplayField>GW_Volunteers__Hours_Worked__c</errorDisplayField>
    <errorMessage>The hours cannot be less than 0</errorMessage>
</ValidationRule>
