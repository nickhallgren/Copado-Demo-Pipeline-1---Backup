<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Non_Billing_Costs__c</fullName>
    <description>Total non-billing costs associated with delivery team consultants including investment in planned tactical work and &quot;bench&quot; available hours</description>
    <formula>Tactical_Utilization_Costs__c  +  (Available_Hours_Month__c  *  Closed_Loaded_Rate__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Non-Billing Costs</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
