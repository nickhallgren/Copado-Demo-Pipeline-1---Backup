<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tactical_Utilization_Costs__c</fullName>
    <description>Total estimated costs incurred with tactical utilization by a consultant</description>
    <formula>((Available_Billing_Hours_Month__c  *  Tactical_Utilization__c)  *  Closed_Loaded_Rate__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Tactical Utilization Costs</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
