<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AEI_Archival_Date__c</fullName>
    <description>Gives the archival date post 7 years and 30 days from the base year of that AEI</description>
    <formula>DATE(VALUE(TEXT(Year)), 1, 1) + VALUE($Label.NZC_AEI_7_years_plus_30_days_value)</formula>
    <label>AEI Archival Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Date</type>
</CustomField>
