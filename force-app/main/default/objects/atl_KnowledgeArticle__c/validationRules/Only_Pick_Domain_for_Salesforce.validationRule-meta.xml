<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Only_Pick_Domain_for_Salesforce</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(INCLUDES(atl_Technology__c,&quot;Salesforce&quot;)),NOT(ISBLANK(atl_Domain__c)))</errorConditionFormula>
    <errorMessage>Oops! Please only select a Domain if the Technology is Salesforce.</errorMessage>
</ValidationRule>
